{
  "about": "Where tools/fill_claims.py finds each claim's value in a folder of boot outputs, and which labels it checks before writing. Paths are relative to the --outputs folder; {pick} is the trunk width in build.full.trunk. Each claim's receipt path comes from card/claims.json. The panel setups say relay transport (launch/ring.relay.env.example).",
  "layout": {
    "widths/": "width table over 4b, 4b6b and 6b (width_table.json)",
    "exl3-4k/": "full quant at the picked width, 4,096-token window: plain boot then drafted boot with the repeat option off (TF_HY4_REPEAT_STABLE unset). Bench outputs named <width>-4k-plain_<prompt>.json and <width>-4k-dfly_<prompt>.json, boot records plain_boot_meta.json and dfly_boot_meta.json (repeat_stable false), draft_diff.json (drafted run 1 against plain run 1), draftoff_vs_plain_diff.json (\"draft\": false requests on the drafted boot against plain run 1), teacher score <width>_score.json; fresh-set score <width>_fresh_score.json; drafted-path grid score <width>_dfly_grid_score.json with the grid boot's record grid_dfly_boot_meta.json (repeat_stable true)",
    "lossless-4k-plain/": "lossless trunk, plain boot, 4,096-token window: lossless-4k-plain_<prompt>.json, boot_meta.json",
    "lossless-4k-dfly/": "lossless trunk, drafted boot with the repeat option on, 4,096-token window: lossless-4k-dfly_<prompt>.json, boot_meta.json, draft_diff.json",
    "lossless-teacher/": "teacher scores of the lossless trunk: lossless_score.json (familiar set), lossless_fresh_score.json (fresh set)",
    "exl3-32k/": "full quant, 32,768-token window, drafted boot with the repeat option on: pp32k_default.json, boot_meta.json",
    "lossless-32k/": "lossless trunk, 32,768-token window, drafted boot with the repeat option on: pp32k_default.json, boot_meta.json",
    "exl3-128k/": "full quant, 131,072-token window, drafted boot with the repeat option on: niah_128k_default.json, niah_128k_nothink.json, boot_meta.json",
    "lossless-128k/": "lossless trunk, 131,072-token window: not booted (its claims are tier later)",
    "systems-exl3-128k/": "launch/collect_receipts.py output of the full quant 128K boot (summary.json and systems.*.exl3.json)",
    "systems-lossless-32k/": "launch/collect_receipts.py output of the lossless trunk 32K boot (summary.json and systems.*.lossless.json); the lossless trunk is not booted at 128K",
    "exl3-4k-rs/": "full quant, drafted boot with TF_HY4_REPEAT_STABLE=1 (the kit default, the headline drafted rows): <width>-4k-rs_<prompt>.json (three runs each), boot_meta.json with repeat_stable true, draft_diff.json (this boot's run 1 against the plain run 1 in exl3-4k/)",
    "exl3-4k-cutoff05/": "the cutoff report (cutoff_summary.json) of two drafted boots with the repeat option on, TF_HY4_DRAFT_MIN_MARGIN unset and 0.5",
    "rigmark/": "RigMark 1.3.0 standard suite on the full quant (131,072-token window, drafts on), thinking off (reasoning_effort no_think): the JSON receipt RigMark's bench.py writes, hy4-exl3-4b6b-tp4-4x-dgx-spark-nothink.json; a quick or partial run is refused"
  },
  "expect_keys": {
    "trunk": "trunk label in the boot record (lossless, 4b, 4b6b, 6b); @pick means build.full.trunk; in a RigMark receipt, run.appliance.quantisation names '<width> trunk'",
    "drafter": "drafter label in the boot record: none, on (any DFly2 drafter), or an exact label; @pick_drafter looks up pick_drafter; in a RigMark receipt, run.appliance.drafter starts with it",
    "context": "context window in the boot record (and in the needle prompt's meta); in a RigMark receipt, run.appliance.context_limit",
    "layers": "layers loaded, from the boot record",
    "transport": "network path in the boot record: stock (NCCL IB) or relay (the direct RoCE relay, launch/ring.relay.env.example); the setups say relay, so a stock boot is refused until its setup says so",
    "prompt": "prompt file name in a bench output",
    "thinking": "on (reasoning_effort omitted) or off (no_think)",
    "drafts": "every bench run reports this drafts flag",
    "runs": "at least this many runs",
    "pairs": "prompts compared, plain against drafted (or against \"draft\": false requests)",
    "label": "label in a teacher score file, or run.label in a RigMark receipt",
    "comparison_id": "run.comparison_id in a RigMark receipt",
    "paired_vs": "baseline label in a paired teacher score file",
    "positions_min": "at least this many scored positions",
    "teacher_kind": "reference shape in a teacher score file; @prefix_set:NAME means the shape of eval/prefixes/NAME/manifest.json (count x seq_len), so only scores on that kit prefix set fill",
    "claim_id": "claim id written inside a launch/collect_receipts.py file",
    "ranks": "ranks in summary.json",
    "repeat_stable": "repeat_stable in the boot record (true when the server's startup line says TF_HY4_REPEAT_STABLE is on); on an entry with meta_off, the off boot's record must say the opposite",
    "margin": "TF_HY4_DRAFT_MIN_MARGIN of the 'on' boot in a cutoff report",
    "protocol": "RigMark protocol version in a RigMark receipt",
    "revision": "RigMark git revision in a RigMark receipt (protocol.repository_revision); the tree must be recorded clean",
    "extra_body": "fields RigMark merged into every chat request (settings.extra_body)",
    "gpu_clocks": "GPU clock setting in a RigMark receipt (run.appliance.gpu_clocks)"
  },
  "pick_drafter": {
    "4b": "DFly2 4-bit",
    "4b6b": "DFly2 4-bit",
    "6b": "DFly2 6-bit"
  },
