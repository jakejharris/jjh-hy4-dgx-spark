# Ring configuration for 4-node switchless 200 Gb/s RoCE cluster.
# Copy to launch/ring.env and edit for your nodes.
#
# Rank order MUST follow the physical ring cables (0 -> 1 -> 2 -> 3 -> 0).
# Find your physical ring order by checking link neighbors on each node:
#   ibdev2netdev
#   ip -o -4 addr show
#   ip route get <neighbor_cable_ip>
# Do not assume hostnames (node1..node4) match physical cable order without checking.

RING_HOSTS="node1 node2 node4 node3"
MASTER_ADDR="192.168.102.1"
MASTER_PORT="29577"

# Model and container settings
MODEL_DIR="/data/models/hy4-exl3"
IMAGE="nvcr.io/nvidia/pytorch:26.07-py3"
TENSORFOLD_BIN="/opt/tensorfold/zig-out/native/bin/tensorfold-native"
SERVE_HOST="0.0.0.0"
SERVE_PORT="8080"
CONTEXT_LEN="131072"

# Memory floor (GiB) required on each node before launch
MIN_AVAIL_GIB="95"
MEMFLOOR_GIB="8"
# Readiness timeout (serve mode bounds load + /v1/models readiness only; live server runs indefinitely).
# Use 900 s for full 78-layer boots.
TIMEOUT_S="900"
# Per-call TP bootstrap timeout (seconds) and post-weight-load barrier timeout (seconds).
# The shipped engine (serve/BUILD.md) splits them: TF_HY4_LOAD_TIMEOUT_S=900 bounds weight load, so
# TF_HY4_TP_TIMEOUT_S could stay short (20). Older builds with one timeout needed TF_HY4_TP_TIMEOUT_S=900.
TF_HY4_TP_TIMEOUT_S="900"
TF_HY4_LOAD_TIMEOUT_S="900"
# Build. The default is the full quant: routed experts and trunk (attention and shared experts) packed.
# TF_HY4_TRUNK is the packed trunk width, one of "4b", "4b6b" or "6b"; it must match the claim
# build.full.trunk in card/claims.json (tools/check_kit.py checks this). Picked 2026-11-21: 4b6b (card/QUALITY_CARD.md, "Why 4b6b").
# For the lossless trunk option, add the overlay instead of editing this file:
#   bash launch/launch.sh --env-file launch/ring.env --env-file launch/ring.lossless.env.example
TF_HY4_TRUNK="4b6b"
# Drafts. DFly2, the drafting model shipped with Hy4, proposes up to six tokens a pass and the full model
# checks them in one wider batch. Every token is still the full model's greedy pick, but BF16 rounds
# differently at another batch width, so at a close call drafted text can differ from plain text
# (card/QUALITY_CARD.md, "Drafts"). Plain decoding repeats exactly. SERVE_DRAFTS="0" passes --no-drafts.
# With drafts on, the repeat option below decides whether a repeat of the same prompt gives the same
# tokens. Drafts off (SERVE_DRAFTS="0", or "draft": false on one request) is bit-exact on repeat.
# Serve over the relay overlay (launch/ring.relay.env.example) with a row-cost table measured on your own
# ring: bash tools/row_cost_table.sh, then set TF_HY4_ROW_COST_TABLE below (README step 6).
# The drafter is staged inside MODEL_DIR (STAGE_DRAFTER="1" below, DRAFTER_DIR empty) and runs from its
# 4-bit files in trunk-4b/ (use "6b" for both drafter settings with a 6b trunk). With drafts on and no
# drafter staged, launch/launch.sh stops before starting (the engine would fall back to prompt-copy drafts,
# which this recipe does not use). launch/launch.sh treats a missing or empty SERVE_DRAFTS as "1" and
# accepts only "0" or "1".
SERVE_DRAFTS="1"
DRAFTER_DIR=""
TF_HY4_DRAFTER_EXL3="4b"
TF_HY4_DRAFTER_HEAD="4b"
# Repeat option, on in this kit (the engine's own default is off; launch/launch.sh passes "1" when this is
# empty). "1": the engine prices each draft depth from the row-cost table alone, with no wall clock, so a
# request drafts the same whatever came before it, and a repeat of the same prompt gives the same tokens.
# "0": it prices depths from live round times, so timing jitter can pick another verify width and a
# repeat can differ. Measured 2026-11-21 on the release engine (card/QUALITY_CARD.md, "Repeat option"): on, 4 of 4
# prompts repeat token-equal, off, 1 of 4; drafted decode on against off: prose +3.21 tok/s, prose with
# thinking off -0.35, code +0.82, the 4K prompt +0.15.
# ",untimed:1" in TF_HY4_ROW_COST_TABLE also turns it on, so the launcher refuses "0" with that entry.
TF_HY4_REPEAT_STABLE="1"
# Thinking budget, off in this kit: with the line below commented out or empty, the launch passes no budget,
# as measured. A whole number N passes --thinking-budget N on every rank: a request that reasons and sends
# no non-zero "thinking_budget" of its own has its reasoning closed after N tokens, then the answer follows.
# max_tokens still counts reasoning and answer together, so keep N well under your clients' max_tokens.
# Run once on the Sparks with "4096" (2026-11-21): a greedy coding request finished with its answer; the same
# request sampled at Tencent's own default, 0.9, did not (launch/SETTINGS.md, "SERVE_THINKING_BUDGET").
# SERVE_THINKING_BUDGET="4096"
# Temperature, 0.7 in this kit: with the line below commented out, launch/launch.sh passes --temperature 0.7 on
# every rank, so a request that sends no "temperature" is sampled at 0.7. top_p 1 and top_k -1 still come from
# Tencent's generation_config.json, which is not changed. A request's own "temperature" wins; 0 is greedy.
# Empty (SERVE_TEMPERATURE="") passes no flag, so that file decides: 0.9. "0" makes greedy the default.
# Any value but empty or a number of 0 or more is refused (launch/SETTINGS.md, "SERVE_TEMPERATURE").
# SERVE_TEMPERATURE="0.7"
# Served model name, empty in this kit: the server answers to the model folder's last part (with the example
# MODEL_DIR, "hy4-exl3"). A name passes --name NAME on every rank, so /v1/models lists it and requests name it:
# letters, digits, dot, dash and underscore, starting with a letter or digit (launch/SETTINGS.md, "SERVE_MODEL_NAME").
# SERVE_MODEL_NAME="hy4-exl3-4b6b"
# Fast prefill, on in this kit with FP32 sums: launch/launch.sh sets TF_HY4_FAST_PREFILL="1" and
# TF_HY4_PREFILL_AR="fp32" when these lines are commented out or empty; that is the one place the default lives.
# "0" gives the last release's prefill path; "bf16" is faster with lower agreement (launch/SETTINGS.md).
# TF_HY4_FAST_PREFILL="0"
# TF_HY4_PREFILL_AR="bf16"
# Vision, off in this kit. "1" serves still images; rank 0 reads the vision folder (tools/vit_folder.py builds
# it), and launch/preflight.sh checks it against launch/vision.sha256 first (launch/SETTINGS.md, "SERVE_VISION").
# SERVE_VISION="1"
# TF_HY4_VISION_DIR="/data/models/hy4-vit-bf16"
# Receipts only, empty in this kit: launch/launch.sh writes these into launch_meta.json with each rank's
# tensorfold-native SHA-256 and one graphics-clock snapshot per rank at launch and at ready. Set the cap only if you
# set one on the GPUs yourself (the launcher does not set clocks); set the commit to the engine source you built.
# GPU_CLOCK_CAP_MHZ="2200"
# ENGINE_COMMIT=""
# Other engine switches (empty keeps the engine default):
#   TF_HY4_TRUNK also accepts "" or "bf16" (lossless) and "4b,o_proj=6b,kv_a=6b" (same as "4b6b")
#   HY4_TRUNK_FAST: "" / "1" (default fast SM121 4-bit tiles) or "0" (grouped kernel)
#   TF_HY4_DRAFTER_EXL3 / TF_HY4_DRAFTER_HEAD also accept a path to packed dfly_layers / lm_head files
#   TF_HY4_TARGET_HEAD: off by default; packs the target lm_head too ("4b", "6b", path, or "<width>=<path>"); changes output
#   TF_HY4_IHC_SPLIT: "1" splits the hyper-connection read into two launches (default "" uses one launch, same bytes)
#   TF_HY4_HEAD_BF16: "1" reads the target lm_head from BF16 (default "" keeps the FP32 head); changes the last bits of the logits
#   TF_HY4_DRAFT_MIN_MARGIN: off by default; positive logit margin cutoff for DFly2 proposals. At "0.85"
#     (2026-11-21, an earlier internal engine build) it helped code and cost prose with thinking on (card/QUALITY_CARD.md, "Draft cutoff")
#   TF_HY4_ROW_COST_TABLE: draft-length cost table (v1:..,v7:..,d:..,e:..); measure it on your ring with
#     tools/row_cost_table.sh (README step 6 shows our four-Spark relay table for 4b6b); empty = engine default
#   TF_TP_ROCE_RELAY / TF_TP_ROCE_RELAY_MAX_KB / TF_TP_KERNEL_IMAGE / HY4_TP_DIRECT_WRITE /
#   TF_TP_ROCE_FAST / TF_TP_ROCE_BLOCKS: direct verbs relay (empty here; the README launch line adds
#     launch/ring.relay.env.example, which is how the published numbers ran)
#   HY4_DECODE_GRAPH: "1" enables a resident CUDA graph for decode (default off)
#   HY4_ROUTED_FAST: "" / "1" (default fast routed experts) or "0" (reference kernel)
#   TF_HY4_INDEX_PAGE_2K / TF_HY4_GREEDY_FULL_GATHER: "1" selects older paths kept for comparison
HY4_TRUNK_FAST=""
TF_HY4_TARGET_HEAD=""
TF_HY4_IHC_SPLIT=""
TF_HY4_HEAD_BF16=""
TF_HY4_DRAFT_MIN_MARGIN=""
TF_HY4_ROW_COST_TABLE=""
TF_TP_ROCE_RELAY=""
TF_TP_ROCE_RELAY_MAX_KB=""
TF_TP_KERNEL_IMAGE=""
HY4_TP_DIRECT_WRITE=""
TF_TP_ROCE_FAST=""
TF_TP_ROCE_BLOCKS=""
HY4_DECODE_GRAPH=""
HY4_ROUTED_FAST=""
TF_HY4_INDEX_PAGE_2K=""
TF_HY4_GREEDY_FULL_GATHER=""
# Optional unified-memory reserve override (GiB) passed into the container when non-empty.
# Leave unset to use TensorFold's default reserve, max(4 GiB, pool/10): about 12.17 GiB of a Spark's
# 121.7 GiB pool by that formula. This is the formula, not a measurement.
TENSORFOLD_MEMORY_RESERVE_GIB=""
LOGDIR="/tmp/hy4-tp4-logs"
PREFIX="hy4-tp4"

# Set to 1 for benchmark runs (refuses to run if NCCL falls back to Socket)
TIMED_RUN="0"

# NCCL RDMA settings for stock NCCL 2.30.7 on a switchless 4-node /24 ring:
# - NCCL_NET=IB / NCCL_IB_DISABLE=0: require RDMA IB/RoCE; never fall back to sockets.
# - NCCL_IB_HCA / NCCL_IB_GID_INDEX=3: pin ConnectX-7 HCAs and RoCEv2 GID 3.
# - NCCL_IB_SUBNET_AWARE_ROUTING=1 + PREFIX_LEN=24: required when each direct cable
#   uses a separate /24 subnet (f1 <-> f0); prevents ibv_modify_qp errno 110.
# - NCCL_IB_MERGE_NICS=0 + NCCL_CROSS_NIC=1 + NCCL_ALGO=Ring: keep ports unmerged.
# - NCCL_CUMEM_ENABLE=1 + NCCL_RUNTIME_CONNECT=1: prevent stock NCCL from eagerly
#   opening the opposite-rank tree edge (which times out with errno 110).
export NCCL_NET="IB"
export NCCL_IB_DISABLE="0"
export NCCL_IB_HCA="rocep1s0f0,rocep1s0f1"
export NCCL_IB_GID_INDEX="3"
export NCCL_IB_SUBNET_AWARE_ROUTING="1"
export NCCL_IB_SUBNET_PREFIX_LEN="24"
export NCCL_IB_MERGE_NICS="0"
export NCCL_CROSS_NIC="1"
export NCCL_ALGO="Ring"
export NCCL_PROTO="^LL128"
export NCCL_SHM_DISABLE="1"
export NCCL_CUMEM_ENABLE="1"
export NCCL_RUNTIME_CONNECT="1"
export NCCL_MIN_NCHANNELS="4"
export NCCL_MAX_NCHANNELS="4"
export NCCL_BUFFSIZE="1048576"
export NCCL_SOCKET_IFNAME="enp1s0f0np0"
export GLOO_SOCKET_IFNAME="enp1s0f0np0"

# Continuous layer staging (launch/stage_layers.py)
# Direct 1-hop cable IPs: rank0->rank3 (PULL), rank0->rank1 (HOP1), rank1->rank2 (HOP2).
STAGE_DIR="/data/models/hy4-exl3"
STAGE_CABLE_IFACE_PREFIX="enp1s0f"
STAGE_CABLE_PULL_IP="192.168.102.11"
STAGE_CABLE_HOP1_IP="192.168.101.10"
STAGE_CABLE_HOP2_IP="192.168.100.12"
QUANT_STATE_PATH="/data/quant/state.json"
QUANT_LAYERS_DIR="/data/quant/qtensors"
ORIG_MODEL_DIR="/data/models/hy4-bf16"
STAGE_STATE_DIR="/tmp/hy4-stage-state"
# Drafter staging: copies the DFly2 shard into STAGE_DIR on all four nodes (or pass --include-drafter).
# On by default, like drafts: launch/stage_layers.py also stages it when this line is missing or empty, and
# accepts only "0" or "1". It changes the staged pack's hash, so switch all four nodes together.
STAGE_DRAFTER="1"
DRAFTER_FILE="model-00245-of-00245.safetensors"
