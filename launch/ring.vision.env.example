# Overlay: serve still images.
# Rank 0 runs the model's vision tower from the separate folder vit-bf16/ (tools/vit_folder.py builds it).
# Only rank 0 needs the folder. Every rank gets --vision. On the vision build, two text requests
# gave the same tokens with it on and off.
# launch/launch.sh hands preflight all its settings files merged, so preflight checks this folder against
# launch/vision.sha256 and refuses the launch if a file is missing or a hash differs.
#
# Usage (after your base ring.env and the relay overlay):
#   bash launch/launch.sh --env-file launch/ring.env --env-file launch/ring.relay.env.example --env-file launch/ring.vision.env.example
#
# Set the path to where vit-bf16/ sits on rank 0. It must be a full path.

SERVE_VISION="1"
TF_HY4_VISION_DIR="/data/models/hy4-vit-bf16"
