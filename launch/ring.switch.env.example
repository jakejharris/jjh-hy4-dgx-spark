# Overlay: four Sparks on one switch instead of the cabled ring (launch/SWITCH.md).
# Each Spark uses the two network interfaces of its first port (f0), one /24 per interface ("rail"). Every Spark
# reaches every other one directly on both rails. RING_HOSTS then is rank order only; there is no cable order.
#
# Usage (after your base ring.env, WITHOUT the relay overlay):
#   bash launch/launch.sh --env-file launch/ring.env --env-file launch/ring.switch.env.example
# With per-Spark parts and images, copy their overlays, set your paths and pass them too. This is how it was run:
#   bash launch/launch.sh --env-file launch/ring.env --env-file launch/ring.parts.env \
#     --env-file launch/ring.vision.env --env-file launch/ring.switch.env
#
# launch/preflight.sh checks the rails and refuses the relay here.

SWITCH_FABRIC="1"
# First rail, then second rail. NCCL_IB_HCA below names their RDMA devices in the same order
# (ls /sys/class/net/INTERFACE/device/infiniband). NCCL_SOCKET_IFNAME in ring.env is the first rail.
SWITCH_RAILS="enp1s0f0np0 enP2p1s0f0np0"
# Rank 0's address on the first rail.
MASTER_ADDR="10.50.1.1"
export NCCL_IB_HCA="rocep1s0f0,roceP2p1s0f0"
export NCCL_CROSS_NIC="0"
