# Overlay that enables the four-rank RoCE verbs relay for live serve. The README launch line uses it.
# On the lossless trunk without drafts it gave the same tokens as stock NCCL IB with 4 channels
# (0 of 384 differ over three prompts) and 9.37 against 9.19 tok/s, four Sparks, 2026-11-21.
#
# Usage (overlay on top of your base ring.env):
#   bash launch/launch.sh --timed --env-file launch/ring.env --env-file launch/ring.relay.env.example
# Or pass TF_TP_KERNEL_IMAGE=/path/to/tp_mailbox.fatbin in the environment (or copy this file
# to launch/ring.relay.env and edit TF_TP_KERNEL_IMAGE for your nodes).

TF_TP_ROCE_RELAY="1"
TF_TP_ROCE_RELAY_MAX_KB="192"
TF_TP_KERNEL_IMAGE="${TF_TP_KERNEL_IMAGE:-/opt/tensorfold/images/tp_mailbox.fatbin}"
HY4_TP_DIRECT_WRITE="1"
TF_TP_ROCE_FAST="1"
TF_TP_ROCE_BLOCKS="4"
