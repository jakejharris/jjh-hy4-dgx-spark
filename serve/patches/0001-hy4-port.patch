diff --git a/zig/src/families/hy4/cuda_backend.zig b/zig/src/families/hy4/cuda_backend.zig
new file mode 100644
index 0000000000000000000000000000000000000000..675f4802df886d22b11bf951ea5834eff772c0f2
--- /dev/null
+++ b/zig/src/families/hy4/cuda_backend.zig
@@ -0,0 +1,598 @@
+//! Full Hy4 (`hy_v4_vl` / `hy_v4`) behind `lanes.backend.Backend` on 1 rank (with optional DFly2 `--drafter`) or TP=4.
+//! Steps prompts in chunks, decodes/verifies `1..16`-row chains over lossless BF16 `KvPool`, and replicates rounds via `PlanLink`.
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const tp = @import("tp");
+const boundary = @import("boundary.zig");
+const forward = @import("forward.zig");
+const kv_pool = @import("kv_pool.zig");
+const resident = @import("resident.zig");
+const drafter_mod = @import("drafter.zig");
+const draft_policy = @import("draft_policy.zig");
+const repeat_stable = @import("repeat_stable.zig");
+const vision_runtime = @import("vision_runtime.zig");
+
+const be = lanes.backend;
+const Stream = lanes.Stream;
+
+pub const prompt_rows: u32 = 1024;
+pub const round_rows: u32 = 16;
+
+pub fn activePromptRowsFrom(source: anytype) @import("sys").environment.Error!u32 {
+    const env = @import("sys").environment;
+    const explicit = try env.value(?u32, "TF_HY4_PROMPT_ROWS", source.get("TF_HY4_PROMPT_ROWS"), null);
+    const fast = try env.value(bool, "TF_HY4_FAST_PREFILL", source.get("TF_HY4_FAST_PREFILL"), false);
+    return explicit orelse if (fast) 2048 else prompt_rows;
+}
+
+pub fn activePromptRows() @import("sys").environment.Error!u32 {
+    return activePromptRowsFrom(@import("sys").environment.Process{});
+}
+pub const max_window: u32 = resident.max_decode_window;
+pub const reserve: usize = max_window;
+const ring: usize = 1024;
+
+pub fn capacity(window: usize) !usize { return if (window == 0) error.BadContext else std.math.add(usize, window, reserve); }
+
+pub fn fits(physical: usize, prompt: usize, reply: usize) bool {
+    return prompt <= physical and reply <= physical - prompt and reserve <= physical - prompt - reply;
+}
+
+const Cand = struct {
+    id: u32, logit: f32, prob: f32 = 0,
+    fn more(_: void, a: Cand, b: Cand) bool { return if (a.logit != b.logit) a.logit > b.logit else a.id < b.id; }
+};
+
+pub fn sampleRowF32(gpa: std.mem.Allocator, logits: []const f32, rule: cuda.sample.Rule, pos: u64) !u32 {
+    if (logits.len == 0) return error.EmptyVocab;
+    var max_logit: f32 = -std.math.inf(f32);
+    for (logits) |v| {
+        if (!std.math.isFinite(v)) return error.NonFiniteLogits;
+        if (v > max_logit) max_logit = v;
+    }
+    const k_lim: usize = if (rule.top_k > 0) @as(usize, @min(@as(usize, rule.top_k), logits.len)) else logits.len;
+    var cands: std.ArrayList(Cand) = .empty;
+    defer cands.deinit(gpa);
+    const floor = max_logit - rule.near / @max(rule.inv_t, 1e-6);
+    for (logits, 0..) |v, id| if (v >= floor) try cands.append(gpa, .{ .id = @intCast(id), .logit = v });
+    if (cands.items.len == 0) return resident.argmaxF32(logits);
+    std.mem.sort(Cand, cands.items, {}, Cand.more);
+    if (cands.items.len > k_lim) cands.items.len = k_lim;
+
+    const top_scaled = (cands.items[0].logit - max_logit) * rule.inv_t;
+    var sum: f32 = 0;
+    var kept: usize = 0;
+    for (cands.items) |c| {
+        const scaled = (c.logit - max_logit) * rule.inv_t;
+        if (kept > 0 and scaled - top_scaled < rule.min_log) break;
+        const p = @exp(scaled);
+        cands.items[kept] = .{ .id = c.id, .logit = c.logit, .prob = p };
+        sum += p;
+        kept += 1;
+    }
+    cands.items.len = @as(usize, @max(kept, @as(usize, 1)));
+
+    if (rule.top_p > 0 and rule.top_p < 1.0 and sum > 0) {
+        var acc: f32 = 0;
+        var p_kept: usize = 0;
+        for (cands.items) |c| {
+            acc += c.prob / sum;
+            p_kept += 1;
+            if (acc >= rule.top_p) break;
+        }
+        cands.items.len = @as(usize, @max(p_kept, @as(usize, 1)));
+        sum = 0;
+        for (cands.items) |c| sum += c.prob;
+    }
+    if (!(sum > 0)) return cands.items[0].id;
+
+    var mix: u64 = rule.seed ^ (pos *% 0x9E3779B97F4A7C15);
+    mix = (mix ^ (mix >> 30)) *% 0xBF58476D1CE4E5B9;
+    mix = (mix ^ (mix >> 27)) *% 0x94D049BB133111EB;
+    mix ^= mix >> 31;
+    const u = @as(f32, @floatFromInt(mix >> 40)) * (1.0 / 16777216.0) * sum;
+    var walk: f32 = 0;
+    for (cands.items) |c| {
+        walk += c.prob;
+        if (u <= walk) return c.id;
+    }
+    return cands.items[cands.items.len - 1].id;
+}
+
+const Lane = struct {
+    slot: usize, len: usize = 0, base: usize = 0, anchor_row: usize = 0,
+    held: [max_window]u32 = @splat(0), nheld: u32 = 0, last_asked: u32 = 0, last_offered: u32 = 0,
+    rows: std.ArrayList(u32) = .empty, last_logits: []f32, first_greedy: [1]u32 = .{0},
+    rule: ?cuda.sample.Rule = null, fill: ?usize = null,
+    pf_timers: forward.PartTimers = .{}, pf_chunks: usize = 0, pf_wall_ns: u64 = 0,
+};
+
+fn pfNowNs(io: std.Io) u64 {
+    return @intCast(@max(@as(i128, 0), std.Io.Clock.awake.now(io).toNanoseconds()));
+}
+
+pub const Hy4Backend = struct {
+    priority_copies: bool = false, untimed: bool = false, time_prefill: bool = false, gpa: std.mem.Allocator, model: *resident.ResidentModel,
+    pools: []kv_pool.KvPool, slot_anchors: []?drafter_mod.AnchorState, physical_cap: usize,
+    free: []bool, slot_last_logits: [][]f32, work_logits: []f32,
+    plan_link: ?*tp.planlink.PlanLink = null,
+    lanes_map: std.AutoHashMapUnmanaged(*const Stream, Lane) = .empty,
+    tok_ring: [ring]u32 = @splat(0), next_handle: u64 = 0,
+    draft_calls: u64 = 0, offered_tokens: u64 = 0, cut_tokens: u64 = 0, accepted_tokens: u64 = 0,
+    window_costs_buf: [7]lanes.config.Cost = undefined,
+
+    pub fn init(gpa: std.mem.Allocator, model: *resident.ResidentModel, slots: usize, physical_cap: usize) !Hy4Backend {
+        if (slots == 0) return error.NoStreamFits;
+        const pools = try gpa.alloc(kv_pool.KvPool, slots);
+        errdefer gpa.free(pools);
+        var made_pools: usize = 0;
+        errdefer for (pools[0..made_pools]) |*p| p.deinit();
+        for (pools) |*p| {
+            p.* = try kv_pool.KvPool.initSlice(gpa, model.rt.d, model.t, 0, model.layers.len, physical_cap);
+            try p.zeroFill(model.rt.stream.handle);
+            made_pools += 1;
+        }
+        const slot_anchors = try gpa.alloc(?drafter_mod.AnchorState, slots);
+        errdefer gpa.free(slot_anchors);
+        @memset(slot_anchors, null);
+        var made_anchors: usize = 0;
+        errdefer for (slot_anchors[0..made_anchors]) |*a_opt| if (a_opt.*) |*a| a.deinit();
+        if (model.drafter) |*dr| for (slot_anchors) |*a_opt| {
+            a_opt.* = try drafter_mod.AnchorState.init(gpa, model.rt.d, model.t, dr.weights.blocks.len, max_window);
+            made_anchors += 1;
+        };
+        const free = try gpa.alloc(bool, slots);
+        errdefer gpa.free(free);
+        @memset(free, true);
+        const slot_last = try gpa.alloc([]f32, slots);
+        errdefer gpa.free(slot_last);
+        var made_last: usize = 0;
+        errdefer for (slot_last[0..made_last]) |buf| gpa.free(buf);
+        for (slot_last) |*buf| { buf.* = try gpa.alloc(f32, model.t.vocab_size); made_last += 1; }
+
+        const work_logits = try gpa.alloc(f32, max_window * model.t.vocab_size);
+        const is_tp = model.tp_sess != null;
+        const blk_ms = if (model.drafter) |dr| (if (dr.step_ms <= 1.0) @as(f64, 0.5) else if (dr.weights.hasExl3()) (if (is_tp) @as(f64, 7.5) else @as(f64, 24.0)) else (if (is_tp) @as(f64, 18.0) else @as(f64, 55.0))) else 0.0;
+        const each_ms = if (model.drafter) |dr| (if (dr.step_ms <= 1.0) @as(f64, 0.2) else if (dr.weights.custom_head != null and dr.weights.custom_head.?.hasExl3()) (if (is_tp) @as(f64, 0.6) else @as(f64, 2.0)) else dr.step_ms) else 0.0;
+        var spec_buf: [4096]u8 = undefined;
+        const rs = try repeat_stable.resolve(boundary.envStr("TF_HY4_ROW_COST_TABLE"), boundary.envStr("TF_HY4_REPEAT_STABLE"), &spec_buf);
+        const tbl = if (rs.table_spec) |tbl_env|
+            try draft_policy.CostParams.parseSpecOrFile(gpa, model.io, tbl_env, blk_ms, each_ms)
+        else
+            draft_policy.defaultR11CostParams(model.layers.len, is_tp, blk_ms, each_ms);
+        var wc: [7]lanes.config.Cost = undefined;
+        for (&wc, 0..) |*slot, d| slot.* = .{ .width = @intCast(d + 1), .ms = tbl.roundMs(d) };
+        const time_prefill = try @import("sys").environment.read(bool, "TF_HY4_PREFILL_TIMERS", false);
+        return .{
+            .untimed = rs.untimed, .time_prefill = time_prefill, .gpa = gpa, .model = model, .pools = pools, .slot_anchors = slot_anchors,
+            .physical_cap = physical_cap, .free = free, .slot_last_logits = slot_last,
+            .work_logits = work_logits, .window_costs_buf = wc,
+        };
+    }
+
+    pub fn deinit(self: *Hy4Backend) void {
+        var it = self.lanes_map.valueIterator();
+        while (it.next()) |l| l.rows.deinit(self.gpa);
+        self.lanes_map.deinit(self.gpa);
+        self.gpa.free(self.work_logits);
+        for (self.slot_last_logits) |buf| self.gpa.free(buf);
+        self.gpa.free(self.slot_last_logits);
+        self.gpa.free(self.free);
+        for (self.slot_anchors) |*a_opt| if (a_opt.*) |*a| a.deinit();
+        self.gpa.free(self.slot_anchors);
+        for (self.pools) |*p| p.deinit();
+        self.gpa.free(self.pools);
+        self.* = undefined;
+    }
+
+    fn execForward(self: *Hy4Backend, slot: usize, first_pos: usize, tokens: []const u32, anc_off: usize, anc_rows: usize) !void {
+        return self.execStep(slot, first_pos, tokens, anc_off, anc_rows, null);
+    }
+
+    fn execStep(self: *Hy4Backend, slot: usize, first_pos: usize, tokens: []const u32, anc_off: usize, anc_rows: usize, greedy_ids: ?[]u32) !void {
+        if (self.plan_link) |pl| if (pl.rank == 0) {
+            var frame = try self.gpa.alloc(i64, 6 + tokens.len);
+            defer self.gpa.free(frame);
+            const op = if (greedy_ids != null) boundary.PlanOp.forward_greedy else boundary.PlanOp.forward_step;
+            frame[0..6].* = .{ @intFromEnum(op), @intCast(slot), @intCast(first_pos), @intCast(anc_off), @intCast(anc_rows), @intCast(tokens.len) };
+            for (tokens, 0..) |tok, i| frame[6 + i] = tok;
+            try pl.send(frame);
+        };
+        self.model.sc.vision_slot = slot; defer self.model.sc.vision_slot = null;
+        if (greedy_ids) |ids| return self.model.forwardGreedy(&self.pools[slot], first_pos, tokens, ids);
+        const anc: ?*drafter_mod.AnchorState = if (anc_rows > 0 and self.slot_anchors[slot] != null) &self.slot_anchors[slot].? else null;
+        try self.model.forwardStepAnchor(&self.pools[slot], first_pos, tokens, anc, anc_off, anc_rows);
+    }
+
+    fn execLogits(self: *Hy4Backend, slot: usize, row_offset: usize, rows: usize, logits_out: []f32, capture_anc: bool) !void {
+        if (self.plan_link) |pl| if (pl.rank == 0) {
+            try pl.send(&.{ @intFromEnum(boundary.PlanOp.compute_logits), @intCast(slot), @intCast(row_offset), @intCast(rows), @intFromBool(capture_anc) });
+        };
+        const anc: ?*drafter_mod.AnchorState = if (capture_anc and self.slot_anchors[slot] != null) &self.slot_anchors[slot].? else null;
+        try self.model.computeLogitsAnchor(row_offset, rows, logits_out, anc);
+    }
+
+    fn execClearRange(self: *Hy4Backend, slot: usize, from_pos: usize, to_pos: usize) !void {
+        if (self.plan_link) |pl| if (pl.rank == 0) {
+            try pl.send(&.{ @intFromEnum(boundary.PlanOp.clear_range), @intCast(slot), @intCast(from_pos), @intCast(to_pos) });
+        };
+        try self.pools[slot].clearRange(self.model.t, from_pos, to_pos, self.model.rt.stream.handle);
+    }
+
+    fn execGreedy(self: *Hy4Backend, slot: usize, row_offset: usize, ids: []u32, capture_anc: bool) !void {
+        if (self.plan_link) |pl| if (pl.rank == 0) {
+            try pl.send(&.{ @intFromEnum(boundary.PlanOp.greedy_rows), @intCast(slot), @intCast(row_offset), @intCast(ids.len), @intFromBool(capture_anc) });
+        };
+        const anc: ?*drafter_mod.AnchorState = if (capture_anc and self.slot_anchors[slot] != null) &self.slot_anchors[slot].? else null;
+        try self.model.computeGreedyAnchor(row_offset, ids, anc);
+    }
+
+    pub fn followLoop(self: *Hy4Backend) !void {
+        const pl = self.plan_link orelse return error.NotFollower;
+        var frame_buf: std.ArrayList(i64) = .empty;
+        defer frame_buf.deinit(self.gpa);
+        var tok_buf: std.ArrayList(u32) = .empty;
+        defer tok_buf.deinit(self.gpa);
+        var held_tmp: [max_window]u32 = @splat(0);
+
+        while (true) {
+            const msg = pl.recvGrow(self.gpa, &frame_buf) catch |err| switch (err) {
+                error.PeerClosed => return,
+                else => return err,
+            };
+            if (msg.len == 0) continue;
+            switch (@as(boundary.PlanOp, @enumFromInt(msg[0]))) {
+                .forward_step, .forward_greedy => {
+                    if (msg.len < 6) return error.Protocol;
+                    const slot: usize = @intCast(msg[1]);
+                    const first_pos: usize = @intCast(msg[2]);
+                    const anc_off: usize = @intCast(msg[3]);
+                    const anc_rows: usize = @intCast(msg[4]);
+                    const count: usize = @intCast(msg[5]);
+                    if (slot >= self.pools.len or msg.len != 6 + count) return error.Protocol;
+                    try tok_buf.resize(self.gpa, count);
+                    for (0..count) |i| tok_buf.items[i] = @intCast(msg[6 + i]);
+                    self.model.sc.vision_slot = slot; defer self.model.sc.vision_slot = null;
+                    if (msg[0] == @intFromEnum(boundary.PlanOp.forward_greedy)) {
+                        var ids: [max_window]u32 = undefined;
+                        if (count == 0 or count > ids.len) return error.Protocol;
+                        self.model.forwardGreedy(&self.pools[slot], first_pos, tok_buf.items, ids[0..count]) catch |err| switch (err) {
+                            error.NonFiniteLogits => continue,
+                            else => return err,
+                        };
+                    } else {
+                        const anc: ?*drafter_mod.AnchorState = if (anc_rows > 0 and self.slot_anchors[slot] != null) &self.slot_anchors[slot].? else null;
+                        try self.model.forwardStepAnchor(&self.pools[slot], first_pos, tok_buf.items, anc, anc_off, anc_rows);
+                    }
+                },
+                .compute_logits => {
+                    if (msg.len != 5) return error.Protocol;
+                    const slot: usize = @intCast(msg[1]);
+                    const row_off: usize = @intCast(msg[2]);
+                    const rows: usize = @intCast(msg[3]);
+                    const cap_anc = msg[4] != 0;
+                    if (slot >= self.pools.len) return error.Protocol;
+                    const anc: ?*drafter_mod.AnchorState = if (cap_anc and self.slot_anchors[slot] != null) &self.slot_anchors[slot].? else null;
+                    try self.model.computeLogitsAnchor(row_off, rows, self.work_logits[0 .. rows * self.model.t.vocab_size], anc);
+                },
+                .clear_range => {
+                    if (msg.len != 4) return error.Protocol;
+                    const slot: usize = @intCast(msg[1]);
+                    const from_pos: usize = @intCast(msg[2]);
+                    const to_pos: usize = @intCast(msg[3]);
+                    if (slot >= self.pools.len) return error.Protocol;
+                    try self.pools[slot].clearRange(self.model.t, from_pos, to_pos, self.model.rt.stream.handle);
+                },
+                .draft_propose => {
+                    if (msg.len != 8) return error.Protocol;
+                    const slot: usize = @intCast(msg[1]);
+                    const anchor_row: usize = @intCast(msg[2]);
+                    const pos: usize = @intCast(msg[3]);
+                    const bonus: u32 = @intCast(msg[4]);
+                    const hold_cap: usize = @intCast(msg[5]);
+                    const is_greedy = msg[6] != 0;
+                    const mm_bits: u32 = @intCast(msg[7]);
+                    if (slot >= self.pools.len or hold_cap >= max_window) return error.Protocol;
+                    const dr = &(self.model.drafter orelse return error.NoDraftHead);
+                    dr.min_margin_override = if (mm_bits == 0) null else @bitCast(mm_bits);
+                    defer dr.min_margin_override = null;
+                    const anc = &(self.slot_anchors[slot] orelse return error.NoDraftHead);
+                    const hd = self.model.head orelse return error.HeadSkipped;
+                    const DummyPick = struct { fn pick(_: *anyopaque, _: []const f32, _: u64) !u32 { return 0; } };
+                    var dummy: u8 = 0;
+                    self.model.sc.mrope = if (self.model.vision) |vr| vr.slotRopeDelta(slot) else null; defer self.model.sc.mrope = null;
+                    _ = try dr.proposeTp(&self.model.rt, &self.model.sc, self.model.t, self.model.trunk.embed_bf16, hd, self.model.layers.len, &self.pools[slot], anc, anchor_row, pos, bonus, hold_cap, self.model.tp_sess, is_greedy, DummyPick.pick, &dummy, held_tmp[0..hold_cap]);
+                },
+                .vision_set, .vision_clear => try (self.model.vision orelse return error.Protocol).applyFollowerMsg(msg),
+                .greedy_rows => {
+                    if (msg.len != 5 or msg[1] < 0 or msg[2] < 0 or msg[3] < 1 or msg[3] > max_window) return error.Protocol;
+                    const slot: usize = @intCast(msg[1]);
+                    if (slot >= self.pools.len) return error.Protocol;
+                    const anc: ?*drafter_mod.AnchorState = if (msg[4] != 0 and self.slot_anchors[slot] != null) &self.slot_anchors[slot].? else null;
+                    var ids: [max_window]u32 = undefined;
+                    self.model.computeGreedyAnchor(@intCast(msg[2]), ids[0..@intCast(msg[3])], anc) catch |err| switch (err) {
+                        error.NonFiniteLogits => continue,
+                        else => return err,
+                    };
+                },
+                .stop => return,
+            }
+        }
+    }
+
+    pub fn backend(self: *Hy4Backend) be.Backend { return .{ .ptr = self, .vtable = &vtable }; }
+
+    pub fn facts(self: *const Hy4Backend) lanes.Model {
+        const dr_opt = if (self.model.drafter) |*d| d else null;
+        return .{
+            .fixed_draft_block = dr_opt != null, .plain_guard = dr_opt != null,
+            .copy_drafts = dr_opt == null, .lone_copies = dr_opt == null, .untimed = self.untimed,
+            .root_copies = self.priority_copies, .context_copies = self.priority_copies,
+            .copy_match = if (self.priority_copies) 4 else 8, .exact_width = max_window,
+            .gpu_tokens = false, .mtp = dr_opt != null, .speculate = dr_opt != null, .speculate_early = false,
+            .draft_prior = if (dr_opt != null) &draft_policy.default_rates else &.{},
+            .drafts = if (dr_opt) |d| @intCast(@as(usize, @min(@as(usize, d.maxProposals()), @as(usize, max_window - 1)))) else 0,
+            .window_costs = if (dr_opt != null) &self.window_costs_buf else &.{}, .window_costs_lone = true,
+            .mtp_step_ms = 0.0, .hidden_rows = true, .batch_rows = round_rows,
+            .max_streams = @intCast(@as(usize, @min(self.pools.len, @as(usize, round_rows)))),
+        };
+    }
+
+    const vtable: be.Backend.VTable = .{
+        .prefill = prefill, .prefill_step = prefillStep, .cancel_prefill = cancelPrefill,
+        .first = first, .queue = queue, .read = read, .verify = verify, .keep = keep,
+        .draft = draft, .tree = heldTree, .held = held, .release = release, .reports_fill = true,
+    };
+
+    fn castSelf(ptr: *anyopaque) *Hy4Backend { return @ptrCast(@alignCast(ptr)); }
+    fn freeSlot(self: *const Hy4Backend) ?usize { return std.mem.indexOfScalar(bool, self.free, true); }
+    fn resolveFeed(self: *Hy4Backend, feed: be.Feed) !u32 { return switch (feed) { .value => |v| v, .handle => |h| read(self, h) }; }
+
+    fn pushToken(self: *Hy4Backend, tok: u32) u64 {
+        const h = self.next_handle;
+        self.tok_ring[@intCast(h % ring)] = tok;
+        self.next_handle += 1;
+        return h;
+    }
+
+    fn opening(self: *Hy4Backend, s: *Stream) !*Lane {
+        const p = s.prompt();
+        if (p.len == 0) return error.EmptyPrompt;
+        if (s.images.len > 0 and self.model.vision == null) return error.Hy4TextOnly;
+        if (!fits(self.physical_cap, p.len, @as(usize, s.max_new))) return error.PastContext;
+        const gop = try self.lanes_map.getOrPut(self.gpa, s);
+        if (!gop.found_existing) {
+            const slot = self.freeSlot() orelse { self.lanes_map.removeByPtr(gop.key_ptr); return error.NoFreeSlot; };
+            self.free[slot] = false;
+            gop.value_ptr.* = .{ .slot = slot, .last_logits = self.slot_last_logits[slot] };
+        }
+        errdefer self.dropLane(s);
+        const l = gop.value_ptr;
+        try vision_runtime.openSlot(self.model.vision, l.slot, p.len, s.images, self.plan_link, self.model.tp_sess);
+        l.len = 0; l.base = 0; l.anchor_row = 0; l.nheld = 0; l.last_asked = 0; l.last_offered = 0;
+        l.rule = cuda.sample.ruleFor(s.sampling);
+        s.cached = 0;
+        if (s.reuse.saved != null) s.reuse_failed = true;
+        l.fill = 0;
+        l.pf_timers = .{}; l.pf_chunks = 0; l.pf_wall_ns = 0;
+        s.fill_at.store(0, .monotonic);
+        return l;
+    }
+
+    fn chunk(self: *Hy4Backend, s: *Stream, l: *Lane) !bool {
+        const p = s.prompt();
+        const at = l.fill.?;
+        if (s.isCancelled()) { s.keepInterruptedPrefill(@intCast(at)); return error.Cancelled; }
+        const step_rows: usize = self.model.chunk_rows;
+        const end: usize = @min(p.len, (at / step_rows + 1) * step_rows);
+        const done = end == p.len;
+        const n = end - at;
+        const t0: u64 = if (self.time_prefill) blk: {
+            self.model.rt.parts = &l.pf_timers;
+            self.model.rt.parts_io = self.model.io;
+            break :blk pfNowNs(self.model.io);
+        } else 0;
+        defer if (self.time_prefill) {
+            self.model.rt.parts = null;
+            self.model.rt.parts_io = null;
+        };
+        try self.execForward(l.slot, at, p[at..end], n - 1, if (done) 1 else 0);
+        if (self.time_prefill) l.pf_chunks += 1;
+        if (done) {
+            const th0: u64 = if (self.time_prefill) pfNowNs(self.model.io) else 0;
+            if (l.rule == null) try self.execGreedy(l.slot, n - 1, &l.first_greedy, true)
+            else try self.execLogits(l.slot, n - 1, 1, l.last_logits, true);
+            if (self.time_prefill) {
+                try self.model.rt.stream.synchronize();
+                l.pf_timers.head_ns += pfNowNs(self.model.io) -| th0;
+            }
+        }
+        if (self.time_prefill) {
+            l.pf_wall_ns += pfNowNs(self.model.io) -| t0;
+            if (done and (if (self.model.tp_sess) |tps| tps.rank_idx == 0 else true)) {
+                const pt = l.pf_timers;
+                const wall_s = @as(f64, @floatFromInt(l.pf_wall_ns)) / 1e9;
+                const tok_s = if (wall_s > 0) @as(f64, @floatFromInt(p.len)) / wall_s else 0;
+                std.log.info("hy4 prefill-parts: T={d} chunks={d} chunk_rows={d} wall_s={d:.3} trunk_s={d:.3} experts_s={d:.3} attn_s={d:.3} index_s={d:.3} other_local_s={d:.3} tp_gather_s={d:.3} head_s={d:.3} tok_s={d:.2}", .{
+                    p.len, l.pf_chunks, self.model.chunk_rows, wall_s, @as(f64, @floatFromInt(pt.trunk_ns)) / 1e9, @as(f64, @floatFromInt(pt.experts_ns)) / 1e9, @as(f64, @floatFromInt(pt.attn_ns)) / 1e9, @as(f64, @floatFromInt(pt.index_ns)) / 1e9, @as(f64, @floatFromInt(pt.other_local_ns)) / 1e9, @as(f64, @floatFromInt(pt.tp_gather_ns)) / 1e9, @as(f64, @floatFromInt(pt.head_ns)) / 1e9, tok_s,
+                });
+            }
+        }
+        s.fill_at.store(@intCast(end), .monotonic);
+        l.fill = if (done) null else end;
+        if (done) { l.len = p.len; l.anchor_row = 0; }
+        return done;
+    }
+
+    fn prefill(ptr: *anyopaque, s: *Stream) anyerror!void {
+        const self = castSelf(ptr);
+        const l = try self.opening(s);
+        errdefer self.dropLane(s);
+        while (!try self.chunk(s, l)) {}
+    }
+
+    fn prefillStep(ptr: *anyopaque, s: *Stream, _: u32) anyerror!bool {
+        const self = castSelf(ptr);
+        const going = if (self.lanes_map.getPtr(s)) |l| l.fill != null else false;
+        const l = if (going) self.lanes_map.getPtr(s).? else try self.opening(s);
+        errdefer self.dropLane(s);
+        return self.chunk(s, l);
+    }
+
+    fn cancelPrefill(ptr: *anyopaque, s: *Stream) !void {
+        const l = castSelf(ptr).lanes_map.getPtr(s) orelse return;
+        if (l.fill) |at| s.keepInterruptedPrefill(@intCast(at));
+    }
+
+    fn first(ptr: *anyopaque, s: *Stream, position: u64) anyerror!u64 {
+        const self = castSelf(ptr);
+        const l = self.lanes_map.getPtr(s) orelse return error.UnknownStream;
+        if (position != l.len or l.fill != null) return error.PositionMismatch;
+        return self.pushToken(if (l.rule) |r| try sampleRowF32(self.gpa, l.last_logits, r, position) else l.first_greedy[0]);
+    }
+
+    fn queue(ptr: *anyopaque, s: *Stream, feed: be.Feed, position: u64) anyerror!u64 {
+        const self = castSelf(ptr);
+        const l = self.lanes_map.getPtr(s) orelse return error.UnknownStream;
+        const tok = try self.resolveFeed(feed);
+        if (position != l.len + 1) return error.PositionMismatch;
+        l.nheld = 0; l.last_offered = 0;
+        try self.execForward(l.slot, l.len, &.{tok}, 0, 1);
+        var id: [1]u32 = undefined;
+        if (l.rule) |r| {
+            const logits = self.work_logits[0..self.model.t.vocab_size];
+            try self.execLogits(l.slot, 0, 1, logits, true);
+            id[0] = try sampleRowF32(self.gpa, logits, r, position);
+        } else try self.execGreedy(l.slot, 0, &id, true);
+        l.len += 1; l.anchor_row = 0;
+        return self.pushToken(id[0]);
+    }
+
+    fn read(ptr: *anyopaque, h: u64) anyerror!u32 {
+        const self = castSelf(ptr);
+        if (h >= self.next_handle or self.next_handle - h > ring) return error.NoSuchToken;
+        return self.tok_ring[@intCast(h % ring)];
+    }
+
+    fn verify(ptr: *anyopaque, windows: []const be.Window, out: []be.Verified) anyerror!void {
+        const self = castSelf(ptr);
+        if (windows.len > round_rows) return error.RoundTooWide;
+        var total: usize = 0;
+        for (windows) |w| {
+            if (w.parents != null) return error.ChainsOnly;
+            if (w.masks.len != 0) return error.StructuresUnsupported;
+            const l = self.lanes_map.getPtr(w.stream) orelse return error.UnknownStream;
+            if (w.held > l.nheld) return error.Hy4DraftsNotHeld;
+            if (w.rows() > max_window) return error.WindowTooWide;
+            l.base = l.len;
+            l.rows.clearRetainingCapacity();
+            try l.rows.append(self.gpa, w.pending);
+            if (w.held > 0) try l.rows.appendSlice(self.gpa, l.held[0..w.held]);
+            try l.rows.appendSlice(self.gpa, w.tokens);
+            l.last_offered = w.held;
+            l.nheld = 0;
+            for (w.positions, 0..) |pos, r| if (pos != l.base + r + 1) return error.PositionMismatch;
+            total += l.rows.items.len;
+        }
+        if (total > round_rows) return error.RoundTooWide;
+
+        const v: usize = self.model.t.vocab_size;
+        for (windows, out) |w, o| {
+            const l = self.lanes_map.getPtr(w.stream).?;
+            const n = l.rows.items.len;
+            const graph_pick = l.rule == null and self.slot_anchors[l.slot] == null and n <= 3 and l.base >= self.model.t.index_topk and self.model.sc.graph_mode != .off and !vision_runtime.hasActiveSlot(self.model.vision, l.slot);
+            if (graph_pick) {
+                try self.execStep(l.slot, l.base, l.rows.items, 0, 0, o.sampled[0..n]);
+            } else {
+                try self.execForward(l.slot, l.base, l.rows.items, 0, n);
+                if (l.rule) |rule| {
+                    const logits = self.work_logits[0 .. n * v];
+                    try self.execLogits(l.slot, 0, n, logits, true);
+                    for (0..n) |r| o.sampled[r] = try sampleRowF32(self.gpa, logits[r * v ..][0..v], rule, w.positions[r]);
+                } else try self.execGreedy(l.slot, 0, o.sampled[0..n], true);
+            }
+            @memcpy(o.drafts[0 .. n - 1], l.rows.items[1..]);
+            l.len = l.base + n;
+        }
+    }
+
+    fn keep(ptr: *anyopaque, windows: []const be.Window, paths: []const []const u32) anyerror!void {
+        const self = castSelf(ptr);
+        for (windows, paths) |w, path| {
+            const l = self.lanes_map.getPtr(w.stream) orelse return error.UnknownStream;
+            if (path.len == 0 or path.len > l.rows.items.len) return error.EmptyPath;
+            for (path, 0..) |r, j| if (r != j) return error.ChainsOnly;
+            const new_len = l.base + path.len;
+            if (new_len < l.len) try self.execClearRange(l.slot, new_len, l.len);
+            if (l.last_offered > 0) {
+                self.accepted_tokens += @as(u64, @min(@as(usize, l.last_offered), path.len - 1));
+                l.last_offered = 0;
+            }
+            l.len = new_len; l.anchor_row = path.len - 1;
+        }
+    }
+
+    fn pickToken(self: *Hy4Backend, l: *const Lane, logits: []const f32, pos: u64) !u32 {
+        return if (l.rule) |r| sampleRowF32(self.gpa, logits, r, pos) else resident.argmaxF32(logits);
+    }
+
+    const DraftPickCtx = struct {
+        hb: *Hy4Backend, lane: *const Lane,
+        fn pick(raw: *anyopaque, logits: []const f32, pos: u64) !u32 {
+            const c: *const @This() = @ptrCast(@alignCast(raw));
+            return c.hb.pickToken(c.lane, logits, pos);
+        }
+    };
+
+    fn draft(ptr: *anyopaque, requests: []const be.DraftRequest) anyerror!void {
+        const self = castSelf(ptr);
+        for (requests) |r| {
+            if (r.lanes != null) return error.ChainsOnly;
+            const l = self.lanes_map.getPtr(r.stream) orelse return error.UnknownStream;
+            l.nheld = 0; l.last_asked = r.depth;
+            if (r.depth == 0) continue;
+            const dr = &(self.model.drafter orelse return error.NoDraftHead);
+            const anc = &(self.slot_anchors[l.slot] orelse return error.NoDraftHead);
+            const hd = self.model.head orelse return error.HeadSkipped;
+            var anchor_row = l.anchor_row;
+            if (r.rows) |rows| {
+                if (rows.len == 0) return error.EmptyPath;
+                for (rows, 0..) |x, j| if (x != j) return error.ChainsOnly;
+                anchor_row = rows[rows.len - 1];
+            }
+            const bonus: u32 = if (r.follow.len > 0) r.follow[r.follow.len - 1] else try self.resolveFeed(r.first orelse return error.NoFirstToken);
+            if (r.position != l.len + 1) return error.PositionMismatch;
+            const hold_cap: usize = @min(@as(usize, r.depth), @as(usize, max_window - 1));
+            const is_greedy = (l.rule == null);
+            const mm_opt = dr.min_margin_override orelse try draft_policy.envMinMargin();
+            const mm_bits: u32 = if (mm_opt) |mm| @bitCast(mm) else 0;
+            if (self.plan_link) |pl| if (pl.rank == 0) {
+                try pl.send(&.{ @intFromEnum(boundary.PlanOp.draft_propose), @intCast(l.slot), @intCast(anchor_row), @intCast(l.len), @intCast(bonus), @intCast(hold_cap), @intFromBool(is_greedy), mm_bits });
+            };
+            var pctx: DraftPickCtx = .{ .hb = self, .lane = l };
+            self.model.sc.mrope = if (self.model.vision) |vr| vr.slotRopeDelta(l.slot) else null; defer self.model.sc.mrope = null;
+            const cnt = draft_policy.resolveEffectiveDepth(hold_cap, try dr.proposeTp(&self.model.rt, &self.model.sc, self.model.t, self.model.trunk.embed_bf16, hd, self.model.layers.len, &self.pools[l.slot], anc, anchor_row, l.len, bonus, hold_cap, self.model.tp_sess, is_greedy, DraftPickCtx.pick, &pctx, l.held[0..hold_cap]));
+            l.nheld = @intCast(cnt);
+            self.draft_calls += 1; self.offered_tokens += cnt; self.cut_tokens += hold_cap - cnt;
+            r.stream.draft_calls += 1; r.stream.offered += cnt;
+        }
+    }
+
+    fn heldTree(ptr: *anyopaque, s: *Stream, _: std.mem.Allocator) anyerror!?lanes.stream.Held {
+        const l = castSelf(ptr).lanes_map.getPtr(s) orelse return error.UnknownStream;
+        return if (l.nheld < l.last_asked) .{ .count = l.nheld } else null;
+    }
+    fn held(ptr: *anyopaque, s: *Stream, out: []u32) anyerror!void {
+        const l = castSelf(ptr).lanes_map.getPtr(s) orelse return error.UnknownStream;
+        if (out.len > l.nheld) return error.Hy4DraftsNotHeld;
+        @memcpy(out, l.held[0..out.len]);
+    }
+    fn dropLane(self: *Hy4Backend, s: *const Stream) void {
+        if (self.lanes_map.fetchRemove(s)) |entry| {
+            var l = entry.value;
+            self.free[l.slot] = true; l.rows.deinit(self.gpa);
+        }
+    }
+    fn release(ptr: *anyopaque, s: *Stream) void { castSelf(ptr).dropLane(s); }
+};
diff --git a/zig/src/families/hy4/cuda_native.zig b/zig/src/families/hy4/cuda_native.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ca8f61d5458404d4d7afa0dd4273239228f25721
--- /dev/null
+++ b/zig/src/families/hy4/cuda_native.zig
@@ -0,0 +1,509 @@
+//! Full Hy4 (`hy_v4_vl` and `hy_v4`) behind TensorFold's native CUDA registry (`zig/src/native/cuda_families.zig`).
+//! Supports 1-rank serving (with optional DFly2 `--drafter`) and 4-rank (`--tp 4`) serving with `PlanLink` follower lockstep.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const config = @import("config.zig");
+const ranks = @import("ranks.zig");
+const boundary = @import("boundary.zig");
+const weights = @import("weights.zig");
+const trunk_exl3 = @import("trunk_exl3.zig");
+const kv_pool = @import("kv_pool.zig");
+const drafter_mod = @import("drafter.zig");
+const resident = @import("resident.zig");
+const cuda_backend = @import("cuda_backend.zig");
+const vision_config = @import("vision_config.zig");
+const vision_image = @import("vision_image.zig");
+const vision_weights = @import("vision_weights.zig");
+const vision_runtime = @import("vision_runtime.zig");
+
+pub const native = Native("hy_v4_vl");
+pub const native_text = Native("hy_v4");
+
+pub const HostRoom = struct {
+    ctx: *anyopaque,
+    read: *const fn (*anyopaque) ?u64,
+};
+
+pub fn fitSlots(room: u64, asked: u32, fixed: bool, fixed_bytes: u64, slot_bytes: u64) !usize {
+    const most: usize = cuda_backend.round_rows;
+    if (fixed and asked > most) return error.ParallelPastRound;
+    var n: usize = std.math.clamp(@as(usize, if (fixed) asked else 1), 1, most);
+    while (fixed_bytes + n * slot_bytes > room) : (n -= 1) {
+        if (fixed) return error.ParallelPastMemory;
+        if (n == 1) return error.NoStreamFits;
+    }
+    return n;
+}
+
+pub fn trunkLabel(layers: []const weights.LayerWeights) []const u8 {
+    var has_3b = false;
+    var has_4b = false;
+    var has_6b = false;
+    var has_other = false;
+    const note = struct {
+        fn f(p: weights.LinearProj, b3: *bool, b4: *bool, b6: *bool, bo: *bool) void {
+            if (p != .exl3) return;
+            switch (p.exl3.weight.halves) {
+                6 => b3.* = true,
+                8 => b4.* = true,
+                12 => b6.* = true,
+                else => bo.* = true,
+            }
+        }
+    }.f;
+    for (layers) |lw| {
+        inline for (.{ lw.q_a, lw.q_b, lw.kv_a, lw.linear_gate, lw.o_proj }) |p| note(p, &has_3b, &has_4b, &has_6b, &has_other);
+        const dn: weights.DenseMlp = switch (lw.mlp) {
+            .dense => |d| d,
+            .sparse_bf16 => |sp| sp.shared,
+            .sparse_exl3 => |sp| sp.shared,
+        };
+        inline for (.{ dn.gate, dn.up, dn.down }) |p| note(p, &has_3b, &has_4b, &has_6b, &has_other);
+    }
+    if (!has_3b and !has_4b and !has_6b and !has_other) return "lossless";
+    if (has_4b and has_6b and !has_3b and !has_other) return "4b6b";
+    if (has_4b and !has_6b and !has_3b and !has_other) return "4b";
+    if (has_6b and !has_4b and !has_3b and !has_other) return "6b";
+    if (has_3b and !has_4b and !has_6b and !has_other) return "3b";
+    return "exl3-mixed";
+}
+
+pub fn drafterLabel(drafts_enabled: bool, dr_opt: ?*const drafter_mod.Drafter) []const u8 {
+    if (dr_opt) |dr| return dr.quantLabel();
+    return if (drafts_enabled) "prompt-copy" else "none";
+}
+
+pub fn formatServeRunTag(
+    buf: []u8, context: usize, lanes_n: u32, lanes_fixed: bool, has_drafter: bool,
+    direct_write: bool, p_rows: u32, sw: cuda.hy4_kernels.PrefillSwitches, d_tag: []const u8,
+    vis_limits: ?vision_image.Limits,
+) ![]const u8 {
+    if (vis_limits) |vl| {
+        return std.fmt.bufPrint(buf, "serve:{d}:{d}:{}:{}:{}:{d}:{}:{}:{}:{}:{s}:{d}:{s}:vis={d}:{d}", .{
+            context, lanes_n, lanes_fixed, has_drafter, direct_write, p_rows,
+            sw.fast_prefill, sw.fast_routed, sw.fast_mla, sw.fast_indexer, @tagName(sw.prefill_ar), sw.min_prefill_rows, d_tag,
+            vl.image_tokens, vl.max_images,
+        });
+    }
+    return std.fmt.bufPrint(buf, "serve:{d}:{d}:{}:{}:{}:{d}:{}:{}:{}:{}:{s}:{d}:{s}", .{
+        context, lanes_n, lanes_fixed, has_drafter, direct_write, p_rows,
+        sw.fast_prefill, sw.fast_routed, sw.fast_mla, sw.fast_indexer, @tagName(sw.prefill_ar), sw.min_prefill_rows, d_tag,
+    });
+}
+
+pub fn formatLoadedLog(
+    buf: []u8, mt: []const u8, tp: u32, rank: u32, load_ns: u64, layers: usize,
+    n_slots: usize, slot_bytes: u64, context: usize, weight_bytes: u64, room_bytes: u64,
+    trunk_lbl: []const u8, drafter_lbl: []const u8, head_lbl: []const u8, repeat_stable: bool,
+) ![]const u8 {
+    return std.fmt.bufPrint(
+        buf,
+        "Hy4 ({s}, tp={d} rank={d}) loaded in {d:.2} s: {d} layers, {d} stream{s}, {d:.2} GiB lossless BF16 KV/stream at {d} window, weights={d:.2} GiB (weight_bytes={d}), room_after_reserve={d:.2} GiB, trunk={s}, drafter={s}, head={s}, repeat_stable={s}",
+        .{
+            mt, tp, rank, @as(f64, @floatFromInt(load_ns)) / 1e9,
+            layers, n_slots, if (n_slots == 1) "" else "s",
+            @as(f64, @floatFromInt(slot_bytes)) / (1 << 30), context,
+            @as(f64, @floatFromInt(weight_bytes)) / (1 << 30), weight_bytes,
+            @as(f64, @floatFromInt(room_bytes)) / (1 << 30),
+            trunk_lbl, drafter_lbl, head_lbl, if (repeat_stable) "on" else "off",
+        },
+    );
+}
