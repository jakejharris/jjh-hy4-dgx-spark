@@ -0,0 +1,405 @@
+//! Safetensors dump writer and single-layer replay input reader for offline reference comparison.
+const std = @import("std");
+const core = @import("core");
+const st = core.safetensors;
+
+pub const Dump = struct {
+    gpa: std.mem.Allocator,
+    arena: std.heap.ArenaAllocator,
+    entries: std.ArrayList(core.shard_edit.New) = .empty,
+
+    pub fn init(gpa: std.mem.Allocator) Dump {
+        return .{
+            .gpa = gpa,
+            .arena = std.heap.ArenaAllocator.init(gpa),
+        };
+    }
+
+    pub fn deinit(self: *Dump) void {
+        self.entries.deinit(self.gpa);
+        self.arena.deinit();
+        self.* = undefined;
+    }
+
+    pub fn put(self: *Dump, name: []const u8, dtype: st.DType, shape: []const usize, bytes: []const u8) !void {
+        const a = self.arena.allocator();
+        try self.entries.append(self.gpa, .{
+            .name = try a.dupe(u8, name),
+            .dtype = dtype,
+            .shape = try a.dupe(usize, shape),
+            .bytes = try a.dupe(u8, bytes),
+        });
+    }
+
+    pub fn recordInputIds(self: *Dump, ids: []const u32, batch: usize, seq_len: usize) !void {
+        return self.recordTokenIdsNamed("input_ids", ids, batch, seq_len);
+    }
+
+    pub fn recordTokenIdsNamed(self: *Dump, name: []const u8, ids: []const u32, batch: usize, seq_len: usize) !void {
+        if (ids.len != batch * seq_len) return error.BadOracleShape;
+        const a = self.arena.allocator();
+        const wide = try a.alloc(i64, ids.len);
+        for (ids, wide) |id, *dst| dst.* = @intCast(id);
+        try self.entries.append(self.gpa, .{
+            .name = try a.dupe(u8, name),
+            .dtype = .i64,
+            .shape = try a.dupe(usize, &.{ batch, seq_len }),
+            .bytes = std.mem.sliceAsBytes(wide),
+        });
+    }
+
+    pub fn recordStreams(
+        self: *Dump,
+        layer: usize,
+        is_out: bool,
+        bf16_bytes: []const u8,
+        batch: usize,
+        seq_len: usize,
+        hc_mult: usize,
+        hidden: usize,
+    ) !void {
+        var buf: [64]u8 = undefined;
+        const suffix = if (is_out) "streams_out" else "streams_in";
+        const key = try std.fmt.bufPrint(&buf, "layer.{d:0>3}.{s}", .{ layer, suffix });
+        try self.put(key, .bf16, &.{ batch, seq_len, hc_mult, hidden }, bf16_bytes);
+    }
+
+    pub fn recordLayerBf16(
+        self: *Dump,
+        layer: usize,
+        field: []const u8,
+        bf16_bytes: []const u8,
+        batch: usize,
+        seq_len: usize,
+        hidden: usize,
+    ) !void {
+        var buf: [64]u8 = undefined;
+        const key = try std.fmt.bufPrint(&buf, "layer.{d:0>3}.{s}", .{ layer, field });
+        try self.put(key, .bf16, &.{ batch, seq_len, hidden }, bf16_bytes);
+    }
+
+    /// Sort each row ascending (with -1 unused causal sentinels first) and store as int32 [B, T, K].
+    pub fn recordIndexPositions(
+        self: *Dump,
+        layer: usize,
+        positions: []const i32,
+        batch: usize,
+        seq_len: usize,
+        topk: usize,
+        first_pos: usize,
+    ) !void {
+        if (positions.len != batch * seq_len * topk) return error.BadOracleShape;
+        const a = self.arena.allocator();
+        const sorted = try a.dupe(i32, positions);
+        for (0..batch) |b| {
+            for (0..seq_len) |r| {
+                const max_causal: i32 = @intCast(first_pos + r);
+                const row = sorted[(b * seq_len + r) * topk ..][0..topk];
+                for (row) |*v| {
+                    if (v.* < 0 or v.* > max_causal) v.* = -1;
+                }
+                std.mem.sort(i32, row, {}, std.sort.asc(i32));
+            }
+        }
+        var buf: [64]u8 = undefined;
+        const key = try std.fmt.bufPrint(&buf, "layer.{d:0>3}.index_positions", .{layer});
+        try self.entries.append(self.gpa, .{
+            .name = try a.dupe(u8, key),
+            .dtype = .i32,
+            .shape = try a.dupe(usize, &.{ batch, seq_len, topk }),
+            .bytes = std.mem.sliceAsBytes(sorted),
+        });
+    }
+
+    /// Sort each row's selected experts by ascending expert ID and permute weights identically.
+    pub fn recordRouter(
+        self: *Dump,
+        layer: usize,
+        ids: []const i32,
+        weights: []const f32,
+        batch: usize,
+        seq_len: usize,
+        topk: usize,
+    ) !void {
+        if (ids.len != batch * seq_len * topk or weights.len != ids.len) return error.BadOracleShape;
+        const a = self.arena.allocator();
+        const out_ids = try a.alloc(i64, ids.len);
+        const out_wts = try a.alloc(f32, weights.len);
+        const Pair = struct {
+            id: i32,
+            wt: f32,
+            fn less(_: void, x: @This(), y: @This()) bool {
+                return x.id < y.id;
+            }
+        };
+        const row_pairs = try self.gpa.alloc(Pair, topk);
+        defer self.gpa.free(row_pairs);
+        const rows = batch * seq_len;
+        for (0..rows) |r| {
+            for (0..topk) |j| row_pairs[j] = .{ .id = ids[r * topk + j], .wt = weights[r * topk + j] };
+            std.mem.sort(Pair, row_pairs, {}, Pair.less);
+            for (0..topk) |j| {
+                out_ids[r * topk + j] = row_pairs[j].id;
+                out_wts[r * topk + j] = row_pairs[j].wt;
+            }
+        }
+        var b1: [64]u8 = undefined;
+        var b2: [64]u8 = undefined;
+        const k_exp = try std.fmt.bufPrint(&b1, "layer.{d:0>3}.router_experts", .{layer});
+        const k_wts = try std.fmt.bufPrint(&b2, "layer.{d:0>3}.router_weights", .{layer});
+        try self.entries.append(self.gpa, .{
+            .name = try a.dupe(u8, k_exp),
+            .dtype = .i64,
+            .shape = try a.dupe(usize, &.{ batch, seq_len, topk }),
+            .bytes = std.mem.sliceAsBytes(out_ids),
+        });
+        try self.entries.append(self.gpa, .{
+            .name = try a.dupe(u8, k_wts),
+            .dtype = .f32,
+            .shape = try a.dupe(usize, &.{ batch, seq_len, topk }),
+            .bytes = std.mem.sliceAsBytes(out_wts),
+        });
+    }
+
+    pub fn recordLogits(self: *Dump, logits_bytes: []const u8, batch: usize, seq_len: usize, vocab: usize) !void {
+        try self.put("logits", .f32, &.{ batch, seq_len, vocab }, logits_bytes);
+    }
+
+    pub fn write(self: *Dump, path: []const u8) !void {
+        std.mem.sort(core.shard_edit.New, self.entries.items, {}, struct {
+            fn lt(_: void, a: core.shard_edit.New, b: core.shard_edit.New) bool {
+                return std.mem.order(u8, a.name, b.name) == .lt;
+            }
+        }.lt);
+        try core.shard_edit.create(self.gpa, path, &.{.{ "format", "pt" }}, self.entries.items);
+    }
+};
+
+/// Canonical unpruned causal selection for `first_pos + rows <= index_topk`:
+/// unused slots are -1 first, followed by 0..pos in ascending order.
+pub fn fillCanonicalCausalIndices(out: []i32, first_pos: usize, rows: usize, topk: usize) !void {
+    if (out.len != rows * topk) return error.BadOracleShape;
+    for (0..rows) |r| {
+        const valid = first_pos + r + 1;
+        if (valid > topk) return error.CausalExceedsTopk;
+        const pad = topk - valid;
+        const row = out[r * topk ..][0..topk];
+        @memset(row[0..pad], -1);
+        for (0..valid) |j| row[pad + j] = @intCast(j);
+    }
+}
+
+pub const ReplayInputs = struct {
+    arena: std.heap.ArenaAllocator,
+    batch: usize,
+    seq_len: usize,
+    first_pos: []usize,
+    max_first_pos: usize,
+    streams_bf16: []u8,
+    prev_topk: ?[]i32,
+    topk_width: usize,
+
+    pub fn deinit(self: *ReplayInputs) void {
+        self.arena.deinit();
+        self.* = undefined;
+    }
+
+    pub fn load(
+        gpa: std.mem.Allocator,
+        io: std.Io,
+        path: []const u8,
+        hc_mult: usize,
+        hidden: usize,
+        max_positions: usize,
+        index_topk: usize,
+        need_prev_topk: bool,
+    ) !ReplayInputs {
+        var file = try st.File.open(gpa, io, path);
+        defer file.close(io);
+        var arena = std.heap.ArenaAllocator.init(gpa);
+        errdefer arena.deinit();
+        const a = arena.allocator();
+
+        const streams = file.get("streams_in") orelse return error.MissingReplayStreams;
+        const pos = file.get("position_ids") orelse return error.MissingReplayPositions;
+        if (streams.rank != 4 or streams.shape[2] != hc_mult or streams.shape[3] != hidden)
+            return error.BadReplayStreams;
+        const batch = streams.shape[0];
+        const seq_len = streams.shape[1];
+        if (batch == 0 or seq_len == 0 or !pos.is(.i64, &.{ batch, seq_len }))
+            return error.BadReplayPositions;
+
+        const first_pos = try a.alloc(usize, batch);
+        var max_first_pos: usize = 0;
+        for (0..batch) |b| {
+            const p0 = std.mem.readInt(i64, pos.bytes[(b * seq_len) * 8 ..][0..8], .little);
+            if (p0 < 0) return error.BadReplayPositions;
+            const fp: usize = std.math.cast(usize, p0) orelse return error.BadReplayPositions;
+            if (fp >= max_positions or seq_len > max_positions - fp) return error.BadReplayPositions;
+            first_pos[b] = fp;
+            max_first_pos = @as(usize, @max(max_first_pos, fp));
+            for (1..seq_len) |t| {
+                const pt = std.mem.readInt(i64, pos.bytes[(b * seq_len + t) * 8 ..][0..8], .little);
+                if (pt != p0 + @as(i64, @intCast(t))) return error.BadReplayPositions;
+            }
+        }
+
+        const n_elem = batch * seq_len * hc_mult * hidden;
+        const streams_bf16 = try a.alloc(u8, n_elem * 2);
+        switch (streams.dtype) {
+            .bf16 => @memcpy(streams_bf16, streams.bytes),
+            .f32 => for (0..n_elem) |i| {
+                const v: f32 = @bitCast(std.mem.readInt(u32, streams.bytes[i * 4 ..][0..4], .little));
+                std.mem.writeInt(u16, streams_bf16[i * 2 ..][0..2], core.quant.convert.bf16(v), .little);
+            },
+            else => return error.BadReplayStreams,
+        }
+
+        const k_eff: usize = @min(@as(usize, index_topk), seq_len);
+        var prev_topk: ?[]i32 = null;
+        if (file.get("prev_topk_indices")) |prev| {
+            if (prev.rank != 3 or prev.shape[0] != batch or prev.shape[1] != seq_len or prev.shape[2] != k_eff)
+                return error.BadReplayTopk;
+            const buf = try a.alloc(i32, batch * seq_len * k_eff);
+            switch (prev.dtype) {
+                .i32 => for (buf, 0..) |*dst, i| {
+                    dst.* = std.mem.readInt(i32, prev.bytes[i * 4 ..][0..4], .little);
+                },
+                .i64 => for (buf, 0..) |*dst, i| {
+                    const v = std.mem.readInt(i64, prev.bytes[i * 8 ..][0..8], .little);
+                    dst.* = std.math.cast(i32, v) orelse return error.BadReplayTopk;
+                },
+                else => return error.BadReplayTopk,
+            }
+            // Normalize any future-offset padding slots to -1 and sort ascending without duplicate valid indices.
+            for (0..batch) |b| {
+                for (0..seq_len) |r| {
+                    const max_pos: i32 = @intCast(r);
+                    const row = buf[(b * seq_len + r) * k_eff ..][0..k_eff];
+                    for (row) |*v| {
+                        if (v.* < -1 or v.* >= @as(i32, @intCast(seq_len))) return error.BadReplayTopk;
+                        if (v.* > max_pos) v.* = -1;
+                    }
+                    std.mem.sort(i32, row, {}, std.sort.asc(i32));
+                    for (1..k_eff) |j| {
+                        if (row[j] >= 0 and row[j] == row[j - 1]) row[j - 1] = -1;
+                    }
+                    std.mem.sort(i32, row, {}, std.sort.asc(i32));
+                }
+            }
+            prev_topk = buf;
+        } else if (need_prev_topk) {
+            return error.MissingReplayTopk;
+        }
+
+        return .{
+            .arena = arena,
+            .batch = batch,
+            .seq_len = seq_len,
+            .first_pos = first_pos,
+            .max_first_pos = max_first_pos,
+            .streams_bf16 = streams_bf16,
+            .prev_topk = prev_topk,
+            .topk_width = k_eff,
+        };
+    }
+};
+
+pub fn validateTokenIds(ids: []const u32, vocab_size: u32) !void {
+    if (ids.len == 0) return error.EmptyPrompt;
+    for (ids) |tok| {
+        if (tok >= vocab_size) return error.TokenOutOfRange;
+    }
+}
+
+pub const PromptTokens = struct {
+    batch: usize,
+    seq_len: usize,
+    ids: []u32,
+
+    pub fn deinit(self: PromptTokens, gpa: std.mem.Allocator) void {
+        gpa.free(self.ids);
+    }
+};
+
+pub fn readPromptSafetensors(gpa: std.mem.Allocator, io: std.Io, path: []const u8) !PromptTokens {
+    var file = try st.File.open(gpa, io, path);
+    defer file.close(io);
+    const t = file.get("input_ids") orelse return error.MissingInputIds;
+    if (t.rank != 2 or t.shape[0] == 0 or t.shape[1] == 0) return error.BadInputIds;
+    const n = t.shape[0] * t.shape[1];
+    const ids = try gpa.alloc(u32, n);
+    errdefer gpa.free(ids);
+    switch (t.dtype) {
+        .i64 => for (ids, 0..) |*dst, i| {
+            const v = std.mem.readInt(i64, t.bytes[i * 8 ..][0..8], .little);
+            dst.* = std.math.cast(u32, v) orelse return error.BadInputIds;
+        },
+        .i32, .u32 => for (ids, 0..) |*dst, i| {
+            const v = std.mem.readInt(i32, t.bytes[i * 4 ..][0..4], .little);
+            dst.* = std.math.cast(u32, v) orelse return error.BadInputIds;
+        },
+        else => return error.BadInputIds,
+    }
+    return .{ .batch = t.shape[0], .seq_len = t.shape[1], .ids = ids };
+}
+
