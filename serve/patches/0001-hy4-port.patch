+//! Device contracts call the public Zig operations, including their fatbin/symbol resolution.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = cuda.hy4_ops;
+const Rig = @import("rig").Rig;
+const bf = @import("core").quant.convert.bf16;
+const oracle = @import("contract_hy4_oracle.zig");
+const t = std.testing;
+
+fn checkGpu(comptime body: anytype) !void {
+    var d = try cuda.Driver.open();
+    defer d.close();
+    var ctx = try cuda.Context.init(&d, 0);
+    defer ctx.deinit();
+    var k = try ops.Kernels.load(&d);
+    defer k.deinit();
+    // The rig uploads synchronously on the default stream.
+    var r: Rig = .{
+        .gpu = .{ .d = &d, .ctx = &ctx, .gpa = t.allocator, .io = t.io },
+        .s = cuda.Stream.borrowed(&d, null),
+    };
+    defer r.deinit();
+    try body(&r, &k);
+    try t.expect(try r.intact());
+}
+
+fn zeros(a: std.mem.Allocator, comptime T: type, n: usize) ![]T {
+    const result = try a.alloc(T, n);
+    @memset(result, 0);
+    return result;
+}
+
+fn ihc(r: *Rig, k: *const ops.Kernels) !void {
+    var pool = std.heap.ArenaAllocator.init(t.allocator);
+    defer pool.deinit();
+    const a = pool.allocator();
+    const w = 6144;
+    const st = w + 3;
+    const row_st = 4 * st + 7;
+    const hidden_st = w + 5;
+    const shape: ops.IhcShape = .{ .rows = 2, .width = w, .stream_stride = st, .streams_row_stride = row_st, .hidden_stride = hidden_st };
+    const x = try zeros(a, u16, 2 * row_st);
+    for (0..2) |row| for (0..4) |stream| {
+        const begin = row * row_st + stream * st;
+        @memset(x[begin..][0..w], bf(@floatFromInt(1 + stream + row * 4)));
+    };
+    const residual = try r.input(std.mem.sliceAsBytes(x));
+    const proj = try zeros(a, f32, 8 * 4 * w);
+    const bias: [8]f32 = @splat(0);
+    const scale = [_]f32{ 1, 1 };
+    const output = try r.output(2 * hidden_st * 2);
+    const gates = try r.output(2 * 4 * 4);
+    const args: ops.IhcRead = .{ .streams = residual, .projection = try r.input(std.mem.sliceAsBytes(proj)), .base = try r.input(std.mem.asBytes(&bias)), .scale = try r.input(std.mem.asBytes(&scale)), .output = output, .post = gates };
+    try ops.ihcRead(k, r.s, shape, args);
+    // Zero pre logits give 0.5 + hc_eps, zero post logits 1 + hc_eps.
+    const gate_bytes = try r.bytes(gates, 32);
+    for (0..8) |i| try t.expectEqual(@as(f32, 1 + 1e-6), @as(f32, @bitCast(std.mem.readInt(u32, gate_bytes[4 * i ..][0..4], .little))));
+    try ops.ihcHead(k, r.s, shape, args);
+    const out = std.mem.bytesAsSlice(u16, try r.bytes(output, 2 * hidden_st * 2));
+    for (0..2) |row| {
+        for (out[row * hidden_st ..][0..w]) |v| try t.expectEqual(bf(if (row == 0) 5 else 13), v);
+        for (out[row * hidden_st + w ..][0..5]) |v| try t.expectEqual(@as(u16, 0xffff), v);
+    }
+    // In-place residual write, including the final channel of every stream.
+    try ops.ihcWrite(k, r.s, shape, .{ .residual = residual, .output = residual, .post = gates, .branch = output });
+    const mixed = std.mem.bytesAsSlice(u16, try r.bytes(residual, x.len * 2));
+    for (0..2) |row| for (0..4) |stream| {
+        const offset = row * row_st + stream * st;
+        const want = bf(@floatFromInt(1 + stream + row * 4 + (if (row == 0) @as(usize, 5) else 13)));
+        for (mixed[offset..][0..w]) |v| try t.expectEqual(want, v);
+        for (mixed[offset + w ..][0..3]) |v| try t.expectEqual(@as(u16, 0), v);
+    };
+}
+
+fn mla(r: *Rig, k: *const ops.Kernels) !void {
+    var pool = std.heap.ArenaAllocator.init(t.allocator);
+    defer pool.deinit();
+    const a = pool.allocator();
+    const heads = 64;
+    const pos = 3;
+    const q_stride = 258;
+    const aq_stride = 580;
+    const v_stride = 260;
+    const shape: ops.MlaShape = .{ .rows = 1, .heads = heads, .capacity = 5, .first_pos = pos, .key_count = 3, .q_head_stride = q_stride, .absorbed_head_stride = aq_stride, .cache_stride = 580, .value_head_stride = v_stride };
+    const q = try zeros(a, u16, q_stride * heads);
+    const weights = try zeros(a, u16, heads * (192 + 256) * 512);
+    const kv = try zeros(a, u16, 576);
+    @memset(kv[0..512], bf(1));
+    kv[512] = bf(1);
+    const gain: [512]u16 = @splat(bf(1));
+    const gate = try zeros(a, u16, v_stride * heads);
+    const sinks = try zeros(a, f32, heads);
+    for (0..heads) |h| {
+        // Trace the last non-rotary and latent coordinates and each head's last value.
+        q[h * q_stride + 191] = bf(2);
+        q[h * q_stride + 192] = bf(1);
+        const base = h * 448 * 512;
+        weights[base + 191 * 512 + 511] = bf(-0.5);
+        weights[base + 447 * 512 + 511] = bf(if (h % 2 == 0) 2 else -2);
+        gate[h * v_stride + 255] = bf(if (h % 2 == 0) -1 else 1);
+        sinks[h] = if (h % 2 == 0) 0 else @log(@as(f32, 3));
+    }
+    const aq = try r.output(heads * aq_stride * 2);
+    const cache = try r.output(5 * 580 * 2);
+    const kv_b = try r.input(std.mem.sliceAsBytes(weights));
+    const project: ops.MlaProject = .{ .q = try r.input(std.mem.sliceAsBytes(q)), .kv = try r.input(std.mem.sliceAsBytes(kv)), .kv_norm = try r.input(std.mem.asBytes(&gain)), .kv_b = kv_b, .absorbed_q = aq, .cache = cache };
+    try ops.mlaProject(k, r.s, shape, project);
+    const words = std.mem.bytesAsSlice(u16, try r.bytes(aq, heads * aq_stride * 2));
+    for (0..heads) |h| {
+        try t.expectEqual(bf(-1), words[h * aq_stride + 511]);
+        try t.expectEqual(bf(@cos(@as(f32, pos))), words[h * aq_stride + 512]);
+        try t.expectEqual(bf(@sin(@as(f32, pos))), words[h * aq_stride + 513]);
+        try t.expectEqual(@as(u16, 0xffff), words[h * aq_stride + 576]);
+    }
+    const cache_words = std.mem.bytesAsSlice(u16, try r.bytes(cache, 5 * 580 * 2));
+    for (cache_words[0 .. pos * 580]) |v| try t.expectEqual(@as(u16, 0xffff), v);
+    try t.expectEqual(bf(1), cache_words[pos * 580 + 511]);
+    for (cache_words[pos * 580 + 576 ..]) |v| try t.expectEqual(@as(u16, 0xffff), v);
+    const scratch = try ops.scratchBytes(shape);
+    const indices = [_]i32{ -1, pos, pos + 1 };
+    const args: ops.MlaAttend = .{ .absorbed_q = aq, .cache = cache, .kv_b = kv_b, .sinks = try r.input(std.mem.sliceAsBytes(sinks)), .gate = try r.input(std.mem.sliceAsBytes(gate)), .indices = try r.input(std.mem.asBytes(&indices)), .scratch = try r.scratch(scratch), .scratch_bytes = scratch, .output = try r.output(heads * v_stride * 2) };
+    try ops.mlaAttend(k, r.s, shape, args);
+    const first = try a.dupe(u8, try r.bytes(args.output, heads * v_stride * 2));
+    try ops.mlaAttend(k, r.s, shape, args);
+    try t.expectEqualSlices(u8, first, try r.bytes(args.output, first.len));
+    const values = std.mem.bytesAsSlice(u16, first);
+    // Dot = -1 + bf16(cos)^2 + bf16(sin)^2, so probabilities round to 1/2 or 1/4.
+    for (0..heads) |h| {
+        const target = if (h % 2 == 0) bf(1.0 / (1.0 + @exp(@as(f32, 1)))) else bf(-0.5 / (1.0 + @exp(@as(f32, -1))));
+        for (values[h * v_stride ..][0..255]) |v| try t.expectEqual(@as(u16, 0), v);
+        try t.expectEqual(target, values[h * v_stride + 255]);
+        for (values[h * v_stride + 256 ..][0..4]) |v| try t.expectEqual(@as(u16, 0xffff), v);
+    }
+}
+
+fn limits(r: *Rig, k: *const ops.Kernels) !void {
+    const thread_limit = try r.gpu.ctx.attribute(.max_threads_per_block);
+    const smem_limit = try r.gpu.ctx.attribute(.max_shared_memory_per_block_optin);
+    inline for (.{ "expert_partial", "rank_fold", "collapse", "write", "ihc_partials", "ihc_norm", "ihc_read", "head_bf16", "attn_front", "project_q", "cache_k", "scores", "softmax", "context", "context_group", "gated_value", "gated_value_rows", "index_linear", "index_prepare", "index_scores", "index_scores_rows", "index_select" }, .{ 256, 256, 256, 256, 512, 256, 512, 128, 128, 128, 128, 128, 128, 128, 32, 128, 128, 128, 128, 128, 256, 256 }) |name, threads| {
+        const f = @field(k, name);
+        const bound = try f.attribute(.max_threads_per_block);
+        const smem = try f.attribute(.shared_size_bytes);
+        try t.expect(threads <= bound and threads <= thread_limit and smem <= smem_limit);
+        std.debug.print("Hy4 {s} threads={d} bound={d} registers={d} static_shared={d}\n", .{ name, threads, bound, try f.attribute(.num_regs), smem });
+    }
+}
