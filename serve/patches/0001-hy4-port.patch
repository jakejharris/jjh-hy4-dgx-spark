+test "vision TP=4 fan-out publishes local slot only after all peers receive the frame and aborts surviving peers on partial failure" {
+    const gpa = std.testing.allocator;
+    const l = try tp.bootstrap.testListener();
+    defer tp.sock.close(l.fd);
+    const deadline = tp.sock.nowNs() + 5 * std.time.ns_per_s;
+    var f0: [tp.planlink.max_ranks]tp.sock.Fd = @splat(-1);
+    var fk: [3][tp.planlink.max_ranks]tp.sock.Fd = @splat(@splat(-1));
+    for (0..3) |i| {
+        fk[i][0] = try tp.sock.connect("127.0.0.1", l.port, deadline);
+        f0[i + 1] = try tp.sock.accept(l.fd, deadline);
+    }
+    var lead = tp.planlink.PlanLink.init(0, 4, f0);
+    defer lead.close();
+    var followers: [3]tp.planlink.PlanLink = .{
+        tp.planlink.PlanLink.init(1, 4, fk[0]),
+        tp.planlink.PlanLink.init(2, 4, fk[1]),
+        tp.planlink.PlanLink.init(3, 4, fk[2]),
+    };
+    defer for (&followers) |*fl| fl.close();
+
+    var slot0: vision_runtime.SlotState = .{ .active = true, .prompt_len = 99, .rope_delta = -50, .total_tokens = 8, .rows_dev = undefined };
+    defer {
+        slot0.thw_host.deinit(gpa);
+        slot0.spans.deinit(gpa);
+    }
+    const imgs = [_]lanes.stream.Image{.{ .pixels = &.{}, .gh = 4, .gw = 6, .at = 2, .tokens = 8 }};
+    var plan = try vision_image.buildMropePlan(gpa, 16, &imgs, 2, 16384);
+    defer plan.deinit(gpa);
+    const feat_bytes = try gpa.alloc(u8, @as(usize, plan.total_image_tokens) * 16 * 2);
+    defer gpa.free(feat_bytes);
+    @memset(feat_bytes, 0x5a);
+
+    // Hang up rank 2's send socket so rank 1 receives the frame while rank 2 fails mid-fan-out!
+    tp.sock.hangup(lead.fds[2]);
+    followers[1].close();
+    try std.testing.expectError(error.PeerClosed, vision_runtime.stageAndFanOutSlot(&slot0, gpa, 0, 16, plan, 16, feat_bytes, null, null, &lead, null));
+    // Local slot must stay inactive (no stale or partial state), and surviving rank 3 must see PeerClosed immediately.
+    try std.testing.expect(!slot0.active);
+    try std.testing.expectEqual(@as(usize, 0), slot0.spans.items.len);
+    var rbuf: std.ArrayList(i64) = .empty;
+    defer rbuf.deinit(gpa);
+    _ = followers[0].recvGrow(gpa, &rbuf) catch {}; // drain rank 1's frame before hangup
+    try std.testing.expectError(error.PeerClosed, followers[0].recvGrow(gpa, &rbuf));
+    try std.testing.expectError(error.PeerClosed, followers[2].recvGrow(gpa, &rbuf));
+
+    // Healthy 4-rank fan-out delivers the vision_set frame to all 3 followers and THEN publishes slot0 on rank 0.
+    var f0_ok: [tp.planlink.max_ranks]tp.sock.Fd = @splat(-1);
+    var fk_ok: [3][tp.planlink.max_ranks]tp.sock.Fd = @splat(@splat(-1));
+    for (0..3) |i| {
+        fk_ok[i][0] = try tp.sock.connect("127.0.0.1", l.port, deadline);
+        f0_ok[i + 1] = try tp.sock.accept(l.fd, deadline);
+    }
+    var lead_ok = tp.planlink.PlanLink.init(0, 4, f0_ok);
+    defer lead_ok.close();
+    var fl_ok: [3]tp.planlink.PlanLink = .{
+        tp.planlink.PlanLink.init(1, 4, fk_ok[0]),
+        tp.planlink.PlanLink.init(2, 4, fk_ok[1]),
+        tp.planlink.PlanLink.init(3, 4, fk_ok[2]),
+    };
+    defer for (&fl_ok) |*fl| fl.close();
+    try vision_runtime.stageAndFanOutSlot(&slot0, gpa, 0, 16, plan, 16, feat_bytes, null, null, &lead_ok, null);
+    try std.testing.expect(slot0.active);
+    try std.testing.expectEqual(@as(usize, 16), slot0.prompt_len);
+    for (&fl_ok) |*fl| {
+        const msg = try fl.recvGrow(gpa, &rbuf);
+        try std.testing.expectEqual(vision_runtime.visionFrameWords(16, 1, 8, 16).?, msg.len);
+    }
+}
