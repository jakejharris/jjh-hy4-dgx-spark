+        var rem = n - 1;
+        while (rem >= 258) : (rem -= 258) {
+            try putLsb.huff(a, &out, &bit_buf, &bit_cnt, 0xc5, 8); // code 285 = length 258
+            try putLsb.huff(a, &out, &bit_buf, &bit_cnt, 0x00, 5); // dist code 0 = distance 1
+        }
+        while (rem > 0) : (rem -= 1) {
+            if (fill < 144) try putLsb.huff(a, &out, &bit_buf, &bit_cnt, 0x30 + @as(u16, fill), 8)
+            else try putLsb.huff(a, &out, &bit_buf, &bit_cnt, 0x190 + @as(u16, fill - 144), 9);
+        }
