+    // 4-rank TCP gatherTop1OnBootstrap tie-breaking + gather-first NonFiniteLogits across stripes.
+    const l = try tp.bootstrap.testListener();
+    defer tp.sock.close(l.fd);
+    const TopPeer = struct {
+        fn run(port: u16, rk: u32, v: f32, col: usize, out_id: *u32, nan_err: *?anyerror) void {
+            var b = tp.Bootstrap.open(.{ .world = 4, .rank = rk, .link_port = port, .connect_timeout_ns = 10 * std.time.ns_per_s }) catch |e| { nan_err.* = e; return; };
+            defer b.close();
+            var stripe: [32]f32 = @splat(-5.0);
