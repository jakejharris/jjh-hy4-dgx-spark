+            else if (std.mem.eql(u8, arg, "--kv-capacity")) kv_capacity = try std.fmt.parseInt(usize, val, 10)
+            else if (std.mem.eql(u8, arg, "--drafter-exl3")) { drafter_on = true; drafter_exl3_arg = val; }
+            else if (std.mem.eql(u8, arg, "--drafter-head")) { drafter_on = true; drafter_head_arg = val; }
+            else if (std.mem.eql(u8, arg, "--row-cost-table")) { drafter_on = true; auto_depth = true; row_cost_arg = val; }
+            else if (std.mem.eql(u8, arg, "--draft-depth")) {
+                if (std.mem.eql(u8, val, "auto")) auto_depth = true else draft_depth = try std.fmt.parseInt(usize, val, 10);
+            }
+            else if (std.mem.eql(u8, arg, "--draft-min-margin")) { drafter_on = true; draft_min_margin = try draft_policy.parseMinMarginStr(val); }
+            else if (std.mem.eql(u8, arg, "--bench-drafter")) { drafter_on = true; bench_drafter = try std.fmt.parseInt(usize, val, 10); }
+            else if (std.mem.eql(u8, arg, "--device")) device = try std.fmt.parseInt(i32, val, 10)
+            else if (std.mem.eql(u8, arg, "--mem-floor-gib")) floor_gib = try std.fmt.parseInt(usize, val, 10)
+            else if (std.mem.eql(u8, arg, "--tp")) tp_opts.tp_world = try std.fmt.parseInt(usize, val, 10)
+            else if (std.mem.eql(u8, arg, "--rank")) tp_opts.rank = try std.fmt.parseInt(usize, val, 10)
+            else if (std.mem.eql(u8, arg, "--load-rank")) load_rank = try std.fmt.parseInt(usize, val, 10)
+            else if (std.mem.eql(u8, arg, "--master")) tp_opts.master = val
+            else if (std.mem.eql(u8, arg, "--master-port")) tp_opts.port = try std.fmt.parseInt(u16, val, 10)
+            else if (std.mem.eql(u8, arg, "--tp-timeout")) tp_opts.timeout_s = try std.fmt.parseInt(u64, val, 10)
+            else if (std.mem.eql(u8, arg, "--load-timeout")) tp_opts.load_timeout_s = try std.fmt.parseInt(u64, val, 10)
+            else if (std.mem.eql(u8, arg, "--plant-pack-mismatch-rank")) tp_opts.plant_pack_mismatch_rank = try std.fmt.parseInt(usize, val, 10)
