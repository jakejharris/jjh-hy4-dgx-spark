@@ -0,0 +1,58 @@
+//! Tensor-parallel geometry shared by the full Hy4 loader and device boundary.
+const std = @import("std");
+
+pub const boundary = @import("hy4_tp_boundary.zig");
+pub const Boundary = boundary.Boundary;
+
+pub const world = 4;
+pub const hidden = 6144;
+pub const Axis = enum { heads, expert, shared, dense, vocab };
+pub const Stripe = struct { first: u32, count: u32 };
+pub const Projection = enum { gate, up, down };
+
+pub const Rank = enum(u2) {
+    zero,
+    one,
+    two,
+    three,
+
+    pub fn init(number: usize, size: usize) !Rank {
+        if (size != world or number >= world) return error.BadHy4Rank;
+        return @fromBackingInt(@intCast(number));
+    }
+
+    pub fn stripe(rank: Rank, axis: Axis) Stripe {
+        const count: u32 = switch (axis) {
+            .heads => 16,
+            .expert, .shared => 512,
+            .dense => 4608,
+            .vocab => 30208,
+        };
+        return .{ .first = @as(u32, @backingInt(rank)) * count, .count = count };
+    }
+
+    /// Use core.exl3_layout directly so the family's reader and CUDA share the same Part type.
+    pub fn expertPart(rank: Rank, comptime layout: type, g: layout.Group, projection: Projection) !layout.Part {
+        const down = projection == .down;
+        const width = rank.stripe(.expert).count * world;
+        if (g.k() != (if (down) width else @as(u32, hidden)) or g.n() != (if (down) @as(u32, hidden) else width)) return error.BadHy4ExpertShape;
+        return g.part(if (down) .row else .col, @backingInt(rank), world);
+    }
+};
+
+test "Hy4 ABI rank stripes cover each checkpoint dimension once" {
+    _ = boundary;
+    const t = std.testing;
+    inline for (.{ Axis.heads, Axis.expert, Axis.shared, Axis.dense, Axis.vocab }, .{ 64, 2048, 2048, 18432, 120832 }) |axis, total| {
+        var end: u32 = 0;
+        for (0..world) |i| {
+            const s = (try Rank.init(i, world)).stripe(axis);
+            try t.expectEqual(end, s.first);
+            try t.expectEqual(@as(u32, total / world), s.count);
+            end += s.count;
+        }
+        try t.expectEqual(@as(u32, total), end);
+    }
+    try t.expectError(error.BadHy4Rank, Rank.init(4, 4));
+    try t.expectError(error.BadHy4Rank, Rank.init(0, 3));
+}
diff --git a/zig/src/cuda/hy4_tp_boundary.zig b/zig/src/cuda/hy4_tp_boundary.zig
