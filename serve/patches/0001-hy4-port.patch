+    try putEntry(gpa, &hdr, try std.fmt.bufPrint(&nb, p ++ "self_attn.linear_gate.weight", .{layer_idx}), .bf16, &.{ 16384, 6144 });
+    try putEntry(gpa, &hdr, try std.fmt.bufPrint(&nb, p ++ "self_attn.o_proj.weight", .{layer_idx}), .bf16, &.{ 6144, 16384 });
+    try putEntry(gpa, &hdr, try std.fmt.bufPrint(&nb, p ++ "self_attn.learnable_sink_param", .{layer_idx}), .bf16, &.{64});
