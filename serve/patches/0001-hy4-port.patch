+test "real Full Hy4 DFly2 TP=4 sharding map: 82 shard tensors, head/MLP/corr stripes, exact rank byte counts, and gatherTop1" {
+    const gpa = std.testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const aa = arena.allocator();
+
+    var ix_types: [78]config.IndexerType = @splat(.shared);
+    ix_types[0] = .full;
+    for (0..20) |j| ix_types[1 + j * 3] = .full;
+    const full_t: config.Text = .{
+        .hidden_size = 6144, .intermediate_size = 18432, .moe_intermediate_size = 2048,
+        .num_hidden_layers = 78, .vocab_size = 120_832, .max_position_embeddings = 131_072,
+        .q_lora_rank = 2048, .kv_lora_rank = 512, .num_attention_heads = 64,
+        .qk_nope_head_dim = 192, .qk_rope_head_dim = 64, .v_head_dim = 256,
