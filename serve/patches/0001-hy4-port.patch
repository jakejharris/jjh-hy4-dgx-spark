+            .{ .name = try std.fmt.allocPrint(a, "{s}.trellis", .{pfx}), .dtype = .i16, .shape = sh_tr, .bytes = tr },
+            .{ .name = try std.fmt.allocPrint(a, "{s}.suh", .{pfx}), .dtype = .f16, .shape = sh_su, .bytes = suh },
+            .{ .name = try std.fmt.allocPrint(a, "{s}.svh", .{pfx}), .dtype = .f16, .shape = sh_sv, .bytes = svh },
+        });
+    }
+
+    const shard_path = try std.fs.path.join(gpa, &.{ dir, "model.layers.1.safetensors" });
+    defer gpa.free(shard_path);
+    try core.shard_edit.create(gpa, shard_path, &.{}, entries.items);
+
+    // 1. All 32 tensors (8 * 4) reassemble byte-for-byte across the 4 TP ranks:
+    //    6 split matrices * 2 sliced tensors each (`trellis` + `svh` on col; `trellis` + `suh` on row) = 12 split, 20 replicated.
+    const pack_stats = try ranks.verifyPackReassembly(gpa, io, shard_path);
+    try std.testing.expectEqual(@as(usize, 32), pack_stats.tensors);
+    try std.testing.expectEqual(@as(usize, 12), pack_stats.split);
