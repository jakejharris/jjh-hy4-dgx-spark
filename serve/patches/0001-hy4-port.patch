+    try std.testing.expect(idx4.has("model.layers.3.mlp.shared_experts.down_proj.weight") and !idx4.has("model.layers.3.mlp.shared_experts.down_proj.trellis"));
+    try std.testing.expect(!idx4.has("lm_head.trellis") and idx4.has("lm_head.weight"));
+
+    // Different TF_HY4_TRUNK / --trunk or --target-head refuses plainly naming both!
+    try std.testing.expectError(error.Hy4PackTrunkMismatch, weights.ShardIndex.openWithTrunk(gpa, io, c4, null, "6b"));
+    try std.testing.expect(std.mem.indexOf(u8, pack_parts.lastRefusal(), "'4b'") != null and std.mem.indexOf(u8, pack_parts.lastRefusal(), "'6b'") != null);
+    try std.testing.expectError(error.Hy4PackTrunkMismatch, weights.ShardIndex.openWithTrunk(gpa, io, c4, null, "bf16"));
+    try std.testing.expectError(error.Hy4PackTrunkMismatch, weights.ShardIndex.openWithTrunkAndHead(gpa, io, c4, null, null, "4b", null));
+
+    // 2. Export --trunk 4b6b --target-head 4b: mixed 4b+6b trunk + 4b head + lossless L2/L3 shared.down matches all 4 ranks!
+    const out46 = try sub(a, root, "out-4b6b-h4");
+    _ = try pack_export.exportPack(gpa, io, .{ .src = src, .out = out46, .trunk = "4b6b", .target_head = "4b" });
+    _ = try pack_export.checkPack(gpa, io, out46, src);
+    const c46 = try sub(a, out46, "common");
+    for (0..4) |r| {
+        const got = try loadMixedDigest(gpa, io, c46, null, null, r, 27);
+        const want = try loadMixedDigest(gpa, io, src, "4b6b", "4b", r, 27);
+        const got_exp = try loadMixedDigest(gpa, io, c46, "4b,o_proj=6b,kv_a=6b", "4b", r, 27);
+        try std.testing.expectEqualSlices(u8, &want, &got);
