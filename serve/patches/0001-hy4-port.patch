+            try a.record(self.rig.s);
+            for (0..repeats) |_| try self.fold(rows);
+            try b.record(self.rig.s);
+            try b.synchronize();
+            try self.link.check();
+            if (i >= 3) std.debug.print("MS rank={d} rows={d} calls={d} i={d} value={d:.6}\n", .{ @backingInt(self.rank), rows, repeats, i - 3, try cuda.Event.elapsedMs(a, b) });
+        }
+        try self.link.check();
+    }
+};
+
+test "Hy4 process boundary" {
+    t.log_level = .info;
+    const mode = try env("HY4_TP_MODE");
+    const files: Files = .{ .dir = try env("HY4_TP_FIXTURE") };
+    var d = try cuda.Driver.open();
+    defer d.close();
+    var ctx = try cuda.Context.init(&d, 0);
+    defer ctx.deinit();
+    var k = try cuda.hy4_ops.Kernels.load(&d);
+    defer k.deinit();
+    var r: testg = .{ .gpu = .{ .d = &d, .ctx = &ctx, .gpa = t.allocator, .io = t.io }, .s = cuda.Stream.borrowed(&d, null) };
+    defer r.deinit();
+    if (std.mem.eql(u8, mode, "prepare")) {
+        try @import("contract_hy4_tp_mla.zig").forBoundary(&r, &k, files);
+        r.reset();
+        try @import("contract_hy4_tp_head.zig").forBoundary(&r, &k, files);
+        return;
+    }
+    if (!std.mem.eql(u8, mode, "rank")) return error.BadBoundaryTestMode;
+    const rank = try tp.Rank.init(try std.fmt.parseInt(usize, try env("RANK"), 10), try std.fmt.parseInt(usize, try env("WORLD_SIZE"), 10));
+    const fabric = @import("tp");
+    const port = try std.fmt.parseInt(u16, try env("MASTER_PORT"), 10);
+    var bootstrap = try fabric.Bootstrap.open(.{ .world = 4, .rank = @backingInt(rank), .master = try env("MASTER_ADDR"), .link_port = port, .connect_timeout_ns = 10 * std.time.ns_per_s });
+    defer bootstrap.close();
+    var lib = try cuda.nccl.Library.open();
+    defer lib.close();
+    std.debug.print("JOIN rank={d} nccl={d}\n", .{ @backingInt(rank), try lib.version() });
+    var link = try tp.Boundary.joinConfigured(fabric, &lib, &bootstrap, r.s, t.io);
+    defer link.close();
+    errdefer link.abort();
+    var gemms = try cuda.vit.Gemms.init(t.allocator, &d);
+    defer gemms.deinit();
+    const n = 2048 * D;
+    var partial = try cuda.DeviceBuffer.alloc(&d, n * 4);
+    defer partial.free();
+    var all = try cuda.DeviceBuffer.alloc(&d, n * 16);
+    defer all.free();
+    var branch = try cuda.DeviceBuffer.alloc(&d, n * 2);
+    defer branch.free();
+    var w: Worker = .{ .files = files, .rank = rank, .link = &link, .rig = &r, .k = &k, .gemms = &gemms, .partial = partial, .all = all, .branch = branch };
+    if (std.c.getenv("HY4_TP_BREAK_RELAY") != null) return w.midToken(&bootstrap);
+    if (std.c.getenv("HY4_TP_PAIRED_WRITE") != null) {
+        try w.pairedWrite(&bootstrap);
+        return;
+    }
+    try w.cases();
+    try w.time(1, 1, 31);
+    try w.time(2048, 1, 11);
+    try w.time(1, 156, 21);
+    try w.equal("moe", 48, 1);
+    try link.finish(r.s);
+    try bootstrap.agree("complete", "all ranks completed all samples");
+    std.debug.print("PASS rank={d} every boundary word and all four controls\n", .{@backingInt(rank)});
+}
diff --git a/zig/kernels/cuda/contract_hy4_tp_ffn.zig b/zig/kernels/cuda/contract_hy4_tp_ffn.zig
new file mode 100644
index 0000000000000000000000000000000000000000..de5d3083e7a9ba4c852cf2716bccbf09c797cc30
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_tp_ffn.zig
@@ -0,0 +1,75 @@
+//! BF16 gate/up and SwiGLU stripes concatenate exactly. Down projections remain FP32.
+const std = @import("std");
+const cuda = @import("cuda");
+const Rig = @import("rig").Rig;
+const t = std.testing;
+const tp = @import("contract_hy4_tp.zig");
+
+const Files = @import("contract_hy4_tp_files.zig").Files;
+
+pub fn run(a: std.mem.Allocator, r: *Rig, k: *const cuda.hy4_ops.Kernels, x: []const u16, inter: usize) !tp.Planes {
+    return forBoundary(a, r, k, x, inter, null);
+}
+
+pub fn forBoundary(a: std.mem.Allocator, r: *Rig, k: *const cuda.hy4_ops.Kernels, x: []const u16, inter: usize, files: ?Files) !tp.Planes {
+    const d = 6144;
+    const rows = x.len / d;
+    var pool = std.heap.ArenaAllocator.init(t.allocator);
+    defer pool.deinit();
+    const scratch = pool.allocator();
+    var prng = std.Random.DefaultPrng.init(20261121 + inter);
+    const rng = prng.random();
+    const gate = try tp.weights(scratch, rng, inter * d, 1.0 / 256.0);
+    const up = try tp.weights(scratch, rng, inter * d, 1.0 / 256.0);
+    const down = try tp.weights(scratch, rng, inter * d, 1.0 / 256.0);
+    // Include quiet lanes in down to exercise FP32 cancellation across different exponents.
+    for (down, 0..) |*w, i| w.* -= @as(u16, @intCast(i % 11)) << 7;
+    var g = try cuda.vit.Gemms.init(t.allocator, r.gpu.d);
+    defer g.deinit();
+    var act = try cuda.act_rows.ActRows.load(r.gpu.d);
+    defer act.unload();
+    const ws = g.workspace.len;
+    var full = try cuda.cublaslt.Linear.init(&g.lt, rows, inter, d, .bf16, ws);
+    defer full.deinit();
+    var local = try cuda.cublaslt.Linear.init(&g.lt, rows, inter / 4, d, .bf16, ws);
+    defer local.deinit();
+    try cuda.hy4_ops.matchColumnPlan(&full, &local, ws);
+    var refs: [3][]u16 = undefined;
+    var out: tp.Planes = .{ .full = undefined, .parts = try a.alloc(f32, 4 * x.len) };
+    for (0..5) |i| {
+        const rank = if (i == 0) 0 else i - 1;
+        const w = if (i == 0) inter else inter / 4;
+        const xdev = try r.input(std.mem.sliceAsBytes(x));
+        const off = rank * w * d;
+        const gate_dev = try r.input(std.mem.sliceAsBytes(gate[off..][0 .. w * d]));
+        const up_dev = try r.input(std.mem.sliceAsBytes(up[off..][0 .. w * d]));
+        const wd = if (i == 0) down else try tp.columns(scratch, down, inter, rank);
+        const down_dev = try r.input(std.mem.sliceAsBytes(wd));
+        const gg = try r.output(rows * w * 2);
+        const uu = try r.output(rows * w * 2);
+        const aa = try r.output(rows * w * 2);
+        const plan = if (i == 0) &full else &local;
+        try plan.run(xdev, gate_dev, gg, g.workspace.ptr, ws, r.s.handle);
+        try plan.run(xdev, up_dev, uu, g.workspace.ptr, ws, r.s.handle);
+        try act.swiglu(r.s, gg, w, uu, w, aa, null, rows, w);
+        for ([3]u64{ gg, uu, aa }, 0..) |ptr, j| {
+            const v = try tp.download(r, scratch, u16, ptr, rows * w);
+            if (i == 0) refs[j] = v else for (0..rows) |row| try t.expectEqualSlices(u16, refs[j][row * inter + rank * w ..][0..w], v[row * w ..][0..w]);
+        }
+        if (files) |f| if (i != 0) {
+            const bytes = try r.bytes(aa, rows * w * 2);
+            try f.save(rank, if (inter == 2048) "shared-input" else "dense-input", bytes);
+            try f.save(rank, if (inter == 2048) "shared-weight" else "dense-weight", std.mem.sliceAsBytes(wd));
+        };
+        const yy = try r.output(x.len * 4);
+        try g.run(r.s, aa, down_dev, yy, rows, d, w, .f32);
+        const y = try tp.download(r, a, f32, yy, x.len);
+        if (i == 0) out.full = y else @memcpy(out.parts[rank * x.len ..][0..x.len], y);
+        try t.expect(try r.intact());
+        r.reset();
+    }
+    const label = if (inter == 2048) "shared" else "dense";
+    const reference = try tp.measure(a, r, k, out, label, 0.001);
+    if (files) |f| try f.save(null, label, std.mem.sliceAsBytes(reference));
+    return out;
+}
diff --git a/zig/kernels/cuda/contract_hy4_tp_files.zig b/zig/kernels/cuda/contract_hy4_tp_files.zig
