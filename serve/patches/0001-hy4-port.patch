+    var spark_r0_room: u64 = 20 * g;
+    try std.testing.expectEqual(@as(usize, 1), (try cuda_native.admitSlotsAfterLoad(.{ .ctx = @ptrCast(&spark_r0_room), .read = MockRoom.read }, 8, false, 2048 * 16, kv_slot_b + vis_slot_b)).slots);
