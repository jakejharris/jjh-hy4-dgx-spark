+fn makeEntry(dtype: st.DType, shape: []const usize) st.Entry {
+    var e: st.Entry = .{ .dtype = dtype, .rank = @intCast(shape.len), .shape = @splat(1), .begin = 0, .end = 0 };
+    var n: usize = dtype.size();
+    for (shape, 0..) |d, i| {
+        e.shape[i] = d;
+        n *= d;
+    }
+    e.end = n;
+    return e;
+}
+
+fn putEntry(gpa: std.mem.Allocator, hdr: *st.Header, name: []const u8, dtype: st.DType, shape: []const usize) !void {
+    try hdr.put(gpa, try gpa.dupe(u8, name), makeEntry(dtype, shape));
+}
