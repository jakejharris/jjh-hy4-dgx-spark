+//! Prefix-filtered vit.* safetensors loader for Full Hy4 (TF_HY4_VISION_DIR sidecar or MODEL_DIR fallback).
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const env = @import("sys").environment;
+const weights = @import("weights.zig");
+const vcfg = @import("vision_config.zig");
+
+const st = core.safetensors;
+const Uploader = cuda.exl3_upload.Uploader;
+
+pub const BiasedLinear = struct {
+    weight: u64,
+    bias: u64,
+    n: usize,
+    k: usize,
+};
+
+pub const NormBias = struct {
+    weight: u64,
+    bias: u64,
+    width: usize,
+};
+
+pub const BlockWeights = struct {
+    input_norm: NormBias,
+    q: BiasedLinear,
+    k: BiasedLinear,
+    v: BiasedLinear,
+    o: BiasedLinear,
+    post_norm: NormBias,
+    h_to_4h: BiasedLinear,
+    f4h_to_h: BiasedLinear,
+};
+
+pub const PerceiveWeights = struct {
+    norm: weights.RmsNormWeight,
+    proj0: BiasedLinear,
+    proj2: BiasedLinear,
+    image_newline: u64,
+};
+
+pub const TowerWeights = struct {
+    gpa: std.mem.Allocator,
+    patch_embed: BiasedLinear,
+    pos_table: u64,
+    blocks: []BlockWeights,
+    perceive: PerceiveWeights,
+    bytes: u64,
+
+    pub fn deinitHost(self: *TowerWeights) void {
+        self.gpa.free(self.blocks);
+        self.* = undefined;
+    }
+};
+
+pub fn resolveVisionTargetFrom(source: anytype, model_dir: []const u8) env.Error![]const u8 {
+    return (try env.path("TF_HY4_VISION_DIR", source.get("TF_HY4_VISION_DIR"))) orelse model_dir;
+}
+
+pub fn resolveVisionTarget(model_dir: []const u8) env.Error![]const u8 {
+    return resolveVisionTargetFrom(env.Process{}, model_dir);
+}
+
+pub fn expectedTensorCount(num_layers: u32) usize {
+    return @as(usize, num_layers) * 16 + 9;
+}
+
+pub fn expectedVisionBytes(cfg: vcfg.Config) u64 {
+    const d: u64 = cfg.hidden_size;
+    const p: u64 = cfg.patchDim();
+    const ffn: u64 = cfg.intermediate_size;
+    const out_d: u64 = cfg.out_hidden_size;
+    const emb_params: u64 = (d * p + d) + (@as(u64, cfg.numPositions()) * d);
+    const blk_params: u64 = 2 * d + 4 * (d * d + d) + 2 * d + (ffn * d + ffn) + (d * ffn + d);
+    const m2: u64 = @as(u64, cfg.spatial_merge_size) * cfg.spatial_merge_size;
+    const perc_params: u64 = d + (out_d * d * m2 + out_d) + (out_d * out_d + out_d) + out_d;
+    return (emb_params + @as(u64, cfg.num_hidden_layers) * blk_params + perc_params) * 2;
+}
+
+pub fn permuteConv2x2Bf16(dst: []u8, src: []const u8, out_c: usize, in_c: usize) !void {
+    const total = out_c * in_c * 4 * 2;
+    if (dst.len != total or src.len != total) return error.UnexpectedTensor;
+    for (0..out_c) |oc| {
+        for (0..in_c) |ic| {
+            for (0..4) |k_idx| {
+                const src_off = ((oc * in_c + ic) * 4 + k_idx) * 2;
+                const dst_off = ((oc * 4 + k_idx) * in_c + ic) * 2;
+                dst[dst_off] = src[src_off];
+                dst[dst_off + 1] = src[src_off + 1];
+            }
+        }
+    }
+}
+
+pub const VisionIndex = struct {
+    gpa: std.mem.Allocator,
+    arena: std.heap.ArenaAllocator,
+    dir: []const u8,
+    weight_map: std.StringHashMapUnmanaged([]const u8) = .empty,
+
+    pub fn open(gpa: std.mem.Allocator, io: std.Io, raw_target: []const u8) !VisionIndex {
+        const target = std.mem.trimEnd(u8, raw_target, "/");
+        const clean = if (target.len > 0) target else raw_target;
+        var arena = std.heap.ArenaAllocator.init(gpa);
+        var arena_moved = false;
+        errdefer if (!arena_moved) arena.deinit();
+        const a = arena.allocator();
+
+        const is_st = std.mem.endsWith(u8, clean, ".safetensors");
+        const is_json = std.mem.endsWith(u8, clean, ".json");
+        const dir = try a.dupe(u8, if (is_st or is_json) (std.fs.path.dirname(clean) orelse ".") else clean);
+
+        var out: VisionIndex = .{ .gpa = gpa, .arena = arena, .dir = dir };
+        arena_moved = true;
+        errdefer out.deinit();
+        if (is_st) {
+            try out.indexShard(io, std.fs.path.basename(clean));
+        } else if (is_json) {
+            try out.loadIndexJson(io, clean);
+        } else blk: {
+            for ([_][]const u8{ "vit.safetensors.index.json", "model.safetensors.index.json", "index.json" }) |idx_name| {
+                const candidate = try std.fs.path.join(gpa, &.{ dir, idx_name });
+                defer gpa.free(candidate);
+                if (out.loadIndexJson(io, candidate)) |_| {
+                    if (out.weight_map.count() > 0 and out.allShardsExist(io)) break :blk;
+                    out.weight_map.clearRetainingCapacity();
+                } else |err| switch (err) {
+                    error.FileNotFound => continue,
+                    else => return err,
+                }
+            }
+            try out.scanDir(io);
+        }
+        if (out.weight_map.count() == 0) return error.MissingVisionWeights;
+        return out;
+    }
+
+    pub fn deinit(self: *VisionIndex) void {
+        self.arena.deinit();
+        self.* = undefined;
+    }
+
+    fn allShardsExist(self: *const VisionIndex, io: std.Io) bool {
+        var seen: std.StringHashMapUnmanaged(void) = .empty;
+        defer seen.deinit(self.gpa);
+        var it = self.weight_map.valueIterator();
+        while (it.next()) |rel_ptr| {
+            if (seen.contains(rel_ptr.*)) continue;
+            seen.put(self.gpa, rel_ptr.*, {}) catch return false;
+            const full = std.fs.path.join(self.gpa, &.{ self.dir, rel_ptr.* }) catch return false;
+            defer self.gpa.free(full);
+            const f = std.Io.Dir.cwd().openFile(io, full, .{}) catch return false;
+            f.close(io);
+        }
+        return true;
+    }
+
+    fn loadIndexJson(self: *VisionIndex, io: std.Io, path: []const u8) !void {
+        const a = self.arena.allocator();
+        const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, self.gpa, .limited(64 << 20));
+        defer self.gpa.free(bytes);
+        const parsed = try std.json.parseFromSliceLeaky(std.json.Value, a, bytes, .{});
+        const map = try st.index.weightMap(parsed);
+        var it = map.iterator();
+        while (it.next()) |kv| {
+            if (std.mem.startsWith(u8, kv.key_ptr.*, "vit.")) {
+                try self.weight_map.put(a, kv.key_ptr.*, kv.value_ptr.string);
+            }
+        }
+    }
+
+    fn indexShard(self: *VisionIndex, io: std.Io, rel_name: []const u8) !void {
+        const a = self.arena.allocator();
+        const rel = try a.dupe(u8, rel_name);
+        const full = try std.fs.path.join(self.gpa, &.{ self.dir, rel });
+        defer self.gpa.free(full);
+        var f = try st.File.openPrefixes(self.gpa, io, full, &.{"vit."});
+        defer f.close(io);
+        for (f.names.keys()) |k| {
+            if (self.weight_map.contains(k)) return error.DuplicateVisionTensor;
+            try self.weight_map.put(a, try a.dupe(u8, k), rel);
+        }
+    }
+
+    fn scanDir(self: *VisionIndex, io: std.Io) !void {
+        var d = try std.Io.Dir.cwd().openDir(io, self.dir, .{ .iterate = true });
+        defer d.close(io);
+        var it = d.iterate();
+        while (try it.next(io)) |entry| {
+            if (entry.kind != .file and entry.kind != .sym_link) continue;
+            if (!std.mem.endsWith(u8, entry.name, ".safetensors") or std.mem.startsWith(u8, entry.name, ".")) continue;
+            try self.indexShard(io, entry.name);
+        }
+    }
+};
+
+const Session = struct {
+    idx: *const VisionIndex,
+    io: std.Io,
+    files: std.StringHashMapUnmanaged(st.File) = .empty,
+
+    fn deinit(self: *Session) void {
+        var it = self.files.valueIterator();
+        while (it.next()) |f| {
+            f.release(self.idx.gpa);
+            f.closeCopied(self.io);
+        }
+        self.files.deinit(self.idx.gpa);
+    }
+
+    fn expect(self: *Session, name: []const u8, shape: []const usize) !st.Tensor {
+        const rel = self.idx.weight_map.get(name) orelse return error.MissingVisionWeights;
+        const gop = try self.files.getOrPut(self.idx.gpa, rel);
+        if (!gop.found_existing) {
+            errdefer _ = self.files.remove(rel);
+            const path = try std.fs.path.join(self.idx.gpa, &.{ self.idx.dir, rel });
+            defer self.idx.gpa.free(path);
+            gop.value_ptr.* = try st.File.openPrefixes(self.idx.gpa, self.io, path, &.{"vit."});
+        }
+        const t = gop.value_ptr.get(name) orelse return error.MissingVisionWeights;
+        if (!t.is(.bf16, shape)) return error.UnexpectedTensor;
+        return t;
+    }
+};
+
+fn uploadVec(sess: *Session, up: *Uploader, name: []const u8, n: usize) !u64 {
+    const t = try sess.expect(name, &.{n});
+    return up.dev(t.bytes);
+}
+
+fn uploadNormBias(sess: *Session, up: *Uploader, prefix: []const u8, width: usize) !NormBias {
+    var wb: [160]u8 = undefined;
+    var bb: [160]u8 = undefined;
+    return .{
+        .weight = try uploadVec(sess, up, try std.fmt.bufPrint(&wb, "{s}.weight", .{prefix}), width),
+        .bias = try uploadVec(sess, up, try std.fmt.bufPrint(&bb, "{s}.bias", .{prefix}), width),
+        .width = width,
+    };
+}
+
+fn uploadBiasedLinear(sess: *Session, up: *Uploader, prefix: []const u8, n: usize, k: usize) !BiasedLinear {
+    var wb: [160]u8 = undefined;
+    var bb: [160]u8 = undefined;
+    const wt = try sess.expect(try std.fmt.bufPrint(&wb, "{s}.weight", .{prefix}), &.{ n, k });
+    const bt = try sess.expect(try std.fmt.bufPrint(&bb, "{s}.bias", .{prefix}), &.{n});
+    return .{ .weight = try up.dev(wt.bytes), .bias = try up.dev(bt.bytes), .n = n, .k = k };
+}
+
+pub fn visionGpuBytes(gpa: std.mem.Allocator, io: std.Io, model_dir: []const u8) !u64 {
+    const target = try resolveVisionTarget(model_dir);
+    const cfg = (try vcfg.readFromDir(gpa, io, model_dir)) orelse return 0;
+    var vidx = try VisionIndex.open(gpa, io, target);
+    defer vidx.deinit();
+    if (vidx.weight_map.count() < expectedTensorCount(cfg.num_hidden_layers)) return error.MissingVisionWeights;
+    return expectedVisionBytes(cfg);
+}
+
+pub fn loadTower(gpa: std.mem.Allocator, io: std.Io, up: *Uploader, cfg: vcfg.Config, model_dir: []const u8) !TowerWeights {
+    var vidx = try VisionIndex.open(gpa, io, try resolveVisionTarget(model_dir));
+    defer vidx.deinit();
+    var sess: Session = .{ .idx = &vidx, .io = io };
+    defer sess.deinit();
+
+    const d: usize = cfg.hidden_size;
+    const ps: usize = cfg.patch_size;
+    const ffn: usize = cfg.intermediate_size;
+    const out_d: usize = cfg.out_hidden_size;
+    const before_bytes = up.bytes;
+
+    const patch_w = try sess.expect("vit.embeddings.patch_embedding.weight", &.{ d, 3, ps, ps });
+    const patch_b = try sess.expect("vit.embeddings.patch_embedding.bias", &.{d});
+    const pos_all = try sess.expect("vit.embeddings.position_embedding.weight", &.{ cfg.numPositions(), d });
+    const pos_grid_bytes = pos_all.bytes[d * 2 ..];
+
+    const patch_embed: BiasedLinear = .{
+        .weight = try up.dev(patch_w.bytes),
+        .bias = try up.dev(patch_b.bytes),
+        .n = d,
+        .k = 3 * ps * ps,
+    };
+    const pos_table = try up.dev(pos_grid_bytes);
+
+    const blocks = try gpa.alloc(BlockWeights, cfg.num_hidden_layers);
+    errdefer gpa.free(blocks);
+    for (blocks, 0..) |*blk, l| {
+        var pfx_buf: [96]u8 = undefined;
+        const pfx = try std.fmt.bufPrint(&pfx_buf, "vit.layers.{d}", .{l});
+        var b0: [128]u8 = undefined;
+        var b1: [128]u8 = undefined;
+        var b2: [128]u8 = undefined;
+        var b3: [128]u8 = undefined;
+        var b4: [128]u8 = undefined;
+        var b5: [128]u8 = undefined;
+        var b6: [128]u8 = undefined;
+        var b7: [128]u8 = undefined;
+        blk.* = .{
+            .input_norm = try uploadNormBias(&sess, up, try std.fmt.bufPrint(&b0, "{s}.input_layernorm", .{pfx}), d),
+            .q = try uploadBiasedLinear(&sess, up, try std.fmt.bufPrint(&b1, "{s}.self_attn.q_proj", .{pfx}), d, d),
+            .k = try uploadBiasedLinear(&sess, up, try std.fmt.bufPrint(&b2, "{s}.self_attn.k_proj", .{pfx}), d, d),
+            .v = try uploadBiasedLinear(&sess, up, try std.fmt.bufPrint(&b3, "{s}.self_attn.v_proj", .{pfx}), d, d),
+            .o = try uploadBiasedLinear(&sess, up, try std.fmt.bufPrint(&b4, "{s}.self_attn.o_proj", .{pfx}), d, d),
+            .post_norm = try uploadNormBias(&sess, up, try std.fmt.bufPrint(&b5, "{s}.post_attention_layernorm", .{pfx}), d),
+            .h_to_4h = try uploadBiasedLinear(&sess, up, try std.fmt.bufPrint(&b6, "{s}.mlp.dense_h_to_4h", .{pfx}), ffn, d),
+            .f4h_to_h = try uploadBiasedLinear(&sess, up, try std.fmt.bufPrint(&b7, "{s}.mlp.dense_4h_to_h", .{pfx}), d, ffn),
+        };
+    }
+
+    const p_norm_t = try sess.expect("vit.perceive.norm.weight", &.{d});
+    const p_norm: weights.RmsNormWeight = .{ .bf16_ptr = try up.dev(p_norm_t.bytes), .f32_ptr = 0, .width = d };
+
+    const proj0_wt = try sess.expect("vit.perceive.proj.0.weight", &.{ out_d, d, 2, 2 });
+    const proj0_bt = try sess.expect("vit.perceive.proj.0.bias", &.{out_d});
+    const perm_proj0 = try gpa.alloc(u8, proj0_wt.bytes.len);
+    defer gpa.free(perm_proj0);
+    try permuteConv2x2Bf16(perm_proj0, proj0_wt.bytes, out_d, d);
+    const proj0: BiasedLinear = .{ .weight = try up.dev(perm_proj0), .bias = try up.dev(proj0_bt.bytes), .n = out_d, .k = 4 * d };
+
+    const proj2_wt = try sess.expect("vit.perceive.proj.2.weight", &.{ out_d, out_d, 1, 1 });
+    const proj2_bt = try sess.expect("vit.perceive.proj.2.bias", &.{out_d});
+    const proj2: BiasedLinear = .{ .weight = try up.dev(proj2_wt.bytes), .bias = try up.dev(proj2_bt.bytes), .n = out_d, .k = out_d };
+    const newline = try uploadVec(&sess, up, "vit.perceive.image_newline", out_d);
+
+    return .{
+        .gpa = gpa,
+        .patch_embed = patch_embed,
+        .pos_table = pos_table,
+        .blocks = blocks,
+        .perceive = .{ .norm = p_norm, .proj0 = proj0, .proj2 = proj2, .image_newline = newline },
+        .bytes = @intCast(up.bytes -| before_bytes),
+    };
+}
+
+test "VisionIndex filters vit.* out of mixed shards, checks exact byte count, and permutes Conv2x2 weights" {
+    const a = std.testing.allocator;
+    const io = std.testing.io;
+    const full_cfg: vcfg.Config = .{};
+    try std.testing.expectEqual(@as(usize, 649), expectedTensorCount(40));
+    try std.testing.expectEqual(@as(u64, 2_470_253_568), expectedVisionBytes(full_cfg));
+
+    var src: [2 * 3 * 4 * 2]u8 = undefined;
+    for (0..24) |i| std.mem.writeInt(u16, src[i * 2 ..][0..2], @intCast(i + 1), .little);
+    var dst: [2 * 3 * 4 * 2]u8 = undefined;
+    try permuteConv2x2Bf16(&dst, &src, 2, 3);
+    const expect_oc0 = [_]u16{ 1, 5, 9, 2, 6, 10, 3, 7, 11, 4, 8, 12 };
+    for (expect_oc0, 0..) |want, j| {
+        try std.testing.expectEqual(want, std.mem.readInt(u16, dst[j * 2 ..][0..2], .little));
+    }
+
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const hdr = "{\"model.layers.0.self_attn.o_proj.weight\":{\"dtype\":\"BF16\",\"shape\":[4],\"data_offsets\":[0,8]},\"vit.perceive.image_newline\":{\"dtype\":\"BF16\",\"shape\":[4],\"data_offsets\":[8,16]}}";
+    var file_buf: [8 + hdr.len + 16]u8 = @splat(0);
+    std.mem.writeInt(u64, file_buf[0..8], hdr.len, .little);
+    @memcpy(file_buf[8 .. 8 + hdr.len], hdr);
+    try tmp.dir.writeFile(io, .{ .sub_path = "mixed.safetensors", .data = &file_buf });
+    const dir_path = try tmp.dir.realPathFileAlloc(io, ".", a);
+    defer a.free(dir_path);
+    var vidx = try VisionIndex.open(a, io, dir_path);
+    defer vidx.deinit();
+    try std.testing.expectEqual(@as(usize, 1), vidx.weight_map.count());
+    try std.testing.expect(vidx.weight_map.contains("vit.perceive.image_newline"));
+    try std.testing.expect(!vidx.weight_map.contains("model.layers.0.self_attn.o_proj.weight"));
+
+    var tmp_empty = std.testing.tmpDir(.{});
+    defer tmp_empty.cleanup();
+    const text_hdr = "{\"model.norm.weight\":{\"dtype\":\"BF16\",\"shape\":[4],\"data_offsets\":[0,8]}}";
+    var text_buf: [8 + text_hdr.len + 8]u8 = @splat(0);
+    std.mem.writeInt(u64, text_buf[0..8], text_hdr.len, .little);
+    @memcpy(text_buf[8 .. 8 + text_hdr.len], text_hdr);
+    try tmp_empty.dir.writeFile(io, .{ .sub_path = "text_only.safetensors", .data = &text_buf });
+    const empty_dir_path = try tmp_empty.dir.realPathFileAlloc(io, ".", a);
+    defer a.free(empty_dir_path);
+    try std.testing.expectError(error.MissingVisionWeights, VisionIndex.open(a, io, empty_dir_path));
+
+    const FakeEnv = struct {
+        raw: ?[]const u8 = null,
+        pub fn get(f: @This(), name: []const u8) ?[]const u8 {
+            return if (std.mem.eql(u8, name, "TF_HY4_VISION_DIR")) f.raw else null;
+        }
+    };
+    try std.testing.expectEqualStrings("/models/hy4", try resolveVisionTargetFrom(FakeEnv{}, "/models/hy4"));
+    try std.testing.expectEqualStrings("/models/hy4", try resolveVisionTargetFrom(FakeEnv{ .raw = "  " }, "/models/hy4"));
+    try std.testing.expectEqualStrings("/sidecar/vit", try resolveVisionTargetFrom(FakeEnv{ .raw = "/sidecar/vit" }, "/models/hy4"));
+    try std.testing.expectError(error.InvalidEnvironment, resolveVisionTargetFrom(FakeEnv{ .raw = "/bad\x07dir" }, "/models/hy4"));
+}
diff --git a/zig/src/families/hy4/weights.zig b/zig/src/families/hy4/weights.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ca91757cdc81c2fa0f96e32f80f2227ec3435e60
--- /dev/null
+++ b/zig/src/families/hy4/weights.zig
@@ -0,0 +1,596 @@
+//! Streaming and rank-sliced shard loader for Full Hy4 (`hy_v4_vl` / `hy_v4`).
+//! Reads `model.safetensors.index.json` or `index.json` without opening unrequested shards,
+//! extracts only this rank's slice on TP=4 (`ranks.tensorSpan`), and drops mapped pages on close.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const config = @import("config.zig");
+const ranks = @import("ranks.zig");
+const exl3_weights = @import("exl3_weights.zig");
+const trunk_exl3 = @import("trunk_exl3.zig");
+const pack_parts = @import("pack_parts.zig");
+
+const st = core.safetensors;
+const Tensor = st.Tensor;
+const Uploader = cuda.exl3_upload.Uploader;
+
+pub const LinearBf16 = struct {
+    ptr: u64 = 0, n: usize = 0, n_full: usize = 0, k: usize = 0, n_pad: usize = 0, k_pad: usize = 0, padded: bool = false,
+    pub fn fullN(self: LinearBf16) usize { return if (self.n_full == 0) self.n else self.n_full; }
+    pub fn fullNPad(self: LinearBf16) usize { return std.mem.alignForward(usize, self.fullN(), 64); }
+};
+pub const LinearProj = trunk_exl3.LinearProj;
+
+pub const RmsNormWeight = struct { bf16_ptr: u64 = 0, f32_ptr: u64 = 0, width: usize = 0 };
+pub const IhcWeights = struct { fn_ptr: u64, base_ptr: u64, scale_ptr: u64 };
+pub const IndexerWeights = struct { wq_b: u64, wk: u64, k_norm_weight: u64, k_norm_bias: u64, weights_proj: u64 };
+pub const DenseMlp = struct { gate: LinearProj = .{ .bf16 = .{} }, up: LinearProj = .{ .bf16 = .{} }, down: LinearProj = .{ .bf16 = .{} } };
+
+pub const SparseBf16 = struct {
+    router_f32: u64, correction_bias_host: []f32, gate_up: []LinearBf16, down: []LinearBf16, shared: DenseMlp,
+    pub fn deinitHost(self: *SparseBf16, gpa: std.mem.Allocator) void {
+        gpa.free(self.correction_bias_host); gpa.free(self.gate_up); gpa.free(self.down); self.* = undefined;
+    }
+};
+
+pub const SparseExl3 = struct {
+    router_bf16: u64, router_f32: u64, correction_bias: u64, exl3_layer: cuda.exl3_experts.Layer, shared: DenseMlp,
+};
+
+pub const TrunkWeights = struct { embed_bf16: u64 };
+pub const HeadWeights = struct {
+    hc: IhcWeights, final_norm: RmsNormWeight, lm_head_f32: u64 = 0, lm_head_bf16: u64 = 0, lm_head_exl3: ?trunk_exl3.LinearExl3 = null,
+    vocab_local: usize, vocab_pad: usize, vocab_full: usize,
+};
+
+pub const LayerWeights = struct {
+    index: usize, attn_hc: IhcWeights, input_norm: RmsNormWeight, q_a: LinearProj, q_a_norm: RmsNormWeight,
+    q_b: LinearProj, kv_a: LinearProj, kv_a_norm_bf16: u64, kv_b: u64, linear_gate: LinearProj, o_proj: LinearProj,
+    sinks: u64, indexer: ?IndexerWeights, ffn_hc: IhcWeights, post_attn_norm: RmsNormWeight,
+    mlp: union(enum) { dense: DenseMlp, sparse_bf16: SparseBf16, sparse_exl3: SparseExl3 },
+    pub fn deinitHost(self: *LayerWeights, gpa: std.mem.Allocator) void {
+        switch (self.mlp) { .sparse_bf16 => |*sp| sp.deinitHost(gpa), else => {} }
+        self.* = undefined;
+    }
+};
+
+pub const ShardIndex = struct {
+    gpa: std.mem.Allocator,
+    arena: std.heap.ArenaAllocator,
+    dir: []const u8,
+    cfg: config.Parsed,
+    cfg_sha256: [32]u8 = @splat(0),
+    trunk_tag: []const u8 = "",
+    trunk_k2: std.StringHashMapUnmanaged(u8) = .empty,
+    weight_map: std.StringHashMapUnmanaged([]const u8) = .empty,
+    /// Set when `dir` is the `common/` part of a per-rank pack (`pack_parts.zig`); null for a full pack.
+    pack: ?pack_parts.Pack = null,
+
+    pub fn open(gpa: std.mem.Allocator, io: std.Io, dir_or_index: []const u8) !ShardIndex {
+        return openWithTrunkAndHead(gpa, io, dir_or_index, null, null, null, null);
+    }
+    pub fn openWith(gpa: std.mem.Allocator, io: std.Io, dir_or_index: []const u8, explicit_config: ?[]const u8) !ShardIndex {
+        return openWithTrunkAndHead(gpa, io, dir_or_index, explicit_config, null, null, null);
+    }
+    pub fn openWithTrunk(gpa: std.mem.Allocator, io: std.Io, dir_or_index: []const u8, explicit_config: ?[]const u8, explicit_trunk: ?[]const u8) !ShardIndex {
+        return openWithTrunkAndHead(gpa, io, dir_or_index, explicit_config, explicit_trunk, null, null);
+    }
+    pub fn openRaw(gpa: std.mem.Allocator, io: std.Io, dir_or_index: []const u8, explicit_config: ?[]const u8) !ShardIndex {
+        const trimmed = std.mem.trimEnd(u8, dir_or_index, "/");
+        return initBase(gpa, io, if (trimmed.len > 0) trimmed else dir_or_index, explicit_config);
+    }
+    pub fn openWithTrunkAndHead(gpa: std.mem.Allocator, io: std.Io, dir_or_index: []const u8, explicit_config: ?[]const u8, explicit_trunk: ?[]const u8, explicit_target_head: ?[]const u8, extra_head_dir: ?[]const u8) !ShardIndex {
+        var norm = try trunk_exl3.normalizeOpenTarget(gpa, io, dir_or_index, explicit_config, explicit_trunk);
+        defer norm.deinit(gpa);
+        var out = try initBase(gpa, io, norm.target, explicit_config);
+        errdefer out.deinit();
+        if (out.pack) |*p| {
+            try pack_parts.verifyPackTrunk(p, gpa, norm.spec, explicit_target_head);
+            return out;
+        }
+        try trunk_exl3.applyOverlayAndPrune(&out, io, norm.spec);
+        try trunk_exl3.applyTargetHeadOverlay(&out, io, explicit_target_head, extra_head_dir);
+        return out;
+    }
+
+    fn initBase(gpa: std.mem.Allocator, io: std.Io, target: []const u8, explicit_config: ?[]const u8) !ShardIndex {
+        var arena = std.heap.ArenaAllocator.init(gpa);
+        var arena_moved = false;
+        errdefer if (!arena_moved) arena.deinit();
+        const a = arena.allocator();
+
+        const is_json = std.mem.endsWith(u8, target, ".json");
+        const is_st = std.mem.endsWith(u8, target, ".safetensors");
+        const dir = try a.dupe(u8, if (is_json or is_st) (std.fs.path.dirname(target) orelse ".") else target);
+        const cfg_path = if (explicit_config) |p| try gpa.dupe(u8, p) else try std.fs.path.join(gpa, &.{ dir, "config.json" });
+        defer gpa.free(cfg_path);
+
+        const cfg_bytes = try std.Io.Dir.cwd().readFileAlloc(io, cfg_path, gpa, .limited(4 << 20));
+        defer gpa.free(cfg_bytes);
+        var cfg_hash: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(cfg_bytes, &cfg_hash, .{});
+        const cfg = try config.parse(gpa, cfg_bytes);
+
+        var out: ShardIndex = .{ .gpa = gpa, .arena = arena, .dir = dir, .cfg = cfg, .cfg_sha256 = cfg_hash };
+        arena_moved = true;
+        errdefer { out.cfg.deinit(); out.arena.deinit(); }
+        if (is_json) {
+            try out.loadIndexJson(io, target);
+        } else if (is_st) {
+            try out.indexSingleSafetensors(io, std.fs.path.basename(target));
+        } else blk: {
+            for ([_][]const u8{ "model.safetensors.index.json", "index.json" }) |idx_name| {
+                const candidate = try std.fs.path.join(gpa, &.{ dir, idx_name });
+                defer gpa.free(candidate);
+                if (out.loadIndexJson(io, candidate)) |_| {
+                    if (out.hasAnyExistingShard(io)) break :blk;
+                    out.weight_map.clearRetainingCapacity();
+                } else |err| switch (err) {
+                    error.FileNotFound => continue,
+                    else => return err,
+                }
+            }
+            try out.scanSafetensorsHeaders(io);
+        }
+        return out;
+    }
+
+    fn hasAnyExistingShard(self: *const ShardIndex, io: std.Io) bool {
+        var it = self.weight_map.valueIterator();
+        while (it.next()) |rel_ptr| {
+            const full = std.fs.path.join(self.gpa, &.{ self.dir, rel_ptr.* }) catch continue;
+            defer self.gpa.free(full);
+            if (std.Io.Dir.cwd().openFile(io, full, .{})) |f| { f.close(io); return true; } else |_| {}
+        }
+        return false;
+    }
+
+    fn loadIndexJson(self: *ShardIndex, io: std.Io, index_path: []const u8) !void {
+        const a = self.arena.allocator();
+        const bytes = try std.Io.Dir.cwd().readFileAlloc(io, index_path, self.gpa, .limited(64 << 20));
+        defer self.gpa.free(bytes);
+        const parsed = try std.json.parseFromSliceLeaky(std.json.Value, a, bytes, .{});
+        const map = try st.index.weightMap(parsed);
+        try self.weight_map.ensureTotalCapacity(a, @intCast(map.count()));
+        var it = map.iterator();
+        while (it.next()) |e| self.weight_map.putAssumeCapacity(e.key_ptr.*, e.value_ptr.string);
+        self.pack = try pack_parts.attach(a, self.gpa, io, parsed, self.dir, &self.weight_map, &self.trunk_k2, &self.trunk_tag);
+    }
+
+    fn indexSingleSafetensors(self: *ShardIndex, io: std.Io, name: []const u8) !void {
+        const a = self.arena.allocator();
+        const shard_rel = try a.dupe(u8, name);
+        const full_path = try std.fs.path.join(self.gpa, &.{ self.dir, shard_rel });
+        defer self.gpa.free(full_path);
+        var f = try st.File.openPrefixes(self.gpa, io, full_path, &.{ "model.", "lm_head." });
+        defer f.close(io);
+        for (f.names.keys()) |tensor_name| try self.weight_map.put(a, try a.dupe(u8, tensor_name), shard_rel);
+    }
+
+    fn scanSafetensorsHeaders(self: *ShardIndex, io: std.Io) !void {
+        var d = try std.Io.Dir.cwd().openDir(io, self.dir, .{ .iterate = true });
+        defer d.close(io);
+        var found: usize = 0;
+        var it = d.iterate();
+        while (try it.next(io)) |entry| {
+            if (entry.kind != .file and entry.kind != .sym_link) continue;
+            if (!std.mem.endsWith(u8, entry.name, ".safetensors") or std.mem.startsWith(u8, entry.name, ".")) continue;
+            try self.indexSingleSafetensors(io, entry.name);
+            found += 1;
+        }
+        if (found == 0) return error.NoSafetensors;
+    }
+
+    pub fn has(self: *const ShardIndex, name: []const u8) bool {
+        return self.weight_map.contains(name);
+    }
+
+    /// True when `name` is stored per rank (its file bytes are already this rank's span).
+    pub fn isSliced(self: *const ShardIndex, name: []const u8) bool {
+        return if (self.pack) |*p| p.isSliced(name) else false;
+    }
+
+    pub fn deinit(self: *ShardIndex) void {
+        self.cfg.deinit(); self.arena.deinit(); self.* = undefined;
+    }
+};
+
+pub const DirectHook = struct {
+    ctx: *anyopaque,
+    copy: *const fn (ctx: *anyopaque, name: []const u8) ?[]const u8,
+    streamRaw: *const fn (ctx: *anyopaque, file: *const st.File, rel: []const u8, bytes: []const u8, up: *Uploader) anyerror!?u64,
+    streamF32: *const fn (ctx: *anyopaque, file: *const st.File, rel: []const u8, tensor: Tensor, up: *Uploader) anyerror!?u64,
+};
+
+pub const SlicedTensor = struct {
+    tensor: Tensor, bytes: []const u8, file: *st.File, rel: []const u8,
+    direct_hit: bool, contiguous_in_file: bool, owned: bool,
+};
+
+pub const ShardSession = struct {
+    idx: *const ShardIndex,
+    io: std.Io,
+    files: std.StringHashMapUnmanaged(st.File) = .empty,
+    direct: ?DirectHook = null,
+    rank: ?ranks.Rank = null,
+
+    pub fn init(idx: *const ShardIndex, io: std.Io) ShardSession { return .{ .idx = idx, .io = io }; }
+    pub fn initWithRank(idx: *const ShardIndex, io: std.Io, rank: ?ranks.Rank) ShardSession { return .{ .idx = idx, .io = io, .rank = rank }; }
+    pub fn close(self: *ShardSession) void {
+        var it = self.files.valueIterator();
+        while (it.next()) |file| { file.release(self.idx.gpa); file.closeCopied(self.io); }
+        self.files.deinit(self.idx.gpa); self.* = undefined;
+    }
+
+    pub fn openShard(self: *ShardSession, rel: []const u8) !*st.File {
+        const gop = try self.files.getOrPut(self.idx.gpa, rel);
+        if (!gop.found_existing) {
+            errdefer _ = self.files.remove(rel);
+            const path = try std.fs.path.join(self.idx.gpa, &.{ self.idx.dir, rel });
+            defer self.idx.gpa.free(path);
+            gop.value_ptr.* = try st.File.openPrefixes(self.idx.gpa, self.io, path, &.{ "model.", "lm_head." });
+            pack_parts.checkFile(if (self.idx.pack) |*p| p else null, gop.value_ptr, rel) catch |err| {
+                gop.value_ptr.close(self.io);
+                return err;
+            };
+        }
+        return gop.value_ptr;
+    }
+
+    /// The file this session reads `name` from (a per-rank pack sends sliced tensors to this rank's part).
+    pub fn relFor(self: *const ShardSession, name: []const u8) ![]const u8 {
+        const rel = self.idx.weight_map.get(name) orelse {
+            if (!@import("builtin").is_test) std.log.err("hy4 checkpoint index has no tensor {s}", .{name});
+            return error.MissingTensor;
+        };
+        return if (self.idx.pack) |*p| p.relFor(name, rel, self.rank) else rel;
+    }
+
+    /// This rank's byte span of `name` in `file`. In a per-rank pack a part file already holds only this rank's bytes,
+    /// and `common/` holds only tensors every rank reads whole (the export checks it), so both are whole; the one
+    /// span left to cut is a tied embedding's vocabulary stripe.
+    pub fn spanOf(self: *const ShardSession, file: *const st.File, name: []const u8, e: st.Entry, rk: ranks.Rank, force_vocab: bool) !ranks.Span {
+        if (self.idx.pack != null and (self.idx.isSliced(name) or !force_vocab)) return .{ .offset = 0, .len = e.end - e.begin };
+        return ranks.tensorSpan(file, name, e, self.idx.cfg.value.text_config, rk, force_vocab);
+    }
+
+    pub fn get(self: *ShardSession, name: []const u8) !struct { tensor: Tensor, file: *st.File, rel: []const u8, direct_hit: bool } {
+        const s = try self.getSlice(self.idx.gpa, name, false);
+        if (s.owned) self.idx.gpa.free(s.bytes);
+        if (s.owned) return error.StridedSliceNeedsGetSlice;
+        var t = s.tensor;
+        t.bytes = s.bytes;
+        return .{ .tensor = t, .file = s.file, .rel = s.rel, .direct_hit = s.direct_hit };
+    }
+
+    pub fn getSlice(self: *ShardSession, alloc: std.mem.Allocator, name: []const u8, force_vocab_slice: bool) !SlicedTensor {
+        const rel = try self.relFor(name);
+        const file = try self.openShard(rel);
+        const raw_file_tensor = file.get(name) orelse return error.MissingTensor;
+        const raw_tensor = if (self.idx.pack) |*p| p.fullView(name, raw_file_tensor) else raw_file_tensor;
+        const entry = file.names.get(name) orelse return error.MissingTensor;
+
+        if (self.rank) |rk| {
+            const span = try self.spanOf(file, name, entry, rk, force_vocab_slice);
+            if (self.direct) |dh| if (dh.copy(dh.ctx, name)) |copied| {
+                if (copied.len != span.bytes()) return error.BadHy4TpSpan;
+                return .{ .tensor = raw_tensor, .bytes = copied, .file = file, .rel = rel, .direct_hit = true, .contiguous_in_file = span.count == 1, .owned = false };
+            };
+            if (span.count == 1) {
+                const sub = raw_tensor.bytes[@intCast(span.offset)..][0..@intCast(span.len)];
+                return .{ .tensor = raw_tensor, .bytes = sub, .file = file, .rel = rel, .direct_hit = false, .contiguous_in_file = true, .owned = false };
+            }
+            const packed_bytes = try ranks.extractSpanAlloc(alloc, raw_tensor.bytes, span);
+            return .{ .tensor = raw_tensor, .bytes = packed_bytes, .file = file, .rel = rel, .direct_hit = false, .contiguous_in_file = false, .owned = true };
+        }
+
+        if (self.direct) |dh| if (dh.copy(dh.ctx, name)) |copied| {
+            return .{ .tensor = raw_tensor, .bytes = copied, .file = file, .rel = rel, .direct_hit = true, .contiguous_in_file = true, .owned = false };
+        };
+        return .{ .tensor = raw_tensor, .bytes = raw_tensor.bytes, .file = file, .rel = rel, .direct_hit = false, .contiguous_in_file = true, .owned = false };
+    }
+
+    pub fn expect(self: *ShardSession, name: []const u8, dtype: st.DType, shape: []const usize) !Tensor {
+        const got = try self.get(name);
+        if (!got.tensor.is(dtype, shape)) return error.UnexpectedTensor;
+        return got.tensor;
+    }
+};
+
+pub fn uploadRawSliced(sess: *ShardSession, gpa: std.mem.Allocator, up: *Uploader, name: []const u8, dtype: st.DType, full_shape: []const usize, local_bytes: usize) !u64 {
+    const got = try sess.getSlice(gpa, name, false);
+    defer if (got.owned) gpa.free(got.bytes);
+    if (!got.tensor.is(dtype, full_shape) or got.bytes.len != local_bytes) return error.UnexpectedTensor;
+    if (!got.direct_hit and got.contiguous_in_file) if (sess.direct) |dh| if (try dh.streamRaw(dh.ctx, got.file, got.rel, got.bytes, up)) |ptr| return ptr;
+    const ptr = try up.dev(got.bytes);
+    if (!got.direct_hit and got.bytes.len >= (128 << 20)) got.file.release(sess.idx.gpa);
+    return ptr;
+}
+
+pub fn uploadF32Sliced(sess: *ShardSession, gpa: std.mem.Allocator, up: *Uploader, name: []const u8, full_shape: []const usize, local_elems: usize, pad_elems: usize, force_vocab: bool) !u64 {
+    const got = try sess.getSlice(gpa, name, force_vocab);
+    defer if (got.owned) gpa.free(got.bytes);
+    if (got.tensor.rank != full_shape.len or !std.mem.eql(usize, got.tensor.shape[0..got.tensor.rank], full_shape))
+        return error.UnexpectedTensor;
+    const elem_sz: usize = switch (got.tensor.dtype) { .f32 => 4, .bf16, .f16 => 2, else => return error.UnexpectedTensor };
+    if (got.bytes.len != local_elems * elem_sz or pad_elems < local_elems) return error.UnexpectedTensor;
+
+    if (pad_elems == local_elems and !got.direct_hit and got.contiguous_in_file) if (sess.direct) |dh| {
+        const sub_t: Tensor = .{ .dtype = got.tensor.dtype, .rank = 1, .shape = .{ local_elems, 0, 0, 0, 0 }, .bytes = got.bytes };
+        if (try dh.streamF32(dh.ctx, got.file, got.rel, sub_t, up)) |ptr| return ptr;
+    };
+    if (got.tensor.dtype == .f32 and pad_elems == local_elems) {
+        const ptr = try up.dev(got.bytes);
+        if (!got.direct_hit and got.bytes.len >= (128 << 20)) got.file.release(sess.idx.gpa);
+        return ptr;
+    }
+    const wide = try gpa.alloc(u8, pad_elems * 4);
+    defer gpa.free(wide);
+    @memset(wide, 0);
+    if (got.tensor.dtype == .f32) {
+        @memcpy(wide[0 .. local_elems * 4], got.bytes);
+    } else if (local_elems > 0) {
+        const sub_t: Tensor = .{ .dtype = got.tensor.dtype, .rank = 1, .shape = .{ local_elems, 0, 0, 0, 0 }, .bytes = got.bytes };
+        try core.quant.convert.widenInto(wide[0 .. local_elems * 4], sub_t);
+    }
+    if (!got.direct_hit and got.bytes.len >= (128 << 20)) got.file.release(sess.idx.gpa);
+    return up.dev(wide);
+}
+
+pub fn uploadF32Any(sess: *ShardSession, gpa: std.mem.Allocator, up: *Uploader, name: []const u8, shape: []const usize) !u64 {
+    var total: usize = 1;
+    for (shape) |d| total *= d;
+    return uploadF32Sliced(sess, gpa, up, name, shape, total, total, false);
+}
+
+pub const UploadedRouter = struct { bf16: u64 = 0, f32: u64 = 0 };
+
+pub fn uploadRouterExl3(sess: *ShardSession, gpa: std.mem.Allocator, up: *Uploader, name: []const u8, e_count: usize, h: usize, dims_pad: usize) !UploadedRouter {
+    const got = try sess.getSlice(gpa, name, false);
+    defer if (got.owned) gpa.free(got.bytes);
+    if (got.tensor.rank != 2 or got.tensor.shape[0] != e_count or got.tensor.shape[1] != h) return error.UnexpectedTensor;
+    switch (got.tensor.dtype) {
+        .bf16 => {
+            if (dims_pad == h) return .{ .bf16 = try up.dev(got.bytes) };
+            const padded = try gpa.alloc(u16, e_count * dims_pad);
+            defer gpa.free(padded);
+            @memset(padded, 0);
+            for (0..e_count) |ex| @memcpy(std.mem.sliceAsBytes(padded[ex * dims_pad ..][0..h]), got.bytes[ex * h * 2 ..][0 .. h * 2]);
+            return .{ .bf16 = try up.dev(std.mem.sliceAsBytes(padded)) };
+        },
+        .f32 => {
+            if (dims_pad == h) return .{ .f32 = try up.dev(got.bytes) };
+            const padded = try gpa.alloc(u32, e_count * dims_pad);
+            defer gpa.free(padded);
+            @memset(padded, 0);
+            for (0..e_count) |ex| @memcpy(std.mem.sliceAsBytes(padded[ex * dims_pad ..][0..h]), got.bytes[ex * h * 4 ..][0 .. h * 4]);
+            return .{ .f32 = try up.dev(std.mem.sliceAsBytes(padded)) };
+        },
+        else => return error.UnexpectedTensor,
+    }
+}
+
+pub fn uploadNorm(sess: *ShardSession, gpa: std.mem.Allocator, up: *Uploader, name: []const u8, width: usize) !RmsNormWeight {
+    const got = try sess.getSlice(gpa, name, false);
+    defer if (got.owned) gpa.free(got.bytes);
+    if (!got.tensor.is(.bf16, &.{width}) or got.bytes.len != width * 2) return error.UnexpectedTensor;
+    const bf16_ptr = try up.dev(got.bytes);
+    if (width % 64 == 0) return .{ .bf16_ptr = bf16_ptr, .f32_ptr = 0, .width = width };
+    const wide = try gpa.alloc(u8, width * 4);
+    defer gpa.free(wide);
+    const sub_t: Tensor = .{ .dtype = .bf16, .rank = 1, .shape = .{ width, 0, 0, 0, 0 }, .bytes = got.bytes };
+    try core.quant.convert.widenInto(wide, sub_t);
+    return .{ .bf16_ptr = bf16_ptr, .f32_ptr = try up.dev(wide), .width = width };
+}
+
+fn padLinearHost(gpa: std.mem.Allocator, raw_bf16: []const u8, n: usize, k: usize, n_pad: usize, k_pad: usize) ![]u8 {
+    const buf = try gpa.alloc(u8, n_pad * k_pad * 2);
+    @memset(buf, 0);
+    for (0..n) |r| @memcpy(buf[r * k_pad * 2 ..][0 .. k * 2], raw_bf16[r * k * 2 ..][0 .. k * 2]);
+    return buf;
+}
+
+pub fn uploadLinearBf16(sess: *ShardSession, gpa: std.mem.Allocator, up: *Uploader, name: []const u8, full_n: usize, full_k: usize, local_n: usize, local_k: usize) !LinearBf16 {
+    const got = try sess.getSlice(gpa, name, false);
+    defer if (got.owned) gpa.free(got.bytes);
+    if (!got.tensor.is(.bf16, &.{ full_n, full_k }) or got.bytes.len != local_n * local_k * 2) return error.UnexpectedTensor;
+    const n_pad = std.mem.alignForward(usize, local_n, 64);
+    const k_pad = std.mem.alignForward(usize, local_k, 64);
+    if (n_pad == local_n and k_pad == local_k) {
+        if (!got.direct_hit and got.contiguous_in_file) if (sess.direct) |dh| if (try dh.streamRaw(dh.ctx, got.file, got.rel, got.bytes, up)) |ptr| {
+            return .{ .ptr = ptr, .n = local_n, .n_full = full_n, .k = local_k, .n_pad = local_n, .k_pad = local_k, .padded = false };
+        };
+        const ptr = try up.dev(got.bytes);
+        if (!got.direct_hit and got.bytes.len >= (128 << 20)) got.file.release(sess.idx.gpa);
+        return .{ .ptr = ptr, .n = local_n, .n_full = full_n, .k = local_k, .n_pad = local_n, .k_pad = local_k, .padded = false };
+    }
+    const padded = try padLinearHost(gpa, got.bytes, local_n, local_k, n_pad, k_pad);
+    defer gpa.free(padded);
+    return .{ .ptr = try up.dev(padded), .n = local_n, .n_full = full_n, .k = local_k, .n_pad = n_pad, .k_pad = k_pad, .padded = true };
+}
+
+fn uploadIhc(sess: *ShardSession, gpa: std.mem.Allocator, up: *Uploader, prefix: []const u8, gates: usize, width: usize) !IhcWeights {
+    var b1: [160]u8 = undefined;
+    var b2: [160]u8 = undefined;
+    var b3: [160]u8 = undefined;
+    return .{
+        .fn_ptr = try uploadF32Any(sess, gpa, up, try std.fmt.bufPrint(&b1, "{s}fn", .{prefix}), &.{ gates, 4 * width }),
+        .base_ptr = try uploadF32Any(sess, gpa, up, try std.fmt.bufPrint(&b2, "{s}base", .{prefix}), &.{gates}),
+        .scale_ptr = try uploadF32Any(sess, gpa, up, try std.fmt.bufPrint(&b3, "{s}scale", .{prefix}), &.{gates / 4}),
+    };
+}
+
+pub fn loadTrunkSession(sess: *ShardSession, up: *Uploader) !TrunkWeights {
+    const t = sess.idx.cfg.value.text_config;
+    const saved_rank = sess.rank;
+    sess.rank = null;
+    defer sess.rank = saved_rank;
+    return .{ .embed_bf16 = try uploadRawSliced(sess, sess.idx.gpa, up, "model.embed_tokens.weight", .bf16, &.{ t.vocab_size, t.hidden_size }, @as(usize, t.vocab_size) * t.hidden_size * 2) };
+}
+
+pub fn loadTrunk(_: std.mem.Allocator, io: std.Io, idx: *const ShardIndex, up: *Uploader) !TrunkWeights {
+    var sess = ShardSession.init(idx, io); defer sess.close();
+    return loadTrunkSession(&sess, up);
+}
+
+pub fn loadHeadSession(sess: *ShardSession, gpa: std.mem.Allocator, up: *Uploader) !HeadWeights {
+    const idx = sess.idx;
+    const t = idx.cfg.value.text_config;
+    const h: usize = t.hidden_size;
+    const ls = try ranks.LocalShape.forText(t, sess.rank);
+    const hc = try uploadIhc(sess, gpa, up, "model.hc_head.hc_head_", 4, h);
+    const final_norm = try uploadNorm(sess, gpa, up, "model.norm.weight", h);
+    if (idx.has("lm_head.trellis")) {
+        const p = try trunk_exl3.uploadProj(sess, gpa, up, "lm_head", ls.vocab_full, h, ls.vocab_stride, h, .col);
+        return .{ .hc = hc, .final_norm = final_norm, .lm_head_exl3 = p.exl3, .vocab_local = ls.vocab_local, .vocab_pad = ls.vocab_stride, .vocab_full = ls.vocab_full };
+    }
+    const has_lm = idx.has("lm_head.weight") or !t.tie_word_embeddings;
+    const lm_name = if (has_lm) "lm_head.weight" else "model.embed_tokens.weight";
+    const bf16 = @import("head_bf16.zig").enabled();
+    return .{
+        .hc = hc, .final_norm = final_norm,
+        .lm_head_f32 = if (bf16) 0 else try uploadF32Sliced(sess, gpa, up, lm_name, &.{ t.vocab_size, h }, ls.vocab_local * h, ls.vocab_stride * h, !has_lm),
+        .lm_head_bf16 = if (bf16) try @import("head_bf16.zig").upload(sess, gpa, up, lm_name, &.{ t.vocab_size, h }, ls.vocab_local * h, ls.vocab_stride * h, !has_lm) else 0,
+        .vocab_local = ls.vocab_local, .vocab_pad = ls.vocab_stride, .vocab_full = ls.vocab_full,
+    };
+}
+
+pub fn loadHead(gpa: std.mem.Allocator, io: std.Io, idx: *const ShardIndex, up: *Uploader) !HeadWeights {
+    var sess = ShardSession.init(idx, io); defer sess.close();
+    return loadHeadSession(&sess, gpa, up);
+}
+
+fn uploadExpert3dSlice(gpa: std.mem.Allocator, sess: *ShardSession, up: *Uploader, name: []const u8, e_count: usize, full_n: usize, full_k: usize, local_n: usize, local_k: usize) ![]LinearBf16 {
+    const got = try sess.getSlice(gpa, name, false);
+    defer if (got.owned) gpa.free(got.bytes);
+    if (!got.tensor.is(.bf16, &.{ e_count, full_n, full_k }) or got.bytes.len != e_count * local_n * local_k * 2)
+        return error.UnexpectedTensor;
+    const out = try gpa.alloc(LinearBf16, e_count);
+    errdefer gpa.free(out);
+    const n_pad = std.mem.alignForward(usize, local_n, 64);
+    const k_pad = std.mem.alignForward(usize, local_k, 64);
+    const stride = local_n * local_k * 2;
+    if (n_pad == local_n and k_pad == local_k) {
+        const streamed: ?u64 = if (!got.direct_hit and got.contiguous_in_file and sess.direct != null)
+            try sess.direct.?.streamRaw(sess.direct.?.ctx, got.file, got.rel, got.bytes, up) else null;
+        const base_ptr = if (streamed) |p| p else blk: {
+            const p = try up.dev(got.bytes);
+            if (!got.direct_hit and got.bytes.len >= (128 << 20)) got.file.release(sess.idx.gpa);
+            break :blk p;
+        };
+        for (out, 0..) |*slot, ex| slot.* = .{ .ptr = base_ptr + ex * stride, .n = local_n, .n_full = full_n, .k = local_k, .n_pad = local_n, .k_pad = local_k, .padded = false };
+    } else {
+        for (out, 0..) |*slot, ex| {
+            const padded = try padLinearHost(gpa, got.bytes[ex * stride ..][0..stride], local_n, local_k, n_pad, k_pad);
+            defer gpa.free(padded);
+            slot.* = .{ .ptr = try up.dev(padded), .n = local_n, .n_full = full_n, .k = local_k, .n_pad = n_pad, .k_pad = k_pad, .padded = true };
+        }
+    }
+    return out;
+}
+
+pub fn loadLayer(gpa: std.mem.Allocator, io: std.Io, idx: *const ShardIndex, up: *Uploader, layer: usize) !LayerWeights {
+    var sess = ShardSession.init(idx, io);
+    defer sess.close();
+    return loadLayerSession(&sess, gpa, up, layer);
+}
+
+pub fn loadLayerSession(sess: *ShardSession, gpa: std.mem.Allocator, up: *Uploader, layer: usize) !LayerWeights {
+    const idx = sess.idx;
+    const t = idx.cfg.value.text_config;
+    if (layer >= t.num_hidden_layers) return error.BadLayerIndex;
+
+    const ls = try ranks.LocalShape.forText(t, sess.rank);
+    const h: usize = t.hidden_size;
+    const q_rank: usize = t.q_lora_rank;
+    const p = "model.layers.{d}.";
+    var nb: [192]u8 = undefined;
+
+    const attn_hc = try uploadIhc(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "hc_attn_layer.hc_pre.hc_", .{layer}), 8, h);
+    const input_norm = try uploadNorm(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "input_layernorm.weight", .{layer}), h);
+    const q_a = try trunk_exl3.uploadProj(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "self_attn.q_a_proj", .{layer}), q_rank, h, q_rank, h, .whole);
+    const q_a_norm = try uploadNorm(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "self_attn.q_a_layernorm.weight", .{layer}), q_rank);
+    const q_b = try trunk_exl3.uploadProj(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "self_attn.q_b_proj", .{layer}), t.queryRows(), q_rank, ls.queryRows(t), q_rank, .col);
+    const kv_a = try trunk_exl3.uploadProj(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "self_attn.kv_a_proj_with_mqa", .{layer}), t.kvARows(), h, t.kvARows(), h, .whole);
+    const kv_a_norm_bf16 = try uploadRawSliced(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "self_attn.kv_a_layernorm.weight", .{layer}), .bf16, &.{t.kv_lora_rank}, @as(usize, t.kv_lora_rank) * 2);
+    const kv_b = try uploadRawSliced(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "self_attn.kv_b_proj.weight", .{layer}), .bf16, &.{ t.kvBRows(), t.kv_lora_rank }, ls.kvBRows(t) * t.kv_lora_rank * 2);
+    const linear_gate = try trunk_exl3.uploadProj(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "self_attn.linear_gate", .{layer}), t.valueRows(), h, ls.valueRows(t), h, .col);
+    const o_proj = try trunk_exl3.uploadProj(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "self_attn.o_proj", .{layer}), h, t.valueRows(), h, ls.valueRows(t), .row);
+    const sinks = try uploadF32Sliced(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "self_attn.learnable_sink_param", .{layer}), &.{t.num_attention_heads}, ls.heads, ls.heads, false);
+
+    const indexer: ?IndexerWeights = if (t.indexer_types[layer] == .full) .{
+        .wq_b = try uploadRawSliced(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "self_attn.indexer.wq_b.weight", .{layer}), .bf16, &.{ @as(usize, t.index_n_heads) * t.index_head_dim, q_rank }, @as(usize, t.index_n_heads) * t.index_head_dim * q_rank * 2),
+        .wk = try uploadRawSliced(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "self_attn.indexer.wk.weight", .{layer}), .bf16, &.{ t.index_head_dim, h }, @as(usize, t.index_head_dim) * h * 2),
+        .k_norm_weight = try uploadF32Any(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "self_attn.indexer.k_norm.weight", .{layer}), &.{t.index_head_dim}),
+        .k_norm_bias = try uploadF32Any(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "self_attn.indexer.k_norm.bias", .{layer}), &.{t.index_head_dim}),
+        .weights_proj = try uploadF32Any(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "self_attn.indexer.weights_proj.weight", .{layer}), &.{ t.index_n_heads, h }),
+    } else null;
+
+    const ffn_hc = try uploadIhc(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "hc_mlp_layer.hc_pre.hc_", .{layer}), 8, h);
+    const post_attn_norm = try uploadNorm(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "post_attention_layernorm.weight", .{layer}), h);
+
+    if (t.mlpKind(layer) == .dense) {
+        const d: usize = t.intermediate_size;
+        return .{
+            .index = layer, .attn_hc = attn_hc, .input_norm = input_norm, .q_a = q_a, .q_a_norm = q_a_norm,
+            .q_b = q_b, .kv_a = kv_a, .kv_a_norm_bf16 = kv_a_norm_bf16, .kv_b = kv_b, .linear_gate = linear_gate,
+            .o_proj = o_proj, .sinks = sinks, .indexer = indexer, .ffn_hc = ffn_hc, .post_attn_norm = post_attn_norm,
+            .mlp = .{ .dense = .{
+                .gate = try trunk_exl3.uploadProj(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "mlp.gate_proj", .{layer}), d, h, ls.dense, h, .col),
+                .up = try trunk_exl3.uploadProj(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "mlp.up_proj", .{layer}), d, h, ls.dense, h, .col),
+                .down = try trunk_exl3.uploadProj(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "mlp.down_proj", .{layer}), h, d, h, ls.dense, .row),
+            } },
+        };
+    }
+
+    const e_count: usize = t.n_routed_experts;
+    const inter: usize = t.moe_intermediate_size;
+    const shared_inter: usize = inter * t.n_shared_experts;
+    const shared: DenseMlp = .{
+        .gate = try trunk_exl3.uploadProj(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "mlp.shared_experts.gate_proj", .{layer}), shared_inter, h, ls.shared, h, .col),
+        .up = try trunk_exl3.uploadProj(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "mlp.shared_experts.up_proj", .{layer}), shared_inter, h, ls.shared, h, .col),
+        .down = try trunk_exl3.uploadProj(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "mlp.shared_experts.down_proj", .{layer}), h, shared_inter, h, ls.shared, .row),
+    };
+
+    if (idx.has(try std.fmt.bufPrint(&nb, p ++ "mlp.experts.0.gate_proj.trellis", .{layer}))) {
+        const dims_pad = std.mem.alignForward(usize, h, 128);
+        const router = try uploadRouterExl3(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "mlp.gate.weight", .{layer}), e_count, h, dims_pad);
+        return .{
+            .index = layer, .attn_hc = attn_hc, .input_norm = input_norm, .q_a = q_a, .q_a_norm = q_a_norm,
+            .q_b = q_b, .kv_a = kv_a, .kv_a_norm_bf16 = kv_a_norm_bf16, .kv_b = kv_b, .linear_gate = linear_gate,
+            .o_proj = o_proj, .sinks = sinks, .indexer = indexer, .ffn_hc = ffn_hc, .post_attn_norm = post_attn_norm,
+            .mlp = .{ .sparse_exl3 = .{
+                .router_bf16 = router.bf16, .router_f32 = router.f32,
+                .correction_bias = try uploadF32Any(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "mlp.gate.e_score_correction_bias", .{layer}), &.{e_count}),
+                .exl3_layer = try exl3_weights.loadLayerExperts(gpa, sess, up, layer, e_count, h, inter, ls.expert, t.swiglu_limit),
+                .shared = shared,
+            } },
+        };
+    }
+
+    const router_f32 = try uploadF32Any(sess, gpa, up, try std.fmt.bufPrint(&nb, p ++ "mlp.gate.weight", .{layer}), &.{ e_count, h });
+    const bias_got = try sess.getSlice(gpa, try std.fmt.bufPrint(&nb, p ++ "mlp.gate.e_score_correction_bias", .{layer}), false);
+    defer if (bias_got.owned) gpa.free(bias_got.bytes);
+    if (bias_got.tensor.rank != 1 or bias_got.tensor.shape[0] != e_count) return error.UnexpectedTensor;
+    const bias_host = try gpa.alloc(f32, e_count);
+    errdefer gpa.free(bias_host);
+    const bias_t: Tensor = .{ .dtype = bias_got.tensor.dtype, .rank = 1, .shape = .{ e_count, 0, 0, 0, 0 }, .bytes = bias_got.bytes };
+    try core.quant.convert.widenInto(std.mem.sliceAsBytes(bias_host), bias_t);
+
+    const gate_up = try uploadExpert3dSlice(gpa, sess, up, try std.fmt.bufPrint(&nb, p ++ "mlp.experts.gate_up_proj", .{layer}), e_count, 2 * inter, h, 2 * ls.expert, h);
+    errdefer gpa.free(gate_up);
+    const down = try uploadExpert3dSlice(gpa, sess, up, try std.fmt.bufPrint(&nb, p ++ "mlp.experts.down_proj", .{layer}), e_count, h, inter, h, ls.expert);
+
+    return .{
+        .index = layer, .attn_hc = attn_hc, .input_norm = input_norm, .q_a = q_a, .q_a_norm = q_a_norm,
+        .q_b = q_b, .kv_a = kv_a, .kv_a_norm_bf16 = kv_a_norm_bf16, .kv_b = kv_b, .linear_gate = linear_gate,
+        .o_proj = o_proj, .sinks = sinks, .indexer = indexer, .ffn_hc = ffn_hc, .post_attn_norm = post_attn_norm,
+        .mlp = .{ .sparse_bf16 = .{
+            .router_f32 = router_f32, .correction_bias_host = bias_host, .gate_up = gate_up, .down = down, .shared = shared,
+        } },
+    };
+}
+
+pub const CheckLoadStats = @import("direct_load.zig").CheckLoadStats;
+pub const checkLoad = @import("direct_load.zig").checkLoad;
+pub const checkLoadRank = @import("direct_load.zig").checkLoadRank;
