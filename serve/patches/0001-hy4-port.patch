index 0000000000000000000000000000000000000000..5e3c2c07761b9487ca2471dd967d2139b7663803
--- /dev/null
+++ b/zig/src/families/hy4_flash/cuda_dense.zig
@@ -0,0 +1,266 @@
+//! The native CUDA attention and dense feed-forward passes for Hy4-flash.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const proj = @import("cuda_projection.zig");
+const ihc = @import("ihc.zig");
+const hc_gpu = @import("ihc_cuda.zig");
+const mla = @import("mla_cuda.zig");
+const shape_ = @import("mla_attention.zig");
+const dims = @import("mla_weights.zig");
+const model = @import("model_weights.zig");
+const rope = @import("rope.zig");
+
+pub const Hyper = struct {
+    w: u64,
+    b: u64,
+    scale: u64,
+    shape: ihc.Shape,
+
+    fn upload(a: *proj.Owned, w: ihc.Weights) !Hyper {
+        return .{
+            .w = try a.upload(w.project.bytes),
+            .b = try a.upload(w.bias.bytes),
+            .scale = try a.upload(w.scale.bytes),
+            .shape = w.shape,
+        };
+    }
+};
+
+pub const Attention = struct {
+    heads: u32,
+    position: rope.Parameters,
+    q_a: proj.Weight,
+    q_norm: u64,
+    q_b: proj.Weight,
+    kv_a: proj.Weight,
+    kv_norm: u64,
+    gate: proj.Weight,
+    output: proj.Weight,
+    output_norm: u64,
+    key: u64,
+    value: u64,
+    sinks: u64,
+    norm: u64,
+    merge: Hyper,
+    needs_reduction: bool,
+
+    pub fn upload(k: *const Kernels, a: *proj.Owned, s: cuda.Stream, w: *const model.TargetLayer) !Attention {
+        const heads = w.attention.heads.count;
+        return .{
+            .heads = heads,
+            .position = w.position,
+            .q_a = try k.project.pack(a, s, w.project_query),
+            .q_norm = try a.upload(w.norm_query.bytes),
+            .q_b = try k.project.pack(a, s, w.attention.query),
+            .kv_a = try k.project.pack(a, s, w.project_kv),
+            .kv_norm = try a.upload(w.norm_kv.bytes),
+            .gate = try k.project.pack(a, s, w.attention.gate),
+            .output = try k.project.pack(a, s, w.attention.output),
+            .output_norm = try a.upload(w.attention_output_norm.bytes),
+            .key = try a.upload(std.mem.sliceAsBytes(w.absorbed.key)),
+            .value = try a.upload(std.mem.sliceAsBytes(w.absorbed.value)),
+            .sinks = try a.upload(std.mem.sliceAsBytes(w.sinks[0..heads])),
+            .norm = try a.upload(w.attention_norm.bytes),
+            .merge = try Hyper.upload(a, w.attention_hc),
+            .needs_reduction = w.attention.owns_output,
+        };
+    }
+};
+
+pub const Feed = struct {
+    gate: proj.Weight,
+    up: proj.Weight,
+    down: proj.Weight,
+    output_norm: u64,
+    input_norm: u64,
+    merge: Hyper,
+
+    pub fn upload(k: *const Kernels, a: *proj.Owned, s: cuda.Stream, w: *const model.TargetLayer) !Feed {
+        if (w.feed != .dense) return error.Hy4DenseFeedRequired;
+        const f = w.feed.dense;
+        return .{
+            .gate = try k.project.pack(a, s, f.projections.gate),
+            .up = try k.project.pack(a, s, f.projections.up),
+            .down = try k.project.pack(a, s, f.projections.down),
+            .output_norm = try a.upload(f.norm.bytes),
+            .input_norm = try a.upload(w.mlp_norm.bytes),
+            .merge = try Hyper.upload(a, w.mlp_hc),
+        };
+    }
+};
+
+pub const Scratch = struct {
+    cap: shape_.Shape,
+    shape: shape_.Shape,
+    inner: u32,
+    collapsed: u64,
+    post: u64,
+    norm_input: u64,
+    normalized: u64,
+    q_low: u64,
+    q_norm: u64,
+    q: u64,
+    q_absorbed: u64,
+    kv: u64,
+    gate: u64,
+    values: u64,
+    latent: u64,
+    rotary: u64,
+    part: u64,
+    sums: u64,
+    branch: u64,
+    ffn_gate: u64,
+    ffn_up: u64,
+    act: u64,
+
+    pub fn init(a: *proj.Owned, shape: shape_.Shape, hidden: u32, q_rank: u32, inner: u32) !Scratch {
+        try shape.check();
+        const rows = shape.rows;
+        const heads = shape.heads;
+        if (rows > proj.max_rows or hidden == 0 or q_rank == 0 or inner == 0) return error.ShortHy4CudaScratch;
+        const max_width = @max(hidden, q_rank, inner, heads * dims.value_width);
+        return .{
+            .cap = shape,
+            .shape = shape,
+            .inner = inner,
+            .collapsed = try bf16(a, rows, hidden),
+            .post = try a.alloc(@as(usize, rows) * ihc.streams * 4),
+            .norm_input = try bf16(a, rows, @max(hidden, q_rank)),
+            .normalized = try bf16(a, rows, hidden),
+            .q_low = try bf16(a, rows, q_rank),
+            .q_norm = try bf16(a, rows, q_rank),
+            .q = try bf16(a, rows, heads * dims.query_stride),
+            .q_absorbed = try bf16(a, rows, heads * dims.absorbed_stride),
+            .kv = try bf16(a, rows, dims.absorbed_stride),
+            .gate = try bf16(a, rows, heads * dims.value_width),
+            .values = try bf16(a, rows, heads * dims.value_width),
+            .latent = try bf16(a, rows, heads * dims.latent),
+            .rotary = try bf16(a, rows, dims.rope),
+            .part = try a.alloc(shape.scratchBytes()),
+            .sums = try a.alloc(@as(usize, rows) * max_width / 64 * 4),
+            .branch = try bf16(a, rows, hidden),
+            .ffn_gate = try bf16(a, rows, inner),
+            .ffn_up = try bf16(a, rows, inner),
+            .act = try bf16(a, rows, inner),
+        };
+    }
+
+    pub fn bind(self: *Scratch, rows: u32, heads: u32, keys: u32) !void {
+        if (rows > self.cap.rows or heads > self.cap.heads or keys > self.cap.key_stride) return error.ShortHy4CudaScratch;
+        self.shape = try shape_.Shape.init(rows, heads, keys);
+    }
+};
+
+fn bf16(a: *proj.Owned, rows: u32, width: u32) !u64 {
+    return a.alloc(@as(usize, rows) * width * @sizeOf(u16));
+}
+
+pub const Cache = struct {
+    positions: u64,
+    slots: u64,
+    retained: u64,
+    counts: u64,
+    data: u64,
+    capacity: u32,
+};
+
+pub const Reduce = struct {
+    ctx: *anyopaque,
+    /// Reduce this rank's output projection before applying the checkpoint's output norm.
+    call: *const fn (*anyopaque, cuda.Stream, u64, usize) anyerror!void,
+};
+
+pub const Kernels = struct {
+    project: proj.Kernels,
+    norm: cuda.norms.Norms,
+    merge: hc_gpu.Kernels,
+    mla_project: mla.Projections,
+    mla_attend: mla.Attention,
+
+    pub fn load(ctx: *const cuda.Context) !Kernels {
+        var project = try proj.Kernels.load(ctx);
+        errdefer project.deinit();
+        var norm = try cuda.norms.Norms.load(ctx.d);
+        errdefer norm.unload();
+        var merge = try hc_gpu.Kernels.load(ctx.d);
+        errdefer merge.deinit();
+        var m = try mla.Projections.load(ctx.d);
+        errdefer m.deinit();
+        return .{
+            .project = project,
+            .norm = norm,
+            .merge = merge,
+            .mla_project = m,
+            .mla_attend = try mla.Attention.load(ctx.d),
+        };
+    }
+
+    pub fn deinit(self: *Kernels) void {
+        self.mla_attend.deinit();
+        self.mla_project.deinit();
+        self.merge.deinit();
+        self.norm.unload();
+        self.project.deinit();
+    }
+
+    fn normal(self: *const Kernels, s: cuda.Stream, x: u64, w: u64, y: u64, f: *const Scratch, width: usize, eps: f32) !void {
+        try self.norm.addRmsTail(s, x, null, w, f.norm_input, y, null, f.shape.rows, width, eps, .{ .round = true });
+    }
+
+    fn collapse(self: *const Kernels, s: cuda.Stream, w: Hyper, norm: u64, f: *const Scratch, x: u64) !ihc.Shape {
+        var shape = w.shape;
+        shape.rows = f.shape.rows;
+        try self.merge.collapse(s, .{ .hidden = x, .projection = w.w, .bias = w.b, .scale = w.scale, .output = f.collapsed, .post = f.post }, shape);
+        try self.normal(s, f.collapsed, norm, f.normalized, f, shape.width, shape.eps);
+        return shape;
+    }
+
+    pub fn attend(self: *const Kernels, s: cuda.Stream, w: *const Attention, f: *const Scratch, cache: Cache, reduction: ?Reduce, x: u64, out: u64) !void {
+        if (f.shape.heads != w.heads or w.needs_reduction != (reduction != null)) return error.BadHy4Rank;
+        const shape = try self.collapse(s, w.merge, w.norm, f, x);
+        const r = shape.rows;
+        try self.project.run(s, w.q_a, f.normalized, f.sums, f.q_low, r);
+        try self.project.run(s, w.kv_a, f.normalized, f.sums, f.kv, r);
+        try self.project.run(s, w.gate, f.normalized, f.sums, f.gate, r);
+        try self.normal(s, f.q_low, w.q_norm, f.q_norm, f, w.q_b.inputs(), shape.eps);
+        try self.project.run(s, w.q_b, f.q_norm, f.sums, f.q, r);
+        try mla.forward(self.mla_project, self.mla_attend, s, .{
+            .query = f.q,
+            .key_weights = w.key,
+            .value_weights = w.value,
+            .value_logits = f.gate,
+            .positions = cache.positions,
+            .rotary_table = f.rotary,
+            .values = f.values,
+            .kv = .{ .projection = f.kv, .gain = w.kv_norm, .write_slots = cache.slots, .capacity = cache.capacity, .epsilon = shape.eps },
+            .attention = .{
+                .query = f.q_absorbed,
+                .cache = cache.data,
+                .slots = cache.retained,
+                .counts = cache.counts,
+                .sinks = w.sinks,
+                .scratch = f.part,
+                .scratch_bytes = f.cap.scratchBytes(),
+                .output = f.latent,
+            },
+        }, f.shape, w.position);
+        try self.project.run(s, w.output, f.values, f.sums, f.branch, r);
+        if (reduction) |op| try op.call(op.ctx, s, f.branch, @as(usize, r) * shape.width);
+        try self.normal(s, f.branch, w.output_norm, f.normalized, f, shape.width, shape.eps);
+        try self.merge.add(s, .{ .residual = x, .branch = f.normalized, .post = f.post, .output = out }, shape);
+    }
+
+    pub fn feed(self: *const Kernels, s: cuda.Stream, w: *const Feed, f: *const Scratch, x: u64, out: u64) !void {
+        const inner = w.down.inputs();
+        if (inner > f.inner) return error.ShortHy4CudaScratch;
+        const shape = try self.collapse(s, w.merge, w.input_norm, f, x);
+        const r = shape.rows;
+        try self.project.run(s, w.gate, f.normalized, f.sums, f.ffn_gate, r);
+        try self.project.run(s, w.up, f.normalized, f.sums, f.ffn_up, r);
+        try self.project.act.swigluRound(s, f.ffn_gate, inner, f.ffn_up, inner, f.act, null, r, inner);
+        try self.project.run(s, w.down, f.act, f.sums, f.branch, r);
+        try self.normal(s, f.branch, w.output_norm, f.normalized, f, shape.width, shape.eps);
+        try self.merge.add(s, .{ .residual = x, .branch = f.normalized, .post = f.post, .output = out }, shape);
+    }
+};
diff --git a/zig/src/families/hy4_flash/cuda_generate.zig b/zig/src/families/hy4_flash/cuda_generate.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b7474841ce8641341e457c7c533f91f5a1ee3381
--- /dev/null
+++ b/zig/src/families/hy4_flash/cuda_generate.zig
@@ -0,0 +1,60 @@
+//! Greedy generation with the CUDA Hy4-flash text model: prefill token ids, decode N, write timings and logits.
+const std = @import("std");
+const cuda = @import("cuda");
+const model = @import("cuda_model.zig");
+
+pub fn main(init: std.process.Init) !void {
+    const a = init.arena.allocator();
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(a);
+    if (args.len != 5) {
+        std.debug.print("usage: tf-hy4-cuda-generate MODEL_DIR PROMPT_IDS.u32 NEW_TOKENS OUT_DIR\n", .{});
+        return error.BadArgs;
+    }
+    const prompt_bytes = try std.Io.Dir.cwd().readFileAlloc(io, args[2], a, .limited(1 << 20));
+    const prompt = try a.alloc(u32, prompt_bytes.len / 4);
+    @memcpy(std.mem.sliceAsBytes(prompt), prompt_bytes[0 .. prompt.len * 4]);
+    const new_tokens = try std.fmt.parseInt(usize, args[3], 10);
+    const out = try std.Io.Dir.cwd().openDir(io, args[4], .{});
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    if (try ctx.capability() != 121) return error.NeedGb10;
+    var s = try cuda.Stream.init(&driver, true);
+    defer s.deinit();
+    var kernels = try model.Kernels.load(a, &driver);
+    const t0 = std.Io.Clock.awake.now(io);
+    const capacity = prompt.len + new_tokens;
+    const hy4 = try model.Model.open(a, io, &driver, s, &kernels, args[1], capacity, @max(prompt.len, 1));
+    const load_ns = t0.durationTo(std.Io.Clock.awake.now(io)).toNanoseconds();
+    std.debug.print("loaded {d} layers, {d:.2} GiB device weights in {d:.1} s\n", .{ hy4.layers.len, @as(f64, @floatFromInt(hy4.weight_bytes)) / (1 << 30), @as(f64, @floatFromInt(load_ns)) / 1e9 });
+    const logits = try a.alloc(f32, hy4.text.vocab_size);
+    var copy: std.ArrayList(u32) = .empty;
+    const p0 = std.Io.Clock.awake.now(io);
+    var u32buf: [1]u32 = undefined;
+    try hy4.pass(prompt, logits);
+    const prefill_ns = p0.durationTo(std.Io.Clock.awake.now(io)).toNanoseconds();
+    try out.writeFile(io, .{ .sub_path = "prefill-logits.f32", .data = std.mem.sliceAsBytes(logits) });
+    const d0 = std.Io.Clock.awake.now(io);
+    for (0..new_tokens) |step| {
+        var best: usize = 0;
+        for (logits, 0..) |v, i| if (v > logits[best]) {
+            best = i;
+        };
+        try copy.append(a, @intCast(best));
+        if (step + 1 == new_tokens) break;
+        u32buf[0] = @intCast(best);
+        try hy4.pass(&u32buf, logits);
+    }
+    const decode_ns = d0.durationTo(std.Io.Clock.awake.now(io)).toNanoseconds();
+    try out.writeFile(io, .{ .sub_path = "generated.u32", .data = std.mem.sliceAsBytes(copy.items) });
+    std.debug.print("prompt {d} tokens: prefill {d:.1} ms ({d:.1} tok/s); decode {d} tokens {d:.1} ms/token\ngenerated={any}\n", .{
+        prompt.len,
+        @as(f64, @floatFromInt(prefill_ns)) / 1e6,
+        @as(f64, @floatFromInt(prompt.len)) * 1e9 / @as(f64, @floatFromInt(prefill_ns)),
+        new_tokens,
+        @as(f64, @floatFromInt(decode_ns)) / 1e6 / @as(f64, @floatFromInt(@max(new_tokens, 2) - 1)),
+        copy.items,
+    });
+}
diff --git a/zig/src/families/hy4_flash/cuda_model.zig b/zig/src/families/hy4_flash/cuda_model.zig
new file mode 100644
index 0000000000000000000000000000000000000000..a6f4c24f012e83bcfa5665bef13aeb17c506c718
--- /dev/null
+++ b/zig/src/families/hy4_flash/cuda_model.zig
@@ -0,0 +1,591 @@
+//! Hy4-flash text model on CUDA for EXL3 routed experts with BF16 elsewhere; one sequence, causal or windowed keys.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const config = @import("config.zig");
+const ihc = @import("ihc.zig");
+const ihc_cuda = @import("ihc_cuda.zig");
+const mla = @import("mla_cuda.zig");
+const m = @import("mla_weights.zig");
+const attn = @import("mla_attention.zig");
+const rope = @import("rope.zig");
+const exl3 = @import("moe_exl3_cuda.zig");
+const expert_weights = @import("exl3_weights.zig");
+const engram = @import("engram.zig");
+const engram_cuda = @import("engram_cuda.zig");
+const direct = @import("bf16_rows.zig");
+
+const H = 3072;
+const S = ihc.streams;
+const L = 1536;
+const D = 13824;
+const E = 512;
+const K = 16;
+const Q = 1024;
+const sparse_stride = 2048;
+const sliding_stride = 512;
+
+pub const Kernels = struct {
+    gemm: cuda.vit.Gemms,
+    norms: cuda.norms.Norms,
+    project: mla.Projections,
+    attention: mla.Attention,
+    ihc: ihc_cuda.Kernels,
+    experts: cuda.exl3_experts.Experts,
+    act: cuda.act_rows.ActRows,
+    glue: cuda.moe_glue.MoeGlue,
+    router: cuda.route_rows.RouteRows,
+    engram: engram_cuda.Kernels,
+
+    /// The kernel images embedded in this build (`-Dnvcc` or `-Dprebuilt`).
+    pub fn load(a: std.mem.Allocator, d: *const cuda.Driver) !Kernels {
+        return .{
+            .gemm = try cuda.vit.Gemms.init(a, d),
+            .norms = try cuda.norms.Norms.load(d),
+            .project = try mla.Projections.load(d),
+            .attention = try mla.Attention.load(d),
+            .ihc = try ihc_cuda.Kernels.load(d),
+            .experts = try cuda.exl3_experts.Experts.load(d),
+            .act = try cuda.act_rows.ActRows.load(d),
+            .glue = try cuda.moe_glue.MoeGlue.load(d),
+            .router = try cuda.route_rows.RouteRows.load(d),
+            .engram = try engram_cuda.Kernels.load(d),
+        };
+    }
+};
+
+const Hc = struct { project: u64, bias: u64, scale: u64 };
+
+const Attention = struct {
+    sliding: bool,
+    heads: u32,
+    hc: Hc,
+    input_norm: u64,
+    q_a: u64,
+    q_norm: u64,
+    q_b: u64,
+    kv_a: u64,
+    kv_norm: u64,
+    key: u64,
+    value: u64,
+    gate: u64,
+    output: u64,
+    output_norm: u64,
+    sinks: u64,
+    cache: cuda.DeviceBuffer,
+};
+
+const Dense = struct { gate: u64, up: u64, down: u64 };
+const Sparse = struct {
+    latent_in: u64,
+    latent_out: u64,
+    shared_gate: u64,
+    shared_up: u64,
+    shared_down: u64,
+    router: u64,
+    router_bias: u64,
+    routed: exl3.Routed,
+};
+
+const Feed = struct {
+    hc: Hc,
+    input_norm: u64,
+    output_norm: u64,
+    mlp: union(enum) { dense: Dense, sparse: Sparse },
+};
+
+const Engram = struct {
+    w: engram_cuda.Weights,
+    table: direct.Table,
+};
+
+const Layer = struct { engram: ?Engram, attention: Attention, feed: Feed };
+
+/// Per-pass device scratch sized for `max_rows`.
+const Scratch = struct {
+    streams: [3]cuda.DeviceBuffer, // [rows, 4, H], rotated through the layer halves
+    collapsed: u64,
+    post: u64,
+    hidden: u64,
+    norm_tmp: u64,
+    q_raw: u64,
+    q_tmp: u64,
+    q_resid: u64,
+    q: u64,
+    kv: u64,
+    gate: u64,
+    absorb: u64,
+    latent_out: u64,
+    values: u64,
+    branch: u64,
+    branch_norm: u64,
+    attn_scratch: u64,
+    attn_scratch_bytes: usize,
+    positions: cuda.DeviceBuffer,
+    table: u64,
+    slots: cuda.DeviceBuffer,
+    counts: cuda.DeviceBuffer,
+    write_slots: cuda.DeviceBuffer,
+    media: u64,
+    latent: u64,
+    logits: u64,
+    picks: u64,
+    probabilities: u64,
+    mix: u64,
+    route_out: u64,
+    ff_gate: u64,
+    ff_up: u64,
+    ff_inner: u64,
+    shared: u64,
+    e_raw: cuda.DeviceBuffer,
+    e_normalized: u64,
+    e_keys: u64,
+    e_value: u64,
+    head_hidden: u64,
+    head_norm: u64,
+    lm_logits: u64,
+};
+
+pub const Model = struct {
+    a: std.mem.Allocator,
+    d: *const cuda.Driver,
+    s: cuda.Stream,
+    k: *Kernels,
+    text: config.Text,
+    own: cuda.exl3_upload.Uploader,
+    layers: []Layer,
+    embed: u64,
+    head_hc: Hc,
+    final_norm: u64,
+    lm_head: u64,
+    scratch: Scratch,
+    max_rows: usize,
+    capacity: usize,
+    history: std.ArrayList(u32) = .empty,
+    weight_bytes: usize = 0,
+
+    fn tensor(ck: *core.Checkpoint, name: []const u8, dtype: anytype, shape: []const usize) ![]const u8 {
+        const t = try ck.get(name);
+        if (!t.is(dtype, shape)) {
+            std.debug.print("unexpected tensor {s}: {any} {any}\n", .{ name, t.dtype, t.shape[0..t.rank] });
+            return error.BadHy4CheckpointTensor;
+        }
+        return t.bytes;
+    }
+
+    fn up(self: *Model, ck: *core.Checkpoint, comptime fmt: []const u8, args: anytype, dtype: anytype, shape: []const usize) !u64 {
+        var buf: [192]u8 = undefined;
+        const name = try std.fmt.bufPrint(&buf, fmt, args);
+        return self.own.dev(try tensor(ck, name, dtype, shape));
+    }
+
+    fn zeros(self: *Model, bytes: usize) !u64 {
+        const z = try std.heap.page_allocator.alloc(u8, bytes);
+        defer std.heap.page_allocator.free(z);
+        @memset(z, 0);
+        return self.own.dev(z);
+    }
+
+    pub fn open(a: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, s: cuda.Stream, k: *Kernels, dir: []const u8, capacity: usize, max_rows: usize) !*Model {
+        const cfg = try config.parse(a, try std.Io.Dir.cwd().readFileAlloc(io, try std.fs.path.join(a, &.{ dir, "config.json" }), a, .limited(1 << 20)));
+        const t = cfg.value.text_config;
+        if (t.hidden_size != H or t.hc_mult != S or t.routed_expert_hidden_size != L or t.moe_intermediate_size != L or
+            t.intermediate_size != D or t.n_routed_experts != E or t.num_experts_per_tok != K or t.q_lora_rank != Q)
+            return error.BadHy4ModelShape;
+        if (capacity > sparse_stride or max_rows == 0 or max_rows > 1024) return error.BadHy4RunnerCapacity;
+        const ck = try a.create(core.Checkpoint);
+        ck.* = try core.Checkpoint.openModel(a, io, dir);
+        const self = try a.create(Model);
+        self.* = .{
+            .a = a,
+            .d = d,
+            .s = s,
+            .k = k,
+            .text = t,
+            // Upload tables and staging go through a freeing allocator: the arena would keep them all.
+            .own = .{ .d = d, .gpa = std.heap.page_allocator, .max_buffers = 1 << 20, .slab = 256 << 20 },
+            .layers = try a.alloc(Layer, t.num_hidden_layers),
+            .embed = undefined,
+            .head_hc = undefined,
+            .final_norm = undefined,
+            .lm_head = undefined,
+            .scratch = undefined,
+            .max_rows = max_rows,
+            .capacity = capacity,
+        };
+        const V: usize = t.vocab_size;
+        self.embed = try self.up(ck, "model.embed_tokens.weight", .{}, .bf16, &.{ V, H });
+        self.head_hc = .{
+            .project = try self.up(ck, "model.hc_head.hc_head_fn", .{}, .f32, &.{ S, S * H }),
+            .bias = try self.up(ck, "model.hc_head.hc_head_base", .{}, .f32, &.{S}),
+            .scale = try self.up(ck, "model.hc_head.hc_head_scale", .{}, .f32, &.{1}),
+        };
+        self.final_norm = try self.up(ck, "model.norm.weight", .{}, .bf16, &.{H});
+        self.lm_head = try self.up(ck, "lm_head.weight", .{}, .bf16, &.{ V, H });
+        ck.release();
+        // UMA guard: device memory is not charged to the cgroup, so stop before the system runs dry.
+        const floor_gib = try @import("sys").environment.read(usize, "TF_HY4_MEM_FLOOR_GIB", 10);
+        for (self.layers, 0..) |*layer, i| {
+            const avail = memAvailable();
+            std.debug.print("layer {d:>2}: device {d:.2} GiB, MemAvailable {d:.2} GiB\n", .{ i, gib(self.own.bytes), gib(avail) });
+            if (avail < floor_gib << 30) {
+                std.debug.print("stopping: MemAvailable below the {d} GiB floor\n", .{floor_gib});
+                return error.Hy4MemoryFloor;
+            }
+            layer.* = try self.loadLayer(a, io, ck, dir, i);
+            // The layer is on the device: its mapped shard pages (and page cache) would otherwise stay resident.
+            ck.release();
+        }
+        std.debug.print("all layers: device {d:.2} GiB, MemAvailable {d:.2} GiB\n", .{ gib(self.own.bytes), gib(memAvailable()) });
+        self.weight_bytes = self.own.bytes;
+        self.scratch = try self.allocScratch();
+        return self;
+    }
+
+    fn gib(bytes: usize) f64 {
+        return @as(f64, @floatFromInt(bytes)) / (1 << 30);
+    }
+
+    /// MemAvailable from /proc/meminfo in bytes (0 when unreadable, which trips the floor).
+    fn memAvailable() usize {
+        var buf: [4096]u8 = undefined;
+        const fd = std.c.open("/proc/meminfo", .{});
+        if (fd < 0) return 0;
+        defer _ = std.c.close(fd);
+        const got = std.c.read(fd, &buf, buf.len);
+        if (got <= 0) return 0;
+        const n: usize = @intCast(got);
+        var it = std.mem.tokenizeScalar(u8, buf[0..n], '\n');
+        while (it.next()) |line| if (std.mem.startsWith(u8, line, "MemAvailable:")) {
+            var f = std.mem.tokenizeScalar(u8, line["MemAvailable:".len..], ' ');
+            const kb = std.fmt.parseInt(usize, f.next() orelse return 0, 10) catch return 0;
+            return kb * 1024;
+        };
+        return 0;
+    }
+
+    fn loadLayer(self: *Model, a: std.mem.Allocator, io: std.Io, ck: *core.Checkpoint, dir: []const u8, i: usize) !Layer {
+        const t = self.text;
+        const sliding = t.layer_types[i] == .sliding_attention;
+        const heads: u32 = if (sliding) t.swa_num_attention_heads else t.num_attention_heads;
+        const hh: usize = heads;
+        const p = "model.layers.{d}.";
+        var kv_b_name: [96]u8 = undefined;
+        const kv_b = try tensor(ck, try std.fmt.bufPrint(&kv_b_name, p ++ "self_attn.kv_b_proj.weight", .{i}), .bf16, &.{ hh * (m.nope + m.value_width), m.latent });
+        const tmp = std.heap.page_allocator;
+        const split = try m.splitBf16(tmp, kv_b, heads);
+        defer tmp.free(split.key);
+        defer tmp.free(split.value);
+        var cache = try cuda.DeviceBuffer.alloc(self.d, self.capacity * m.absorbed_stride * 2);
+        try cache.fill8(0, null);
+        const att: Attention = .{
+            .sliding = sliding,
+            .heads = heads,
+            .hc = .{
+                .project = try self.up(ck, p ++ "hc_attn_layer.hc_pre.hc_fn", .{i}, .f32, &.{ 2 * S, S * H }),
+                .bias = try self.up(ck, p ++ "hc_attn_layer.hc_pre.hc_base", .{i}, .f32, &.{2 * S}),
+                .scale = try self.up(ck, p ++ "hc_attn_layer.hc_pre.hc_scale", .{i}, .f32, &.{2}),
+            },
+            .input_norm = try self.up(ck, p ++ "input_layernorm.weight", .{i}, .bf16, &.{H}),
+            .q_a = try self.up(ck, p ++ "self_attn.q_a_proj.weight", .{i}, .bf16, &.{ Q, H }),
+            .q_norm = try self.up(ck, p ++ "self_attn.q_a_layernorm.weight", .{i}, .bf16, &.{Q}),
+            .q_b = try self.up(ck, p ++ "self_attn.q_b_proj.weight", .{i}, .bf16, &.{ hh * m.query_stride, Q }),
+            .kv_a = try self.up(ck, p ++ "self_attn.kv_a_proj_with_mqa.weight", .{i}, .bf16, &.{ m.absorbed_stride, H }),
+            .kv_norm = try self.up(ck, p ++ "self_attn.kv_a_layernorm.weight", .{i}, .bf16, &.{m.latent}),
+            .key = try self.own.dev(std.mem.sliceAsBytes(split.key)),
+            .value = try self.own.dev(std.mem.sliceAsBytes(split.value)),
+            .gate = try self.up(ck, p ++ "self_attn.linear_gate.weight", .{i}, .bf16, &.{ hh * m.value_width, H }),
+            .output = try self.up(ck, p ++ "self_attn.o_proj.weight", .{i}, .bf16, &.{ H, hh * m.value_width }),
+            .output_norm = try self.up(ck, p ++ "self_attn.post_proj_norm.weight", .{i}, .bf16, &.{H}),
+            .sinks = try self.up(ck, p ++ "self_attn.learnable_sink_param", .{i}, .f32, &.{hh}),
+            .cache = cache,
+        };
+        const dense = t.mlp_layer_types[i] == .dense;
+        const feed: Feed = .{
+            .hc = .{
+                .project = try self.up(ck, p ++ "hc_mlp_layer.hc_pre.hc_fn", .{i}, .f32, &.{ 2 * S, S * H }),
+                .bias = try self.up(ck, p ++ "hc_mlp_layer.hc_pre.hc_base", .{i}, .f32, &.{2 * S}),
+                .scale = try self.up(ck, p ++ "hc_mlp_layer.hc_pre.hc_scale", .{i}, .f32, &.{2}),
+            },
+            .input_norm = try self.up(ck, p ++ "post_attention_layernorm.weight", .{i}, .bf16, &.{H}),
+            .output_norm = if (dense)
+                try self.up(ck, p ++ "mlp.post_fc2_norm.weight", .{i}, .bf16, &.{H})
+            else
+                try self.up(ck, p ++ "mlp.combine_output_norm.weight", .{i}, .bf16, &.{H}),
+            .mlp = if (dense) .{ .dense = .{
+                .gate = try self.up(ck, p ++ "mlp.gate_proj.weight", .{i}, .bf16, &.{ D, H }),
+                .up = try self.up(ck, p ++ "mlp.up_proj.weight", .{i}, .bf16, &.{ D, H }),
+                .down = try self.up(ck, p ++ "mlp.down_proj.weight", .{i}, .bf16, &.{ H, D }),
+            } } else .{ .sparse = blk: {
+                const experts = try std.heap.page_allocator.alloc(expert_weights.Expert, E);
+                defer std.heap.page_allocator.free(experts);
+                for (experts, 0..) |*e, j| e.* = try expert_weights.readExpert(ck, i, j, L, L);
+                break :blk .{
+                    .latent_in = try self.up(ck, p ++ "mlp.routed_expert_down_proj.weight", .{i}, .bf16, &.{ L, H }),
+                    .latent_out = try self.up(ck, p ++ "mlp.routed_expert_up_proj.weight", .{i}, .bf16, &.{ H, L }),
+                    .shared_gate = try self.up(ck, p ++ "mlp.shared_experts.gate_proj.weight", .{i}, .bf16, &.{ L, H }),
+                    .shared_up = try self.up(ck, p ++ "mlp.shared_experts.up_proj.weight", .{i}, .bf16, &.{ L, H }),
+                    .shared_down = try self.up(ck, p ++ "mlp.shared_experts.down_proj.weight", .{i}, .bf16, &.{ H, L }),
+                    .router = try self.up(ck, p ++ "mlp.gate.weight", .{i}, .bf16, &.{ E, H }),
+                    .router_bias = try self.up(ck, p ++ "mlp.gate.e_score_correction_bias", .{i}, .f32, &.{E}),
+                    .routed = try exl3.Routed.init(&self.own, experts, L, L, self.max_rows, K, t.swiglu_limit),
+                };
+            } },
+        };
+        var eng: ?Engram = null;
+        if (std.mem.indexOfScalar(u32, t.engram_layer_ids, @intCast(i + 1)) != null) {
+            const e = "model.layers.{d}.engram_layer.";
+            const ein: usize = engram_cuda.input;
+            var key: [S]u64 = undefined;
+            for (&key, 0..) |*dst, j| dst.* = try self.up(ck, e ++ "key_projs.{d}.weight", .{ i, j }, .bf16, &.{ H, ein });
+            const cat = struct {
+                fn run(mm: *Model, c: *core.Checkpoint, layer: usize, comptime fmt: []const u8, count: usize, size: usize) !u64 {
+                    const out = try mm.a.alloc(u8, count * size * 2);
+                    defer mm.a.free(out);
+                    for (0..count) |j| {
+                        var nb: [128]u8 = undefined;
+                        @memcpy(out[j * size * 2 ..][0 .. size * 2], try tensor(c, try std.fmt.bufPrint(&nb, fmt, .{ layer, j }), .bf16, &.{size}));
+                    }
+                    return mm.own.dev(out);
+                }
+            }.run;
+            const w: engram_cuda.Weights = .{
+                .lookup_gamma = try cat(self, ck, i, e ++ "lookup_per_head_norms.{d}.weight", engram_cuda.columns, engram_cuda.head_width),
+                .value = try self.up(ck, e ++ "value_proj.weight", .{i}, .bf16, &.{ H, ein }),
+                .value_bias = try self.up(ck, e ++ "value_proj.bias", .{i}, .bf16, &.{H}),
+                .value_gain = try self.up(ck, e ++ "unified_pre_gamma", .{i}, .bf16, &.{H}),
+                .key = key,
+                .key_bias = try cat(self, ck, i, e ++ "key_projs.{d}.bias", S, H),
+                .key_gain = try cat(self, ck, i, e ++ "norm_key.{d}.weight", S, H),
+                .query_gain = try cat(self, ck, i, e ++ "norm_query.{d}.weight", S, H),
+                .delta_gain = try cat(self, ck, i, e ++ "unified_per_hc_scales.{d}", S, H),
+            };
+            var nb: [128]u8 = undefined;
+            const lookup = (try ck.get(try std.fmt.bufPrint(&nb, e ++ "lookup_table", .{i}))).bytes;
+            const map = try engram.TokenMap.open(lookup, t);
+            const hash = try engram.Layer.open(t, @intCast(i + 1));
+            var tb: [128]u8 = undefined;
+            const table_name = try std.fmt.bufPrint(&tb, e ++ "multi_head_embedding.embedding.weight", .{i});
+            const shard = try shardOf(a, io, dir, table_name);
+            // The config's per-layer row count, so a wrong or repacked table fails here and not mid-forward.
+            const rows_expected = try t.engramRows(@intCast(i + 1));
+            eng = .{ .w = w, .table = try direct.openDirect(a, shard, table_name, map, hash, rows_expected) };
+        }
+        return .{ .engram = eng, .attention = att, .feed = feed };
+    }
+
+    /// The safetensors file holding `name` (the Engram tables sit alone in their shards).
+    fn shardOf(a: std.mem.Allocator, io: std.Io, dir: []const u8, name: []const u8) ![:0]const u8 {
+        const index = try std.Io.Dir.cwd().readFileAlloc(io, try std.fs.path.join(a, &.{ dir, "model.safetensors.index.json" }), a, .limited(1 << 26));
+        const parsed = try std.json.parseFromSliceLeaky(std.json.Value, a, index, .{});
+        const file = parsed.object.get("weight_map").?.object.get(name) orelse return error.MissingHy4EngramTable;
+        return std.fmt.allocPrintSentinel(a, "{s}/{s}", .{ dir, file.string }, 0);
+    }
+
+    fn allocScratch(self: *Model) !Scratch {
+        const r = self.max_rows;
+        const shape = try attn.Shape.init(@intCast(r), 64, sparse_stride);
+        var sc: Scratch = undefined;
+        for (&sc.streams) |*x| x.* = try cuda.DeviceBuffer.alloc(self.d, r * S * H * 2);
+        sc.collapsed = try self.zeros(r * H * 2);
+        sc.post = try self.zeros(r * S * 4);
+        sc.hidden = try self.zeros(r * H * 2);
+        sc.norm_tmp = try self.zeros(r * D * 2);
+        sc.q_raw = try self.zeros(r * Q * 2);
+        sc.q_tmp = try self.zeros(r * Q * 2);
+        sc.q_resid = try self.zeros(r * Q * 2);
+        sc.q = try self.zeros(r * 64 * m.query_stride * 2);
+        sc.kv = try self.zeros(r * m.absorbed_stride * 2);
+        sc.gate = try self.zeros(r * 64 * m.value_width * 2);
+        sc.absorb = try self.zeros(r * 64 * m.absorbed_stride * 2);
+        sc.latent_out = try self.zeros(r * 64 * m.latent * 2);
+        sc.values = try self.zeros(r * 64 * m.value_width * 2);
+        sc.branch = try self.zeros(r * H * 2);
+        sc.branch_norm = try self.zeros(r * H * 2);
+        sc.attn_scratch_bytes = shape.scratchBytes();
+        sc.attn_scratch = try self.zeros(sc.attn_scratch_bytes);
+        sc.positions = try cuda.DeviceBuffer.alloc(self.d, r * 12);
+        sc.table = try self.zeros(r * 64 * 2);
+        sc.slots = try cuda.DeviceBuffer.alloc(self.d, r * sparse_stride * 4);
+        sc.counts = try cuda.DeviceBuffer.alloc(self.d, r * 4);
+        sc.write_slots = try cuda.DeviceBuffer.alloc(self.d, r * 4);
+        sc.media = try self.zeros(r * 4);
+        sc.latent = try self.zeros(r * L * 2);
+        sc.logits = try self.zeros(r * E * 4);
+        sc.picks = try self.zeros(r * K * 4);
+        sc.probabilities = try self.zeros(r * K * 4);
+        sc.mix = try self.zeros(r * L * 2);
+        sc.route_out = try self.zeros(r * H * 2);
+        sc.ff_gate = try self.zeros(r * D * 2);
+        sc.ff_up = try self.zeros(r * D * 2);
+        sc.ff_inner = try self.zeros(r * D * 2);
+        sc.shared = try self.zeros(r * H * 2);
+        sc.e_raw = try cuda.DeviceBuffer.alloc(self.d, r * engram_cuda.input * 2);
+        sc.e_normalized = try self.zeros(r * engram_cuda.input * 2);
+        sc.e_keys = try self.zeros(S * r * H * 2);
+        sc.e_value = try self.zeros(r * H * 2);
+        sc.head_hidden = try self.zeros(r * H * 2);
+        sc.head_norm = try self.zeros(r * H * 2);
+        sc.lm_logits = try self.zeros(@as(usize, self.text.vocab_size) * 4);
+        return sc;
+    }
+
+    fn hcShape(self: *const Model, rows: usize, gates: u32) ihc.Shape {
+        return .{ .rows = @intCast(rows), .width = H, .gates = gates, .eps = self.text.rms_norm_eps, .gate_eps = self.text.hc_eps, .post_magnitude = self.text.hc_magnitude };
+    }
+
+    /// Run `tokens` (appended at the current history length) through the model; returns the last row's logits.
+    pub fn pass(self: *Model, tokens: []const u32, logits_out: []f32) !void {
+        const rows = tokens.len;
+        const start = self.history.items.len;
+        if (rows == 0 or rows > self.max_rows or start + rows > self.capacity) return error.BadHy4PassRows;
+        try self.history.appendSlice(self.a, tokens);
+        const sc = self.scratch;
+        const s = self.s;
+        const k = self.k;
+        const eps = self.text.rms_norm_eps;
+        // Embedding into four identical streams.
+        var x = sc.streams[0].ptr;
+        for (tokens, 0..) |tok, r| for (0..S) |st| {
+            try sc.streams[0].copyFrom((r * S + st) * H * 2, self.embed + @as(u64, tok) * H * 2, H * 2, s.handle);
+        };
+        // Positions (text: t = h = w), write slots and key lists for both attention kinds.
+        const positions = try self.a.alloc(i32, rows * 3);
+        defer self.a.free(positions);
+        const writes = try self.a.alloc(u32, rows);
+        defer self.a.free(writes);
+        for (0..rows) |r| {
+            const p: i32 = @intCast(start + r);
+            positions[r * 3 ..][0..3].* = .{ p, p, p };
+            writes[r] = @intCast(start + r);
+        }
+        try sc.positions.uploadAsync(0, std.mem.sliceAsBytes(positions), s.handle);
+        try sc.write_slots.uploadAsync(0, std.mem.sliceAsBytes(writes), s.handle);
+        const keys_sparse = try self.a.alloc(u32, rows * sparse_stride);
+        defer self.a.free(keys_sparse);
+        const keys_sliding = try self.a.alloc(u32, rows * sliding_stride);
+        defer self.a.free(keys_sliding);
+        const counts_sparse = try self.a.alloc(u32, rows);
+        defer self.a.free(counts_sparse);
+        const counts_sliding = try self.a.alloc(u32, rows);
+        defer self.a.free(counts_sliding);
+        @memset(keys_sparse, 0);
+        @memset(keys_sliding, 0);
+        for (0..rows) |r| {
+            const pos = start + r;
+            counts_sparse[r] = @intCast(pos + 1);
+            for (0..pos + 1) |j| keys_sparse[r * sparse_stride + j] = @intCast(j);
+            const first = if (pos + 1 > sliding_stride) pos + 1 - sliding_stride else 0;
+            counts_sliding[r] = @intCast(pos + 1 - first);
+            for (first..pos + 1, 0..) |j, n| keys_sliding[r * sliding_stride + n] = @intCast(j);
+        }
+        // Engram windows from the committed history.
+        const windows = try self.a.alloc([engram.order]u32, rows);
+        defer self.a.free(windows);
+        const pad = self.text.engram_pad_id;
+        for (windows, 0..) |*w, r| {
+            const pos = start + r;
+            for (w, 0..) |*v, back| v.* = if (pos >= back) self.history.items[pos - back] else pad;
+        }
+        const raw_rows = try self.a.alloc(u16, rows * engram_cuda.input);
+        defer self.a.free(raw_rows);
+
+        var slot: usize = 0; // index of the stream buffer x lives in
+        for (self.layers) |*layer| {
+            // Engram residual into the streams.
+            if (layer.engram) |*e| {
+                try e.table.gather(self.a, windows, raw_rows);
+                try sc.e_raw.uploadAsync(0, std.mem.sliceAsBytes(raw_rows), s.handle);
+                const out = sc.streams[(slot + 1) % 3].ptr;
+                try k.engram.forward(s, &k.gemm, e.w, .{
+                    .raw = sc.e_raw.ptr,
+                    .normalized = sc.e_normalized,
+                    .keys = sc.e_keys,
+                    .value = sc.e_value,
+                    .media = sc.media,
+                    .state = x,
+                    .output = out,
+                }, @intCast(rows), @intCast(rows), H, self.text.engram_fp8_embedding);
+                slot = (slot + 1) % 3;
+                x = out;
+            }
+            // Attention half.
+            const at = &layer.attention;
+            const hh: usize = at.heads;
+            try k.ihc.collapse(s, .{ .hidden = x, .projection = at.hc.project, .bias = at.hc.bias, .scale = at.hc.scale, .output = sc.collapsed, .post = sc.post }, self.hcShape(rows, 2 * S));
+            try k.norms.addRmsTail(s, sc.collapsed, null, at.input_norm, sc.norm_tmp, sc.hidden, null, rows, H, eps, .{ .round = true });
+            try k.gemm.run(s, sc.hidden, at.q_a, sc.q_raw, rows, Q, H, .bf16);
+            try k.norms.addRmsTail(s, sc.q_raw, null, at.q_norm, sc.q_tmp, sc.q_resid, null, rows, Q, eps, .{ .round = true });
+            try k.gemm.run(s, sc.q_resid, at.q_b, sc.q, rows, hh * m.query_stride, Q, .bf16);
+            try k.gemm.run(s, sc.hidden, at.kv_a, sc.kv, rows, m.absorbed_stride, H, .bf16);
+            try k.gemm.run(s, sc.hidden, at.gate, sc.gate, rows, hh * m.value_width, H, .bf16);
+            const stride: usize = if (at.sliding) sliding_stride else sparse_stride;
+            try sc.slots.uploadAsync(0, std.mem.sliceAsBytes(if (at.sliding) keys_sliding else keys_sparse), s.handle);
+            try sc.counts.uploadAsync(0, std.mem.sliceAsBytes(if (at.sliding) counts_sliding else counts_sparse), s.handle);
+            const shape = try attn.Shape.init(@intCast(rows), at.heads, @intCast(stride));
+            try mla.forward(k.project, k.attention, s, .{
+                .query = sc.q,
+                .key_weights = at.key,
+                .value_weights = at.value,
+                .value_logits = sc.gate,
+                .positions = sc.positions.ptr,
+                .rotary_table = sc.table,
+                .kv = .{ .projection = sc.kv, .gain = at.kv_norm, .write_slots = sc.write_slots.ptr, .capacity = @intCast(self.capacity), .epsilon = eps },
+                .attention = .{
+                    .query = sc.absorb,
+                    .cache = at.cache.ptr,
+                    .slots = sc.slots.ptr,
+                    .counts = sc.counts.ptr,
+                    .sinks = at.sinks,
+                    .scratch = sc.attn_scratch,
+                    .scratch_bytes = sc.attn_scratch_bytes,
+                    .output = sc.latent_out,
+                },
+                .values = sc.values,
+            }, shape, try self.text.rotary(if (at.sliding) .sliding_attention else .deepseek_sparse_attention));
+            try k.gemm.run(s, sc.values, at.output, sc.branch, rows, H, hh * m.value_width, .bf16);
+            try k.norms.addRmsTail(s, sc.branch, null, at.output_norm, sc.norm_tmp, sc.branch_norm, null, rows, H, eps, .{ .round = true });
+            const after_attn = sc.streams[(slot + 1) % 3].ptr;
+            try k.ihc.add(s, .{ .residual = x, .branch = sc.branch_norm, .post = sc.post, .output = after_attn }, self.hcShape(rows, 2 * S));
+            slot = (slot + 1) % 3;
+            x = after_attn;
+            // Feed-forward half.
+            const f = &layer.feed;
+            try k.ihc.collapse(s, .{ .hidden = x, .projection = f.hc.project, .bias = f.hc.bias, .scale = f.hc.scale, .output = sc.collapsed, .post = sc.post }, self.hcShape(rows, 2 * S));
+            try k.norms.addRmsTail(s, sc.collapsed, null, f.input_norm, sc.norm_tmp, sc.hidden, null, rows, H, eps, .{ .round = true });
+            switch (f.mlp) {
+                .dense => |dn| {
+                    try k.gemm.run(s, sc.hidden, dn.gate, sc.ff_gate, rows, D, H, .bf16);
+                    try k.gemm.run(s, sc.hidden, dn.up, sc.ff_up, rows, D, H, .bf16);
+                    try k.act.swiglu(s, sc.ff_gate, D, sc.ff_up, D, sc.ff_inner, null, rows, D);
+                    try k.gemm.run(s, sc.ff_inner, dn.down, sc.shared, rows, H, D, .bf16);
+                    try k.norms.addRmsTail(s, sc.shared, null, f.output_norm, sc.norm_tmp, sc.branch_norm, null, rows, H, eps, .{ .round = true });
+                },
+                .sparse => |sp| {
+                    try k.gemm.run(s, sc.hidden, sp.latent_in, sc.latent, rows, L, H, .bf16);
+                    try k.router.logits(s, sc.hidden, H, sp.router, sc.logits, rows, H, E);
+                    try k.glue.topk(s, sc.logits, sp.router_bias, .{ .experts = E, .topk = K, .shared = false, .score = true, .normalize = true, .scale = self.text.routed_scaling_factor }, sc.picks, sc.probabilities, rows);
+                    const y = try sp.routed.run(&k.experts, s, sc.latent, sc.picks, rows);
+                    try k.glue.combine(s, y, .f32, sc.probabilities, sc.mix, .bf16, rows, K, L);
+                    try k.gemm.run(s, sc.mix, sp.latent_out, sc.route_out, rows, H, L, .bf16);
+                    try k.gemm.run(s, sc.hidden, sp.shared_gate, sc.ff_gate, rows, L, H, .bf16);
+                    try k.gemm.run(s, sc.hidden, sp.shared_up, sc.ff_up, rows, L, H, .bf16);
+                    try k.act.swiglu(s, sc.ff_gate, L, sc.ff_up, L, sc.ff_inner, null, rows, L);
+                    try k.gemm.run(s, sc.ff_inner, sp.shared_down, sc.shared, rows, H, L, .bf16);
+                    try k.norms.addRmsTail(s, sc.route_out, sc.shared, f.output_norm, sc.norm_tmp, sc.branch_norm, null, rows, H, eps, .{ .round = true });
+                },
+            }
+            const after_ff = sc.streams[(slot + 1) % 3].ptr;
+            try k.ihc.add(s, .{ .residual = x, .branch = sc.branch_norm, .post = sc.post, .output = after_ff }, self.hcShape(rows, 2 * S));
+            slot = (slot + 1) % 3;
+            x = after_ff;
+        }
+        // Hyper head, final norm and LM head on the last row.
+        const last = x + (rows - 1) * S * H * 2;
+        try k.ihc.collapse(s, .{ .hidden = last, .projection = self.head_hc.project, .bias = self.head_hc.bias, .scale = self.head_hc.scale, .output = sc.head_hidden, .post = 0 }, self.hcShape(1, S));
+        try k.norms.addRmsTail(s, sc.head_hidden, null, self.final_norm, sc.norm_tmp, sc.head_norm, null, 1, H, eps, .{ .round = true });
+        try k.gemm.run(s, sc.head_norm, self.lm_head, sc.lm_logits, 1, self.text.vocab_size, H, .f32);
+        try s.synchronize();
+        try cuda.memory.download(self.d, sc.lm_logits, std.mem.sliceAsBytes(logits_out));
+    }
+};
diff --git a/zig/src/families/hy4_flash/cuda_projection.zig b/zig/src/families/hy4_flash/cuda_projection.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b7cdd940ff7aa797073e598941459b391bb4352e
--- /dev/null
+++ b/zig/src/families/hy4_flash/cuda_projection.zig
@@ -0,0 +1,130 @@
+//! Lossless device packing and row-stable CUDA projections for the two published affine widths.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+
+pub const max_rows = 16;
+
+pub const Owned = struct {
+    a: std.mem.Allocator,
+    driver: *const cuda.Driver,
+    buffers: std.ArrayList(cuda.DeviceBuffer) = .empty,
+
+    pub fn alloc(self: *Owned, bytes: usize) !u64 {
+        var b = try cuda.DeviceBuffer.alloc(self.driver, bytes);
+        errdefer b.free();
+        try self.buffers.append(self.a, b);
+        return b.ptr;
+    }
+
+    pub fn upload(self: *Owned, bytes: []const u8) !u64 {
+        var b = try cuda.DeviceBuffer.alloc(self.driver, bytes.len);
+        errdefer b.free();
+        try b.upload(0, bytes);
+        try self.buffers.append(self.a, b);
+        return b.ptr;
+    }
+
+    fn rollback(self: *Owned, start: usize) void {
+        for (self.buffers.items[start..]) |*b| b.free();
+        self.buffers.shrinkRetainingCapacity(start);
+    }
+
+    pub fn deinit(self: *Owned) void {
+        self.rollback(0);
+        self.buffers.deinit(self.a);
+    }
+};
+
+pub const Weight = union(enum) {
+    q4: cuda.qlinear.Affine4,
+    q8: cuda.qlinear.AffineN,
+
+    pub fn inputs(self: Weight) usize {
+        return switch (self) {
+            inline else => |w| w.k,
+        };
+    }
+};
+
+pub const Kernels = struct {
+    modules: [6]cuda.Module,
+    q4: cuda.qlinear.Affine4Kernels,
+    q8: cuda.qlinear.AffineNKernels,
+    act: cuda.act_rows.ActRows,
+
+    pub fn load(ctx: *const cuda.Context) !Kernels {
+        const k = cuda.kernels;
+        if (!k.available) return error.BuiltWithoutKernels;
+        var out: Kernels = undefined;
+        var count: usize = 0;
+        errdefer for (out.modules[0..count]) |*m| m.unload();
+        for (&out.modules, [_][]const u8{ k.qmm_group, k.qmm_prefill, k.lane_gemv, k.affine4_pack, k.affine8, k.affine_prefill }) |*slot, image| {
+            slot.* = try cuda.Module.load(ctx.d, image);
+            count += 1;
+        }
+        const sms = @as(usize, @intCast(try ctx.attribute(.multiprocessor_count)));
+        const gb10 = try ctx.capability() == 121;
+        const m = out.modules;
+        out.q4 = try cuda.qlinear.Affine4Kernels.resolve(ctx.d, m[0], m[1], m[2], m[3], sms, gb10);
+        errdefer out.q4.deinit();
+        out.q8 = try cuda.qlinear.AffineNKernels.resolve(ctx.d, m[4], m[5], m[3], sms, gb10);
+        errdefer out.q8.deinit();
+        out.act = try cuda.act_rows.ActRows.load(ctx.d);
+        return out;
+    }
+
+    pub fn deinit(self: *Kernels) void {
+        self.act.unload();
+        self.q8.deinit();
+        self.q4.deinit();
+        for (&self.modules) |*m| m.unload();
+    }
+
+    /// Adapt the storage layout without requantizing the checkpoint.
+    pub fn pack(self: *const Kernels, owner: *Owned, s: cuda.Stream, host: core.quant.mlx.Host) !Weight {
+        if (host.group != 64 or (host.bits != 4 and host.bits != 8)) return error.BadHy4ProjectionWidth;
+        const dims = try core.quant.mlx.geometry.shape(host.words, host.scales, host.biases, host.bits, host.group, false);
+        const n = host.words.shape[0];
+        const k = host.scales.shape[1] * host.group;
+        if (dims.elements == 0 or n == 0 or k == 0) return error.BadHy4ProjectionWidth;
+        const start = owner.buffers.items.len;
+        errdefer owner.rollback(start);
+        var raw: Owned = .{ .a = owner.a, .driver = owner.driver };
+        defer raw.deinit();
+        const codes = try raw.upload(host.words.bytes);
+        const scales = try raw.upload(host.scales.bytes);
+        const zeros = try raw.upload(host.biases.bytes);
+        const size = cuda.qlinear.AffineN.layout(n, k, host.bits);
+        const w = try owner.alloc(size.words);
+        const scale = try owner.alloc(size.scales);
+        const bias = try owner.alloc(size.scales);
+        errdefer s.synchronize() catch {};
+        const packed_: Weight = switch (host.bits) {
+            4 => blk: {
+                const q: cuda.qlinear.Affine4 = .{ .w = w, .s = scale, .b = bias, .n = n, .k = k, .npad = size.npad };
+                try self.q4.pack(s, codes, scales, zeros, q);
+                break :blk .{ .q4 = q };
+            },
+            8 => blk: {
+                try self.q8.packWords(s, codes, 8, n, k, w);
+                try self.q8.packTable(s, scales, n, k, size.npad, scale);
+                try self.q8.packTable(s, zeros, n, k, size.npad, bias);
+                break :blk .{ .q8 = .{ .w = w, .s = scale, .b = bias, .n = n, .k = k, .npad = size.npad, .bits = 8 } };
+            },
+            else => unreachable,
+        };
+        try s.synchronize();
+        return packed_;
+    }
+
+    pub fn run(self: *const Kernels, s: cuda.Stream, w: Weight, input: u64, sums: u64, output: u64, rows: usize) !void {
+        if (rows == 0 or rows > max_rows or sums == 0) return error.BadHy4ProjectionRows;
+        const width = w.inputs();
+        try self.act.groupSums(s, input, width, sums, rows, width);
+        switch (w) {
+            .q4 => |q| try self.q4.decode(s, input, sums, q, output, rows),
+            .q8 => |q| try self.q8.decode(s, input, sums, q, output, rows),
+        }
+    }
+};
diff --git a/zig/src/families/hy4_flash/dfly2_inputs.zig b/zig/src/families/hy4_flash/dfly2_inputs.zig
new file mode 100644
index 0000000000000000000000000000000000000000..35fb148386a97979469b1e4a73128269da6a2d2c
--- /dev/null
+++ b/zig/src/families/hy4_flash/dfly2_inputs.zig
@@ -0,0 +1,56 @@
+const std = @import("std");
+
+pub const Frame = struct {
+    source_row: usize,
+    anchor: u32,
+    query_rows: u32,
+};
+
+/// The target row survives rejection; the first draft query uses the target's bonus token.
+pub fn prepare(positions: []const u32, rejected: usize, bonus: ?u32, context: u32, mask_token: u32, block_tokens: []u32, block_positions: []u32) !?Frame {
+    if (block_tokens.len != block_positions.len or block_tokens.len < 2) return error.BadDraftBlock;
+    const token = bonus orelse return null;
+    if (rejected >= positions.len) return error.BadRejectionCount;
+    const source_row = positions.len - rejected - 1;
+    const anchor = std.math.add(u32, positions[source_row], 1) catch return error.BadDraftBlock;
+    const rows = std.math.cast(u32, block_tokens.len) orelse return error.BadDraftBlock;
+    if (anchor > context or rows > context - anchor) return null;
+    @memset(block_tokens, mask_token);
+    block_tokens[0] = token;
+    for (block_positions, 0..) |*position, i| position.* = anchor + @as(u32, @intCast(i));
+    return .{ .source_row = source_row, .anchor = anchor, .query_rows = rows };
+}
+
+/// Use target sparse indices, then an optional local prefix and each query's causal draft prefix.
+pub fn reuseIndices(frame: Frame, target: []const i32, local_window: u32, query: u32, out: []i32) !void {
+    const total = std.math.add(usize, target.len, local_window) catch return error.BadDraftBlock;
+    const size = std.math.add(usize, total, frame.query_rows) catch return error.BadDraftBlock;
+    if (query >= frame.query_rows or out.len < size or
+        @as(u64, frame.anchor) + query > std.math.maxInt(i32)) return error.BadDraftBlock;
+    const window_start = @as(i64, frame.anchor) - local_window;
+    @memset(out, -1);
+    for (out[0..target.len], target) |*entry, position| {
+        if (position >= 0 and position < window_start) entry.* = position;
+    }
+    for (out[target.len..total], 0..) |*entry, i| {
+        entry.* = @intCast(@max(-1, window_start + @as(i64, @intCast(i))));
+    }
+    for (out[total .. total + query + 1], 0..) |*entry, i| entry.* = @intCast(frame.anchor + i);
+}
+
+test "rejected target rows do not advance the DFly2 anchor" {
+    var tokens: [6]u32 = undefined;
+    var positions: [6]u32 = undefined;
+    const frame = (try prepare(&.{ 10, 11, 12, 13 }, 1, 42, 20, 120009, &tokens, &positions)).?;
+    try std.testing.expectEqual(@as(usize, 2), frame.source_row);
+    try std.testing.expectEqualSlices(u32, &.{ 42, 120009, 120009, 120009, 120009, 120009 }, &tokens);
+    try std.testing.expectEqualSlices(u32, &.{ 13, 14, 15, 16, 17, 18 }, &positions);
+    try std.testing.expectEqual(@as(?Frame, null), try prepare(&.{ 10, 11, 12, 13 }, 1, 42, 18, 120009, &tokens, &positions));
+}
+
+test "the DFly2 draft row uses neither duplicate local keys nor future query keys" {
+    const frame: Frame = .{ .source_row = 2, .anchor = 13, .query_rows = 6 };
+    var out: [16]i32 = undefined;
+    try reuseIndices(frame, &.{ 0, 8, 10, 12, 13, -1 }, 3, 2, &out);
+    try std.testing.expectEqualSlices(i32, &.{ 0, 8, -1, -1, -1, -1, 10, 11, 12, 13, 14, 15, -1, -1, -1, -1 }, &out);
+}
diff --git a/zig/src/families/hy4_flash/engram.zig b/zig/src/families/hy4_flash/engram.zig
new file mode 100644
index 0000000000000000000000000000000000000000..25580878839f76fcb3207f7b40bc4badf2912ef1
--- /dev/null
+++ b/zig/src/families/hy4_flash/engram.zig
@@ -0,0 +1,82 @@
+//! Engram row selection for Tencent's released Hy4-flash vocabulary map.
+const std = @import("std");
+const config = @import("config.zig");
+const hashValues = @import("engram_hash_core").hashValues;
+
+pub const order = 3;
+pub const heads = 8;
+pub const columns = (order - 1) * heads;
+const lookup_sha = "87c7b2e1c2fc227ba7fdec4dd7a867533072eb2b73a85cc54189174ccfaf5f3f";
+
+pub const TokenMap = struct {
+    bytes: []const u8,
+    pad: u32,
+
+    pub fn open(bytes: []const u8, text: config.Text) !TokenMap {
+        if (bytes.len != @as(usize, text.engram_lookup_table_size) * 4 or
+            text.engram_pad_id >= text.engram_lookup_table_size) return error.BadEngramMap;
+        var digest: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(bytes, &digest, .{});
+        const hex = std.fmt.bytesToHex(digest, .lower);
+        if (!std.mem.eql(u8, &hex, lookup_sha)) return error.UnknownEngramVocabulary;
+        return .{ .bytes = bytes, .pad = text.engram_pad_id };
+    }
+
+    pub fn normalize(self: TokenMap, id: u32) u32 {
+        const slot = if (id < self.bytes.len / 4) id else self.pad;
+        return std.mem.readInt(u32, self.bytes[@as(usize, slot) * 4 ..][0..4], .little);
+    }
+};
+
+pub const Layer = struct {
+    multipliers: [order]u64,
+    primes: [columns]u32,
+    offsets: [columns]u32,
+
+    pub fn open(text: config.Text, number: u32) !Layer {
+        if (text.engram_seed != 0 or text.engram_max_ngram_size != order or text.engram_n_head_per_ngram != heads)
+            return error.UnsupportedEngramHash;
+        // The reference PCG64 draws use the checked vocabulary's maximum ID plus one, which is 92620.
+        const multipliers: [order]u64 = switch (number) {
+            2 => .{ 81853575799317, 39690085502883, 24229915018165 },
+            12 => .{ 19457948045719, 44729556510419, 84779352922315 },
+            22 => .{ 72974230057307, 21530602121221, 55998057243097 },
+            32 => .{ 29128509562787, 16745155128523, 22474588302733 },
+            else => return error.UnknownEngramLayer,
+        };
+        _ = try text.engramRows(number);
+        var key_storage: [10]u8 = undefined;
+        const key = try std.fmt.bufPrint(&key_storage, "{d}", .{number});
+        const groups = text.engram_layer_head_vocab_sizes.map.get(key) orelse return error.UnknownEngramLayer;
+        var result: Layer = .{ .multipliers = multipliers, .primes = undefined, .offsets = undefined };
+        var row: u32 = 0;
+        for (groups, 0..) |group, n| for (group, 0..) |prime, head| {
+            const col = n * heads + head;
+            result.primes[col] = prime;
+            result.offsets[col] = row;
+            row = try std.math.add(u32, row, prime);
+        };
+        return result;
+    }
+
+    pub fn hash(self: Layer, map: TokenMap, tokens: [order]u32) [columns]u32 {
+        var normalized: [order]u32 = undefined;
+        for (tokens, &normalized) |token, *value| value.* = map.normalize(token);
+        return self.hashNormalized(normalized);
+    }
+
+    pub fn hashNormalized(self: Layer, normalized: [order]u32) [columns]u32 {
+        var rows: [columns]u32 = undefined;
+        hashValues(&normalized, &self.multipliers, &self.primes, &self.offsets, heads, &rows);
+        return rows;
+    }
+};
+
+test "the native Engram hash returns the upstream rows for a released token window" {
+    const parsed = try config.parse(std.testing.allocator, @embedFile("config_fixture.json"));
+    defer parsed.deinit();
+    const layer = try Layer.open(parsed.value.text_config, 2);
+    const rows = layer.hashNormalized(.{ 1, 0, 91804 });
+    const expected = [_]u32{ 9395452, 11699939, 23502176, 32861672, 43851032, 53212976, 68274127, 73702352, 91770608, 93761842, 110295210, 116456011, 133373173, 137621161, 154112274, 155288835 };
+    try std.testing.expectEqualSlices(u32, &expected, &rows);
+}
diff --git a/zig/src/families/hy4_flash/engram_cuda.zig b/zig/src/families/hy4_flash/engram_cuda.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e104c1ee23f72e988655645897152d9a08730438
--- /dev/null
+++ b/zig/src/families/hy4_flash/engram_cuda.zig
@@ -0,0 +1,62 @@
+//! Hy4-flash's CUDA Engram branch: optional FP8 round trip, per-head norm, value and per-stream keys, gated add.
+const std = @import("std");
+const cuda = @import("cuda");
+const engram = @import("engram.zig");
+const ihc = @import("ihc.zig");
+
+pub const head_width = 96;
+pub const columns = engram.columns;
+pub const input = columns * head_width;
+
+pub const Weights = struct {
+    lookup_gamma: u64, // BF16 [16, 96]
+    value: u64, // BF16 [hidden, 1536]
+    value_bias: u64,
+    value_gain: u64, // unified_pre_gamma
+    key: [ihc.streams]u64, // BF16 [hidden, 1536] each
+    key_bias: u64, // BF16 [4, hidden]
+    key_gain: u64,
+    query_gain: u64,
+    delta_gain: u64, // unified_per_hc_scales
+};
+
+pub const Buffers = struct {
+    raw: u64, // BF16 [gemm_rows, 1536], gathered rows
+    normalized: u64, // BF16 [gemm_rows, 1536]
+    keys: u64, // BF16 [4, gemm_rows, hidden]
+    value: u64, // BF16 [gemm_rows, hidden]
+    media: u64, // u32 [gemm_rows]
+    state: u64, // BF16 [gemm_rows, 4, hidden]
+    output: u64, // BF16 [gemm_rows, 4, hidden]
+};
+
+pub const Kernels = struct {
+    module: cuda.Module,
+    lookup_fn: cuda.Function,
+    apply_fn: cuda.Function,
+
+    pub fn load(driver: *const cuda.Driver) !Kernels {
+        if (!cuda.kernels.available) return error.BuiltWithoutKernels;
+        var module = try cuda.Module.load(driver, cuda.kernels.hy4_engram);
+        errdefer module.unload();
+        return .{ .module = module, .lookup_fn = try module.function("tf_hy4_engram_lookup"), .apply_fn = try module.function("tf_hy4_engram_apply") };
+    }
+
+    pub fn deinit(self: *Kernels) void {
+        self.module.unload();
+        self.* = undefined;
+    }
+
+    /// The Engram residual added to `rows` rows of four hidden streams. GEMMs run on the fixed `gemm_rows`.
+    pub fn forward(self: Kernels, s: cuda.Stream, gemm: *cuda.vit.Gemms, w: Weights, b: Buffers, rows: u32, gemm_rows: u32, hidden: u32, fp8: bool) !void {
+        if (rows == 0 or rows > gemm_rows) return error.BadHy4EngramRows;
+        var lookup: cuda.Args = .{};
+        inline for (.{ b.raw, w.lookup_gamma, b.normalized, @as(u32, @intFromBool(fp8)) }) |x| lookup.add(x);
+        try cuda.launch.launch(self.lookup_fn, .{ .grid = .{ .x = columns, .y = gemm_rows }, .block = .{ .x = 32 } }, s, &lookup);
+        try gemm.run(s, b.normalized, w.value, b.value, gemm_rows, hidden, input, .bf16);
+        for (w.key, 0..) |key, i| try gemm.run(s, b.normalized, key, b.keys + i * @as(u64, gemm_rows) * hidden * 2, gemm_rows, hidden, input, .bf16);
+        var apply: cuda.Args = .{};
+        inline for (.{ b.state, b.keys, w.key_bias, w.key_gain, w.query_gain, w.delta_gain, b.value, w.value_bias, w.value_gain, b.media, b.output, gemm_rows, hidden }) |x| apply.add(x);
+        try cuda.launch.launch(self.apply_fn, .{ .grid = .{ .x = ihc.streams, .y = rows }, .block = .{ .x = 128 } }, s, &apply);
+    }
+};
diff --git a/zig/src/families/hy4_flash/engram_rows.zig b/zig/src/families/hy4_flash/engram_rows.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1aa9bf0f31e7fbece921884da4516329050ad1c7
--- /dev/null
+++ b/zig/src/families/hy4_flash/engram_rows.zig
@@ -0,0 +1,93 @@
+//! Gather Hy4-flash's selected affine Engram rows from the mapped checkpoint.
+const std = @import("std");
+const core = @import("core");
+const engram = @import("engram.zig");
+const loader = @import("loader.zig");
+
+const group = 32;
+
+/// Borrows the loader's checkpoint mapping. The large embedding table can stay in file-backed memory.
+fn willNeed(t: core.checkpoint_host.Tensor, spans: []const core.quant.Span) void {
+    const os = @import("builtin").os.tag;
+    if (os != .macos and os != .linux) return;
+    if (t.shape[0] == 0 or t.bytes.len == 0) return;
+    const row = t.bytes.len / t.shape[0];
+    const page = std.heap.pageSize();
+    for (spans) |span| {
+        const lo = std.mem.alignBackward(usize, @intFromPtr(t.bytes.ptr) + span.from * row, page);
+        const hi = std.mem.alignForward(usize, @intFromPtr(t.bytes.ptr) + span.to * row, page);
+        _ = std.c.madvise(@ptrFromInt(lo), hi - lo, std.c.MADV.WILLNEED);
+    }
+}
+
+pub const Table = struct {
+    map: engram.TokenMap,
+    hash: engram.Layer,
+    affine: core.quant.mlx.Host,
+    width: usize,
+
+    pub fn open(model: *loader.Loaded, layer_number: u32) !Table {
+        const text = model.config.value.text_config;
+        if (std.mem.indexOfScalar(u32, text.engram_layer_ids, layer_number) == null) return error.UnknownEngramLayer;
+        const hash = try engram.Layer.open(text, layer_number);
+        const rows = try text.engramRows(layer_number);
+        const width = text.engram_n_embed_per_ngram / engram.heads;
+        if (width == 0 or width % group != 0) return error.BadEngramGeometry;
+
+        var buffer: [160]u8 = undefined;
+        var name = try std.fmt.bufPrint(&buffer, "model.layers.{d}.engram_layer.lookup_table", .{layer_number - 1});
+        const map = try engram.TokenMap.open((try model.checkpoint.expect(name, .i32, &.{text.engram_lookup_table_size})).bytes, text);
+        const prefix = "model.layers.{d}.engram_layer.multi_head_embedding.embedding";
+        name = try std.fmt.bufPrint(&buffer, prefix ++ ".weight", .{layer_number - 1});
+        const words = try model.checkpoint.expect(name, .u32, &.{ rows, @as(usize, width) * model.bits / 32 });
+        try model.checkpoint.adviseRandom(name);
+        name = try std.fmt.bufPrint(&buffer, prefix ++ ".scales", .{layer_number - 1});
+        const scales = try model.checkpoint.expect(name, .bf16, &.{ rows, width / group });
+        try model.checkpoint.adviseRandom(name);
+        name = try std.fmt.bufPrint(&buffer, prefix ++ ".biases", .{layer_number - 1});
+        const biases = try model.checkpoint.expect(name, .bf16, &.{ rows, width / group });
+        try model.checkpoint.adviseRandom(name);
+        return .{
+            .map = map,
+            .hash = hash,
+            .affine = .{ .words = words, .scales = scales, .biases = biases, .bits = model.bits, .group = group },
+            .width = width,
+        };
+    }
+
+    /// The table rows a token window reads, one a column (the gather's spans).
+    pub fn windowRows(self: Table, window: [engram.order]u32) [engram.columns]u32 {
+        return self.hash.hash(self.map, window);
+    }
+
+    pub fn elementsPerToken(self: Table) usize {
+        return engram.columns * self.width;
+    }
+
+    /// Each window is current token first, then older tokens, padded by the caller for a new stream.
+    pub fn gather(self: Table, a: std.mem.Allocator, windows: []const [engram.order]u32, output: []u16) !void {
+        const cells = try std.math.mul(usize, windows.len, self.elementsPerToken());
+        if (output.len != cells) return error.BadEngramOutput;
+        if (windows.len == 0) return;
+        const spans = try a.alloc(core.quant.Span, windows.len * engram.columns);
+        defer a.free(spans);
+        for (windows, 0..) |window, token| {
+            for (self.hash.hash(self.map, window), 0..) |row, head| {
+                const index: usize = row;
+                spans[token * engram.columns + head] = .{ .from = index, .to = index + 1 };
+            }
+        }
+
+        // Ask for every row's pages at once (asynchronous read-ahead)
+        for ([_]core.checkpoint_host.Tensor{ self.affine.words, self.affine.scales, self.affine.biases }) |t| willNeed(t, spans);
+        const words = try core.quant.slice.takeRows(a, self.affine.words, spans);
+        defer a.free(words.bytes);
+        const scales = try core.quant.slice.takeRows(a, self.affine.scales, spans);
+        defer a.free(scales.bytes);
+        const biases = try core.quant.slice.takeRows(a, self.affine.biases, spans);
+        defer a.free(biases.bytes);
+        const values = try core.quant.mlx.dequant(a, words, scales, biases, group);
+        defer a.free(values);
+        for (output, values) |*word, v| word.* = core.quant.convert.bf16(v);
+    }
+};
diff --git a/zig/src/families/hy4_flash/exl3_weights.zig b/zig/src/families/hy4_flash/exl3_weights.zig
new file mode 100644
index 0000000000000000000000000000000000000000..44ee8032ff68a38936b575e4bf11a900c9fddc64
--- /dev/null
+++ b/zig/src/families/hy4_flash/exl3_weights.zig
@@ -0,0 +1,82 @@
+//! Split routed experts from the standard Hy4-flash EXL3 checkpoint.
+const std = @import("std");
+const core = @import("core");
+const Tensor = core.safetensors.Tensor;
+
+pub const Projection = struct {
+    parts: core.exl3_load.Parts,
+    geometry: core.exl3_layout.Group,
+};
+
+pub const Expert = struct { gate: Projection, up: Projection, down: Projection };
+
+pub fn readExpert(source: anytype, layer: usize, expert: usize, latent: usize, intermediate: usize) !Expert {
+    return .{
+        .gate = try read(source, layer, expert, "gate", latent, intermediate),
+        .up = try read(source, layer, expert, "up", latent, intermediate),
+        .down = try read(source, layer, expert, "down", intermediate, latent),
+    };
+}
+
+fn read(source: anytype, layer: usize, expert: usize, name: []const u8, k: usize, n: usize) !Projection {
+    var buf: [160]u8 = undefined;
+    const prefix = try std.fmt.bufPrint(&buf, "model.layers.{d}.mlp.experts.{d}.{s}_proj", .{ layer, expert, name });
+    for ([_][]const u8{ "mcg", "bias", "weight", "su", "sv" }) |suffix| {
+        var full: [192]u8 = undefined;
+        if (source.has(try std.fmt.bufPrint(&full, "{s}.{s}", .{ prefix, suffix })))
+            return error.UnsupportedHy4Expert;
+    }
+    return validate(
+        try tensor(source, prefix, "trellis"),
+        try tensor(source, prefix, "suh"),
+        try tensor(source, prefix, "svh"),
+        try tensor(source, prefix, "mul1"),
+        k,
+        n,
+    );
+}
+
+fn tensor(source: anytype, prefix: []const u8, suffix: []const u8) !Tensor {
+    var buf: [192]u8 = undefined;
+    return source.get(try std.fmt.bufPrint(&buf, "{s}.{s}", .{ prefix, suffix }));
+}
+
+fn validate(trellis: Tensor, suh: Tensor, svh: Tensor, marker: Tensor, k: usize, n: usize) !Projection {
+    if (trellis.dtype != .i16 or trellis.rank != 3 or k % 128 != 0 or n % 128 != 0)
+        return error.BadHy4Trellis;
+    const g = try core.exl3_layout.Group.fromShape(trellis.shape[0..trellis.rank]);
+    if (g.k() != k or g.n() != n or trellis.bytes.len != g.trellisBytes())
+        return error.BadHy4Trellis;
+    if (!suh.is(.f16, &.{k}) or !svh.is(.f16, &.{n}) or suh.bytes.len != 2 * k or svh.bytes.len != 2 * n)
+        return error.BadHy4ExpertScales;
+    if ((!marker.is(.i32, &.{}) and !marker.is(.i32, &.{1})) or marker.bytes.len != 4)
+        return error.BadHy4ExpertMarker;
+    if (try core.exl3_layout.fromMarker(std.mem.readInt(u32, marker.bytes[0..4], .little)) != .mul1)
+        return error.BadHy4ExpertMarker;
+    return .{ .parts = .{ .trellis = trellis, .suh = suh, .svh = svh }, .geometry = g };
+}
+
+fn fixed(dtype: core.safetensors.DType, shape: []const usize, bytes: []const u8) Tensor {
+    var out: Tensor = .{ .dtype = dtype, .rank = @intCast(shape.len), .shape = @splat(1), .bytes = bytes };
+    @memcpy(out.shape[0..shape.len], shape);
+    return out;
+}
+
+test "Hy4 orders EXL3 axes as input then output and requires fp16 scales and mul1" {
+    const t = std.testing;
+    const words: [8 * 16 * 64 * 2]u8 = @splat(0);
+    const input: [128 * 2]u8 = @splat(0);
+    const output: [256 * 2]u8 = @splat(0);
+    const magic = &.{ 0x2d, 0xd1, 0xdc, 0x83 };
+    const trellis = fixed(.i16, &.{ 8, 16, 64 }, &words);
+    const suh = fixed(.f16, &.{128}, &input);
+    const svh = fixed(.f16, &.{256}, &output);
+    const marker = fixed(.i32, &.{1}, magic);
+    const p = try validate(trellis, suh, svh, marker, 128, 256);
+    try t.expectEqual(@as(u32, 8), p.geometry.k2());
+    _ = try validate(trellis, suh, svh, fixed(.i32, &.{}, magic), 128, 256);
+    try t.expectError(error.BadHy4Trellis, validate(trellis, suh, svh, marker, 256, 128));
+    try t.expectError(error.BadHy4ExpertScales, validate(trellis, suh, suh, marker, 128, 256));
+    try t.expectError(error.BadHy4ExpertMarker, validate(trellis, suh, svh, fixed(.u32, &.{1}, magic), 128, 256));
+    try t.expectError(error.BadHy4ExpertMarker, validate(trellis, suh, svh, fixed(.i32, &.{}, &.{ 0xed, 0x1f, 0xac, 0xcb }), 128, 256));
+}
diff --git a/zig/src/families/hy4_flash/forward.zig b/zig/src/families/hy4_flash/forward.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6163ad360dd16b5ccf5b2c8360e716c9101e27eb
--- /dev/null
+++ b/zig/src/families/hy4_flash/forward.zig
@@ -0,0 +1,136 @@
+//! Pack lane requests into the buffers used by the native target and DFly2 graph.
+const std = @import("std");
+const slots = @import("attention_slots.zig");
+const groups = @import("index_groups.zig");
+
+pub const Query = struct {
+    token: u32,
+    coordinates: [3]i32,
+    media: bool = false,
+};
+
+pub const Lane = struct {
+    /// Reused or freshly prefetched prefix. Speculative rows are supplied separately.
+    prefix: []const u32,
+    queries: []const Query,
+    cache: slots.Cache,
+};
+
+pub const Rows = struct {
+    ids: []u32,
+    coordinates: [][3]i32,
+    windows: [][3]u32,
+    media: []u32,
+    writes: []u32,
+
+    /// Metadata is identical for a lane in a solo batch or one that shares the forward.
+    pub fn stage(self: Rows, lanes: []const Lane, pad: u32) !usize {
+        var row: usize = 0;
+        for (lanes) |lane| {
+            for (lane.queries, 0..) |q, i| {
+                if (row >= self.ids.len or row >= self.coordinates.len or row >= self.windows.len or
+                    row >= self.media.len or row >= self.writes.len) return error.ShortHy4ForwardRows;
+                const position = try std.math.add(usize, lane.prefix.len, i);
+                const pos = std.math.cast(u32, position) orelse return error.Hy4PositionTooLarge;
+                self.ids[row] = q.token;
+                self.coordinates[row] = q.coordinates;
+                self.windows[row][0] = q.token;
+                for (1..3) |lag| {
+                    self.windows[row][lag] = if (lag <= i)
+                        lane.queries[i - lag].token
+                    else if (lag <= position)
+                        lane.prefix[position - lag]
+                    else
+                        pad;
+                }
+                self.media[row] = @intFromBool(q.media);
+                self.writes[row] = try lane.cache.slot(pos);
+                row += 1;
+            }
+        }
+        return row;
+    }
+};
+
+pub const Attention = union(enum) {
+    sliding: u32,
+    sparse: struct {
+        group_budget: u32,
+        /// Selected logical token indices for rows beyond the all-keys frontier.
+        retained: []const []const i32 = &.{},
+    },
+};
+
+pub const Keys = struct {
+    slots: []u32,
+    counts: []u32,
+    stride: u32,
+
+    pub fn stage(self: Keys, lanes: []const Lane, mode: Attention) !usize {
+        if (self.stride == 0) return error.ShortHy4KeyList;
+        var row: usize = 0;
+        for (lanes) |lane| {
+            for (0..lane.queries.len) |i| {
+                if (row >= self.counts.len or row >= self.slots.len / self.stride) return error.ShortHy4KeyList;
+                const buffer = self.slots[row * self.stride ..][0..self.stride];
+                const pos = try std.math.add(usize, lane.prefix.len, i);
+                const end = std.math.cast(u32, try std.math.add(usize, pos, 1)) orelse return error.Hy4PositionTooLarge;
+                self.counts[row] = switch (mode) {
+                    .sliding => |window| try lane.cache.sliding(end, window, buffer),
+                    .sparse => |s| blk: {
+                        const f = try groups.frontier(pos, s.group_budget);
+                        if (f.groups_to_recall == f.indexed_groups) break :blk try lane.cache.sliding(end, end, buffer);
+                        if (row >= s.retained.len) return error.Hy4IndexRowsRequired;
+                        const n = try lane.cache.retained(end, s.retained[row], buffer);
+                        const expected = f.groups_to_recall * groups.slots + f.visible_end - f.current_group_start;
+                        if (n != expected) return error.BadHy4RetainedCount;
+                        break :blk n;
+                    },
+                };
+                row += 1;
+            }
+        }
+        return row;
+    }
+};
+
+test "sharing a target pass preserves tokenizer history and physical cache isolation" {
+    const t = std.testing;
+    const one: Lane = .{
+        .prefix = &.{ 7, 8, 9 },
+        .queries = &.{
+            .{ .token = 20, .coordinates = .{ 3, 7, 10 }, .media = true },
+            .{ .token = 21, .coordinates = .{ 4, 4, 4 } },
+        },
+        .cache = .{ .page_bases = &.{ 16, 32 }, .page_tokens = 4, .capacity = 64 },
+    };
+    const two: Lane = .{
+        .prefix = &.{11},
+        .queries = &.{.{ .token = 22, .coordinates = .{ 1, 1, 1 } }},
+        .cache = .{ .page_bases = &.{48}, .page_tokens = 4, .capacity = 64 },
+    };
+    var ids: [3]u32 = undefined;
+    var coords: [3][3]i32 = undefined;
+    var windows: [3][3]u32 = undefined;
+    var media: [3]u32 = undefined;
+    var writes: [3]u32 = undefined;
+    const rows: Rows = .{ .ids = &ids, .coordinates = &coords, .windows = &windows, .media = &media, .writes = &writes };
+    try t.expectEqual(@as(usize, 3), try rows.stage(&.{ two, one }, 2));
+    try t.expectEqualSlices(u32, &.{ 22, 20, 21 }, &ids);
+    try t.expectEqualSlices(u32, &.{ 49, 19, 32 }, &writes);
+    try t.expectEqualSlices(u32, &.{ 21, 20, 9 }, &windows[2]);
+    try t.expectEqualSlices(u32, &.{ 0, 1, 0 }, &media);
+    try t.expectEqualSlices(i32, &.{ 3, 7, 10 }, &coords[1]);
+
+    var keys: [3 * 4]u32 = undefined;
+    var counts: [3]u32 = undefined;
+    const k: Keys = .{ .slots = &keys, .counts = &counts, .stride = 4 };
+    try t.expectEqual(@as(usize, 3), try k.stage(&.{ two, one }, .{ .sliding = 4 }));
+    try t.expectEqualSlices(u32, &.{ 17, 18, 19, 32 }, keys[8..]);
+    try t.expectEqualSlices(u32, &.{ 2, 4, 4 }, &counts);
+
+    try t.expectEqual(@as(usize, 2), try rows.stage(&.{one}, 2));
+    try t.expectEqualSlices(u32, &.{ 21, 20, 9 }, &windows[1]);
+    try t.expectEqualSlices(u32, &.{ 19, 32 }, writes[0..2]);
+    try t.expectError(error.Hy4IndexRowsRequired, k.stage(&.{one}, .{ .sparse = .{ .group_budget = 1 } }));
+}
diff --git a/zig/src/families/hy4_flash/host_tests.zig b/zig/src/families/hy4_flash/host_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..996eec1919c63014ef61e6f483299148f982af17
--- /dev/null
+++ b/zig/src/families/hy4_flash/host_tests.zig
@@ -0,0 +1,58 @@
+const std = @import("std");
+const core = @import("core");
+const engram = @import("engram.zig");
+const engram_rows = @import("engram_rows.zig");
+
+test {
+    _ = @import("config.zig");
+    _ = @import("attention_slots.zig");
+    _ = @import("mla_attention.zig");
+    _ = @import("index_groups.zig");
+    _ = @import("rope.zig");
+    _ = @import("rank_weights.zig");
+    _ = @import("index_recall.zig");
+    _ = @import("forward.zig");
+    _ = @import("exl3_weights.zig");
+    if (@import("builtin").os.tag == .linux) _ = @import("bf16_rows_test.zig");
+}
+
+fn tensor(dtype: core.checkpoint_host.DType, rows: usize, width: usize, bytes: []const u8) core.checkpoint_host.Tensor {
+    var result: core.checkpoint_host.Tensor = .{ .dtype = dtype, .rank = 2, .shape = @splat(0), .bytes = bytes };
+    result.shape[0..2].* = .{ rows, width };
+    return result;
+}
+
+test "Engram gathers the selected affine rows in token and head order" {
+    const n = engram.columns * 2;
+    var words: [n][4]u32 = undefined;
+    var offsets: [engram.columns]u32 = undefined;
+    for (&words, 0..) |*row, i| row.* = @splat(if (i % 2 == 0) 0x11111111 else 0xeeeeeeee);
+    for (&offsets, 0..) |*offset, i| offset.* = @intCast(i * 2);
+    const scales: [n]u16 = @splat(0x3f80); // BF16 1.0
+    const biases: [n]u16 = @splat(0xbf80); // BF16 -1.0
+    const lookup = [2]u32{ 0, 1 };
+    const table: engram_rows.Table = .{
+        .map = .{ .bytes = std.mem.asBytes(&lookup), .pad = 0 },
+        .hash = .{ .multipliers = .{ 3, 5, 7 }, .primes = @splat(2), .offsets = offsets },
+        .affine = .{
+            .words = tensor(.u32, n, 4, std.mem.asBytes(&words)),
+            .scales = tensor(.bf16, n, 1, std.mem.asBytes(&scales)),
+            .biases = tensor(.bf16, n, 1, std.mem.asBytes(&biases)),
+            .bits = 4,
+            .group = 32,
+        },
+        .width = 32,
+    };
+    const a = std.testing.allocator;
+    const window0 = [3]u32{ 1, 0, 1 };
+    const window1 = [3]u32{ 0xffffffff, 0, 1 };
+    var out: [2 * engram.columns * 32]u16 = undefined;
+    try table.gather(a, &.{ window0, window1 }, &out);
+    for (out, 0..) |word, i| {
+        const head = (i / 32) % engram.columns;
+        const from_first = i / 32 < engram.columns;
+        const on = from_first == (head < engram.heads);
+        try std.testing.expectEqual(@as(u16, if (on) 0x4150 else 0), word); // BF16 13.0 or 0.0
+    }
+    try std.testing.expectError(error.BadEngramOutput, table.gather(a, &.{window0}, out[1..]));
+}
diff --git a/zig/src/families/hy4_flash/ihc.zig b/zig/src/families/hy4_flash/ihc.zig
new file mode 100644
index 0000000000000000000000000000000000000000..70e66a8dc2b73ad527a3e7c3c6cbd808a294a99f
--- /dev/null
+++ b/zig/src/families/hy4_flash/ihc.zig
@@ -0,0 +1,63 @@
+//! FP32 weights and parameters for Hy4-flash's independent hyper-connections.
+const std = @import("std");
+const core = @import("core");
+const loader = @import("loader.zig");
+
+pub const streams = 4;
+pub const Which = union(enum) { attention: u32, feed_forward: u32, head };
+
+pub const Shape = extern struct {
+    rows: u32,
+    width: u32,
+    gates: u32,
+    eps: f32,
+    gate_eps: f32,
+    post_magnitude: f32,
+
+    pub fn check(self: Shape) !void {
+        if (self.rows == 0 or self.rows > std.math.maxInt(u16) or self.width == 0 or self.width > 8192 or
+            (self.gates != streams and self.gates != 2 * streams) or !std.math.isFinite(self.eps) or self.eps <= 0 or
+            !std.math.isFinite(self.gate_eps) or self.gate_eps < 0 or
+            !std.math.isFinite(self.post_magnitude) or self.post_magnitude < 0) return error.BadHy4IhcShape;
+    }
+};
+
+pub const Weights = struct {
+    project: core.checkpoint_host.Tensor,
+    bias: core.checkpoint_host.Tensor,
+    scale: core.checkpoint_host.Tensor,
+    shape: Shape,
+
+    pub fn read(model: *loader.Loaded, which: Which, rows: u32) !Weights {
+        const config = model.config.value.text_config;
+        if (config.hc_mult != streams) return error.BadHy4IhcShape;
+        var prefix: [120]u8 = undefined;
+        const base = switch (which) {
+            .attention => |layer| try blockPrefix(model, &prefix, layer, "hc_attn_layer"),
+            .feed_forward => |layer| try blockPrefix(model, &prefix, layer, "hc_mlp_layer"),
+            .head => "model.hc_head.hc_head_",
+        };
+        const gates: u32 = if (which == .head) streams else 2 * streams;
+        const shape: Shape = .{
+            .rows = rows,
+            .width = config.hidden_size,
+            .gates = gates,
+            .eps = config.rms_norm_eps,
+            .gate_eps = config.hc_eps,
+            .post_magnitude = config.hc_magnitude,
+        };
+        try shape.check();
+        var name: [128]u8 = undefined;
+        return .{
+            .project = try model.checkpoint.expect(try std.fmt.bufPrint(&name, "{s}fn", .{base}), .f32, &.{ gates, streams * shape.width }),
+            .bias = try model.checkpoint.expect(try std.fmt.bufPrint(&name, "{s}base", .{base}), .f32, &.{gates}),
+            .scale = try model.checkpoint.expect(try std.fmt.bufPrint(&name, "{s}scale", .{base}), .f32, &.{gates / streams}),
+            .shape = shape,
+        };
+    }
+};
+
+fn blockPrefix(model: *const loader.Loaded, buffer: []u8, layer: u32, name: []const u8) ![]const u8 {
+    if (layer >= model.config.value.text_config.num_hidden_layers) return error.BadHy4IhcLayer;
+    return std.fmt.bufPrint(buffer, "model.layers.{d}.{s}.hc_pre.hc_", .{ layer, name });
+}
diff --git a/zig/src/families/hy4_flash/ihc_cuda.zig b/zig/src/families/hy4_flash/ihc_cuda.zig
new file mode 100644
index 0000000000000000000000000000000000000000..67d65428a0a7646916ad9cfc3554e73b24fc8ab1
--- /dev/null
+++ b/zig/src/families/hy4_flash/ihc_cuda.zig
@@ -0,0 +1,43 @@
+//! Native CUDA launches for Hy4-flash's independent hyper-connections.
+const cuda = @import("cuda");
+const ihc = @import("ihc.zig");
+
+pub const Collapse = struct { hidden: u64, projection: u64, bias: u64, scale: u64, output: u64, post: u64 = 0 };
+pub const Add = struct { residual: u64, branch: u64, post: u64, output: u64 };
+pub const Kernels = struct {
+    image: cuda.Module,
+    pre: cuda.Function,
+    mix: cuda.Function,
+
+    pub fn load(driver: *const cuda.Driver) !Kernels {
+        if (!cuda.kernels.available) return error.BuiltWithoutKernels;
+        var image = try cuda.Module.load(driver, cuda.kernels.hy4_ihc);
+        errdefer image.unload();
+        return .{ .image = image, .pre = try image.function("tf_hy4_ihc_collapse"), .mix = try image.function("tf_hy4_ihc_add") };
+    }
+
+    pub fn deinit(self: *Kernels) void {
+        self.image.unload();
+        self.* = undefined;
+    }
+
+    pub fn collapse(self: Kernels, s: cuda.Stream, b: Collapse, shape: ihc.Shape) !void {
+        try shape.check();
+        if (shape.gates != ihc.streams and b.post == 0) return error.MissingHy4PostGates;
+        var args: cuda.Args = .{};
+        inline for (.{ b.hidden, b.projection, b.bias, b.scale, b.output, b.post, shape }) |x| args.add(x);
+        try cuda.launch.launch(self.pre, .{ .grid = .{ .x = shape.rows }, .block = .{ .x = 256 } }, s, &args);
+    }
+
+    pub fn add(self: Kernels, s: cuda.Stream, b: Add, shape: ihc.Shape) !void {
+        try shape.check();
+        if (shape.gates != 2 * ihc.streams or b.post == 0) return error.MissingHy4PostGates;
+        var args: cuda.Args = .{};
+        inline for (.{ b.residual, b.branch, b.post, b.output, shape }) |x| args.add(x);
+        const cols = (ihc.streams * shape.width + 255) / 256;
+        try cuda.launch.launch(self.mix, .{
+            .grid = .{ .x = cols, .y = shape.rows },
+            .block = .{ .x = 256 },
+        }, s, &args);
+    }
+};
diff --git a/zig/src/families/hy4_flash/ihc_metal.zig b/zig/src/families/hy4_flash/ihc_metal.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f9c6a2e3fd7fe9a2207c590f2ddd8f081a5175c8
--- /dev/null
+++ b/zig/src/families/hy4_flash/ihc_metal.zig
@@ -0,0 +1,156 @@
+//! Native Metal launches for Hy4-flash's independent hyper-connections.
+const mtl = @import("metal");
+const sources = @import("kernel_sources");
+const ihc = @import("ihc.zig");
+
+pub const Ref = struct { buffer: mtl.Buffer, offset: usize = 0 };
+/// `partials` (72 floats a row) selects the two-launch collapse that spreads a row over eight threadgroups.
+pub const Collapse = struct { hidden: Ref, projection: Ref, bias: Ref, scale: Ref, output: Ref, post: ?Ref = null, partials: ?Ref = null };
+/// The seam partials a row: 19 sums (8 gate logits, the sum of squares, 10 stream products) x 16 slots.
+pub const partial_floats = 19 * 16;
+pub const Add = struct { residual: Ref, branch: Ref, post: Ref, output: Ref };
+pub const Kernels = struct {
+    /// Gate counts fixed at compile time (head: 4, blocks: 8); bit-equal to the generic tf_hy4_ihc_collapse.
+    pre4: mtl.Pipeline,
+    pre8: mtl.Pipeline,
+    /// The same collapse split in two: eight one-simdgroup threadgroups a row, then the gates and the row.
+    part: [2]mtl.Pipeline,
+    finish: [2]mtl.Pipeline,
+    /// Sub-block seams: tail (output norm, residual mix, next collapse's partials), head (gates, row, input norm).
+    tail: [2]mtl.Pipeline,
+    head: [2]mtl.Pipeline,
+    /// tail and the next head in one launch with an in-kernel barrier across a row's 12 threadgroups (decode).
+    seam: [2]mtl.Pipeline,
+    mix: mtl.Pipeline,
+
+    pub fn load(device: mtl.Device) !Kernels {
+        const library = try mtl.Library.fromSource(device, sources.hy4_flash_ihc, mtl.CompileOptions.mlx());
+        defer library.deinit();
+        var pre4 = try mtl.Pipeline.init(device, library, "tf_hy4_ihc_collapse_g4", false);
+        errdefer pre4.deinit();
+        var pre8 = try mtl.Pipeline.init(device, library, "tf_hy4_ihc_collapse_g8", false);
+        errdefer pre8.deinit();
+        var sets: [5][2]mtl.Pipeline = undefined;
+        var made: usize = 0;
+        errdefer for (0..made) |m| sets[m / 2][m % 2].deinit();
+        inline for (.{ "tf_hy4_ihc_partials_g", "tf_hy4_ihc_finish_g", "tf_hy4_tail_g", "tf_hy4_head_g", "tf_hy4_seam_g" }, 0..) |name, si| {
+            inline for (.{ "4", "8" }, 0..) |g, i| {
+                sets[si][i] = try mtl.Pipeline.init(device, library, name ++ g, false);
+                made += 1;
+            }
+        }
+        return .{ .pre4 = pre4, .pre8 = pre8, .part = sets[0], .finish = sets[1], .tail = sets[2], .head = sets[3], .seam = sets[4], .mix = try mtl.Pipeline.init(device, library, "tf_hy4_ihc_add", false) };
+    }
+
+    pub fn deinit(self: *Kernels) void {
+        self.pre4.deinit();
+        self.pre8.deinit();
+        for (self.part) |p| p.deinit();
+        for (self.finish) |p| p.deinit();
+        for (self.tail) |p| p.deinit();
+        for (self.head) |p| p.deinit();
+        for (self.seam) |p| p.deinit();
+        self.mix.deinit();
+        self.* = undefined;
+    }
+
+    pub fn collapse(self: Kernels, e: mtl.ComputeEncoder, b: Collapse, shape: ihc.Shape) !void {
+        try shape.check();
+        if (shape.gates != ihc.streams and b.post == null) return error.MissingHy4PostGates;
+        const which: usize = @intFromBool(shape.gates != ihc.streams);
+        if (b.partials) |part| {
+            e.setPipeline(self.part[which]);
+            for ([_]Ref{ b.hidden, b.projection, part }, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+            e.setValue(shape, 3);
+            e.dispatchGroups(mtl.Size.of(8, shape.rows, 1), mtl.Size.of(32, 1, 1));
+            e.barrier();
+            e.setPipeline(self.finish[which]);
+            const args = [_]Ref{ b.hidden, part, b.bias, b.scale, b.output, b.post orelse b.hidden };
+            for (args, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+            e.setValue(shape, args.len);
+            e.dispatchGroups(mtl.Size.of((shape.width + 255) / 256, shape.rows, 1), mtl.Size.of(256, 1, 1));
+            return;
+        }
+        e.setPipeline(if (shape.gates == ihc.streams) self.pre4 else self.pre8);
+        const args = [_]Ref{ b.hidden, b.projection, b.bias, b.scale, b.output, b.post orelse b.hidden };
+        for (args, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+        e.setValue(shape, args.len);
+        e.dispatchGroups(mtl.Size.of(shape.rows, 1, 1), mtl.Size.of(256, 1, 1));
+    }
+
+    /// The collapse's partial sums only (the first of its two launches).
+    pub fn partials(self: Kernels, e: mtl.ComputeEncoder, hidden: Ref, projection: Ref, part: Ref, shape: ihc.Shape) !void {
+        try shape.check();
+        e.setPipeline(self.part[@intFromBool(shape.gates != ihc.streams)]);
+        for ([_]Ref{ hidden, projection, part }, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+        e.setValue(shape, 3);
+        e.dispatchGroups(mtl.Size.of(8, shape.rows, 1), mtl.Size.of(32, 1, 1));
+    }
+
+    pub const Head = struct { hidden: Ref, partials: Ref, bias: Ref, scale: Ref, gain: Ref, collapsed: Ref, normalized: Ref, post: Ref };
+
+    /// The collapse's gates and row from its partials, then the input RMS norm: one threadgroup a row.
+    pub fn headPass(self: Kernels, e: mtl.ComputeEncoder, b: Head, shape: ihc.Shape, norm_eps: f32) !void {
+        try shape.check();
+        e.setPipeline(self.head[@intFromBool(shape.gates != ihc.streams)]);
+        for ([_]Ref{ b.hidden, b.partials, b.bias, b.scale, b.gain, b.collapsed, b.normalized, b.post }, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+        e.setValue(shape, 8);
+        e.setValue(norm_eps, 9);
+        if (shape.width > 12 * 256) return error.BadHy4SeamWidth;
+        e.dispatchGroups(mtl.Size.of(12, shape.rows, 1), mtl.Size.of(256, 1, 1));
+    }
+
+    pub const TailShape = extern struct { rows: u32, width: u32, two: u32, partials: u32, eps: f32, mode: u32 };
+    pub const Tail = struct { branch: Ref, branch2: ?Ref = null, gain: Ref, residual: Ref, post: Ref, output: Ref, next: ?Ref = null, partials: Ref };
+
+    /// A sub-block's branch (or two, added) through its output norm, mixed into the streams;
+    pub fn tailPass(self: Kernels, e: mtl.ComputeEncoder, b: Tail, rows: u32, width: u32, eps: f32, gates: u32) void {
+        e.setPipeline(self.tail[@intFromBool(gates != ihc.streams)]);
+        const args = [_]Ref{ b.branch, b.branch2 orelse b.branch, b.gain, b.residual, b.post, b.output, b.next orelse b.branch, b.partials };
+        for (args, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+        e.setValue(TailShape{ .rows = rows, .width = width, .two = @intFromBool(b.branch2 != null), .partials = @intFromBool(b.next != null), .eps = eps, .mode = 1 }, 8);
+        e.dispatchGroups(mtl.Size.of(12, rows, 1), mtl.Size.of(256, 1, 1));
+    }
+
+    pub const Next = struct { bias: Ref, scale: Ref, gain: Ref, collapsed: Ref, normalized: Ref, shape: ihc.Shape, barriers: Ref };
+
+    /// Rows a fused seam launch may hold (all its threadgroups resident for the in-kernel barrier).
+    pub const seam_rows = 16;
+
+    /// tailPass then the next collapse's headPass in one launch (rows <= seam_rows, width 3072).
+    pub fn seamPass(self: Kernels, e: mtl.ComputeEncoder, b: Tail, n: Next, rows: u32, width: u32, eps: f32) !void {
+        if (rows > seam_rows or width != 12 * 256 or b.next == null) return error.BadHy4FusedSeam;
+        var next = n.shape;
+        next.rows = rows;
+        try next.check();
+        e.setPipeline(self.seam[@intFromBool(next.gates != ihc.streams)]);
+        const args = [_]Ref{ b.branch, b.branch2 orelse b.branch, b.gain, b.residual, b.post, b.output, b.next.?, b.partials };
+        for (args, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+        e.setValue(TailShape{ .rows = rows, .width = width, .two = @intFromBool(b.branch2 != null), .partials = 1, .eps = eps, .mode = 1 }, 8);
+        for ([_]Ref{ n.bias, n.scale, n.gain, n.collapsed, n.normalized }, 9..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+        e.setValue(next, 14);
+        e.setValue(next.eps, 15);
+        e.setBuffer(n.barriers.buffer, n.barriers.offset, 16);
+        e.dispatchGroups(mtl.Size.of(12, rows, 1), mtl.Size.of(256, 1, 1));
+    }
+
+    /// The seam partials of `hidden` alone (the collapse after an Engram layer, or with no tail before it).
+    pub fn seamPartials(self: Kernels, e: mtl.ComputeEncoder, hidden: Ref, projection: Ref, part: Ref, shape: ihc.Shape) !void {
+        try shape.check();
+        e.setPipeline(self.tail[@intFromBool(shape.gates != ihc.streams)]);
+        const args = [_]Ref{ hidden, hidden, hidden, hidden, hidden, hidden, projection, part };
+        for (args, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+        e.setValue(TailShape{ .rows = shape.rows, .width = shape.width, .two = 0, .partials = 1, .eps = shape.eps, .mode = 0 }, 8);
+        e.dispatchGroups(mtl.Size.of(12, shape.rows, 1), mtl.Size.of(256, 1, 1));
+    }
+
+    pub fn add(self: Kernels, e: mtl.ComputeEncoder, b: Add, shape: ihc.Shape) !void {
+        try shape.check();
+        if (shape.gates != 2 * ihc.streams) return error.MissingHy4PostGates;
+        e.setPipeline(self.mix);
+        const args = [_]Ref{ b.residual, b.branch, b.post, b.output };
+        for (args, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+        e.setValue(shape, args.len);
+        e.dispatchThreads(mtl.Size.of(ihc.streams * shape.width, shape.rows, 1), mtl.Size.of(256, 1, 1));
+    }
+};
diff --git a/zig/src/families/hy4_flash/index_cuda.zig b/zig/src/families/hy4_flash/index_cuda.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f56cb72f8d0774759b89e48dd0f77929fcca74ca
--- /dev/null
+++ b/zig/src/families/hy4_flash/index_cuda.zig
@@ -0,0 +1,116 @@
+//! Hy4-flash's CUDA compressed indexer: cache token keys, pool closed groups, rank them, keep 511 plus its own.
+const std = @import("std");
+const cuda = @import("cuda");
+const mla = @import("mla_cuda.zig");
+const rotary = @import("rope.zig");
+const recall = @import("index_recall.zig");
+const recall_cuda = @import("index_recall_cuda.zig");
+const groups = @import("index_groups.zig");
+
+pub const heads = recall.heads;
+pub const width = recall.width;
+pub const nope = width - 2 * rotary.pairs;
+pub const budget_groups: u32 = 512;
+
+/// Device weights: BF16 projections and norm, FP32 pooling parameters.
+pub const Weights = struct {
+    token_keys: u64, // [128, hidden]
+    token_norm: u64, // [128]
+    query: u64, // [16 * 128, q_rank]
+    head_weights: u64, // [16, hidden]
+    values: u64, // f32 [128, 128]
+    gates: u64, // f32 [128, 128]
+    bias: u64, // f32 [4, 128]
+    norm: u64, // f32 [128]
+};
+
+pub const Indexer = struct {
+    pool: cuda.Module,
+    groups_fn: cuda.Function,
+    select_kernels: recall_cuda.Kernels,
+
+    pub fn load(driver: *const cuda.Driver) !Indexer {
+        if (!cuda.kernels.available) return error.BuiltWithoutKernels;
+        var pool = try cuda.Module.load(driver, cuda.kernels.hy4_indexpool);
+        errdefer pool.unload();
+        return .{
+            .pool = pool,
+            .groups_fn = try pool.function("tf_hy4_index_groups"),
+            .select_kernels = try recall_cuda.Kernels.load(driver),
+        };
+    }
+
+    pub fn deinit(self: *Indexer) void {
+        self.select_kernels.deinit();
+        self.pool.unload();
+        self.* = undefined;
+    }
+
+    pub const Keys = struct {
+        hidden: u64, // BF16 [gemm_rows, hidden], zero past the active rows
+        gemm_rows: usize, // fixed per lane class so cuBLASLt keeps one reduction order
+        count: usize,
+        projected: u64, // BF16 [gemm_rows, 128]
+        norm_tmp: u64,
+        staged: u64, // BF16 [gemm_rows, 128]
+        first_slot: usize,
+    };
+
+    /// Normalized BF16 token keys of the active rows into contiguous cache slots from `first_slot`.
+    pub fn cacheKeys(_: Indexer, s: cuda.Stream, gemm: *cuda.vit.Gemms, norms: *const cuda.norms.Norms, w: Weights, b: Keys, cache: cuda.DeviceBuffer, hidden_size: usize, eps: f32) !void {
+        if (b.count == 0 or b.count > b.gemm_rows) return error.BadHy4IndexRows;
+        try gemm.run(s, b.hidden, w.token_keys, b.projected, b.gemm_rows, width, hidden_size, .bf16);
+        try norms.addRmsTail(s, b.projected, null, w.token_norm, b.norm_tmp, b.staged, null, b.gemm_rows, width, eps, .{ .round = true });
+        try cache.copyFrom(b.first_slot * width * 2, b.staged, b.count * width * 2, s.handle);
+    }
+
+    /// Pool, normalize and rotate `count` closed groups from `first_group` (positions: each group's first token).
+    pub fn poolGroups(self: Indexer, s: cuda.Stream, project: mla.Projections, w: Weights, cache: u64, arena: u64, first_group: u32, count: u32, positions: u64, table: u64, p: rotary.Parameters, eps: f32) !void {
+        if (count == 0) return;
+        var args: cuda.Args = .{};
+        inline for (.{ cache, w.values, w.gates, w.bias, w.norm, arena, first_group, eps }) |x| args.add(x);
+        try cuda.launch.launch(self.groups_fn, .{ .grid = .{ .x = count }, .block = .{ .x = width } }, s, &args);
+        try project.rotaryTable(s, positions, table, count, p);
+        const rope_base = arena + (@as(u64, first_group) * width + nope) * 2;
+        try project.rotate(s, rope_base, table, rope_base, .{ .rows = count, .heads = 1, .input_stride = width, .output_stride = width });
+    }
+
+    pub const Select = struct {
+        q_resid: u64, // BF16 [gemm_rows, q_rank], the q_a_layernorm output
+        hidden: u64, // BF16 [gemm_rows, hidden]
+        gemm_rows: usize,
+        positions: u64, // i32 [rows, 3]
+        table: u64, // BF16 [rows, 64]
+        query: u64, // BF16 [rows, 16 * 128]
+        head_weights: u64, // BF16 [rows, 16]
+        arena: u64,
+        rows: u64, // recall.Row [rows]
+        scores: u64,
+        tokens: u64,
+        counts: u64,
+    };
+
+    /// Rotated query heads, head weights, closed-group scores and the recalled slot list of each row.
+    pub fn select(self: Indexer, s: cuda.Stream, gemm: *cuda.vit.Gemms, project: mla.Projections, w: Weights, b: Select, shape: recall.Shape, q_rank: usize, hidden_size: usize, p: rotary.Parameters) !void {
+        if (shape.rows > b.gemm_rows) return error.BadHy4IndexRows;
+        try gemm.run(s, b.q_resid, w.query, b.query, b.gemm_rows, heads * width, q_rank, .bf16);
+        try project.rotaryTable(s, b.positions, b.table, shape.rows, p);
+        const rope_base = b.query + nope * 2;
+        try project.rotate(s, rope_base, b.table, rope_base, .{ .rows = shape.rows, .heads = heads, .input_stride = width, .output_stride = width });
+        try gemm.run(s, b.hidden, w.head_weights, b.head_weights, b.gemm_rows, heads, hidden_size, .bf16);
+        try self.select_kernels.run(s, .{
+            .query = b.query,
+            .keys = b.arena,
+            .weights = b.head_weights,
+            .rows = b.rows,
+            .scores = b.scores,
+            .tokens = b.tokens,
+            .counts = b.counts,
+        }, shape);
+    }
+};
+
+/// Closed groups a pass of `count` new slots after `previous` cached slots makes poolable.
+pub fn closedBy(previous: usize, count: usize) !groups.Append {
+    return groups.append(previous, count);
+}
diff --git a/zig/src/families/hy4_flash/index_groups.zig b/zig/src/families/hy4_flash/index_groups.zig
new file mode 100644
index 0000000000000000000000000000000000000000..55ca5703e0569e3f9a2def0cc29dcdeaa673eecd
--- /dev/null
+++ b/zig/src/families/hy4_flash/index_groups.zig
@@ -0,0 +1,61 @@
+//! Logical sparse-index groups shared by CUDA and Metal; token slots define group boundaries.
+const std = @import("std");
+
+pub const slots = 4;
+
+pub const PoolShape = extern struct {
+    groups: u32,
+    width: u32,
+};
+
+pub const Append = struct {
+    first_group: usize,
+    new_groups: usize,
+    pending_slots: usize,
+};
+
+/// Each completed group consumes four token slots and uses the first one's rotary position.
+pub fn append(previous: usize, count: usize) !Append {
+    const after = try std.math.add(usize, previous, count);
+    return .{
+        .first_group = previous / slots,
+        .new_groups = after / slots - previous / slots,
+        .pending_slots = after % slots,
+    };
+}
+
+pub const Frontier = struct {
+    visible_end: usize,
+    indexed_groups: usize,
+    current_group_start: usize,
+    groups_to_recall: usize,
+};
+
+/// The sparse selector ranks only closed earlier groups. It always includes the causal part of the current group.
+pub fn frontier(query_slot: usize, group_budget: usize) !Frontier {
+    if (group_budget == 0) return error.ZeroGroupBudget;
+    const end = try std.math.add(usize, query_slot, 1);
+    const group = query_slot / slots;
+    return .{
+        .visible_end = end,
+        .indexed_groups = group,
+        .current_group_start = group * slots,
+        .groups_to_recall = @min(group, group_budget - 1),
+    };
+}
+
+test "prefix continuation closes the same groups after draft rejection" {
+    const accepted = try append(2046, 3);
+    try std.testing.expectEqual(Append{ .first_group = 511, .new_groups = 1, .pending_slots = 1 }, accepted);
+    const provisioned = try append(2046, 6);
+    try std.testing.expectEqual(@as(usize, 2), provisioned.new_groups);
+    const after_rejection = try append(2046, 6 - 3);
+    try std.testing.expectEqual(accepted, after_rejection);
+}
+
+test "recall excludes the query group from ranking around the 2048-token budget" {
+    const last = try frontier(2047, 512);
+    try std.testing.expectEqual(Frontier{ .visible_end = 2048, .indexed_groups = 511, .current_group_start = 2044, .groups_to_recall = 511 }, last);
+    const first = try frontier(2048, 512);
+    try std.testing.expectEqual(Frontier{ .visible_end = 2049, .indexed_groups = 512, .current_group_start = 2048, .groups_to_recall = 511 }, first);
+}
diff --git a/zig/src/families/hy4_flash/index_recall.zig b/zig/src/families/hy4_flash/index_recall.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9f36e250bd5c66e2e869838673b96cbdfc2d68bd
--- /dev/null
+++ b/zig/src/families/hy4_flash/index_recall.zig
@@ -0,0 +1,48 @@
+//! Shapes for scoring completed index groups and expanding their token positions.
+const std = @import("std");
+const groups = @import("index_groups.zig");
+
+pub const heads = 16;
+pub const width = 128;
+pub const head_scale: f32 = 0.02209708691207961; // 1 / sqrt(heads * width)
+
+/// A group's location in the compressed key arena and the query's logical token position.
+pub const Row = extern struct {
+    group_base: u32,
+    token: u32,
+};
+
+pub const Shape = extern struct {
+    rows: u32,
+    score_groups: u32,
+    group_budget: u32,
+
+    pub fn check(self: Shape) !void {
+        if (self.rows == 0 or self.rows > std.math.maxInt(u16) or self.score_groups == 0 or
+            self.score_groups > 65536 or self.group_budget < 2 or self.group_budget > 512)
+            return error.BadHy4RecallShape;
+    }
+
+    pub fn tokenStride(self: Shape) u32 {
+        return self.group_budget * groups.slots;
+    }
+
+    pub fn scoreBytes(self: Shape) usize {
+        return @as(usize, self.rows) * self.score_groups * @sizeOf(f32);
+    }
+
+    pub fn tokenCount(self: Shape, token: u32) !u32 {
+        try self.check();
+        const recall = try groups.frontier(token, self.group_budget);
+        if (recall.indexed_groups > self.score_groups) return error.ShortHy4RecallScores;
+        return @intCast(recall.groups_to_recall * groups.slots + recall.visible_end - recall.current_group_start);
+    }
+};
+
+test "the current group's first token consumes a new key at the recall edge" {
+    const shape: Shape = .{ .rows = 1, .score_groups = 513, .group_budget = 512 };
+    try std.testing.expectEqual(@as(u32, 2048), shape.tokenStride());
+    try std.testing.expectEqual(@as(u32, 2048), try shape.tokenCount(2047));
+    try std.testing.expectEqual(@as(u32, 2045), try shape.tokenCount(2048));
+    try std.testing.expectEqual(@as(u32, 2048), try shape.tokenCount(2051));
+}
