+//! Four independent CUDA processes versus the single-device round-3 reference.
+const std = @import("std");
+const cuda = @import("cuda");
+const tp = cuda.hy4_tp;
+const testg = @import("rig").Rig;
+const Files = @import("contract_hy4_tp_files.zig").Files;
+const t = std.testing;
+const D: usize = tp.hidden;
+
+fn env(name: [:0]const u8) ![]const u8 {
+    return std.mem.span(std.c.getenv(name) orelse return error.MissingRankSetting);
+}
+
+const Worker = struct {
+    files: Files,
+    rank: tp.Rank,
+    link: *tp.Boundary,
+    rig: *testg,
+    k: *const cuda.hy4_ops.Kernels,
+    gemms: *cuda.vit.Gemms,
+    // Reuse full-chunk buffers across both boundary sites.
+    partial: cuda.DeviceBuffer,
+    all: cuda.DeviceBuffer,
+    branch: cuda.DeviceBuffer,
+
+    fn upload(self: *Worker, name: []const u8, n: usize) !u64 {
+        const data = try self.files.read(@backingInt(self.rank), name, n);
+        defer t.allocator.free(data);
+        return self.rig.input(data);
+    }
+
+    fn attention(self: *Worker) !void {
+        const rank = @backingInt(self.rank);
+        const shape: cuda.hy4_ops.MlaShape = .{ .rows = 2, .heads = 16, .capacity = 32770, .first_pos = 32768, .key_count = 2048 };
+        const bytes = try cuda.hy4_ops.scratchBytes(shape);
+        const cache = try self.files.read(null, "cache", 32770 * 576 * 2);
+        defer t.allocator.free(cache);
+        const ids = try self.files.read(null, "indices", 2 * 2048 * 4);
+        defer t.allocator.free(ids);
+        var b: cuda.hy4_ops.MlaAttend = .{ .absorbed_q = try self.upload("aq", 2 * 16 * 576 * 2), .cache = try self.rig.input(cache), .indices = try self.rig.input(ids), .kv_b = try self.upload("kv-b", 16 * 448 * 512 * 2), .gate = try self.upload("gate", 2 * 4096 * 2), .sinks = try self.upload("sinks", 16 * 4), .scratch = try self.rig.scratch(bytes), .scratch_bytes = bytes, .output = try self.rig.output(2 * 4096 * 2) };
+        const w = try self.upload("attn-weight", D * 4096 * 2);
+        for ([_]bool{ false, true }) |fault| {
+            if (!fault or rank == 0) {
+                if (fault) {
+                    var vals: [16]f32 = undefined;
+                    @memcpy(std.mem.asBytes(&vals), try self.rig.bytes(b.sinks, 16 * 4));
+                    for (&vals) |*v| v.* += @log(@as(f32, 2));
+                    b.sinks = try self.rig.input(std.mem.asBytes(&vals));
+                }
+                try cuda.hy4_ops.mlaAttend(self.k, self.rig.s, shape, b);
+                const expected = try self.files.read(rank, if (fault) "attn-double-sink" else "attn-input", 2 * 4096 * 2);
+                defer t.allocator.free(expected);
+                try t.expectEqualSlices(u8, expected, try self.rig.bytes(b.output, expected.len));
+                try self.gemms.run(self.rig.s, b.output, w, self.partial.ptr, 2, D, 4096, .f32);
+            }
+            try self.fold(2);
+            if (fault) {
+                const changed = try self.reference("attention", 2, 2);
+                std.debug.print("CONTROL doubled_sink folded_changed={d}/{d}\n", .{ changed, 2 * D });
+                try t.expect(changed != 0);
+            } else try self.equal("attention", 2, 2);
+        }
+    }
+
+    fn projection(self: *Worker, input: []const u8, weight: []const u8, rows: usize, width: usize, dest: u64) !void {
+        const x = try self.upload(input, rows * width * 2);
+        const w = try self.upload(weight, D * width * 2);
+        try self.gemms.run(self.rig.s, x, w, dest, rows, D, width, .f32);
+    }
+
+    fn fold(self: *Worker, rows: usize) !void {
+        try self.link.gatherFold(self.k, self.rig.s, rows, .{
+            .partial = .{ .ptr = self.partial.ptr, .bytes = self.partial.len },
+            .gathered = .{ .ptr = self.all.ptr, .bytes = self.all.len },
+            .branch = .{ .ptr = self.branch.ptr, .bytes = self.branch.len },
+        });
+    }
+
+    fn reference(self: *Worker, name: []const u8, ref_rows: usize, rows: usize) !usize {
+        const expected = try self.files.read(null, name, ref_rows * D * 2);
+        defer t.allocator.free(expected);
+        const actual = try self.rig.bytes(self.branch.ptr, rows * D * 2);
+        var changed: usize = 0;
+        for (0..rows * D) |i| {
+            const j = i % (ref_rows * D);
+            changed += @intFromBool(!std.mem.eql(u8, actual[i * 2 ..][0..2], expected[j * 2 ..][0..2]));
+        }
+        return changed;
+    }
+
+    fn equal(self: *Worker, name: []const u8, ref_rows: usize, rows: usize) !void {
+        const changed = try self.reference(name, ref_rows, rows);
+        std.debug.print("WORDS rank={d} branch={s} rows={d} changed={d}/{d}\n", .{ @backingInt(self.rank), name, rows, changed, rows * D });
+        try t.expectEqual(@as(usize, 0), changed);
+    }
+
+    fn orderControls(self: *Worker) !void {
+        const bf = @import("bf16_round");
+        for ([_][4]f32{ .{ 16777216, 1, -16777216, 4 }, .{ 16777216, -16777216, 1, 4 }, .{ 16777216, 1, -16777216, 0 } }, [_]u32{ 4, 5, 0 }) |values, value| {
+            try self.partial.fill32(@bitCast(values[@backingInt(self.rank)]), self.rig.s.handle);
+            try self.fold(1);
+            const data = try self.rig.bytes(self.branch.ptr, D * 2);
+            for (0..D) |i| try t.expectEqual(bf.bits(@floatFromInt(value)), std.mem.readInt(u16, data[i * 2 ..][0..2], .little));
+        }
+        std.debug.print("CONTROL rank={d} canonical=4 swapped=5 dropped=0 words={d}\n", .{ @backingInt(self.rank), D });
+    }
+
+    fn midToken(self: *Worker, bootstrap: anytype) !void {
+        try self.partial.fill32(@bitCast(@as(f32, 1)), self.rig.s.handle);
+        for (0..7) |_| try self.fold(1);
+        try self.link.finish(self.rig.s);
+        for (std.mem.bytesAsSlice(u16, try self.rig.bytes(self.branch.ptr, D * 2))) |word|
+            try t.expectEqual(@as(u16, 0x4080), word);
+        try bootstrap.agree("seven", "seven exact boundaries before injected failure");
+        if (self.rank == .two) {
+            if (self.link.relay) |wire| {
+                wire.abort(wire.ctx);
+            } else {
+                std.debug.print("MID_TOKEN rank=2 completed=7 call=8 injected_peer_exit=86 published=0\n", .{});
+                std.process.exit(86);
+            }
+        }
+        const refused = blk: {
+            self.fold(1) catch |err| break :blk err;
+            self.link.finish(self.rig.s) catch |err| break :blk err;
+            return error.FaultAccepted;
+        };
+        std.debug.print("MID_TOKEN rank={d} completed=7 call=8 refused={t} published=0\n", .{ @backingInt(self.rank), refused });
+        if (self.link.relay != null) try bootstrap.agree("refused", "every rank refused the token");
+        return error.InjectedRelayFailure;
+    }
+
+    fn cases(self: *Worker) !void {
+        try self.orderControls();
+        try self.attention();
+        self.rig.reset();
+
+        try self.projection("dense-input", "dense-weight", 48, 4608, self.partial.ptr);
+        try self.fold(48);
+        try self.equal("dense", 48, 48);
+        self.rig.reset();
+        const shared = try self.rig.output(48 * D * 4);
+        try self.projection("shared-input", "shared-weight", 48, 512, shared);
