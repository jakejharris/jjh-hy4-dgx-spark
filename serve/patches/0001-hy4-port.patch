+    const Spec = struct { sfx: []const u8, k_pad: usize, n_pad: usize, n_log: usize, k_log: usize, loc_n: usize, loc_k: usize, split: core.exl3_layout.Split, k2: usize };
+    // Mix 3-bit (k2=6), 4-bit (k2=8), and 6-bit (k2=12) across the 8 matrices of Layer 1 in one shard!
+    const specs = [_]Spec{
+        .{ .sfx = "self_attn.q_a_proj", .k_pad = 6144, .n_pad = 2048, .n_log = 2048, .k_log = 6144, .loc_n = 2048, .loc_k = 6144, .split = .whole, .k2 = 6 },
+        .{ .sfx = "self_attn.q_b_proj", .k_pad = 2048, .n_pad = 16384, .n_log = 16384, .k_log = 2048, .loc_n = 4096, .loc_k = 2048, .split = .col, .k2 = 8 },
+        .{ .sfx = "self_attn.kv_a_proj_with_mqa", .k_pad = 6144, .n_pad = 640, .n_log = 576, .k_log = 6144, .loc_n = 576, .loc_k = 6144, .split = .whole, .k2 = 12 },
+        .{ .sfx = "self_attn.linear_gate", .k_pad = 6144, .n_pad = 16384, .n_log = 16384, .k_log = 6144, .loc_n = 4096, .loc_k = 6144, .split = .col, .k2 = 6 },
+        .{ .sfx = "self_attn.o_proj", .k_pad = 16384, .n_pad = 6144, .n_log = 6144, .k_log = 16384, .loc_n = 6144, .loc_k = 4096, .split = .row, .k2 = 8 },
+        .{ .sfx = "mlp.shared_experts.gate_proj", .k_pad = 6144, .n_pad = 2048, .n_log = 2048, .k_log = 6144, .loc_n = 512, .loc_k = 6144, .split = .col, .k2 = 12 },
+        .{ .sfx = "mlp.shared_experts.up_proj", .k_pad = 6144, .n_pad = 2048, .n_log = 2048, .k_log = 6144, .loc_n = 512, .loc_k = 6144, .split = .col, .k2 = 8 },
+        .{ .sfx = "mlp.shared_experts.down_proj", .k_pad = 2048, .n_pad = 6144, .n_log = 6144, .k_log = 2048, .loc_n = 6144, .loc_k = 512, .split = .row, .k2 = 6 },
+    };
+
+    var arena = std.heap.ArenaAllocator.init(gpa);
