+/// Single check in one place: disables row-number fast prefill paths on image lanes while keeping text and MoE intact.
+pub fn enterRowPositionGuard(ops: anytype, mrope: ?*const LanePositions) RowPositionGuard {
+    if (mrope == null or !mrope.?.active) return .{};
+    const T = @TypeOf(ops.*);
+    var g: RowPositionGuard = .{ .active = true };
+    if (comptime @hasField(T, "fast_prefill")) {
+        g.saved_fast_prefill = ops.fast_prefill;
+        ops.fast_prefill = false;
+    }
+    if (comptime @hasField(T, "fast_mla")) {
+        g.saved_fast_mla = ops.fast_mla;
+        ops.fast_mla = false;
+    }
+    if (comptime @hasField(T, "fast_indexer")) {
+        g.saved_fast_indexer = ops.fast_indexer;
+        ops.fast_indexer = false;
+    }
+    return g;
+}
+
+pub const RowPositionGuard = struct {
+    saved_fast_prefill: bool = false,
+    saved_fast_mla: bool = false,
+    saved_fast_indexer: bool = false,
+    active: bool = false,
+
+    pub fn leave(self: RowPositionGuard, ops: anytype) void {
+        if (!self.active) return;
+        const T = @TypeOf(ops.*);
+        if (comptime @hasField(T, "fast_prefill")) ops.fast_prefill = self.saved_fast_prefill;
+        if (comptime @hasField(T, "fast_mla")) ops.fast_mla = self.saved_fast_mla;
+        if (comptime @hasField(T, "fast_indexer")) ops.fast_indexer = self.saved_fast_indexer;
+    }
+};
+
+pub const LanePositions = struct {
+    active: bool = false,
+    prompt_len: usize = 0,
+    rope_delta: i32 = 0,
+    thw_ptr: u64 = 0,
+    vk: *const cuda.hy4_vision.Kernels,
+
+    pub fn forStep(vk: *const cuda.hy4_vision.Kernels, thw_ptr: u64, prompt_len: usize, rope_delta: i32) LanePositions {
+        return .{ .active = true, .prompt_len = prompt_len, .rope_delta = rope_delta, .thw_ptr = thw_ptr, .vk = vk };
+    }
+};
+
+pub const SlotState = struct {
+    active: bool = false,
+    prompt_len: usize = 0,
+    rope_delta: i32 = 0,
+    total_tokens: u32 = 0,
+    rows_dev: cuda.DeviceBuffer,
+    thw_host: std.ArrayList(i32) = .empty,
+    spans: std.ArrayList(vimg.ImageSpan) = .empty,
+
+    pub fn reset(self: *SlotState) void {
+        self.active = false;
+        self.prompt_len = 0;
+        self.rope_delta = 0;
+        self.total_tokens = 0;
+        self.spans.clearRetainingCapacity();
+        self.thw_host.clearRetainingCapacity();
+    }
+
+    pub fn deinit(self: *SlotState, gpa: std.mem.Allocator) void {
+        self.rows_dev.free();
+        self.thw_host.deinit(gpa);
+        self.spans.deinit(gpa);
+        self.* = undefined;
+    }
+
+    pub const ChunkPlan = struct {
+        active: bool = false,
+        has_overlap: bool = false,
+        thw_slice: ?[]const i32 = null,
+        prompt_len: usize = 0,
+        rope_delta: i32 = 0,
+    };
+
+    pub fn planChunk(self: *const SlotState, first_pos: usize, rows: usize, host_map: []i32) !ChunkPlan {
+        if (!self.active) return .{};
+        if (first_pos < self.prompt_len) {
+            if (first_pos + rows > self.prompt_len or rows > host_map.len) return error.BadHy4VisionPrompt;
+            @memset(host_map[0..rows], -1);
+            var has_overlap = false;
+            for (self.spans.items) |sp| {
+                const lo = @max(first_pos, @as(usize, sp.at));
+                const hi = @min(first_pos + rows, @as(usize, sp.at + sp.tokens));
+                if (lo < hi) {
+                    has_overlap = true;
+                    for (lo..hi) |abs_p| host_map[abs_p - first_pos] = @intCast(sp.row_offset + @as(u32, @intCast(abs_p - sp.at)));
+                }
+            }
+            return .{
+                .active = true, .has_overlap = has_overlap,
+                .thw_slice = self.thw_host.items[first_pos * 3 .. (first_pos + rows) * 3],
+                .prompt_len = self.prompt_len, .rope_delta = self.rope_delta,
+            };
+        }
+        return .{ .active = true, .prompt_len = self.prompt_len, .rope_delta = self.rope_delta };
+    }
+};
+
+pub fn abortFanOut(pl: *tp.planlink.PlanLink, tp_sess: ?*boundary.TpSession) void {
+    for (&pl.fds) |*fd| if (fd.* >= 0) tp.sock.hangup(fd.*);
+    pl.close();
+    if (tp_sess) |tps| {
+        tps.boundary.abort();
+        tps.bootstrap.close();
+    }
+}
+
+/// Stages and fans out a `vision_set` frame; aborts peers on send failure and publishes local slot only after success.
+pub fn stageAndFanOutSlot(
+    st_slot: *SlotState,
+    gpa: std.mem.Allocator,
+    slot: usize,
+    prompt_len: usize,
+    plan: vimg.MropePlan,
+    out_hidden_size: u32,
+    feat_src: ?[]const u8,
+    d_opt: ?*const cuda.Driver,
+    stream_opt: ?cuda.Stream,
+    plan_link: ?*tp.planlink.PlanLink,
+    tp_sess: ?*boundary.TpSession,
+) !void {
+    st_slot.reset();
+    try st_slot.thw_host.ensureTotalCapacity(gpa, plan.thw.len);
+    try st_slot.spans.ensureTotalCapacity(gpa, plan.spans.len);
+
+    if (plan_link) |pl| if (pl.rank == 0) {
+        const feat_bytes = @as(usize, plan.total_image_tokens) * out_hidden_size * 2;
+        const feat_words = (feat_bytes + 7) / 8;
+        const header_words: usize = 6;
+        const span_words: usize = plan.spans.len * 3;
+        const thw_words: usize = (plan.thw.len * 4 + 7) / 8;
+        const frame = try gpa.alloc(i64, header_words + span_words + thw_words + feat_words);
+        defer gpa.free(frame);
+        @memset(frame, 0);
+        frame[0] = @intFromEnum(boundary.PlanOp.vision_set);
+        frame[1] = @intCast(slot);
+        frame[2] = @intCast(prompt_len);
+        frame[3] = plan.rope_delta;
+        frame[4] = plan.total_image_tokens;
+        frame[5] = @intCast(plan.spans.len);
+        for (plan.spans, 0..) |sp, i| {
+            frame[header_words + i * 3 + 0] = sp.at;
+            frame[header_words + i * 3 + 1] = sp.tokens;
+            frame[header_words + i * 3 + 2] = sp.row_offset;
+        }
+        @memcpy(std.mem.sliceAsBytes(frame[header_words + span_words ..][0..thw_words])[0 .. plan.thw.len * 4], std.mem.sliceAsBytes(plan.thw));
+        const feat_dst = std.mem.sliceAsBytes(frame[header_words + span_words + thw_words ..][0..feat_words])[0..feat_bytes];
+        if (feat_src) |src| {
+            @memcpy(feat_dst, src[0..feat_bytes]);
+        } else {
+            try stream_opt.?.synchronize();
+            try cuda.memory.download(d_opt.?, st_slot.rows_dev.ptr, feat_dst);
+        }
+        pl.send(frame) catch |err| {
+            abortFanOut(pl, tp_sess);
+            return err;
+        };
+    };
+
+    st_slot.thw_host.appendSliceAssumeCapacity(plan.thw);
+    st_slot.spans.appendSliceAssumeCapacity(plan.spans);
+    st_slot.prompt_len = prompt_len;
+    st_slot.rope_delta = plan.rope_delta;
+    st_slot.total_tokens = plan.total_image_tokens;
+    st_slot.active = true;
+}
