+test "short iHC and rounded norm match every staged word" {
+    try checkGpu(@import("contract_hy4_tp.zig").readNorm);
+}
+
+test "short Hy4 trunk preserves each K partition and BF16 activation point" {
+    try checkGpu(@import("contract_hy4_trunk.zig").check);
+}
+
+test "Hy4 short router and in-place routed tiles reproduce canonical bytes and reject planted faults" {
+    try checkGpu(@import("contract_hy4_routed_wide.zig").check);
+}
+
+test "packed Hy4 down and O keep their in-range bytes and recover a million" {
+    try checkGpu(@import("contract_hy4_range.zig").check);
+}
diff --git a/zig/kernels/cuda/contract_hy4_oracle.zig b/zig/kernels/cuda/contract_hy4_oracle.zig
new file mode 100644
index 0000000000000000000000000000000000000000..a603667a30d613b5c8eee69c75727cf4abf362c7
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_oracle.zig
@@ -0,0 +1,230 @@
+//! Replay the independent synthetic L0 dumps through the production CUDA ABI.
+//! Host BF16 linears supply the family-owned projections. The saved index sets
+//! and dense branch isolate the kernel round from later work on MoE/indexing.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = cuda.hy4_ops;
+const Rig = @import("rig").Rig;
+const st = @import("core").safetensors;
+const bf = @import("bf16_round");
+const io = std.testing.io;
+const W = 32;
+const layer = "model.layers.0.";
+const attn = layer ++ "self_attn.";
+
+pub fn tensor(files: []const st.File, name: []const u8, dtype: st.DType, shape: []const usize) ![]const u8 {
+    for (files) |*f| if (f.get(name)) |v| {
+        if (!v.is(dtype, shape)) return error.BadFixtureTensor;
+        return v.bytes;
+    };
+    std.debug.print("Missing Hy4 fixture tensor {s}\n", .{name});
+    return error.BadFixtureTensor;
+}
+
+pub fn mv(a: std.mem.Allocator, x: []align(1) const u16, weights: []const u8, width: usize, out_width: usize) ![]u16 {
+    const w = std.mem.bytesAsSlice(u16, weights);
+    const y = try a.alloc(u16, x.len / width * out_width);
+    for (0..x.len / width) |row| for (0..out_width) |n| {
+        var sum: f32 = 0;
+        for (0..width) |i| sum = @mulAdd(f32, bf.value(x[row * width + i]), bf.value(w[n * width + i]), sum);
+        y[row * out_width + n] = bf.bits(sum);
+    };
+    return y;
+}
+
+pub fn norm(a: std.mem.Allocator, x: []align(1) const u16, weights: []const u8) ![]u16 {
+    const w = std.mem.bytesAsSlice(u16, weights);
+    const y = try a.alloc(u16, x.len);
+    for (0..x.len / w.len) |row| {
+        const base = row * w.len;
+        var sum: f32 = 0;
+        for (x[base..][0..w.len]) |v| sum += bf.value(v) * bf.value(v);
+        const inv = 1 / @sqrt(sum / @as(f32, @floatFromInt(w.len)) + 1e-5);
+        for (w, 0..) |v, i| y[base + i] = bf.bits(bf.round32(bf.value(x[base + i]) * inv) * bf.value(v));
+    }
+    return y;
+}
+
+pub fn read(r: *Rig, k: *const ops.Kernels, weights: []const st.File, rows: u32, streams: u64, comptime prefix: []const u8) !ops.IhcRead {
+    const b: ops.IhcRead = .{
+        .streams = streams,
+        .projection = try r.input(try tensor(weights, prefix ++ "fn", .f32, &.{ 8, 4 * W })),
+        .base = try r.input(try tensor(weights, prefix ++ "base", .f32, &.{8})),
+        .scale = try r.input(try tensor(weights, prefix ++ "scale", .f32, &.{2})),
+        .post = try r.output(rows * 4 * 4),
+        .output = try r.output(rows * W * 2),
+    };
+    try ops.ihcRead(k, r.s, .{ .rows = rows, .width = W }, b);
+    return b;
+}
+
+fn compare(comptime T: type, name: []const u8, got: []align(1) const T, ref_bytes: []const u8, abs_limit: f64) !void {
+    const ref = std.mem.bytesAsSlice(T, ref_bytes);
+    var max_abs: f64 = 0;
+    var peak: f64 = 0;
+    var dot: f64 = 0;
+    var g2: f64 = 0;
+    var r2: f64 = 0;
+    var differing: usize = 0;
+    for (got, ref) |gb, rb| {
+        differing += @intFromBool(!std.mem.eql(u8, std.mem.asBytes(&gb), std.mem.asBytes(&rb)));
+        const g: f64 = if (T == u16) bf.value(gb) else gb;
+        const v: f64 = if (T == u16) bf.value(rb) else rb;
+        try std.testing.expect(std.math.isFinite(g) and std.math.isFinite(v));
+        max_abs = @max(max_abs, @abs(g - v));
+        peak = @max(peak, @abs(v));
+        dot += g * v;
+        g2 += g * g;
+        r2 += v * v;
+    }
+    const rel = if (max_abs == 0) 0 else max_abs / peak;
+    const cos_loss = if (g2 == 0 and r2 == 0) 0 else if (g2 == 0 or r2 == 0) 1 else 1 - dot / @sqrt(r2 * g2);
+    const ratio = @max(max_abs / abs_limit, rel / 0.025, cos_loss / 5e-4);
+    const band = if (ratio <= 1) "PASS" else if (ratio < 2) "NEAR" else "MISS";
+    std.debug.print("Hy4 oracle {s} {s} max_abs={d:.8} peak_rel={d:.8} cos_loss={d:.9} differing={d}/{d}\n", .{ band, name, max_abs, rel, cos_loss, differing, got.len });
+    try std.testing.expect(ratio < 2);
+}
+
+fn capture(k: *const ops.Kernels, stream: cuda.Stream, m: ops.MlaShape, project: ops.MlaProject, attend: ops.MlaAttend) !cuda.graph.Graph {
+    try cuda.graph.beginCapture(stream, .thread_local);
+    {
+        errdefer if (cuda.graph.endCapture(stream)) |graph| {
+            var invalid = graph;
+            invalid.deinit();
+        } else |_| {};
+        try ops.mlaProject(k, stream, m, project);
+        try ops.mlaAttend(k, stream, m, attend);
+    }
+    return cuda.graph.endCapture(stream);
+}
+
+fn replay(r: *Rig, k: *const ops.Kernels, weights: []const st.File, reference: st.File, rows: u32) !void {
+    var pool = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer pool.deinit();
+    const a = pool.allocator();
+    const dump = &.{reference};
+    const shape: ops.IhcShape = .{ .width = W, .rows = rows };
+    const in = try tensor(dump, "layer.000.streams_in", .bf16, &.{ 1, rows, 4, W });
+    const streams = try r.input(in);
+    const hc = try read(r, k, weights, rows, streams, layer ++ "hc_attn_layer.hc_pre.hc_");
+    const hidden = std.mem.bytesAsSlice(u16, try r.bytes(hc.output, rows * W * 2));
+    const x = try norm(a, hidden, try tensor(weights, layer ++ "input_layernorm.weight", .bf16, &.{W}));
+    const qa = try mv(a, x, try tensor(weights, attn ++ "q_a_proj.weight", .bf16, &.{ 12, W }), W, 12);
+    const qn = try norm(a, qa, try tensor(weights, attn ++ "q_a_layernorm.weight", .bf16, &.{12}));
+    const q = try mv(a, qn, try tensor(weights, attn ++ "q_b_proj.weight", .bf16, &.{ 64, 12 }), 12, 64);
+    const kv = try mv(a, x, try tensor(weights, attn ++ "kv_a_proj_with_mqa.weight", .bf16, &.{ 14, W }), W, 14);
+    const gate = try mv(a, x, try tensor(weights, attn ++ "linear_gate.weight", .bf16, &.{ 64, W }), W, 64);
+    const m: ops.MlaShape = .{ .rows = rows, .heads = 4, .capacity = rows, .key_count = 16, .latent = 8, .nope = 10, .rope = 6, .value = 16 };
+    const project: ops.MlaProject = .{
+        .q = try r.input(std.mem.sliceAsBytes(q)),
+        .kv = try r.input(std.mem.sliceAsBytes(kv)),
+        .kv_norm = try r.input(try tensor(weights, attn ++ "kv_a_layernorm.weight", .bf16, &.{8})),
+        .kv_b = try r.input(try tensor(weights, attn ++ "kv_b_proj.weight", .bf16, &.{ 104, 8 })),
+        .absorbed_q = try r.output(rows * 4 * 14 * 2),
+        .cache = try r.output(rows * 14 * 2),
+    };
+    try ops.mlaProject(k, r.s, m, project);
+    const n = try ops.scratchBytes(m);
+    const attend: ops.MlaAttend = .{
+        .absorbed_q = project.absorbed_q,
+        .cache = project.cache,
+        .kv_b = project.kv_b,
+        .sinks = try r.input(try tensor(weights, attn ++ "learnable_sink_param", .f32, &.{4})),
+        .gate = try r.input(std.mem.sliceAsBytes(gate)),
+        .indices = try r.input(try tensor(dump, "layer.000.index_positions", .i32, &.{ 1, rows, 16 })),
+        .output = try r.output(rows * 64 * 2),
+        .scratch_bytes = n,
+        .scratch = try r.scratch(n),
+    };
+    try ops.mlaAttend(k, r.s, m, attend);
+    const values = std.mem.bytesAsSlice(u16, try a.dupe(u8, try r.bytes(attend.output, rows * 64 * 2)));
+    // A row decoded alone from the same prefix must produce the same output bits.
+    var separate = project;
+    separate.cache = try r.output(rows * 14 * 2);
+    separate.absorbed_q = try r.output(4 * 14 * 2);
+    const streamed = try r.output(rows * 64 * 2);
+    var single = m;
+    single.rows = 1;
+    for (0..rows) |row| {
+        single.first_pos = @intCast(row);
+        var pr = separate;
+        pr.q += row * 4 * 16 * 2;
+        pr.kv += row * 14 * 2;
+        try ops.mlaProject(k, r.s, single, pr);
+        var step = attend;
+        step.cache = pr.cache;
+        step.absorbed_q = pr.absorbed_q;
+        step.gate += row * 64 * 2;
+        step.indices += row * 16 * 4;
+        step.output = streamed + row * 64 * 2;
+        try ops.mlaAttend(k, r.s, single, step);
+    }
+    try std.testing.expectEqualSlices(u8, std.mem.sliceAsBytes(values), try r.bytes(streamed, rows * 64 * 2));
+    var captured = attend;
+    captured.output = try r.output(rows * 64 * 2);
+    try r.gpu.d.synchronize();
+    var stream = try cuda.Stream.init(r.gpu.d, true);
+    defer stream.deinit();
+    var graph = try capture(k, stream, m, project, captured);
+    defer graph.deinit();
+    var exe = try graph.instantiate();
+    defer exe.deinit();
+    try exe.launchOn(stream);
+    try stream.synchronize();
+    try std.testing.expectEqualSlices(u8, std.mem.sliceAsBytes(values), try r.bytes(captured.output, rows * 64 * 2));
+    if (rows == 16) {
+        var dense = attend;
+        dense.indices = 0;
+        try ops.mlaAttend(k, r.s, m, dense);
+        try std.testing.expectEqualSlices(u8, std.mem.sliceAsBytes(values), try r.bytes(attend.output, rows * 64 * 2));
+    }
+    const attention = try mv(a, values, try tensor(weights, attn ++ "o_proj.weight", .bf16, &.{ W, 64 }), 64, W);
+    try compare(u16, "layer.000.attention_out", attention, try tensor(dump, "layer.000.attention_out", .bf16, &.{ 1, rows, W }), 0.025);
+    const mid = try r.output(in.len);
+    try ops.ihcWrite(k, r.s, shape, .{ .residual = streams, .post = hc.post, .branch = try r.input(std.mem.sliceAsBytes(attention)), .output = mid });
+    const ffn = try read(r, k, weights, rows, mid, layer ++ "hc_mlp_layer.hc_pre.hc_");
+    const dense_out = try r.input(try tensor(dump, "layer.000.dense_out", .bf16, &.{ 1, rows, W }));
+    try ops.ihcWrite(k, r.s, shape, .{ .residual = mid, .post = ffn.post, .branch = dense_out, .output = mid });
+    try compare(u16, "layer.000.streams_out", std.mem.bytesAsSlice(u16, try r.bytes(mid, in.len)), try tensor(dump, "layer.000.streams_out", .bf16, &.{ 1, rows, 4, W }), 0.10);
+    // Probe the learned head on exact last-layer streams, independent of the
+    // intervening layers. The checkpoint keeps the final LM projection in FP32.
+    const last = try tensor(dump, "layer.005.streams_out", .bf16, &.{ 1, rows, 4, W });
+    const head = try r.output(rows * W * 2);
+    try ops.ihcHead(k, r.s, shape, .{
+        .streams = try r.input(last),
+        .output = head,
+        .projection = try r.input(try tensor(weights, "model.hc_head.hc_head_fn", .f32, &.{ 4, 4 * W })),
+        .base = try r.input(try tensor(weights, "model.hc_head.hc_head_base", .f32, &.{4})),
+        .scale = try r.input(try tensor(weights, "model.hc_head.hc_head_scale", .f32, &.{1})),
+    });
+    const hx = try norm(a, std.mem.bytesAsSlice(u16, try r.bytes(head, rows * W * 2)), try tensor(weights, "model.norm.weight", .bf16, &.{W}));
+    const lm = std.mem.bytesAsSlice(f32, try tensor(weights, "lm_head.weight", .f32, &.{ 101, W }));
+    const logits = try a.alloc(f32, rows * 101);
+    for (0..rows) |row| for (0..101) |token| {
+        var sum: f32 = 0;
+        for (0..W) |i| sum = @mulAdd(f32, bf.value(hx[row * W + i]), lm[token * W + i], sum);
+        logits[row * 101 + token] = sum;
+    };
+    try compare(f32, "logits (injected final streams)", logits, try tensor(dump, "logits", .f32, &.{ 1, rows, 101 }), 0.08);
+    try std.testing.expect(try r.intact());
+}
+
+pub fn open(dir: []const u8, suffix: []const u8) !st.File {
+    const name = try std.fs.path.join(std.testing.allocator, &.{ dir, suffix });
+    defer std.testing.allocator.free(name);
+    return st.File.open(std.testing.allocator, io, name);
+}
+pub fn check(r: *Rig, k: *const ops.Kernels) !void {
+    const dir = @import("hy4_options").oracle orelse return error.MissingOracle;
+    var w1 = try open(dir, "tiny/model-00001-of-00002.safetensors");
+    defer w1.close(io);
+    var w2 = try open(dir, "tiny/model-00002-of-00002.safetensors");
+    defer w2.close(io);
+    inline for (.{ "prompt16", "prune48" }, .{ 16, 48 }) |case, rows| {
+        var dump = try open(dir, "dumps/" ++ case ++ ".safetensors");
+        defer dump.close(io);
+        std.debug.print("Hy4 oracle {s}\n", .{case});
+        try replay(r, k, &.{ w1, w2 }, dump, rows);
+        r.reset();
+    }
+}
diff --git a/zig/kernels/cuda/contract_hy4_precision.zig b/zig/kernels/cuda/contract_hy4_precision.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b0ddfc16c362d35f271b98ddb461d2232e15dbf0
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_precision.zig
@@ -0,0 +1,87 @@
+//! Cancellation controls distinguish FP32 accumulators from reduced-precision sums.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = cuda.hy4_ops;
+const Rig = @import("rig").Rig;
+const bf = @import("bf16_round");
+const expect = std.testing.expectEqual;
+
+pub fn check(r: *Rig, k: *const ops.Kernels) !void {
+    // The middle unit vanishes in a BF16 chain; the first term overflows FP16.
+    const wide: f32 = 65536;
+    try expect(@as(f32, 0), bf.round32(bf.round32(wide + 1) - wide));
+    try std.testing.expect(std.math.isInf(@as(f16, @floatCast(wide))));
+    try projection(r, k, wide);
+    try mixture(r, k, wide);
+    try prefix(r, k, wide);
+}
+
+fn projection(r: *Rig, k: *const ops.Kernels, wide: f32) !void {
+    // A single Q output accumulates three signed BF16 products in FP32.
+    const shape: ops.MlaShape = .{ .rows = 1, .heads = 1, .capacity = 1, .key_count = 1, .nope = 3, .latent = 1, .rope = 2, .value = 1 };
+    const q = [_]u16{ bf.bits(1), bf.bits(1), bf.bits(1), 0, 0 };
+    const kv = [_]u16{ bf.bits(1), 0, 0 };
+    const w = [_]u16{ bf.bits(wide), bf.bits(1), bf.bits(-wide), bf.bits(1) };
+    const gain = [_]u16{bf.bits(1)};
+    const out = try r.output(6);
+    try ops.mlaProject(k, r.s, shape, .{ .q = try r.input(std.mem.asBytes(&q)), .kv = try r.input(std.mem.asBytes(&kv)), .kv_norm = try r.input(std.mem.asBytes(&gain)), .kv_b = try r.input(std.mem.asBytes(&w)), .absorbed_q = out, .cache = try r.output(6) });
+    try expect(bf.bits(1), std.mem.readInt(u16, (try r.bytes(out, 6))[0..2], .little));
+}
+
+fn mixture(r: *Rig, k: *const ops.Kernels, wide: f32) !void {
+    const width = 192;
+    // Put all three terms on lane 0 of the iHC projection, each one block step apart.
+    var hidden: [4 * width]u16 = @splat(0);
+    var projection_weights: [8 * 4 * width]f32 = @splat(0);
+    for ([_]usize{ 0, 256, 512 }, [_]f32{ wide, 1, -wide }) |at, v| {
+        hidden[at] = bf.bits(1);
+        projection_weights[4 * 4 * width + at] = v;
+    }
+    const base: [8]f32 = @splat(0);
+    const scale = [_]f32{ 1, 0.0625 };
+    const post = try r.output(4 * 4);
+    try ops.ihcRead(k, r.s, .{ .rows = 1, .width = width }, .{ .streams = try r.input(std.mem.asBytes(&hidden)), .projection = try r.input(std.mem.asBytes(&projection_weights)), .base = try r.input(std.mem.asBytes(&base)), .scale = try r.input(std.mem.asBytes(&scale)), .output = try r.output(width * 2), .post = post });
+    const result: f32 = @bitCast(std.mem.readInt(u32, (try r.bytes(post, 16))[0..4], .little));
+    const score: f64 = 0.0625 / @sqrt(@as(f64, 3.0) / (4 * width) + 1e-5);
+    const reference: f64 = 2 / (1 + @exp(-score)) + 1e-6;
+    try std.testing.expectApproxEqAbs(reference, @as(f64, result), 2e-6);
+}
+
+fn prefix(r: *Rig, k: *const ops.Kernels, wide: f32) !void {
+    const count = 2048;
+    const shape: ops.MlaShape = .{ .rows = 1, .heads = 1, .capacity = count, .first_pos = count - 1, .key_count = count, .latent = 1, .nope = 1, .value = 1, .rope = 2 };
+    const q: [3]u16 = @splat(0);
+    var cache: [count * 3]u16 = @splat(0);
+    cache[0] = bf.bits(wide);
+    cache[3] = bf.bits(1);
+    cache[6] = bf.bits(-wide);
+    const w = [_]u16{ 0, bf.bits(1) };
+    const gate = [_]u16{0};
+    const sink = [_]f32{0};
+    const bytes = try ops.scratchBytes(shape);
+    var b: ops.MlaAttend = .{
+        .absorbed_q = try r.input(std.mem.asBytes(&q)),
+        .cache = try r.input(std.mem.asBytes(&cache)),
+        .kv_b = try r.input(std.mem.asBytes(&w)),
+        .gate = try r.input(std.mem.asBytes(&gate)),
+        .sinks = try r.input(std.mem.asBytes(&sink)),
+        .scratch = try r.scratch(bytes),
+        .scratch_bytes = bytes,
+        .output = try r.output(2),
+    };
+    try ops.mlaAttend(k, r.s, shape, b);
+    // 2,048 keys and one zero-logit sink. The probability rounds to 1/2048.
+    const prob = bf.round32(1.0 / 2049.0);
+    try expect(prob, @as(f32, @bitCast(std.mem.readInt(u32, (try r.bytes(b.scratch, 4))[0..4], .little))));
+    try expect(bf.bits(prob * 0.5), std.mem.readInt(u16, (try r.bytes(b.output, 2))[0..2], .little));
+    // Only the finite sink remains. NaNs in unreachable cache rows cannot enter the reduction.
+    const empty: [count]i32 = @splat(-1);
+    b.indices = try r.input(std.mem.asBytes(&empty));
+    b.cache = try r.output(count * 3 * 2);
+    try ops.mlaAttend(k, r.s, shape, b);
+    try expect(@as(u16, 0), std.mem.readInt(u16, (try r.bytes(b.output, 2))[0..2], .little));
+    // With a NaN key in the legal set the reference propagates the NaN.
+    b.indices = 0;
+    try ops.mlaAttend(k, r.s, shape, b);
+    try std.testing.expect(std.math.isNan(bf.value(std.mem.readInt(u16, (try r.bytes(b.output, 2))[0..2], .little))));
+}
diff --git a/zig/kernels/cuda/contract_hy4_range.zig b/zig/kernels/cuda/contract_hy4_range.zig
new file mode 100644
index 0000000000000000000000000000000000000000..cda50526566d812aab2be31b654b429c65509393
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_range.zig
@@ -0,0 +1,173 @@
+//! A decoded trellis and scalar FP32 H128/dot/H128 reference a planted down projection.
+const std = @import("std");
+const cuda = @import("cuda");
+const fmt = @import("core").exl3_format;
+const bf = @import("bf16_round");
+const Rig = @import("rig").Rig;
+const download = @import("contract_hy4_routed.zig").download;
+const t = std.testing;
+const k = 512;
+const n = 128;
+const rows = 8;
+
+fn transform(v: *[128]f32) void {
+    const in = v.*;
+    for (v, 0..) |*out, i| {
+        var sum: f32 = 0;
+        for (in, 0..) |x, j| sum += if (@popCount(i & j) % 2 == 0) x else -x;
+        out.* = sum * 0.08838834764831845;
+    }
+}
+
+fn reference(x: []const u16, matrix: []const f16, svh: []const f16) [n]f32 {
+    @setFloatMode(.strict);
+    var y: [n]f32 = @splat(0);
+    for (0..k / 128) |block| {
+        var h: [128]f32 = undefined;
+        for (&h, x[block * 128 ..][0..128]) |*v, b| v.* = bf.value(b) * 16;
+        transform(&h);
+        for (h, 0..) |v, i| {
+            for (&y, matrix[(block * 128 + i) * n ..][0..n]) |*d, w| d.* = @mulAdd(f32, v, @as(f32, w), d.*);
+        }
+    }
+    transform(&y);
+    for (&y, svh) |*v, s| v.* *= @as(f32, s);
+    return y;
+}
+
+fn halfBoundary(r: *Rig, short: *cuda.hy4_ops.ShortTrunk, w: cuda.exl3.Weight, a: std.mem.Allocator) !void {
+    const peaks = [_]f32{ 65504, 65512, 65519, 65520, -65520 };
+    var raw: [peaks.len * k]f32 = @splat(0);
+    for (peaks, 0..) |peak, row| {
+        @memcpy(raw[row * k ..][0..5], &[_]f32{ peak, -0.0, 0x1p-24, -0x1p-24, 0x1p-25 });
+    }
+    const rotated = try r.input(std.mem.sliceAsBytes(&raw));
+    const half = try r.output(raw.len * 2);
+    const restore = try r.output(peaks.len * 4);
+    try short.range.prepare(r.s, w, 0, half, .{ .rotated = rotated, .partial = 0, .restore = restore }, peaks.len);
+    const scales = try download(r, a, f32, restore, peaks.len);
+    const bits = try download(r, a, u16, half, raw.len);
+    for (peaks, scales, 0..) |peak, scale, row| {
+        try t.expectEqual(@as(f32, if (@abs(peak) < 65520) 1 else 2), scale);
+        for (raw[row * k ..][0..k], bits[row * k ..][0..k]) |v, b| {
+            const want: f16 = @floatCast(v / scale);
+            try t.expectEqual(@as(u16, @bitCast(want)), b);
+        }
+    }
+}
+
+pub fn check(r: *Rig, _: *const cuda.hy4_ops.Kernels) !void {
+    try checkPeaks(r, 100000, 1000000, 1003520, 8192);
+    // Shared SwiGLU maxima from the patched L57..77 forward on two 2048-token BOS rows.
+    try checkPeaks(r, 1510548.9, 64.1, 1515520, 8192); // also test the BF16 neighbor above the observed peak
+    // Four million rounds down in BF16. Exercise the next word above it in both layouts.
+    // Divide the legacy control by a larger power of two so its 128-lane rotation fits FP16.
+    try checkPeaks(r, 4_000_000, 4_014_080, 4_014_080, 32768);
+}
+
+fn checkPeaks(r: *Rig, a_peak: f32, b_peak: f32, mixed_peak: f32, normalization: f32) !void {
+    var short = try cuda.hy4_ops.ShortTrunk.load(r.s.d);
+    defer short.deinit();
+    var dense = try cuda.exl3.Dense.load(r.s.d);
+    defer dense.unload();
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var gen = std.Random.DefaultPrng.init(1776);
+    var x: [rows * k]u16 = @splat(0);
+    const peaks = [_]f32{ a_peak, b_peak, a_peak, b_peak, -b_peak, 0.125, 0, mixed_peak };
+    for (peaks, 0..) |peak, row| {
+        const block = row % (k / 128);
+        const channels: usize = if (row == 2 or row == 3) 128 else 1;
+        for (0..channels) |i| x[row * k + block * 128 + i] = bf.bits(peak);
+    }
+    // Place the ordinary lane in a different K split from the large mixed-row lane.
+    x[7 * k] = bf.bits(20);
+    var small: [rows * k]u16 = undefined;
+    for (&small, x) |*v, raw| v.* = bf.bits(bf.value(raw) / normalization);
+    const xd = try r.input(std.mem.sliceAsBytes(&x));
+    const sd = try r.input(std.mem.sliceAsBytes(&small));
+    const stock = try r.output(rows * n * 4);
+    const result = try r.output(rows * n * 4);
+    const su: [k]f16 = @splat(16);
+    var sv: [n]f16 = undefined;
+    for (&sv) |*v| v.* = @floatCast(0.1 + gen.random().float(f32) * 0.8);
+    const su_d = try r.input(std.mem.sliceAsBytes(&su));
+    const sv_d = try r.input(std.mem.sliceAsBytes(&sv));
+    const enabled = short.enabled;
+    const cases = [_]struct { halves: u32, splits: u32 }{
+        .{ .halves = 6, .splits = 0 },  .{ .halves = 8, .splits = 0 },
+        .{ .halves = 12, .splits = 0 }, .{ .halves = 8, .splits = 2 },
+    };
+    for (cases) |case| {
+        const halves = case.halves;
+        const width: fmt.Width = .{ .halves = @intCast(halves) };
+        const trellis = try a.alloc(i16, (k / 16) * (n / 16) * width.tileWords());
+        gen.random().bytes(std.mem.sliceAsBytes(trellis));
+        const matrix = try a.alloc(f16, k * n);
+        fmt.unpack(width, .mul1, trellis, k / 16, n / 16, matrix);
+        const stride = cuda.exl3.strides(k, n, halves, false);
+        const w: cuda.exl3.Weight = .{ .k = k, .n = n, .halves = halves, .codebook = .mul1, .trellis = try r.input(std.mem.sliceAsBytes(trellis)), .suh = su_d, .svh = sv_d, .stride_k = stride.k, .stride_nb = stride.nb, .sk = case.splits, .wk = 4 };
+        if (halves == 6) try halfBoundary(r, &short, w, a);
+        try dense.decode(r.s, w, sd, .bf16, rows, stock, .f32);
+        const normalized = try download(r, a, f32, stock, rows * n);
+        try dense.decode(r.s, w, xd, .bf16, rows, stock, .f32);
+        const legacy = try download(r, a, f32, stock, rows * n);
+        for ([_]bool{ false, true }) |fast| {
+            if (fast and (halves != 8 or !enabled)) continue;
+            short.enabled = fast;
+            try short.projectRange(&dense, r.s, w, xd, result, .f32, rows);
+            const got = try download(r, a, f32, result, rows * n);
+            const b = try short.range.reserve(r.s, w, rows);
+            // Run a real negative control through the stock MMA with a protected
+            // rotation and omit its final restore, including on the fused short arm.
+            const sc = try dense.groupScratch(r.s, &.{w}, rows);
+            try short.range.prepare(r.s, w, xd, sc.xh, b, rows);
+            try dense.lin.matmulRotated(r.s, w, rows, b.partial, .f32, sc.xh, sc.z, sc.counters);
+            const scales = try download(r, a, f32, b.restore, rows);
+            const dropped = try download(r, a, f32, b.partial, rows * n);
+            // A 129-row prefill crosses both the mid-M path and the 128-row chunk.
+            // Its BF16 outputs must be the same per-row results rounded once.
+            const wide = try a.alloc(u16, 129 * k);
+            for (0..129) |j| @memcpy(wide[j * k ..][0..k], x[(j % rows) * k ..][0..k]);
+            const wide_out = try r.output(129 * n * 2);
+            try short.projectRange(&dense, r.s, w, try r.input(std.mem.sliceAsBytes(wide)), wide_out, .bf16, 129);
+            const words = try download(r, a, u16, wide_out, 129 * n);
+            for (words, 0..) |word, j| try t.expectEqual(bf.bits(got[j % (rows * n)]), word);
+            for (0..rows) |row| {
+                const ref = reference(x[row * k ..][0..k], matrix, &sv);
+                // A single-lane Walsh input spreads over 128 coordinates. A uniform
+                // block puts their entire sum in one coordinate.
+                const channels: f32 = if (row == 2 or row == 3) 128 else 1;
+                const planted = bf.value(bf.bits(peaks[row]));
+                const overflow = @abs(planted) * 16 * channels * 0.08838834764831845 >= 65520;
+                var signal: f32 = 0;
+                var err: f32 = 0;
+                var baseline_err: f32 = 0;
+                var bad_err: f32 = 0;
+                var nonfinite: usize = 0;
+                for (ref, 0..) |want, i| {
+                    const at = row * n + i;
+                    try t.expect(std.math.isFinite(got[at]));
+                    try t.expect(std.math.isFinite(normalized[at]));
+                    signal = @max(signal, @abs(want));
+                    err = @max(err, @abs(got[at] - want));
+                    baseline_err = @max(baseline_err, @abs(normalized[at] * normalization - want));
+                    bad_err = @max(bad_err, @abs(dropped[at] - want));
+                    nonfinite += @intFromBool(!std.math.isFinite(legacy[at]));
+                    if (!overflow) try t.expectEqual(@as(u32, @bitCast(legacy[at])), @as(u32, @bitCast(got[at])));
+                }
+                const denom = @max(signal, 1);
+                if (overflow) {
+                    try t.expect(scales[row] > 1 and nonfinite > 0 and bad_err > 0.45 * signal);
+                } else {
+                    try t.expectEqual(@as(f32, 1), scales[row]);
+                    try t.expectEqual(@as(usize, 0), nonfinite);
+                }
+                // Same packed matrix and rounded BF16 rows, normalized into stock's finite domain.
+                try t.expect(err <= baseline_err + 0.000001 * denom and err < 0.001 * denom);
+                if (row != 5 and row != 6) std.debug.print("range k2={d} sk={d} short={} row={d} input={d} restore={d:.0} rel={d:.8} stock={d:.8} omitted={d:.5} old_nonfinite={d}\n", .{ halves, cuda.exl3.planOf(w).sk, fast, row, planted, scales[row], err / denom, baseline_err / denom, bad_err / denom, nonfinite });
+            }
+        }
+    }
+}
diff --git a/zig/kernels/cuda/contract_hy4_reference.zig b/zig/kernels/cuda/contract_hy4_reference.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ed50d2dad78de08ed8ec271b1bb0ce5a5a46fc8d
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_reference.zig
@@ -0,0 +1,162 @@
+//! Independent scalar arithmetic for each isolated CUDA entry, including its BF16 conversion points.
+const std = @import("std");
+const ct = @import("core").contract;
+const c = ct.spec;
+const bf = @import("bf16_round");
+pub const Kind = enum { collapse, write, project_q, cache_k, scores, softmax, context, gated_value, index_linear, index_prepare, index_scores, index_select, expert_partial, rank_fold };
+
+fn sizes(k: Kind) [2]c.Shape {
+    const dims: [4]usize = switch (k) {
+        .collapse, .write => .{ 6144, 4 * 6144, 32, 128 },
+        .project_q => .{ 512, 192, 8, 10 },
+        .cache_k => .{ 512, 512, 8, 8 },
+        .scores => .{ 1, 576, 1, 14 },
+        .softmax => .{ 2048, 2048, 16, 16 },
+        .context => .{ 512, 2048, 8, 16 },
+        .gated_value => .{ 256, 512, 16, 8 },
+        .index_linear => .{ 32, 6144, 4, 32 },
+        .index_prepare => .{ 128, 128, 16, 16 },
+        .index_scores => .{ 1, 128, 1, 16 },
+        .index_select => .{ 2048, 2048, 16, 48 },
+        .expert_partial => .{ 6144, 2, 128, 2 },
+        .rank_fold => .{ 6144, 4, 128, 4 },
+    };
+    return .{ .{ .rows = 1, .n = dims[0], .k = dims[1] }, .{ .rows = 16, .n = dims[2], .k = dims[3] } };
+}
+
+fn depth(s: c.Shape) usize {
+    return s.k + 8;
+}
+
+pub fn spec(comptime kind: Kind, comptime control: bool) c.Spec {
+    const Sizes = struct {
+        const served = sizes(kind);
+    };
+    const nonlin = kind == .softmax or kind == .cache_k or kind == .collapse or kind == .index_prepare;
+    return .{
+        .name = (if (control) "control: full Hy4 " else "cuda full Hy4 ") ++ @tagName(kind),
+        .served = &Sizes.served,
+        .tiles = .{ .{ .size = 1 }, .{}, .{} },
+        .accum = if (kind == .write or kind == .index_select) .none else .f32,
+        .out = switch (kind) {
+            .softmax, .context, .scores, .index_linear, .index_scores, .expert_partial => .f32,
+            .index_select => .raw,
+            else => .bf16,
+        },
+        .store = if (kind == .scores or kind == .softmax) .bf16 else null,
+        .nan = if (kind == .index_select) .{ .stated = "positive NaN ranks ahead of infinity; equal scores retain earlier positions" } else .propagate,
+        .depth = depth,
+        .ops = 8,
+        .in_place = kind == .softmax or kind == .write or kind == .expert_partial,
+        .sums = if (kind == .expert_partial or kind == .rank_fold) .{ .f16 = 0, .bf16 = 0, .why = "two or four terms; the rank-order cancellation control exercises rounding separately", .exact = false } else if (nonlin) .{ .f16 = 0, .bf16 = 0, .why = "the normalized or gated BF16 output can hide a sum's rounding", .exact = false } else .{},
+    };
+}
+
+pub fn width(kind: Kind, n: usize) usize {
+    return switch (kind) {
+        .write => 4 * n,
+        .project_q, .cache_k => n + 2,
+        else => n,
+    };
+}
+
+pub fn input(x: []u16, s: c.Shape, kind: Kind, fill: ct.gates.Fill, seed: u64) void {
+    // Eight consecutive BF16 words from prompt16 layer.000.streams_in[0,0,0,:8].
+    const fixture = [_]u16{ 48698, 15406, 48795, 48358, 48681, 15761, 15818, 15816 };
+    var prng = std.Random.DefaultPrng.init(seed);
+    for (x, 0..) |*v, i| {
+        v.* = fixture[prng.random().uintLessThan(usize, fixture.len)];
+        if (fill == .stress) {
+            const col = i % s.k;
+            const term: f32 = switch (kind) {
+                .softmax => 0,
+                .cache_k, .collapse, .index_prepare => @floatFromInt(1 + col % 32),
+                else => if (col == 0) 1 else if (col == s.k / 2) 0 else if (col < s.k / 2) 4096 else -4096,
+            };
+            v.* = bf.bits(term);
+        }
+    }
+    if (fill == .nonfinite) {
+        x[0] = bf.bits(std.math.nan(f32));
+        x[s.k] = bf.bits(std.math.inf(f32));
+        x[2 * s.k] = bf.bits(-std.math.inf(f32));
+    }
+}
+
+fn sum(terms: []const f64, acc: ?c.Accum, order: ct.rows.Order) f64 {
+    if (acc) |which| return ct.rows.sumIn(which, order, terms);
+    var v: f64 = 0;
+    for (terms) |term| v += term;
+    return v;
+}
+
+// A single active column pattern keeps even the 2048 x 512 reference exact and small.
+// Other heads and columns are distinguished by the strided and end-to-end fixtures.
+pub fn evaluate(a: std.mem.Allocator, kind: Kind, s: c.Shape, x: []const u16, acc: ?c.Accum, order: ct.rows.Order, out: []f64, mag: ?[]f64) !void {
+    const terms = try a.alloc(f64, s.k + 1);
+    defer a.free(terms);
+    const len = width(kind, s.n);
+    for (0..s.rows) |row| {
+        const words = x[row * s.k ..][0..s.k];
+        const y = out[row * len ..][0..len];
+        var top: f64 = 0;
+        var abs_sum: f64 = 0;
+        for (words, terms[0..s.k]) |w, *p| {
+            p.* = bf.value(w);
+            top = @max(top, p.*);
+            abs_sum += @abs(p.*);
+        }
+        const dot = sum(terms[0..s.k], acc, order);
+        const kn: f64 = @floatFromInt(s.k);
+        switch (kind) {
+            .write => for (y, terms[0..y.len]) |*v, term| {
+                v.* = term + 0.25;
+            },
+            .project_q => {
+                @memset(y[0..s.n], dot);
+                @memset(y[s.n..], 0);
+            },
+            .scores => y[0] = bf.bf16(dot) * (if (s.k == 576) @as(f64, 1.0 / 16.0) else 0.25),
+            .context => @memset(y, dot / (2 * kn)),
+            .index_linear, .rank_fold, .expert_partial => @memset(y, dot),
+            .index_scores => y[0] = (if (dot < 0) 0 else dot) / @sqrt(kn),
+            .index_select => unreachable, // the raw-ID gate uses a stable scalar sort
+            .index_prepare => {
+                const mean = dot / kn;
+                for (terms[0..s.k]) |*v| v.* = (v.* - mean) * (v.* - mean);
+                const inv = 1 / @sqrt(sum(terms[0..s.k], acc, order) / kn + 1e-5);
+                for (words, y) |word, *v| v.* = bf.bf16((bf.value(word) - mean) * inv * 0.75 + 0.125);
+                const left = y[y.len - 2];
+                const right = y[y.len - 1];
+                const pos: f64 = @floatFromInt(row);
+                const co = bf.bf16(@cos(pos));
+                const si = bf.bf16(@sin(pos));
+                y[y.len - 2] = left * co - right * si;
+                y[y.len - 1] = right * co + left * si;
+            },
+            .gated_value => @memset(y, bf.bf16(dot) * 0.5),
+            .cache_k, .collapse => {
+                for (terms[0..s.k]) |*v| v.* *= v.*;
+                const inv = 1 / @sqrt(sum(terms[0..s.k], acc, order) / kn + 1e-5);
+                if (kind == .cache_k) {
+                    for (words, y[0..s.n]) |v, *dst| dst.* = bf.bf16(bf.value(v) * inv) * 0.75;
+                    @memset(y[s.n..], 0);
+                } else {
+                    const pre = 1 / (1 + @exp(-dot * inv / kn)) + 1e-6;
+                    for (y, 0..) |*dst, i| {
+                        var parts: [4]f64 = undefined;
+                        for (&parts, 0..) |*p, j| p.* = pre * bf.value(words[j * s.n + i]);
+                        dst.* = sum(&parts, acc, order);
+                    }
+                }
+            },
+            .softmax => {
+                for (terms[0..s.k]) |*v| v.* = @exp(v.* - top);
+                terms[s.k] = @exp(-top); // The sink's logit is zero.
+                const mass = sum(terms, acc, order);
+                for (terms[0..s.k], y) |v, *dst| dst.* = v / mass;
+            },
+        }
+        if (mag) |m| @memset(m[row * len ..][0..len], abs_sum);
+    }
+}
