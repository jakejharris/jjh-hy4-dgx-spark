+    fast_indexer: bool,
+    prefill_ar: PrefillAr,
+    min_prefill_rows: u32,
+    router: RouteRows,
+    glue: MoeGlue,
+    experts: exl3.Experts,
+    plan_module: Module,
+    planner: grouped.Router,
+    expert_partial: Function,
+    rank_fold: Function,
+    f32_to_bf16: Function,
+    greedy: Function,
+    greedy_top2: Function,
+    collapse: Function,
+    collapse_fast: Function,
+    ihc_partials: Function,
+    ihc_norm: Function,
+    ihc_read: Function,
+    head_bf16: Function,
+    write: Function,
+    write_fast: Function,
+    attn_front: Function,
+    project_q: Function,
+    project_q_tc: Function,
+    cache_k: Function,
+    scores: Function,
+    softmax: Function,
+    merge_sink: Function,
+    context: Function,
+    context_group: Function,
+    compact_indices: Function,
+    mla_chunks_wide: Function,
+    gated_value: Function,
+    gated_value_rows: Function,
+    gated_value_tc: Function,
+    index_linear: Function,
+    index_prepare: Function,
+    index_scores: Function,
+    index_scores_rows: Function,
+    index_scores_tc: Function,
+    index_select: Function,
+
+    pub fn load(d: *const Driver) !Kernels {
+        if (!blobs.available) return error.BuiltWithoutKernels;
+        var result: Kernels = undefined;
+        const sw = try PrefillSwitches.fromProcess();
+        result.fast_prefill = sw.fast_prefill;
+        result.fast_routed = sw.fast_routed;
+        result.fast_mla = sw.fast_mla;
+        result.fast_indexer = sw.fast_indexer;
+        result.prefill_ar = sw.prefill_ar;
+        result.min_prefill_rows = sw.min_prefill_rows;
+        var loaded: usize = 0;
+        errdefer for (result.images[0..loaded]) |*image| image.unload();
+        for ([_][]const u8{ blobs.full_hy4_ihc, blobs.full_hy4_mla_project, blobs.full_hy4_mla_attention, blobs.full_hy4_attention_sink, blobs.full_hy4_token_indexer }) |blob| {
+            result.images[loaded] = try Module.load(d, blob);
+            loaded += 1;
+        }
+        result.collapse = try result.images[0].function("tf_full_hy4_ihc_collapse");
+        result.collapse_fast = try result.images[0].function("tf_full_hy4_ihc_collapse_fast");
+        result.write = try result.images[0].function("tf_full_hy4_ihc_add");
+        result.write_fast = try result.images[0].function("tf_full_hy4_ihc_add_fast");
+        inline for (.{ "expert_partial", "rank_fold", "f32_to_bf16", "greedy", "greedy_top2", "ihc_partials", "ihc_norm", "ihc_read", "head_bf16" }) |name| @field(result, name) = try result.images[0].function("tf_full_hy4_" ++ name);
+        inline for (.{ "attn_front", "project_q", "project_q_tc", "cache_k", "gated_value", "gated_value_rows", "gated_value_tc" }) |name| @field(result, name) = try result.images[1].function("tf_full_hy4_" ++ name);
+        inline for (.{ "scores", "context", "context_group", "compact_indices", "mla_chunks_wide" }) |name| @field(result, name) = try result.images[2].function("tf_full_hy4_" ++ name);
+        try result.mla_chunks_wide.allowDynamicShared(mla_wide_smem);
+        result.softmax = try result.images[3].function("tf_full_hy4_softmax");
+        result.merge_sink = try result.images[3].function("tf_full_hy4_merge_sink");
+        inline for (.{ "index_linear", "index_prepare", "index_scores", "index_scores_rows", "index_scores_tc", "index_select" }) |name| @field(result, name) = try result.images[4].function("tf_full_hy4_" ++ name);
+        result.router = try RouteRows.load(d);
+        errdefer result.router.unload();
+        result.glue = try MoeGlue.load(d);
+        errdefer result.glue.unload();
+        result.plan_module = try Module.load(d, blobs.experts);
+        errdefer result.plan_module.unload();
+        result.planner = try grouped.Router.resolve(result.plan_module);
+        result.experts = try exl3.Experts.load(d);
+        errdefer result.experts.unload();
+        result.short_route = try @import("hy4_routed.zig").Fast.load(d);
+        if (result.short_route) |fast| result.experts.wide_grouped = fast.grouped;
+        return result;
+    }
+    pub fn deinit(self: *Kernels) void {
+        if (self.short_route) |*fast| fast.deinit();
+        self.plan_module.unload();
+        self.experts.unload();
+        self.glue.unload();
+        self.router.unload();
+        for (&self.images) |*image| image.unload();
+        self.* = undefined;
+    }
+};
diff --git a/zig/src/cuda/hy4_ops.zig b/zig/src/cuda/hy4_ops.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9b003d8287781bdb4ad3d099764533b470938b3f
--- /dev/null
+++ b/zig/src/cuda/hy4_ops.zig
@@ -0,0 +1,809 @@
+//! Full Hy4 text CUDA ABI. Load Kernels once per context. All pointers and
+//! scratch are borrowed device addresses. All strides count elements.
+//! One call covers contiguous positions in ONE sequence and one rank's heads.
+pub const ShortTrunk = @import("hy4_trunk.zig").Short;
+const std = @import("std");
+const Stream = @import("stream.zig").Stream;
+const grouped = @import("grouped.zig");
+const exl3 = @import("exl3_experts.zig");
+const launch = @import("launch.zig");
+const Function = @import("module.zig").Function;
+
+pub const Kernels = @import("hy4_kernels.zig").Kernels;
+
+/// Four BF16 streams per row. A zero stride requests tight packing.
+/// The collapsed/branch row stride is hidden_stride. Post gates are packed FP32 [rows,4].
+pub const IhcShape = extern struct {
+    rows: u32,
+    width: u32 = 6144,
+    streams_row_stride: u32 = 0,
+    stream_stride: u32 = 0,
+    hidden_stride: u32 = 0,
+    rms_eps: f32 = 1e-5,
+    hc_eps: f32 = 1e-6,
+    magnitude: f32 = 2,
+};
+
+/// FP32 fn [gates,4*width], base [gates], scale [gates/4]. Read has 8 gates, head has 4.
+pub const IhcRead = struct { streams: u64, projection: u64, base: u64, scale: u64, output: u64, post: u64 = 0 };
+/// BF16 branch [rows,width]. Output may alias residual exactly.
+pub const IhcWrite = struct { residual: u64, branch: u64, post: u64, output: u64 };
+
+fn run(f: Function, stream: Stream, grid: launch.Dim3, threads: u32, values: anytype) !void {
+    var args: launch.Args = .{};
+    inline for (values) |v| args.add(v);
+    try launch.launch(f, .{ .grid = grid, .block = .{ .x = threads } }, stream, &args);
+}
+
+fn runShared(f: Function, stream: Stream, grid: launch.Dim3, threads: u32, shared: u32, values: anytype) !void {
+    var args: launch.Args = .{};
+    inline for (values) |v| args.add(v);
+    try launch.launch(f, .{ .grid = grid, .block = .{ .x = threads }, .shared = shared }, stream, &args);
+}
+
+fn stride(explicit: u32, required: u32) !u32 {
+    if (explicit == 0) return required;
+    if (explicit < required) return error.BadHy4Stride;
+    return explicit;
+}
+
+// The last head/stream needs only its live elements. Callers may omit
+// trailing padding from an explicit row pitch.
+fn rowStride(explicit: u32, count: u32, pitch: u32, width: u32) !u32 {
+    if (explicit == 0) return std.math.mul(u32, count, pitch);
+    return stride(explicit, try std.math.add(u32, try std.math.mul(u32, count - 1, pitch), width));
+}
+
+fn validIhc(shape: IhcShape) !IhcShape {
+    var a = shape;
+    if (a.rows == 0 or a.rows > std.math.maxInt(i32) or a.width == 0 or a.width > 8192 or
+        !std.math.isFinite(a.rms_eps) or a.rms_eps <= 0 or
+        !std.math.isFinite(a.hc_eps) or a.hc_eps < 0 or
+        !std.math.isFinite(a.magnitude) or a.magnitude < 0) return error.BadHy4IhcShape;
+    a.stream_stride = try stride(a.stream_stride, a.width);
+    a.streams_row_stride = try rowStride(a.streams_row_stride, 4, a.stream_stride, a.width);
+    a.hidden_stride = try stride(a.hidden_stride, a.width);
+    return a;
+}
+
+fn pointers(values: anytype) !void {
+    inline for (values) |p| if (p == 0) return error.MissingHy4Buffer;
+}
+
+fn collapse(k: *const Kernels, stream: Stream, shape: IhcShape, b: IhcRead, gates: u32) !void {
+    const a = try validIhc(shape);
+    try pointers(.{ b.streams, b.projection, b.base, b.scale, b.output });
+    if (k.fast_prefill and a.rows >= k.min_prefill_rows and gates == 8 and a.width == 6144 and a.stream_stride == 6144 and
+        a.streams_row_stride == 24576 and a.hidden_stride == 6144 and (b.streams | b.output) % 8 == 0 and b.projection % 16 == 0)
+    {
+        return run(k.collapse_fast, stream, .{ .x = (a.rows + 3) / 4 }, 256, .{ b.streams, b.projection, b.base, b.scale, b.output, b.post, a });
+    }
+    try run(k.collapse, stream, .{ .x = a.rows }, 256, .{ b.streams, b.projection, b.base, b.scale, b.output, b.post, a, gates });
+}
+
+pub fn ihcRead(k: *const Kernels, stream: Stream, shape: IhcShape, b: IhcRead) !void {
+    try pointers(.{b.post});
+    try collapse(k, stream, shape, b, 8);
+}
+/// Fuse collapse with the rounded hidden RMS norm on short, tightly packed rows.
+pub fn tryIhcReadNorm(k: *const Kernels, stream: Stream, shape: IhcShape, b: IhcRead, weight: u64, normalized: u64, scratch: u64, bytes: usize) !bool {
+    const a = try readNormShape(shape, b, weight, normalized, scratch, bytes) orelse return false;
+    try run(k.ihc_partials, stream, .{ .x = 72, .y = a.rows }, 512, .{ b.streams, b.projection, scratch });
+    try run(k.ihc_norm, stream, .{ .x = a.rows }, 256, .{ b.streams, scratch, b.base, b.scale, weight, b.output, b.post, normalized, a });
+    return true;
+}
+/// tryIhcReadNorm's bytes in one launch. `count` is a dedicated u32 [8], zero
+/// before the first call; each launch leaves it zero again.
+pub fn tryIhcReadOnce(k: *const Kernels, stream: Stream, shape: IhcShape, b: IhcRead, weight: u64, normalized: u64, scratch: u64, bytes: usize, count: u64) !bool {
+    const a = try readNormShape(shape, b, weight, normalized, scratch, bytes) orelse return false;
+    if (count == 0 or count % 4 != 0) return false;
+    try run(k.ihc_read, stream, .{ .x = 72, .y = a.rows }, 512, .{ b.streams, b.projection, scratch, count, b.base, b.scale, weight, b.output, b.post, normalized, a });
+    return true;
+}
+fn readNormShape(shape: IhcShape, b: IhcRead, weight: u64, normalized: u64, scratch: u64, bytes: usize) !?IhcShape {
+    const a = try validIhc(shape);
+    if (a.width != 6144 or a.rows > 8 or a.stream_stride != 6144 or a.streams_row_stride != 24576 or a.hidden_stride != 6144) return null;
+    try pointers(.{ b.streams, b.projection, b.base, b.scale, b.output, b.post, weight, normalized, scratch });
+    if ((b.streams | b.output | weight | normalized) % 16 != 0 or (scratch | b.projection | b.base | b.scale | b.post) % 4 != 0) return null;
+    if (bytes < @as(usize, a.rows) * 72 * 4) return null;
+    return a;
+}
+
+/// FP32 logits [rows,y_stride] from BF16 x [rows,width] and BF16 head rows [n,width], one ascending-k FMA chain each.
+pub fn headBf16(k: *const Kernels, stream: Stream, x: u64, w: u64, y: u64, rows: usize, n: usize, width: usize, y_stride: usize) !void {
+    if (rows == 0 or n == 0 or n > y_stride or width == 0 or width % 64 != 0 or y_stride > std.math.maxInt(u32) or width > std.math.maxInt(u32)) return error.BadHy4HeadShape;
+    try pointers(.{ x, w, y });
+    if ((x | w) % 16 != 0 or y % 4 != 0) return error.BadHy4HeadShape;
+    var r: usize = 0;
+    while (r < rows) : (r += 8) { // rows are independent: eight per launch
+        const part: u32 = @intCast(@min(8, rows - r));
+        try run(k.head_bf16, stream, .{ .x = @intCast((n + 127) / 128) }, 128, .{ x + r * width * 2, w, y + r * y_stride * 4, part, @as(u32, @intCast(n)), @as(u32, @intCast(width)), @as(u32, @intCast(y_stride)) });
+    }
+}
+pub fn ihcHead(k: *const Kernels, stream: Stream, shape: IhcShape, b: IhcRead) !void {
+    try collapse(k, stream, shape, b, 4);
+}
+pub fn ihcWrite(k: *const Kernels, stream: Stream, shape: IhcShape, b: IhcWrite) !void {
+    const a = try validIhc(shape);
+    try pointers(.{ b.residual, b.branch, b.post, b.output });
+    if (k.fast_prefill and a.rows >= k.min_prefill_rows and a.width == 6144 and a.stream_stride == 6144 and
+        a.streams_row_stride == 24576 and a.hidden_stride == 6144 and (b.residual | b.branch | b.output) % 8 == 0 and b.post % 16 == 0)
+    {
+        return run(k.write_fast, stream, .{ .x = a.rows, .y = 6 }, 256, .{ b.residual, b.branch, b.post, b.output, a.rows });
+    }
+    try run(k.write, stream, .{ .x = a.rows, .y = (4 * a.width + 255) / 256 }, 256, .{ b.residual, b.branch, b.post, b.output, a });
+}
+
+/// Zero strides pack inner dimensions tightly. Cache is BF16 [capacity,latent+rope] at first_pos+i.
+/// key_count includes padded slots, or the entire populated dense window.
+/// mlaAttend starts at zero. Use mlaAttendWindow for a shifted origin.
+pub const MlaShape = extern struct {
+    rows: u32,
+    heads: u32,
+    capacity: u32,
+    key_count: u32,
+    first_pos: u32 = 0,
+    latent: u32 = 512,
+    nope: u32 = 192,
+    rope: u32 = 64,
+    value: u32 = 256,
+    q_head_stride: u32 = 0,
+    q_row_stride: u32 = 0,
+    absorbed_head_stride: u32 = 0,
+    absorbed_row_stride: u32 = 0,
+    kv_row_stride: u32 = 0,
+    cache_stride: u32 = 0,
+    value_head_stride: u32 = 0,
+    value_row_stride: u32 = 0,
+    index_row_stride: u32 = 0,
+    theta: f32 = 1e7,
+    rms_eps: f32 = 1e-5,
+};
+
+/// BF16 q_b [rows,heads,nope+rope], kv_a [rows,latent+rope], norm [latent] and original kv_b [heads,nope+value,latent].
+/// Writes absorbed Q [rows,heads,latent+rope] and the normalized, rotated cache.
+pub const MlaProject = struct { q: u64, kv: u64, kv_norm: u64, kv_b: u64, absorbed_q: u64, cache: u64 };
+/// indices are i32 logical cache positions [rows,key_count], unique legal
+/// positions or -1. Future positions are always masked. sinks are FP32 [heads].
+/// gate and output are BF16 [rows,heads,value] with the same strides.
+/// Output includes the sigmoid gate, ready for the caller's o_proj.
+pub const MlaAttend = struct {
+    absorbed_q: u64,
+    cache: u64,
+    kv_b: u64,
+    gate: u64,
+    sinks: u64,
+    indices: u64 = 0,
+    scratch: u64,
+    scratch_bytes: usize,
+    output: u64,
+};
+
+fn validMla(shape: MlaShape) !MlaShape {
+    var a = shape;
+    if (a.rows == 0 or a.heads == 0 or a.heads > 64 or
+        a.latent == 0 or a.latent > 512 or a.nope == 0 or a.nope > 192 or
+        a.rope == 0 or a.rope > 64 or a.rope % 2 != 0 or a.value == 0 or a.value > 256 or
+        a.key_count == 0 or a.key_count > 131072 or a.capacity > std.math.maxInt(i32) or
+        a.first_pos > a.capacity or a.rows > a.capacity - a.first_pos or
+        !std.math.isFinite(a.theta) or a.theta <= 0 or
+        !std.math.isFinite(a.rms_eps) or a.rms_eps <= 0) return error.BadHy4MlaShape;
+    a.q_head_stride = try stride(a.q_head_stride, a.nope + a.rope);
+    a.q_row_stride = try rowStride(a.q_row_stride, a.heads, a.q_head_stride, a.nope + a.rope);
+    a.absorbed_head_stride = try stride(a.absorbed_head_stride, a.latent + a.rope);
+    a.absorbed_row_stride = try rowStride(a.absorbed_row_stride, a.heads, a.absorbed_head_stride, a.latent + a.rope);
+    a.kv_row_stride = try stride(a.kv_row_stride, a.latent + a.rope);
+    a.cache_stride = try stride(a.cache_stride, a.latent + a.rope);
+    a.value_head_stride = try stride(a.value_head_stride, a.value);
+    a.value_row_stride = try rowStride(a.value_row_stride, a.heads, a.value_head_stride, a.value);
+    a.index_row_stride = try stride(a.index_row_stride, a.key_count);
+    return a;
+}
+
+// Bound both query rows and score elements per head independently of history.
+const mla_rows = 64;
+const mla_scores = 131072;
+
+/// Four-byte-aligned FP32 scores and latent. Monotone in rows and key_count.
+pub fn scratchBytes(shape: MlaShape) !usize {
+    const a = try validMla(shape);
+    const rows: usize = @min(a.rows, mla_rows);
+    return (@min(rows * a.key_count, mla_scores) + rows * a.latent) * a.heads * @sizeOf(f32);
+}
+
+const FastMlaLayout = struct {
+    po: usize,
+    pm: usize,
+    pl: usize,
+    tok: usize,
+    cnt: usize,
+    ctx: usize,
+    nch: u32,
+    bytes: usize,
+};
+
+fn fastMlaLayout(rows: usize, heads: usize, max_k: u32) FastMlaLayout {
+    const nch: u32 = @max(@as(u32, 1), (max_k + 511) / 512);
+    var at: usize = 0;
+    const take = struct {
+        fn f(cur: *usize, bytes: usize) usize {
+            const off = cur.*;
+            cur.* = std.mem.alignForward(usize, off + bytes, 256);
+            return off;
+        }
+    }.f;
+    const po = take(&at, @as(usize, nch) * rows * heads * 512 * 4);
+    const pm = take(&at, @as(usize, nch) * rows * heads * 4);
+    const pl = take(&at, @as(usize, nch) * rows * heads * 4);
+    const tok = take(&at, rows * @as(usize, max_k) * 4);
+    const cnt = take(&at, rows * 4);
+    const ctx = take(&at, rows * heads * 512 * 4);
+    return .{ .po = po, .pm = pm, .pl = pl, .tok = tok, .cnt = cnt, .ctx = ctx, .nch = nch, .bytes = at };
+}
+
+pub fn scratchBytesFor(k: *const Kernels, shape: MlaShape) !usize {
+    const base = try scratchBytes(shape);
+    const a = try validMla(shape);
+    if (!k.fast_mla or a.rows < k.min_prefill_rows or a.latent != 512 or a.nope != 192 or a.rope != 64 or a.value != 256 or a.heads % 16 != 0)
+        return base;
+    const tile_n: usize = @min(a.rows, 128);
+    const max_k: u32 = @max(@as(u32, 1), @min(a.key_count, 2048));
+    return @max(base, fastMlaLayout(tile_n, a.heads, max_k).bytes);
+}
+fn mlaProjectImpl(k: *const Kernels, stream: Stream, shape: MlaShape, b: MlaProject, fused: bool) !void {
+    const a = try validMla(shape);
+    try pointers(.{ b.q, b.kv, b.kv_norm, b.kv_b, b.absorbed_q, b.cache });
+    if (fused and a.rows <= 8 and a.latent == 512 and a.nope == 192 and a.rope == 64 and a.value == 256) {
+        const tiles = (a.latent + 127) / 128;
+        try run(k.attn_front, stream, .{ .x = a.heads * tiles + a.rows }, 128, .{
+            b.q,             b.kv,           b.kv_norm,      b.kv_b,          b.absorbed_q,          b.cache,
+            a.heads,         a.rows,         a.q_row_stride, a.q_head_stride, a.absorbed_row_stride, a.absorbed_head_stride,
+            a.kv_row_stride, a.cache_stride, a.latent,       a.nope,          a.rope,                a.value,
+            a.first_pos,     a.theta,        a.rms_eps,
+        });
+        return;
+    }
+    if (fused and k.fast_prefill and a.rows >= k.min_prefill_rows and a.latent == 512 and a.nope == 192 and a.rope == 64 and a.value == 256 and
+        a.absorbed_row_stride % 2 == 0 and a.absorbed_head_stride % 2 == 0 and b.absorbed_q % 4 == 0)
+    {
+        try run(k.project_q_tc, stream, .{ .x = (a.rows + 31) / 32, .y = a.heads, .z = 8 }, 128, .{
+            b.q, b.kv_b, b.absorbed_q, a.rows, a.q_row_stride, a.q_head_stride, a.absorbed_row_stride, a.absorbed_head_stride, a.first_pos, a.theta,
+        });
+        try run(k.cache_k, stream, .{ .x = a.rows }, 128, .{ b.kv, b.kv_norm, b.cache, a.kv_row_stride, a.cache_stride, a.latent, a.rope, a.first_pos, a.theta, a.rms_eps });
+        return;
+    }
+    const tiles: u32 = if (a.rows <= 4) (a.latent + 127) / 128 else 1;
+    try run(k.project_q, stream, .{ .x = a.rows, .y = a.heads, .z = tiles }, 128, .{
+        b.q, b.kv_b, b.absorbed_q, a.q_row_stride, a.q_head_stride, a.absorbed_row_stride, a.absorbed_head_stride, a.latent, a.nope, a.rope, a.value, a.first_pos, a.theta,
+    });
+    try run(k.cache_k, stream, .{ .x = a.rows }, 128, .{ b.kv, b.kv_norm, b.cache, a.kv_row_stride, a.cache_stride, a.latent, a.rope, a.first_pos, a.theta, a.rms_eps });
+}
+pub fn mlaProject(k: *const Kernels, stream: Stream, shape: MlaShape, b: MlaProject) !void { return mlaProjectImpl(k, stream, shape, b, true); }
+/// Exact separate-launch control for contracts and paired measurements.
+pub fn mlaProjectReference(k: *const Kernels, stream: Stream, shape: MlaShape, b: MlaProject) !void { return mlaProjectImpl(k, stream, shape, b, false); }
+pub fn mlaAttend(k: *const Kernels, stream: Stream, shape: MlaShape, b: MlaAttend) !void { return mlaAttendWindow(k, stream, shape, b, 0); }
+
+/// Attend to populated absolute cache rows cache_start..first_pos+row, inclusive.
+/// Dense slots enumerate that interval from cache_start. Sparse IDs stay absolute.
+/// Size scratch with scratchBytes(shape). For decode reuse, size for the largest
+/// key_count and query chunk the caller will use. Cache layout is unchanged.
+pub fn mlaAttendWindow(k: *const Kernels, stream: Stream, shape: MlaShape, b: MlaAttend, cache_start: u32) !void {
+    const a = try validMla(shape);
+    try pointers(.{ b.absorbed_q, b.cache, b.kv_b, b.gate, b.sinks, b.scratch, b.output });
+    const bytes = try scratchBytes(a);
+    if (b.scratch_bytes < bytes or b.scratch % 4 != 0) return error.BadHy4Scratch;
+    _ = try std.math.add(u64, b.scratch, bytes);
+    if (cache_start > a.first_pos) return error.BadHy4MlaShape;
+    if (b.indices == 0 and a.key_count < a.first_pos + a.rows - cache_start) return error.ShortHy4DensePrefix;
+    const tile = @min(mla_rows, mla_scores / a.key_count);
+    const scale: f32 = 1 / @sqrt(@as(f32, @floatFromInt(a.nope + a.rope)));
+    const can_fast_mla = k.fast_mla and a.rows >= k.min_prefill_rows and
+        a.latent == 512 and a.nope == 192 and a.rope == 64 and a.value == 256 and
+        a.heads % 16 == 0 and a.absorbed_head_stride == 576 and a.absorbed_row_stride == a.heads * 576 and
+        a.cache_stride == 576 and (b.absorbed_q | b.cache) % 16 == 0 and b.scratch % 16 == 0 and
+        (b.indices != 0 or a.first_pos + a.rows - cache_start <= 2048);
+    if (can_fast_mla) {
+        const max_k_cap: u32 = @max(@as(u32, 1), @min(if (b.indices == 0) a.first_pos + a.rows - cache_start else a.key_count, 2048));
+        var tile_n: u32 = @min(a.rows, 128);
+        while (tile_n > 16 and fastMlaLayout(tile_n, a.heads, max_k_cap).bytes > b.scratch_bytes) : (tile_n /= 2) {}
+        if (fastMlaLayout(tile_n, a.heads, max_k_cap).bytes <= b.scratch_bytes) {
+            var row: u32 = 0;
+            while (row < a.rows) {
+                const n: u32 = @min(tile_n, a.rows - row);
+                const first = a.first_pos + row;
+                const keys = if (b.indices == 0) first + n - cache_start else a.key_count;
+                const max_k: u32 = @max(@as(u32, 1), @min(keys, 2048));
+                const fl = fastMlaLayout(n, a.heads, max_k);
+                const q = b.absorbed_q + @as(u64, row) * a.absorbed_row_stride * 2;
+                const ids = if (b.indices == 0) 0 else b.indices + @as(u64, row) * a.index_row_stride * 4;
+                const offset = @as(u64, row) * a.value_row_stride * 2;
+                const po = b.scratch + fl.po;
+                const pm = b.scratch + fl.pm;
+                const pl = b.scratch + fl.pl;
+                const tok = b.scratch + fl.tok;
+                const cnt = b.scratch + fl.cnt;
+                const ctx = b.scratch + fl.ctx;
+                try run(k.compact_indices, stream, .{ .x = n }, 256, .{
+                    ids, tok, cnt, n, keys, a.index_row_stride, max_k, first, cache_start,
+                });
+                try runShared(k.mla_chunks_wide, stream, .{ .x = n, .y = a.heads / 16, .z = fl.nch }, 256, @import("hy4_kernels.zig").mla_wide_smem, .{
+                    q, b.cache, tok, cnt, po, pm, pl, @as(i64, n), @as(i64, a.heads), @as(i64, max_k), scale,
+                });
+                try run(k.merge_sink, stream, .{ .x = n, .y = a.heads }, 128, .{
+                    po, pm, pl, b.sinks, ctx, n, a.heads, fl.nch,
+                });
+                if (n >= 16) {
+                    try run(k.gated_value_tc, stream, .{ .x = (n + 31) / 32, .y = a.heads, .z = 4 }, 128, .{
+                        ctx, b.kv_b, b.gate + offset, b.output + offset, n, a.heads, a.value_row_stride, a.value_head_stride,
+                    });
+                } else {
+                    const inputs = .{ ctx, b.kv_b, b.gate + offset, b.output + offset, a.heads };
+                    const strides = .{ a.nope, a.value, a.value_row_stride, a.value_head_stride };
+                    try run(k.gated_value, stream, .{ .x = n, .y = a.heads, .z = a.value }, 128, inputs ++ .{a.latent} ++ strides);
+                }
+                row += n;
+            }
+            return;
+        }
+    }
+    var row: u32 = 0;
+    while (row < a.rows) {
+        const n = @min(tile, a.rows - row);
+        const first = a.first_pos + row;
+        const keys = if (b.indices == 0) first + n - cache_start else a.key_count;
+        const q = b.absorbed_q + @as(u64, row) * a.absorbed_row_stride * 2;
+        const ids = if (b.indices == 0) 0 else b.indices + @as(u64, row) * a.index_row_stride * 4;
+        const offset = @as(u64, row) * a.value_row_stride * 2;
+        const ctx = b.scratch + @as(u64, n) * a.heads * keys * 4;
+        const score_heads = if ((n > 1 or keys >= 512) and a.latent + a.rope == 576 and a.heads % 16 == 0) a.heads / 16 else a.heads;
+        const slots: u32 = if (n == 1 and score_heads < a.heads) (if (keys >= 2048) 16 else 8) else 32;
+        try run(k.scores, stream, .{ .x = n, .y = score_heads, .z = (keys + slots - 1) / slots }, 128, .{
+            q, b.cache, ids, b.scratch, a.heads, a.latent + a.rope, a.absorbed_row_stride, a.absorbed_head_stride, a.cache_stride, a.index_row_stride, keys, first, scale, cache_start,
+        });
+        try run(k.softmax, stream, .{ .x = n, .y = a.heads }, 128, .{ b.scratch, b.sinks, a.heads, keys });
+        const threads: u32 = if (n == 1 or (n <= 16 and a.latent == 512)) 32 else 128;
+        const checkpoint = a.latent == 512 and a.heads % 16 == 0;
+        const group: u32 = if (!checkpoint) 1 else if (threads == 128) 16 else switch (n * a.heads) {
+            0...64 => 1, 65...128 => if (keys <= 512) 4 else 2, else => 4,
+        };
+        const context = if (group == 2 or group == 4) k.context_group else k.context;
+        try run(context, stream, .{ .x = n, .y = a.heads / group, .z = (a.latent + threads - 1) / threads }, threads, .{ b.scratch, b.cache, ids, ctx, a.heads, a.latent, a.cache_stride, a.index_row_stride, keys, first, cache_start });
+        const inputs = .{ ctx, b.kv_b, b.gate + offset, b.output + offset, a.heads };
+        const strides = .{ a.nope, a.value, a.value_row_stride, a.value_head_stride };
+        if (k.fast_prefill and a.rows >= k.min_prefill_rows and n >= 16 and a.latent == 512 and a.nope == 192 and a.value == 256)
+            try run(k.gated_value_tc, stream, .{ .x = (n + 31) / 32, .y = a.heads, .z = 4 }, 128, .{ ctx, b.kv_b, b.gate + offset, b.output + offset, n, a.heads, a.value_row_stride, a.value_head_stride })
+        else if (n <= 8 and a.latent == 512 and a.value % 8 == 0)
+            try run(k.gated_value_rows, stream, .{ .x = 1, .y = a.heads, .z = a.value / 8 }, 128, inputs ++ strides ++ .{n})
+        else
+            try run(k.gated_value, stream, .{ .x = n, .y = a.heads, .z = a.value }, 128, inputs ++ .{a.latent} ++ strides);
+        row += n;
+    }
+}
+
+pub const IndexShape = struct {
+    rows: u32,
+    first_pos: u32,
+    capacity: u32,
+    top_k: u32 = 2048,
+    width: u32 = 6144,
+    q_rank: u32 = 2048,
+    heads: u32 = 32,
+    dim: u32 = 128,
+    rope: u32 = 64,
+    x_row_stride: u32,
+    q_row_stride: u32,
+    cache_stride: u32,
+    indices_stride: u32,
+    theta: f32 = 1e7,
+    norm_eps: f32 = 1e-5,
+};
+/// q_resid, x, wq_b, wk and cache are BF16. k_norm weight/bias and weights_proj
+/// are FP32. Output is ascending i32 positions per row with unused slots -1.
+pub const IndexBuffers = struct {
+    q_resid: u64,
+    x: u64,
+    wq_b: u64,
+    wk: u64,
+    k_norm: u64,
+    k_bias: u64,
+    weights_proj: u64,
+    cache: u64,
+    indices: u64,
+    scratch: u64,
+    scratch_bytes: usize,
+};
+const index_rows = 64;
+const index_rows_fast = 256;
+const index_page = 2048;
+
+const IndexLayout = struct { raw: usize, query: usize, weights: usize, scores: usize, picks: usize, bytes: usize, pitch: u32, tile_rows: u32 };
+
+fn indexLayoutMode(a: IndexShape, cache_start: u32, wide: bool, fast_tc: bool) !IndexLayout {
+    if (a.rows == 0 or cache_start > a.first_pos or a.first_pos >= a.capacity or a.rows > a.capacity - a.first_pos or
+        a.capacity > std.math.maxInt(i32) or a.top_k == 0 or a.top_k > index_page or
+        a.width == 0 or a.width > 6144 or a.q_rank == 0 or a.q_rank > 2048 or
+        a.heads == 0 or a.heads > 32 or a.dim == 0 or a.dim > 128 or
+        a.rope == 0 or a.rope > a.dim or a.rope % 2 != 0 or
+        !std.math.isFinite(a.theta) or a.theta <= 0 or !std.math.isFinite(a.norm_eps) or a.norm_eps <= 0)
+        return error.BadHy4IndexShape;
+    _ = try stride(a.x_row_stride, a.width);
+    _ = try stride(a.q_row_stride, a.q_rank);
+    _ = try stride(a.cache_stride, a.dim);
+    _ = try stride(a.indices_stride, a.top_k);
+    const row_cap: u32 = if (fast_tc) index_rows_fast else index_rows;
+    const rows: usize = @min(a.rows, row_cap);
+    const q_len = rows * a.heads * a.dim;
+    const query = std.mem.alignForward(usize, q_len * 4, 16);
+    const weights = std.mem.alignForward(usize, query + q_len * 2, 16);
+    const scores = std.mem.alignForward(usize, weights + rows * a.heads * 4, 16);
+    const span = a.first_pos + a.rows - cache_start;
+    const page: u32 = if (fast_tc and span >= 8192) 16384 else if (wide and span >= 8192) 8192 else index_page;
+    const pitch = a.top_k + @min(page, a.capacity);
+    const picks = std.mem.alignForward(usize, scores + rows * pitch * 4, 8);
+    return .{ .raw = 0, .query = query, .weights = weights, .scores = scores, .picks = picks, .pitch = pitch, .tile_rows = @intCast(rows), .bytes = picks + rows * a.top_k * 8 };
+}
+
+fn indexLayout(a: IndexShape, cache_start: u32, wide: bool) !IndexLayout {
+    return indexLayoutMode(a, cache_start, wide, false);
+}
+
+/// Minimum workspace for up to 64 queries and 2,048 new keys plus the retained top K.
+pub fn indexScratchBytes(shape: IndexShape) !usize {
+    return (try indexLayout(shape, 0, false)).bytes;
+}
+
+/// Preferred workspace includes one 8K score page per live query for long populated windows.
+pub fn indexWindowScratchBytes(shape: IndexShape, cache_start: u32) !usize {
+    return (try indexLayout(shape, cache_start, true)).bytes;
+}
+
+/// Kernel-aware workspace sizing (uses 256-row tiles + 16K score pages when TF_HY4_FAST_INDEXER is active).
+pub fn indexWindowScratchBytesFor(k: *const Kernels, shape: IndexShape, cache_start: u32) !usize {
+    const use_fast = k.fast_indexer and shape.rows >= k.min_prefill_rows and shape.heads == 32 and shape.dim == 128;
+    return (try indexLayoutMode(shape, cache_start, true, use_fast)).bytes;
+}
+
+fn indexLinear(k: *const Kernels, s: Stream, x: u64, w: u64, out: u64, pitch: u32, width: u32, columns: u32, rows: u32, fp32_weight: bool) !void {
+    if (!fp32_weight and width % 16 == 0 and pitch % 8 == 0 and pitch <= std.math.maxInt(i32) and
+        (x | w) % 16 == 0) return k.router.logits(s, x, pitch, w, out, rows, width, columns);
+    const tile: u32 = if (!fp32_weight and width % 16 == 0) 32 else 4;
+    try run(k.index_linear, s, .{ .x = (columns + tile - 1) / tile, .y = rows }, 128, .{ x, w, out, pitch, width, columns, @as(u32, @intFromBool(fp32_weight)) });
+}
+
+pub fn selectTokens(k: *const Kernels, stream: Stream, shape: IndexShape, b: IndexBuffers) !void {
+    return selectTokensWindow(k, stream, shape, b, 0);
+}
+
+/// The populated key interval begins at cache_start. Positions and cache rows
+/// are absolute. A cold shifted replay sets cache_start to shape.first_pos.
+pub fn selectTokensWindow(k: *const Kernels, stream: Stream, shape: IndexShape, b: IndexBuffers, cache_start: u32) !void {
+    const want_tc = k.fast_indexer and shape.rows >= k.min_prefill_rows and shape.heads == 32 and shape.dim == 128;
+    var layout = try indexLayoutMode(shape, cache_start, true, want_tc);
+    if (b.scratch_bytes < layout.bytes) layout = try indexLayout(shape, cache_start, true);
+    if (b.scratch_bytes < layout.bytes) layout = try indexLayout(shape, cache_start, false);
+    try pointers(.{ b.q_resid, b.x, b.wq_b, b.wk, b.k_norm, b.k_bias, b.weights_proj, b.cache, b.indices, b.scratch });
+    if (b.scratch % 8 != 0 or b.scratch_bytes < layout.bytes) return error.BadHy4Scratch;
+    if ((b.q_resid | b.x | b.wq_b | b.wk | b.cache) % 2 != 0 or (b.k_norm | b.k_bias | b.weights_proj | b.indices) % 4 != 0)
+        return error.BadHy4IndexShape;
+    const x_pitch = try stride(shape.x_row_stride, shape.width);
+    const q_pitch = try stride(shape.q_row_stride, shape.q_rank);
+    const cache_pitch = try stride(shape.cache_stride, shape.dim);
+    const id_pitch = try stride(shape.indices_stride, shape.top_k);
+    // Validate byte spans once, before enqueuing any writes.
+    inline for (.{ .{ b.x, shape.rows, x_pitch, shape.width, 2 }, .{ b.q_resid, shape.rows, q_pitch, shape.q_rank, 2 }, .{ b.cache, shape.first_pos + shape.rows, cache_pitch, shape.dim, 2 }, .{ b.indices, shape.rows, id_pitch, shape.top_k, 4 } }) |v| {
+        const elements = @as(u64, v[1] - 1) * v[2] + v[3];
+        _ = try std.math.add(u64, v[0], try std.math.mul(u64, elements, v[4]));
+    }
+    _ = try std.math.add(u64, b.scratch, layout.bytes);
+    const raw = b.scratch + layout.raw;
+    const q = b.scratch + layout.query;
+    const w = b.scratch + layout.weights;
+    const scores = b.scratch + layout.scores;
+    const picks = b.scratch + layout.picks;
+    const cols = shape.heads * shape.dim;
+    const use_tc_scores = want_tc and cache_pitch % 8 == 0 and (b.cache | q) % 16 == 0;
+    var row: u32 = 0;
+    while (row < shape.rows) {
+        const rows: u32 = @min(layout.tile_rows, shape.rows - row);
+        const first = shape.first_pos + row;
+        const end = first + rows;
+        const x = b.x + @as(u64, row) * x_pitch * 2;
+        const cache = b.cache + @as(u64, first) * cache_pitch * 2;
+        const ids = b.indices + @as(u64, row) * id_pitch * 4;
+        try indexLinear(k, stream, x, b.wk, raw, x_pitch, shape.width, shape.dim, rows, false);
+        try run(k.index_prepare, stream, .{ .x = rows }, 128, .{ raw, b.k_norm, b.k_bias, cache, @as(u32, 1), shape.dim, shape.rope, cache_pitch, first, shape.theta, shape.norm_eps });
+        const prune = end - cache_start > shape.top_k;
+        if (prune) {
+            const resid = b.q_resid + @as(u64, row) * q_pitch * 2;
+            try indexLinear(k, stream, resid, b.wq_b, raw, q_pitch, shape.q_rank, cols, rows, false);
+            try run(k.index_prepare, stream, .{ .x = rows, .y = shape.heads }, 128, .{ raw, @as(u64, 0), @as(u64, 0), q, shape.heads, shape.dim, shape.rope, cols, first, shape.theta, shape.norm_eps });
+            try indexLinear(k, stream, x, b.weights_proj, w, x_pitch, shape.width, shape.heads, rows, true);
+        }
+        var page = cache_start;
+        while (page < end) {
+            const count: u32 = @min(layout.pitch - shape.top_k, end - page);
+            const block_keys: u32 = if (shape.heads == 32 and shape.dim == 128 and count >= 16) 16 else 4;
+            if (prune and use_tc_scores) {
+                try run(k.index_scores_tc, stream, .{ .x = (count + 31) / 32, .y = (rows + 15) / 16 }, 128, .{
+                    q, b.cache, w, scores, cache_pitch, layout.pitch, first, cache_start, page, count, shape.top_k, rows,
+                });
+            } else if (block_keys == 16 and prune and rows >= 2 and rows <= 16) {
+                const warps: u32 = if (rows <= 2) 2 else if (rows <= 4) 4 else 8;
+                try run(k.index_scores_rows, stream, .{ .x = (count + 7) / 8, .y = (rows + warps - 1) / warps }, warps * 32, .{
+                    q, b.cache, w, scores, cache_pitch, layout.pitch, first, cache_start, page, count, shape.top_k, rows,
+                });
+            } else if (prune) try run(k.index_scores, stream, .{ .x = (count + block_keys - 1) / block_keys, .y = rows }, if (block_keys == 16) 64 else 128, .{ q, b.cache, w, scores, shape.heads, shape.dim, cache_pitch, layout.pitch, first, cache_start, page, count, shape.top_k });
+            try run(k.index_select, stream, .{ .x = rows }, 256, .{ scores, picks, ids, layout.pitch, id_pitch, first, cache_start, page, count, shape.top_k });
+            page += count;
+        }
+        row += rows;
+    }
+}
+
+pub const RoutedShape = struct {
+    rows: u32,
+    top_k: u32 = 8,
+    x_row_stride: u32,
+    output_row_stride: u32,
+    route_scale: f32 = 2.827,
+};
+/// x BF16; router rows BF16 [E,D], choice-only bias FP32 [E].
+/// ids i32 and weights FP32 [rows,top_k] are caller-owned outputs.
+/// output FP32 [rows,dims] is the rank partial before shared expert addition.
+/// Layer supplies mul1 per-projection half bits, model/rank widths and clamp.
+pub const RoutedBuffers = struct {
+    layer: exl3.Layer,
+    x: u64,
+    router: u64,
+    correction_bias: u64,
+    ids: u64,
+    weights: u64,
+    output: u64,
+    scratch: u64,
+    scratch_bytes: usize,
+};
+const routed_chunk = 1024;
+const routed_prefill_chunk = 2048;
+
+fn align256(n: usize) usize {
+    return (n + 255) / 256 * 256;
+}
+
+fn usePrefillWide(k: *const Kernels, shape: RoutedShape, layer: exl3.Layer) bool {
+    return k.fast_routed and k.short_route != null and layer.wide and shape.rows >= k.min_prefill_rows and shape.top_k == 8;
+}
+
+const PrefillWideWork = struct {
+    xg: u64,
+    xu: u64,
+    xd: u64,
+    y_bf16: u64,
+    plan: grouped.Plan,
+    n_items: u32,
+    bytes: usize,
+};
+
+fn prefillWideWork(base: u64, layer: exl3.Layer, rows: usize, slots: usize) PrefillWideWork {
+    const p = rows * slots;
+    const e = layer.experts;
+    const n_items = grouped.maxItems(p, e, 64);
+    var at = base;
+    const take = struct {
+        fn f(a: *u64, bytes: usize) u64 {
+            const r = a.*;
+            a.* = r + align256(bytes);
+            return r;
+        }
+    }.f;
+    const xg = take(&at, p * layer.dims * 2);
+    const xu = take(&at, p * layer.dims * 2);
+    const xd = take(&at, p * layer.width * 2);
+    const y_bf16 = take(&at, p * layer.dims * 2);
+    const members = take(&at, p * 4);
+    const rank = take(&at, p * 4);
+    const hist = take(&at, ((p + 1023) / 1024) * e * 4);
+    const items = take(&at, n_items * 12);
+    const counts = take(&at, 8);
+    return .{
+        .xg = xg, .xu = xu, .xd = xd, .y_bf16 = y_bf16,
+        .plan = .{ .members = members, .rank = rank, .hist = hist, .items = items, .counts = counts },
+        .n_items = @intCast(n_items),
+        .bytes = @intCast(at - base),
+    };
+}
+
+const RoutedLayout = struct { rows: usize, packed_input: usize, packed_output: usize, expert_scratch: usize, bytes: usize };
+
+fn routedLayoutMode(shape: RoutedShape, layer: exl3.Layer, prefill_wide: bool) !RoutedLayout {
+    if (shape.rows == 0 or shape.top_k == 0 or shape.top_k > 8 or shape.top_k > layer.experts or
+        layer.experts > 256 or layer.dims == 0 or layer.dims > 6144 or layer.dims % 128 != 0 or
+        layer.width == 0 or layer.width > 2048 or layer.width % 128 != 0 or
+        (layer.gu_stride != 0 and (layer.gu_stride < layer.width / 16 or layer.gu_stride > std.math.maxInt(i32))) or
+        layer.codebook != .mul1 or layer.limit != 10 or layer.act_mode != 0 or (layer.wide and !layer.canWiden()) or
+        (layer.uniform_k2 != 0 and layer.uniform_k2 != 6 and layer.uniform_k2 != 8) or
+        !std.math.isFinite(shape.route_scale) or shape.route_scale <= 0) return error.BadHy4Route;
+    _ = try stride(shape.x_row_stride, @intCast(layer.dims));
+    _ = try stride(shape.output_row_stride, @intCast(layer.dims));
+    const chunk_lim: usize = if (prefill_wide) routed_prefill_chunk else routed_chunk;
+    const rows: usize = @min(chunk_lim, shape.rows);
+    const input = std.mem.alignForward(usize, rows * layer.experts * 4, 256);
+    const output = input + rows * layer.dims * 2;
+    const experts = output + if (shape.output_row_stride > layer.dims) rows * layer.dims * 4 else 0;
+    const ex_bytes = if (prefill_wide)
+        prefillWideWork(0, layer, rows, shape.top_k).bytes
+    else
+        try exl3.scratchBytes(layer, rows, shape.top_k);
+    return .{
+        .rows = rows,
+        .packed_input = input,
+        .packed_output = output,
+        .expert_scratch = experts,
+        .bytes = experts + ex_bytes,
+    };
+}
+
+/// Reusable 256-byte-aligned workspace (1,024-row cap; fast prefill uses 2,048 in routedScratchBytesFor).
+pub fn routedScratchBytes(shape: RoutedShape, layer: exl3.Layer) !usize {
+    return (try routedLayoutMode(shape, layer, false)).bytes;
+}
+
+/// Kernel-aware scratch size (uses compact zero-z BM=64 prefill scratch when TF_HY4_FAST_PREFILL=1).
+pub fn routedScratchBytesFor(k: *const Kernels, shape: RoutedShape, layer: exl3.Layer) !usize {
+    return (try routedLayoutMode(shape, layer, usePrefillWide(k, shape, layer))).bytes;
+}
+
+fn copyRoutedRows(s: Stream, dst: u64, dst_pitch: usize, src: u64, src_pitch: usize, width: usize, rows: usize) !void {
+    const copy: @import("abi.zig").Memcpy2D = .{ .src = src, .src_pitch = src_pitch, .dst = dst, .dst_pitch = dst_pitch, .width = width, .height = rows };
+    try s.d.check(s.d.api.cuMemcpy2DAsync_v2(&copy, s.handle), "Hy4 routed row copy");
+}
+
+// Keep the EXL3 projections and epilogues. The plan enumerates live 16-member
+// tiles in place of the rectangular expert-by-all-rows grid.
+fn routedTiles(k: *const Kernels, s: Stream, l: exl3.Layer, x: u64, pitch: usize, ids: u64, weights: u64, out: u64, sc: exl3.Scratch) !void {
+    const rows: u32 = @intCast(sc.rows);
+    const slots: u32 = @intCast(sc.slots);
+    const e: u32 = @intCast(l.experts);
+    const d: u32 = @intCast(l.dims);
+    const w: u32 = @intCast(l.width);
+    const pairs = rows * slots;
+    const items: u32 = @intCast(grouped.maxItems(pairs, e, 16));
+    const rank = pairs * 4;
+    const hist = rank + pairs * 4;
+    const desc = hist + ((pairs + 1023) / 1024) * e * 4;
+    const counts = desc + items * 12;
+    if (counts + 8 > @min(pairs, e) * rows * 4) return k.experts.run(s, l, x, pitch, .bf16, ids, weights, rows, out, sc);
+    const plan: grouped.Plan = .{ .members = sc.members, .rank = sc.members + rank, .hist = sc.members + hist, .items = sc.members + desc, .counts = sc.members + counts };
+    try k.planner.route(s, ids, pairs, e, 16, plan);
+    try run(k.experts.rot_in, s, .{ .x = pairs, .y = d / 128, .z = 2 }, 32, .{ x, @as(u32, @intCast(pitch)), @as(i32, @backingInt(exl3.DType.bf16)), ids, l.suh_g, l.suh_u, sc.xg, sc.xu, d, slots, e });
+    const gu_sk = try exl3.plan(d, w, true);
+    const down_sk = try exl3.plan(w, d, false);
+    inline for (.{ true, false }) |up| {
+        const n = if (up) w else d;
+        const sk = if (up) gu_sk else down_sk;
+        const mats: u32 = if (up) 2 else 1;
+        try run(try k.experts.groupedFunction(l), s, .{ .x = items, .y = n / 128, .z = mats * sk }, if (l.wide) 512 else 128, .{
+            if (up) sc.xg else sc.xd,         if (up) sc.xu else sc.xd,       if (up) l.gate else l.down,                     if (up) l.up else l.down,
+            if (up) l.gate_k2 else l.down_k2, if (up) l.up_k2 else l.down_k2, plan.items,                                     plan.counts,
+            plan.members,                     sc.z,                           if (up) d else w,                               n,
+            pairs,                            sk,                             @as(u32, 16),                                   slots,
+            items,                            mats,                           @as(u32, @intCast(if (up) l.gu_stride else 0)), @as(u32, 1),
+            @as(i32, -1),
+        });
+        if (up) try run(k.experts.gateup, s, .{ .x = pairs, .y = w / 128 }, 32, .{ sc.z, ids, l.svh_g, l.svh_u, l.suh_d, sc.xd, pairs, w, sk, e, l.limit, l.act_mode });
+    }
+    try run(k.experts.down_combine, s, .{ .x = rows, .y = d / 128 }, 32 * slots, .{ sc.z, ids, l.svh_d, sc.y, weights, out, pairs, d, down_sk, e, slots });
+}
+
+/// Router matrix rows are 16-byte aligned. The layer owns device i32 k2 tables
+/// for gate, up and down, with 6 or 8 per expert. All work stays on stream.
+pub fn routedExperts(k: *const Kernels, stream: Stream, shape: RoutedShape, b: RoutedBuffers) !void {
+    const layer = b.layer;
+    const prefill_wide = usePrefillWide(k, shape, layer);
+    const layout = try routedLayoutMode(shape, layer, prefill_wide);
+    try pointers(.{ b.x, b.router, b.correction_bias, b.ids, b.weights, b.output, b.scratch });
+    try pointers(.{ layer.gate, layer.up, layer.down, layer.gate_k2, layer.up_k2, layer.down_k2 });
+    try pointers(.{ layer.suh_g, layer.suh_u, layer.svh_g, layer.svh_u, layer.suh_d, layer.svh_d });
+    if (b.scratch_bytes < layout.bytes or b.scratch % 256 != 0) return error.BadHy4Scratch;
+    if (b.router % 16 != 0 or b.x % 2 != 0 or (b.output | b.weights | b.ids | b.correction_bias) % 4 != 0)
+        return error.BadHy4Route;
+    const input_stride: usize = try stride(shape.x_row_stride, @intCast(layer.dims));
+    const output_stride: usize = try stride(shape.output_row_stride, @intCast(layer.dims));
+    const last: u64 = shape.rows - 1;
+    inline for (.{ .{ b.x, input_stride, 2, layer.dims }, .{ b.output, output_stride, 4, layer.dims }, .{ b.ids, shape.top_k, 4, shape.top_k }, .{ b.weights, shape.top_k, 4, shape.top_k } }) |view| {
+        const elements = try std.math.add(u64, try std.math.mul(u64, last, view[1]), view[3]);
+        _ = try std.math.add(u64, view[0], try std.math.mul(u64, elements, view[2]));
+    }
+    _ = try std.math.add(u64, b.scratch, layout.bytes);
+    var first: usize = 0;
+    while (first < shape.rows) {
+        const rows = @min(layout.rows, shape.rows - first);
+        var x = b.x + first * input_stride * 2;
+        var pitch = input_stride;
+        if (x % 16 != 0 or input_stride % 8 != 0 or input_stride > std.math.maxInt(i32)) {
+            try copyRoutedRows(stream, b.scratch + layout.packed_input, layer.dims * 2, x, input_stride * 2, layer.dims * 2, rows);
+            x = b.scratch + layout.packed_input;
+            pitch = layer.dims;
+        }
+        const ids = b.ids + first * shape.top_k * 4;
+        const weights = b.weights + first * shape.top_k * 4;
+        const dst = b.output + first * output_stride * 4;
+        const out = if (output_stride == layer.dims) dst else b.scratch + layout.packed_output;
+        const short: ?*const @import("hy4_routed.zig").Fast = if (rows <= 8 and shape.top_k == 8 and layer.dims == 6144 and layer.experts == 256) (if (k.short_route) |*f| f else null) else null;
+        if (short) |fast| {
+            try fast.route(stream, x, pitch, b.router, b.correction_bias, b.scratch, ids, weights, rows, shape.route_scale);
+        } else {
+            try k.router.logits(stream, x, pitch, b.router, b.scratch, rows, layer.dims, layer.experts);
+            const routing: @import("moe_glue.zig").Route = .{ .experts = layer.experts, .topk = shape.top_k, .score = true, .shared = false, .normalize = true, .scale = shape.route_scale };
+            try k.glue.topk(stream, b.scratch, b.correction_bias, routing, ids, weights, rows);
+        }
+        if (prefill_wide) {
+            const pw = prefillWideWork(b.scratch + layout.expert_scratch, layer, rows, shape.top_k);
+            const pairs: u32 = @intCast(rows * shape.top_k);
+            try k.planner.route(stream, ids, pairs, layer.experts, 64, pw.plan);
+            try run(k.experts.rot_in, stream, .{ .x = pairs, .y = @intCast(layer.dims / 128), .z = 2 }, 32, .{
+                x, @as(u32, @intCast(pitch)), @as(i32, @backingInt(exl3.DType.bf16)), ids, layer.suh_g, layer.suh_u,
+                pw.xg, pw.xu, @as(u32, @intCast(layer.dims)), shape.top_k, @as(u32, @intCast(layer.experts)),
+            });
+            try (&k.short_route.?).prefillRun(stream, layer, pw.plan.items, pw.plan.counts, pw.plan.members, pw.n_items, pw.xg, pw.xu, pw.xd, pw.y_bf16, weights, out, @intCast(rows));
+        } else {
+            const work = try exl3.scratch(b.scratch + layout.expert_scratch, layer, rows, shape.top_k);
+            if (layer.wide and short != null) {
+                try short.?.run(stream, layer, x, pitch, ids, weights, out, work);
+            } else if (rows >= 32) {
+                try routedTiles(k, stream, layer, x, pitch, ids, weights, out, work);
+            } else try k.experts.run(stream, layer, x, pitch, .bf16, ids, weights, rows, out, work);
+        }
+        if (output_stride != layer.dims) try copyRoutedRows(stream, dst, output_stride * 4, out, layer.dims * 4, layer.dims * 4, rows);
+        first += rows;
+    }
+}
+
+test "Hy4 ABI validates shapes and strides before a CUDA launch" {
+    const t = std.testing;
+    const full: MlaShape = .{ .rows = 16, .heads = 64, .capacity = 2048, .key_count = 16 };
+    try t.expectEqual(@as(u32, 64 * 576), (try validMla(full)).absorbed_row_stride);
+    const packed_end = try validIhc(.{ .rows = 2, .width = 32, .stream_stride = 40, .streams_row_stride = 152 });
+    try t.expectEqual(@as(u32, 152), packed_end.streams_row_stride);
+    const ihc = try validIhc(.{ .rows = 2, .stream_stride = 6200 });
+    try t.expectEqual(@as(u32, 24800), ihc.streams_row_stride);
+}
+
+fn overlaps(a: u64, a_bytes: usize, b: u64, b_bytes: usize) bool {
+    return if (a <= b) b - a < a_bytes else a - b < b_bytes;
+}
+
+/// Add this rank's routed and shared FP32 partials before the FFN gather.
+/// All arrays have n contiguous FP32 elements. out may exactly alias either input.
+pub fn addExpertPartial(k: *const Kernels, stream: Stream, routed: u64, shared: u64, out: u64, n: usize) !void {
+    if (n == 0) return;
+    try pointers(.{ routed, shared, out });
+    if ((routed | shared | out) % 4 != 0 or n > std.math.maxInt(usize) / 4) return error.BadHy4RankBuffer;
+    for ([_]u64{ routed, shared }) |p| if (out != p and overlaps(out, 4 * n, p, 4 * n)) return error.BadHy4RankBuffer;
+    try run(k.expert_partial, stream, .{ .x = @intCast(@min(65535, (n + 255) / 256)) }, 256, .{ routed, shared, out, n });
+}
+
+/// NCCL has gathered four contiguous FP32 planes [4,n] in rank order.
+/// Add in FP32 (0,1,2,3), then round once into a disjoint BF16 branch for ihcWrite.
+pub fn foldRank4(k: *const Kernels, stream: Stream, gathered: u64, branch: u64, n: usize) !void {
+    if (n == 0) return;
+    try pointers(.{ gathered, branch });
+    if (gathered % 4 != 0 or branch % 2 != 0 or n > std.math.maxInt(usize) / 16) return error.BadHy4RankBuffer;
+    if (overlaps(gathered, 16 * n, branch, 2 * n)) return error.BadHy4RankBuffer;
+    try run(k.rank_fold, stream, .{ .x = @intCast(@min(65535, (n + 255) / 256)) }, 256, .{ gathered, branch, n });
+}
+
+/// Cast n contiguous FP32 elements to BF16 (vectorized 4 elements/thread when 16B/8B aligned).
+pub fn castF32ToBf16(k: *const Kernels, stream: Stream, src: u64, dst: u64, n: usize) !void {
+    if (n == 0) return;
+    try pointers(.{ src, dst });
+    if (src % 16 != 0 or dst % 8 != 0) return error.BadHy4RankBuffer;
+    const vecs = (n + 3) / 4;
+    try run(k.f32_to_bf16, stream, .{ .x = @intCast(@min(65535, (vecs + 255) / 256)) }, 256, .{ src, dst, @as(u64, n) });
+}
+
+pub const matchColumnPlan = @import("hy4_column_plan.zig").matchColumnPlan;
+pub const lastHeadPlan = @import("hy4_column_plan.zig").lastHeadPlan;
+
+test {
+    _ = @import("hy4_column_plan.zig");
+}
diff --git a/zig/src/cuda/hy4_routed.zig b/zig/src/cuda/hy4_routed.zig
new file mode 100644
index 0000000000000000000000000000000000000000..40f1ad5a28924f2d8a77788c5a845f6cd46fc55d
--- /dev/null
+++ b/zig/src/cuda/hy4_routed.zig
@@ -0,0 +1,203 @@
+//! Short-window full Hy4 BF16 routing and equal-size, in-place TP4 expert tiles.
+const std = @import("std");
+const Driver = @import("driver.zig").Driver;
+const abi = @import("abi.zig");
+const ex = @import("exl3_experts.zig");
+const mod = @import("module.zig");
+const launch = @import("launch.zig");
+const Stream = @import("stream.zig").Stream;
+const blobs = @import("kernels.zig");
+fn routerShared(rows: usize) u32 {
+    return @intCast(2 * (rows + 8) * (512 + 8) * 2);
+}
+
+fn expertShared(rows: usize) u32 {
+    return @intCast(@max(rows * 4 * 132 * 4, 2 * 8 * 128 * 4));
+}
+
+const Route = extern struct {
+    x: u64,
+    w: u64,
+    bias: u64,
+    logits: u64,
+    ids: u64,
+    weights: u64,
+    pitch: i32,
+    rows: i32,
+    scale: f32,
+};
+const Fused = extern struct {
+    gate: u64,
+    up: u64,
+    down: u64,
+    sv_g: u64,
+    sv_u: u64,
+    su_d: u64,
+    sv_d: u64,
+    xg: u64,
+    xu: u64,
+    xd: u64,
+    ids: u64,
+    weights: u64,
+    z: u64,
+    y: u64,
+    out: u64,
+    rows: i32,
+    x: u64,
+    su_g: u64,
+    su_u: u64,
+    pitch: i32,
+};
+
+const PrefillGuArgs = extern struct {
+    gate: u64,
+    up: u64,
+    xg: u64,
+    xu: u64,
+    sv_g: u64,
+    sv_u: u64,
+    su_d: u64,
+    items: u64,
+    counts: u64,
+    members: u64,
+    xd: u64,
+};
+
+const PrefillDnArgs = extern struct {
+    down: u64,
+    xd: u64,
+    sv_d: u64,
+    items: u64,
+    counts: u64,
+    members: u64,
+    y_bf16: u64,
+};
+
+pub const Fast = struct {
+    images: [2]mod.Module,
+    router: mod.Function,
+    widen: mod.Function,
+    experts: mod.Function,
+    grouped: mod.Function,
+    prefill_gu: mod.Function,
+    prefill_dn: mod.Function,
+    prefill_combine: mod.Function,
+    blocks: [8]u32,
+
+    pub fn load(d: *const Driver) !?Fast {
+        if (std.c.getenv("HY4_ROUTED_FAST")) |raw| if (std.mem.eql(u8, std.mem.span(raw), "0")) return null;
+        if (try d.currentCapability() != 121) return null;
+        var dev: abi.Device = 0;
+        try d.check(d.api.cuCtxGetDevice(&dev), "cuCtxGetDevice");
+        var cooperative: c_int = 0;
+        try d.check(d.api.cuDeviceGetAttribute(&cooperative, .cooperative_launch, dev), "cuDeviceGetAttribute");
+        if (cooperative == 0) return null;
+        var sms: c_int = 0;
+        try d.check(d.api.cuDeviceGetAttribute(&sms, .multiprocessor_count, dev), "cuDeviceGetAttribute");
+
+        var self: Fast = undefined;
+        self.images[0] = try mod.Module.load(d, blobs.full_hy4_router);
+        errdefer self.images[0].unload();
+        self.images[1] = try mod.Module.load(d, blobs.full_hy4_routed);
+        errdefer self.images[1].unload();
+        self.router = try self.images[0].function("tf_full_hy4_router");
+        self.widen = try self.images[1].function("tf_full_hy4_routed_widen");
+        self.experts = try self.images[1].function("tf_full_hy4_routed_experts");
+        self.grouped = try self.images[1].function("tf_full_hy4_routed_grouped");
+        self.prefill_gu = try self.images[1].function("tf_full_hy4_routed_prefill_gu");
+        self.prefill_dn = try self.images[1].function("tf_full_hy4_routed_prefill_dn");
+        self.prefill_combine = try self.images[1].function("tf_full_hy4_routed_prefill_combine");
+        if (try self.router.occupancy(256, routerShared(8)) * @as(u32, @intCast(sms)) < 32) {
+            self.deinit();
+            return null;
+        }
+        for (&self.blocks, 1..) |*n, rows| {
+            n.* = try self.experts.occupancy(512, expertShared(rows)) * @as(u32, @intCast(sms));
+            if (n.* == 0) {
+                self.deinit();
+                return null;
+            }
+        }
+        return self;
+    }
+
+    pub fn deinit(self: *Fast) void {
+        for (&self.images) |*image| image.unload();
+    }
+
+    /// The loader checked every expert and every projection before publishing uniform_k2.
+    pub fn prepare(self: *const Fast, s: Stream, l: *ex.Layer) !void {
+        if (l.wide or !l.canWiden()) return;
+        var args: launch.Args = .{};
+        inline for (.{ l.gate, l.up, l.down }) |p| args.add(p);
+        try launch.launch(self.widen, .{ .grid = .{ .x = 192, .y = 256, .z = 3 }, .block = .{ .x = 256 } }, s, &args);
+        try s.synchronize();
+        l.wide = true;
+    }
+
+    pub fn route(self: *const Fast, s: Stream, x: u64, pitch: usize, w: u64, bias: u64, logits: u64, ids: u64, weights: u64, rows: usize, scale: f32) !void {
+        var args: launch.Args = .{};
+        args.add(Route{ .x = x, .pitch = @intCast(pitch), .w = w, .bias = bias, .logits = logits, .ids = ids, .weights = weights, .rows = @intCast(rows), .scale = scale });
+        try launch.launch(self.router, .{ .grid = .{ .x = 32 }, .block = .{ .x = 256 }, .shared = routerShared(rows), .cooperative = true }, s, &args);
+    }
+
+    pub fn run(self: *const Fast, s: Stream, l: ex.Layer, x: u64, pitch: usize, ids: u64, weights: u64, out: u64, sc: ex.Scratch) !void {
+        std.debug.assert(l.wide and sc.rows >= 1 and sc.rows <= 8 and sc.slots == 8);
+        var args: launch.Args = .{};
+        args.add(Fused{ .gate = l.gate, .up = l.up, .down = l.down, .sv_g = l.svh_g, .sv_u = l.svh_u, .su_d = l.suh_d, .sv_d = l.svh_d, .xg = sc.xg, .xu = sc.xu, .xd = sc.xd, .ids = ids, .weights = weights, .z = sc.z, .y = sc.y, .out = out, .rows = @intCast(sc.rows), .x = x, .su_g = l.suh_g, .su_u = l.suh_u, .pitch = @intCast(pitch) });
+        try launch.launch(self.experts, .{ .grid = .{ .x = self.blocks[sc.rows - 1] }, .block = .{ .x = 512 }, .shared = expertShared(sc.rows), .cooperative = true }, s, &args);
+    }
+
+    pub fn prefillRun(
+        self: *const Fast,
+        s: Stream,
+        l: ex.Layer,
+        items: u64,
+        counts: u64,
+        members: u64,
+        n_items: u32,
+        xg: u64,
+        xu: u64,
+        xd: u64,
+        y_bf16: u64,
+        weights: u64,
+        out: u64,
+        rows: u32,
+    ) !void {
+        std.debug.assert(l.wide and l.dims == 6144 and l.width == 512 and l.experts == 256);
+        var gu_args: launch.Args = .{};
+        gu_args.add(PrefillGuArgs{
+            .gate = l.gate,
+            .up = l.up,
+            .xg = xg,
+            .xu = xu,
+            .sv_g = l.svh_g,
+            .sv_u = l.svh_u,
+            .su_d = l.suh_d,
+            .items = items,
+            .counts = counts,
+            .members = members,
+            .xd = xd,
+        });
+        try launch.launch(self.prefill_gu, .{ .grid = .{ .x = n_items, .y = 4 }, .block = .{ .x = 256 }, .shared = 2 * 64 * 136 * 2 }, s, &gu_args);
+
+        var dn_args: launch.Args = .{};
+        dn_args.add(PrefillDnArgs{
+            .down = l.down,
+            .xd = xd,
+            .sv_d = l.svh_d,
+            .items = items,
+            .counts = counts,
+            .members = members,
+            .y_bf16 = y_bf16,
+        });
+        try launch.launch(self.prefill_dn, .{ .grid = .{ .x = n_items, .y = 48 }, .block = .{ .x = 256 }, .shared = 64 * 136 * 2 }, s, &dn_args);
+
+        var cb_args: launch.Args = .{};
+        cb_args.add(y_bf16);
+        cb_args.add(weights);
+        cb_args.add(out);
+        cb_args.add(@as(i32, @intCast(rows)));
+        try launch.launch(self.prefill_combine, .{ .grid = .{ .x = rows, .y = 6 }, .block = .{ .x = 256 } }, s, &cb_args);
+    }
+};
