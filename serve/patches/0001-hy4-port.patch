+    try std.testing.expectEqual(@as(usize, 80), loaded_count);
+    try std.testing.expectEqual(@as(usize, 43), split_count); // 5 blocks * 8 (q_b,kv_b,gate,o_proj,sinks,mlp*3) + 3 corr_mlp
+    try std.testing.expectEqual(@as(u64, 6_582_933_760), tp1_gpu_bytes);
+    for (0..4) |rk_i| {
+        try std.testing.expectEqual(@as(u64, 1_880_056_992), rank_disk_bytes[rk_i]);
+        try std.testing.expectEqual(@as(u64, 1_880_069_440), rank_gpu_bytes[rk_i]);
+    }
+
+    // Spot-check individual stripe offsets/strides on rank 2 (heads 32..48, dense 9216..13824, corr 3072..4608).
+    const r2 = try ranks.Rank.init(2, 4);
+    const qb_sp = try ranks.headerTensorSpan(&dfly_hdr, "model.dfly_layers.3.self_attn.q_b_proj.weight", dfly_hdr.get("model.dfly_layers.3.self_attn.q_b_proj.weight").?, full_t, r2, false);
+    try std.testing.expectEqual(@as(u64, 2 * 4096 * 2048 * 2), qb_sp.offset);
+    try std.testing.expectEqual(@as(u64, 4096 * 2048 * 2), qb_sp.bytes());
+    const op_sp = try ranks.headerTensorSpan(&dfly_hdr, "model.dfly_layers.3.self_attn.o_proj.weight", dfly_hdr.get("model.dfly_layers.3.self_attn.o_proj.weight").?, full_t, r2, false);
+    try std.testing.expectEqual(@as(u64, 6144), op_sp.count);
