+//! Full Hy4 (`hy_v4_vl` / `hy_v4`) text configuration parser and geometry checks.
+//! Drops Flash-only Engram, sliding-window SWA, compressed indexer, and extra norms.
+const std = @import("std");
+
+pub const IndexerType = enum { full, shared };
+pub const FeedForward = enum { dense, sparse };
+
+pub const RopeParameters = struct {
+    rope_type: []const u8 = "default",
+    rope_theta: f32 = 10_000_000.0,
+    mrope_interleaved: bool = true,
+    mrope_section: ?[]const u32 = null,
+};
+
+pub const Text = struct {
+    model_type: []const u8 = "hy_v4",
+    hidden_size: u32,
+    intermediate_size: u32,
+    moe_intermediate_size: u32 = 0,
+    num_hidden_layers: u32,
+    vocab_size: u32,
+    max_position_embeddings: u32 = 1_048_576,
+    bos_token_id: u32 = 120000,
+    eos_token_id: u32 = 120025,
+    pad_token_id: u32 = 120002,
+    q_lora_rank: u32,
+    kv_lora_rank: u32,
+    num_attention_heads: u32,
+    num_key_value_heads: u32 = 8,
+    qk_nope_head_dim: u32,
+    qk_rope_head_dim: u32,
+    qk_head_dim: ?u32 = null,
+    v_head_dim: u32,
+    head_dim: ?u32 = null,
+    gated_mla: bool = true,
+    gating_type: []const u8 = "elementwise",
+    learnable_sink: bool = true,
+    learnable_sink_init: f32 = 0.0,
+    qk_norm: bool = true,
+    attention_bias: bool = false,
+    index_n_heads: u32,
+    index_head_dim: u32,
+    index_topk: u32,
+    indexer_types: []const IndexerType,
+    mlp_layer_types: ?[]const FeedForward = null,
+    first_k_dense_replace: u32 = 1,
+    n_routed_experts: u32 = 0,
+    num_experts_per_tok: u32 = 0,
+    n_shared_experts: u32 = 1,
+    n_group: u32 = 1,
+    topk_group: u32 = 1,
+    norm_topk_prob: bool = true,
+    routed_scaling_factor: f32 = 2.827,
+    swiglu_limit: f32 = 10.0,
+    enable_ihc: bool = true,
+    hc_mult: u32 = 4,
+    hc_eps: f32 = 1e-6,
+    hc_magnitude: f32 = 2.0,
+    rms_norm_eps: f32 = 1e-5,
+    enable_lm_head_fp32: bool = true,
+    tie_word_embeddings: bool = false,
+    rope_parameters: RopeParameters = .{},
+
+    pub fn qkHeadDim(self: Text) u32 {
+        return self.qk_nope_head_dim + self.qk_rope_head_dim;
+    }
+
+    pub fn queryRows(self: Text) usize {
+        return @as(usize, self.num_attention_heads) * self.qkHeadDim();
+    }
+
+    pub fn kvARows(self: Text) usize {
+        return @as(usize, self.kv_lora_rank) + self.qk_rope_head_dim;
+    }
+
+    pub fn kvBRows(self: Text) usize {
+        return @as(usize, self.num_attention_heads) * (self.qk_nope_head_dim + self.v_head_dim);
+    }
+
+    pub fn valueRows(self: Text) usize {
+        return @as(usize, self.num_attention_heads) * self.v_head_dim;
+    }
+
+    pub fn mlpKind(self: Text, layer: usize) FeedForward {
+        if (self.mlp_layer_types) |types| return types[layer];
+        return if (layer < self.first_k_dense_replace) .dense else .sparse;
+    }
+
+    pub fn validate(self: Text) !void {
+        if (std.mem.eql(u8, self.model_type, "hy_v4_flash")) return error.WrongFamily;
+        if (!std.mem.eql(u8, self.model_type, "hy_v4") and !std.mem.eql(u8, self.model_type, "hy_v4_vl"))
+            return error.WrongFamily;
+        if (self.num_hidden_layers == 0 or self.hidden_size == 0 or self.vocab_size == 0 or
+            self.max_position_embeddings == 0 or self.q_lora_rank == 0 or self.kv_lora_rank == 0 or
+            self.num_attention_heads == 0 or self.qk_nope_head_dim == 0 or self.qk_rope_head_dim == 0 or
+            self.qk_rope_head_dim % 2 != 0 or self.v_head_dim == 0)
+            return error.BadArchitecture;
+        if (self.qk_head_dim) |qkh| {
+            if (qkh != self.qkHeadDim()) return error.BadArchitecture;
+        }
+        if (!self.enable_ihc or self.hc_mult != 4 or !self.gated_mla or
+            !std.mem.eql(u8, self.gating_type, "elementwise") or !self.learnable_sink or self.attention_bias)
+            return error.BadArchitecture;
+        if (!std.math.isFinite(self.rms_norm_eps) or self.rms_norm_eps <= 0 or
+            !std.math.isFinite(self.hc_eps) or self.hc_eps < 0 or
+            !std.math.isFinite(self.hc_magnitude) or self.hc_magnitude < 0)
+            return error.BadArchitecture;
+        if (!std.mem.eql(u8, self.rope_parameters.rope_type, "default") or
+            !std.math.isFinite(self.rope_parameters.rope_theta) or self.rope_parameters.rope_theta <= 0)
+            return error.UnsupportedHy4Rotary;
+        if (self.rope_parameters.mrope_section) |sec| {
+            if (sec.len != 3 or sec[0] + sec[1] + sec[2] != self.qk_rope_head_dim / 2)
+                return error.UnsupportedHy4Rotary;
+        }
+        if (self.indexer_types.len != self.num_hidden_layers or self.indexer_types[0] != .full or
+            self.index_n_heads == 0 or self.index_head_dim <= self.qk_rope_head_dim or self.index_topk == 0)
+            return error.BadSparseGeometry;
+        if (self.mlp_layer_types) |mlp_types| {
+            if (mlp_types.len != self.num_hidden_layers) return error.BadArchitecture;
+        }
+        var has_dense = false;
+        var has_sparse = false;
+        for (0..self.num_hidden_layers) |l| {
+            switch (self.mlpKind(l)) {
+                .dense => has_dense = true,
+                .sparse => has_sparse = true,
+            }
+        }
+        if (has_dense and self.intermediate_size == 0) return error.BadArchitecture;
+        if (has_sparse) {
+            if (self.moe_intermediate_size == 0 or self.n_routed_experts == 0 or
+                self.num_experts_per_tok == 0 or self.num_experts_per_tok > self.n_routed_experts or
+                self.n_shared_experts == 0 or self.n_group != 1 or self.topk_group != 1 or
+                !self.norm_topk_prob or !std.math.isFinite(self.routed_scaling_factor) or
+                self.routed_scaling_factor <= 0 or !std.math.isFinite(self.swiglu_limit) or self.swiglu_limit <= 0)
+                return error.BadExpertGeometry;
+        }
+    }
+};
+
+pub const Vision = struct {
+    hidden_size: u32 = 1536,
+    num_hidden_layers: u32 = 40,
+    num_attention_heads: u32 = 16,
+    out_hidden_size: u32 = 6144,
+    patch_size: u32 = 16,
+    spatial_merge_size: u32 = 2,
+};
+
+pub const QuantizationConfig = struct {
+    quant_method: ?[]const u8 = null,
+    bits: ?f32 = null,
+    codebook: ?[]const u8 = null,
+};
+
+pub const Model = struct {
+    model_type: []const u8 = "hy_v4_vl",
+    text_config: Text,
+    vision_config: ?Vision = null,
+    quantization_config: ?QuantizationConfig = null,
+    dfly_num_hidden_layers: u32 = 0,
+    dfly_block_size: u32 = 7,
+    dfly_intermediate_size: ?u32 = null,
+    dfly_target_index_topk: u32 = 2048,
+    dfly_context_local_window: ?u32 = null,
+    dfly_target_index_layer: []const u32 = &.{},
+    dfly_target_kv_layers: []const u32 = &.{},
+    dfly_enable_ihc: bool = false,
+    dfly_enable_hidden_correction: bool = true,
+    dfly_attn_causal: bool = true,
+    dfly_mlp_type: []const u8 = "dense",
+    dfly_mask_token_id: u32 = 0,
+    dfly_mtp_fusion: []const u8 = "slot0",
+
+    pub fn validate(self: Model) !void {
+        if (std.mem.eql(u8, self.model_type, "hy_v4_flash")) return error.WrongFamily;
+        if (!std.mem.eql(u8, self.model_type, "hy_v4_vl") and !std.mem.eql(u8, self.model_type, "hy_v4"))
+            return error.WrongFamily;
+        try self.text_config.validate();
+        if (self.vision_config) |vc| {
+            if (vc.out_hidden_size != self.text_config.hidden_size) return error.BadArchitecture;
+        }
+        if (self.dfly_num_hidden_layers > 0) {
+            if (self.dfly_block_size < 2 or self.dfly_block_size > 16 or
+                self.dfly_enable_ihc or !self.dfly_attn_causal or
+                !std.mem.eql(u8, self.dfly_mtp_fusion, "slot0") or
+                !std.mem.eql(u8, self.dfly_mlp_type, "dense") or
+                self.dfly_mask_token_id >= self.text_config.vocab_size or
+                self.dfly_target_kv_layers.len != self.dfly_num_hidden_layers or
+                self.dfly_target_index_layer.len != self.dfly_num_hidden_layers)
+                return error.BadDraftGeometry;
+            for (self.dfly_target_index_layer, self.dfly_target_kv_layers) |ix, kv| {
+                if (ix >= self.text_config.num_hidden_layers or kv >= self.text_config.num_hidden_layers or
+                    self.text_config.indexer_types[ix] != .full)
+                    return error.BadDraftGeometry;
+            }
+        }
+    }
+};
+
+pub const Parsed = struct {
+    arena: std.heap.ArenaAllocator,
+    value: Model,
+
+    pub fn deinit(self: *Parsed) void {
+        self.arena.deinit();
+        self.* = undefined;
+    }
+};
+
+const Probe = struct {
+    model_type: ?[]const u8 = null,
+    text_config: ?std.json.Value = null,
+};
+
+pub fn parse(allocator: std.mem.Allocator, bytes: []const u8) !Parsed {
+    var arena = std.heap.ArenaAllocator.init(allocator);
+    errdefer arena.deinit();
+    const a = arena.allocator();
+    const probe = try std.json.parseFromSliceLeaky(Probe, a, bytes, .{ .ignore_unknown_fields = true });
+    if (probe.model_type) |mt| {
+        if (std.mem.eql(u8, mt, "hy_v4_flash")) return error.WrongFamily;
+    }
+    const opts: std.json.ParseOptions = .{ .ignore_unknown_fields = true, .allocate = .alloc_always };
+    const model: Model = if (probe.text_config != null)
+        try std.json.parseFromSliceLeaky(Model, a, bytes, opts)
+    else .{
+        .model_type = probe.model_type orelse "hy_v4",
+        .text_config = try std.json.parseFromSliceLeaky(Text, a, bytes, opts),
+    };
+    try model.validate();
+    return .{ .arena = arena, .value = model };
+}
+
