+//! Host tests for per-rank packs (`pack_export.zig` + `pack_parts.zig`): a tiny full model cut into `common/` plus
+//! four `rank<R>/` parts loads each rank with the same uploaded bytes as a full-pack load of that rank (a digest of
+//! every host-to-device copy); real-shape EXL3 expert slices read back identically; and the planted controls refuse
+//! another rank's part, a part from another source pack, a mix of full and part files, and a changed byte.
+const std = @import("std");
+const core = @import("core");
+const ranks = @import("ranks.zig");
+const weights = @import("weights.zig");
+const cache = @import("cache.zig");
+const boundary = @import("boundary.zig");
+const pack_export = @import("pack_export.zig");
+
+const tiny_cfg =
+    \\{"text_config":{"model_type":"hy_v4","hidden_size":32,"intermediate_size":64,"moe_intermediate_size":16,
+    \\"num_hidden_layers":3,"vocab_size":101,"q_lora_rank":12,"kv_lora_rank":8,"num_attention_heads":4,
+    \\"qk_nope_head_dim":10,"qk_rope_head_dim":6,"v_head_dim":16,"index_n_heads":4,"index_head_dim":16,
+    \\"index_topk":16,"indexer_types":["full","full","shared"],"mlp_layer_types":["dense","sparse","sparse"],
+    \\"n_routed_experts":4,"num_experts_per_tok":2,"tie_word_embeddings":false}}
+;
+
+const T = struct { name: []const u8, dtype: core.safetensors.DType, shape: []const usize };
+
+/// Every tensor `checkLoadRank` reads for `tiny_cfg`, with random bytes, in two shards behind an index.json.
+fn writeTinyModel(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, seed: u64) !void {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var specs: std.ArrayList(T) = .empty;
+    try specs.appendSlice(a, &.{
+        .{ .name = "model.embed_tokens.weight", .dtype = .bf16, .shape = &.{ 101, 32 } },
+        .{ .name = "model.norm.weight", .dtype = .bf16, .shape = &.{32} },
+        .{ .name = "model.hc_head.hc_head_fn", .dtype = .f32, .shape = &.{ 4, 128 } },
+        .{ .name = "model.hc_head.hc_head_base", .dtype = .f32, .shape = &.{4} },
+        .{ .name = "model.hc_head.hc_head_scale", .dtype = .f32, .shape = &.{1} },
+    });
+    const per_layer = [_]T{
+        .{ .name = "hc_attn_layer.hc_pre.hc_fn", .dtype = .f32, .shape = &.{ 8, 128 } },
+        .{ .name = "hc_attn_layer.hc_pre.hc_base", .dtype = .f32, .shape = &.{8} },
+        .{ .name = "hc_attn_layer.hc_pre.hc_scale", .dtype = .f32, .shape = &.{2} },
+        .{ .name = "hc_mlp_layer.hc_pre.hc_fn", .dtype = .f32, .shape = &.{ 8, 128 } },
+        .{ .name = "hc_mlp_layer.hc_pre.hc_base", .dtype = .f32, .shape = &.{8} },
+        .{ .name = "hc_mlp_layer.hc_pre.hc_scale", .dtype = .f32, .shape = &.{2} },
+        .{ .name = "input_layernorm.weight", .dtype = .bf16, .shape = &.{32} },
+        .{ .name = "post_attention_layernorm.weight", .dtype = .bf16, .shape = &.{32} },
+        .{ .name = "self_attn.q_a_proj.weight", .dtype = .bf16, .shape = &.{ 12, 32 } },
+        .{ .name = "self_attn.q_a_layernorm.weight", .dtype = .bf16, .shape = &.{12} },
+        .{ .name = "self_attn.q_b_proj.weight", .dtype = .bf16, .shape = &.{ 64, 12 } },
+        .{ .name = "self_attn.kv_a_proj_with_mqa.weight", .dtype = .bf16, .shape = &.{ 14, 32 } },
+        .{ .name = "self_attn.kv_a_layernorm.weight", .dtype = .bf16, .shape = &.{8} },
+        .{ .name = "self_attn.kv_b_proj.weight", .dtype = .bf16, .shape = &.{ 104, 8 } },
+        .{ .name = "self_attn.linear_gate.weight", .dtype = .bf16, .shape = &.{ 64, 32 } },
+        .{ .name = "self_attn.o_proj.weight", .dtype = .bf16, .shape = &.{ 32, 64 } },
+        .{ .name = "self_attn.learnable_sink_param", .dtype = .f32, .shape = &.{4} },
+    };
+    const indexer = [_]T{
+        .{ .name = "self_attn.indexer.wq_b.weight", .dtype = .bf16, .shape = &.{ 64, 12 } },
+        .{ .name = "self_attn.indexer.wk.weight", .dtype = .bf16, .shape = &.{ 16, 32 } },
+        .{ .name = "self_attn.indexer.k_norm.weight", .dtype = .bf16, .shape = &.{16} },
+        .{ .name = "self_attn.indexer.k_norm.bias", .dtype = .bf16, .shape = &.{16} },
+        .{ .name = "self_attn.indexer.weights_proj.weight", .dtype = .bf16, .shape = &.{ 4, 32 } },
+    };
+    const dense = [_]T{
+        .{ .name = "mlp.gate_proj.weight", .dtype = .bf16, .shape = &.{ 64, 32 } },
+        .{ .name = "mlp.up_proj.weight", .dtype = .bf16, .shape = &.{ 64, 32 } },
+        .{ .name = "mlp.down_proj.weight", .dtype = .bf16, .shape = &.{ 32, 64 } },
+    };
+    const sparse = [_]T{
+        .{ .name = "mlp.shared_experts.gate_proj.weight", .dtype = .bf16, .shape = &.{ 16, 32 } },
+        .{ .name = "mlp.shared_experts.up_proj.weight", .dtype = .bf16, .shape = &.{ 16, 32 } },
+        .{ .name = "mlp.shared_experts.down_proj.weight", .dtype = .bf16, .shape = &.{ 32, 16 } },
+        .{ .name = "mlp.gate.weight", .dtype = .f32, .shape = &.{ 4, 32 } },
+        .{ .name = "mlp.gate.e_score_correction_bias", .dtype = .f32, .shape = &.{4} },
+        .{ .name = "mlp.experts.gate_up_proj", .dtype = .bf16, .shape = &.{ 4, 32, 32 } },
+        .{ .name = "mlp.experts.down_proj", .dtype = .bf16, .shape = &.{ 4, 32, 16 } },
+    };
+    const first_b = specs.items.len;
+    for (0..3) |l| {
+        const groups: []const []const T = &.{ &per_layer, if (l < 2) &indexer else &.{}, if (l == 0) &dense else &sparse };
+        for (groups) |g| for (g) |s| try specs.append(a, .{ .name = try std.fmt.allocPrint(a, "model.layers.{d}.{s}", .{ l, s.name }), .dtype = s.dtype, .shape = s.shape });
+    }
+    try specs.append(a, .{ .name = "lm_head.weight", .dtype = .bf16, .shape = &.{ 101, 32 } });
+
+    var prng = std.Random.DefaultPrng.init(seed);
+    var shards: [2]std.ArrayList(core.shard_edit.New) = .{ .empty, .empty };
+    var index: std.ArrayList(u8) = .empty;
+    try index.appendSlice(a, "{\"weight_map\":{");
+    for (specs.items, 0..) |s, i| {
+        var n: usize = s.dtype.size();
+        for (s.shape) |d| n *= d;
+        const bytes = try a.alloc(u8, n);
+        prng.random().bytes(bytes);
+        const which: usize = if (i < first_b + 20) 0 else 1;
+        try shards[which].append(a, .{ .name = s.name, .dtype = s.dtype, .shape = s.shape, .bytes = bytes });
+        try index.print(a, "{s}\"{s}\":\"model-0000{d}-of-00002.safetensors\"", .{ if (i == 0) "" else ",", s.name, which + 1 });
+    }
+    try index.appendSlice(a, "}}");
+    for (shards, 0..) |sh, w| {
+        const p = try std.fmt.allocPrint(a, "{s}/model-0000{d}-of-00002.safetensors", .{ dir, w + 1 });
+        try core.shard_edit.create(gpa, p, &.{}, sh.items);
+    }
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = try std.fs.path.join(a, &.{ dir, "index.json" }), .data = index.items });
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = try std.fs.path.join(a, &.{ dir, "config.json" }), .data = tiny_cfg });
+}
+
+/// SHA-256 of every byte `checkLoadRank` copies to the (mock) device, in order: the loaded weights of that rank.
+fn loadDigest(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, rank: ?usize) ![32]u8 {
+    var idx = try weights.ShardIndex.open(gpa, io, dir);
+    defer idx.deinit();
+    const mock = cache.TestMock;
+    var d = mock.init();
+    var h = std.crypto.hash.sha2.Sha256.init(.{});
+    mock.digest = &h;
+    defer mock.digest = null;
+    const st = try weights.checkLoadRank(gpa, io, &d, &idx, null, null, false, if (rank) |r| try ranks.Rank.init(r, 4) else null);
+    try std.testing.expect(st.has_trunk and st.has_head and st.n_dense == 1 and st.n_bf16 == 2);
+    return h.finalResult();
+}
+
+fn sub(a: std.mem.Allocator, base: []const u8, rest: []const u8) ![]u8 {
+    return std.fs.path.join(a, &.{ base, rest });
+}
+
+fn copyFile(io: std.Io, a: std.mem.Allocator, from: []const u8, to: []const u8) !void {
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(io, from, a, .limited(16 << 20));
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = to, .data = bytes });
+}
+
+test "per-rank pack: each rank boots from common + its own part with the full-pack bytes; planted controls refuse" {
+    const gpa = std.testing.allocator;
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const root = try tmp.dir.realPathFileAlloc(io, ".", a);
+    for ([_][]const u8{ "src", "src2", "out", "solo1", "mixed" }) |d| try tmp.dir.createDirPath(io, d);
+    const src = try sub(a, root, "src");
+    const out = try sub(a, root, "out");
+    try writeTinyModel(gpa, io, src, 20261120);
+
