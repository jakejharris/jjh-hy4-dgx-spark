@@ -0,0 +1,197 @@
+//! Four-rank NCCL with an optional verbs relay for small FP32 gathers. The family owns this communicator, its CUDA stream and all work buffers.
+const std = @import("std");
+const geom = @import("hy4_tp.zig");
+const ops = @import("hy4_ops.zig");
+const nccl = @import("nccl.zig");
+const Stream = @import("stream.zig").Stream;
+const DeviceBuffer = @import("memory.zig").DeviceBuffer;
+
+pub const Region = struct { ptr: u64, bytes: usize };
+pub const Buffers = struct { partial: Region, gathered: Region, branch: Region };
+
+fn buildDigest(io: std.Io) ![32]u8 {
+    const file = try std.Io.Dir.cwd().openFile(io, "/proc/self/exe", .{});
+    defer file.close(io);
+    var sha = std.crypto.hash.sha2.Sha256.init(.{});
+    var block: [65536]u8 = undefined;
+    var offset: u64 = 0;
+    while (true) {
+        const got = try file.readPositionalAll(io, &block, offset);
+        sha.update(block[0..got]);
+        if (got < block.len) return sha.finalResult();
+        offset += got;
+    }
+}
+
+fn checkedEnd(region: Region, needed: usize, alignment: u64) !u64 {
+    if (region.ptr == 0 or region.ptr % alignment != 0 or region.bytes < needed) return error.BadHy4RankBuffer;
+    return std.math.add(u64, region.ptr, needed) catch error.BadHy4RankBuffer;
+}
+
+pub fn elements(rows: usize) !usize {
+    if (rows == 0 or rows > std.math.maxInt(usize) / (geom.hidden * 16)) return error.BadHy4BoundaryRows;
+    return rows * geom.hidden;
+}
+
+fn validate(rank: geom.Rank, rows: usize, b: Buffers) !usize {
+    const n = try elements(rows);
+    const send_end = try checkedEnd(b.partial, n * 4, 4);
+    const recv_end = try checkedEnd(b.gathered, n * 16, 4);
+    const output_end = try checkedEnd(b.branch, n * 2, 2);
+    if (b.branch.ptr < recv_end and b.gathered.ptr < output_end or
+        b.branch.ptr < send_end and b.partial.ptr < output_end) return error.BadHy4RankBuffer;
+    const own = b.gathered.ptr + @as(usize, @backingInt(rank)) * n * 4;
+    if (b.partial.ptr < recv_end and b.gathered.ptr < send_end and b.partial.ptr != own) return error.BadHy4RankBuffer;
+    return n;
+}
+
+pub const Boundary = struct {
+    lib: *const nccl.Library,
+    comm: nccl.Comm,
+    rank: geom.Rank,
+
+    relay: ?@import("hy4_tp_relay.zig").Link = null,
+
+    /// Collectively select the wire at startup. With TF_TP_ROCE_RELAY=1 a failed relay refuses the join.
+    pub fn joinConfigured(comptime fabric: type, lib: *const nccl.Library, b: *fabric.Bootstrap, stream: Stream, io: std.Io) !Boundary {
+        var self = try join(lib, b, io);
+        errdefer self.abort();
+        self.relay = try @import("hy4_tp_relay.zig").open(fabric, b, stream, io);
+        return self;
+    }
+
+    /// Join using fabric/tp's Bootstrap. Only rank zero creates an NCCL ID. The existing
+    /// bounded control sockets carry identity and ID bytes before any NCCL operation can wait.
+    pub fn join(lib: *const nccl.Library, bootstrap: anytype, io: std.Io) !Boundary {
+        const rank = try geom.Rank.init(bootstrap.rank, bootstrap.world);
+        const digest = try buildDigest(io);
+        bootstrap.agree(&digest, "Hy4 executable SHA-256") catch |err| {
+            if (err == error.Mismatch) return error.Hy4BuildMismatch;
+            return err;
+        };
+        const version = try lib.version();
+        try bootstrap.agree(std.mem.asBytes(&version), "NCCL version");
+        var id: nccl.UniqueId = .{ .internal = @splat(0) };
+        if (rank == .zero) try lib.check(lib.api.ncclGetUniqueId(&id), "Hy4 rank zero NCCL ID");
+        try bootstrap.broadcast(&id.internal, &id.internal);
+        return initComm(lib, id, rank);
+    }
+
+    fn initComm(lib: *const nccl.Library, id: nccl.UniqueId, rank: geom.Rank) !Boundary {
+        var comm: nccl.Comm = null;
+        lib.check(lib.api.ncclCommInitRank(&comm, geom.world, id, @backingInt(rank)), "Hy4 ncclCommInitRank") catch |err| {
+            if (comm != null) _ = lib.api.ncclCommAbort(comm);
+            return err;
+        };
+        var self: Boundary = .{ .lib = lib, .comm = comm, .rank = rank };
+        errdefer self.abort();
+        const shape = try lib.shape(comm);
+        if (try geom.Rank.init(shape.rank, shape.world) != rank) return error.BadHy4Rank;
+        return self;
+    }
+
+    /// For a caller which already distributes one unique ID. Verify all four running executables on NCCL.
+    pub fn open(lib: *const nccl.Library, id: nccl.UniqueId, rank: geom.Rank, stream: Stream, io: std.Io) !Boundary {
+        const digest = try buildDigest(io);
+        var self = try initComm(lib, id, rank);
+        errdefer self.abort();
+        var send = try DeviceBuffer.fromHost(stream.d, &digest);
+        defer send.free();
+        var words: [geom.world][32]u8 = undefined;
+        var recv = try DeviceBuffer.alloc(stream.d, @sizeOf(@TypeOf(words)));
+        defer recv.free();
+        try lib.check(lib.api.ncclAllGather(send.ptr, recv.ptr, digest.len, .u8, self.comm, stream.handle), "Hy4 build identity");
+        try stream.synchronize();
+        try self.check();
+        try recv.download(0, std.mem.asBytes(&words));
+        for (words) |peer| if (!std.mem.eql(u8, &digest, &peer)) return error.Hy4BuildMismatch;
+        return self;
+    }
+
+    /// Enqueues the gather and ordered fold on the same stream. All ranks must agree on rows and call order.
+    pub fn gatherFold(self: *const Boundary, k: *const ops.Kernels, stream: Stream, rows: usize, b: Buffers) !void {
+        const n = try validate(self.rank, rows, b);
+        if (self.comm == null) return error.Hy4CommunicatorClosed;
+        if (k.fast_prefill and rows >= k.min_prefill_rows and k.prefill_ar != .off and (b.partial.ptr % 16 == 0) and (b.gathered.ptr % 16 == 0) and (b.branch.ptr % 8 == 0)) {
+            switch (k.prefill_ar) {
+                .bf16 => {
+                    try ops.castF32ToBf16(k, stream, b.partial.ptr, b.gathered.ptr, n);
+                    try self.lib.check(self.lib.api.ncclAllReduce(b.gathered.ptr, b.branch.ptr, n, .bf16, .sum, self.comm, stream.handle), "Hy4 BF16 prefill all-reduce");
+                    return;
+                },
+                .fp32 => {
+                    try self.lib.check(self.lib.api.ncclAllReduce(b.partial.ptr, b.gathered.ptr, n, .f32, .sum, self.comm, stream.handle), "Hy4 FP32 prefill all-reduce");
+                    try ops.castF32ToBf16(k, stream, b.gathered.ptr, b.branch.ptr, n);
+                    return;
+                },
+                .off => {},
+            }
+        }
+        try self.gather(stream, b, n);
+        try ops.foldRank4(k, stream, b.gathered.ptr, b.branch.ptr, n);
+    }
+
+    /// Consume a tight checkpoint-width branch and apply its iHC residual directly from the relay slots.
+    /// A legacy image or an oversized message leaves the caller on the ordinary gather/fold/write path.
+    pub fn tryFoldWrite(self: *const Boundary, stream: Stream, rows: usize, b: Buffers, w: ops.IhcWrite) !bool {
+        const relay = self.relay orelse return false;
+        if (self.comm == null) return error.Hy4CommunicatorClosed;
+        const n = try validate(self.rank, rows, b);
+        if (w.branch != b.branch.ptr or w.post == 0 or w.residual == 0 or w.output == 0) return error.BadHy4RankBuffer;
+        return relay.foldWrite(relay.ctx, stream.handle, b.partial.ptr, b.branch.ptr, n * 4, w.residual, w.post, w.output);
+    }
+
+    fn gather(self: *const Boundary, stream: Stream, b: Buffers, n: usize) !void {
+        if (self.relay) |r| {
+            try r.check(r.ctx);
+            if (r.fits(r.ctx, n * 4)) return r.gather(r.ctx, stream.handle, b.partial.ptr, b.gathered.ptr, n * 4);
+        }
+        try self.lib.check(self.lib.api.ncclAllGather(b.partial.ptr, b.gathered.ptr, n, .f32, self.comm, stream.handle), "Hy4 FP32 all-gather");
+    }
+
+    /// Complete the token's stream and check both transports before publishing its output.
+    pub fn finish(self: *const Boundary, stream: Stream) !void {
+        try stream.synchronize();
+        try self.check();
+    }
+
+    pub fn check(self: *const Boundary) !void {
+        if (self.comm == null) return error.Hy4CommunicatorClosed;
+        if (self.relay) |r| try r.check(r.ctx);
+        var result: nccl.Result = undefined;
+        try self.lib.check(self.lib.api.ncclCommGetAsyncError(self.comm, &result), "Hy4 ncclCommGetAsyncError");
+        try self.lib.check(result, "Hy4 communicator");
+    }
+
+    pub fn abort(self: *Boundary) void {
+        // Wake both transports before freeing storage that may drain the CUDA context.
+        if (self.relay) |r| r.abort(r.ctx);
+        if (self.comm != null) _ = self.lib.api.ncclCommAbort(self.comm);
+        self.comm = null;
+        if (self.relay) |r| r.deinit(r.ctx);
+        self.relay = null;
+    }
+
+    pub fn close(self: *Boundary) void {
+        if (self.relay) |r| {
+            r.deinit(r.ctx);
+            self.relay = null;
+        }
+        if (self.comm != null) _ = self.lib.api.ncclCommDestroy(self.comm);
+        self.comm = null;
+    }
+};
+
+test "Hy4 ABI boundary buffers reject overlaps before issuing a collective" {
+    const t = std.testing;
+    const n = geom.hidden;
+    var b: Buffers = .{ .partial = .{ .ptr = 4, .bytes = n * 4 }, .gathered = .{ .ptr = 0x100000, .bytes = n * 16 }, .branch = .{ .ptr = 0x200000, .bytes = n * 2 } };
+    try t.expectEqual(n, try validate(.one, 1, b));
+    b.partial.ptr = b.gathered.ptr + n * 4;
+    try t.expectEqual(n, try validate(.one, 1, b));
+    try t.expectError(error.BadHy4RankBuffer, validate(.two, 1, b));
+    b.branch.ptr = b.gathered.ptr;
+    try t.expectError(error.BadHy4RankBuffer, validate(.one, 1, b));
+    try t.expectError(error.BadHy4BoundaryRows, elements(0));
+    try t.expectError(error.BadHy4BoundaryRows, elements(std.math.maxInt(usize)));
+}
diff --git a/zig/src/cuda/hy4_tp_relay.zig b/zig/src/cuda/hy4_tp_relay.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5ee2dd0161308431d3222bc1c571d812a7a9b654
--- /dev/null
+++ b/zig/src/cuda/hy4_tp_relay.zig
@@ -0,0 +1,133 @@
+//! Optional four-rank verbs relay. Fabric owns the QPs, the GPU mailbox and their failure state.
+const std = @import("std");
+const Multi = @import("tp_group.zig").Multi;
+const abi = @import("abi.zig");
+const Stream = @import("stream.zig").Stream;
+const Buffer = @import("memory.zig").DeviceBuffer;
+const hidden = @import("hy4_tp.zig").hidden;
+
+pub const Link = struct {
+    ctx: *anyopaque,
+    fits: @FieldType(Multi, "fits"),
+    gather: @FieldType(Multi, "gather"),
+    check: @FieldType(Multi, "check"),
+    abort: @FieldType(Multi, "abort"),
+    deinit: @FieldType(Multi, "deinit"),
+    foldWrite: *const fn (*anyopaque, abi.Stream, u64, u64, usize, u64, u64, u64) anyerror!bool,
+};
+
+pub fn open(comptime fabric: type, b: *fabric.Bootstrap, stream: Stream, io: std.Io) !?Link {
+    const cfg = try fabric.Config.fromEnvFor(b.world, b.rank);
+    try b.agree(&cfg.digest(), "Hy4 relay settings");
+    if (!cfg.roce_relay) return null;
+    const direct = if (std.c.getenv("HY4_TP_DIRECT_WRITE")) |v| std.mem.eql(u8, std.mem.span(v), "1") else false;
+    try b.agree(&.{@intFromBool(direct)}, "Hy4 direct residual consumer");
+    if (cfg.roce_wire != .verbs) return error.Hy4RelayNeedsVerbs;
+    const path = std.mem.span(std.c.getenv("TF_TP_KERNEL_IMAGE") orelse return error.NoKernelImage);
+    const alloc = std.heap.page_allocator;
+    const image = try std.Io.Dir.cwd().readFileAllocOptions(io, path, alloc, .limited(1 << 26), .@"16", null);
+    defer alloc.free(image);
+    var digest: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(image, &digest, .{});
+    try b.agree(&digest, "Hy4 relay kernel SHA-256");
+
+    var specs: [fabric.roce_verbs.max_hcas]fabric.roce_verbs.HcaSpec = undefined;
+    const count = try fabric.roce_pick.resolve(cfg, b, &specs);
+    // The chunk ABI advances by the physical slot. Make the slot itself obey the relay cap.
+    const slot = @min(cfg.mailbox_max_bytes, cfg.roce_relay_max_bytes);
+    if (slot % 4096 != 0 or slot < hidden * 4) return error.BadHy4RelaySlot;
+    const wire = try fabric.roce_multi.Roce.init(stream.d, b, image, .{
+        .relay = true,
+        .relay_max_bytes = slot,
+        .hcas = specs[0..count],
+        .max_bytes = slot,
+        .traffic_class = cfg.roce_tc,
+        .cpu = cfg.roce_cpu,
+        .timeout_ns = cfg.mailbox_timeout_ns,
+        .fast = cfg.roce_fast,
+        .blocks = cfg.roce_blocks,
+    });
+    errdefer wire.deinit();
+    if (cfg.roce_chunked_bytes > slot and !wire.chunk_abi) return error.ChunkAbiMissing;
+    const Adapter = Relay(fabric);
+    const a = try alloc.create(Adapter);
+    errdefer alloc.destroy(a);
+    a.* = .{ .wire = wire, .direct = direct, .lengths = try Buffer.alloc(stream.d, b.world * @sizeOf(i32)), .chunk_limit = cfg.roce_chunked_bytes };
+    errdefer a.lengths.free();
+    const good = a.probe(stream) catch |err| blk: {
+        std.log.err("Hy4 relay probe rank {d} failed with {t}", .{ b.rank, err });
+        break :blk false;
+    };
+    try b.agree(&.{@intFromBool(good)}, "Hy4 ordered decode relay probe");
+    if (!good) return error.Hy4RelayProbeMismatch;
+    var line: [384]u8 = undefined;
+    std.log.info("Hy4 relay rank {d} verified {d} bytes per rank, slot {d}, split limit {d}, {s}", .{ b.rank, hidden * 4, slot, a.chunk_limit, wire.describeLink(&line) });
+    return .{ .ctx = a, .fits = Adapter.fits, .foldWrite = Adapter.foldWrite, .gather = Adapter.gather, .check = Adapter.check, .abort = Adapter.abort, .deinit = Adapter.deinit };
+}
+
+fn Relay(comptime fabric: type) type {
+    return struct {
+        wire: *fabric.roce_multi.Roce,
+        lengths: Buffer,
+        direct: bool,
+        chunk_limit: usize,
+        const Self = @This();
+
+        fn get(ctx: *anyopaque) *Self {
+            return @ptrCast(@alignCast(ctx));
+        }
+
+        fn fits(ctx: *anyopaque, bytes: usize) bool {
+            const a = get(ctx);
+            return a.wire.fits(bytes) or bytes <= a.chunk_limit;
+        }
+
+        fn foldWrite(ctx: *anyopaque, s: abi.Stream, mine: u64, branch: u64, bytes: usize, residual: u64, post: u64, output: u64) anyerror!bool {
+            const a = get(ctx);
+            if (!a.direct) return false;
+            const wire = a.wire;
+            try wire.check();
+            return wire.tryHy4FoldWrite(mine, branch, bytes, .{ .residual = residual, .post = post, .output = output }, s);
+        }
+
+        fn gather(ctx: *anyopaque, s: abi.Stream, mine: u64, all: u64, bytes: usize) anyerror!void {
+            const a = get(ctx);
+            if (a.wire.fits(bytes)) return a.wire.allGatherBytes(mine, all, bytes, s);
+            try a.lengths.fill32(@intCast(bytes), s);
+            try a.wire.allGatherVChunked(mine, all, bytes, a.lengths.ptr, s);
+        }
+
+        // Verify every rank and both cable halves, in place, before accepting any model output.
+        fn probe(a: *Self, s: Stream) !bool {
+            const bytes = hidden * 4;
+            var buf = try Buffer.alloc(s.d, 4 * bytes);
+            defer buf.free();
+            var data: [bytes]u8 = undefined;
+            var expected: [bytes]u8 = undefined;
+            fabric.reference.fill(&data, .u8, a.wire.me, 0x687934);
+            try buf.upload(a.wire.me * bytes, &data);
+            try a.wire.allGatherBytes(buf.ptr + a.wire.me * bytes, buf.ptr, bytes, s.handle);
+            try s.synchronize();
+            try a.wire.check();
+            for (0..4) |rank| {
+                fabric.reference.fill(&expected, .u8, @intCast(rank), 0x687934);
+                try buf.download(rank * bytes, &data);
+                if (!std.mem.eql(u8, &expected, &data)) return false;
+            }
+            return true;
+        }
+
+        fn check(ctx: *anyopaque) anyerror!void {
+            return get(ctx).wire.check();
+        }
+        fn abort(ctx: *anyopaque) void {
+            get(ctx).wire.abort();
+        }
+        fn deinit(ctx: *anyopaque) void {
+            const a = get(ctx);
+            a.wire.deinit();
+            a.lengths.free();
+            std.heap.page_allocator.destroy(a);
+        }
+    };
+}
diff --git a/zig/src/cuda/hy4_trunk.zig b/zig/src/cuda/hy4_trunk.zig
new file mode 100644
index 0000000000000000000000000000000000000000..591a5e736f4e00ff1d38bd99aeb5e35c63d425b1
--- /dev/null
+++ b/zig/src/cuda/hy4_trunk.zig
@@ -0,0 +1,241 @@
+//! GB10 short-window EXL3 mul1 trunk. Preserves the loader's K-split plan.
+const std = @import("std");
+const ex = @import("exl3.zig");
+const Driver = @import("driver.zig").Driver;
+const memory = @import("memory.zig");
+const mod = @import("module.zig");
+const launch = @import("launch.zig");
+const Stream = @import("stream.zig").Stream;
+const vit = @import("vit.zig");
+const blobs = @import("kernels.zig");
+const env = @import("sys").environment;
+
+const Part = extern struct { linear: ex.LinearArgsC, suh: u64 };
+const Pair = extern struct { parts: [2]Part, down_suh: u64, first_blocks: i32 };
+
+fn workspace(w: ex.Weight, rows: usize, rotate: bool) usize {
+    const p = ex.planOf(w);
+    const red = rows * p.wk * 132 * 4;
+    return if (rotate) @max(red, rows * (w.k / p.sk) * 2) else red;
+}
+
+fn fits(w: ex.Weight, rows: usize, rotate: bool) bool {
+    if (rows == 0 or rows > 8 or w.k == 0 or w.n == 0 or (w.k | w.n) % 128 != 0 or
+        w.codebook != .mul1 or w.halves != 8) return false;
+    const p = ex.planOf(w);
+    if ((p.wk != 4 and p.wk != 8) or p.sk > 64 or w.k % (16 * p.sk * p.wk) != 0) return false;
+    if (rotate and w.k / p.sk % 128 != 0) return false;
+    // The prologue rereads a long K slice for every output block. On wider windows,
+    // keep the separate shared rotation once it exceeds this block's shared budget.
+    return workspace(w, rows, rotate) <= 48 * 1024;
+}
+
+fn rangeWorkspace(w: ex.Weight, rows: usize) usize {
+    return @max(workspace(w, rows, false), rows * (w.k / ex.planOf(w).sk) * 6);
+}
+
+fn fitsRange(w: ex.Weight, rows: usize) bool {
+    return fits(w, rows, true) and rangeWorkspace(w, rows) <= 48 * 1024;
+}
+
+fn args(w: ex.Weight, x: u64, y: u64, yd: ex.DType, rows: usize, z: u64, c: u64) Part {
+    return .{
+        .linear = .{ .xh = x, .t = w.trellis, .stride_k = @intCast(w.stride_k), .stride_nb = @intCast(w.stride_nb),
+            .svh = w.svh, .bias = w.bias, .y = y, .z = z, .counters = c, .y_dtype = @backingInt(yd),
+            .n = @intCast(w.n), .sk = @intCast(ex.planOf(w).sk), .m = @intCast(rows), .k = @intCast(w.k) },
+        .suh = w.suh,
+    };
+}
+
+fn blocks(w: ex.Weight) u32 {
+    return (w.n / 128) * ex.planOf(w).sk;
+}
+
+fn enqueue(f: mod.Function, s: Stream, n: u32, shared: usize, param: anytype) !void {
+    var values: launch.Args = .{};
+    values.add(param);
+    try launch.launch(f, .{ .grid = .{ .x = n }, .block = .{ .x = 1024 }, .shared = @intCast(shared) }, s, &values);
+}
+
+pub const Short = struct {
+    d: *const Driver,
+    image: mod.Module,
+    trunk4: mod.Function,
+    trunk8: mod.Function,
+    trunk_pair: mod.Function,
+    trunk_glu: mod.Function,
+    trunk_down: mod.Function,
+    trunk_down8: mod.Function,
+    unpack_bf16: mod.Function,
+    rot_bf16: mod.Function,
+    unrot_out: mod.Function,
+    pf_w: ?memory.DeviceBuffer = null,
+    pf_x: ?memory.DeviceBuffer = null,
+    pf_part: ?memory.DeviceBuffer = null,
+    range: @import("hy4_trunk_range.zig").Range,
+    enabled: bool,
+    fast_prefill: bool,
+    min_prefill_rows: usize,
+
+    pub fn load(d: *const Driver) !Short {
+        var enabled = try d.currentCapability() == 121;
+        if (std.c.getenv("HY4_TRUNK_FAST")) |raw| if (std.mem.eql(u8, std.mem.span(raw), "0")) {
+            enabled = false;
+        };
+
+        const fast_prefill = try env.read(bool, "TF_HY4_FAST_PREFILL", false);
+        const min_prefill_rows: usize = try env.read(u32, "TF_HY4_FAST_PREFILL_MIN_ROWS", 256);
+
+        var self: Short = undefined;
+        self.d = d;
+        self.image = try mod.Module.load(d, blobs.full_hy4_trunk);
+        errdefer self.image.unload();
+        self.enabled = enabled;
+        self.fast_prefill = fast_prefill;
+        self.min_prefill_rows = min_prefill_rows;
+        self.pf_w = null;
+        self.pf_x = null;
+        self.pf_part = null;
+        self.range = try @import("hy4_trunk_range.zig").Range.resolve(self.image);
+        inline for (.{ "trunk4", "trunk8", "trunk_pair", "trunk_glu", "trunk_down", "trunk_down8" }) |name| {
+            @field(self, name) = try self.image.function("tf_full_hy4_" ++ name);
+            try @field(self, name).allowDynamicShared(48 * 1024);
+        }
+        self.unpack_bf16 = try self.image.function("tf_full_hy4_trunk_unpack_bf16");
+        self.rot_bf16 = try self.image.function("tf_full_hy4_trunk_rot_bf16");
+        self.unrot_out = try self.image.function("tf_full_hy4_trunk_unrot_out");
+        return self;
+    }
+
+    pub fn deinit(self: *Short) void {
+        if (self.pf_w) |*b| b.free();
+        if (self.pf_x) |*b| b.free();
+        if (self.pf_part) |*b| b.free();
+        self.range.deinit();
+        self.image.unload();
+    }
+
+    fn ensureBuf(d: *const Driver, slot: *?memory.DeviceBuffer, need: usize) !u64 {
+        if (slot.*) |b| if (b.len >= need) return b.ptr;
+        const next = try memory.DeviceBuffer.alloc(d, need);
+        if (slot.*) |*old| old.free();
+        slot.* = next;
+        return next.ptr;
+    }
+
+    pub fn reservePrefill(self: *Short, w_bytes: usize, x_bytes: usize, part_bytes: usize) !void {
+        if (!self.fast_prefill) return;
+        if (w_bytes > 0) _ = try ensureBuf(self.d, &self.pf_w, w_bytes);
+        if (x_bytes > 0) _ = try ensureBuf(self.d, &self.pf_x, x_bytes);
+        if (part_bytes > 0) _ = try ensureBuf(self.d, &self.pf_part, part_bytes);
+    }
+
+    /// Prefill EXL3 path (TF_HY4_FAST_PREFILL=1, rows >= min_prefill_rows, default 256): unpack mul1 trellis
+    /// per call into a reused BF16 buffer, FWHT-rotate input in FP32->BF16 (overflow-free on L35/L76),
+    /// run cuBLASLt BF16->FP32 GEMM, then output-FWHT + svh + optional bias.
+    pub fn prefillGemm(self: *Short, gemm: *vit.Gemms, stream: Stream, w: ex.Weight, x: u64, y: u64, yd: ex.DType, rows: usize) !bool {
+        if (!self.fast_prefill or rows < self.min_prefill_rows) return false;
+        if (w.codebook != .mul1 or w.k == 0 or w.n == 0 or (w.k | w.n) % 128 != 0) return false;
+        if (w.halves != 6 and w.halves != 8 and w.halves != 12 and w.halves != 16) return false;
+
+        const w_ptr = try ensureBuf(self.d, &self.pf_w, @as(usize, w.n) * w.k * 2);
+        const x_ptr = try ensureBuf(self.d, &self.pf_x, rows * w.k * 2);
+        const p_ptr = try ensureBuf(self.d, &self.pf_part, rows * w.n * 4);
+
+        var a_unp: launch.Args = .{};
+        a_unp.add(w.trellis);
+        a_unp.add(@as(i64, @intCast(w.stride_k)));
+        a_unp.add(@as(i64, @intCast(w.stride_nb)));
+        a_unp.add(w_ptr);
+        a_unp.add(@as(i32, @intCast(w.k)));
+        a_unp.add(@as(i32, @intCast(w.n)));
+        a_unp.add(@as(i32, @intCast(w.halves)));
+        try launch.launch(self.unpack_bf16, .{ .grid = .{ .x = w.n / 128, .y = w.k / 16 }, .block = .{ .x = 256 } }, stream, &a_unp);
+
+        var a_rot: launch.Args = .{};
+        a_rot.add(x);
+        a_rot.add(w.suh);
+        a_rot.add(x_ptr);
+        a_rot.add(@as(i32, @intCast(rows)));
+        a_rot.add(@as(i32, @intCast(w.k)));
+        try launch.launch(self.rot_bf16, .{ .grid = .{ .x = (w.k / 128 + 3) / 4, .y = @intCast(rows) }, .block = .{ .x = 128 } }, stream, &a_rot);
+
+        try gemm.run(stream, x_ptr, w_ptr, p_ptr, rows, w.n, w.k, .f32);
+
+        var a_fin: launch.Args = .{};
+        a_fin.add(p_ptr);
+        a_fin.add(w.svh);
+        a_fin.add(w.bias);
+        a_fin.add(y);
+        a_fin.add(@as(i32, @backingInt(yd)));
+        a_fin.add(@as(i32, @intCast(rows)));
+        a_fin.add(@as(i32, @intCast(w.n)));
+        try launch.launch(self.unrot_out, .{ .grid = .{ .x = (w.n / 128 + 3) / 4, .y = @intCast(rows) }, .block = .{ .x = 128 } }, stream, &a_fin);
+        return true;
+    }
+
+    /// x == 0 means the fused gate/up just wrote the FP32 rotation into range scratch.
+    pub fn projectRange(self: *Short, de: *ex.Dense, stream: Stream, w: ex.Weight, x: u64, y: u64, yd: ex.DType, rows: usize) !void {
+        var offset: usize = 0;
+        while (offset < rows) : (offset += 128) {
+            const m = @min(rows - offset, 128);
+            const b = try self.range.reserve(stream, w, m);
+            const sc = try de.groupScratch(stream, &.{w}, m);
+            const elem: usize = if (yd == .f32) 4 else 2;
+            const dst = y + offset * w.n * elem;
+            const input = if (x == 0) b.rotated else x + offset * w.k * 2;
+            if (self.enabled and fitsRange(w, m)) {
+                var part = args(w, input, dst, yd, m, sc.z, sc.counters);
+                if (x == 0) part.suh = 0;
+                const f = if (ex.planOf(w).wk == 4) self.trunk_down else self.trunk_down8;
+                try enqueue(f, stream, blocks(w), rangeWorkspace(w, m), part);
+                continue;
+            }
+            try self.range.prepare(stream, w, if (x == 0) 0 else input, sc.xh, b, m);
+            var dot = w;
+            if (w.bias != 0) {
+                dot.svh = self.range.ones.?.ptr;
+                dot.bias = 0;
+            }
+            try de.lin.matmulRotated(stream, dot, m, b.partial, .f32, sc.xh, sc.z, sc.counters);
+            try self.range.finish(stream, w, dst, yd, b, m);
+        }
+    }
+
+    pub fn single(self: *const Short, de: *ex.Dense, stream: Stream, w: ex.Weight, x: u64, y: u64, yd: ex.DType, rows: usize) !bool {
+        if (!self.enabled or !fits(w, rows, true)) return false;
+        const sc = try de.groupScratch(stream, &.{w}, rows);
+        const f = if (ex.planOf(w).wk == 4) self.trunk4 else self.trunk8;
+        try enqueue(f, stream, blocks(w), workspace(w, rows, true), args(w, x, y, yd, rows, sc.z, sc.counters));
+        return true;
+    }
+
+    pub fn paired(self: *const Short, de: *ex.Dense, stream: Stream, w: [2]ex.Weight, x: u64, ys: [2]u64, rows: usize) !bool {
+        if (!self.enabled or w[0].k != w[1].k) return false;
+        for (w) |v| if (!fits(v, rows, true) or ex.planOf(v).wk != 4) return false;
+        const sc = try de.groupScratch(stream, &w, rows);
+        const p: Pair = .{ .parts = .{ args(w[0], x, ys[0], .bf16, rows, sc.z, sc.counters),
+            args(w[1], x, ys[1], .bf16, rows, sc.z + ex.Linear.zBytes(w[0], rows), sc.counters + ex.Linear.counterBytes(w[0])) },
+            .down_suh = 0, .first_blocks = @intCast(blocks(w[0])) };
+        try enqueue(self.trunk_pair, stream, blocks(w[0]) + blocks(w[1]), @max(workspace(w[0], rows, true), workspace(w[1], rows, true)), p);
+        return true;
+    }
+
+    pub fn gated(self: *Short, de: *ex.Dense, stream: Stream, gu: [2]ex.Weight, down: ex.Weight, x: u64, y: u64, rows: usize) !bool {
+        const g = gu[0];
+        if (!self.enabled or g.k != 6144 or (g.n != 512 and g.n != 2048) or g.n != down.k or down.n != g.k or
+            !fits(down, rows, false) or ex.planOf(down).wk != 4) return false;
+        for (gu) |w| if (w.k != g.k or w.n != g.n or !fits(w, rows, true) or ex.planOf(w).wk != 4 or
+            ex.planOf(w).sk != ex.planOf(g).sk or ex.planOf(w).sk == 1) return false;
+        // Allocate both requirements before capturing pointers. The final gate/up
+        // CTA clears each counter and down can reuse the buffers on the same stream.
+        _ = try de.groupScratch(stream, &.{down}, rows);
+        const sc = try de.groupScratch(stream, &gu, rows);
+        const b = try self.range.reserve(stream, down, rows);
+        const p: Pair = .{ .parts = .{ args(g, x, b.rotated, .f32, rows, sc.z, sc.counters),
+            args(gu[1], x, b.rotated, .f32, rows, sc.z, sc.counters) }, .first_blocks = @intCast(blocks(g)), .down_suh = down.suh };
+        try enqueue(self.trunk_glu, stream, 2 * blocks(g), workspace(g, rows, true), p);
+        try self.projectRange(de, stream, down, 0, y, .f32, rows);
+        return true;
+    }
+};
diff --git a/zig/src/cuda/hy4_trunk_range.zig b/zig/src/cuda/hy4_trunk_range.zig
new file mode 100644
index 0000000000000000000000000000000000000000..710b0f4e27a26b31d45027ea314abef1717212b0
--- /dev/null
+++ b/zig/src/cuda/hy4_trunk_range.zig
@@ -0,0 +1,68 @@
+//! Scratch and launches for the row-local scale around a packed Hy4 dot product.
+const ex = @import("exl3.zig");
+const memory = @import("memory.zig");
+const mod = @import("module.zig");
+const launch = @import("launch.zig");
+const Stream = @import("stream.zig").Stream;
+
+pub const Buffers = struct { rotated: u64, partial: u64, restore: u64 };
+
+pub const Range = struct {
+    prepare_fn: mod.Function,
+    finish_fn: mod.Function,
+    work: ?memory.DeviceBuffer = null,
+    ones: ?memory.DeviceBuffer = null,
+
+    pub fn resolve(image: mod.Module) !Range {
+        return .{ .prepare_fn = try image.function("tf_full_hy4_range_prepare"), .finish_fn = try image.function("tf_full_hy4_range_finish") };
+    }
+
+    pub fn deinit(self: *Range) void {
+        if (self.work) |*b| b.free();
+        if (self.ones) |*b| b.free();
+    }
+
+    pub fn reserve(self: *Range, stream: Stream, w: ex.Weight, rows: usize) !Buffers {
+        const input_bytes = rows * w.k * 4;
+        const output_bytes = rows * w.n * 4;
+        const need = input_bytes + output_bytes + rows * 4;
+        if (self.work == null or self.work.?.len < need) {
+            const b = try memory.DeviceBuffer.alloc(stream.d, need);
+            if (self.work) |*old| old.free();
+            self.work = b;
+        }
+        // For a biased projection, restore the dot before the original scale and bias.
+        if (w.bias != 0 and (self.ones == null or self.ones.?.len < w.n * 2)) {
+            var b = try memory.DeviceBuffer.alloc(stream.d, w.n * 2);
+            errdefer b.free();
+            try b.fill32(0x3c003c00, stream.handle);
+            if (self.ones) |*old| old.free();
+            self.ones = b;
+        }
+        const rotated = self.work.?.ptr;
+        return .{ .rotated = rotated, .partial = rotated + input_bytes, .restore = rotated + input_bytes + output_bytes };
+    }
+
+    pub fn prepare(self: *const Range, stream: Stream, w: ex.Weight, x: u64, xh: u64, b: Buffers, rows: usize) !void {
+        var a: launch.Args = .{};
+        a.add(x);
+        a.add(if (x == 0) @as(u64, 0) else w.suh);
+        a.add(b.rotated);
+        a.add(xh);
+        a.add(b.restore);
+        a.add(w.k);
+        try launch.launch(self.prepare_fn, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 256 } }, stream, &a);
+    }
+
+    pub fn finish(self: *const Range, stream: Stream, w: ex.Weight, y: u64, yd: ex.DType, b: Buffers, rows: usize) !void {
+        var a: launch.Args = .{};
+        a.add(b.partial);
+        a.add(b.restore);
+        a.add(w.svh);
+        a.add(w.bias);
+        a.add(y);
+        a.add(@as(i32, @backingInt(yd)));
+        a.add(w.n);
+        try launch.launch(self.finish_fn, .{ .grid = .{ .x = (w.n + 1023) / 1024, .y = @intCast(rows) }, .block = .{ .x = 256 } }, stream, &a);
+    }
+};
diff --git a/zig/src/cuda/hy4_vision.zig b/zig/src/cuda/hy4_vision.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4584019998d101fdbe2ac8811c1546d2e0ee13cf
--- /dev/null
+++ b/zig/src/cuda/hy4_vision.zig
@@ -0,0 +1,200 @@
+//! Full Hy4 vision tower and 3D interleaved M-RoPE CUDA kernel module (`zig/kernels/cuda/hy4/vision.cu`).
+const std = @import("std");
+const kernels = @import("kernels.zig");
+const module = @import("module.zig");
+const launch_ = @import("launch.zig");
+const stream_ = @import("stream.zig");
+const hy4_ops = @import("hy4_ops.zig");
+
+const Driver = @import("driver.zig").Driver;
+const Stream = stream_.Stream;
+const Function = module.Function;
+
+pub const Kernels = struct {
+    mod: module.Module,
+    pos_add_fn: Function,
+    qkv_pack_fn: Function,
+    attn96_fn: Function,
+    merge_gather_fn: Function,
+    append_newline_fn: Function,
+    splice_ihc_fn: Function,
+    mrope_mla_fn: Function,
+    mrope_index_prepare_fn: Function,
+
+    pub fn load(d: *const Driver) !Kernels {
+        if (!kernels.available) return error.BuiltWithoutKernels;
+        var mod = try module.Module.load(d, kernels.full_hy4_vision);
+        errdefer mod.unload();
+        return .{
+            .mod = mod,
+            .pos_add_fn = try mod.function("tf_hy4_vit_pos_add"),
+            .qkv_pack_fn = try mod.function("tf_hy4_vit_qkv_pack"),
+            .attn96_fn = try mod.function("tf_hy4_vit_attention96"),
+            .merge_gather_fn = try mod.function("tf_hy4_vit_merge_gather"),
+            .append_newline_fn = try mod.function("tf_hy4_vit_append_newline"),
+            .splice_ihc_fn = try mod.function("tf_hy4_vision_splice_ihc"),
+            .mrope_mla_fn = try mod.function("tf_hy4_mrope_mla_overwrite"),
+            .mrope_index_prepare_fn = try mod.function("tf_hy4_mrope_index_prepare"),
+        };
+    }
+
+    pub fn unload(self: *Kernels) void {
+        self.mod.unload();
+        self.* = undefined;
+    }
+
+    pub fn posAdd(self: *const Kernels, s: Stream, patch_embeds: u64, pos_table: u64, out: u64, gh: usize, gw: usize, edge: usize, d_model: usize) !void {
+        const rows = gh * gw;
+        if (rows == 0 or edge == 0 or d_model == 0) return error.BadHy4VisionShape;
+        try run(self.pos_add_fn, s, .{ .x = @intCast(rows) }, 256, .{
+            patch_embeds, pos_table, out,
+            @as(i32, @intCast(gh)), @as(i32, @intCast(gw)), @as(i32, @intCast(edge)), @as(i32, @intCast(d_model)),
+        });
+    }
+
+    pub fn qkvPack(self: *const Kernels, s: Stream, q_in: u64, k_in: u64, v_in: u64, q_out: u64, k_out: u64, v_out: u64, rows: usize, heads: usize, hd: usize) !void {
+        if (rows == 0 or heads == 0 or hd == 0) return error.BadHy4VisionShape;
+        try run(self.qkv_pack_fn, s, .{ .x = @intCast(rows), .y = @intCast(heads) }, 128, .{
+            q_in, k_in, v_in, q_out, k_out, v_out,
+            @as(i32, @intCast(rows)), @as(i32, @intCast(heads)), @as(i32, @intCast(hd)),
+        });
+    }
+
+    pub fn attention96(self: *const Kernels, s: Stream, q: u64, k: u64, v: u64, out: u64, rows: usize, heads: usize, scale: f32) !void {
+        if (rows == 0 or heads == 0) return error.BadHy4VisionShape;
+        try run(self.attn96_fn, s, .{ .x = @intCast((rows + 63) / 64), .y = @intCast(heads) }, 64, .{
+            q, k, v, out, @as(i32, @intCast(rows)), @as(i32, @intCast(heads)), scale,
+        });
+    }
+
+    pub fn mergeGather(self: *const Kernels, s: Stream, x: u64, out: u64, gh: usize, gw: usize, d_in: usize) !void {
+        if (gh < 2 or gw < 2 or gh % 2 != 0 or gw % 2 != 0 or d_in == 0) return error.BadHy4VisionShape;
+        const merged = (gh / 2) * (gw / 2);
+        try run(self.merge_gather_fn, s, .{ .x = @intCast(merged) }, 256, .{
+            x, out, @as(i32, @intCast(gh)), @as(i32, @intCast(gw)), @as(i32, @intCast(d_in)),
+        });
+    }
+
+    pub fn appendNewline(self: *const Kernels, s: Stream, merged: u64, newline: u64, out: u64, hm: usize, wm: usize, d_out: usize) !void {
+        if (hm == 0 or wm == 0 or d_out == 0) return error.BadHy4VisionShape;
+        try run(self.append_newline_fn, s, .{ .x = @intCast(hm * (wm + 1)) }, 256, .{
+            merged, newline, out, @as(i32, @intCast(hm)), @as(i32, @intCast(wm)), @as(i32, @intCast(d_out)),
+        });
+    }
+
+    pub fn spliceIhc(self: *const Kernels, s: Stream, img_rows: u64, row_map: u64, streams_a: u64, rows: usize, width: usize) !void {
+        if (rows == 0 or width == 0) return;
+        try run(self.splice_ihc_fn, s, .{ .x = @intCast(rows), .y = @intCast((4 * width + 255) / 256) }, 256, .{
+            img_rows, row_map, streams_a, @as(i32, @intCast(rows)), @as(i32, @intCast(width)),
+        });
+    }
+
+    pub fn mropeMlaOverwrite(self: *const Kernels, s: Stream, shape: hy4_ops.MlaShape, b: hy4_ops.MlaProject, thw_ptr: u64, rope_delta: i32) !void {
+        if (shape.rows == 0 or shape.heads == 0 or shape.rope != 64) return error.BadHy4MlaShape;
+        const q_head: u32 = if (shape.q_head_stride != 0) shape.q_head_stride else shape.nope + shape.rope;
+        const q_row: u32 = if (shape.q_row_stride != 0) shape.q_row_stride else shape.heads * q_head;
+        const out_head: u32 = if (shape.absorbed_head_stride != 0) shape.absorbed_head_stride else shape.latent + shape.rope;
+        const out_row: u32 = if (shape.absorbed_row_stride != 0) shape.absorbed_row_stride else shape.heads * out_head;
+        const kv_stride: u32 = if (shape.kv_row_stride != 0) shape.kv_row_stride else shape.latent + shape.rope;
+        const cache_stride: u32 = if (shape.cache_stride != 0) shape.cache_stride else shape.latent + shape.rope;
+        try run(self.mrope_mla_fn, s, .{ .x = shape.rows, .y = shape.heads + 1 }, 32, .{
+            b.q, b.kv, b.absorbed_q, b.cache, thw_ptr,
+            shape.heads, shape.rows, q_row, q_head, out_row, out_head, kv_stride, cache_stride,
+            shape.latent, shape.nope, shape.rope, shape.first_pos, rope_delta, shape.theta,
+        });
+    }
+
+    pub fn selectTokensWindowMrope(self: *const Kernels, ops: *const hy4_ops.Kernels, s: Stream, shape: hy4_ops.IndexShape, b: hy4_ops.IndexBuffers, cache_start: u32, thw_ptr: u64, rope_delta: i32) !void {
+        const index_rows: u32 = 64;
+        const index_page: u32 = 2048;
+        if (shape.rows == 0 or cache_start > shape.first_pos or shape.first_pos >= shape.capacity or
+            shape.rows > shape.capacity - shape.first_pos or shape.top_k == 0 or shape.top_k > index_page or
+            shape.heads == 0 or shape.heads > 32 or shape.dim == 0 or shape.dim > 128 or shape.rope != 64)
+            return error.BadHy4IndexShape;
+        const rows_cap: usize = @min(shape.rows, index_rows);
+        const q_len = rows_cap * shape.heads * shape.dim;
+        const query_off = q_len * 4;
+        const weights_off = std.mem.alignForward(usize, query_off + q_len * 2, 4);
+        const scores_off = weights_off + rows_cap * shape.heads * 4;
+        var page_w: u32 = if (shape.first_pos + shape.rows - cache_start >= 8192) 8192 else index_page;
+        var pitch: u32 = shape.top_k + @min(page_w, shape.capacity);
+        var picks_off = std.mem.alignForward(usize, scores_off + rows_cap * pitch * 4, 8);
+        if (b.scratch_bytes < picks_off + rows_cap * shape.top_k * 8) {
+            page_w = index_page;
+            pitch = shape.top_k + @min(page_w, shape.capacity);
+            picks_off = std.mem.alignForward(usize, scores_off + rows_cap * pitch * 4, 8);
+            if (b.scratch_bytes < picks_off + rows_cap * shape.top_k * 8) return error.BadHy4Scratch;
+        }
+        const raw = b.scratch;
+        const q = b.scratch + query_off;
+        const w = b.scratch + weights_off;
+        const scores = b.scratch + scores_off;
+        const picks = b.scratch + picks_off;
+        const x_pitch: u32 = if (shape.x_row_stride != 0) shape.x_row_stride else shape.width;
+        const q_pitch: u32 = if (shape.q_row_stride != 0) shape.q_row_stride else shape.q_rank;
+        const cache_pitch: u32 = if (shape.cache_stride != 0) shape.cache_stride else shape.dim;
+        const id_pitch: u32 = if (shape.indices_stride != 0) shape.indices_stride else shape.top_k;
+        const cols = shape.heads * shape.dim;
+        var row: u32 = 0;
+        while (row < shape.rows) {
+            const rows: u32 = @min(index_rows, shape.rows - row);
+            const first = shape.first_pos + row;
+            const end = first + rows;
+            const x = b.x + @as(u64, row) * x_pitch * 2;
+            const cache = b.cache + @as(u64, first) * cache_pitch * 2;
+            const ids = b.indices + @as(u64, row) * id_pitch * 4;
+            const thw_sub: u64 = if (thw_ptr != 0) thw_ptr + @as(u64, row) * 3 * 4 else 0;
+            try indexLinear(ops, s, x, b.wk, raw, x_pitch, shape.width, shape.dim, rows, false);
+            try run(self.mrope_index_prepare_fn, s, .{ .x = rows, .y = 1 }, 128, .{
+                raw, b.k_norm, b.k_bias, cache, thw_sub,
+                @as(u32, 1), shape.dim, shape.rope, cache_pitch, first, rope_delta, shape.theta, shape.norm_eps,
+            });
+            const prune = end - cache_start > shape.top_k;
+            if (prune) {
+                const resid = b.q_resid + @as(u64, row) * q_pitch * 2;
+                try indexLinear(ops, s, resid, b.wq_b, raw, q_pitch, shape.q_rank, cols, rows, false);
+                try run(self.mrope_index_prepare_fn, s, .{ .x = rows, .y = shape.heads }, 128, .{
+                    raw, @as(u64, 0), @as(u64, 0), q, thw_sub,
+                    shape.heads, shape.dim, shape.rope, cols, first, rope_delta, shape.theta, shape.norm_eps,
+                });
+                try indexLinear(ops, s, x, b.weights_proj, w, x_pitch, shape.width, shape.heads, rows, true);
+            }
+            var page = cache_start;
+            while (page < end) {
+                const count: u32 = @min(pitch - shape.top_k, end - page);
+                const block_keys: u32 = if (shape.heads == 32 and shape.dim == 128 and count >= 16) 16 else 4;
+                if (block_keys == 16 and prune and rows >= 2 and rows <= 16) {
+                    const warps: u32 = if (rows <= 2) 2 else if (rows <= 4) 4 else 8;
+                    try run(ops.index_scores_rows, s, .{ .x = (count + 7) / 8, .y = (rows + warps - 1) / warps }, warps * 32, .{
+                        q, b.cache, w, scores, cache_pitch, pitch, first, cache_start, page, count, shape.top_k, rows,
+                    });
+                } else if (prune) {
+                    try run(ops.index_scores, s, .{ .x = (count + block_keys - 1) / block_keys, .y = rows }, if (block_keys == 16) 64 else 128, .{
+                        q, b.cache, w, scores, shape.heads, shape.dim, cache_pitch, pitch, first, cache_start, page, count, shape.top_k,
+                    });
+                }
+                try run(ops.index_select, s, .{ .x = rows }, 256, .{
+                    scores, picks, ids, pitch, id_pitch, first, cache_start, page, count, shape.top_k,
+                });
+                page += count;
+            }
+            row += rows;
+        }
+    }
+};
+
+fn indexLinear(ops: *const hy4_ops.Kernels, s: Stream, x: u64, w: u64, out: u64, pitch: u32, width: u32, columns: u32, rows: u32, fp32_weight: bool) !void {
+    if (!fp32_weight and width % 16 == 0 and pitch % 8 == 0 and pitch <= std.math.maxInt(i32) and (x | w) % 16 == 0) {
+        return ops.router.logits(s, x, pitch, w, out, rows, width, columns);
+    }
+    const tile: u32 = if (!fp32_weight and width % 16 == 0) 32 else 4;
+    try run(ops.index_linear, s, .{ .x = (columns + tile - 1) / tile, .y = rows }, 128, .{
+        x, w, out, pitch, width, columns, @as(u32, @intFromBool(fp32_weight)),
+    });
+}
+
+fn run(f: Function, stream: Stream, grid: launch_.Dim3, threads: u32, values: anytype) !void {
+    var args: launch_.Args = .{};
+    inline for (values) |v| args.add(v);
+    try launch_.launch(f, .{ .grid = grid, .block = .{ .x = threads } }, stream, &args);
+}
