+        try core.shard_edit.create(gpa, try sub(a, src, try std.fmt.allocPrint(a, "trunk-4b/{s}", .{shard})), &.{}, s4.items);
+        try core.shard_edit.create(gpa, try sub(a, src, try std.fmt.allocPrint(a, "trunk-6b/{s}", .{shard})), &.{}, s6.items);
+    }
+    var h4: std.ArrayList(core.shard_edit.New) = .empty;
+    try addExl3Mat(a, &h4, &wm4, &m4, "lm_head.safetensors", "lm_head", 512, 512, 8, rnd);
