+//! nvcc 13.0.88 and 13.3.73 with the per-image release flags on sm_80,86,89,120,121.
+//! Static shared bytes exclude the driver's reserved KiB on Blackwell.
+const std = @import("std");
+
+const Record = struct {
+    image: []const u8,
+    symbol: []const u8,
+    threads: u32,
+    shared: u32,
+    dynamic: u32 = 0,
+    regs: [5]u32,
+    regs_133: ?[5]u32 = null,
+};
+
+const records = [_]Record{
