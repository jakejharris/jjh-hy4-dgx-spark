+//! Cross-review regressions for cached BF16 keys and a non-tied top-1 selection.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = cuda.hy4_ops;
+const Rig = @import("rig").Rig;
+const bf = @import("bf16_round");
+const t = std.testing;
+
+fn zeros(a: std.mem.Allocator, comptime T: type, n: usize) ![]T {
+    const out = try a.alloc(T, n);
+    @memset(out, 0);
+    return out;
+}
+
+fn download(r: *Rig, a: std.mem.Allocator, comptime T: type, ptr: u64, n: usize) ![]T {
+    const out = try a.alloc(T, n);
+    @memcpy(std.mem.sliceAsBytes(out), try r.bytes(ptr, n * @sizeOf(T)));
+    return out;
+}
+
+pub fn views(r: *Rig, k: *const ops.Kernels) !void {
+    var pool = std.heap.ArenaAllocator.init(t.allocator);
+    defer pool.deinit();
+    const a = pool.allocator();
+
+    const rows = 24;
+    const keep = 16;
+    var prng = std.Random.DefaultPrng.init(0x5eed1234);
+    const rnd = prng.random();
+
+    const x_tight = try a.alloc(u16, rows * 6144);
+    const q_tight = try a.alloc(u16, rows * 2048);
+    for (x_tight) |*v| v.* = bf.bits((rnd.float(f32) * 3.0) - 1.5);
+    for (q_tight) |*v| v.* = bf.bits((rnd.float(f32) * 3.0) - 1.5);
+
+    const wk = try a.alloc(u16, 128 * 6144);
+    const wq = try a.alloc(u16, 32 * 128 * 2048);
+    const head = try a.alloc(f32, 32 * 6144);
+    for (wk) |*v| v.* = bf.bits((rnd.float(f32) * 0.5) - 0.25);
+    for (wq) |*v| v.* = bf.bits((rnd.float(f32) * 0.5) - 0.25);
+    for (head) |*v| v.* = (rnd.float(f32) * 0.5) - 0.25;
+    var norm: [128]f32 = undefined;
+    var bias: [128]f32 = undefined;
+    for (&norm, &bias) |*n, *b_val| {
+        n.* = 0.8 + rnd.float(f32) * 0.4;
+        b_val.* = (rnd.float(f32) - 0.5) * 0.1;
+    }
+
+    const base_shape: ops.IndexShape = .{
+        .rows = rows,
+        .first_pos = 0,
+        .capacity = rows,
+        .top_k = keep,
+        .width = 6144,
+        .q_rank = 2048,
+        .heads = 32,
+        .dim = 128,
+        .rope = 64,
+        .x_row_stride = 6144,
+        .q_row_stride = 2048,
+        .cache_stride = 128,
+        .indices_stride = keep,
+    };
+    const scratch_n = try ops.indexScratchBytes(base_shape);
+    const wk_dev = try r.input(std.mem.sliceAsBytes(wk));
+    const wq_dev = try r.input(std.mem.sliceAsBytes(wq));
+    const kn_dev = try r.input(std.mem.asBytes(&norm));
+    const kb_dev = try r.input(std.mem.asBytes(&bias));
+    const wp_dev = try r.input(std.mem.sliceAsBytes(head));
+
+    // Case A: 16-byte aligned, x_row_stride=6144, q_row_stride=2048 -> runs k.router.logits (BF16 MMA)
+    const b_mma: ops.IndexBuffers = .{
+        .q_resid = try r.input(std.mem.sliceAsBytes(q_tight)),
+        .x = try r.input(std.mem.sliceAsBytes(x_tight)),
+        .wq_b = wq_dev,
+        .wk = wk_dev,
+        .k_norm = kn_dev,
+        .k_bias = kb_dev,
+        .weights_proj = wp_dev,
+        .cache = try r.output(rows * 128 * 2),
+        .indices = try r.output(rows * keep * 4),
+        .scratch = try r.scratch(scratch_n),
+        .scratch_bytes = scratch_n,
+    };
+    try t.expectEqual(@as(u64, 0), b_mma.x % 16);
+    try t.expectEqual(@as(u64, 0), b_mma.q_resid % 16);
+    try ops.selectTokens(k, r.s, base_shape, b_mma);
+    const cache_mma = try download(r, a, u16, b_mma.cache, rows * 128);
+    const ids_mma = try download(r, a, i32, b_mma.indices, rows * keep);
+
+    // Case B: Identical values shifted by +4 BF16 words (+8 bytes -> ptr % 16 == 8, valid 2-byte aligned!)
+    const x_off = try a.alloc(u16, 4 + rows * 6144);
+    @memset(x_off[0..4], 0);
+    @memcpy(x_off[4..], x_tight);
+    const q_off = try a.alloc(u16, 4 + rows * 2048);
+    @memset(q_off[0..4], 0);
+    @memcpy(q_off[4..], q_tight);
+    var b_unaligned = b_mma;
+    b_unaligned.x = (try r.input(std.mem.sliceAsBytes(x_off))) + 8;
+    b_unaligned.q_resid = (try r.input(std.mem.sliceAsBytes(q_off))) + 8;
+    b_unaligned.cache = try r.output(rows * 128 * 2);
+    b_unaligned.indices = try r.output(rows * keep * 4);
+    try t.expectEqual(@as(u64, 8), b_unaligned.x % 16);
+    try ops.selectTokens(k, r.s, base_shape, b_unaligned);
+    const cache_unaligned = try download(r, a, u16, b_unaligned.cache, rows * 128);
+    const ids_unaligned = try download(r, a, i32, b_unaligned.indices, rows * keep);
+
+    // Case C: 16-byte aligned, x_row_stride=6148, q_row_stride=2052
+    const x_strided = try zeros(a, u16, rows * 6148);
+    const q_strided = try zeros(a, u16, rows * 2052);
+    for (0..rows) |row| {
+        @memcpy(x_strided[row * 6148 ..][0..6144], x_tight[row * 6144 ..][0..6144]);
+        @memcpy(q_strided[row * 2052 ..][0..2048], q_tight[row * 2048 ..][0..2048]);
+    }
+    var strided_shape = base_shape;
+    strided_shape.x_row_stride = 6148;
+    strided_shape.q_row_stride = 2052;
+    var b_strided = b_mma;
+    b_strided.x = try r.input(std.mem.sliceAsBytes(x_strided));
+    b_strided.q_resid = try r.input(std.mem.sliceAsBytes(q_strided));
+    b_strided.cache = try r.output(rows * 128 * 2);
+    b_strided.indices = try r.output(rows * keep * 4);
+    try ops.selectTokens(k, r.s, strided_shape, b_strided);
+    const cache_strided = try download(r, a, u16, b_strided.cache, rows * 128);
+    const ids_strided = try download(r, a, i32, b_strided.indices, rows * keep);
+
+    var cache_diffs: usize = 0;
+    for (cache_mma, cache_unaligned) |u, v| cache_diffs += @intFromBool(u != v);
+    var id_diffs: usize = 0;
+    for (ids_mma, ids_unaligned) |u, v| id_diffs += @intFromBool(u != v);
+    try t.expectEqualSlices(u16, cache_unaligned, cache_strided);
+    try t.expectEqualSlices(i32, ids_unaligned, ids_strided);
+
+    std.debug.print(
+        "Hy4 aligned, offset and padded BF16 projections (24 rows, K=16): cache_bf16_diffs={d}/{d}, selected_id_diffs={d}/{d}\n",
+        .{ cache_diffs, cache_mma.len, id_diffs, ids_mma.len },
+    );
+
+    try t.expectEqual(@as(usize, 0), cache_diffs);
+    try t.expectEqual(@as(usize, 0), id_diffs);
+    try t.expect(try r.intact());
+    r.reset();
+    try nonTiedPick(r, k);
+}
+
+fn nonTiedPick(r: *Rig, k: *const ops.Kernels) !void {
+    var pool = std.heap.ArenaAllocator.init(t.allocator);
+    defer pool.deinit();
+    const a = pool.allocator();
+
+    const rows = 3;
+    const keep = 1;
+    const shape: ops.IndexShape = .{
+        .rows = rows,
+        .first_pos = 0,
+        .capacity = rows,
+        .top_k = keep,
+        .width = 6144,
+        .q_rank = 2048,
+        .heads = 32,
+        .dim = 128,
+        .rope = 64,
+        .x_row_stride = 6144,
+        .q_row_stride = 2048,
+        .cache_stride = 128,
+        .indices_stride = keep,
+    };
+    const q = try zeros(a, u16, rows * 2048);
+    const wq = try zeros(a, u16, 32 * 128 * 2048);
+    const row2 = 2 * 2048;
+    for (0..16) |i| {
+        q[row2 + i] = bf.bits(1.0);
+        wq[i] = bf.bits(1.0);
+        q[row2 + 32 + i] = bf.bits(-1.0);
+        wq[32 + i] = bf.bits(1.0);
+    }
+    q[row2 + 16] = bf.bits(1.0);
+    wq[16] = bf.bits(1.0);
+    q[row2 + 17] = bf.bits(0.0625);
+    wq[17] = bf.bits(0.0625);
+    q[row2 + 18] = bf.bits(1.0 / 1024.0);
+    wq[18] = bf.bits(1.0 / 1024.0);
+    q[row2 + 19] = bf.bits(1.0);
+    wq[1 * 2048 + 19] = bf.bits(1.0);
+
+    const x = try zeros(a, u16, rows * 6144);
+    const wk = try zeros(a, u16, 128 * 6144);
+    x[0 * 6144 + 0] = bf.bits(1.0);
+    x[1 * 6144 + 1] = bf.bits(1.0);
+    x[2 * 6144 + 2] = bf.bits(1.0);
+    wk[0 * 6144 + 0] = bf.bits(1.0);
+    wk[2 * 6144 + 0] = bf.bits(-1.0);
+    wk[0 * 6144 + 1] = bf.bits(0.25);
+    wk[1 * 6144 + 1] = bf.bits(0.75);
+    wk[2 * 6144 + 1] = bf.bits(-0.5);
+    wk[3 * 6144 + 1] = bf.bits(-0.5);
+
+    var norm: [128]f32 = @splat(0);
+    const bias: [128]f32 = @splat(0);
+    norm[0] = 0.1250400;
+    norm[1] = 0.0835435;
+
+    const head = try zeros(a, f32, 32 * 6144);
+    head[0 * 6144 + 2] = 1.0;
+
+    const n = try ops.indexScratchBytes(shape);
+    const b_aligned: ops.IndexBuffers = .{
+        .q_resid = try r.input(std.mem.sliceAsBytes(q)),
+        .x = try r.input(std.mem.sliceAsBytes(x)),
+        .wq_b = try r.input(std.mem.sliceAsBytes(wq)),
+        .wk = try r.input(std.mem.sliceAsBytes(wk)),
+        .k_norm = try r.input(std.mem.asBytes(&norm)),
+        .k_bias = try r.input(std.mem.asBytes(&bias)),
+        .weights_proj = try r.input(std.mem.sliceAsBytes(head)),
+        .cache = try r.output(rows * 128 * 2),
+        .indices = try r.output(rows * keep * 4),
+        .scratch = try r.scratch(n),
+        .scratch_bytes = n,
+    };
+    try ops.selectTokens(k, r.s, shape, b_aligned);
+    const pick_mma = (try download(r, a, i32, b_aligned.indices, rows))[2];
+
+    const q_pad = try a.alloc(u16, 4 + rows * 2048);
+    @memset(q_pad[0..4], 0);
+    @memcpy(q_pad[4..], q);
+    var b_off8 = b_aligned;
+    b_off8.q_resid = (try r.input(std.mem.sliceAsBytes(q_pad))) + 8;
+    b_off8.cache = try r.output(rows * 128 * 2);
+    b_off8.indices = try r.output(rows * keep * 4);
+    try ops.selectTokens(k, r.s, shape, b_off8);
+    const pick_off8 = (try download(r, a, i32, b_off8.indices, rows))[2];
+
+    std.debug.print("Hy4 non-tied top-1 row 2: aligned={d}, offset8={d}\n", .{ pick_mma, pick_off8 });
+    try t.expectEqual(@as(i32, 1), pick_mma);
+    try t.expectEqual(pick_mma, pick_off8);
+}
+
+// Compare the multi-row checkpoint specialization with one-row launches of the
+// original arithmetic before top-k can conceal differences in FP32 scores.
+pub fn pages(r: *Rig, k: *const ops.Kernels) !void {
+    var pool = std.heap.ArenaAllocator.init(t.allocator);
+    defer pool.deinit();
+    const a = pool.allocator();
+    const rows: u32 = 7;
+    const keys: u32 = 139;
+    const first: u32 = 134;
+    const pitch: u32 = 151;
+    var prng = std.Random.DefaultPrng.init(20261125);
+    const q = try a.alloc(u16, rows * 32 * 128);
+    const cache = try a.alloc(u16, keys * 131);
+    const weights = try a.alloc(f32, rows * 32);
+    for (q) |*v| v.* = bf.bits(prng.random().float(f32) * 8 - 4);
+    for (cache) |*v| v.* = bf.bits(prng.random().float(f32) * 8 - 4);
+    for (weights) |*v| v.* = prng.random().float(f32) * 4 - 2;
+    const qd = try r.input(std.mem.sliceAsBytes(q));
+    const cd = try r.input(std.mem.sliceAsBytes(cache));
+    const wd = try r.input(std.mem.sliceAsBytes(weights));
+    for ([2]u32{ 0, 7 }) |page| {
+        const count = keys - page;
+        const fused = try r.output(rows * pitch * 4);
+        const base = try r.output(rows * pitch * 4);
+        for (0..rows + 1) |i| {
+            const row: u32 = if (i == 0) 0 else @intCast(i - 1);
+            var args: cuda.launch.Args = .{};
+            const out = if (i == 0) fused else base + 4 * row * pitch;
+            inline for (.{ qd + 2 * row * 32 * 128, cd, wd + 4 * row * 32, out, @as(u32, 32), @as(u32, 128), @as(u32, 131), pitch, first + row, @as(u32, 0), page, count, @as(u32, 5) }) |v| args.add(v);
+            const block: u32 = if (i == 0) 16 else 4;
+            try cuda.launch.launch(k.index_scores, .{ .grid = .{ .x = (count + block - 1) / block, .y = if (i == 0) rows else 1 }, .block = .{ .x = if (i == 0) 64 else 128 } }, r.s, &args);
+        }
+        const ref = try a.dupe(u8, try r.bytes(base, rows * pitch * 4));
+        try t.expectEqualSlices(u8, ref, try r.bytes(fused, ref.len));
+    }
+}
