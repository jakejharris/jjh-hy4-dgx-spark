+fn loadMixedDigest(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, trunk: ?[]const u8, head: ?[]const u8, rank: usize, exp_mats: usize) ![32]u8 {
+    var idx = try weights.ShardIndex.openWithTrunkAndHead(gpa, io, dir, null, trunk, head, null);
+    defer idx.deinit();
+    const mock = cache.TestMock;
+    var d = mock.init();
+    var h = std.crypto.hash.sha2.Sha256.init(.{});
+    mock.digest = &h;
+    defer mock.digest = null;
+    const st = try weights.checkLoadRank(gpa, io, &d, &idx, null, null, false, try ranks.Rank.init(rank, 4));
+    try std.testing.expect(st.has_trunk and st.has_head and st.n_dense == 1 and st.n_bf16 == 3);
+    try std.testing.expectEqual(@as(usize, 4), st.n_trunk_exl3);
+    try std.testing.expectEqual(exp_mats, st.trunk_exl3_mats);
+    return h.finalResult();
+}
