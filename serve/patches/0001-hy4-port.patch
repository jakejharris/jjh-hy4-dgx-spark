+test "RowPositionGuard covers the entire image request including post-image text chunks and decode, then restores switches for text-only requests" {
+    const gpa = std.testing.allocator;
+    // Simulate V6 voxel turn: 11,600 tokens (3x 1,288-row images + 7,736 text tokens).
+    const imgs = [_]lanes.stream.Image{
+        .{ .pixels = &.{}, .gh = 56, .gw = 90, .at = 120, .tokens = 1288 },
+        .{ .pixels = &.{}, .gh = 56, .gw = 90, .at = 1448, .tokens = 1288 },
+        .{ .pixels = &.{}, .gh = 56, .gw = 90, .at = 2776, .tokens = 1288 },
+    };
+    const prompt_len: usize = 11_600;
+    var plan = try vision_image.buildMropePlan(gpa, prompt_len, &imgs, 2, 16384);
+    defer plan.deinit(gpa);
+    try std.testing.expectEqual(@as(u32, 3864), plan.total_image_tokens);
+    try std.testing.expectEqual(@as(i32, -3 * (1288 - 46)), plan.rope_delta);
+
+    var slot: vision_runtime.SlotState = .{ .rows_dev = undefined };
+    defer {
+        slot.thw_host.deinit(gpa);
+        slot.spans.deinit(gpa);
+    }
+    try vision_runtime.stageAndFanOutSlot(&slot, gpa, 0, prompt_len, plan, 16, null, null, null, null, null);
+    try std.testing.expect(slot.active);
+
+    const MockOps = struct {
+        fast_prefill: bool = true,
+        fast_routed: bool = true,
+        fast_mla: bool = true,
+        fast_indexer: bool = true,
+    };
+    var ops: MockOps = .{};
+    var vk: cuda.hy4_vision.Kernels = undefined;
+    var host_map: [2048]i32 = undefined;
+
+    // Step through all six 2,048-row prefill chunks (chunks 2..5 at rows 4,096..11,600 are 100% post-image text!).
+    var pos: usize = 0;
+    var pure_text_tail_chunks: usize = 0;
+    while (pos < prompt_len) {
+        const rows = @min(@as(usize, 2048), prompt_len - pos);
+        const cp = try slot.planChunk(pos, rows, &host_map);
+        try std.testing.expect(cp.active);
+        try std.testing.expect(cp.thw_slice != null);
+        if (pos >= 4096) {
+            pure_text_tail_chunks += 1;
+            try std.testing.expect(!cp.has_overlap);
+            for (0..rows) |r| {
+                const want_pos: i32 = @as(i32, @intCast(pos + r)) + plan.rope_delta;
+                try std.testing.expectEqual(want_pos, cp.thw_slice.?[r * 3 + 0]);
+                try std.testing.expectEqual(want_pos, cp.thw_slice.?[r * 3 + 1]);
+                try std.testing.expectEqual(want_pos, cp.thw_slice.?[r * 3 + 2]);
+            }
+        }
+        const mrope = vision_runtime.LanePositions.forStep(&vk, 0x1000, cp.prompt_len, cp.rope_delta);
+        const g = vision_runtime.enterRowPositionGuard(&ops, &mrope);
+        try std.testing.expect(g.active);
+        try std.testing.expect(!ops.fast_prefill and !ops.fast_mla and !ops.fast_indexer and ops.fast_routed);
+        g.leave(&ops);
+        try std.testing.expect(ops.fast_prefill and ops.fast_mla and ops.fast_indexer and ops.fast_routed);
+        pos += rows;
+    }
+    try std.testing.expectEqual(@as(usize, 4), pure_text_tail_chunks);
+
+    // Decode/verify steps past prompt_len keep guard active with thw_slice == null and shifted rope_delta.
+    const cp_dec = try slot.planChunk(prompt_len, 7, &host_map);
+    try std.testing.expect(cp_dec.active and cp_dec.thw_slice == null and cp_dec.rope_delta == plan.rope_delta);
+    const mrope_dec = vision_runtime.LanePositions.forStep(&vk, 0, cp_dec.prompt_len, cp_dec.rope_delta);
+    const g_dec = vision_runtime.enterRowPositionGuard(&ops, &mrope_dec);
+    try std.testing.expect(g_dec.active and !ops.fast_prefill and !ops.fast_mla and !ops.fast_indexer);
+    g_dec.leave(&ops);
+
+    // Next text-only request on same slot: reset() clears active and restores fast switches.
+    slot.reset();
+    const cp_txt = try slot.planChunk(0, 2048, &host_map);
+    try std.testing.expect(!cp_txt.active and cp_txt.thw_slice == null);
+    const g_txt = vision_runtime.enterRowPositionGuard(&ops, null);
+    try std.testing.expect(!g_txt.active and ops.fast_prefill and ops.fast_mla and ops.fast_indexer and ops.fast_routed);
+    g_txt.leave(&ops);
+}
