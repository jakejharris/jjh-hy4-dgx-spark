@@ -0,0 +1,35 @@
+//! Metal launch for Hy4-flash's FP32 sparse-index key pooling.
+const mtl = @import("metal");
+const groups = @import("index_groups.zig");
+const sources = @import("kernel_sources");
+
+pub const Ref = struct { buffer: mtl.Buffer, offset: usize = 0 };
+pub const Bindings = struct { values: Ref, gates: Ref, position_bias: Ref, pooled: Ref };
+
+pub const Pool = struct {
+    pipeline: mtl.Pipeline,
+
+    pub fn load(device: mtl.Device) !Pool {
+        const library = try mtl.Library.fromSource(device, sources.hy4_flash_indexpool, mtl.CompileOptions.mlx());
+        defer library.deinit();
+        return fromLibrary(device, library);
+    }
+
+    pub fn fromLibrary(device: mtl.Device, library: mtl.Library) !Pool {
+        return .{ .pipeline = try mtl.Pipeline.init(device, library, "tf_hy4_pool_groups", false) };
+    }
+
+    pub fn deinit(self: *Pool) void {
+        self.pipeline.deinit();
+    }
+
+    pub fn run(self: Pool, encoder: mtl.ComputeEncoder, refs: Bindings, shape: groups.PoolShape) void {
+        if (shape.groups == 0 or shape.width == 0) return;
+        encoder.setPipeline(self.pipeline);
+        for ([_]Ref{ refs.values, refs.gates, refs.position_bias, refs.pooled }, 0..) |ref, i| {
+            encoder.setBuffer(ref.buffer, ref.offset, i);
+        }
+        encoder.setValue(shape, 4);
+        encoder.dispatchThreads(mtl.Size.of(shape.width, shape.groups, 1), mtl.Size.of(32, 1, 1));
+    }
+};
diff --git a/zig/src/families/hy4_flash/loader.zig b/zig/src/families/hy4_flash/loader.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4e1ee7964b1080ba0d4416f71b0da6c0a4f5b121
--- /dev/null
+++ b/zig/src/families/hy4_flash/loader.zig
@@ -0,0 +1,83 @@
+//! Checkpoint ownership and admission for the native Hy4-flash model family.
+const std = @import("std");
+const core = @import("core");
+const config = @import("config.zig");
+const weights = @import("weights.zig");
+
+pub const Attention = enum { target, draft };
+
+pub const Loaded = struct {
+    config: std.json.Parsed(config.Model),
+    checkpoint: core.Checkpoint,
+    bits: u8,
+
+    pub fn open(a: std.mem.Allocator, io: std.Io, directory: []const u8) !Loaded {
+        const config_path = try std.fs.path.join(a, &.{ directory, "config.json" });
+        defer a.free(config_path);
+        const text = try std.Io.Dir.cwd().readFileAlloc(io, config_path, a, .limited(1 << 20));
+        defer a.free(text);
+        const parsed = try config.parse(a, text);
+        errdefer parsed.deinit();
+        const q = parsed.value.quantization orelse return error.UnsupportedHy4Affine;
+        if (q.group_size != 64 or !std.mem.eql(u8, q.mode, "affine") or (q.bits != 4 and q.bits != 8))
+            return error.UnsupportedHy4Affine;
+        var checkpoint = try core.Checkpoint.openModel(a, io, directory);
+        errdefer checkpoint.close();
+        var validation: Validation = .{ .checkpoint = &checkpoint };
+        try weights.check(&validation, parsed.value, q.bits);
+        return .{ .config = parsed, .checkpoint = checkpoint, .bits = q.bits };
+    }
+
+    pub fn close(self: *Loaded) void {
+        self.checkpoint.close();
+        self.config.deinit();
+        self.* = undefined;
+    }
+
+    pub fn attentionTargetLayer(self: *const Loaded, kind: Attention, layer: u32) !u32 {
+        const model = self.config.value;
+        return switch (kind) {
+            .target => if (layer < model.text_config.num_hidden_layers) layer else error.BadAttentionLayer,
+            .draft => if (layer < model.dfly_target_kv_layers.len) model.dfly_target_kv_layers[layer] else return error.BadAttentionLayer,
+        };
+    }
+
+    /// Return this layer's learned sink, even when its draft attention shares the target's KV.
+    pub fn attentionSink(self: *Loaded, kind: Attention, layer: u32, output: []f32) ![]f32 {
+        const layer_config = try self.attentionTargetLayer(kind, layer);
+        const heads = self.config.value.text_config.headShape(layer_config).heads;
+        if (output.len < heads) return error.ShortAttentionSinkBuffer;
+        var buffer: [96]u8 = undefined;
+        const prefix = switch (kind) {
+            .target => "model.layers",
+            .draft => "model.dfly_layers",
+        };
+        const name = try std.fmt.bufPrint(&buffer, "{s}.{d}.self_attn.learnable_sink_param", .{ prefix, layer });
+        const result = output[0..heads];
+        switch (kind) {
+            .target => {
+                const tensor = try self.checkpoint.expect(name, .f32, &.{heads});
+                for (result, 0..) |*value, i| value.* = @bitCast(std.mem.readInt(u32, tensor.bytes[4 * i ..][0..4], .little));
+            },
+            .draft => {
+                const tensor = try self.checkpoint.expect(name, .bf16, &.{heads});
+                for (result, 0..) |*value, i| {
+                    const raw = std.mem.readInt(u16, tensor.bytes[2 * i ..][0..2], .little);
+                    value.* = @bitCast(@as(u32, raw) << 16);
+                }
+            },
+        }
+        return result;
+    }
+};
+
+const Validation = struct {
+    checkpoint: *core.Checkpoint,
+
+    pub fn expect(self: *Validation, name: []const u8, format: weights.DType, shape: []const usize) !void {
+        const dtype: core.checkpoint_host.DType = switch (format) {
+            inline else => |tag| @field(core.checkpoint_host.DType, @tagName(tag)),
+        };
+        _ = try self.checkpoint.expect(name, dtype, shape);
+    }
+};
diff --git a/zig/src/families/hy4_flash/metal_dense.zig b/zig/src/families/hy4_flash/metal_dense.zig
new file mode 100644
index 0000000000000000000000000000000000000000..094b5f7ee0b334f2a3c16dd52ce4b3f6d3c6f645
--- /dev/null
+++ b/zig/src/families/hy4_flash/metal_dense.zig
@@ -0,0 +1,589 @@
+//! The native Metal attention and dense feed-forward layer passes for Hy4-flash.
+const std = @import("std");
+const mtl = @import("metal");
+const affine = @import("../../core/row_projection.zig");
+const dense = @import("draft_ops");
+const core = @import("core");
+const cfg = @import("config.zig");
+const ihc = @import("ihc.zig");
+const ihc_gpu = @import("ihc_metal.zig");
+const mla_gpu = @import("mla_metal.zig");
+const mha = @import("mla_attention.zig");
+const shape_ = @import("mla_weights.zig");
+const weights = @import("model_weights.zig");
+const rope = @import("rope.zig");
+const gpu_qkv = @import("metal_tensor_qkv.zig");
+const lane = @import("../../core/lane_projection.zig");
+const index = @import("metal_index.zig");
+
+pub const Ref = mla_gpu.Ref;
+
+pub const Buffers = struct {
+    a: std.mem.Allocator,
+    d: mtl.Device,
+    list: std.ArrayList(mtl.Buffer) = .empty,
+
+    pub fn alloc(self: *Buffers, bytes: usize) !mtl.Buffer {
+        const b = try self.d.buffer(bytes, mtl.ResourceOptions.shared);
+        errdefer b.deinit();
+        try self.list.append(self.a, b);
+        return b;
+    }
+
+    pub fn upload(self: *Buffers, bytes: []const u8) !mtl.Buffer {
+        const b = try self.alloc(bytes.len);
+        @memcpy(b.slice(u8, bytes.len), bytes);
+        return b;
+    }
+
+    pub fn clear(self: *Buffers) void {
+        for (self.list.items) |b| b.deinit();
+        self.list.deinit(self.a);
+    }
+
+    pub fn matrix(self: *Buffers, w: core.quant.mlx.Host) !affine.Weights {
+        const view: affine.Weights = .{
+            .w = try self.upload(w.words.bytes),
+            .scales = try self.upload(w.scales.bytes),
+            .biases = try self.upload(w.biases.bytes),
+            .n = w.words.shape[0],
+            .k = w.scales.shape[1] * w.group,
+            .bits = w.bits,
+            .group = w.group,
+        };
+        try view.validate();
+        return view;
+    }
+
+    /// A dense projection's weights: packed for the tensor units' lane projection when `tensors`
+    pub fn linear(self: *Buffers, w: core.quant.mlx.Host, tensors: bool) !Linear {
+        const n: u32 = @intCast(w.words.shape[0]);
+        const k: u32 = @intCast(w.scales.shape[1] * w.group);
+        if (tensors and n % 32 == 0 and w.group == 64 and (w.bits == 4 or w.bits == 8)) {
+            const packed_ = try gpu_qkv.Packed.upload(self, &.{w}, gpu_qkv.denseLayout(w.bits, n, k));
+            return .{ .tensor = .{ .w = packed_.w, .sb = packed_.sb, .n = n, .k = k } };
+        }
+        return .{ .portable = try self.matrix(w) };
+    }
+
+    pub fn rows(self: *Buffers, count: u32, columns: u32) !Ref {
+        return .{ .buffer = try self.alloc(@as(usize, count) * columns * @sizeOf(u16)) };
+    }
+};
+
+/// A dense affine projection [n, k]: the core row kernels, or the tensor units' lane projection over packed weights.
+pub const Linear = union(enum) {
+    portable: affine.Weights,
+    tensor: struct { w: lane.Ref, sb: lane.Ref, n: u32, k: u32 },
+
+    pub fn outputs(self: Linear) u32 {
+        return switch (self) {
+            .portable => |w| @intCast(w.n),
+            .tensor => |t| t.n,
+        };
+    }
+};
+
+pub const Linears = @import("metal_linears.zig").Linears;
+
+pub const Merge = struct {
+    project: mtl.Buffer,
+    bias: mtl.Buffer,
+    scale: mtl.Buffer,
+    shape: ihc.Shape,
+
+    pub fn upload(b: *Buffers, w: ihc.Weights) !Merge {
+        return .{
+            .project = try b.upload(w.project.bytes),
+            .bias = try b.upload(w.bias.bytes),
+            .scale = try b.upload(w.scale.bytes),
+            .shape = w.shape,
+        };
+    }
+};
+
+const InputWeights = union(enum) {
+    portable: struct { q_a: affine.Weights, q_b: affine.Weights, kv_a: affine.Weights, gates: affine.Weights },
+    tensor: struct { qkv: gpu_qkv.Packed, q_b: gpu_qkv.Packed, flavor: usize },
+};
+
+pub const Attention = struct {
+    own: Buffers,
+    hidden: u32,
+    query_rank: u32,
+    heads: u32,
+    epsilon: f32,
+    rope: rope.Parameters,
+    merge: Merge,
+    norm: mtl.Buffer,
+    inputs: InputWeights,
+    q_norm: mtl.Buffer,
+    kv_norm: mtl.Buffer,
+    o: Linear,
+    o_norm: mtl.Buffer,
+    wk: mtl.Buffer,
+    wv: mtl.Buffer,
+    bits: u8 = 4,
+    sinks: mtl.Buffer,
+    /// A sparse layer's compressed indexer (null on sliding layers).
+    index: ?index.Weights = null,
+
+    pub fn upload(a: std.mem.Allocator, device: mtl.Device, w: *const weights.TargetLayer, t: cfg.Text) !Attention {
+        return uploadForModel(a, device, w, t, false);
+    }
+
+    pub fn uploadForModel(a: std.mem.Allocator, device: mtl.Device, w: *const weights.TargetLayer, t: cfg.Text, use_tensors: bool) !Attention {
+        if (w.attention.owns_output) return error.Hy4MetalAttentionNeedsFullHeadRange;
+        var b: Buffers = .{ .a = a, .d = device };
+        errdefer b.clear();
+        const heads = w.attention.heads.count;
+        const bits = w.project_query.bits;
+        const inputs: InputWeights = if (use_tensors)
+            .{ .tensor = .{
+                .qkv = try gpu_qkv.Packed.upload(&b, &.{ w.project_query, w.project_kv, w.attention.gate }, gpu_qkv.inputLayout(t, bits, heads)),
+                .q_b = try gpu_qkv.Packed.upload(&b, &.{w.attention.query}, gpu_qkv.queryLayout(t, bits, heads)),
+                .flavor = gpu_qkv.flavor(t, heads),
+            } }
+        else
+            .{ .portable = .{
+                .q_a = try b.matrix(w.project_query),
+                .q_b = try b.matrix(w.attention.query),
+                .kv_a = try b.matrix(w.project_kv),
+                .gates = try b.matrix(w.attention.gate),
+            } };
+        const out: Attention = .{
+            .own = undefined,
+            .hidden = t.hidden_size,
+            .query_rank = t.q_lora_rank,
+            .heads = heads,
+            .epsilon = t.rms_norm_eps,
+            .rope = w.position,
+            .merge = try Merge.upload(&b, w.attention_hc),
+            .norm = try b.upload(w.attention_norm.bytes),
+            .inputs = inputs,
+            .q_norm = try b.upload(w.norm_query.bytes),
+            .kv_norm = try b.upload(w.norm_kv.bytes),
+            .o = try b.linear(w.attention.output, use_tensors),
+            .o_norm = try b.upload(w.attention_output_norm.bytes),
+            .wk = try b.upload(std.mem.sliceAsBytes(w.absorbed.key)),
+            .wv = try b.upload(std.mem.sliceAsBytes(w.absorbed.value)),
+            .bits = if (w.absorbed.packed_rows) |p| p.bits else 4,
+            .sinks = try b.upload(std.mem.sliceAsBytes(w.sinks[0..heads])),
+            .index = if (w.index) |*ix| try index.Weights.upload(&b, ix, use_tensors) else null,
+        };
+        return withAllocation(out, b);
+    }
+
+    pub fn deinit(self: *Attention) void {
+        self.own.clear();
+        self.* = undefined;
+    }
+};
+
+pub const Feed = struct {
+    own: Buffers,
+    merge: Merge,
+    norm: mtl.Buffer,
+    gate: Linear,
+    up: Linear,
+    down: Linear,
+    output_norm: mtl.Buffer,
+
+    pub fn upload(a: std.mem.Allocator, device: mtl.Device, w: *const weights.TargetLayer) !Feed {
+        return uploadForModel(a, device, w, false);
+    }
+
+    pub fn uploadForModel(a: std.mem.Allocator, device: mtl.Device, w: *const weights.TargetLayer, use_tensors: bool) !Feed {
+        if (w.feed != .dense) return error.Hy4DenseFeedRequired;
+        var b: Buffers = .{ .a = a, .d = device };
+        errdefer b.clear();
+        const feed = w.feed.dense;
+        const out: Feed = .{
+            .own = undefined,
+            .merge = try Merge.upload(&b, w.mlp_hc),
+            .norm = try b.upload(w.mlp_norm.bytes),
+            .gate = try b.linear(feed.projections.gate, use_tensors),
+            .up = try b.linear(feed.projections.up, use_tensors),
+            .down = try b.linear(feed.projections.down, use_tensors),
+            .output_norm = try b.upload(feed.norm.bytes),
+        };
+        return withAllocation(out, b);
+    }
+
+    pub fn deinit(self: *Feed) void {
+        self.own.clear();
+        self.* = undefined;
+    }
+};
+
+pub fn withAllocation(out: anytype, b: Buffers) @TypeOf(out) {
+    var owned = out;
+    owned.own = b;
+    return owned;
+}
+
+pub const Scratch = @import("metal_scratch.zig").Scratch;
+
+pub const Rows = @import("metal_linears.zig").Rows;
+
+fn twoStep(keys: u32) bool {
+    return keys >= 1024;
+}
+
+pub const CacheRows = struct {
+    positions: Ref,
+    write_slots: Ref,
+    retained: Ref,
+    counts: Ref,
+    cache: Ref,
+    capacity: u32,
+    /// When every row's keys are one contiguous run: their ranges and tiles, for the tensor units' flash kernel.
+    ranges: ?mla_gpu.KeyRanges = null,
+    /// The widest row's live key count this pass (0: unknown), which sizes the decode attention split.
+    live_keys: u32 = 0,
+    /// A sparse layer's indexer for this pass (null: it attends `retained`, the probe's contexts under 2,048).
+    index: ?index.Pass = null,
+};
+
+pub const Kernels = struct {
+    affine: affine.Pipelines,
+    dense: dense.Ops,
+    merge: ihc_gpu.Kernels,
+    projections: mla_gpu.Projections,
+    attention: mla_gpu.Attention,
+    tensors: ?gpu_qkv.Kernels = null,
+    rows: ?Rows = null,
+    linears: ?Linears = null,
+
+    pub fn load(device: mtl.Device) !Kernels {
+        var row_project = try affine.Pipelines.load(device);
+        errdefer row_project.deinit();
+        const normalize = try dense.Ops.init(device);
+        errdefer normalize.deinit();
+        var merge = try ihc_gpu.Kernels.load(device);
+        errdefer merge.deinit();
+        var proj = try mla_gpu.Projections.load(device);
+        errdefer proj.deinit();
+        return .{
+            .affine = row_project,
+            .dense = normalize,
+            .merge = merge,
+            .projections = proj,
+            .attention = try mla_gpu.Attention.load(device),
+        };
+    }
+
+    pub fn deinit(self: *Kernels) void {
+        if (self.linears) |*l| l.deinit();
+        if (self.rows) |r| r.deinit();
+        if (self.tensors) |t| t.deinit();
+        self.attention.deinit();
+        self.projections.deinit();
+        self.merge.deinit();
+        self.dense.deinit();
+        self.affine.deinit();
+    }
+
+    pub fn loadForModel(a: std.mem.Allocator, device: mtl.Device, t: cfg.Text, bits: u8) !Kernels {
+        var out = try load(device);
+        errdefer out.deinit();
+        if (device.tensorUnits()) out.tensors = try gpu_qkv.Kernels.load(a, device, t, bits);
+        if (device.tensorUnits()) out.linears = try Linears.load(a, device, t, bits);
+        out.rows = try Rows.load(a, device);
+        if (device.tensorUnits()) out.projections.nax = try mla_gpu.Nax.load(a, device);
+        return out;
+    }
+
+    pub fn project(self: *const Kernels, e: mtl.ComputeEncoder, w: affine.Weights, x: Ref, y: Ref, rows: u32) !void {
+        var call = try affine.call(&self.affine, w, rows, false);
+        if (self.rows) |r| if (r.choose(w, rows)) |pipe| {
+            call.pipeline = pipe;
+            call.groups = w.n / (r.rps * r.sg());
+            call.threads = 32 * r.sg();
+        };
+        e.setPipeline(call.pipeline);
+        e.setBuffer(x.buffer, x.offset, 0);
+        e.setBuffer(w.w, w.w_off, 1);
+        e.setBuffer(w.scales, w.s_off, 2);
+        e.setBuffer(w.biases, w.b_off, 3);
+        e.setValue(call.dims, 4);
+        e.setBuffer(y.buffer, y.offset, 5);
+        e.dispatchGroups(mtl.Size.of(call.groups, 1, 1), mtl.Size.of(call.threads, 1, 1));
+    }
+
+    /// y = x W^T for a dense projection, on whichever kernels its weights were packed for.
+    pub fn linear(self: *const Kernels, e: mtl.ComputeEncoder, w: Linear, x: Ref, y: Ref, rows: u32) !void {
+        return self.linearsFrom(e, x, &.{.{ .w = w, .y = y }}, rows);
+    }
+
+    pub const Out = struct { w: Linear, y: Ref };
+
+    /// Every projection of the same input x: on tensor units one group-sums pass, a barrier
+    pub fn linearsFrom(self: *const Kernels, e: mtl.ComputeEncoder, x: Ref, outs: []const Out, rows: u32) !void {
+        if (outs.len == 0) return;
+        if (outs[0].w == .portable) {
+            for (outs) |o| try self.project(e, o.w.portable, x, o.y, rows);
+            return;
+        }
+        const all = &(self.linears orelse return error.Hy4LinearsMissing);
+        const k = outs[0].w.tensor.k;
+        // small passes: the kernels that add their own group sums (the same words, no sums pass or barrier)
+        if (rows <= gpu_qkv.inline_rows) inline_sums: {
+            for (outs) |o| if (all.findInline(o.w.tensor.n, o.w.tensor.k) == null) break :inline_sums;
+            for (outs) |o| try all.findInline(o.w.tensor.n, o.w.tensor.k).?.encode(e, tref(x), o.w.tensor.w, o.w.tensor.sb, tref(o.y), rows);
+            return;
+        }
+        const first = all.find(outs[0].w.tensor.n, k) orelse return error.Hy4LinearShapeMissing;
+        const shared = first.reg and first.sums_pipe != null and rows <= Linears.sum_rows;
+        const stride: u32 = 16 * ((rows + 15) / 16);
+        if (shared) {
+            e.setPipeline(first.sums_pipe.?);
+            e.setBuffer(x.buffer, x.offset, 0);
+            e.setValue(@as(i32, @intCast(rows)), 1);
+            e.setBuffer(all.sums.?, 0, 2);
+            e.setValue(@as(i32, @intCast(stride)), 3);
+            e.dispatchThreads(.{ .width = stride * (k / 64) }, .{ .width = 256 });
+            e.barrier();
+        }
+        for (outs) |o| {
+            const m = o.w.tensor;
+            if (m.k != k) return error.Hy4LinearInputsDiffer;
+            const p = all.find(m.n, m.k) orelse return error.Hy4LinearShapeMissing;
+            if (shared)
+                try p.encodeSums(e, tref(x), m.w, m.sb, .{ .ref = .{ .buf = all.sums.? }, .stride = stride }, tref(o.y), rows)
+            else
+                try p.encode(e, tref(x), m.w, m.sb, tref(o.y), rows);
+        }
+    }
+
+    pub fn dref(x: Ref) dense.Ref {
+        return .{ .buf = x.buffer, .off = x.offset };
+    }
+
+    fn tref(x: Ref) lane.Ref {
+        return .{ .buf = x.buffer, .off = x.offset };
+    }
+
+    pub fn norm(self: *const Kernels, e: mtl.ComputeEncoder, x: Ref, gain: mtl.Buffer, y: Ref, rows: u32, width: u32, epsilon: f32) !void {
+        try self.dense.norm(e, dref(x), .{ .buf = gain }, dref(y), .{
+            .rows = rows,
+            .heads = 1,
+            .dim = width,
+            .x_stride = width,
+            .y_stride = width,
+            .eps = epsilon,
+        });
+    }
+
+    /// Where a sub-block sits between seams: `ready` when the previous tail already wrote this collapse's partials
+    pub const Seam = struct { ready: bool = false, headed: bool = false, next: ?Merge = null, next_gain: ?mtl.Buffer = null };
+
+    /// Decode passes fuse each tail with the next head.
+    pub fn fusedSeams(rows: u32) bool {
+        return rows <= ihc_gpu.Kernels.seam_rows;
+    }
+
+    /// The collapse and input norm in two launches at most (partials unless `ready`, then gates, row and norm).
+    pub fn collapseSeam(self: *const Kernels, e: mtl.ComputeEncoder, x: Ref, w: Merge, gain: mtl.Buffer, s: *const Scratch, ready: bool) !ihc.Shape {
+        return self.collapseSeamFrom(e, x, w, gain, s, .{ .ready = ready });
+    }
+
+    pub fn collapseSeamFrom(self: *const Kernels, e: mtl.ComputeEncoder, x: Ref, w: Merge, gain: mtl.Buffer, s: *const Scratch, seam: Seam) !ihc.Shape {
+        const ready = seam.ready;
+        var shape = w.shape;
+        shape.rows = s.shape.rows;
+        if (seam.headed) return shape;
+        const part: ihc_gpu.Ref = .{ .buffer = s.ihc_partials.buffer, .offset = s.ihc_partials.offset };
+        const hidden: ihc_gpu.Ref = .{ .buffer = x.buffer, .offset = x.offset };
+        if (!ready) {
+            try self.merge.seamPartials(e, hidden, .{ .buffer = w.project }, part, shape);
+            e.barrier();
+        }
+        try self.merge.headPass(e, .{
+            .hidden = hidden,
+            .partials = part,
+            .bias = .{ .buffer = w.bias },
+            .scale = .{ .buffer = w.scale },
+            .gain = .{ .buffer = gain },
+            .collapsed = .{ .buffer = s.merged.buffer, .offset = s.merged.offset },
+            .normalized = .{ .buffer = s.normalized.buffer, .offset = s.normalized.offset },
+            .post = .{ .buffer = s.post.buffer, .offset = s.post.offset },
+        }, shape, shape.eps);
+        e.barrier();
+        return shape;
+    }
+
+    /// A sub-block's end: its branch (two added, for the experts) through the output norm, mixed into `out`
+    pub fn tail(self: *const Kernels, e: mtl.ComputeEncoder, branch: Ref, branch2: ?Ref, gain: mtl.Buffer, eps: f32, x: Ref, out: Ref, s: *const Scratch, shape: ihc.Shape, next: ?Merge) !void {
+        return self.tailTo(e, branch, branch2, gain, eps, x, out, s, shape, .{ .next = next });
+    }
+
+    pub fn tailTo(self: *const Kernels, e: mtl.ComputeEncoder, branch: Ref, branch2: ?Ref, gain: mtl.Buffer, eps: f32, x: Ref, out: Ref, s: *const Scratch, shape: ihc.Shape, seam: Seam) !void {
+        const next = seam.next;
+        if (next) |n| if (seam.next_gain) |ng| if (fusedSeams(shape.rows) and shape.width == 12 * 256) {
+            const r = ihc_gpu.Ref;
+            return self.merge.seamPass(e, .{
+                .branch = r{ .buffer = branch.buffer, .offset = branch.offset },
+                .branch2 = if (branch2) |b2| r{ .buffer = b2.buffer, .offset = b2.offset } else null,
+                .gain = .{ .buffer = gain },
+                .residual = .{ .buffer = x.buffer, .offset = x.offset },
+                .post = .{ .buffer = s.post.buffer, .offset = s.post.offset },
+                .output = .{ .buffer = out.buffer, .offset = out.offset },
+                .next = r{ .buffer = n.project },
+                .partials = .{ .buffer = s.ihc_partials.buffer, .offset = s.ihc_partials.offset },
+            }, .{
+                .bias = .{ .buffer = n.bias },
+                .scale = .{ .buffer = n.scale },
+                .gain = .{ .buffer = ng },
+                .collapsed = .{ .buffer = s.merged.buffer, .offset = s.merged.offset },
+                .normalized = .{ .buffer = s.normalized.buffer, .offset = s.normalized.offset },
+                .shape = n.shape,
+                .barriers = .{ .buffer = s.seam_barriers.buffer, .offset = s.seam_barriers.offset },
+            }, shape.rows, shape.width, eps);
+        };
+        const r = ihc_gpu.Ref;
+        self.merge.tailPass(e, .{
+            .branch = r{ .buffer = branch.buffer, .offset = branch.offset },
+            .branch2 = if (branch2) |b2| r{ .buffer = b2.buffer, .offset = b2.offset } else null,
+            .gain = .{ .buffer = gain },
+            .residual = .{ .buffer = x.buffer, .offset = x.offset },
+            .post = .{ .buffer = s.post.buffer, .offset = s.post.offset },
+            .output = .{ .buffer = out.buffer, .offset = out.offset },
+            .next = if (next) |n| r{ .buffer = n.project } else null,
+            .partials = .{ .buffer = s.ihc_partials.buffer, .offset = s.ihc_partials.offset },
+        }, shape.rows, shape.width, eps, if (next) |n| n.shape.gates else 8);
+    }
+
+    pub fn collapse(self: *const Kernels, e: mtl.ComputeEncoder, x: Ref, w: Merge, gain: mtl.Buffer, s: *const Scratch) !ihc.Shape {
+        var shape = w.shape;
+        shape.rows = s.shape.rows;
+        try self.merge.collapse(e, .{
+            .hidden = .{ .buffer = x.buffer, .offset = x.offset },
+            .projection = .{ .buffer = w.project },
+            .bias = .{ .buffer = w.bias },
+            .scale = .{ .buffer = w.scale },
+            .output = .{ .buffer = s.merged.buffer, .offset = s.merged.offset },
+            .post = .{ .buffer = s.post.buffer, .offset = s.post.offset },
+            .partials = .{ .buffer = s.ihc_partials.buffer, .offset = s.ihc_partials.offset },
+        }, shape);
+        e.barrier();
+        try self.norm(e, s.merged, gain, s.normalized, shape.rows, shape.width, shape.eps);
+        e.barrier();
+        return shape;
+    }
+
+    pub fn residual(self: *const Kernels, e: mtl.ComputeEncoder, x: Ref, branch: Ref, post: Ref, out: Ref, shape: ihc.Shape) !void {
+        try self.merge.add(e, .{
+            .residual = .{ .buffer = x.buffer, .offset = x.offset },
+            .branch = .{ .buffer = branch.buffer, .offset = branch.offset },
+            .post = .{ .buffer = post.buffer, .offset = post.offset },
+            .output = .{ .buffer = out.buffer, .offset = out.offset },
+        }, shape);
+    }
+
+    /// The caller supplies the retained list for this lane from its sliding or sparse index state.
+    pub fn attend(self: *const Kernels, e: mtl.ComputeEncoder, w: *const Attention, s: *const Scratch, cache: CacheRows, x: Ref, out: Ref) !void {
+        return self.attendSeam(e, w, s, cache, x, out, .{});
+    }
+
+    pub fn attendSeam(self: *const Kernels, e: mtl.ComputeEncoder, w: *const Attention, s: *const Scratch, cache: CacheRows, x: Ref, out: Ref, seam: Seam) !void {
+        if (s.shape.heads != w.heads) return error.Hy4WrongAttentionHeadCount;
+        if (w.inputs == .tensor and (self.tensors == null or s.qkv == null)) return error.ShortHy4Scratch;
+        const shape = try self.collapseSeamFrom(e, x, w.merge, w.norm, s, seam);
+        const rows = shape.rows;
+        var q_a = s.query_a;
+        var kv = s.kv;
+        var gates = s.value_logits;
+        switch (w.inputs) {
+            .portable => |m| {
+                try self.project(e, m.q_a, s.normalized, q_a, rows);
+                try self.project(e, m.kv_a, s.normalized, kv, rows);
+                try self.project(e, m.gates, s.normalized, gates, rows);
+                e.barrier();
+                try self.norm(e, q_a, w.q_norm, s.query_norm, rows, w.query_rank, w.epsilon);
+                e.barrier();
+                try self.project(e, m.q_b, s.query_norm, s.query, rows);
+            },
+            .tensor => |m| {
+                const kernels = &self.tensors.?;
+                const qkv = s.qkv.?;
+                try kernels.inputFor(m.flavor, rows).encode(e, tref(s.normalized), m.qkv.w, m.qkv.sb, tref(qkv), rows);
+                e.barrier();
+                if (rows == 1) {
+                    q_a = qkv;
+                    kv = .{ .buffer = qkv.buffer, .offset = @as(usize, w.query_rank) * @sizeOf(u16) };
+                    gates = .{ .buffer = qkv.buffer, .offset = (@as(usize, w.query_rank) + shape_.absorbed_stride) * @sizeOf(u16) };
+                } else {
+                    kernels.split(e, tref(qkv), tref(q_a), tref(kv), tref(gates), rows, w.query_rank, w.heads * shape_.value_width);
+                    e.barrier();
+                }
+                try self.norm(e, q_a, w.q_norm, s.query_norm, rows, w.query_rank, w.epsilon);
+                e.barrier();
+                try kernels.queryFor(m.flavor, rows).encode(e, tref(s.query_norm), m.q_b.w, m.q_b.sb, tref(s.query), rows);
+            },
+        }
+        e.barrier();
+        const ix_pass: ?index.Pass = if (cache.index) |p| (if (w.index != null) p else null) else null;
+        if (ix_pass) |p| {
+            if (p.scratch.rows != rows) return error.Hy4IndexRowsOutOfStep;
+            try index.run(p, self, self.projections, e, &w.index.?, s.normalized, s.query_norm, cache.write_slots, cache.positions, s.rotary, w.rope, w.epsilon);
+            e.barrier();
+        }
+        // past 2,048 keys a sparse layer attends each row's recalled slots
+        const lists = if (ix_pass) |p| p.scratch.selects() else false;
+        // rows of a pass across 2,048 keys that sit before it attend as they would in any other pass
+        const lists_from: ?u32 = if (lists and cache.ranges != null and ix_pass.?.scratch.first < index.keys_a_row) index.keys_a_row - ix_pass.?.scratch.first else null;
+        try mla_gpu.forward(self.projections, self.attention, e, .{
+            .query = s.query,
+            .key_weights = .{ .buffer = w.wk },
+            .value_weights = .{ .buffer = w.wv },
+            .value_logits = gates,
+            .positions = cache.positions,
+            .rotary_table = s.rotary,
+            .values = s.values,
+            .kv = .{ .projection = kv, .gain = .{ .buffer = w.kv_norm }, .write_slots = cache.write_slots, .capacity = cache.capacity, .epsilon = w.epsilon },
+            .attention = .{
+                .query = s.absorbed,
+                .cache = cache.cache,
+                .slots = if (lists) ix_pass.?.cache.tokens else cache.retained,
+                .counts = if (lists) ix_pass.?.cache.counts else cache.counts,
+                .sinks = .{ .buffer = w.sinks },
+                .scratch = s.attention,
+                .output = s.latent,
+                // two steps pay off from two chunks of keys; below that the one-step kernel is quicker
+                .key_scores = if (twoStep(s.shape.key_stride)) s.key_scores else null,
+                .ranges = if (lists and lists_from == null) null else cache.ranges,
+                .lists_from = lists_from,
+                .flash_parts = s.flash_parts,
+                .live_keys = if (lists) index.keys_a_row else cache.live_keys,
+            },
+        }, s.shape, w.rope);
+        e.barrier();
+        try self.linear(e, w.o, s.values, s.branch, rows);
+        e.barrier();
+        try self.tailTo(e, s.branch, null, w.o_norm, w.epsilon, x, out, s, shape, seam);
+    }
+
+    pub fn feed(self: *const Kernels, e: mtl.ComputeEncoder, w: *const Feed, s: *const Scratch, x: Ref, out: Ref) !void {
+        return self.feedSeam(e, w, s, x, out, .{});
+    }
+
+    pub fn feedSeam(self: *const Kernels, e: mtl.ComputeEncoder, w: *const Feed, s: *const Scratch, x: Ref, out: Ref, seam: Seam) !void {
+        const inner: u32 = w.gate.outputs();
+        if (inner > s.inner_capacity) return error.ShortHy4Scratch;
+        const shape = try self.collapseSeamFrom(e, x, w.merge, w.norm, s, seam);
+        try self.linearsFrom(e, s.normalized, &.{ .{ .w = w.gate, .y = s.gate }, .{ .w = w.up, .y = s.up } }, shape.rows);
+        e.barrier();
+        try self.dense.swiglu(e, dref(s.gate), dref(s.up), dref(s.inner), .{
+            .rows = shape.rows,
+            .width = inner,
+            .gate_stride = inner,
+            .up_stride = inner,
+            .y_stride = inner,
+        });
+        e.barrier();
+        try self.linear(e, w.down, s.inner, s.branch, shape.rows);
+        e.barrier();
+        try self.tailTo(e, s.branch, null, w.output_norm, shape.eps, x, out, s, shape, seam);
+    }
+};
diff --git a/zig/src/families/hy4_flash/metal_draft.zig b/zig/src/families/hy4_flash/metal_draft.zig
new file mode 100644
index 0000000000000000000000000000000000000000..741149ba6c86e1f5794531f095f54722af80d01e
--- /dev/null
+++ b/zig/src/families/hy4_flash/metal_draft.zig
@@ -0,0 +1,419 @@
+//! DFly2 on Metal. The scheduler supplies the target KV and retained indices for each draft layer.
+const std = @import("std");
+const mtl = @import("metal");
+const source = @import("kernel_sources");
+const dense_ops = @import("draft_ops");
+const affine = @import("../../core/row_projection.zig");
+const ck = @import("loader.zig");
+const model = @import("metal_model.zig");
+const common = @import("metal_dense.zig");
+const mla = @import("mla_metal.zig");
+const weights = @import("model_weights.zig");
+const geom = @import("mla_weights.zig");
+const rope = @import("rope.zig");
+
+pub const Ref = common.Ref;
+
+/// TF_HY4_DRAFT_BITS=4 or 8 quantizes DFly2's BF16 linears at load (MLX affine
+fn draftBits() !?u8 {
+    const bits = try @import("sys").environment.read(u32, "TF_HY4_DRAFT_BITS", 16);
+    return if (bits == 16) null else @intCast(bits);
+}
+
+fn bf16Round(x: f32) u16 {
+    const u: u32 = @bitCast(x);
+    return @intCast((u +% 0x7fff +% ((u >> 16) & 1)) >> 16);
+}
+
+fn bf16Value(w: u16) f32 {
+    return @bitCast(@as(u32, w) << 16);
+}
+
+/// MLX affine quantization of a BF16 [n, k] matrix
+fn quantize(b: *common.Buffers, bytes: []const u8, n: u32, k: u32, bits: u8) !affine.Weights {
+    const group = 64;
+    const groups = k / group;
+    const per_row = k * bits / 32;
+    const words = try b.alloc(@as(usize, n) * per_row * 4);
+    const scales = try b.alloc(@as(usize, n) * groups * 2);
+    const biases = try b.alloc(@as(usize, n) * groups * 2);
+    const wq = words.slice(u32, @as(usize, n) * per_row);
+    const sq = scales.slice(u16, @as(usize, n) * groups);
+    const bq = biases.slice(u16, @as(usize, n) * groups);
+    @memset(wq, 0);
+    const levels: f32 = @floatFromInt((@as(u32, 1) << @intCast(bits)) - 1);
+    for (0..n) |r| for (0..groups) |g| {
+        var lo: f32 = std.math.inf(f32);
+        var hi: f32 = -std.math.inf(f32);
+        const base = r * k + g * group;
+        for (0..group) |i| {
+            const v = bf16Value(std.mem.readInt(u16, bytes[2 * (base + i) ..][0..2], .little));
+            lo = @min(lo, v);
+            hi = @max(hi, v);
+        }
+        var scale = (hi - lo) / levels;
+        if (!(scale > 0)) scale = 1;
+        const s16 = bf16Round(scale);
+        const b16 = bf16Round(lo);
+        sq[r * groups + g] = s16;
+        bq[r * groups + g] = b16;
+        const sf = bf16Value(s16);
+        const bf = bf16Value(b16);
+        for (0..group) |i| {
+            const v = bf16Value(std.mem.readInt(u16, bytes[2 * (base + i) ..][0..2], .little));
+            const code: u32 = @intFromFloat(std.math.clamp(@round((v - bf) / sf), 0, levels));
+            const at = (g * group + i) * bits;
+            wq[r * per_row + at / 32] |= code << @intCast(at % 32);
+        }
+    };
+    const out: affine.Weights = .{ .w = words, .scales = scales, .biases = biases, .n = n, .k = k, .bits = bits, .group = group };
+    try out.validate();
+    return out;
+}
+
+const Linear = struct {
+    w: ?mtl.Buffer,
+    q: ?affine.Weights = null,
+    n: u32,
+    k: u32,
+    fn upload(b: *common.Buffers, t: @import("core").checkpoint_host.Tensor) !Linear {
+        const n: u32 = @intCast(t.shape[0]);
+        const k: u32 = @intCast(t.shape[1]);
+        if (try draftBits()) |bits| if (k % 512 == 0 and n % 8 == 0) {
+            if (quantize(b, t.bytes, n, k, bits)) |q| return .{ .w = null, .q = q, .n = n, .k = k } else |_| {}
+        };
+        return .{ .w = try b.upload(t.bytes), .n = n, .k = k };
+    }
+    fn run(p: Linear, kernels: *const common.Kernels, e: mtl.ComputeEncoder, x: Ref, y: Ref, rows: u32) !void {
+        if (p.q) |q| return kernels.project(e, q, x, y, rows);
+        try kernels.dense.linear(e, dr(x), .{ .buf = p.w.? }, dr(y), .{
+            .rows = rows,
+            .n = p.n,
+            .k = p.k,
+            .x_stride = p.k,
+            .w_stride = p.k,
+            .y_stride = p.n,
+        });
+    }
+};
+
+fn reference(b: mtl.Buffer) Ref {
+    return .{ .buffer = b };
+}
+
+fn dr(x: Ref) dense_ops.Ref {
+    return .{ .buf = x.buffer, .off = x.offset };
+}
+
+fn offset(x: Ref, words: usize) Ref {
+    return .{ .buffer = x.buffer, .offset = x.offset + words * @sizeOf(u16) };
+}
+
+const Feed = struct { gate: Linear, up: Linear, down: Linear };
+
+pub const Block = struct {
+    target_kv: u32,
+    target_index: u32,
+    heads: u32,
+    rope: rope.Parameters,
+    norm: mtl.Buffer,
+    q_low: Linear,
+    q_norm: mtl.Buffer,
+    q_high: Linear,
+    kv: Linear,
+    kv_norm: mtl.Buffer,
+    wk: mtl.Buffer,
+    wv: mtl.Buffer,
+    gate: Linear,
+    o: Linear,
+    o_norm: mtl.Buffer,
+    sinks: mtl.Buffer,
+    mlp_norm: mtl.Buffer,
+    mlp: Feed,
+
+    fn upload(b: *common.Buffers, host: *ck.Loaded, layer: u32) !Block {
+        var weights_ = try weights.DraftLayer.read(b.a, host, layer, .{ .rank = 0, .world = 1 });
+        defer weights_.deinit(b.a);
+        const t = host.config.value.text_config;
+        const heads = weights_.heads.count;
+        return .{
+            .target_kv = weights_.target_kv,
+            .target_index = weights_.target_index,
+            .heads = heads,
+            .rope = try t.rotary(t.layer_types[weights_.target_kv]),
+            .norm = try b.upload(weights_.input_norm.bytes),
+            .q_low = try Linear.upload(b, weights_.query_low),
+            .q_norm = try b.upload(weights_.query_norm.bytes),
+            .q_high = try Linear.upload(b, weights_.query_high),
+            .kv = try Linear.upload(b, weights_.kv_low),
+            .kv_norm = try b.upload(weights_.kv_norm.bytes),
+            .wk = try b.upload(std.mem.sliceAsBytes(weights_.absorbed.key)),
+            .wv = try b.upload(std.mem.sliceAsBytes(weights_.absorbed.value)),
+            .gate = try Linear.upload(b, weights_.gate),
+            .o = try Linear.upload(b, weights_.output),
+            .o_norm = try b.upload(weights_.output_norm.bytes),
+            .sinks = try b.upload(std.mem.sliceAsBytes(weights_.sinks[0..heads])),
+            .mlp_norm = try b.upload(weights_.mlp_norm.bytes),
+            .mlp = .{
+                .gate = try Linear.upload(b, weights_.mlp.gate),
+                .up = try Linear.upload(b, weights_.mlp.up),
+                .down = try Linear.upload(b, weights_.mlp.down),
+            },
+        };
+    }
+};
+
+pub const Draft = struct {
+    own: common.Buffers,
+    blocks: []Block,
+    width: u32,
+    hidden: u32,
+    epsilon: f32,
+    anchor_norm: mtl.Buffer,
+    hidden_norm: mtl.Buffer,
+    fusion: Linear,
+    fusion_gate: mtl.Buffer,
+    final_norm: mtl.Buffer,
+    correct_hidden: mtl.Buffer,
+    correct_embed: mtl.Buffer,
+    correction: Feed,
+    fuse: mtl.Pipeline,
+    residual: mtl.Pipeline,
+
+    pub fn open(a: std.mem.Allocator, d: mtl.Device, host: *ck.Loaded) !Draft {
+        var b: common.Buffers = .{ .a = a, .d = d };
+        errdefer b.clear();
+        const cfg = host.config.value;
+        const t = cfg.text_config;
+        const blocks = try a.alloc(Block, cfg.dfly_num_hidden_layers);
+        errdefer a.free(blocks);
+        for (blocks, 0..) |*layer, i| layer.* = try Block.upload(&b, host, @intCast(i));
+        const w = try weights.DraftHead.read(host);
+        const lib = try mtl.Library.fromSource(d, source.hy4_flash_ihc, mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        var fuse = try mtl.Pipeline.init(d, lib, "tf_hy4_draft_fuse", false);
+        errdefer fuse.deinit();
+        var out: Draft = .{
+            .own = undefined,
+            .blocks = blocks,
+            .width = cfg.speculative_config.num_speculative_tokens + 1,
+            .hidden = t.hidden_size,
+            .epsilon = t.rms_norm_eps,
+            .anchor_norm = try b.upload(w.anchor_norm.bytes),
+            .hidden_norm = try b.upload(w.hidden_norm.bytes),
+            .fusion = try Linear.upload(&b, w.fusion),
+            .fusion_gate = try b.upload(w.fusion_gate.bytes),
+            .final_norm = try b.upload(w.norm.bytes),
+            .correct_hidden = try b.upload(w.correction_hidden_norm.bytes),
+            .correct_embed = try b.upload(w.correction_embedding_norm.bytes),
+            .correction = .{
+                .gate = try Linear.upload(&b, w.correction.gate),
+                .up = try Linear.upload(&b, w.correction.up),
+                .down = try Linear.upload(&b, w.correction.down),
+            },
+            .fuse = fuse,
+            .residual = try mtl.Pipeline.init(d, lib, "tf_hy4_draft_residual", false),
+        };
+        out.own = b;
+        return out;
+    }
+
+    pub fn deinit(self: *Draft) void {
+        self.fuse.deinit();
+        self.residual.deinit();
+        self.own.a.free(self.blocks);
+        self.own.clear();
+    }
+
+    fn norm(self: *const Draft, ops: dense_ops.Ops, e: mtl.ComputeEncoder, x: Ref, gain: mtl.Buffer, y: Ref, rows: u32, dim: u32, xs: u32, ys: u32) !void {
+        try ops.norm(e, dr(x), .{ .buf = gain }, dr(y), .{
+            .rows = rows,
+            .heads = 1,
+            .dim = dim,
+            .x_stride = xs,
+            .y_stride = ys,
+            .eps = self.epsilon,
+        });
+    }
+
+    fn add(self: *const Draft, e: mtl.ComputeEncoder, x: Ref, y: Ref, out: Ref, rows: u32, stride: u32) void {
+        e.setPipeline(self.residual);
+        for ([_]Ref{ x, y, out }, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+        e.setValue([2]u32{ self.hidden, stride }, 3);
+        e.dispatchThreads(mtl.Size.of(self.hidden, rows, 1), mtl.Size.of(128, 1, 1));
+    }
+
+    fn mlp(kernels: *const common.Kernels, e: mtl.ComputeEncoder, w: Feed, temp: *const common.Scratch, x: Ref, y: Ref, rows: u32) !void {
+        const ops = kernels.dense;
+        const n = w.gate.n;
+        if (n > temp.inner_capacity) return error.ShortHy4Scratch;
+        try w.gate.run(kernels, e, x, temp.gate, rows);
+        try w.up.run(kernels, e, x, temp.up, rows);
+        e.barrier();
+        try ops.swiglu(e, dr(temp.gate), dr(temp.up), dr(temp.inner), .{
+            .rows = rows,
+            .width = n,
+            .gate_stride = n,
+            .up_stride = n,
+            .y_stride = n,
+        });
+        e.barrier();
+        try w.down.run(kernels, e, temp.inner, y, rows);
+    }
+
+    pub fn encode(self: *const Draft, target: *const model.Model, e: mtl.ComputeEncoder, s: *Frame, ids: Ref, anchors: Ref, lanes: u32, caches: []const model.LayerCache) !void {
+        s.lanes = 0;
+        if (lanes == 0 or lanes > s.capacity or caches.len != self.blocks.len) return error.BadHy4DraftFrame;
+        const begin = s.streams[0];
+        const rows = lanes * self.width;
+        const h = self.hidden;
+        const ops = target.common.dense;
+        target.embedRows(e, ids, begin, rows);
+        try self.norm(ops, e, anchors, self.hidden_norm, offset(s.concat, h), lanes, h, h, 2 * h);
+        e.barrier();
+        try self.norm(ops, e, begin, self.anchor_norm, s.concat, lanes, h, self.width * h, 2 * h);
+        e.barrier();
+        try self.fusion.run(&target.common, e, s.concat, s.delta, lanes);
+        e.barrier();
+        e.setPipeline(self.fuse);
+        e.setBuffer(begin.buffer, begin.offset, 0);
+        e.setBuffer(s.delta.buffer, s.delta.offset, 1);
+        e.setBuffer(self.fusion_gate, 0, 2);
+        e.setValue([2]u32{ h, self.width }, 3);
+        e.dispatchThreads(mtl.Size.of(h, lanes, 1), mtl.Size.of(128, 1, 1));
+        e.barrier();
+        var x = begin;
+        var y = s.streams[1];
+        for (self.blocks, caches) |block, cache| {
+            try s.common.bind(rows, block.heads, cache.key_stride);
+            try self.encodeBlock(target, e, block, s, cache.rows, x, y);
+            e.barrier();
+            std.mem.swap(Ref, &x, &y);
+        }
+        try self.norm(ops, e, x, self.final_norm, s.normalized, rows, h, h, h);
+        s.lanes = lanes;
+    }
+
+    fn encodeBlock(self: *const Draft, target: *const model.Model, e: mtl.ComputeEncoder, w: Block, s: *const Frame, cache: common.CacheRows, x: Ref, y: Ref) !void {
+        const ops = target.common.dense;
+        const v = &s.common;
+        const rows = v.shape.rows;
+        const h = self.hidden;
+        try self.norm(ops, e, x, w.norm, v.normalized, rows, h, h, h);
+        e.barrier();
+        try w.q_low.run(&target.common, e, v.normalized, v.query_a, rows);
+        try w.kv.run(&target.common, e, v.normalized, v.kv, rows);
+        try w.gate.run(&target.common, e, v.normalized, v.value_logits, rows);
+        e.barrier();
+        try self.norm(ops, e, v.query_a, w.q_norm, v.query_norm, rows, w.q_low.n, w.q_low.n, w.q_low.n);
+        e.barrier();
+        try w.q_high.run(&target.common, e, v.query_norm, v.query, rows);
+        e.barrier();
+        try mla.forward(target.common.projections, target.common.attention, e, .{
+            .query = v.query,
+            .key_weights = reference(w.wk),
+            .value_weights = reference(w.wv),
+            .value_logits = v.value_logits,
+            .positions = cache.positions,
+            .rotary_table = v.rotary,
+            .values = v.values,
+            .kv = .{ .projection = v.kv, .gain = reference(w.kv_norm), .write_slots = cache.write_slots, .capacity = cache.capacity, .epsilon = self.epsilon },
+            .attention = .{
+                .query = v.absorbed,
+                .cache = cache.cache,
+                .slots = cache.retained,
+                .counts = cache.counts,
+                .sinks = reference(w.sinks),
+                .scratch = v.attention,
+                .output = v.latent,
+                .key_scores = v.key_scores,
+            },
+        }, v.shape, w.rope);
+        e.barrier();
+        try w.o.run(&target.common, e, v.values, v.branch, rows);
+        e.barrier();
+        try self.norm(ops, e, v.branch, w.o_norm, v.normalized, rows, h, h, h);
+        e.barrier();
+        self.add(e, x, v.normalized, s.after_attention, rows, h);
+        e.barrier();
+        try self.norm(ops, e, s.after_attention, w.mlp_norm, v.normalized, rows, h, h, h);
+        e.barrier();
+        try mlp(&target.common, e, w.mlp, v, v.normalized, v.branch, rows);
+        e.barrier();
+        self.add(e, s.after_attention, v.branch, y, rows, h);
+    }
+
+    /// Apply the hidden correction at the chosen draft column with the previous proposal's token.
+    pub fn next(self: *const Draft, target: *const model.Model, e: mtl.ComputeEncoder, s: *const Frame, previous: Ref, column: u32) !Ref {
+        if (column == 0 or column >= self.width or s.lanes == 0) return error.BadHy4DraftColumn;
+        const ops = target.common.dense;
+        const rows = s.lanes;
+        const h = self.hidden;
+        const draft = offset(s.normalized, @as(usize, column) * h);
+        target.embedRows(e, previous, s.previous, rows);
+        try self.norm(ops, e, draft, self.correct_hidden, s.concat, rows, h, h * self.width, 2 * h);
+        e.barrier();
+        try self.norm(ops, e, s.previous, self.correct_embed, offset(s.concat, h), rows, h, h, 2 * h);
+        e.barrier();
+        try mlp(&target.common, e, self.correction, &s.common, s.concat, s.delta, rows);
+        e.barrier();
+        self.add(e, draft, s.delta, s.previous, rows, h * self.width);
+        e.barrier();
+        try target.readout(e, s.previous, s.logits, rows);
+        return s.logits;
+    }
+};
+
+pub const Frame = struct {
+    own: common.Buffers,
+    capacity: u32,
+    lanes: u32 = 0,
+    common: common.Scratch,
+    streams: [2]Ref,
+    concat: Ref,
+    delta: Ref,
+    normalized: Ref,
+    after_attention: Ref,
+    previous: Ref,
+    logits: Ref,
+
+    pub fn init(a: std.mem.Allocator, d: mtl.Device, target: *const model.Model, draft: *const Draft, lanes: u32, keys: u32) !Frame {
+        if (lanes == 0 or draft.blocks.len == 0) return error.BadHy4DraftFrame;
+        const rows = try std.math.mul(u32, lanes, draft.width);
+        const h = draft.hidden;
+        const t = target.host.config.value.text_config;
+        var max_inner = draft.correction.gate.n;
+        var max_heads: u32 = 0;
+        var target_layer: u32 = 0;
+        for (draft.blocks) |block| {
+            max_inner = @max(max_inner, block.mlp.gate.n);
+            if (block.heads > max_heads) {
+                max_heads = block.heads;
+                target_layer = block.target_kv;
+            }
+        }
+        var temp = try common.Scratch.init(a, d, &target.blocks[target_layer].attention, max_inner, keys, rows);
+        errdefer temp.deinit();
+        var b: common.Buffers = .{ .a = a, .d = d };
+        errdefer b.clear();
+        var out: Frame = .{
+            .own = undefined,
+            .capacity = lanes,
+            .common = temp,
+            .streams = .{ try b.rows(rows, h), try b.rows(rows, h) },
+            .concat = try b.rows(lanes, 2 * h),
+            .delta = try b.rows(lanes, h),
+            .normalized = try b.rows(rows, h),
+            .after_attention = try b.rows(rows, h),
+            .previous = try b.rows(lanes, h),
+            .logits = try b.rows(lanes, t.vocab_size),
+        };
+        out.own = b;
+        return out;
+    }
+
+    pub fn deinit(self: *Frame) void {
+        self.common.deinit();
+        self.own.clear();
+    }
+};
diff --git a/zig/src/families/hy4_flash/metal_engram.zig b/zig/src/families/hy4_flash/metal_engram.zig
new file mode 100644
index 0000000000000000000000000000000000000000..cebdf742c68ff149e3c3f4a26293ef449e85b6dc
--- /dev/null
+++ b/zig/src/families/hy4_flash/metal_engram.zig
@@ -0,0 +1,209 @@
+//! Metal Engram weights and apply pass. The large lookup table stays in the checkpoint mapping.
+const std = @import("std");
+const core = @import("core");
+const mtl = @import("metal");
+const affine = @import("../../core/row_projection.zig");
+const sources = @import("kernel_sources");
+const common = @import("metal_dense.zig");
+const engram = @import("engram.zig");
+const row_table = @import("engram_rows.zig");
+const weights = @import("model_weights.zig");
+const ihc = @import("ihc.zig");
+
+const Ref = common.Ref;
+const width = 96;
+
+/// Where the n-gram tables live (TF_HY4_ENGRAM)
+pub const Placement = enum { nvme, ram, gpu };
+
+pub fn placement() !Placement {
+    return @fromBackingInt(@intCast(try @import("sys").environment.read(u32, "TF_HY4_ENGRAM", 0)));
+}
+
+pub const Layer = struct {
+    own: common.Buffers,
+    table: row_table.Table,
+    /// The tables in memory of ours (ram or gpu placement).
+    resident: ?struct { words: mtl.Buffer, scales: mtl.Buffer, biases: mtl.Buffer, gpu: bool } = null,
+    lookup_gamma: mtl.Buffer,
+    key: [ihc.streams]common.Linear,
+    key_bias: mtl.Buffer,
+    key_gain: mtl.Buffer,
+    query_gain: mtl.Buffer,
+    delta_gain: mtl.Buffer,
+    value: common.Linear,
+    value_bias: mtl.Buffer,
+    value_gain: mtl.Buffer,
+    fp8: bool,
+    hidden: u32,
+
+    pub fn upload(a: std.mem.Allocator, d: mtl.Device, w: *const weights.Engram, hidden: u32, fp8: bool) !Layer {
+        return uploadForModel(a, d, w, hidden, fp8, false);
+    }
+
+    pub fn uploadForModel(a: std.mem.Allocator, d: mtl.Device, w: *const weights.Engram, hidden: u32, fp8: bool, use_tensors: bool) !Layer {
+        if (w.table.width != width or hidden == 0) return error.BadHy4EngramShape;
+        var b: common.Buffers = .{ .a = a, .d = d };
+        errdefer b.clear();
+        var out: Layer = .{
+            .own = undefined,
+            .table = w.table,
+            .lookup_gamma = try concatenate(&b, &w.lookup_norm),
+            .key = undefined,
+            .key_bias = undefined,
+            .key_gain = undefined,
+            .query_gain = undefined,
+            .delta_gain = undefined,
+            .value = try b.linear(w.value, use_tensors),
+            .value_bias = try b.upload(w.value_bias.bytes),
+            .value_gain = try b.upload(w.pre_gamma.bytes),
+            .fp8 = fp8,
+            .hidden = hidden,
+        };
+        switch (try placement()) {
+            .nvme => {},
+            .ram, .gpu => |where| {
+                const t = &out.table.affine;
+                const words = try b.upload(t.words.bytes);
+                const scales = try b.upload(t.scales.bytes);
+                const biases = try b.upload(t.biases.bytes);
+                // the host's gather reads the copies from here on
+                t.words.bytes = words.slice(u8, t.words.bytes.len);
+                t.scales.bytes = scales.slice(u8, t.scales.bytes.len);
+                t.biases.bytes = biases.slice(u8, t.biases.bytes.len);
+                out.resident = .{ .words = words, .scales = scales, .biases = biases, .gpu = where == .gpu };
+            },
+        }
+        for (&out.key, w.key) |*dst, src| dst.* = try b.linear(src.key, use_tensors);
+        inline for (.{ "key_bias", "key_gain", "query_gain", "delta_gain" }, .{ "bias", "key_norm", "query_norm", "residual_scale" }) |dst, field| {
+            var tensors: [ihc.streams]core.checkpoint_host.Tensor = undefined;
+            for (&tensors, w.key) |*tensor, src| tensor.* = @field(src, field);
+            @field(out, dst) = try concatenate(&b, &tensors);
+        }
+        out.own = b;
+        return out;
+    }
+
+    pub fn deinit(self: *Layer) void {
+        self.own.clear();
+        self.* = undefined;
+    }
+};
+
+fn concatenate(b: *common.Buffers, weights_: []const core.checkpoint_host.Tensor) !mtl.Buffer {
+    const size = weights_[0].bytes.len;
+    const result = try b.alloc(size * weights_.len);
+    const bytes = result.slice(u8, size * weights_.len);
+    for (weights_, 0..) |tensor, i| @memcpy(bytes[i * size ..][0..size], tensor.bytes);
+    return result;
+}
+
+pub const Scratch = struct {
+    own: common.Buffers,
+    capacity: u32,
+    raw: Ref,
+    normalized: Ref,
+    keys: Ref,
+    value: Ref,
+    media_mask: Ref,
+    /// Table rows a token and column, for the GPU gather.
+    table_rows: Ref,
+
+    pub fn init(a: std.mem.Allocator, d: mtl.Device, capacity: u32, hidden: u32) !Scratch {
+        if (capacity == 0 or hidden == 0) return error.BadHy4EngramShape;
+        var b: common.Buffers = .{ .a = a, .d = d };
+        errdefer b.clear();
+        var out: Scratch = .{
+            .own = undefined,
+            .capacity = capacity,
+            .raw = try b.rows(capacity, engram.columns * width),
+            .normalized = try b.rows(capacity, engram.columns * width),
+            .keys = try b.rows(capacity, ihc.streams * hidden),
+            .value = try b.rows(capacity, hidden),
+            .media_mask = .{ .buffer = try b.alloc(@as(usize, capacity) * @sizeOf(u32)) },
+            .table_rows = .{ .buffer = try b.alloc(@as(usize, capacity) * engram.columns * @sizeOf(u32)) },
+        };
+        out.own = b;
+        return out;
+    }
+
+    pub fn deinit(self: *Scratch) void {
+        self.own.clear();
+        self.* = undefined;
+    }
+
+    /// Windows come from committed or speculative lane token history. A media row leaves its hidden streams untouched.
+    pub fn stage(self: *const Scratch, a: std.mem.Allocator, layer: *const Layer, windows: []const [engram.order]u32, media: []const u32) !void {
+        if (windows.len == 0 or windows.len > self.capacity or windows.len != media.len) return error.BadHy4EngramRows;
+        const cells = windows.len * engram.columns * width;
+        if (layer.resident) |r| if (r.gpu) {
+            const out = self.table_rows.buffer.slice(u32, windows.len * engram.columns);
+            for (windows, 0..) |window, t| out[t * engram.columns ..][0..engram.columns].* = layer.table.windowRows(window);
+            @memcpy(self.media_mask.buffer.slice(u32, media.len), media);
+            return;
+        };
+        try layer.table.gather(a, windows, self.raw.buffer.slice(u16, cells));
+        @memcpy(self.media_mask.buffer.slice(u32, media.len), media);
+    }
+};
+
+pub const Kernels = struct {
+    lookup: mtl.Pipeline,
+    apply: mtl.Pipeline,
+    gather: mtl.Pipeline,
+
+    pub fn load(d: mtl.Device) !Kernels {
+        const library = try mtl.Library.fromSource(d, sources.hy4_flash_engram, mtl.CompileOptions.mlx());
+        defer library.deinit();
+        var lookup = try mtl.Pipeline.init(d, library, "tf_hy4_engram_lookup", false);
+        errdefer lookup.deinit();
+        var apply = try mtl.Pipeline.init(d, library, "tf_hy4_engram_apply", false);
+        errdefer apply.deinit();
+        return .{ .lookup = lookup, .apply = apply, .gather = try mtl.Pipeline.init(d, library, "tf_hy4_engram_gather", false) };
+    }
+
+    pub fn deinit(self: *Kernels) void {
+        self.lookup.deinit();
+        self.apply.deinit();
+        self.gather.deinit();
+    }
+
+    pub fn forward(self: Kernels, ops: *const common.Kernels, e: mtl.ComputeEncoder, w: *const Layer, s: *const Scratch, x: Ref, output: Ref, rows: u32) !void {
+        if (rows == 0 or rows > s.capacity) return error.BadHy4EngramRows;
+        if (w.resident) |r| if (r.gpu) {
+            const cells: u32 = rows * engram.columns * width;
+            e.setPipeline(self.gather);
+            e.setBuffer(r.words, 0, 0);
+            e.setBuffer(r.scales, 0, 1);
+            e.setBuffer(r.biases, 0, 2);
+            e.setBuffer(s.table_rows.buffer, 0, 3);
+            e.setBuffer(s.raw.buffer, 0, 4);
+            e.setValue([2]u32{ w.table.affine.bits, cells }, 5);
+            e.dispatchThreads(mtl.Size.of(cells, 1, 1), mtl.Size.of(256, 1, 1));
+            e.barrier();
+        };
+        e.setPipeline(self.lookup);
+        e.setBuffer(s.raw.buffer, 0, 0);
+        e.setBuffer(w.lookup_gamma, 0, 1);
+        e.setBuffer(s.normalized.buffer, 0, 2);
+        e.setValue(@as(u32, @intFromBool(w.fp8)), 3);
+        e.dispatchGroups(mtl.Size.of(engram.columns, rows, 1), mtl.Size.of(32, 1, 1));
+        e.barrier();
+        var outs: [1 + ihc.streams]common.Kernels.Out = undefined;
+        outs[0] = .{ .w = w.value, .y = s.value };
+        for (w.key, 0..) |projection, i| {
+            outs[1 + i] = .{ .w = projection, .y = .{ .buffer = s.keys.buffer, .offset = i * rows * w.hidden * @sizeOf(u16) } };
+        }
+        try ops.linearsFrom(e, s.normalized, &outs, rows);
+        e.barrier();
+        e.setPipeline(self.apply);
+        const buffers = [_]Ref{
+            x,                           s.keys,  .{ .buffer = w.key_bias },   .{ .buffer = w.key_gain },   .{ .buffer = w.query_gain },
+            .{ .buffer = w.delta_gain }, s.value, .{ .buffer = w.value_bias }, .{ .buffer = w.value_gain }, s.media_mask,
+            output,
+        };
+        for (buffers, 0..) |b, i| e.setBuffer(b.buffer, b.offset, i);
+        e.setValue([2]u32{ rows, w.hidden }, buffers.len);
+        e.dispatchGroups(mtl.Size.of(ihc.streams, rows, 1), mtl.Size.of(128, 1, 1));
+    }
+};
diff --git a/zig/src/families/hy4_flash/metal_index.zig b/zig/src/families/hy4_flash/metal_index.zig
new file mode 100644
index 0000000000000000000000000000000000000000..620bcee41587b332cb4e14cae773ba37b7223ecd
--- /dev/null
+++ b/zig/src/families/hy4_flash/metal_index.zig
@@ -0,0 +1,232 @@
+//! Hy4-flash's compressed sparse indexer on Metal, after the reference's CompressedIndexer
+const std = @import("std");
+const mtl = @import("metal");
+const source = @import("kernel_sources");
+const dense = @import("metal_dense.zig");
+const mla_gpu = @import("mla_metal.zig");
+const rope = @import("rope.zig");
+const weights = @import("model_weights.zig");
+const recall = @import("index_recall.zig");
+
+pub const Ref = dense.Ref;
+pub const heads = recall.heads;
+pub const width = recall.width;
+/// group_topk: 511 closed groups and the query's own.
+pub const budget_groups: u32 = 512;
+/// A row's recalled key list: 512 groups of four slots.
+pub const keys_a_row: u32 = budget_groups * 4;
+
+pub const Weights = struct {
+    token_keys: dense.Linear,
+    token_norm: mtl.Buffer,
+    query: dense.Linear,
+    head_weights: dense.Linear,
+    values: mtl.Buffer,
+    gates: mtl.Buffer,
+    bias: mtl.Buffer,
+    norm: mtl.Buffer,
+
+    /// The projections take the row kernels: the tensor units' packings exist only for the layers' own shapes.
+    pub fn upload(b: *dense.Buffers, w: *const weights.Index, tensors: bool) !Weights {
+        _ = tensors;
+        return .{
+            .token_keys = try b.linear(w.token_keys, false),
+            .token_norm = try b.upload(w.token_norm.bytes),
+            .query = try b.linear(w.query, false),
+            .head_weights = try b.linear(w.head_weights, false),
+            .values = try b.upload(w.group_values.bytes),
+            .gates = try b.upload(w.group_gates.bytes),
+            .bias = try b.upload(w.group_bias.bytes),
+            .norm = try b.upload(w.group_norm.bytes),
+        };
+    }
+};
+
+pub const Kernels = struct {
+    keys: mtl.Pipeline,
+    groups: mtl.Pipeline,
+    score: mtl.Pipeline,
+    select: mtl.Pipeline,
+
+    pub fn load(device: mtl.Device) !Kernels {
+        const build = try mtl.Library.fromSource(device, source.hy4_flash_index_build, mtl.CompileOptions.mlx());
+        defer build.deinit();
+        const rec = try mtl.Library.fromSource(device, source.hy4_flash_index_recall, mtl.CompileOptions.mlx());
+        defer rec.deinit();
+        var keys = try mtl.Pipeline.init(device, build, "tf_hy4_index_keys", false);
+        errdefer keys.deinit();
+        var groups = try mtl.Pipeline.init(device, build, "tf_hy4_index_groups", false);
+        errdefer groups.deinit();
+        var score = try mtl.Pipeline.init(device, rec, "tf_hy4_group_scores", false);
+        errdefer score.deinit();
+        return .{ .keys = keys, .groups = groups, .score = score, .select = try mtl.Pipeline.init(device, rec, "tf_hy4_recall_groups", false) };
+    }
+
+    pub fn deinit(self: *Kernels) void {
+        self.keys.deinit();
+        self.groups.deinit();
+        self.score.deinit();
+        self.select.deinit();
+    }
+};
+
+/// A pass's indexer rows: each row's projections, and the groups it touches with their rotary positions.
+pub const Scratch = struct {
+    own: dense.Buffers,
+    capacity: u32,
+    keys: Ref,
+    query: Ref,
+    head_weights: Ref,
+    recall_rows: mtl.Buffer,
+    group_positions: mtl.Buffer,
+    group_table: Ref,
+    first: u32 = 0,
+    rows: u32 = 0,
+
+    pub fn init(a: std.mem.Allocator, device: mtl.Device, rows: u32) !Scratch {
+        var b: dense.Buffers = .{ .a = a, .d = device };
+        errdefer b.clear();
+        const groups = rows / 4 + 2;
+        var out: Scratch = .{
+            .own = undefined,
+            .capacity = rows,
+            .keys = try b.rows(rows, width),
+            .query = try b.rows(rows, heads * width),
+            .head_weights = try b.rows(rows, heads),
+            .recall_rows = try b.alloc(@as(usize, rows) * @sizeOf(recall.Row)),
+            .group_positions = try b.alloc(@as(usize, groups) * 3 * @sizeOf(i32)),
+            .group_table = try b.rows(groups, 2 * rope.pairs),
+        };
+        out.own = b;
+        return out;
+    }
+
+    pub fn deinit(self: *Scratch) void {
+        self.own.clear();
+        self.* = undefined;
+    }
+
+    /// The pass's rows sit at positions first.. (consecutive); call before encoding, after the previous pass completed.
+    pub fn stage(self: *Scratch, first: u32, rows: u32) !void {
+        if (rows == 0 or rows > self.capacity) return error.BadHy4IndexRows;
+        self.first = first;
+        self.rows = rows;
+        const r = self.recall_rows.slice(recall.Row, rows);
+        for (r, 0..) |*row, i| row.* = .{ .group_base = 0, .token = first + @as(u32, @intCast(i)) };
+        const g0 = first / 4;
+        const count = (first + rows - 1) / 4 - g0 + 1;
+        const pos = self.group_positions.slice(i32, count * 3);
+        for (0..count) |g| pos[g * 3 ..][0..3].* = @splat(@intCast((g0 + g) * 4));
+    }
+
+    pub fn groupRange(self: *const Scratch) [2]u32 {
+        const g0 = self.first / 4;
+        return .{ g0, (self.first + self.rows - 1) / 4 - g0 + 1 };
+    }
+
+    /// Whether any row's attention takes recalled lists: a row at 2,048 or past has more closed groups than it keeps.
+    pub fn selects(self: *const Scratch) bool {
+        return self.first + self.rows - 1 >= keys_a_row;
+    }
+};
+
+/// A sparse layer's indexer state for one stream, and the pass's shared score rows and this layer's key lists.
+pub const Cache = struct {
+    token_keys: Ref, // [capacity][128] BF16
+    group_keys: Ref, // [capacity / 4][128] BF16, RoPE'd at each group's first slot
+    capacity: u32, // slots (a multiple of 4)
+    scores: Ref, // [rows][score_groups] fp32, shared by every layer of a pass
+    score_groups: u32,
+    tokens: Ref, // [rows][2048] i32: each row's recalled slots, this layer's (the drafter reads the anchor's)
+    counts: Ref, // [rows] i32
+
+    pub fn tokenBytes(capacity: u32) usize {
+        return @as(usize, capacity) * width * 2;
+    }
+
+    pub fn groupBytes(capacity: u32) usize {
+        return @as(usize, capacity / 4) * width * 2;
+    }
+};
+
+/// What attendSeam needs to run a sparse layer's indexer.
+pub const Pass = struct {
+    kernels: *const Kernels,
+    scratch: *const Scratch,
+    cache: Cache,
+};
+
+const KeysArgs = extern struct { rows: u32, capacity: u32, epsilon: f32 };
+const GroupArgs = extern struct { first: u32, count: u32, capacity_groups: u32, epsilon: f32 };
+const RecallShape = extern struct { rows: u32, score_groups: u32, group_budget: u32 };
+
+/// The indexer for the staged rows: `normalized` is the layer's input (the reference's hidden_states)
+pub fn run(p: Pass, common: *const dense.Kernels, project: mla_gpu.Projections, e: mtl.ComputeEncoder, w: *const Weights, normalized: Ref, q_resid: Ref, write_slots: Ref, positions: Ref, table: Ref, r: rope.Parameters, epsilon: f32) !void {
+    encode(p, common, project, e, w, normalized, q_resid, write_slots, positions, table, r, epsilon) catch |err| {
+        std.log.err("hy4 indexer: {s}", .{@errorName(err)});
+        return err;
+    };
+}
+
+fn encode(p: Pass, common: *const dense.Kernels, project: mla_gpu.Projections, e: mtl.ComputeEncoder, w: *const Weights, normalized: Ref, q_resid: Ref, write_slots: Ref, positions: Ref, table: Ref, r: rope.Parameters, epsilon: f32) !void {
+    const k = p.kernels;
+    const s = p.scratch;
+    const c = p.cache;
+    const rows = s.rows;
+    if (rows == 0) return error.BadHy4IndexRows;
+    const range = s.groupRange();
+    if ((range[0] + range[1]) * 4 > c.capacity) return error.Hy4IndexPastCapacity;
+    // the projections, and both rotary tables (positions only)
+    try common.linear(e, w.token_keys, normalized, s.keys, rows);
+    try common.linear(e, w.head_weights, normalized, s.head_weights, rows);
+    try common.linear(e, w.query, q_resid, s.query, rows);
+    project.rotaryTable(e, positions, table, rows, r);
+    project.rotaryTable(e, .{ .buffer = s.group_positions }, s.group_table, range[1], r);
+    e.barrier();
+    // each row's normalized key at its slot; the query heads' trailing 64 channels rotated in place
+    e.setPipeline(k.keys);
+    e.setBuffer(s.keys.buffer, s.keys.offset, 0);
+    e.setBuffer(w.token_norm, 0, 1);
+    e.setBuffer(write_slots.buffer, write_slots.offset, 2);
+    e.setBuffer(c.token_keys.buffer, c.token_keys.offset, 3);
+    e.setValue(KeysArgs{ .rows = rows, .capacity = c.capacity, .epsilon = epsilon }, 4);
+    e.dispatchGroups(mtl.Size.of(rows, 1, 1), mtl.Size.of(width, 1, 1));
+    const q_rot: Ref = .{ .buffer = s.query.buffer, .offset = s.query.offset + (width - 2 * rope.pairs) * 2 };
+    try project.rotate(e, q_rot, table, q_rot, .{ .rows = rows, .heads = heads, .input_stride = width, .output_stride = width });
+    e.barrier();
+    // the touched groups pooled from the cached keys
+    e.setPipeline(k.groups);
+    e.setBuffer(c.token_keys.buffer, c.token_keys.offset, 0);
+    e.setBuffer(w.values, 0, 1);
+    e.setBuffer(w.gates, 0, 2);
+    e.setBuffer(w.bias, 0, 3);
+    e.setBuffer(w.norm, 0, 4);
+    e.setBuffer(c.group_keys.buffer, c.group_keys.offset, 5);
+    e.setValue(GroupArgs{ .first = range[0], .count = range[1], .capacity_groups = c.capacity / 4, .epsilon = epsilon }, 6);
+    e.dispatchGroups(mtl.Size.of(range[1], 1, 1), mtl.Size.of(width, 1, 1));
+    e.barrier();
+    const g_rot: Ref = .{ .buffer = c.group_keys.buffer, .offset = c.group_keys.offset + (@as(usize, range[0]) * width + width - 2 * rope.pairs) * 2 };
+    try project.rotate(e, g_rot, s.group_table, g_rot, .{ .rows = range[1], .heads = 1, .input_stride = width, .output_stride = width });
+    if (!s.selects()) return;
+    e.barrier();
+    const last = s.first + rows - 1;
+    const shape: RecallShape = .{ .rows = rows, .score_groups = c.score_groups, .group_budget = budget_groups };
+    if (last / 4 > c.score_groups) return error.Hy4IndexPastCapacity;
+    e.setPipeline(k.score);
+    e.setBuffer(s.query.buffer, s.query.offset, 0);
+    e.setBuffer(c.group_keys.buffer, c.group_keys.offset, 1);
+    e.setBuffer(s.head_weights.buffer, s.head_weights.offset, 2);
+    e.setBuffer(s.recall_rows, 0, 3);
+    e.setBuffer(c.scores.buffer, c.scores.offset, 4);
+    e.setValue(shape, 5);
+    e.setValue(recall.head_scale, 6);
+    e.dispatchGroups(mtl.Size.of((last / 4 + 3) / 4, rows, 1), mtl.Size.of(128, 1, 1));
+    e.barrier();
+    e.setPipeline(k.select);
+    e.setBuffer(c.scores.buffer, c.scores.offset, 0);
+    e.setBuffer(s.recall_rows, 0, 1);
+    e.setBuffer(c.tokens.buffer, c.tokens.offset, 2);
+    e.setBuffer(c.counts.buffer, c.counts.offset, 3);
+    e.setValue(shape, 4);
+    e.dispatchGroups(mtl.Size.of(rows, 1, 1), mtl.Size.of(256, 1, 1));
+}
diff --git a/zig/src/families/hy4_flash/metal_linears.zig b/zig/src/families/hy4_flash/metal_linears.zig
new file mode 100644
index 0000000000000000000000000000000000000000..eb89517573a3d39d1dc1d265a311a07c77bd1c0c
--- /dev/null
+++ b/zig/src/families/hy4_flash/metal_linears.zig
@@ -0,0 +1,123 @@
+//! Hy4-flash's dense projection kernels: the tensor units' lane projections by shape, and the row kernels.
+const std = @import("std");
+const mtl = @import("metal");
+const affine = @import("../../core/row_projection.zig");
+const cfg = @import("config.zig");
+const ihc = @import("ihc.zig");
+const ihc_gpu = @import("ihc_metal.zig");
+const mla_gpu = @import("mla_metal.zig");
+const mha = @import("mla_attention.zig");
+const shape_ = @import("mla_weights.zig");
+const gpu_qkv = @import("metal_tensor_qkv.zig");
+const lane = @import("../../core/lane_projection.zig");
+const dense = @import("metal_dense.zig");
+const Buffers = dense.Buffers;
+const Ref = dense.Ref;
+const Attention = dense.Attention;
+
+/// The lane projections for every dense shape a model has, made once at load
+pub const Linears = struct {
+    shapes: [16][2]u32 = undefined,
+    projections: [16]lane.Projection = undefined,
+    /// The same projections adding their own group sums (4-bit reg layouts), for small passes.
+    inlines: [16]?lane.Projection = @splat(null),
+    count: usize = 0,
+    sums: ?mtl.Buffer = null,
+    pub const sum_rows = gpu_qkv.prompt_rows;
+
+    pub fn load(a: std.mem.Allocator, device: mtl.Device, t: cfg.Text, bits: u8) !Linears {
+        var out: Linears = .{};
+        errdefer out.deinit();
+        const v = shape_.value_width;
+        const wanted = [_][2]u32{
+            .{ t.hidden_size, t.swa_num_attention_heads * v },
+            .{ t.hidden_size, t.num_attention_heads * v },
+            .{ t.routed_expert_hidden_size, t.hidden_size },
+            .{ t.moe_intermediate_size * t.n_shared_experts, t.hidden_size },
+            .{ t.hidden_size, t.routed_expert_hidden_size },
+            .{ t.hidden_size, t.moe_intermediate_size * t.n_shared_experts },
+            .{ t.intermediate_size, t.hidden_size },
+            .{ t.hidden_size, t.intermediate_size },
+            .{ t.vocab_size, t.hidden_size },
+            // Engram's value and stream keys over a lookup row: every column's slice of the n-gram embedding
+            .{ t.hidden_size, @import("engram.zig").columns * (t.engram_n_embed_per_ngram / @import("engram.zig").heads) },
+        };
+        var groups: usize = 0;
+        for (wanted) |nk| {
+            if (out.find(nk[0], nk[1]) != null or nk[0] % 32 != 0) continue;
+            out.projections[out.count] = try lane.Projection.init(a, device, gpu_qkv.denseLayout(bits, nk[0], nk[1]));
+            out.inlines[out.count] = if (gpu_qkv.withInlineSums(gpu_qkv.denseLayout(bits, nk[0], nk[1]))) |l| try lane.Projection.init(a, device, l) else null;
+            out.shapes[out.count] = nk;
+            out.count += 1;
+            groups = @max(groups, nk[1] / 64);
+        }
+        out.sums = try device.buffer(sum_rows * groups * 4, mtl.ResourceOptions.shared);
+        return out;
+    }
+
+    pub fn deinit(self: *Linears) void {
+        for (self.projections[0..self.count]) |p| p.deinit();
+        for (self.inlines[0..self.count]) |p| if (p) |x| x.deinit();
+        if (self.sums) |b| b.deinit();
+        self.count = 0;
+    }
+
+    pub fn find(self: *const Linears, n: u32, k: u32) ?*const lane.Projection {
+        for (self.shapes[0..self.count], self.projections[0..self.count]) |nk, *p| if (nk[0] == n and nk[1] == k) return p;
+        return null;
+    }
+
+    pub fn findInline(self: *const Linears, n: u32, k: u32) ?*const lane.Projection {
+        for (self.shapes[0..self.count], self.inlines[0..self.count]) |nk, *p| if (nk[0] == n and nk[1] == k) if (p.*) |*x| return x;
+        return null;
+    }
+};
+
+/// The row kernels for 2-8 row passes of portable weights
+pub const Rows = struct {
+    q4: mtl.Pipeline,
+    q8: mtl.Pipeline,
+    rps: u32 = 2,
+    /// Greedy tokens on the GPU (first index of the largest logit), so draft columns chain without the host.
+    argmax: mtl.Pipeline,
+
+    pub fn load(a: std.mem.Allocator, device: mtl.Device) !Rows {
+        const text = try std.mem.concat(a, u8, &.{ affine.source(device.tensorUnits()), @import("kernel_sources").hy4_flash_rows });
+        defer a.free(text);
+        const lib = try mtl.Library.fromSource(device, text, mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        var q4 = try mtl.Pipeline.init(device, lib, "tf_hy4_rows_r2_q4", false);
+        errdefer q4.deinit();
+        var q8 = try mtl.Pipeline.init(device, lib, "tf_hy4_rows_r2_q8", false);
+        errdefer q8.deinit();
+        return .{ .q4 = q4, .q8 = q8, .argmax = try mtl.Pipeline.init(device, lib, "tf_hy4_argmax", false) };
+    }
+
+    pub fn deinit(self: Rows) void {
+        self.q4.deinit();
+        self.q8.deinit();
+        self.argmax.deinit();
+    }
+
+    /// out[at + r] = the greedy token of logits row r, for `rows` rows of `vocab`.
+    pub fn pick(self: Rows, e: mtl.ComputeEncoder, logits: Ref, out: Ref, at: u32, rows: u32, vocab: u32) void {
+        e.setPipeline(self.argmax);
+        e.setBuffer(logits.buffer, logits.offset, 0);
+        e.setBuffer(out.buffer, out.offset, 1);
+        e.setValue([2]u32{ vocab, at }, 2);
+        e.dispatchGroups(mtl.Size.of(rows, 1, 1), mtl.Size.of(1024, 1, 1));
+    }
+
+    pub fn sg(self: Rows) u32 {
+        return if (self.rps == 1) 8 else 4;
+    }
+
+    pub fn choose(self: Rows, w: affine.Weights, rows: u32) ?mtl.Pipeline {
+        if (rows < 2 or w.sum != .f32 or w.n % (self.rps * self.sg()) != 0) return null;
+        return switch (w.bits) {
+            4 => self.q4,
+            8 => self.q8,
+            else => null,
+        };
+    }
+};
diff --git a/zig/src/families/hy4_flash/metal_model.zig b/zig/src/families/hy4_flash/metal_model.zig
new file mode 100644
index 0000000000000000000000000000000000000000..936cbdda96207bea0c3e973be79775130e9ed4d2
--- /dev/null
+++ b/zig/src/families/hy4_flash/metal_model.zig
@@ -0,0 +1,312 @@
+//! The Metal target graph. Lane-owned cache buffers and retained slots are supplied for each layer.
+const std = @import("std");
+const mtl = @import("metal");
+const source = @import("kernel_sources");
+const aff = @import("../../core/row_projection.zig");
+const load = @import("loader.zig");
+const weights = @import("model_weights.zig");
+const dense = @import("metal_dense.zig");
+const routed = @import("metal_routed.zig");
+const memory = @import("metal_engram.zig");
+const engram = @import("engram.zig");
+const ihc = @import("ihc.zig");
+const index = @import("metal_index.zig");
+
+pub const Ref = dense.Ref;
+
+const Block = struct {
+    attention: dense.Attention,
+    feed: union(enum) { dense: dense.Feed, routed: routed.Layer },
+    memory: ?memory.Layer,
+
+    fn upload(a: std.mem.Allocator, device: mtl.Device, host: *load.Loaded, i: u32, use_tensors: bool) !Block {
+        const config = host.config.value.text_config;
+        var w = try weights.TargetLayer.read(a, host, i, .{ .rank = 0, .world = 1 }, 1);
+        defer w.deinit(a);
+        var attention = try dense.Attention.uploadForModel(a, device, &w, config, use_tensors);
+        errdefer attention.deinit();
+        var mem = if (w.memory) |*v| try memory.Layer.uploadForModel(a, device, v, config.hidden_size, config.engram_fp8_embedding, use_tensors) else null;
+        errdefer if (mem) |*v| v.deinit();
+        return .{
+            .attention = attention,
+            .feed = switch (w.feed) {
+                .dense => .{ .dense = try dense.Feed.uploadForModel(a, device, &w, use_tensors) },
+                .routed => .{ .routed = try routed.Layer.uploadForModel(a, device, &w, config, use_tensors) },
+            },
+            .memory = mem,
+        };
+    }
+
+    fn deinit(self: *Block) void {
+        if (self.memory) |*v| v.deinit();
+        switch (self.feed) {
+            inline else => |*v| v.deinit(),
+        }
+        self.attention.deinit();
+    }
+};
+
+const Head = struct {
+    owned: dense.Buffers,
+    embedding: aff.Weights,
+    vocab: dense.Linear,
+    norm: mtl.Buffer,
+    merge: dense.Merge,
+    lookup: mtl.Pipeline,
+
+    fn upload(a: std.mem.Allocator, device: mtl.Device, w: weights.Head, tensors: bool) !Head {
+        var b: dense.Buffers = .{ .a = a, .d = device };
+        errdefer b.clear();
+        const lib = try mtl.Library.fromSource(device, source.embed_norm, mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        const name: [:0]const u8 = switch (w.embedding.bits) {
+            4 => "tf_embed_b4_g64",
+            8 => "tf_embed_b8_g64",
+            else => return error.BadHy4EmbedBits,
+        };
+        var out: Head = .{
+            .owned = undefined,
+            .embedding = try b.matrix(w.embedding),
+            .vocab = try b.linear(w.lm_head, tensors),
+            .norm = try b.upload(w.norm.bytes),
+            .merge = try dense.Merge.upload(&b, w.merge),
+            .lookup = try mtl.Pipeline.init(device, lib, name, false),
+        };
+        out.owned = b;
+        return out;
+    }
+
+    fn deinit(self: *Head) void {
+        self.lookup.deinit();
+        self.owned.clear();
+    }
+
+    fn embed(self: Head, e: mtl.ComputeEncoder, ids: Ref, out: Ref, rows: u32) void {
+        const w = self.embedding;
+        e.setPipeline(self.lookup);
+        e.setBuffer(ids.buffer, ids.offset, 0);
+        e.setBuffer(w.w, w.w_off, 1);
+        e.setBuffer(w.scales, w.s_off, 2);
+        e.setBuffer(w.biases, w.b_off, 3);
+        e.setValue(@as(i32, @intCast(w.k)), 4);
+        e.setBuffer(out.buffer, out.offset, 5);
+        e.dispatchThreads(mtl.Size.of(w.k / @as(usize, if (w.bits == 4) 2 else 1), rows, 1), mtl.Size.of(128, 1, 1));
+    }
+};
+
+pub const Model = struct {
+    allocator: std.mem.Allocator,
+    host: load.Loaded,
+    blocks: []Block,
+    head: Head,
+    common: dense.Kernels,
+    routed: routed.Kernels,
+    memory: memory.Kernels,
+    /// The sparse layers' compressed indexer (used when a lane cache carries index state).
+    index: index.Kernels,
+
+    pub fn open(a: std.mem.Allocator, io: std.Io, device: mtl.Device, dir: []const u8) !Model {
+        var host = try load.Loaded.open(a, io, dir);
+        errdefer host.close();
+        const t = host.config.value.text_config;
+        var common = try dense.Kernels.loadForModel(a, device, t, host.bits);
+        errdefer common.deinit();
+        var route = try routed.Kernels.loadForModel(a, device, t, host.bits);
+        errdefer route.deinit();
+        var mem = try memory.Kernels.load(device);
+        errdefer mem.deinit();
+        var ix = try index.Kernels.load(device);
+        errdefer ix.deinit();
+        var head = try Head.upload(a, device, try weights.Head.read(&host, 1), common.linears != null);
+        errdefer head.deinit();
+        const blocks = try a.alloc(Block, t.num_hidden_layers);
+        errdefer a.free(blocks);
+        var built: usize = 0;
+        errdefer for (blocks[0..built]) |*block| block.deinit();
+        for (blocks, 0..) |*block, i| {
+            block.* = try Block.upload(a, device, &host, @intCast(i), common.tensors != null);
+            built += 1;
+        }
+        host.checkpoint.release();
+        return .{
+            .allocator = a,
+            .host = host,
+            .blocks = blocks,
+            .head = head,
+            .common = common,
+            .routed = route,
+            .memory = mem,
+            .index = ix,
+        };
+    }
+
+    pub fn deinit(self: *Model) void {
+        for (self.blocks) |*block| block.deinit();
+        self.allocator.free(self.blocks);
+        self.head.deinit();
+        self.memory.deinit();
+        self.index.deinit();
+        self.routed.deinit();
+        self.common.deinit();
+        self.host.close();
+        self.* = undefined;
+    }
+
+    pub fn encode(self: *Model, e: mtl.ComputeEncoder, frame: *Frame, cache: []const LayerCache) !Ref {
+        if (frame.rows == 0 or cache.len != self.blocks.len) return error.BadHy4MetalFrame;
+        var x = frame.streams[0];
+        var y = frame.streams[1];
+        self.embedRows(e, frame.ids, x, frame.rows * ihc.streams);
+        e.barrier();
+        var mem_ix: usize = 0;
+        // each sub-block's tail writes the next collapse's partials (an Engram layer between them recomputes them)
+        var ready = false;
+        var headed = false;
+        for (self.blocks, cache, 0..) |*block, lane, bi| {
+            if (block.memory) |*m| {
+                try self.memory.forward(&self.common, e, m, &frame.memory[mem_ix], x, y, frame.rows);
+                e.barrier();
+                std.mem.swap(Ref, &x, &y);
+                mem_ix += 1;
+                ready = false;
+                headed = false;
+            }
+            try frame.common.bind(frame.rows, block.attention.heads, lane.key_stride);
+            const feed_merge = switch (block.feed) {
+                .dense => |*w| w.merge,
+                .routed => |*w| w.merge,
+            };
+            const feed_gain = switch (block.feed) {
+                .dense => |*w| w.norm,
+                .routed => |*w| w.input_norm,
+            };
+            // decode passes run each tail with the next collapse's head in one launch
+            const fuse = dense.Kernels.fusedSeams(frame.rows);
+            var rows = lane.rows;
+            if (lane.index) |c| if (block.attention.index != null) {
+                rows.index = .{ .kernels = &self.index, .scratch = &frame.index, .cache = c };
+            };
+            try self.common.attendSeam(e, &block.attention, &frame.common, rows, x, y, .{ .ready = ready, .headed = headed, .next = feed_merge, .next_gain = if (fuse) feed_gain else null });
+            e.barrier();
+            std.mem.swap(Ref, &x, &y);
+            const next: ?dense.Merge = if (bi + 1 < self.blocks.len)
+                (if (self.blocks[bi + 1].memory != null) null else self.blocks[bi + 1].attention.merge)
+            else
+                self.head.merge;
+            const next_gain: ?mtl.Buffer = if (!fuse or next == null) null else if (bi + 1 < self.blocks.len) self.blocks[bi + 1].attention.norm else self.head.norm;
+            switch (block.feed) {
+                .dense => |*w| try self.common.feedSeam(e, w, &frame.common, x, y, .{ .ready = true, .headed = fuse, .next = next, .next_gain = next_gain }),
+                .routed => |*w| try self.routed.forwardSeam(&self.common, e, w, &frame.common, &frame.routed, x, y, .{ .ready = true, .headed = fuse, .next = next, .next_gain = next_gain }),
+            }
+            e.barrier();
+            std.mem.swap(Ref, &x, &y);
+            ready = next != null;
+            headed = next_gain != null;
+        }
+        _ = try self.common.collapseSeamFrom(e, x, self.head.merge, self.head.norm, &frame.common, .{ .ready = ready, .headed = headed });
+        if (frame.last_logits) {
+            // a prompt chunk needs only its last row's logits (the same bits: rows are independent)
+            const h = self.host.config.value.text_config.hidden_size;
+            const last: Ref = .{ .buffer = frame.common.normalized.buffer, .offset = frame.common.normalized.offset + @as(usize, frame.rows - 1) * h * 2 };
+            try self.readout(e, last, frame.logits, 1);
+        } else try self.readout(e, frame.common.normalized, frame.logits, frame.rows);
+        return frame.logits;
+    }
+
+    pub fn embedRows(self: *const Model, e: mtl.ComputeEncoder, ids: Ref, out: Ref, rows: u32) void {
+        self.head.embed(e, ids, out, rows);
+    }
+
+    pub fn readout(self: *const Model, e: mtl.ComputeEncoder, x: Ref, out: Ref, rows: u32) !void {
+        try self.common.linear(e, self.head.vocab, x, out, rows);
+    }
+};
+
+/// A layer's cache rows for a pass; a sparse layer's `index` runs the compressed indexer (beyond the probe's 2,048).
+pub const LayerCache = struct { rows: dense.CacheRows, key_stride: u32, index: ?index.Cache = null };
+
+pub const Frame = struct {
+    own: dense.Buffers,
+    capacity: u32,
+    rows: u32 = 0,
+    /// Read out only the last row's logits (a prompt chunk); they land in logits row 0.
+    last_logits: bool = false,
+    streams: [2]Ref,
+    ids: Ref,
+    logits: Ref,
+    common: dense.Scratch,
+    routed: routed.Scratch,
+    memory: []memory.Scratch,
+    /// The indexer's rows; the caller stages their first position with `index.stage` before a pass with index caches.
+    index: index.Scratch,
+
+    pub fn init(a: std.mem.Allocator, device: mtl.Device, model: *const Model, rows: u32, key_stride: u32) !Frame {
+        const t = model.host.config.value.text_config;
+        if (rows == 0 or rows > routed.prompt_rows) return error.BadHy4MetalFrame;
+        var needed: usize = 0;
+        var largest = &model.blocks[0].attention;
+        for (model.blocks) |*b| {
+            needed += @intFromBool(b.memory != null);
+            if (b.attention.heads > largest.heads) largest = &b.attention;
+        }
+        const memories = try a.alloc(memory.Scratch, needed);
+        errdefer a.free(memories);
+        var made: usize = 0;
+        errdefer for (memories[0..made]) |*m| m.deinit();
+        for (memories) |*m| {
+            m.* = try memory.Scratch.init(a, device, rows, t.hidden_size);
+            made += 1;
+        }
+        const inner = @max(t.moe_intermediate_size * t.n_shared_experts, t.intermediate_size);
+        var common = try dense.Scratch.initForModel(a, device, largest, inner, key_stride, rows, model.common.tensors != null);
+        errdefer common.deinit();
+        var route = try routed.Scratch.initForModel(a, device, t, rows, model.routed.tensors != null);
+        errdefer route.deinit();
+        var ix = try index.Scratch.init(a, device, rows);
+        errdefer ix.deinit();
+        var b: dense.Buffers = .{ .a = a, .d = device };
+        errdefer b.clear();
+        var out: Frame = .{
+            .own = undefined,
+            .capacity = rows,
+            .streams = .{ try b.rows(rows, ihc.streams * t.hidden_size), try b.rows(rows, ihc.streams * t.hidden_size) },
+            .ids = .{ .buffer = try b.alloc(@as(usize, rows) * ihc.streams * @sizeOf(u32)) },
+            .logits = try b.rows(rows, t.vocab_size),
+            .common = common,
+            .routed = route,
+            .memory = memories,
+            .index = ix,
+        };
+        out.own = b;
+        return out;
+    }
+
+    pub fn deinit(self: *Frame) void {
+        self.common.deinit();
+        self.routed.deinit();
+        self.index.deinit();
+        for (self.memory) |*m| m.deinit();
+        self.own.a.free(self.memory);
+        self.own.clear();
+        self.* = undefined;
+    }
+
+    /// Call after this frame's previous command buffer completes. History windows are newest token first.
+    pub fn stage(self: *Frame, model: *const Model, tokens: []const u32, windows: []const [engram.order]u32, media: []const u32) !void {
+        self.rows = 0;
+        if (tokens.len == 0 or tokens.len > self.capacity or tokens.len != windows.len or tokens.len != media.len)
+            return error.BadHy4MetalFrame;
+        const vocab = model.host.config.value.text_config.vocab_size;
+        const ids = self.ids.buffer.slice(u32, tokens.len * ihc.streams);
+        for (tokens, 0..) |token, row| {
+            if (token >= vocab or windows[row][0] != token) return error.BadHy4Token;
+            @memset(ids[row * ihc.streams ..][0..ihc.streams], token);
+        }
+        var i: usize = 0;
+        for (model.blocks) |*b| if (b.memory) |*m| {
+            try self.memory[i].stage(self.own.a, m, windows, media);
+            i += 1;
+        };
+        self.rows = @intCast(tokens.len);
+    }
+};
diff --git a/zig/src/families/hy4_flash/metal_routed.zig b/zig/src/families/hy4_flash/metal_routed.zig
new file mode 100644
index 0000000000000000000000000000000000000000..07ad68524b3de480b0f48666247cecb19b1cd1c4
--- /dev/null
+++ b/zig/src/families/hy4_flash/metal_routed.zig
@@ -0,0 +1,349 @@
+//! A Metal routed Hy4-flash feed-forward block, including the shared branch and residual merge.
+const std = @import("std");
+const mtl = @import("metal");
+const sources = @import("kernel_sources");
+const affine = @import("../../core/row_projection.zig");
+const route = @import("../../core/moe_route.zig");
+const experts = @import("affine_experts_metal.zig");
+const dense = @import("metal_dense.zig");
+const weights = @import("model_weights.zig");
+const config = @import("config.zig");
+const gpu_experts = @import("metal_tensor_experts.zig");
+const lane = @import("../../core/lane_projection.zig");
+
+const Ref = dense.Ref;
+const RouteRef = @import("draft_ops").Ref;
+const RouteOutputs = route.Outputs(RouteRef);
+/// One router window (the core select's limit); prompt chunks up to `prompt_rows` run it a window at a time.
+pub const max_rows = 16;
+pub const prompt_rows = @import("metal_tensor_qkv.zig").prompt_rows;
+
+const ExpertWeights = union(enum) {
+    portable: struct { up: experts.Weights, down: experts.Weights },
+    tensor: gpu_experts.Weights,
+};
+
+pub const Layer = struct {
+    own: dense.Buffers,
+    merge: dense.Merge,
+    input_norm: mtl.Buffer,
+    output_norm: mtl.Buffer,
+    router: RouteRef,
+    correction: RouteRef,
+    down: dense.Linear,
+    up: dense.Linear,
+    expert_weights: ExpertWeights,
+    shared_gate: dense.Linear,
+    shared_up: dense.Linear,
+    shared_down: dense.Linear,
+    precision: experts.Precision,
+    size: experts.Shape,
+    scale: f32,
+
+    pub fn upload(a: std.mem.Allocator, device: mtl.Device, w: *const weights.TargetLayer, t: config.Text) !Layer {
+        return uploadForModel(a, device, w, t, false);
+    }
+
+    pub fn uploadForModel(a: std.mem.Allocator, device: mtl.Device, w: *const weights.TargetLayer, t: config.Text, use_tensors: bool) !Layer {
+        if (w.feed != .routed) return error.Hy4RoutedFeedRequired;
+        const f = w.feed.routed;
+        if (f.experts.ids.first != 0 or f.experts.ids.count != t.n_routed_experts) return error.Hy4MetalNeedsWholeExpertSet;
+        var b: dense.Buffers = .{ .a = a, .d = device };
+        errdefer b.clear();
+        const packed_router = try b.alloc(f.router.bytes.len);
+        const router = try a.alloc(u16, f.router.bytes.len / @sizeOf(u16));
+        defer a.free(router);
+        @memcpy(std.mem.sliceAsBytes(router), f.router.bytes);
+        route.pack(router, packed_router.slice(u16, router.len), t.n_routed_experts, t.hidden_size);
+        const precision: experts.Precision = switch (f.experts.gate_up.bits) {
+            4 => .q4,
+            8 => .q8,
+            else => return error.BadHy4ExpertBits,
+        };
+        var out: Layer = .{
+            .own = undefined,
+            .merge = try dense.Merge.upload(&b, w.mlp_hc),
+            .input_norm = try b.upload(w.mlp_norm.bytes),
+            .output_norm = try b.upload(f.norm.bytes),
+            .router = .{ .buf = packed_router },
+            .correction = .{ .buf = try b.upload(f.correction.bytes) },
+            .down = try b.linear(f.down, use_tensors),
+            .up = try b.linear(f.up, use_tensors),
+            .expert_weights = if (use_tensors)
+                .{ .tensor = try gpu_experts.Weights.upload(&b, f.experts.gate_up, f.experts.down) }
+            else
+                .{ .portable = .{ .up = try uploadExperts(&b, f.experts.gate_up), .down = try uploadExperts(&b, f.experts.down) } },
+            .shared_gate = try b.linear(f.shared.gate, use_tensors),
+            .shared_up = try b.linear(f.shared.up, use_tensors),
+            .shared_down = try b.linear(f.shared.down, use_tensors),
+            .precision = precision,
+            .size = .{
+                .width = t.routed_expert_hidden_size,
+                .inner = t.moe_intermediate_size,
+                .first = 0,
+                .experts = t.n_routed_experts,
+                .rows = 1,
+                .pairs = t.num_experts_per_tok,
+                .swiglu_limit = t.swiglu_limit,
+            },
+            .scale = t.routed_scaling_factor,
+        };
+        try out.size.check();
+        out.own = b;
+        return out;
+    }
+
+    pub fn deinit(self: *Layer) void {
+        self.own.clear();
+        self.* = undefined;
+    }
+};
+
+fn uploadExperts(b: *dense.Buffers, w: @import("core").quant.mlx.Host) !experts.Weights {
+    return .{
+        .words = .{ .buffer = try b.upload(w.words.bytes) },
+        .scales = .{ .buffer = try b.upload(w.scales.bytes) },
+        .biases = .{ .buffer = try b.upload(w.biases.bytes) },
+    };
+}
+
+fn raw(b: *dense.Buffers, elements: usize) !RouteRef {
+    return .{ .buf = try b.alloc(elements * @sizeOf(u32)) };
+}
+
+pub const Scratch = struct {
+    own: dense.Buffers,
+    rows: u32,
+    picks: u32,
+    logits: RouteRef,
+    select: RouteOutputs,
+    expert_rows: ?mtl.Buffer,
+    tensors: ?gpu_experts.Scratch,
+    latent: Ref,
+    weighted: Ref,
+    pair_activations: Ref,
+    pair_outputs: mtl.Buffer,
+    routed: Ref,
+    shared: Ref,
+    /// A prompt chunk's expert ids, the identity (job e = expert e).
+    group_ids: RouteRef,
+
+    pub fn init(a: std.mem.Allocator, d: mtl.Device, t: config.Text, rows: u32) !Scratch {
+        return initForModel(a, d, t, rows, false);
+    }
+
+    pub fn initForModel(a: std.mem.Allocator, d: mtl.Device, t: config.Text, rows: u32, use_tensors: bool) !Scratch {
+        if (rows == 0 or rows > prompt_rows or (rows > max_rows and !use_tensors)) return error.BadHy4RouteRows;
+        var b: dense.Buffers = .{ .a = a, .d = d };
+        errdefer b.clear();
+        const slots = t.num_experts_per_tok;
+        const total = rows * slots;
+        const e = t.n_routed_experts;
+        const width = t.routed_expert_hidden_size;
+        const si = if (use_tensors) null else (try raw(&b, total)).buf;
+        if (si) |ids| for (ids.slice(i32, total), 0..) |*dst, i| {
+            dst.* = @intCast(i / slots);
+        };
+        var out: Scratch = .{
+            .own = undefined,
+            .rows = rows,
+            .picks = slots,
+            .logits = try raw(&b, rows * e),
+            .select = .{
+                .pick = try raw(&b, total),
+                .wts = try raw(&b, total),
+                .ids = try raw(&b, e),
+                .members = try raw(&b, e * max_rows),
+                .count = try raw(&b, 1),
+                .mine = try raw(&b, total),
+                .theirs = try raw(&b, total),
+                .counts = try raw(&b, 2),
+                .word = try raw(&b, 1),
+            },
+            .expert_rows = si,
+            .tensors = if (use_tensors) try gpu_experts.Scratch.init(&b, rows, slots, width, t.moe_intermediate_size) else null,
+            .latent = try b.rows(rows, width),
+            .weighted = try b.rows(rows, width),
+            .pair_activations = try b.rows(total, t.moe_intermediate_size),
+            .pair_outputs = (try raw(&b, @as(usize, total) * width)).buf,
+            .routed = try b.rows(rows, t.hidden_size),
+            .shared = try b.rows(rows, t.hidden_size),
+            .group_ids = try raw(&b, e),
+        };
+        out.own = b;
+        return out;
+    }
+
+    pub fn deinit(self: *Scratch) void {
+        self.own.clear();
+        self.* = undefined;
+    }
+};
+
+pub const Kernels = struct {
+    shape: route.Shape,
+    logits: mtl.Pipeline,
+    select: mtl.Pipeline,
+    /// A prompt chunk's picks and weights, a threadgroup a row (the core select's per-row arithmetic).
+    select_rows: mtl.Pipeline,
+    /// The same picks and weights by ranks, a thread an expert (TF_HY4_SELECT_LOOP keeps the arg-max rounds).
+    select_rank: mtl.Pipeline,
+    experts: ?experts.Kernels,
+    tensors: ?gpu_experts.Kernels,
+    sum: mtl.Pipeline,
+    add: mtl.Pipeline,
+
+    pub fn load(a: std.mem.Allocator, device: mtl.Device, t: config.Text) !Kernels {
+        return loadImpl(a, device, t, null);
+    }
+
+    pub fn loadForModel(a: std.mem.Allocator, device: mtl.Device, t: config.Text, bits: u8) !Kernels {
+        return loadImpl(a, device, t, if (device.tensorUnits()) bits else null);
+    }
+
+    fn loadImpl(a: std.mem.Allocator, device: mtl.Device, t: config.Text, tensor_bits: ?u8) !Kernels {
+        const shape: route.Shape = .{ .hidden = t.hidden_size, .experts = t.n_routed_experts, .topk = t.num_experts_per_tok, .max_rows = max_rows };
+        const core_src = try route.source(a, shape);
+        defer a.free(core_src);
+        const src = try std.mem.concat(a, u8, &.{ core_src, sources.hy4_flash_route_rows });
+        defer a.free(src);
+        const routes = try mtl.Library.fromSource(device, src, mtl.CompileOptions.mlx());
+        defer routes.deinit();
+        const sums = try mtl.Library.fromSource(device, sources.hy4_flash_affine_experts, mtl.CompileOptions.mlx());
+        defer sums.deinit();
+        const adds = try mtl.Library.fromSource(device, sources.elementwise, mtl.CompileOptions.mlx());
+        defer adds.deinit();
+        var logits = try mtl.Pipeline.init(device, routes, route.names[0], false);
+        errdefer logits.deinit();
+        var select = try mtl.Pipeline.init(device, routes, route.names[1], false);
+        errdefer select.deinit();
+        var select_rows = try mtl.Pipeline.init(device, routes, "tf_hy4_route_select_rows", false);
+        errdefer select_rows.deinit();
+        var select_rank = try mtl.Pipeline.init(device, routes, "tf_hy4_route_select_rank", false);
+        errdefer select_rank.deinit();
+        var expert = if (tensor_bits == null) try experts.Kernels.load(device) else null;
+        errdefer if (expert) |*op| op.deinit();
+        const tensors = if (tensor_bits) |bits| try gpu_experts.Kernels.load(a, device, bits) else null;
+        errdefer if (tensors) |op| op.deinit();
+        var sum = try mtl.Pipeline.init(device, sums, "tf_hy4_routed_sum", false);
+        errdefer sum.deinit();
+        return .{
+            .shape = shape,
+            .logits = logits,
+            .select = select,
+            .select_rows = select_rows,
+            .select_rank = select_rank,
+            .experts = expert,
+            .tensors = tensors,
+            .sum = sum,
+            .add = try mtl.Pipeline.init(device, adds, "tf_add_bf16", false),
+        };
+    }
+
+    pub fn deinit(self: *Kernels) void {
+        self.logits.deinit();
+        self.select.deinit();
+        self.select_rows.deinit();
+        self.select_rank.deinit();
+        if (self.experts) |*op| op.deinit();
+        if (self.tensors) |op| op.deinit();
+        self.sum.deinit();
+        self.add.deinit();
+    }
+
+    pub fn forward(self: *const Kernels, shared: *const dense.Kernels, e: mtl.ComputeEncoder, w: *const Layer, d: *const dense.Scratch, s: *const Scratch, x: Ref, out: Ref) !void {
+        return self.forwardSeam(shared, e, w, d, s, x, out, .{});
+    }
+
+    pub fn forwardSeam(self: *const Kernels, shared: *const dense.Kernels, e: mtl.ComputeEncoder, w: *const Layer, d: *const dense.Scratch, s: *const Scratch, x: Ref, out: Ref, seam: dense.Kernels.Seam) !void {
+        const rows = d.shape.rows;
+        const inner: u32 = w.shared_gate.outputs();
+        if (rows > s.rows or s.picks != self.shape.topk or inner > d.inner_capacity) return error.ShortHy4Scratch;
+        const merge = try shared.collapseSeamFrom(e, x, w.merge, w.input_norm, d, seam);
+        try shared.linearsFrom(e, d.normalized, &.{
+            .{ .w = w.down, .y = s.latent },
+            .{ .w = w.shared_gate, .y = d.gate },
+            .{ .w = w.shared_up, .y = d.up },
+        }, rows);
+        route.logits(e, self.logits, self.shape, dense.Kernels.dref(d.normalized), w.router, s.logits, rows);
+        e.barrier();
+        if (rows <= max_rows) {
+            route.select(e, self.select, s.logits, w.correction, w.scale, rows, .{ 0, w.size.experts }, s.select);
+        } else {
+            // every row's picks and weights at once; the expert grouping comes from the picks
+            const rank = w.size.experts <= 512;
+            e.setPipeline(if (rank) self.select_rank else self.select_rows);
+            e.setBuffer(s.logits.buf, s.logits.off, 0);
+            e.setBuffer(w.correction.buf, w.correction.off, 1);
+            e.setValue(route.Args{ .rows = @intCast(rows), .lo = 0, .hi = @intCast(w.size.experts), .scale = w.scale }, 2);
+            e.setBuffer(s.select.pick.buf, s.select.pick.off, 3);
+            e.setBuffer(s.select.wts.buf, s.select.wts.off, 4);
+            e.dispatchGroups(mtl.Size.of(rows, 1, 1), mtl.Size.of(if (rank) 512 else 32, 1, 1));
+        }
+        try shared.dense.swiglu(e, dense.Kernels.dref(d.gate), dense.Kernels.dref(d.up), dense.Kernels.dref(d.inner), .{
+            .rows = rows,
+            .width = inner,
+            .gate_stride = inner,
+            .up_stride = inner,
+            .y_stride = inner,
+        });
+        e.barrier();
+        var shape = w.size;
+        shape.rows = rows;
+        shape.pairs = rows * s.picks;
+        switch (w.expert_weights) {
+            .portable => |mat| {
+                const ops = self.experts orelse return error.Hy4ExpertKernelsMissing;
+                const ids: experts.Ref = .{ .buffer = s.select.pick.buf };
+                try ops.run(e, w.precision, .up, .{
+                    .input = .{ .buffer = s.latent.buffer },
+                    .ids = ids,
+                    .src_rows = .{ .buffer = s.expert_rows orelse return error.ShortHy4Scratch },
+                    .weights = mat.up,
+                    .output = .{ .buffer = s.pair_activations.buffer },
+                }, shape);
+                try shared.linear(e, w.shared_down, d.inner, s.shared, rows);
+                e.barrier();
+                try ops.run(e, w.precision, .down, .{
+                    .input = .{ .buffer = s.pair_activations.buffer },
+                    .ids = ids,
+                    .weights = mat.down,
+                    .output = .{ .buffer = s.pair_outputs },
+                }, shape);
+            },
+            .tensor => |mat| {
+                const ops = self.tensors orelse return error.Hy4ExpertKernelsMissing;
+                const tensor_scratch = s.tensors orelse return error.ShortHy4Scratch;
+                const latent: lane.Ref = .{ .buf = s.latent.buffer, .off = s.latent.offset };
+                const prompt = rows > max_rows;
+                const jobs = if (prompt)
+                    ops.group(e, tensor_scratch, tensorRef(s.select.pick), tensorRef(s.group_ids), latent, rows, shape.pairs, shape.experts, shape.width)
+                else
+                    ops.prepare(e, tensor_scratch, .{
+                        .pick = tensorRef(s.select.pick),
+                        .ids = tensorRef(s.select.ids),
+                        .members = tensorRef(s.select.members),
+                        .count = tensorRef(s.select.count),
+                    }, latent, rows, shape.pairs, max_rows, shape.width);
+                try shared.linear(e, w.shared_down, d.inner, s.shared, rows);
+                e.barrier();
+                ops.applyJobs(e, mat, tensor_scratch, jobs, latent, .{ .buf = s.pair_activations.buffer, .off = s.pair_activations.offset }, .{ .buf = s.pair_outputs }, shape.pairs, if (prompt) shape.experts else shape.pairs, s.picks, shape.swiglu_limit);
+            },
+        }
+        e.barrier();
+        e.setPipeline(self.sum);
+        e.setBuffer(s.pair_outputs, 0, 0);
+        e.setBuffer(s.select.wts.buf, 0, 1);
+        e.setBuffer(s.weighted.buffer, 0, 2);
+        e.setValue([2]u32{ shape.width, s.picks }, 3);
+        e.dispatchThreads(mtl.Size.of(shape.width, rows, 1), mtl.Size.of(128, 1, 1));
+        e.barrier();
+        try shared.linear(e, w.up, s.weighted, s.routed, rows);
+        e.barrier();
+        try shared.tailTo(e, s.routed, s.shared, w.output_norm, merge.eps, x, out, d, merge, seam);
+    }
+};
+
+fn tensorRef(ref: RouteRef) lane.Ref {
+    return .{ .buf = ref.buf, .off = ref.off };
+}
diff --git a/zig/src/families/hy4_flash/metal_scratch.zig b/zig/src/families/hy4_flash/metal_scratch.zig
new file mode 100644
index 0000000000000000000000000000000000000000..350c784f5477d1c6214ac44d60006180f0a42d71
--- /dev/null
+++ b/zig/src/families/hy4_flash/metal_scratch.zig
@@ -0,0 +1,109 @@
+//! A Hy4-flash pass's per-row scratch, sized once at the widest layer.
+const std = @import("std");
+const mtl = @import("metal");
+const affine = @import("../../core/row_projection.zig");
+const cfg = @import("config.zig");
+const ihc = @import("ihc.zig");
+const ihc_gpu = @import("ihc_metal.zig");
+const mla_gpu = @import("mla_metal.zig");
+const mha = @import("mla_attention.zig");
+const shape_ = @import("mla_weights.zig");
+const gpu_qkv = @import("metal_tensor_qkv.zig");
+const lane = @import("../../core/lane_projection.zig");
+const dense = @import("metal_dense.zig");
+const Buffers = dense.Buffers;
+const Ref = dense.Ref;
+const Attention = dense.Attention;
+const withAllocation = dense.withAllocation;
+
+pub const Scratch = struct {
+    own: Buffers,
+    capacity: mha.Shape,
+    shape: mha.Shape,
+    inner_capacity: u32,
+    merged: Ref,
+    ihc_partials: Ref,
+    /// A count and a generation a row for the fused seams' in-kernel barrier (zeroed; each launch leaves count 0).
+    seam_barriers: Ref,
+    qkv: ?Ref = null,
+    post: Ref,
+    normalized: Ref,
+    query_a: Ref,
+    query_norm: Ref,
+    query: Ref,
+    kv: Ref,
+    value_logits: Ref,
+    values: Ref,
+    absorbed: Ref,
+    rotary: Ref,
+    latent: Ref,
+    attention: Ref,
+    key_scores: Ref,
+    flash_parts: ?Ref = null,
+    branch: Ref,
+    gate: Ref,
+    up: Ref,
+    inner: Ref,
+
+    pub fn init(a: std.mem.Allocator, device: mtl.Device, layer: *const Attention, inner: u32, keys: u32, rows: u32) !Scratch {
+        return initForModel(a, device, layer, inner, keys, rows, false);
+    }
+
+    pub fn initForModel(a: std.mem.Allocator, device: mtl.Device, layer: *const Attention, inner: u32, keys: u32, rows: u32, use_tensors: bool) !Scratch {
+        var b: Buffers = .{ .a = a, .d = device };
+        errdefer b.clear();
+        const r = rows;
+        const h = layer.hidden;
+        const heads = layer.heads;
+        const shape = try mha.Shape.init(r, heads, keys);
+        const out: Scratch = .{
+            .own = undefined,
+            .capacity = shape,
+            .shape = shape,
+            .inner_capacity = inner,
+            .merged = try b.rows(r, h),
+            .ihc_partials = .{ .buffer = try b.alloc(@as(usize, r) * ihc_gpu.partial_floats * @sizeOf(f32)) },
+            .seam_barriers = blk: {
+                const bars = try b.alloc(ihc_gpu.Kernels.seam_rows * 8);
+                @memset(bars.slice(u8, ihc_gpu.Kernels.seam_rows * 8), 0);
+                break :blk .{ .buffer = bars };
+            },
+            .qkv = if (use_tensors) try b.rows(r, layer.query_rank + shape_.absorbed_stride + heads * shape_.value_width) else null,
+            .post = .{ .buffer = try b.alloc(@as(usize, r) * ihc.streams * @sizeOf(f32)) },
+            .normalized = try b.rows(r, h),
+            .query_a = try b.rows(r, layer.query_rank),
+            .query_norm = try b.rows(r, layer.query_rank),
+            .query = try b.rows(r, heads * shape_.query_stride),
+            .kv = try b.rows(r, shape_.absorbed_stride),
+            .value_logits = try b.rows(r, heads * shape_.value_width),
+            .values = try b.rows(r, heads * shape_.value_width),
+            .absorbed = try b.rows(r, heads * shape_.absorbed_stride),
+            .rotary = try b.rows(r, shape_.rope),
+            .latent = try b.rows(r, heads * shape_.latent),
+            .attention = .{ .buffer = try b.alloc(shape.scratchBytes()) },
+            .key_scores = .{ .buffer = try b.alloc(@as(usize, r) * heads * keys * @sizeOf(f32)) },
+            .flash_parts = if (use_tensors) blk: {
+                const parts = try b.alloc(mla_gpu.Nax.partBytes(heads));
+                @memset(parts.slice(u8, mla_gpu.Nax.partBytes(heads)), 0);
+                break :blk .{ .buffer = parts };
+            } else null,
+            .branch = try b.rows(r, h),
+            .gate = try b.rows(r, inner),
+            .up = try b.rows(r, inner),
+            .inner = try b.rows(r, inner),
+        };
+        return withAllocation(out, b);
+    }
+
+    /// Keep one allocation at the widest layer and bind the current lane batch and head count before encoding.
+    pub fn bind(self: *Scratch, rows: u32, heads: u32, keys: u32) !void {
+        if (rows > self.capacity.rows or heads > self.capacity.heads or keys > self.capacity.key_stride)
+            return error.ShortHy4Scratch;
+        self.shape = try mha.Shape.init(rows, heads, keys);
+    }
+
+    pub fn deinit(self: *Scratch) void {
+        self.own.clear();
+        self.* = undefined;
+    }
+};
diff --git a/zig/src/families/hy4_flash/metal_tensor_experts.zig b/zig/src/families/hy4_flash/metal_tensor_experts.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ba8a697f4d62fbe3d6d16186744213a8dd86d305
--- /dev/null
+++ b/zig/src/families/hy4_flash/metal_tensor_experts.zig
@@ -0,0 +1,142 @@
+//! TensorOps for Hy4-flash's active experts, retaining FFN gate and up codes byte-for-byte.
+const std = @import("std");
+const mtl = @import("metal");
+const core = @import("core");
+const lane = @import("../../core/lane_projection.zig");
+const tensor = lane.affine_mm;
+const source = @import("kernel_sources").hy4_flash_tensor_dispatch;
+
+const Ref = lane.Ref;
+const Matrix = struct { w: Ref, s: Ref, b: Ref, n: u32, k: u32 };
+
+pub const Weights = struct {
+    gate: Matrix,
+    up: Matrix,
+    down: Matrix,
+    pub fn upload(owner: anytype, up: core.quant.mlx.Host, down: core.quant.mlx.Host) !Weights {
+        if (up.group != 64 or down.group != 64 or up.bits != down.bits) return error.BadHy4ExpertLayout;
+        return .{
+            .gate = try read(owner, up, 0),
+            .up = try read(owner, up, 1),
+            .down = try read(owner, down, null),
+        };
+    }
+};
+
+fn read(owner: anytype, w: core.quant.mlx.Host, part: ?usize) !Matrix {
+    const count = w.words.shape[0];
+    const n: u32 = @intCast(w.words.shape[1] / @as(usize, if (part == null) 1 else 2));
+    const k: u32 = @intCast(w.scales.shape[2] * w.group);
+    const tensors = [_][]const u8{ w.words.bytes, w.scales.bytes, w.biases.bytes };
+    var packed_: [3]Ref = undefined;
+    for (tensors, &packed_) |bytes, *dst| {
+        if (part) |side| {
+            if (count == 0 or bytes.len % (count * 2) != 0) return error.BadHy4ExpertLayout;
+            const half = bytes.len / count / 2;
+            const buf = try owner.alloc(half * count);
+            const contents = buf.slice(u8, half * count);
+            for (0..count) |i| @memcpy(contents[i * half ..][0..half], bytes[(i * 2 + side) * half ..][0..half]);
+            dst.* = .{ .buf = buf };
+        } else dst.* = .{ .buf = try owner.upload(bytes) };
+    }
+    return .{ .w = packed_[0], .s = packed_[1], .b = packed_[2], .n = n, .k = k };
+}
+
+pub const Scratch = struct {
+    order: Ref,
+    offsets: Ref,
+    identity: Ref,
+    latent_sums: Ref,
+    act_sums: Ref,
+
+    pub fn init(owner: anytype, rows: usize, picks: usize, width: usize, inner: usize) !Scratch {
+        const slots = rows * picks;
+        if (slots > 8192) return error.BadHy4TensorRows;
+        const identity = try owner.alloc((picks + 1) * @sizeOf(i32));
+        for (identity.slice(i32, picks + 1), 0..) |*v, i| v.* = @intCast(i);
+        return .{
+            .order = .{ .buf = try owner.alloc(slots * @sizeOf(i32)) },
+            .offsets = .{ .buf = try owner.alloc(@max(slots, 1024) * @sizeOf(i32)) },
+            .identity = .{ .buf = identity },
+            .latent_sums = .{ .buf = try owner.alloc(rows * (width / 64) * @sizeOf(f32)) },
+            .act_sums = .{ .buf = try owner.alloc(slots * (inner / 64) * @sizeOf(f32)) },
+        };
+    }
+};
+
+pub const Route = struct { pick: Ref, ids: Ref, members: Ref, count: Ref };
+pub const Jobs = struct { offsets: Ref, order: Ref, ids: Ref };
+
+pub const Kernels = struct {
+    pipes: tensor.Pipes,
+    compact: mtl.Pipeline,
+    grouping: mtl.Pipeline,
+
+    pub fn load(a: std.mem.Allocator, d: mtl.Device, bits: u8) !Kernels {
+        const text = try tensor.source(d, a, .{ .bits = bits, .group = 64, .out_f32 = true, .glu = .clipped_silu, .mapped_experts = true });
+        defer a.free(text);
+        const lib = try mtl.Library.fromSource(d, text, mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        var pipes: tensor.Pipes = undefined;
+        var n: usize = 0;
+        errdefer for (pipes[0..n]) |p| p.deinit();
+        for (&pipes, tensor.names) |*dst, name| {
+            dst.* = try mtl.Pipeline.init(d, lib, name, false);
+            n += 1;
+        }
+        const lib_compact = try mtl.Library.fromSource(d, source, mtl.CompileOptions.mlx());
+        defer lib_compact.deinit();
+        var compact = try mtl.Pipeline.init(d, lib_compact, "tf_hy4_active_experts", false);
+        errdefer compact.deinit();
+        return .{
+            .pipes = pipes,
+            .compact = compact,
+            .grouping = try mtl.Pipeline.init(d, lib_compact, "tf_hy4_group_pairs", false),
+        };
+    }
+
+    pub fn deinit(self: Kernels) void {
+        for (self.pipes) |p| p.deinit();
+        self.compact.deinit();
+        self.grouping.deinit();
+    }
+
+    /// For one row each expert is unique, so the pick list itself is the active-to-global map.
+    pub fn prepare(self: Kernels, e: mtl.ComputeEncoder, s: Scratch, route: Route, x: Ref, rows: u32, pairs: u32, max_rows: u32, width: u32) Jobs {
+        if (rows > 1) {
+            e.setPipeline(self.compact);
+            for ([_]Ref{ route.members, route.count, s.offsets, s.order }, 0..) |ref, i| e.setBuffer(ref.buf, ref.off, i);
+            e.setValue([2]u32{ pairs, max_rows }, 4);
+            e.dispatchGroups(mtl.Size.of(1, 1, 1), mtl.Size.of(256, 1, 1));
+        }
+        tensor.rowSums(e, self.pipes, 64, x, s.latent_sums, rows, width);
+        return if (rows == 1)
+            .{ .offsets = s.identity, .order = s.identity, .ids = route.pick }
+        else
+            .{ .offsets = s.offsets, .order = s.order, .ids = route.ids };
+    }
+
+    pub fn apply(self: Kernels, e: mtl.ComputeEncoder, w: Weights, s: Scratch, jobs: Jobs, x: Ref, act: Ref, out: Ref, pairs: u32, picks: u32, limit: f32) void {
+        self.applyJobs(e, w, s, jobs, x, act, out, pairs, pairs, picks, limit);
+    }
+
+    /// `apply` over `count` expert jobs (a window's pick list, or every expert for a prompt chunk's grouping).
+    pub fn applyJobs(self: Kernels, e: mtl.ComputeEncoder, w: Weights, s: Scratch, jobs: Jobs, x: Ref, act: Ref, out: Ref, pairs: u32, count: u32, picks: u32, limit: f32) void {
+        tensor.gatherGluMapped(e, self.pipes, x, s.latent_sums, w.gate, w.up, jobs.offsets, jobs.order, act, jobs.ids, pairs, count, picks, limit);
+        e.barrier();
+        tensor.rowSums(e, self.pipes, 64, act, s.act_sums, pairs, w.down.k);
+        e.barrier();
+        tensor.gatherToMapped(e, self.pipes, act, s.act_sums, w.down, jobs.offsets, out, jobs.order, jobs.ids, pairs, count);
+    }
+
+    /// A prompt chunk's grouping (more rows than one router window)
+    pub fn group(self: Kernels, e: mtl.ComputeEncoder, s: Scratch, pick: Ref, ids: Ref, x: Ref, rows: u32, pairs: u32, experts: u32, width: u32) Jobs {
+        e.setPipeline(self.grouping);
+        for ([_]Ref{ pick, s.offsets, s.order, ids }, 0..) |ref, i| e.setBuffer(ref.buf, ref.off, i);
+        // Metal's uint3 has the same 16-byte ABI as uint4.
+        e.setValue([4]u32{ pairs, experts, pairs / rows, 0 }, 4);
+        e.dispatchGroups(mtl.Size.of(1, 1, 1), mtl.Size.of(1024, 1, 1));
+        tensor.rowSums(e, self.pipes, 64, x, s.latent_sums, rows, width);
+        return .{ .offsets = s.offsets, .order = s.order, .ids = ids };
+    }
+};
diff --git a/zig/src/families/hy4_flash/metal_tensor_qkv.zig b/zig/src/families/hy4_flash/metal_tensor_qkv.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d85a33fb6ec0b7cb904150f24305f1530b1f610d
--- /dev/null
+++ b/zig/src/families/hy4_flash/metal_tensor_qkv.zig
@@ -0,0 +1,155 @@
+//! Hy4-flash Q/KV projections and gate on Apple GPU tensor units.
+const std = @import("std");
+const mtl = @import("metal");
+const core = @import("core");
+const lane = @import("../../core/lane_projection.zig");
+const source = @import("kernel_sources").hy4_flash_tensor_dispatch;
+const config = @import("config.zig");
+const mla = @import("mla_weights.zig");
+
+pub const Packed = struct {
+    w: lane.Ref,
+    sb: lane.Ref,
+
+    pub fn upload(owner: anytype, inputs: []const core.quant.mlx.Host, l: lane.Layout) !Packed {
+        const words = try owner.a.alloc(u32, l.sourceWords());
+        defer owner.a.free(words);
+        const scales = try owner.a.alloc(u16, l.metadataElements() / 2);
+        defer owner.a.free(scales);
+        const bias = try owner.a.alloc(u16, scales.len);
+        defer owner.a.free(bias);
+        var wi: usize = 0;
+        var si: usize = 0;
+        for (inputs) |input| {
+            if (input.bits != l.format.bits or input.group != l.format.group or input.scales.shape[1] * input.group != l.k or
+                input.words.bytes.len % @sizeOf(u32) != 0 or input.scales.bytes.len % @sizeOf(u16) != 0)
+                return error.BadQkvInput;
+            const nw = input.words.bytes.len / 4;
+            const nt = input.scales.bytes.len / 2;
+            if (nw > words.len - wi or nt > scales.len - si or input.biases.bytes.len != input.scales.bytes.len)
+                return error.BadQkvInput;
+            @memcpy(std.mem.sliceAsBytes(words[wi..][0..nw]), input.words.bytes);
+            @memcpy(std.mem.sliceAsBytes(scales[si..][0..nt]), input.scales.bytes);
+            @memcpy(std.mem.sliceAsBytes(bias[si..][0..nt]), input.biases.bytes);
+            wi += nw;
+            si += nt;
+        }
+        if (wi != words.len or si != scales.len) return error.BadQkvInput;
+        const w = try owner.alloc(l.weightWords() * 4);
+        const sb = try owner.alloc(l.metadataElements() * 2);
+        try lane.pack(l, words, scales, bias, w.slice(u32, l.weightWords()), sb.slice(u16, l.metadataElements()));
+        if (l.reg and l.format.bits == 8) try lane.regOrder8(w.slice(u32, l.weightWords()), l.n, l.k) else if (l.reg) try lane.regOrder(owner.d, &.{.{ .w = .{ .buf = w }, .n = l.n, .k = l.k }});
+        return .{ .w = .{ .buf = w }, .sb = .{ .buf = sb } };
+    }
+};
+
+/// Rows one prompt chunk may hold (the routed layer's prompt_rows).
+pub const prompt_rows = 512;
+
+fn layout(bits: u8, n: usize, k: usize, sk: usize) lane.Layout {
+    return .{
+        .n = n,
+        .k = k,
+        .sk = sk,
+        .format = .{ .bits = bits, .group = 64 },
+        .reg = true,
+        .precompute_sums = true,
+        // a whole prompt chunk in one encode on the reg path (independent 16-row blocks, so the same bits)
+        .rows = prompt_rows,
+        .row_blocks = false,
+    };
+}
+
+/// Any other dense projection [n, k] on tensor units
+pub fn denseLayout(bits: u8, n: usize, k: usize) lane.Layout {
+    return layout(bits, n, k, if (k < 2048) 2 else if (k <= 4096) 4 else 8);
+}
+
+pub fn inputLayout(t: config.Text, bits: u8, heads: u32) lane.Layout {
+    return layout(bits, t.q_lora_rank + mla.absorbed_stride + heads * mla.value_width, t.hidden_size, 4);
+}
+
+pub fn queryLayout(t: config.Text, bits: u8, heads: u32) lane.Layout {
+    return layout(bits, heads * mla.query_stride, t.q_lora_rank, 2);
+}
+
+pub fn flavor(t: config.Text, heads: u32) usize {
+    return if (heads == t.swa_num_attention_heads) 1 else 0;
+}
+
+/// Passes of at most this many rows take the reg kernels that add their own group sums
+pub const inline_rows = 8;
+
+/// `l` with the kernel adding its split's group sums up front (4-bit reg and 8-bit layouts; null otherwise).
+pub fn withInlineSums(l: lane.Layout) ?lane.Layout {
+    if (!l.reg and l.format.bits != 8) return null;
+    var out = l;
+    out.inline_sums = true;
+    return out;
+}
+
+pub const Kernels = struct {
+    inputs: [2]lane.Projection,
+    queries: [2]lane.Projection,
+    /// The same projections adding their own group sums (4-bit reg layouts), for passes of inline_rows at most.
+    inline_inputs: [2]?lane.Projection = .{ null, null },
+    inline_queries: [2]?lane.Projection = .{ null, null },
+    unpack: mtl.Pipeline,
+
+    pub fn load(a: std.mem.Allocator, d: mtl.Device, t: config.Text, bits: u8) !Kernels {
+        const lib = try mtl.Library.fromSource(d, source, mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        var unpack = try mtl.Pipeline.init(d, lib, "tf_hy4_qkv_split", false);
+        errdefer unpack.deinit();
+        var out: Kernels = .{ .inputs = undefined, .queries = undefined, .unpack = unpack };
+        var made: usize = 0;
+        errdefer {
+            for (0..made) |i| {
+                out.inputs[i].deinit();
+                out.queries[i].deinit();
+            }
+        }
+        for ([_]u32{ t.num_attention_heads, t.swa_num_attention_heads }, 0..) |heads, i| {
+            var input = try lane.Projection.init(a, d, inputLayout(t, bits, heads));
+            errdefer input.deinit();
+            out.queries[i] = try lane.Projection.init(a, d, queryLayout(t, bits, heads));
+            out.inputs[i] = input;
+            made += 1;
+        }
+        for ([_]u32{ t.num_attention_heads, t.swa_num_attention_heads }, 0..) |heads, i| {
+            if (withInlineSums(inputLayout(t, bits, heads))) |l| out.inline_inputs[i] = try lane.Projection.init(a, d, l);
+            if (withInlineSums(queryLayout(t, bits, heads))) |l| out.inline_queries[i] = try lane.Projection.init(a, d, l);
+        }
+        return out;
+    }
+
+    pub fn deinit(self: Kernels) void {
+        for (self.inputs, self.queries) |a, b| {
+            a.deinit();
+            b.deinit();
+        }
+        for (self.inline_inputs, self.inline_queries) |a, b| {
+            if (a) |x| x.deinit();
+            if (b) |x| x.deinit();
+        }
+        self.unpack.deinit();
+    }
+
+    pub fn inputFor(self: *const Kernels, which: usize, rows: u32) *const lane.Projection {
+        if (rows <= inline_rows) if (self.inline_inputs[which]) |*p| return p;
+        return &self.inputs[which];
+    }
+
+    pub fn queryFor(self: *const Kernels, which: usize, rows: u32) *const lane.Projection {
+        if (rows <= inline_rows) if (self.inline_queries[which]) |*p| return p;
+        return &self.queries[which];
+    }
+
+    pub fn split(self: Kernels, e: mtl.ComputeEncoder, input: lane.Ref, q: lane.Ref, kv: lane.Ref, gates: lane.Ref, rows: u32, q_rank: u32, gate_cols: u32) void {
+        e.setPipeline(self.unpack);
+        for ([_]lane.Ref{ input, q, kv, gates }, 0..) |r, i| e.setBuffer(r.buf, r.off, i);
+        // Metal's uint3 has the same 16-byte ABI as uint4.
+        e.setValue([4]u32{ q_rank, mla.absorbed_stride, gate_cols, 0 }, 4);
+        e.dispatchThreads(mtl.Size.of(q_rank + mla.absorbed_stride + gate_cols, rows, 1), mtl.Size.of(128, 1, 1));
+    }
+};
diff --git a/zig/src/families/hy4_flash/mla_attention.zig b/zig/src/families/hy4_flash/mla_attention.zig
new file mode 100644
index 0000000000000000000000000000000000000000..0e4b1728c9b815eb9c58c041310f66c0a527a086
--- /dev/null
+++ b/zig/src/families/hy4_flash/mla_attention.zig
@@ -0,0 +1,57 @@
+//! The launch shape for absorbed attention over retained physical KV slots.
+const std = @import("std");
+const weights = @import("mla_weights.zig");
+
+pub const chunk_keys = 512;
+pub const score_scale: f32 = 0.0625; // 1 / sqrt(192 + 64), before absorbing the key projection.
+
+pub const CacheWrite = extern struct {
+    rows: u32,
+    capacity: u32,
+    epsilon: f32,
+
+    pub fn check(self: CacheWrite) !void {
+        if (self.rows == 0 or self.rows > std.math.maxInt(u16) or self.capacity == 0 or
+            self.capacity > std.math.maxInt(i32) or !std.math.isFinite(self.epsilon) or self.epsilon <= 0)
+            return error.BadHy4CacheWrite;
+    }
+};
+
+pub const Shape = extern struct {
+    rows: u32,
+    heads: u32,
+    key_stride: u32,
+    chunks: u32,
+
+    pub fn init(rows: u32, heads: u32, key_stride: u32) !Shape {
+        if (rows == 0 or heads == 0 or key_stride == 0) return error.EmptyHy4AttentionShape;
+        const chunks = (key_stride - 1) / chunk_keys + 1;
+        if (chunks > std.math.maxInt(u16) or rows > std.math.maxInt(u16) or heads > 64)
+            return error.UnsupportedHy4AttentionShape;
+        return .{ .rows = rows, .heads = heads, .key_stride = key_stride, .chunks = chunks };
+    }
+
+    pub fn partialHeads(self: Shape) usize {
+        return @as(usize, self.rows) * self.heads * self.chunks;
+    }
+
+    pub fn scratchBytes(self: Shape) usize {
+        return self.partialHeads() * (weights.latent + 2) * @sizeOf(f32);
+    }
+
+    pub fn check(self: Shape) !void {
+        const derived = try init(self.rows, self.heads, self.key_stride);
+        if (self.chunks != derived.chunks) return error.WrongHy4AttentionChunks;
+    }
+};
+
+test "dispatch geometry covers sliding and sparse tails" {
+    for ([_]u32{ 511, 512, 513, 2047, 2048, 2049 }, [_]u32{ 1, 1, 2, 4, 4, 5 }) |len, chunks| {
+        const shape = try Shape.init(8, 32, len);
+        try shape.check();
+        try std.testing.expectEqual(chunks, shape.chunks);
+        try std.testing.expectEqual(@as(usize, 8 * 32 * (512 + 2) * 4) * chunks, shape.scratchBytes());
+    }
+    try std.testing.expectError(error.EmptyHy4AttentionShape, Shape.init(1, 64, 0));
+    try std.testing.expectError(error.UnsupportedHy4AttentionShape, Shape.init(1, 65, 512));
+}
diff --git a/zig/src/families/hy4_flash/mla_cuda.zig b/zig/src/families/hy4_flash/mla_cuda.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f82fecf5ed9d95048c79c95f6fdb0c508e66e6e1
--- /dev/null
+++ b/zig/src/families/hy4_flash/mla_cuda.zig
@@ -0,0 +1,188 @@
+//! CUDA launches for Hy4-flash's absorbed MLA projections.
+const cuda = @import("cuda");
+const weights = @import("mla_weights.zig");
+const attention = @import("mla_attention.zig");
+const rotary = @import("rope.zig");
+
+pub const Projections = struct {
+    image: cuda.Module,
+    absorb_kernel: cuda.Function,
+    expand_kernel: cuda.Function,
+    table_kernel: cuda.Function,
+    rotate_kernel: cuda.Function,
+    cache_kernel: cuda.Function,
+    gate_kernel: cuda.Function,
+
+    pub fn load(driver: *const cuda.Driver) !Projections {
+        var image = try cuda.Module.load(driver, cuda.kernels.hy4_mla_project);
+        errdefer image.unload();
+        return .{
+            .image = image,
+            .absorb_kernel = try image.function("tf_hy4_absorb_q"),
+            .expand_kernel = try image.function("tf_hy4_expand_v"),
+            .table_kernel = try image.function("tf_hy4_rotary_table"),
+            .rotate_kernel = try image.function("tf_hy4_rotate"),
+            .cache_kernel = try image.function("tf_hy4_cache_keys"),
+            .gate_kernel = try image.function("tf_hy4_gate_values"),
+        };
+    }
+
+    pub fn deinit(self: *Projections) void {
+        self.image.unload();
+        self.* = undefined;
+    }
+
+    fn launch(kernel: cuda.Function, stream: cuda.Stream, input: u64, coefficients: u64, output: u64, rows: u32, heads: u32, column_tiles: u32) !void {
+        if (rows == 0 or heads == 0) return;
+        const rows_per_block = @min(rows, 64);
+        var args: cuda.Args = .{};
+        inline for (.{ input, coefficients, output, @as(i64, rows), @as(i64, heads), @as(i64, rows_per_block) }) |x| args.add(x);
+        try cuda.launch.launch(kernel, .{
+            .grid = .{ .x = heads, .y = column_tiles, .z = (rows - 1) / rows_per_block + 1 },
+            .block = .{ .x = 128 },
+        }, stream, &args);
+    }
+
+    pub fn absorb(self: Projections, stream: cuda.Stream, query: u64, wk: u64, output: u64, rows: u32, heads: u32) !void {
+        try launch(self.absorb_kernel, stream, query, wk, output, rows, heads, weights.latent / 32);
+    }
+
+    pub fn expand(self: Projections, stream: cuda.Stream, latent: u64, wv: u64, output: u64, rows: u32, heads: u32) !void {
+        try launch(self.expand_kernel, stream, latent, wv, output, rows, heads, weights.value_width / 16);
+    }
+
+    /// Positions [row][3] i32, table [row][32][cos,sin] BF16.
+    pub fn rotaryTable(self: Projections, s: cuda.Stream, positions: u64, table: u64, rows: u32, p: rotary.Parameters) !void {
+        if (rows == 0) return;
+        var args: cuda.Args = .{};
+        inline for (.{ positions, table, p }) |x| args.add(x);
+        try cuda.launch.launch(self.table_kernel, .{ .grid = .{ .x = rows }, .block = .{ .x = rotary.pairs } }, s, &args);
+    }
+
+    pub fn rotate(self: Projections, s: cuda.Stream, input: u64, table: u64, output: u64, shape: rotary.View) !void {
+        try shape.check();
+        var args: cuda.Args = .{};
+        inline for (.{ input, table, output, shape }) |x| args.add(x);
+        try cuda.launch.launch(self.rotate_kernel, .{
+            .grid = .{ .x = shape.rows, .y = shape.heads },
+            .block = .{ .x = rotary.pairs },
+        }, s, &args);
+    }
+
+    /// Normalize and rotate KV projection rows directly into the lane's assigned latent slots.
+    pub fn cacheKeys(self: Projections, s: cuda.Stream, input: u64, gain: u64, table: u64, slots: u64, cache: u64, shape: attention.CacheWrite) !void {
+        try shape.check();
+        var args: cuda.Args = .{};
+        inline for (.{ input, gain, table, slots, cache, shape }) |x| args.add(x);
+        try cuda.launch.launch(self.cache_kernel, .{ .grid = .{ .x = shape.rows }, .block = .{ .x = 128 } }, s, &args);
+    }
+
+    pub fn gate(self: Projections, s: cuda.Stream, values: u64, logits: u64, rows: u32, heads: u32) !void {
+        if (rows == 0) return;
+        if (rows > 65535 or heads == 0 or heads > 64) return error.BadHy4GateShape;
+        const columns = heads * weights.value_width;
+        var args: cuda.Args = .{};
+        inline for (.{ values, logits, columns }) |x| args.add(x);
+        try cuda.launch.launch(self.gate_kernel, .{ .grid = .{ .x = columns / 128, .y = rows }, .block = .{ .x = 128 } }, s, &args);
+    }
+};
+
+pub const Attention = struct {
+    image: cuda.Module,
+    chunks: cuda.Function,
+    merge: cuda.Function,
+
+    const head_tile = cuda.mla.heads_tile;
+    const shared_bytes = cuda.mla.chunksSmem(head_tile);
+
+    pub const Buffers = struct {
+        query: u64,
+        cache: u64,
+        slots: u64,
+        counts: u64,
+        sinks: u64,
+        scratch: u64,
+        scratch_bytes: usize,
+        output: u64,
+    };
+
+    pub fn load(driver: *const cuda.Driver) !Attention {
+        var image = try cuda.Module.load(driver, cuda.kernels.hy4_mla_attention);
+        errdefer image.unload();
+        const chunks = try image.function("tf_hy4_attend_chunks");
+        try chunks.allowDynamicShared(shared_bytes);
+        return .{ .image = image, .chunks = chunks, .merge = try image.function("tf_hy4_attend_merge") };
+    }
+
+    pub fn deinit(self: *Attention) void {
+        self.image.unload();
+        self.* = undefined;
+    }
+
+    /// Counts must fit key_stride and all active key slots must address the passed cache.
+    pub fn attend(self: Attention, s: cuda.Stream, b: Buffers, shape: attention.Shape) !void {
+        try shape.check();
+        if (b.scratch_bytes < shape.scratchBytes()) return error.ShortHy4AttentionScratch;
+        const partials = shape.partialHeads() * @sizeOf(f32);
+        const maxima = b.scratch + partials * weights.latent;
+        const mass = maxima + partials;
+        const rows: i64 = shape.rows;
+        const heads: i64 = shape.heads;
+        var args: cuda.Args = .{};
+        inline for (.{ b.query, b.cache, b.slots, b.counts, b.scratch, maxima, mass, rows, heads, @as(i64, shape.key_stride), attention.score_scale }) |x|
+            args.add(x);
+        try cuda.launch.launch(self.chunks, .{
+            .grid = .{ .x = shape.rows, .y = (shape.heads + head_tile - 1) / head_tile, .z = shape.chunks },
+            .block = .{ .x = 256 },
+            .shared = shared_bytes,
+        }, s, &args);
+        var merge: cuda.Args = .{};
+        inline for (.{ b.scratch, maxima, mass, b.sinks, b.output, rows, heads, @as(i32, @intCast(shape.chunks)) }) |x| merge.add(x);
+        try cuda.launch.launch(self.merge, .{
+            .grid = .{ .x = shape.rows, .y = shape.heads },
+            .block = .{ .x = 128 },
+        }, s, &merge);
+    }
+};
+
+pub const KvInput = struct {
+    projection: u64,
+    gain: u64,
+    write_slots: u64,
+    capacity: u32,
+    epsilon: f32,
+};
+
+pub const MlaPass = struct {
+    query: u64,
+    key_weights: u64,
+    value_weights: u64,
+    value_logits: u64,
+    positions: u64,
+    rotary_table: u64,
+    kv: ?KvInput = null,
+    attention: Attention.Buffers,
+    values: u64,
+};
+
+/// The affine projections feed this pass. The caller owns the KV leases and retained physical key list.
+pub fn forward(project: Projections, attend: Attention, s: cuda.Stream, b: MlaPass, shape: attention.Shape, p: rotary.Parameters) !void {
+    try shape.check();
+    if (b.kv) |kv| try (attention.CacheWrite{ .rows = shape.rows, .capacity = kv.capacity, .epsilon = kv.epsilon }).check();
+    try project.rotaryTable(s, b.positions, b.rotary_table, shape.rows, p);
+    try project.absorb(s, b.query, b.key_weights, b.attention.query, shape.rows, shape.heads);
+    try project.rotate(s, b.query + weights.nope * 2, b.rotary_table, b.attention.query + weights.latent * 2, .{
+        .rows = shape.rows,
+        .heads = shape.heads,
+        .input_stride = weights.query_stride,
+        .output_stride = weights.absorbed_stride,
+    });
+    if (b.kv) |kv| try project.cacheKeys(s, kv.projection, kv.gain, b.rotary_table, kv.write_slots, b.attention.cache, .{
+        .rows = shape.rows,
+        .capacity = kv.capacity,
+        .epsilon = kv.epsilon,
+    });
+    try attend.attend(s, b.attention, shape);
+    try project.expand(s, b.attention.output, b.value_weights, b.values, shape.rows, shape.heads);
+    try project.gate(s, b.values, b.value_logits, shape.rows, shape.heads);
+}
diff --git a/zig/src/families/hy4_flash/mla_metal.zig b/zig/src/families/hy4_flash/mla_metal.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9aafb9d05af8e626cef602ef3cb681d77a596879
--- /dev/null
+++ b/zig/src/families/hy4_flash/mla_metal.zig
@@ -0,0 +1,355 @@
+//! Metal launches for Hy4-flash's absorbed MLA projections.
+const std = @import("std");
+const mtl = @import("metal");
+const sources = @import("kernel_sources");
+const weights = @import("mla_weights.zig");
+const attention = @import("mla_attention.zig");
+const rotary = @import("rope.zig");
+
+pub const Ref = struct { buffer: mtl.Buffer, offset: usize = 0 };
+const Args = extern struct { rows: u32, heads: u32 };
+
+/// The BF16 absorb and expand-and-gate products on the tensor units, the same tiles at every row count.
+pub const Nax = struct {
+    absorb: mtl.Pipeline,
+    expand: mtl.Pipeline,
+    attend_split: mtl.Pipeline,
+    combine: mtl.Pipeline,
+    attend: mtl.Pipeline,
+
+    pub fn load(a: std.mem.Allocator, device: mtl.Device) !Nax {
+        const text = try @import("../../core/lane_projection.zig").frags.source(device, a, sources.hy4_flash_mla_nax);
+        defer a.free(text);
+        const lib = try mtl.Library.fromSource(device, text, mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        var absorb = try mtl.Pipeline.init(device, lib, "tf_hy4_absorb_nax", false);
+        errdefer absorb.deinit();
+        var expand = try mtl.Pipeline.init(device, lib, "tf_hy4_expand_gated_nax", false);
+        errdefer expand.deinit();
+        var attend_split = try mtl.Pipeline.init(device, lib, "tf_hy4_attend_nax_split", false);
+        errdefer attend_split.deinit();
+        var combine = try mtl.Pipeline.init(device, lib, "tf_hy4_attend_combine", false);
+        errdefer combine.deinit();
+        return .{ .absorb = absorb, .expand = expand, .attend_split = attend_split, .combine = combine, .attend = try mtl.Pipeline.init(device, lib, "tf_hy4_attend_nax", false) };
+    }
+
+    pub fn deinit(self: Nax) void {
+        self.absorb.deinit();
+        self.expand.deinit();
+        self.attend_split.deinit();
+        self.combine.deinit();
+        self.attend.deinit();
+    }
+
+    /// Flash attention over contiguous key ranges: out [rows][heads][512] from the absorbed queries and the cache.
+    fn splits(shape: attention.Shape, has_parts: bool, live_keys: u32) u32 {
+        _ = .{ shape, has_parts, live_keys };
+        return 1; // row-invariant bits: a split count from the pass's widest row would change other rows' sums
+    }
+
+    fn flash(self: Nax, e: mtl.ComputeEncoder, b: Attention.Buffers, ranges: KeyRanges, shape: attention.Shape) void {
+        const n = splits(shape, b.flash_parts != null, b.live_keys);
+        e.setPipeline(if (n > 1) self.attend_split else self.attend);
+        for ([_]Ref{ b.query, b.cache, ranges.ranges, ranges.tiles, b.sinks, b.output }, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+        const args = extern struct { rows: u32, heads: u32, scale: f32, pad: u32 }{ .rows = shape.rows, .heads = shape.heads, .scale = attention.score_scale, .pad = n };
+        e.setValue(args, 6);
+        if (n == 1) return e.dispatchGroups(mtl.Size.of(shape.heads, (shape.rows + 15) / 16, 1), mtl.Size.of(128, 1, 1));
+        const parts = b.flash_parts.?;
+        const ml: Ref = .{ .buffer = parts.buffer, .offset = parts.offset + @as(usize, max_splits) * 16 * shape.heads * weights.latent * 4 };
+        e.setBuffer(parts.buffer, parts.offset, 7);
+        e.setBuffer(ml.buffer, ml.offset, 8);
+        e.dispatchGroups(mtl.Size.of(shape.heads, 1, n), mtl.Size.of(128, 1, 1));
+        e.barrier();
+        e.setPipeline(self.combine);
+        for ([_]Ref{ parts, ml, b.sinks, b.output }, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+        e.setValue(args, 4);
+        e.dispatchGroups(mtl.Size.of(shape.heads, shape.rows, 1), mtl.Size.of(128, 1, 1));
+    }
+
+    pub const max_splits = 8;
+
+    /// Bytes of the split partials for `heads` heads (16 rows, max_splits runs, O then max and sum).
+    pub fn partBytes(heads: u32) usize {
+        return @as(usize, max_splits) * 16 * heads * (weights.latent + 2) * 4;
+    }
+
+    fn run(pipe: mtl.Pipeline, e: mtl.ComputeEncoder, refs: []const Ref, rows: u32, heads: u32, col_blocks: u32) void {
+        e.setPipeline(pipe);
+        for (refs[0..3], 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+        e.setValue(Args{ .rows = rows, .heads = heads }, 3);
+        if (refs.len > 3) e.setBuffer(refs[3].buffer, refs[3].offset, 4);
+        e.dispatchGroups(mtl.Size.of(col_blocks, heads, (rows + 15) / 16), mtl.Size.of(128, 1, 1));
+    }
+};
+
+/// Each row's keys as one range of key indices [lo, hi) (u32 pairs), and each 32-key tile's first slot
+pub const KeyRanges = struct { ranges: Ref, tiles: Ref };
+
+pub const Projections = struct {
+    absorb_pipeline: mtl.Pipeline,
+    expand_pipeline: mtl.Pipeline,
+    table_pipeline: mtl.Pipeline,
+    rotate_pipeline: mtl.Pipeline,
+    cache_pipeline: mtl.Pipeline,
+    gate_pipeline: mtl.Pipeline,
+    /// expand then gate in one launch (bit-equal to the two passes).
+    expand_gated: mtl.Pipeline,
+    /// On tensor units: the absorb and expand-and-gate products there instead.
+    nax: ?Nax = null,
+
+    pub fn load(device: mtl.Device) !Projections {
+        const library = try mtl.Library.fromSource(device, sources.hy4_flash_mla_project, mtl.CompileOptions.mlx());
+        defer library.deinit();
+        var absorb_pipeline = try mtl.Pipeline.init(device, library, "tf_hy4_absorb_q", false);
+        errdefer absorb_pipeline.deinit();
+        var expand_pipeline = try mtl.Pipeline.init(device, library, "tf_hy4_expand_v", false);
+        errdefer expand_pipeline.deinit();
+        var table_pipeline = try mtl.Pipeline.init(device, library, "tf_hy4_rotary_table", false);
+        errdefer table_pipeline.deinit();
+        var rotate_pipeline = try mtl.Pipeline.init(device, library, "tf_hy4_rotate", false);
+        errdefer rotate_pipeline.deinit();
+        var cache_pipeline = try mtl.Pipeline.init(device, library, "tf_hy4_cache_keys", false);
+        errdefer cache_pipeline.deinit();
+        var expand_gated = try mtl.Pipeline.init(device, library, "tf_hy4_expand_v_gated", false);
+        errdefer expand_gated.deinit();
+        return .{
+            .expand_gated = expand_gated,
+            .absorb_pipeline = absorb_pipeline,
+            .expand_pipeline = expand_pipeline,
+            .table_pipeline = table_pipeline,
+            .rotate_pipeline = rotate_pipeline,
+            .cache_pipeline = cache_pipeline,
+            .gate_pipeline = try mtl.Pipeline.init(device, library, "tf_hy4_gate_values", false),
+        };
+    }
+
+    pub fn deinit(self: *Projections) void {
+        self.absorb_pipeline.deinit();
+        self.expand_pipeline.deinit();
+        self.table_pipeline.deinit();
+        self.rotate_pipeline.deinit();
+        self.cache_pipeline.deinit();
+        self.gate_pipeline.deinit();
+        self.expand_gated.deinit();
+        if (self.nax) |n| n.deinit();
+        self.* = undefined;
+    }
+
+    fn encode(pipeline: mtl.Pipeline, encoder: mtl.ComputeEncoder, refs: [3]Ref, rows: u32, heads: u32, width: u32) !void {
+        if (rows == 0 or heads == 0) return;
+        const row_heads = try std.math.mul(u32, rows, heads);
+        encoder.setPipeline(pipeline);
+        for (refs, 0..) |r, i| encoder.setBuffer(r.buffer, r.offset, i);
+        encoder.setValue(Args{ .rows = rows, .heads = heads }, refs.len);
+        encoder.dispatchThreads(mtl.Size.of(width, row_heads, 1), mtl.Size.of(32, 1, 1));
+    }
+
+    pub fn absorb(self: Projections, encoder: mtl.ComputeEncoder, query: Ref, wk: Ref, output: Ref, rows: u32, heads: u32) !void {
+        try encode(self.absorb_pipeline, encoder, .{ query, wk, output }, rows, heads, weights.latent);
+    }
+
+    pub fn expand(self: Projections, encoder: mtl.ComputeEncoder, latent: Ref, wv: Ref, output: Ref, rows: u32, heads: u32) !void {
+        try encode(self.expand_pipeline, encoder, .{ latent, wv, output }, rows, heads, weights.value_width);
+    }
+
+    /// Positions [row][3] i32, table [row][32][cos,sin] BF16. Order the table before the rotations that use it.
+    pub fn rotaryTable(self: Projections, e: mtl.ComputeEncoder, positions: Ref, table: Ref, rows: u32, p: rotary.Parameters) void {
+        if (rows == 0) return;
+        e.setPipeline(self.table_pipeline);
+        e.setBuffer(positions.buffer, positions.offset, 0);
+        e.setBuffer(table.buffer, table.offset, 1);
+        e.setValue(p, 2);
+        e.dispatchThreads(mtl.Size.of(rotary.pairs, rows, 1), mtl.Size.of(rotary.pairs, 1, 1));
+    }
+
+    pub fn rotate(self: Projections, e: mtl.ComputeEncoder, input: Ref, table: Ref, output: Ref, shape: rotary.View) !void {
+        try shape.check();
+        e.setPipeline(self.rotate_pipeline);
+        const buffers = [_]Ref{ input, table, output };
+        for (buffers, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+        e.setValue(shape, buffers.len);
+        e.dispatchThreads(mtl.Size.of(rotary.pairs, shape.heads, shape.rows), mtl.Size.of(rotary.pairs, 1, 1));
+    }
+
+    /// Normalize and rotate KV projection rows directly into the lane's assigned latent slots.
+    pub fn cacheKeys(self: Projections, e: mtl.ComputeEncoder, input: Ref, gain: Ref, table: Ref, slots: Ref, cache: Ref, shape: attention.CacheWrite) !void {
+        try shape.check();
+        e.setPipeline(self.cache_pipeline);
+        const buffers = [_]Ref{ input, gain, table, slots, cache };
+        for (buffers, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+        e.setValue(shape, buffers.len);
+        e.dispatchGroups(mtl.Size.of(shape.rows, 1, 1), mtl.Size.of(128, 1, 1));
+    }
+
+    pub fn gate(self: Projections, e: mtl.ComputeEncoder, values: Ref, logits: Ref, rows: u32, heads: u32) !void {
+        if (rows == 0) return;
+        if (heads == 0 or heads > 64) return error.BadHy4GateShape;
+        const columns = heads * weights.value_width;
+        e.setPipeline(self.gate_pipeline);
+        e.setBuffer(values.buffer, values.offset, 0);
+        e.setBuffer(logits.buffer, logits.offset, 1);
+        e.setValue(columns, 2);
+        e.dispatchThreads(mtl.Size.of(columns, rows, 1), mtl.Size.of(128, 1, 1));
+    }
+};
+
+pub const Attention = struct {
+    chunks: mtl.Pipeline,
+    merge: mtl.Pipeline,
+    /// Scores for every key at once, then each chunk's softmax over them (bit-equal to `chunks`).
+    scores: mtl.Pipeline,
+    scored: mtl.Pipeline,
+
+    pub const Buffers = struct {
+        query: Ref,
+        cache: Ref,
+        slots: Ref,
+        counts: Ref,
+        sinks: Ref,
+        scratch: Ref,
+        output: Ref,
+        /// [rows][heads][key_stride] floats; null runs the one-step chunks kernel.
+        key_scores: ?Ref = null,
+        /// Contiguous key ranges: the tensor units' flash kernel instead of the slot lists.
+        ranges: ?KeyRanges = null,
+        /// The flash kernel's split partials for decode passes (Nax.partBytes); null keeps one threadgroup a head.
+        flash_parts: ?Ref = null,
+        /// The widest row's live key count (0: unknown, the key stride sizes the split).
+        live_keys: u32 = 0,
+        /// A pass across 2,048 keys: rows before this one take the flash kernel over `ranges`
+        lists_from: ?u32 = null,
+    };
+
+    pub fn load(device: mtl.Device) !Attention {
+        const library = try mtl.Library.fromSource(device, sources.hy4_flash_mla_attention, mtl.CompileOptions.mlx());
+        defer library.deinit();
+        var chunks = try mtl.Pipeline.init(device, library, "tf_hy4_attend_chunks", false);
+        errdefer chunks.deinit();
+        var merge = try mtl.Pipeline.init(device, library, "tf_hy4_attend_merge", false);
+        errdefer merge.deinit();
+        var scores = try mtl.Pipeline.init(device, library, "tf_hy4_attend_scores", false);
+        errdefer scores.deinit();
+        return .{ .chunks = chunks, .merge = merge, .scores = scores, .scored = try mtl.Pipeline.init(device, library, "tf_hy4_attend_scored", false) };
+    }
+
+    pub fn deinit(self: *Attention) void {
+        self.chunks.deinit();
+        self.merge.deinit();
+        self.scores.deinit();
+        self.scored.deinit();
+        self.* = undefined;
+    }
+
+    /// Caller orders the query/cache writers before this dispatch. Counts and physical slots must be valid.
+    pub fn attend(self: Attention, e: mtl.ComputeEncoder, b: Buffers, shape: attention.Shape) !void {
+        try shape.check();
+        const length = b.scratch.buffer.length();
+        if (b.scratch.offset > length or shape.scratchBytes() > length - b.scratch.offset) return error.ShortHy4AttentionScratch;
+        if (b.key_scores) |ks| {
+            if (ks.buffer.length() < ks.offset + @as(usize, shape.rows) * shape.heads * shape.key_stride * 4) return error.ShortHy4AttentionScratch;
+            e.setPipeline(self.scores);
+            const first = .{ b.query, b.cache, b.slots, b.counts, ks };
+            inline for (first, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+            e.setValue(shape, first.len);
+            e.setValue(attention.score_scale, first.len + 1);
+            e.dispatchGroups(mtl.Size.of((shape.heads + 3) / 4, (shape.key_stride + 63) / 64, shape.rows), mtl.Size.of(128, 1, 1));
+            e.barrier();
+            e.setPipeline(self.scored);
+            const second = .{ ks, b.cache, b.slots, b.counts, b.scratch };
+            inline for (second, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+            e.setValue(shape, second.len);
+            e.dispatchGroups(mtl.Size.of((shape.heads + 3) / 4, shape.chunks, shape.rows), mtl.Size.of(128, 1, 1));
+        } else {
+            e.setPipeline(self.chunks);
+            const input = .{ b.query, b.cache, b.slots, b.counts, b.scratch };
+            inline for (input, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+            e.setValue(shape, input.len);
+            e.setValue(attention.score_scale, input.len + 1);
+            e.dispatchGroups(mtl.Size.of((shape.heads + 3) / 4, shape.chunks, shape.rows), mtl.Size.of(128, 1, 1));
+        }
+        e.barrier();
+        e.setPipeline(self.merge);
+        const merge_buffers = .{ b.scratch, b.sinks, b.output };
+        inline for (merge_buffers, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+        e.setValue(shape, merge_buffers.len);
+        e.dispatchGroups(mtl.Size.of(shape.heads, shape.rows, 1), mtl.Size.of(128, 1, 1));
+    }
+};
+
+pub const KvInput = struct {
+    projection: Ref,
+    gain: Ref,
+    write_slots: Ref,
+    capacity: u32,
+    epsilon: f32,
+};
+
+/// Decode passes (at most 4 rows): absorb and expand-and-gate as GEMVs over the checkpoint's affine kv_b codes
+pub const MlaPass = struct {
+    query: Ref,
+    key_weights: Ref,
+    value_weights: Ref,
+    value_logits: Ref,
+    positions: Ref,
+    rotary_table: Ref,
+    kv: ?KvInput = null,
+    attention: Attention.Buffers,
+    values: Ref,
+};
+
+fn rowsPast(r: Ref, bytes: usize) Ref {
+    return .{ .buffer = r.buffer, .offset = r.offset + bytes };
+}
+
+/// The affine projections feed this pass. The caller owns the KV leases and retained physical key list.
+pub fn forward(project: Projections, attend: Attention, e: mtl.ComputeEncoder, b: MlaPass, shape: attention.Shape, p: rotary.Parameters) !void {
+    try shape.check();
+    if (b.kv) |kv| try (attention.CacheWrite{ .rows = shape.rows, .capacity = kv.capacity, .epsilon = kv.epsilon }).check();
+    project.rotaryTable(e, b.positions, b.rotary_table, shape.rows, p);
+    if (project.nax) |n|
+        Nax.run(n.absorb, e, &.{ b.query, b.key_weights, b.attention.query }, shape.rows, shape.heads, weights.latent / 128)
+    else
+        try project.absorb(e, b.query, b.key_weights, b.attention.query, shape.rows, shape.heads);
+    e.barrier();
+    const input: Ref = .{ .buffer = b.query.buffer, .offset = b.query.offset + weights.nope * 2 };
+    const output: Ref = .{
+        .buffer = b.attention.query.buffer,
+        .offset = b.attention.query.offset + weights.latent * 2,
+    };
+    try project.rotate(e, input, b.rotary_table, output, .{
+        .rows = shape.rows,
+        .heads = shape.heads,
+        .input_stride = weights.query_stride,
+        .output_stride = weights.absorbed_stride,
+    });
+    if (b.kv) |kv| try project.cacheKeys(e, kv.projection, kv.gain, b.rotary_table, kv.write_slots, b.attention.cache, .{
+        .rows = shape.rows,
+        .capacity = kv.capacity,
+        .epsilon = kv.epsilon,
+    });
+    e.barrier();
+    if (b.attention.lists_from) |k| {
+        const n = project.nax orelse return error.Hy4ListSplitNeedsNax;
+        const r = b.attention.ranges orelse return error.Hy4ListSplitNeedsRanges;
+        if (k == 0 or k >= shape.rows) return error.BadHy4ListSplit;
+        n.flash(e, b.attention, r, try attention.Shape.init(k, shape.heads, shape.key_stride));
+        var rest = b.attention;
+        rest.ranges = null;
+        rest.lists_from = null;
+        rest.query = rowsPast(b.attention.query, k * shape.heads * weights.absorbed_stride * 2);
+        rest.slots = rowsPast(b.attention.slots, k * shape.key_stride * 4);
+        rest.counts = rowsPast(b.attention.counts, k * 4);
+        rest.output = rowsPast(b.attention.output, k * shape.heads * weights.latent * 2);
+        try attend.attend(e, rest, try attention.Shape.init(shape.rows - k, shape.heads, shape.key_stride));
+    } else if (project.nax) |n| if (b.attention.ranges) |r| {
+        n.flash(e, b.attention, r, shape);
+    } else try attend.attend(e, b.attention, shape) else try attend.attend(e, b.attention, shape);
+    e.barrier();
+    if (shape.heads > 64) return error.BadHy4GateShape;
+    if (project.nax) |n| return Nax.run(n.expand, e, &.{ b.attention.output, b.value_weights, b.values, b.value_logits }, shape.rows, shape.heads, weights.value_width / 128);
+    e.setPipeline(project.expand_gated);
+    for ([_]Ref{ b.attention.output, b.value_weights, b.values }, 0..) |r, i| e.setBuffer(r.buffer, r.offset, i);
+    e.setValue(Args{ .rows = shape.rows, .heads = shape.heads }, 3);
+    e.setBuffer(b.value_logits.buffer, b.value_logits.offset, 4);
+    e.dispatchThreads(mtl.Size.of(weights.value_width, try std.math.mul(u32, shape.rows, shape.heads), 1), mtl.Size.of(32, 1, 1));
+}
diff --git a/zig/src/families/hy4_flash/mla_weights.zig b/zig/src/families/hy4_flash/mla_weights.zig
new file mode 100644
index 0000000000000000000000000000000000000000..104bcdc34e10156cf4dc6824da975ea8bc4c0ed2
--- /dev/null
+++ b/zig/src/families/hy4_flash/mla_weights.zig
@@ -0,0 +1,122 @@
+//! Head-local BF16 K and V projections for absorbed Hy4-flash attention.
+const std = @import("std");
+const core = @import("core");
+const loader = @import("loader.zig");
+
+pub const latent = 512;
+pub const nope = 192;
+pub const rope = 64;
+pub const value_width = 256;
+pub const query_stride = nope + rope;
+pub const absorbed_stride = latent + rope;
+
+pub const HeadRange = struct { first: u32, count: u32 };
+
+/// The checkpoint's own affine kv_b rows for the selected heads (per head
+pub const Packed = struct {
+    bits: u8,
+    words: []u8,
+    scales: []u8,
+    biases: []u8,
+
+    pub fn deinit(self: Packed, a: std.mem.Allocator) void {
+        a.free(self.words);
+        a.free(self.scales);
+        a.free(self.biases);
+    }
+};
+
+pub const Weights = struct {
+    key: []u16,
+    value: []u16,
+    packed_rows: ?Packed = null,
+
+    pub fn deinit(self: *Weights, a: std.mem.Allocator) void {
+        a.free(self.key);
+        a.free(self.value);
+        if (self.packed_rows) |p| p.deinit(a);
+        self.* = undefined;
+    }
+};
+
+const per_head = nope + value_width;
+const Input = union(enum) { bf16: []const u8, fp32: []const f32 };
+
+fn word(input: Input, at: usize) u16 {
+    return switch (input) {
+        .bf16 => |bytes| std.mem.readInt(u16, bytes[2 * at ..][0..2], .little),
+        .fp32 => |elements| core.quant.convert.bf16(elements[at]),
+    };
+}
+
+fn split(a: std.mem.Allocator, input: Input, count: usize) !Weights {
+    const keys = try a.alloc(u16, count * nope * latent);
+    errdefer a.free(keys);
+    const values = try a.alloc(u16, count * value_width * latent);
+    errdefer a.free(values);
+    for (0..count) |head| {
+        const key_start = head * per_head * latent;
+        const value_start = key_start + nope * latent;
+        for (keys[head * nope * latent ..][0 .. nope * latent], 0..) |*item, i| item.* = word(input, key_start + i);
+        for (values[head * value_width * latent ..][0 .. value_width * latent], 0..) |*item, i| item.* = word(input, value_start + i);
+    }
+    return .{ .key = keys, .value = values };
+}
+
+/// Split contiguous BF16 kv_b rows for the selected heads without changing their values.
+pub fn splitBf16(a: std.mem.Allocator, raw: []const u8, count: usize) !Weights {
+    if (count == 0 or count > 64 or raw.len != count * per_head * latent * 2)
+        return error.BadHy4MlaWeight;
+    return split(a, .{ .bf16 = raw }, count);
+}
+
+/// The owning rank reads only its selected heads. DFly2 reads its own BF16 projection when sharing target KV.
+pub fn read(a: std.mem.Allocator, model: *loader.Loaded, kind: loader.Attention, layer: u32, range: HeadRange) !Weights {
+    const index = try model.attentionTargetLayer(kind, layer);
+    const t = model.config.value.text_config;
+    const shape = t.headShape(index);
+    if (t.kv_lora_rank != latent or shape.non_rotary != nope or shape.rotary != rope or shape.value != value_width)
+        return error.UnsupportedHy4MlaGeometry;
+    if (range.count == 0 or range.first > shape.heads or range.count > shape.heads - range.first)
+        return error.BadHeadRange;
+    var key_buffer: [96]u8 = undefined;
+    const prefix = switch (kind) {
+        .target => "model.layers",
+        .draft => "model.dfly_layers",
+    };
+    const base = try std.fmt.bufPrint(&key_buffer, "{s}.{d}.self_attn.kv_b_proj", .{ prefix, layer });
+    const from = @as(usize, range.first) * per_head;
+    const to = from + @as(usize, range.count) * per_head;
+    const span: core.quant.Span = .{ .from = from, .to = to };
+    const rows = @as(usize, shape.heads) * per_head;
+    var name: [108]u8 = undefined;
+    const weight_key = try std.fmt.bufPrint(&name, "{s}.weight", .{base});
+    switch (kind) {
+        .draft => {
+            const raw = try model.checkpoint.expect(weight_key, .bf16, &.{ rows, latent });
+            const selected = try core.quant.slice.takeRows(a, raw, &.{span});
+            return splitBf16(a, selected.bytes, range.count);
+        },
+        .target => {
+            const word_count = latent * @as(usize, model.bits) / 32;
+            const words = try model.checkpoint.expect(weight_key, .u32, &.{ rows, word_count });
+            const scale_key = try std.fmt.bufPrint(&name, "{s}.scales", .{base});
+            const scales = try model.checkpoint.expect(scale_key, .bf16, &.{ rows, latent / 64 });
+            const bias_key = try std.fmt.bufPrint(&name, "{s}.biases", .{base});
+            const biases = try model.checkpoint.expect(bias_key, .bf16, &.{ rows, latent / 64 });
+            const w_rows = try core.quant.slice.takeRows(a, words, &.{span});
+            const s_rows = try core.quant.slice.takeRows(a, scales, &.{span});
+            const b_rows = try core.quant.slice.takeRows(a, biases, &.{span});
+            const dequant = try core.quant.mlx.dequant(a, w_rows, s_rows, b_rows, 64);
+            defer a.free(dequant);
+            var out = try split(a, .{ .fp32 = dequant }, range.count);
+            errdefer out.deinit(a);
+            const pw = try a.dupe(u8, w_rows.bytes);
+            errdefer a.free(pw);
+            const ps = try a.dupe(u8, s_rows.bytes);
+            errdefer a.free(ps);
+            out.packed_rows = .{ .bits = model.bits, .words = pw, .scales = ps, .biases = try a.dupe(u8, b_rows.bytes) };
+            return out;
+        },
+    }
+}
diff --git a/zig/src/families/hy4_flash/model_weights.zig b/zig/src/families/hy4_flash/model_weights.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d1e130bed81749d40ad149b619169e19db84abe6
--- /dev/null
+++ b/zig/src/families/hy4_flash/model_weights.zig
@@ -0,0 +1,368 @@
+//! Checkpoint-backed weights for the target graph and DFly2. GPU loaders consume one layer at a time.
+const std = @import("std");
+const core = @import("core");
+const config = @import("config.zig");
+const checkpoint = @import("loader.zig");
+const ranks = @import("rank_weights.zig");
+const mla = @import("mla_weights.zig");
+const ihc = @import("ihc.zig");
+const engram = @import("engram.zig");
+const engram_rows = @import("engram_rows.zig");
+const rope = @import("rope.zig");
+
+const Tensor = core.checkpoint_host.Tensor;
+const Affine = core.quant.mlx.Host;
+const Allocator = std.mem.Allocator;
+const Rank = core.quant.Rank;
+
+/// Prefix-scoped, checked views. The checkpoint owns these bytes.
+const Reader = struct {
+    model: *checkpoint.Loaded,
+    prefix: []const u8,
+
+    fn tensor(self: Reader, field: []const u8, format: core.checkpoint_host.DType, dims: []const usize) !Tensor {
+        var scratch: [160]u8 = undefined;
+        const key = try std.fmt.bufPrint(&scratch, "{s}{s}", .{ self.prefix, field });
+        return self.model.checkpoint.expect(key, format, dims);
+    }
+
+    fn affine(self: Reader, field: []const u8, dims: []const usize) !Affine {
+        var scratch: [128]u8 = undefined;
+        const key = try std.fmt.bufPrint(&scratch, "{s}{s}", .{ self.prefix, field });
+        return ranks.affine(self.model, key, dims);
+    }
+
+    fn bf16(self: Reader, field: []const u8, dims: []const usize) !Tensor {
+        return self.tensor(field, .bf16, dims);
+    }
+};
+
+pub const Head = struct {
+    embedding: Affine,
+    lm_head: Affine,
+    norm: Tensor,
+    merge: ihc.Weights,
+
+    pub fn read(model: *checkpoint.Loaded, rows: u32) !Head {
+        const t = model.config.value.text_config;
+        const r: Reader = .{ .model = model, .prefix = "" };
+        return .{
+            .embedding = try r.affine("model.embed_tokens", &.{ t.vocab_size, t.hidden_size }),
+            .lm_head = try r.affine("lm_head", &.{ t.vocab_size, t.hidden_size }),
+            .norm = try r.bf16("model.norm.weight", &.{t.hidden_size}),
+            .merge = try ihc.Weights.read(model, .head, rows),
+        };
+    }
+};
+
+fn Mlp(comptime Matrix: type) type {
+    return struct { gate: Matrix, up: Matrix, down: Matrix };
+}
+
+fn affineMlp(r: Reader, h: usize, inner: usize) !Mlp(Affine) {
+    return .{
+        .gate = try r.affine("gate_proj", &.{ inner, h }),
+        .up = try r.affine("up_proj", &.{ inner, h }),
+        .down = try r.affine("down_proj", &.{ h, inner }),
+    };
+}
+
+fn draftMlp(r: Reader, h: usize, inner: usize) !Mlp(Tensor) {
+    return .{
+        .gate = try r.bf16("gate_proj.weight", &.{ inner, h }),
+        .up = try r.bf16("up_proj.weight", &.{ inner, h }),
+        .down = try r.bf16("down_proj.weight", &.{ h, inner }),
+    };
+}
+
+pub const Index = struct {
+    token_keys: Affine,
+    token_norm: Tensor,
+    query: Affine,
+    head_weights: Affine,
+    group_values: Tensor,
+    group_gates: Tensor,
+    group_bias: Tensor,
+    group_norm: Tensor,
+
+    fn read(r: Reader, t: config.Text) !Index {
+        const width = t.compressed_indexer_head_dim;
+        const heads = t.compressed_indexer_num_attention_heads;
+        return .{
+            .token_keys = try r.affine("token_key_projection", &.{ width, t.hidden_size }),
+            .token_norm = try r.bf16("token_key_norm.weight", &.{width}),
+            .query = try r.affine("query_projection", &.{ @as(usize, heads) * width, t.q_lora_rank }),
+            .head_weights = try r.affine("head_weight_projection", &.{ heads, t.hidden_size }),
+            .group_values = try r.tensor("key_value_projection.weight", .f32, &.{ width, width }),
+            .group_gates = try r.tensor("key_gate_projection.weight", .f32, &.{ width, width }),
+            .group_bias = try r.tensor("intra_group_ape", .f32, &.{ t.compressed_indexer_compress_ratio, width }),
+            .group_norm = try r.tensor("key_norm.weight", .f32, &.{width}),
+        };
+    }
+};
+
+pub const Routed = struct {
+    router: Tensor,
+    correction: Tensor,
+    down: Affine,
+    up: Affine,
+    experts: ranks.Experts,
+    shared: Mlp(Affine),
+    norm: Tensor,
+};
+
+pub const Feed = union(enum) {
+    dense: struct { projections: Mlp(Affine), norm: Tensor },
+    routed: Routed,
+
+    fn read(a: Allocator, model: *checkpoint.Loaded, layer: u32, rank: Rank) !Feed {
+        const t = model.config.value.text_config;
+        var buf: [80]u8 = undefined;
+        const prefix = try std.fmt.bufPrint(&buf, "model.layers.{d}.mlp.", .{layer});
+        const r: Reader = .{ .model = model, .prefix = prefix };
+        const h = t.hidden_size;
+        if (t.mlp_layer_types[layer] == .dense) {
+            return .{ .dense = .{
+                .projections = try affineMlp(r, h, t.intermediate_size),
+                .norm = try r.bf16("post_fc2_norm.weight", &.{h}),
+            } };
+        }
+        var shared_buf: [96]u8 = undefined;
+        const shared: Reader = .{
+            .model = model,
+            .prefix = try std.fmt.bufPrint(&shared_buf, "{s}shared_experts.", .{prefix}),
+        };
+        const latent = t.routed_expert_hidden_size;
+        return .{ .routed = .{
+            .router = try r.bf16("gate.weight", &.{ t.n_routed_experts, h }),
+            .correction = try r.tensor("gate.e_score_correction_bias", .f32, &.{t.n_routed_experts}),
+            .down = try r.affine("routed_expert_down_proj", &.{ latent, h }),
+            .up = try r.affine("routed_expert_up_proj", &.{ h, latent }),
+            .experts = try ranks.Experts.load(a, model, layer, rank),
+            .shared = try affineMlp(shared, h, @as(usize, t.moe_intermediate_size) * t.n_shared_experts),
+            .norm = try r.bf16("combine_output_norm.weight", &.{h}),
+        } };
+    }
+};
+
+pub const Engram = struct {
+    const Stream = struct { key: Affine, bias: Tensor, key_norm: Tensor, query_norm: Tensor, residual_scale: Tensor };
+
+    table: engram_rows.Table,
+    key: [ihc.streams]Stream,
+    lookup_norm: [engram.columns]Tensor,
+    value: Affine,
+    value_bias: Tensor,
+    pre_gamma: Tensor,
+
+    fn read(model: *checkpoint.Loaded, layer: u32) !Engram {
+        const t = model.config.value.text_config;
+        if (t.hc_mult != ihc.streams) return error.BadHy4IhcShape;
+        var prefix_buf: [76]u8 = undefined;
+        const r: Reader = .{
+            .model = model,
+            .prefix = try std.fmt.bufPrint(&prefix_buf, "model.layers.{d}.engram_layer.", .{layer}),
+        };
+        const table = try engram_rows.Table.open(model, layer + 1);
+        const h = t.hidden_size;
+        const input = table.elementsPerToken();
+        var out: Engram = .{
+            .table = table,
+            .key = undefined,
+            .lookup_norm = undefined,
+            .value = try r.affine("value_proj", &.{ h, input }),
+            .value_bias = try r.bf16("value_proj.bias", &.{h}),
+            .pre_gamma = try r.bf16("unified_pre_gamma", &.{h}),
+        };
+        var name: [72]u8 = undefined;
+        for (&out.lookup_norm, 0..) |*weight, i| {
+            weight.* = try r.bf16(try std.fmt.bufPrint(&name, "lookup_per_head_norms.{d}.weight", .{i}), &.{table.width});
+        }
+        for (&out.key, 0..) |*weight, i| {
+            weight.* = .{
+                .key = try r.affine(try std.fmt.bufPrint(&name, "key_projs.{d}", .{i}), &.{ h, input }),
+                .bias = try r.bf16(try std.fmt.bufPrint(&name, "key_projs.{d}.bias", .{i}), &.{h}),
+                .key_norm = try r.bf16(try std.fmt.bufPrint(&name, "norm_key.{d}.weight", .{i}), &.{h}),
+                .query_norm = try r.bf16(try std.fmt.bufPrint(&name, "norm_query.{d}.weight", .{i}), &.{h}),
+                .residual_scale = try r.bf16(try std.fmt.bufPrint(&name, "unified_per_hc_scales.{d}", .{i}), &.{h}),
+            };
+        }
+        return out;
+    }
+};
+
+pub const TargetLayer = struct {
+    project_query: Affine,
+    project_kv: Affine,
+    norm_query: Tensor,
+    norm_kv: Tensor,
+    attention: ranks.Attention,
+    absorbed: mla.Weights,
+    sinks: [64]f32,
+    position: rope.Parameters,
+    index: ?Index,
+    memory: ?Engram,
+    attention_hc: ihc.Weights,
+    attention_norm: Tensor,
+    attention_output_norm: Tensor,
+    mlp_hc: ihc.Weights,
+    mlp_norm: Tensor,
+    feed: Feed,
+
+    pub fn read(a: Allocator, model: *checkpoint.Loaded, layer: u32, rank: Rank, rows: u32) !TargetLayer {
+        _ = try model.attentionTargetLayer(.target, layer);
+        const t = model.config.value.text_config;
+        const h = t.hidden_size;
+        var path: [92]u8 = undefined;
+        const r: Reader = .{ .model = model, .prefix = try std.fmt.bufPrint(&path, "model.layers.{d}.", .{layer}) };
+        var ix_path: [96]u8 = undefined;
+        const ix: Reader = .{
+            .model = model,
+            .prefix = try std.fmt.bufPrint(&ix_path, "{s}self_attn.compressed_indexer.", .{r.prefix}),
+        };
+        const shape = t.headShape(layer);
+        var attention = try ranks.Attention.load(a, model, layer, rank);
+        errdefer attention.deinit(a);
+        var absorbed = try mla.read(a, model, .target, layer, attention.heads);
+        errdefer absorbed.deinit(a);
+        var all_sinks: [64]f32 = undefined;
+        const sink = try model.attentionSink(.target, layer, &all_sinks);
+        var packed_sinks: [64]f32 = @splat(0);
+        const first = attention.heads.first;
+        const count = attention.heads.count;
+        @memcpy(packed_sinks[0..count], sink[first..][0..count]);
+        const kind = t.layer_types[layer];
+        return .{
+            .project_query = try r.affine("self_attn.q_a_proj", &.{ t.q_lora_rank, h }),
+            .project_kv = try r.affine("self_attn.kv_a_proj_with_mqa", &.{ @as(usize, t.kv_lora_rank) + shape.rotary, h }),
+            .norm_query = try r.bf16("self_attn.q_a_layernorm.weight", &.{t.q_lora_rank}),
+            .norm_kv = try r.bf16("self_attn.kv_a_layernorm.weight", &.{t.kv_lora_rank}),
+            .attention = attention,
+            .absorbed = absorbed,
+            .sinks = packed_sinks,
+            .position = try t.rotary(kind),
+            .index = if (kind == .deepseek_sparse_attention) try Index.read(ix, t) else null,
+            .memory = if (std.mem.indexOfScalar(u32, t.engram_layer_ids, layer + 1) != null) try Engram.read(model, layer) else null,
+            .attention_hc = try ihc.Weights.read(model, .{ .attention = layer }, rows),
+            .attention_norm = try r.bf16("input_layernorm.weight", &.{h}),
+            .attention_output_norm = try r.bf16("self_attn.post_proj_norm.weight", &.{h}),
+            .mlp_hc = try ihc.Weights.read(model, .{ .feed_forward = layer }, rows),
+            .mlp_norm = try r.bf16("post_attention_layernorm.weight", &.{h}),
+            .feed = try Feed.read(a, model, layer, rank),
+        };
+    }
+
+    pub fn deinit(self: *TargetLayer, a: Allocator) void {
+        self.absorbed.deinit(a);
+        self.attention.deinit(a);
+        self.* = undefined;
+    }
+};
+
+pub const DraftHead = struct {
+    anchor_norm: Tensor,
+    hidden_norm: Tensor,
+    fusion: Tensor,
+    fusion_gate: Tensor,
+    norm: Tensor,
+    correction_hidden_norm: Tensor,
+    correction_embedding_norm: Tensor,
+    correction: Mlp(Tensor),
+
+    pub fn read(model: *checkpoint.Loaded) !DraftHead {
+        const h = model.config.value.text_config.hidden_size;
+        const r: Reader = .{ .model = model, .prefix = "model.dfly_layers." };
+        const correction: Reader = .{ .model = model, .prefix = "model.dfly_layers.hidden_correction." };
+        return .{
+            .anchor_norm = try r.bf16("mtp_fusion.enorm.weight", &.{h}),
+            .hidden_norm = try r.bf16("mtp_fusion.hnorm.weight", &.{h}),
+            .fusion = try r.bf16("mtp_fusion.eh_proj.weight", &.{ h, @as(usize, h) * 2 }),
+            .fusion_gate = try r.bf16("mtp_fusion.gate", &.{h}),
+            .norm = try r.bf16("final_norm.weight", &.{h}),
+            .correction_hidden_norm = try correction.bf16("hidden_norm.weight", &.{h}),
+            .correction_embedding_norm = try correction.bf16("embed_norm.weight", &.{h}),
+            .correction = .{
+                .gate = try correction.bf16("gate_proj.weight", &.{ h, @as(usize, h) * 2 }),
+                .up = try correction.bf16("up_proj.weight", &.{ h, @as(usize, h) * 2 }),
+                .down = try correction.bf16("down_proj.weight", &.{ h, h }),
+            },
+        };
+    }
+};
+
+pub const DraftLayer = struct {
+    target_kv: u32,
+    target_index: u32,
+    heads: mla.HeadRange,
+    input_norm: Tensor,
+    query_low: Tensor,
+    query_norm: Tensor,
+    query_high: Tensor,
+    kv_low: Tensor,
+    kv_norm: Tensor,
+    absorbed: mla.Weights,
+    gate: Tensor,
+    output: Tensor,
+    owns_output: bool,
+    output_norm: Tensor,
+    sinks: [64]f32,
+    mlp_norm: Tensor,
+    mlp: Mlp(Tensor),
+
+    pub fn read(a: Allocator, model: *checkpoint.Loaded, layer: u32, rank: Rank) !DraftLayer {
+        const target = try model.attentionTargetLayer(.draft, layer);
+        const t = model.config.value.text_config;
+        const s = t.headShape(target);
+        const range = try ranks.Range.init(s.heads, rank, "Hy4-flash DFly2 attention heads");
+        const heads: mla.HeadRange = .{ .first = @intCast(range.first), .count = @intCast(range.count) };
+        const values = @as(usize, s.heads) * s.value;
+        const query = @as(usize, s.non_rotary) + s.rotary;
+        const value_start = range.first * s.value;
+        const value_end = value_start + range.count * s.value;
+        const h = t.hidden_size;
+        var path: [80]u8 = undefined;
+        const r: Reader = .{
+            .model = model,
+            .prefix = try std.fmt.bufPrint(&path, "model.dfly_layers.{d}.", .{layer}),
+        };
+        var mlp_path: [88]u8 = undefined;
+        const ffn: Reader = .{ .model = model, .prefix = try std.fmt.bufPrint(&mlp_path, "{s}mlp.", .{r.prefix}) };
+        const inner = model.config.value.dfly_intermediate_size orelse try std.math.mul(u32, h, 3);
+        const o = try r.bf16("self_attn.o_proj.weight", &.{ h, values });
+        const output = if (rank.world == 1) o else try core.quant.slice.takeCols(a, o, value_start, value_end);
+        errdefer if (rank.world != 1) a.free(output.bytes);
+        var absorbed = try mla.read(a, model, .draft, layer, heads);
+        errdefer absorbed.deinit(a);
+        var all_sinks: [64]f32 = undefined;
+        const sink = try model.attentionSink(.draft, layer, &all_sinks);
+        var packed_sinks: [64]f32 = @splat(0);
+        @memcpy(packed_sinks[0..heads.count], sink[heads.first..][0..heads.count]);
+        const q = try r.bf16("self_attn.q_b_proj.weight", &.{ s.queryRows(), t.q_lora_rank });
+        const gate = try r.bf16("self_attn.linear_gate.weight", &.{ values, h });
+        return .{
+            .target_kv = target,
+            .target_index = model.config.value.dfly_target_index_layer[layer],
+            .heads = heads,
+            .input_norm = try r.bf16("input_layernorm.weight", &.{h}),
+            .query_low = try r.bf16("self_attn.q_a_proj.weight", &.{ t.q_lora_rank, h }),
+            .query_norm = try r.bf16("self_attn.q_a_layernorm.weight", &.{t.q_lora_rank}),
+            .query_high = try core.quant.slice.takeRows(a, q, &.{.{ .from = range.first * query, .to = (range.first + range.count) * query }}),
+            .kv_low = try r.bf16("self_attn.kv_a_proj_with_mqa.weight", &.{ @as(usize, t.kv_lora_rank) + s.rotary, h }),
+            .kv_norm = try r.bf16("self_attn.kv_a_layernorm.weight", &.{t.kv_lora_rank}),
+            .absorbed = absorbed,
+            .gate = try core.quant.slice.takeRows(a, gate, &.{.{ .from = value_start, .to = value_end }}),
+            .output = output,
+            .owns_output = rank.world != 1,
+            .output_norm = try r.bf16("self_attn.post_proj_norm.weight", &.{h}),
+            .sinks = packed_sinks,
+            .mlp_norm = try r.bf16("post_attention_layernorm.weight", &.{h}),
+            .mlp = try draftMlp(ffn, h, inner),
+        };
+    }
+
+    pub fn deinit(self: *DraftLayer, a: Allocator) void {
+        self.absorbed.deinit(a);
+        if (self.owns_output) a.free(self.output.bytes);
+        self.* = undefined;
+    }
+};
diff --git a/zig/src/families/hy4_flash/moe_cuda.zig b/zig/src/families/hy4_flash/moe_cuda.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5aa2ffbdb239fc041c731c98b8687adc0c7b673e
--- /dev/null
+++ b/zig/src/families/hy4_flash/moe_cuda.zig
@@ -0,0 +1,105 @@
+//! CUDA's latent routed branch. The enclosing layer reduces the rank's partial before projecting it back.
+const std = @import("std");
+const cuda = @import("cuda");
+const config = @import("config.zig");
+const ranks = @import("rank_weights.zig");
+const affine = cuda.affine_experts;
+
+pub const Shape = struct {
+    hidden: u32,
+    route: cuda.moe_glue.Route,
+    experts: affine.Shape,
+
+    pub fn init(text: config.Text, rank: ranks.Range, rows: u32) !Shape {
+        const first = std.math.cast(u32, rank.first) orelse return error.BadHy4Rank;
+        const count = std.math.cast(u32, rank.count) orelse return error.BadHy4Rank;
+        if (@as(u64, first) + count > text.n_routed_experts or text.num_experts_per_tok == 0 or
+            text.n_routed_experts > 512 or text.num_experts_per_tok > @min(32, text.n_routed_experts)) return error.BadHy4Route;
+        const experts: affine.Shape = .{
+            .width = text.routed_expert_hidden_size,
+            .inner = text.moe_intermediate_size,
+            .first = first,
+            .experts = count,
+            .pairs = try std.math.mul(u32, rows, text.num_experts_per_tok),
+            .rows = rows,
+            .swiglu_limit = text.swiglu_limit,
+        };
+        try experts.check();
+        return .{
+            .hidden = text.hidden_size,
+            .route = .{
+                .experts = text.n_routed_experts,
+                .topk = text.num_experts_per_tok,
+                .shared = false,
+                .normalize = true,
+                .scale = text.routed_scaling_factor,
+                .score = true,
+            },
+            .experts = experts,
+        };
+    }
+};
+
+pub const Weights = struct {
+    router: u64,
+    correction_bias: u64,
+    gate_up: affine.Weights,
+    down: affine.Weights,
+    precision: affine.Precision,
+};
+
+pub const Buffers = struct {
+    hidden: u64, // BF16 [rows][hidden]
+    latent: u64, // BF16 [rows][routed width] from the replicated down projection
+    expert_rows: u64, // i32 [rows][top-k], each entry names the owning input row
+    logits: u64, // FP32 [rows][global experts]
+    ids: u64, // int32 [rows][top-k]
+    probabilities: u64, // FP32 [rows][top-k]
+    activated: u64, // BF16 [rows * top-k][inner]
+    contributions: u64, // FP32 [rows * top-k][routed width]
+    rank_output: u64, // FP32 [rows][routed width], summed over this rank's experts
+};
+
+pub const Kernels = struct {
+    router: cuda.route_rows.RouteRows,
+    glue: cuda.moe_glue.MoeGlue,
+    experts: affine.Kernels,
+
+    pub fn load(driver: *const cuda.Driver) !Kernels {
+        var router = try cuda.route_rows.RouteRows.load(driver);
+        errdefer router.unload();
+        var glue = try cuda.moe_glue.MoeGlue.load(driver);
+        errdefer glue.unload();
+        return .{ .router = router, .glue = glue, .experts = try affine.Kernels.load(driver) };
+    }
+
+    pub fn deinit(self: *Kernels) void {
+        self.experts.deinit();
+        self.glue.unload();
+        self.router.unload();
+        self.* = undefined;
+    }
+
+    pub fn forward(self: *const Kernels, s: cuda.Stream, w: Weights, b: Buffers, shape: Shape) !void {
+        const a = shape.experts;
+        try a.check();
+        if (b.expert_rows == 0 or !shape.route.score or !shape.route.normalize or shape.route.shared or
+            @as(usize, a.rows) * shape.route.topk != a.pairs) return error.BadHy4Route;
+        try self.router.logits(s, b.hidden, shape.hidden, w.router, b.logits, a.rows, shape.hidden, shape.route.experts);
+        try self.glue.topk(s, b.logits, w.correction_bias, shape.route, b.ids, b.probabilities, a.rows);
+        try self.experts.run(s, w.precision, .up, .{
+            .input = b.latent,
+            .ids = b.ids,
+            .src_rows = b.expert_rows,
+            .weights = w.gate_up,
+            .output = b.activated,
+        }, a);
+        try self.experts.run(s, w.precision, .down, .{
+            .input = b.activated,
+            .ids = b.ids,
+            .weights = w.down,
+            .output = b.contributions,
+        }, a);
+        try self.glue.combine(s, b.contributions, .f32, b.probabilities, b.rank_output, .f32, a.rows, shape.route.topk, a.width);
+    }
+};
diff --git a/zig/src/families/hy4_flash/moe_exl3_cuda.zig b/zig/src/families/hy4_flash/moe_exl3_cuda.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d84a955a64a5880ba8123a33e9d147d29bc63c86
--- /dev/null
+++ b/zig/src/families/hy4_flash/moe_exl3_cuda.zig
@@ -0,0 +1,102 @@
+//! Standard MUL1 routed experts for the Hy4 latent branch.
+const std = @import("std");
+const cuda = @import("cuda");
+const weights = @import("exl3_weights.zig");
+const exl3 = cuda.exl3_experts;
+const upload = cuda.exl3_upload;
+
+pub const Route = struct {
+    hidden: u64,
+    width: usize,
+    router: u64,
+    bias: u64,
+    logits: u64,
+    picks: u64,
+    probabilities: u64,
+    scale: f32,
+    output: u64,
+};
+
+pub const Routed = struct {
+    layer: exl3.Layer,
+    scratch: exl3.Scratch,
+
+    pub fn init(
+        owner: *upload.Uploader,
+        experts: []const weights.Expert,
+        latent: usize,
+        intermediate: usize,
+        rows: usize,
+        slots: usize,
+        limit: f32,
+    ) !Routed {
+        if (experts.len == 0 or experts.len > 512 or rows == 0 or slots == 0 or slots > 32 or
+            rows > 16384 / slots or !std.math.isFinite(limit) or limit <= 0)
+            return error.BadHy4ExpertShape;
+        _ = try exl3.plan(latent, intermediate, true);
+        _ = try exl3.plan(intermediate, latent, false);
+        const a = owner.gpa;
+        const projections = try a.alloc(upload.Proj, 3 * experts.len);
+        defer a.free(projections);
+        const gate = projections[0..experts.len];
+        const up = projections[experts.len..][0..experts.len];
+        const down = projections[2 * experts.len ..];
+        for (experts, gate, up, down) |e, *g, *u, *d| {
+            g.* = try projection(e.gate, latent, intermediate);
+            u.* = try projection(e.up, latent, intermediate);
+            d.* = try projection(e.down, intermediate, latent);
+        }
+        const mark = owner.bufs.items.len;
+        errdefer owner.rollback(mark);
+        const layer = try upload.layer(owner, a, latent, intermediate, .mul1, limit, 0, gate, up, down);
+        const size = try exl3.scratchBytes(layer, rows, slots);
+        const space = try a.alloc(u8, size);
+        defer a.free(space);
+        @memset(space, 0);
+        const base = try owner.dev(space);
+        return .{ .layer = layer, .scratch = try exl3.scratch(base, layer, rows, slots) };
+    }
+
+    pub fn forward(
+        self: Routed,
+        kernels: *const exl3.Experts,
+        router: *const cuda.route_rows.RouteRows,
+        glue: *const cuda.moe_glue.MoeGlue,
+        stream: cuda.Stream,
+        latent: u64,
+        rows: usize,
+        route: Route,
+    ) !void {
+        const slots = self.scratch.slots;
+        if (rows == 0 or rows > self.scratch.rows or slots > self.layer.experts or
+            route.width == 0 or !std.math.isFinite(route.scale) or route.scale <= 0)
+            return error.BadHy4Route;
+        try router.logits(stream, route.hidden, route.width, route.router, route.logits, rows, route.width, self.layer.experts);
+        try glue.topk(stream, route.logits, route.bias, .{
+            .experts = self.layer.experts,
+            .topk = slots,
+            .score = true,
+            .shared = false,
+            .normalize = true,
+            .scale = route.scale,
+        }, route.picks, route.probabilities, rows);
+        const output = try self.run(kernels, stream, latent, route.picks, rows);
+        try glue.combine(stream, output, .f32, route.probabilities, route.output, .f32, rows, slots, self.layer.dims);
+    }
+
+    pub fn run(self: Routed, kernels: *const exl3.Experts, stream: cuda.Stream, x: u64, picks: u64, rows: usize) !u64 {
+        if (rows == 0 or rows > self.scratch.rows) return error.BadHy4ExpertRows;
+        try kernels.runSlots(stream, self.layer, x, self.layer.dims, .bf16, picks, rows, self.scratch);
+        return self.scratch.y;
+    }
+};
+
+fn projection(p: weights.Projection, k: usize, n: usize) !upload.Proj {
+    if (p.geometry.k() != k or p.geometry.n() != n) return error.BadHy4ExpertShape;
+    return .{
+        .trellis = p.parts.trellis.bytes,
+        .suh = p.parts.suh.bytes,
+        .svh = p.parts.svh.bytes,
+        .k2 = p.geometry.k2(),
+    };
+}
diff --git a/zig/src/families/hy4_flash/rank_weights.zig b/zig/src/families/hy4_flash/rank_weights.zig
new file mode 100644
index 0000000000000000000000000000000000000000..51158881fadbebd6033f1cf5336e94df1bac28e3
--- /dev/null
+++ b/zig/src/families/hy4_flash/rank_weights.zig
@@ -0,0 +1,142 @@
+//! Exact partitions of Hy4-flash attention heads and routed experts.
+const std = @import("std");
+const core = @import("core");
+const loader = @import("loader.zig");
+const mla = @import("mla_weights.zig");
+
+const Affine = core.quant.mlx.Host;
+const Span = core.quant.Span;
+const Rank = core.quant.Rank;
+const group = 64;
+
+pub const Range = struct {
+    first: usize,
+    count: usize,
+
+    pub fn init(whole: usize, r: Rank, name: []const u8) !Range {
+        if (r.world == 0 or r.rank >= r.world or whole == 0) return error.BadHy4Rank;
+        const count = try core.quant.slice.even(whole, r.world, name);
+        return .{ .first = r.rank * count, .count = count };
+    }
+
+    fn span(self: Range, width: usize) Span {
+        return .{ .from = self.first * width, .to = (self.first + self.count) * width };
+    }
+};
+
+/// Q-B and the gate own this rank's output heads. The O projection owns those same input columns.
+pub const Attention = struct {
+    heads: mla.HeadRange,
+    query: Affine,
+    gate: Affine,
+    output: Affine,
+    owns_output: bool,
+
+    pub fn load(a: std.mem.Allocator, model: *loader.Loaded, layer: u32, rank: Rank) !Attention {
+        _ = try model.attentionTargetLayer(.target, layer);
+        const config = model.config.value.text_config;
+        const shape = config.headShape(layer);
+        const heads = try Range.init(shape.heads, rank, "Hy4-flash attention heads");
+        const query_stride = @as(usize, shape.non_rotary) + shape.rotary;
+        const value_width = shape.value;
+        var buffer: [108]u8 = undefined;
+        const prefix = "model.layers.{d}.self_attn.";
+        const query = try affine(model, try std.fmt.bufPrint(&buffer, prefix ++ "q_b_proj", .{layer}), &.{
+            shape.heads * query_stride, config.q_lora_rank,
+        });
+        const gate = try affine(model, try std.fmt.bufPrint(&buffer, prefix ++ "linear_gate", .{layer}), &.{
+            @as(usize, shape.heads) * value_width, config.hidden_size,
+        });
+        const output = try affine(model, try std.fmt.bufPrint(&buffer, prefix ++ "o_proj", .{layer}), &.{
+            config.hidden_size, @as(usize, shape.heads) * value_width,
+        });
+        return .{
+            .heads = .{ .first = @intCast(heads.first), .count = @intCast(heads.count) },
+            .query = try takeRows(a, query, heads.span(query_stride)),
+            .gate = try takeRows(a, gate, heads.span(value_width)),
+            .output = if (rank.world == 1) output else try takeCols(a, output, heads.span(value_width)),
+            .owns_output = rank.world != 1,
+        };
+    }
+
+    pub fn deinit(self: *Attention, a: std.mem.Allocator) void {
+        if (self.owns_output) {
+            a.free(self.output.words.bytes);
+            a.free(self.output.scales.bytes);
+            a.free(self.output.biases.bytes);
+        }
+        self.* = undefined;
+    }
+};
+
+/// Each rank reads whole experts from the two stacked affine projections, keeping global expert IDs.
+pub const Experts = struct {
+    ids: Range,
+    gate_up: Affine,
+    down: Affine,
+
+    pub fn load(a: std.mem.Allocator, model: *loader.Loaded, layer: u32, rank: Rank) !Experts {
+        _ = try model.attentionTargetLayer(.target, layer);
+        const config = model.config.value.text_config;
+        if (config.mlp_layer_types[layer] != .sparse) return error.BadHy4ExpertLayer;
+        const total = config.n_routed_experts;
+        const width = config.moe_intermediate_size;
+        const latent = config.routed_expert_hidden_size;
+        const ids = try Range.init(total, rank, "Hy4-flash routed experts");
+        var name: [108]u8 = undefined;
+        const prefix = "model.layers.{d}.mlp.experts.";
+        const gate_up = try affine(model, try std.fmt.bufPrint(&name, prefix ++ "gate_up_proj", .{layer}), &.{ total, @as(usize, width) * 2, latent });
+        const down = try affine(model, try std.fmt.bufPrint(&name, prefix ++ "down_proj", .{layer}), &.{ total, latent, width });
+        return .{
+            .ids = ids,
+            .gate_up = try takeRows(a, gate_up, ids.span(1)),
+            .down = try takeRows(a, down, ids.span(1)),
+        };
+    }
+};
+
+pub fn affine(model: *loader.Loaded, key: []const u8, dims: []const usize) !Affine {
+    if (dims.len < 2 or dims.len > 3) return error.BadHy4ProjectionWidth;
+    var name: [120]u8 = undefined;
+    var shape: [3]usize = undefined;
+    @memcpy(shape[0..dims.len], dims);
+    const k = dims[dims.len - 1];
+    if (k == 0 or k % group != 0) return error.BadHy4ProjectionWidth;
+    shape[dims.len - 1] = k * model.bits / 32;
+    const words = try model.checkpoint.expect(try std.fmt.bufPrint(&name, "{s}.weight", .{key}), .u32, shape[0..dims.len]);
+    shape[dims.len - 1] = k / group;
+    return .{
+        .words = words,
+        .scales = try model.checkpoint.expect(try std.fmt.bufPrint(&name, "{s}.scales", .{key}), .bf16, shape[0..dims.len]),
+        .biases = try model.checkpoint.expect(try std.fmt.bufPrint(&name, "{s}.biases", .{key}), .bf16, shape[0..dims.len]),
+        .bits = model.bits,
+        .group = group,
+    };
+}
+
+fn takeRows(a: std.mem.Allocator, p: Affine, span: Span) !Affine {
+    var cut = p;
+    cut.words = try core.quant.slice.takeRows(a, p.words, &.{span});
+    cut.scales = try core.quant.slice.takeRows(a, p.scales, &.{span});
+    cut.biases = try core.quant.slice.takeRows(a, p.biases, &.{span});
+    return cut;
+}
+
+fn takeCols(a: std.mem.Allocator, p: Affine, cols: Span) !Affine {
+    if (cols.from % group != 0 or cols.to % group != 0) return error.BadHy4ProjectionWidth;
+    var cut = p;
+    cut.words = try core.quant.slice.takeCols(a, p.words, cols.from * p.bits / 32, cols.to * p.bits / 32);
+    errdefer a.free(cut.words.bytes);
+    cut.scales = try core.quant.slice.takeCols(a, p.scales, cols.from / group, cols.to / group);
+    errdefer a.free(cut.scales.bytes);
+    cut.biases = try core.quant.slice.takeCols(a, p.biases, cols.from / group, cols.to / group);
+    return cut;
+}
+
+test "both rank cuts align attention and routed expert partitions" {
+    try std.testing.expectEqual(Range{ .first = 16, .count = 16 }, try Range.init(32, .{ .rank = 1, .world = 2 }, "sparse"));
+    try std.testing.expectEqual(Range{ .first = 0, .count = 32 }, try Range.init(64, .{ .rank = 0, .world = 2 }, "sliding"));
+    const ids = try Range.init(512, .{ .rank = 1, .world = 2 }, "experts");
+    try std.testing.expectEqual(Span{ .from = 256, .to = 512 }, ids.span(1));
+    try std.testing.expectError(error.BadHy4Rank, Range.init(32, .{ .rank = 0, .world = 0 }, "sparse"));
+}
diff --git a/zig/src/families/hy4_flash/rope.zig b/zig/src/families/hy4_flash/rope.zig
new file mode 100644
index 0000000000000000000000000000000000000000..db6f54c41a8633d349f9a783fbfa052717fa2844
--- /dev/null
+++ b/zig/src/families/hy4_flash/rope.zig
@@ -0,0 +1,57 @@
+//! Hy4-flash uses adjacent rotary pairs with interleaved time, height and width positions.
+const std = @import("std");
+
+pub const pairs = 32;
+pub const Config = struct {
+    rope_type: []const u8,
+    rope_theta: f32,
+    mrope_interleaved: bool,
+    mrope_section: [3]u32,
+
+    pub fn parameters(self: Config, width: u32) !Parameters {
+        if (width != pairs * 2 or !self.mrope_interleaved or !std.mem.eql(u8, self.rope_type, "default") or
+            !std.math.isFinite(self.rope_theta) or self.rope_theta <= 0)
+            return error.UnsupportedHy4Rotary;
+        var result: Parameters = undefined;
+        var counts: [3]u32 = @splat(0);
+        for (&result.frequencies, &result.axes, 0..) |*freq, *axis, i| {
+            axis.* = switch (i % 3) {
+                1 => if (i / 3 < self.mrope_section[1]) 1 else 0,
+                2 => if (i / 3 < self.mrope_section[2]) 2 else 0,
+                else => 0,
+            };
+            counts[axis.*] += 1;
+            freq.* = 1 / std.math.pow(f32, self.rope_theta, @as(f32, @floatFromInt(i)) / pairs);
+        }
+        if (!std.mem.eql(u32, &counts, &self.mrope_section)) return error.UnsupportedHy4Rotary;
+        return result;
+    }
+};
+
+pub const Parameters = extern struct { frequencies: [pairs]f32, axes: [pairs]u32 };
+
+/// Strides are in BF16 elements. Both base pointers address the first rotary element of head zero.
+pub const View = extern struct {
+    rows: u32,
+    heads: u32,
+    input_stride: u32,
+    output_stride: u32,
+
+    pub fn check(self: View) !void {
+        if (self.rows == 0 or self.rows > std.math.maxInt(u16) or self.heads == 0 or self.heads > 64 or
+            self.input_stride < 2 * pairs or self.output_stride < 2 * pairs) return error.BadHy4RotaryView;
+    }
+};
+
+test "checkpoint rotary tables use distinct frequency bases and exactly twelve time pairs" {
+    const config = @import("config.zig");
+    const parsed = try config.parse(std.testing.allocator, @embedFile("config_fixture.json"));
+    defer parsed.deinit();
+    const sliding = try parsed.value.text_config.rotary(.sliding_attention);
+    const sparse = try parsed.value.text_config.rotary(.deepseek_sparse_attention);
+    try std.testing.expectEqualSlices(u32, &sliding.axes, &sparse.axes);
+    try std.testing.expectEqualSlices(u32, &.{ 0, 1, 2 }, sliding.axes[0..3]);
+    try std.testing.expectEqualSlices(u32, &.{ 0, 1, 2, 0, 0 }, sliding.axes[27..32]);
+    try std.testing.expectApproxEqAbs(@as(f32, 0.01), sliding.frequencies[16], 0.0000001);
+    try std.testing.expectApproxEqAbs(@as(f32, 0.00031622777), sparse.frequencies[16], 0.0000001);
+}
diff --git a/zig/src/families/hy4_flash/serve_draft.zig b/zig/src/families/hy4_flash/serve_draft.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4498b238d4aa9a9ca163583883a0b7169ef350cd
--- /dev/null
+++ b/zig/src/families/hy4_flash/serve_draft.zig
@@ -0,0 +1,95 @@
+//! DFly2 drafts for a served Hy4-flash stream, from the anchor row's final hidden.
+const std = @import("std");
+const mtl = @import("metal");
+const target = @import("metal_model.zig");
+const index = @import("metal_index.zig");
+const serve = @import("serve_metal.zig");
+const Metal = serve.Metal;
+const Cache = serve.Cache;
+const prompt_rows = serve.prompt_rows;
+const draft_stride = serve.draft_stride;
+
+pub fn run(self: *Metal, c: *Cache, anchor_row: u32, bonus: u32, depth: u32) !void {
+    const w = self.draft.width;
+    const count = @min(depth, w - 1);
+    c.nheld = 0;
+    if (count == 0) return;
+    const p = c.len;
+    if (p + w > self.capacity) return;
+    self.bind(c);
+    const ids = self.d_ids.slice(u32, w);
+    @memset(ids, self.mask_token);
+    ids[0] = bonus;
+    const pos3 = self.d_positions.slice(i32, w * 3);
+    const wr = self.d_writes.slice(i32, w);
+    for (0..w) |i| {
+        const at = p + @as(u32, @intCast(i));
+        pos3[i * 3 ..][0..3].* = @splat(@intCast(at));
+        wr[i] = @intCast(at);
+    }
+    // each block's keys: past 2,048 the anchor's recalled list in its target layer, then the draft's own rows
+    for (self.draft.blocks, self.d_keys, self.d_counts) |block, kb, cb_| {
+        const keys = kb.slice(u32, @as(usize, w) * draft_stride);
+        const counts = cb_.slice(u32, w);
+        var base: []const i32 = &.{};
+        if (c.selected) {
+            const all = self.ix_tokens[block.target_index].?.slice(i32, @as(usize, prompt_rows) * index.keys_a_row);
+            const n: usize = @intCast(self.ix_counts[block.target_index].?.slice(i32, prompt_rows)[anchor_row]);
+            base = all[@as(usize, anchor_row) * index.keys_a_row ..][0..n];
+        }
+        for (0..w) |i| {
+            const at = p + @as(u32, @intCast(i));
+            const row_keys = keys[i * draft_stride ..][0..draft_stride];
+            var k: usize = 0;
+            if (c.selected) {
+                for (base) |slot| if (slot >= 0 and @as(u32, @intCast(slot)) < p) {
+                    row_keys[k] = @intCast(slot);
+                    k += 1;
+                };
+                for (p..at + 1) |slot| {
+                    row_keys[k] = @intCast(slot);
+                    k += 1;
+                }
+            } else {
+                for (0..at + 1) |slot| row_keys[slot] = @intCast(slot);
+                k = at + 1;
+            }
+            counts[i] = @intCast(k);
+        }
+    }
+    const h = self.draft.hidden;
+    const hidden = self.frame.common.normalized;
+    const anchor: target.Ref = .{ .buffer = hidden.buffer, .offset = hidden.offset + @as(usize, anchor_row) * h * 2 };
+    const pick = self.model.common.rows orelse return error.Hy4NeedsRowKernels;
+    const pool = mtl.objc.Pool.push();
+    defer pool.pop();
+    const cb = self.queue.commandBuffer();
+    const e = cb.compute(.concurrent);
+    encode: {
+        self.draft.encode(&self.model, e, &self.dframe, .{ .buffer = self.d_ids }, anchor, 1, self.d_caches) catch |err| {
+            e.end();
+            return err;
+        };
+        e.barrier();
+        for (0..count) |col| {
+            const previous: target.Ref = if (col == 0) .{ .buffer = self.d_ids } else .{ .buffer = self.d_tokens, .offset = (col - 1) * 4 };
+            const logits = self.draft.next(&self.model, e, &self.dframe, previous, @intCast(col + 1)) catch |err| {
+                e.end();
+                return err;
+            };
+            e.barrier();
+            pick.pick(e, logits, .{ .buffer = self.d_tokens }, @intCast(col), 1, self.vocab);
+            e.barrier();
+        }
+        break :encode;
+    }
+    e.end();
+    cb.commit();
+    cb.wait();
+    if (cb.failure()) |why| {
+        std.log.err("hy4: draft pass failed: {s}", .{why});
+        return error.Hy4GpuFailed;
+    }
+    @memcpy(c.held[0..count], self.d_tokens.slice(u32, count));
+    c.nheld = count;
+}
diff --git a/zig/src/families/hy4_flash/serve_metal.zig b/zig/src/families/hy4_flash/serve_metal.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e5e06d54be664bd9727a0479ea81378d7f844727
--- /dev/null
+++ b/zig/src/families/hy4_flash/serve_metal.zig
@@ -0,0 +1,600 @@
+//! Hy4-flash behind the lane engine on Metal
+const std = @import("std");
+const mtl = @import("metal");
+const lanes = @import("lanes");
+const target = @import("metal_model.zig");
+const dfly = @import("metal_draft.zig");
+const index = @import("metal_index.zig");
+const engram = @import("engram.zig");
+const be = lanes.backend;
+
+pub const key_width = 576; // BF16 words in a latent KV slot: 512 latent + 64 rope
+pub const window: u32 = 512; // the sliding layers' keys
+pub const prompt_rows: u32 = 512; // a prompt chunk's rows
+pub const max_window: u32 = 6; // the pending row and DFly2's five drafts
+pub const draft_stride: u32 = 2560; // a draft row's keys at most: a recalled list (2,048) and its own rows
+
+pub const Options = struct {
+    capacity: u32, // slots a stream's caches hold (a multiple of 512)
+};
+
+/// One stream's caches.
+pub const Cache = struct {
+    kv: []mtl.Buffer,
+    token_keys: []?mtl.Buffer,
+    group_keys: []?mtl.Buffer,
+    len: u32 = 0, // slots written and kept
+    hist: std.ArrayList(u32) = .empty, // the token at each kept slot
+    held: [max_window]u32 = @splat(0),
+    nheld: u32 = 0,
+    logits: []u16, // the last pass's last row
+    anchor: u32 = 0, // the row of the last pass whose final hidden the drafter reads (with no kept rows given)
+    selected: bool = false, // the last pass's sparse layers attended recalled lists
+
+    fn deinit(self: *Cache, gpa: std.mem.Allocator) void {
+        for (self.kv) |b| b.deinit();
+        for (self.token_keys) |b| if (b) |x| x.deinit();
+        for (self.group_keys) |b| if (b) |x| x.deinit();
+        gpa.free(self.kv);
+        gpa.free(self.token_keys);
+        gpa.free(self.group_keys);
+        gpa.free(self.logits);
+        self.hist.deinit(gpa);
+    }
+};
+
+pub const Metal = struct {
+    gpa: std.mem.Allocator,
+    device: mtl.Device,
+    queue: mtl.Queue,
+    model: target.Model,
+    draft: dfly.Draft,
+    frame: target.Frame,
+    dframe: dfly.Frame,
+    capacity: u32,
+    vocab: u32,
+    pad: u32,
+    mask_token: u32,
+    sliding: []bool,
+    lanes: []target.LayerCache,
+    positions: mtl.Buffer,
+    writes: mtl.Buffer,
+    slide_keys: mtl.Buffer,
+    slide_counts: mtl.Buffer,
+    sparse_keys: mtl.Buffer,
+    sparse_counts: mtl.Buffer,
+    slide_ranges: mtl.Buffer,
+    sparse_ranges: mtl.Buffer,
+    tiles: mtl.Buffer,
+    scores: mtl.Buffer,
+    ix_tokens: []?mtl.Buffer,
+    ix_counts: []?mtl.Buffer,
+    d_ids: mtl.Buffer,
+    d_tokens: mtl.Buffer,
+    d_positions: mtl.Buffer,
+    d_writes: mtl.Buffer,
+    d_keys: []mtl.Buffer,
+    d_counts: []mtl.Buffer,
+    d_caches: []target.LayerCache,
+    caches: std.AutoHashMapUnmanaged(*lanes.Stream, *Cache) = .empty,
+    kept: ?*Cache = null, // the last released stream's caches, for a prompt that shares their prefix
+    costs: [max_window]lanes.allocate.Cost = undefined,
+    draft_ms: f64 = 0,
+    /// The residency set's hook: caches made after the set is built join it.
+    follow: ?mtl.ResidencySet.Follow = null,
+
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, options: Options) !*Metal {
+        if (options.capacity < 2048 or options.capacity % 512 != 0 or options.capacity / 4 > 65536) return error.BadHy4Capacity;
+        const out = try gpa.create(Metal);
+        errdefer gpa.destroy(out);
+        const device = try mtl.Device.init();
+        errdefer device.deinit();
+        const queue = try device.queue();
+        errdefer queue.deinit();
+        out.* = undefined;
+        out.gpa = gpa;
+        out.device = device;
+        out.queue = queue;
+        out.capacity = options.capacity;
+        out.caches = .empty;
+        out.kept = null;
+        out.draft_ms = 0;
+        out.follow = null;
+        out.model = try target.Model.open(gpa, io, device, dir);
+        errdefer out.model.deinit();
+        const t = out.model.host.config.value.text_config;
+        out.vocab = t.vocab_size;
+        out.pad = t.engram_pad_id;
+        out.mask_token = out.model.host.config.value.dfly_mask_token_id;
+        out.draft = try dfly.Draft.open(gpa, device, &out.model.host);
+        errdefer out.draft.deinit();
+        if (out.draft.width > max_window) return error.Hy4DraftTooWide;
+        out.frame = try target.Frame.init(gpa, device, &out.model, prompt_rows, index.keys_a_row);
+        errdefer out.frame.deinit();
+        out.dframe = try dfly.Frame.init(gpa, device, &out.model, &out.draft, 1, draft_stride);
+        errdefer out.dframe.deinit();
+        const layers = out.model.blocks.len;
+        const opts = mtl.ResourceOptions.shared;
+        const C = options.capacity;
+        out.positions = try device.buffer(prompt_rows * 3 * 4, opts);
+        out.writes = try device.buffer(prompt_rows * 4, opts);
+        out.slide_keys = try device.buffer(prompt_rows * window * 4, opts);
+        out.slide_counts = try device.buffer(prompt_rows * 4, opts);
+        out.sparse_keys = try device.buffer(prompt_rows * index.keys_a_row * 4, opts);
+        out.sparse_counts = try device.buffer(prompt_rows * 4, opts);
+        out.slide_ranges = try device.buffer(prompt_rows * 8, opts);
+        out.sparse_ranges = try device.buffer(prompt_rows * 8, opts);
+        out.tiles = try device.buffer(C / 32 * 4, opts);
+        for (out.tiles.slice(u32, C / 32), 0..) |*x, i| x.* = @intCast(32 * i);
+        out.scores = try device.buffer(@as(usize, prompt_rows) * (C / 4) * 4, mtl.ResourceOptions.private);
+        out.sliding = try gpa.alloc(bool, layers);
+        out.lanes = try gpa.alloc(target.LayerCache, layers);
+        out.ix_tokens = try gpa.alloc(?mtl.Buffer, layers);
+        out.ix_counts = try gpa.alloc(?mtl.Buffer, layers);
+        for (0..layers) |l| {
+            const slide = t.layer_types[l] == .sliding_attention;
+            out.sliding[l] = slide;
+            out.ix_tokens[l] = if (slide) null else try device.buffer(@as(usize, prompt_rows) * index.keys_a_row * 4, opts);
+            out.ix_counts[l] = if (slide) null else try device.buffer(prompt_rows * 4, opts);
+            out.lanes[l] = .{
+                .rows = .{
+                    .positions = .{ .buffer = out.positions },
+                    .write_slots = .{ .buffer = out.writes },
+                    .retained = .{ .buffer = if (slide) out.slide_keys else out.sparse_keys },
+                    .counts = .{ .buffer = if (slide) out.slide_counts else out.sparse_counts },
+                    .cache = .{ .buffer = out.positions }, // bound to a stream's caches before each pass
+                    .capacity = C,
+                    .ranges = .{ .ranges = .{ .buffer = if (slide) out.slide_ranges else out.sparse_ranges }, .tiles = .{ .buffer = out.tiles } },
+                },
+                .key_stride = if (slide) window else index.keys_a_row,
+            };
+        }
+        const w = out.draft.width;
+        out.d_ids = try device.buffer(w * 4, opts);
+        out.d_tokens = try device.buffer(16 * 4, opts);
+        out.d_positions = try device.buffer(w * 3 * 4, opts);
+        out.d_writes = try device.buffer(w * 4, opts);
+        const blocks = out.draft.blocks.len;
+        out.d_keys = try gpa.alloc(mtl.Buffer, blocks);
+        out.d_counts = try gpa.alloc(mtl.Buffer, blocks);
+        out.d_caches = try gpa.alloc(target.LayerCache, blocks);
+        for (out.d_keys, out.d_counts, out.d_caches) |*k, *c, *dc| {
+            k.* = try device.buffer(@as(usize, w) * draft_stride * 4, opts);
+            c.* = try device.buffer(w * 4, opts);
+            dc.* = .{ .rows = .{
+                .positions = .{ .buffer = out.d_positions },
+                .write_slots = .{ .buffer = out.d_writes },
+                .retained = .{ .buffer = k.* },
+                .counts = .{ .buffer = c.* },
+                .cache = .{ .buffer = out.positions },
+                .capacity = C,
+            }, .key_stride = draft_stride };
+        }
+        return out;
+    }
+
+    pub fn deinit(self: *Metal) void {
+        var it = self.caches.valueIterator();
+        while (it.next()) |c| {
+            c.*.deinit(self.gpa);
+            self.gpa.destroy(c.*);
+        }
+        self.caches.deinit(self.gpa);
+        if (self.kept) |c| {
+            c.deinit(self.gpa);
+            self.gpa.destroy(c);
+        }
+        for (self.d_keys) |b| b.deinit();
+        for (self.d_counts) |b| b.deinit();
+        for (self.ix_tokens) |b| if (b) |x| x.deinit();
+        for (self.ix_counts) |b| if (b) |x| x.deinit();
+        for ([_]mtl.Buffer{ self.positions, self.writes, self.slide_keys, self.slide_counts, self.sparse_keys, self.sparse_counts, self.slide_ranges, self.sparse_ranges, self.tiles, self.scores, self.d_ids, self.d_tokens, self.d_positions, self.d_writes }) |b| b.deinit();
+        self.gpa.free(self.d_keys);
+        self.gpa.free(self.d_counts);
+        self.gpa.free(self.d_caches);
+        self.gpa.free(self.ix_tokens);
+        self.gpa.free(self.ix_counts);
+        self.gpa.free(self.lanes);
+        self.gpa.free(self.sliding);
+        self.dframe.deinit();
+        self.frame.deinit();
+        self.draft.deinit();
+        self.model.deinit();
+        self.queue.deinit();
+        self.device.deinit();
+        self.gpa.destroy(self);
+    }
+
+    /// Every Metal buffer the model, drafter, frames, pass state and kept caches hold, for one residency set.
+    pub fn residentBuffers(self: *Metal, list: *std.ArrayList(mtl.Buffer)) !void {
+        return @import("serve_resident.zig").buffers(self, list);
+    }
+
+    /// Bytes one stream's caches take at `capacity` slots.
+    pub fn cacheBytes(self: *const Metal, capacity: u32) u64 {
+        var sparse: u64 = 0;
+        for (self.sliding) |s| sparse += @intFromBool(!s);
+        return @as(u64, self.sliding.len) * capacity * key_width * 2 + sparse * (index.Cache.tokenBytes(capacity) + index.Cache.groupBytes(capacity));
+    }
+
+    fn newCache(self: *Metal) !*Cache {
+        const c = try self.gpa.create(Cache);
+        errdefer self.gpa.destroy(c);
+        const layers = self.sliding.len;
+        const opts = mtl.ResourceOptions.private;
+        const kv = try self.gpa.alloc(mtl.Buffer, layers);
+        errdefer self.gpa.free(kv);
+        const tk = try self.gpa.alloc(?mtl.Buffer, layers);
+        errdefer self.gpa.free(tk);
+        const gk = try self.gpa.alloc(?mtl.Buffer, layers);
+        errdefer self.gpa.free(gk);
+        @memset(tk, null);
+        @memset(gk, null);
+        var made: usize = 0;
+        errdefer for (kv[0..made], tk[0..made], gk[0..made]) |b, x, y| {
+            b.deinit();
+            if (x) |v| v.deinit();
+            if (y) |v| v.deinit();
+        };
+        for (0..layers) |l| {
+            kv[l] = try self.device.buffer(@as(usize, self.capacity) * key_width * 2, opts);
+            if (!self.sliding[l]) {
+                tk[l] = try self.device.buffer(index.Cache.tokenBytes(self.capacity), opts);
+                gk[l] = try self.device.buffer(index.Cache.groupBytes(self.capacity), opts);
+            }
+            made += 1;
+        }
+        c.* = .{ .kv = kv, .token_keys = tk, .group_keys = gk, .logits = try self.gpa.alloc(u16, self.vocab) };
+        // touch every page now: a fresh buffer's first GPU writes otherwise cost seconds inside a request
+        const pool = mtl.objc.Pool.push();
+        defer pool.pop();
+        const cb = self.queue.commandBuffer();
+        const blit = cb.blit();
+        for (0..layers) |l| {
+            blit.fill(kv[l], 0, @as(usize, self.capacity) * key_width * 2, 0);
+            if (tk[l]) |b| blit.fill(b, 0, index.Cache.tokenBytes(self.capacity), 0);
+            if (gk[l]) |b| blit.fill(b, 0, index.Cache.groupBytes(self.capacity), 0);
+        }
+        blit.end();
+        cb.commit();
+        cb.wait();
+        if (self.follow) |f| for (0..layers) |l| {
+            f.join(f.ctx, kv[l]);
+            if (tk[l]) |b| f.join(f.ctx, b);
+            if (gk[l]) |b| f.join(f.ctx, b);
+        };
+        return c;
+    }
+
+    /// Point the layers' caches at `c` for the next pass.
+    pub fn bind(self: *Metal, c: *const Cache) void {
+        for (self.lanes, 0..) |*lane, l| {
+            lane.rows.cache = .{ .buffer = c.kv[l] };
+            lane.index = if (self.sliding[l]) null else .{
+                .token_keys = .{ .buffer = c.token_keys[l].? },
+                .group_keys = .{ .buffer = c.group_keys[l].? },
+                .capacity = self.capacity,
+                .scores = .{ .buffer = self.scores },
+                .score_groups = self.capacity / 4,
+                .tokens = .{ .buffer = self.ix_tokens[l].? },
+                .counts = .{ .buffer = self.ix_counts[l].? },
+            };
+        }
+        for (self.d_caches, self.draft.blocks) |*dc, block| dc.rows.cache = .{ .buffer = c.kv[block.target_kv] };
+    }
+
+    /// Engram windows and ids for `tokens` at slots start.. (the cache's history holds the tokens before start).
+    fn stage(self: *Metal, c: *const Cache, start: u32, tokens: []const u32) !void {
+        const n = tokens.len;
+        var windows: [prompt_rows][engram.order]u32 = undefined;
+        var media: [prompt_rows]u32 = @splat(0);
+        for (tokens, 0..) |tk, r| {
+            const pos = start + @as(u32, @intCast(r));
+            windows[r][0] = tk;
+            for (1..engram.order) |lag| {
+                windows[r][lag] = if (lag <= r) tokens[r - lag] else if (lag <= pos) c.hist.items[pos - lag] else self.pad;
+            }
+        }
+        try self.frame.stage(&self.model, tokens, windows[0..n], media[0..n]);
+    }
+
+    /// Positions, write slots and the key lists and ranges of `n` rows at start.., and the indexer's rows.
+    fn layout(self: *Metal, start: u32, n: u32) !void {
+        const pos3 = self.positions.slice(i32, prompt_rows * 3);
+        const wr = self.writes.slice(i32, prompt_rows);
+        const last_end = start + n;
+        try self.frame.index.stage(start, n);
+        const lists = self.frame.index.selects();
+        const sparse_stride: u32 = if (lists) index.keys_a_row else ((last_end + window - 1) / window) * window;
+        const sk = self.slide_keys.slice(u32, prompt_rows * window);
+        const sc = self.slide_counts.slice(u32, prompt_rows);
+        const pk = self.sparse_keys.slice(u32, prompt_rows * index.keys_a_row);
+        const pc = self.sparse_counts.slice(u32, prompt_rows);
+        for (0..n) |r| {
+            const pos = start + @as(u32, @intCast(r));
+            const end = pos + 1;
+            pos3[r * 3 ..][0..3].* = @splat(@intCast(pos));
+            wr[r] = @intCast(pos);
+            const count = @min(end, window);
+            for (0..count) |j| sk[r * window + j] = end - count + @as(u32, @intCast(j));
+            sc[r] = count;
+            if (!lists) {
+                for (0..end) |j| pk[r * sparse_stride + j] = @intCast(j);
+                pc[r] = end;
+            }
+            self.slide_ranges.slice([2]u32, prompt_rows)[r] = .{ end - count, end };
+            self.sparse_ranges.slice([2]u32, prompt_rows)[r] = .{ 0, end };
+        }
+        for (self.lanes, self.sliding) |*lane, slide| {
+            lane.key_stride = if (slide) window else sparse_stride;
+            lane.rows.live_keys = if (slide) @min(last_end, window) else if (lists) index.keys_a_row else last_end;
+        }
+    }
+
+    /// One target pass over `tokens` at the cache's end: every row's logits when `all`, else the last row's.
+    fn pass(self: *Metal, c: *Cache, tokens: []const u32, all: bool) !void {
+        const n: u32 = @intCast(tokens.len);
+        if (n == 0 or n > prompt_rows) return error.BadHy4Pass;
+        const start = c.len;
+        if (start + n > self.capacity) return error.Hy4ContextFull;
+        self.bind(c);
+        try self.stage(c, start, tokens);
+        try self.layout(start, n);
+        self.frame.last_logits = !all and n > 1;
+        defer self.frame.last_logits = false;
+        const pool = mtl.objc.Pool.push();
+        defer pool.pop();
+        const cb = self.queue.commandBuffer();
+        const e = cb.compute(.concurrent);
+        _ = self.model.encode(e, &self.frame, self.lanes) catch |err| {
+            e.end();
+            return err;
+        };
+        e.end();
+        cb.commit();
+        cb.wait();
+        if (cb.failure()) |why| {
+            std.log.err("hy4: target pass failed: {s}", .{why});
+            return error.Hy4GpuFailed;
+        }
+        c.len += n;
+        try c.hist.appendSlice(self.gpa, tokens);
+        c.anchor = n - 1;
+        c.selected = self.frame.index.selects();
+        const rows: usize = if (self.frame.last_logits) 1 else n;
+        @memcpy(c.logits, self.frame.logits.buffer.slice(u16, rows * self.vocab)[(rows - 1) * self.vocab ..][0..self.vocab]);
+    }
+
+    fn logitsRow(self: *const Metal, r: usize) []const u16 {
+        return self.frame.logits.buffer.slice(u16, (r + 1) * self.vocab)[r * self.vocab ..][0..self.vocab];
+    }
+
+    pub fn facts(self: *const Metal) lanes.Model {
+        return .{
+            .exact_width = max_window,
+            .mtp = true,
+            .speculate = true,
+            .speculate_early = false,
+            .drafts = self.draft.width - 1,
+            .window_costs = &self.costs,
+            .mtp_step_ms = self.draft_ms,
+            .max_streams = 1,
+            .streams_exact = true,
+        };
+    }
+
+    pub fn backend(self: *Metal) be.Backend {
+        return .{ .ptr = self, .vtable = &.{ .prefill = prefillFn, .first = firstFn, .first_masked = firstMaskedFn, .queue = queueFn, .read = readFn, .verify = verifyFn, .keep = keepFn, .draft = draftFn, .release = releaseFn, .first_row = firstRowFn, .held = heldFn } };
+    }
+
+    fn cast(ptr: *anyopaque) *Metal {
+        return @ptrCast(@alignCast(ptr));
+    }
+
+    fn cacheOf(self: *Metal, s: *lanes.Stream) !*Cache {
+        return self.caches.get(s) orelse error.UnknownHy4Stream;
+    }
+
+    /// A prompt chunk, the verify widths and a draft once, timing each width for the lane core's depth rule.
+    pub fn warm(self: *Metal) !void {
+        const c = try self.newCache();
+        errdefer {
+            c.deinit(self.gpa);
+            self.gpa.destroy(c);
+        }
+        var ids: [prompt_rows]u32 = undefined;
+        for (&ids, 0..) |*x, i| x.* = @intCast(1000 + i * 37 % 20000);
+        ids[0] = 120000;
+        try self.pass(c, ids[0..prompt_rows], false);
+        for (1..max_window + 1) |width| {
+            var times: [3]f64 = undefined;
+            for (&times) |*tm| {
+                const t0 = mtl.clock.seconds();
+                try self.pass(c, ids[0..width], true);
+                tm.* = mtl.clock.seconds() - t0;
+                c.len -= @intCast(width);
+                c.hist.items.len -= width;
+            }
+            std.mem.sort(f64, &times, {}, std.sort.asc(f64));
+            self.costs[width - 1] = .{ .width = @intCast(width), .ms = 1000 * times[1] };
+        }
+        try self.runDraft(c, c.anchor, ids[1], 3); // the first draft compiles its pipelines
+        const t0 = mtl.clock.seconds();
+        try self.runDraft(c, c.anchor, ids[1], 3);
+        self.draft_ms = 1000 * (mtl.clock.seconds() - t0) / 3;
+        // every page of the caches touched once, then kept for the first stream
+        c.len = 0;
+        c.hist.items.len = 0;
+        c.nheld = 0;
+        self.kept = c;
+        std.log.info("hy4: window ms by width {d:.1} {d:.1} {d:.1} {d:.1} {d:.1} {d:.1}, draft {d:.2} ms a token", .{ self.costs[0].ms, self.costs[1].ms, self.costs[2].ms, self.costs[3].ms, self.costs[4].ms, self.costs[5].ms, self.draft_ms });
+    }
+
+    fn prefillFn(ptr: *anyopaque, s: *lanes.Stream) !void {
+        const self = cast(ptr);
+        const ids = s.prompt();
+        if (ids.len == 0 or self.caches.contains(s)) return error.InvalidHy4Prompt;
+        if (ids.len + s.max_new + max_window > self.capacity) return error.Hy4ContextFull;
+        // the kept caches, when this prompt starts with their tokens (keep at least one prompt token to run)
+        var c: *Cache = undefined;
+        var reused: u32 = 0;
+        if (self.kept) |k| {
+            var same: usize = 0;
+            const most = @min(k.hist.items.len, ids.len - 1);
+            while (same < most and k.hist.items[same] == ids[same]) same += 1;
+            // the caches are reused either way (fresh pages cost seconds to first touch): only the shared prefix stays
+            if (same < 64) same = 0;
+            c = k;
+            self.kept = null;
+            c.len = @intCast(same);
+            c.hist.items.len = same;
+            c.nheld = 0;
+            reused = @intCast(same);
+        } else c = try self.newCache();
+        errdefer {
+            c.deinit(self.gpa);
+            self.gpa.destroy(c);
+        }
+        try self.caches.put(self.gpa, s, c);
+        errdefer _ = self.caches.remove(s);
+        s.cached = reused;
+        var at: usize = reused;
+        while (at < ids.len) {
+            if (s.isCancelled()) return error.Cancelled;
+            const end = @min(ids.len, at + prompt_rows);
+            try self.pass(c, ids[at..end], false);
+            lanes.prefill_widths.completed(self.gpa, s, end - at);
+            at = end;
+        }
+    }
+
+    fn firstFn(ptr: *anyopaque, s: *lanes.Stream, position: u64) !u64 {
+        const self = cast(ptr);
+        const c = try self.cacheOf(s);
+        if (position != c.len) return error.InvalidHy4Position;
+        return try lanes.sampling_row.draw(self.gpa, c.logits, s.sampling, position, &.{});
+    }
+
+    fn firstMaskedFn(ptr: *anyopaque, s: *lanes.Stream, position: u64, mask: []const u32) !u64 {
+        const self = cast(ptr);
+        const c = try self.cacheOf(s);
+        if (position != c.len) return error.InvalidHy4Position;
+        return try lanes.sampling_row.draw(self.gpa, c.logits, s.sampling, position, mask);
+    }
+
+    fn queueFn(ptr: *anyopaque, s: *lanes.Stream, f: be.Feed, position: u64) !u64 {
+        const self = cast(ptr);
+        const c = try self.cacheOf(s);
+        if (position != c.len + 1) return error.InvalidHy4Position;
+        const token: u32 = switch (f) {
+            .value => |v| v,
+            .handle => |h| @intCast(h),
+        };
+        c.nheld = 0;
+        try self.pass(c, &.{token}, false);
+        return try lanes.sampling_row.draw(self.gpa, c.logits, s.sampling, position, &.{});
+    }
+
+    fn readFn(ptr: *anyopaque, handle: u64) !u32 {
+        if (handle >= cast(ptr).vocab) return error.InvalidHy4Token;
+        return @intCast(handle);
+    }
+
+    fn firstRowFn(ptr: *anyopaque, s: *lanes.Stream) !lanes.LogprobRow {
+        const self = cast(ptr);
+        const l = (try self.cacheOf(s)).logits;
+        return row(l, @intCast(argmax(l)), s.logprobs orelse 0);
+    }
+
+    /// The window's pending token and drafts in one pass, every row drawn; `keep` rolls the rest back.
+    fn verifyFn(ptr: *anyopaque, windows: []const be.Window, out: []be.Verified) !void {
+        const self = cast(ptr);
+        const words = (self.vocab + 31) / 32;
+        if (windows.len != out.len) return error.InvalidHy4Windows;
+        for (windows, out) |w, o| {
+            const rows = w.rows();
+            if (rows > max_window or w.parents != null or o.sampled.len != rows or o.drafts.len != rows - 1) return error.UnsupportedHy4Window;
+            const c = try self.cacheOf(w.stream);
+            if (w.held > c.nheld) return error.Hy4DraftsNotHeld;
+            for (w.positions, 0..) |p, r| if (p != c.len + r + 1) return error.InvalidHy4Position;
+            var ids: [max_window]u32 = undefined;
+            ids[0] = w.pending;
+            @memcpy(ids[1..][0..w.held], c.held[0..w.held]);
+            @memcpy(ids[1 + w.held ..][0..w.tokens.len], w.tokens);
+            c.nheld = 0;
+            try self.pass(c, ids[0..rows], true);
+            @memcpy(o.drafts, ids[1..rows]);
+            for (0..rows) |r| {
+                const l = self.logitsRow(r);
+                const mask = if (w.masks.len >= (r + 1) * words) w.masks[r * words ..][0..words] else &.{};
+                o.sampled[r] = try lanes.sampling_row.draw(self.gpa, l, w.stream.sampling, w.positions[r], mask);
+                if (o.rows.len == rows) o.rows[r] = row(l, o.sampled[r], w.stream.logprobs orelse 0);
+            }
+        }
+    }
+
+    fn keepFn(ptr: *anyopaque, windows: []const be.Window, paths: []const []const u32) !void {
+        const self = cast(ptr);
+        for (windows, paths) |w, path| {
+            const c = try self.cacheOf(w.stream);
+            for (path, 0..) |r, i| if (r != i) return error.UnsupportedHy4Tree;
+            const rows: u32 = @intCast(w.rows());
+            if (path.len == 0 or path.len > rows or rows > c.len) return error.UnsupportedHy4Window;
+            c.len = c.len - rows + @as(u32, @intCast(path.len));
+            c.hist.items.len = c.len;
+            c.anchor = @intCast(path.len - 1);
+        }
+    }
+
+    /// DFly2 from the anchor row's final hidden
+    pub fn runDraft(self: *Metal, c: *Cache, anchor_row: u32, bonus: u32, depth: u32) !void {
+        return @import("serve_draft.zig").run(self, c, anchor_row, bonus, depth);
+    }
+
+    fn draftFn(ptr: *anyopaque, requests: []const be.DraftRequest) !void {
+        const self = cast(ptr);
+        for (requests) |r| {
+            const c = try self.cacheOf(r.stream);
+            c.nheld = 0;
+            var anchor_row = c.anchor;
+            if (r.rows) |rows| {
+                if (rows.len == 0) return error.UnsupportedHy4Window;
+                for (rows, 0..) |x, i| if (x != i) return error.UnsupportedHy4Tree;
+                anchor_row = rows[rows.len - 1];
+            }
+            const bonus: u32 = if (r.follow.len > 0) r.follow[r.follow.len - 1] else switch (r.first orelse return error.NoFirstToken) {
+                .value => |v| v,
+                .handle => |hd| @intCast(hd),
+            };
+            if (r.position != @as(u64, c.len) + 1) return error.InvalidHy4Position;
+            try self.runDraft(c, anchor_row, bonus, r.depth);
+        }
+    }
+
+    fn heldFn(ptr: *anyopaque, s: *lanes.Stream, out: []u32) !void {
+        const c = try cast(ptr).cacheOf(s);
+        if (out.len > c.nheld) return error.Hy4DraftsNotHeld;
+        @memcpy(out, c.held[0..out.len]);
+    }
+
+    fn releaseFn(ptr: *anyopaque, s: *lanes.Stream) void {
+        const self = cast(ptr);
+        const entry = self.caches.fetchRemove(s) orelse return;
+        if (self.kept) |k| {
+            k.deinit(self.gpa);
+            self.gpa.destroy(k);
+        }
+        entry.value.nheld = 0;
+        self.kept = entry.value;
+    }
+};
+
+fn argmax(l: []const u16) usize {
+    var best: usize = 0;
+    for (l, 0..) |w, i| if (@as(f32, @bitCast(@as(u32, w) << 16)) > @as(f32, @bitCast(@as(u32, l[best]) << 16))) {
+        best = i;
+    };
+    return best;
+}
+
+const row = @import("../step5/backend.zig").row;
diff --git a/zig/src/families/hy4_flash/serve_resident.zig b/zig/src/families/hy4_flash/serve_resident.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1cb35aca44c4c367b5411ee429ebfe6e6f049bca
--- /dev/null
+++ b/zig/src/families/hy4_flash/serve_resident.zig
@@ -0,0 +1,78 @@
+//! Every Metal buffer a served Hy4-flash model holds, gathered once for its residency set.
+const std = @import("std");
+const mtl = @import("metal");
+const target = @import("metal_model.zig");
+const dfly = @import("metal_draft.zig");
+const Metal = @import("serve_metal.zig").Metal;
+
+pub fn buffers(self: *Metal, list: *std.ArrayList(mtl.Buffer)) !void {
+    try gather(target.Model, &self.model, list, self.gpa);
+    try gather(dfly.Draft, &self.draft, list, self.gpa);
+    try gather(target.Frame, &self.frame, list, self.gpa);
+    try gather(dfly.Frame, &self.dframe, list, self.gpa);
+    for ([_]mtl.Buffer{ self.positions, self.writes, self.slide_keys, self.slide_counts, self.sparse_keys, self.sparse_counts, self.slide_ranges, self.sparse_ranges, self.tiles, self.scores, self.d_ids, self.d_tokens, self.d_positions, self.d_writes }) |b| try list.append(self.gpa, b);
+    try list.appendSlice(self.gpa, self.d_keys);
+    try list.appendSlice(self.gpa, self.d_counts);
+    for (self.ix_tokens, self.ix_counts) |x, y| {
+        if (x) |b| try list.append(self.gpa, b);
+        if (y) |b| try list.append(self.gpa, b);
+    }
+    if (self.kept) |c| {
+        try list.appendSlice(self.gpa, c.kv);
+        for (c.token_keys, c.group_keys) |x, y| {
+            if (x) |b| try list.append(self.gpa, b);
+            if (y) |b| try list.append(self.gpa, b);
+        }
+    }
+    // one entry a buffer
+    std.mem.sort(mtl.Buffer, list.items, {}, struct {
+        fn less(_: void, x: mtl.Buffer, y: mtl.Buffer) bool {
+            return @intFromPtr(x.id) < @intFromPtr(y.id);
+        }
+    }.less);
+    var n: usize = 0;
+    for (list.items) |b| {
+        if (n > 0 and list.items[n - 1].id == b.id) continue;
+        list.items[n] = b;
+        n += 1;
+    }
+    list.items.len = n;
+}
+
+/// Whether a value of T can hold a Metal buffer (structs, optionals, arrays, slices and unions of them).
+fn holds(comptime T: type, comptime depth: u32) bool {
+    if (T == mtl.Buffer) return true;
+    if (depth == 0) return false;
+    return switch (@typeInfo(T)) {
+        .@"struct" => |st| blk: {
+            for (st.field_types, st.field_attrs) |F, attrs| if (!attrs.@"comptime" and holds(F, depth - 1)) break :blk true;
+            break :blk false;
+        },
+        .optional => |o| holds(o.child, depth - 1),
+        .array => |ar| holds(ar.child, depth - 1),
+        .pointer => |ptr| ptr.size == .slice and holds(ptr.child, depth - 1),
+        .@"union" => |u| blk: {
+            if (u.tag_type == null) break :blk false;
+            for (u.field_types) |F| if (holds(F, depth - 1)) break :blk true;
+            break :blk false;
+        },
+        else => false,
+    };
+}
+
+fn gather(comptime T: type, v: *const T, list: *std.ArrayList(mtl.Buffer), gpa: std.mem.Allocator) !void {
+    if (T == mtl.Buffer) return list.append(gpa, v.*);
+    if (comptime !holds(T, 8)) return;
+    switch (@typeInfo(T)) {
+        .@"struct" => |st| inline for (st.field_names, st.field_types, st.field_attrs) |f, F, attrs| {
+            if (!attrs.@"comptime") try gather(F, &@field(v.*, f), list, gpa);
+        },
+        .optional => |o| if (v.*) |*x| try gather(o.child, x, list, gpa),
+        .array => |ar| for (v) |*x| try gather(ar.child, x, list, gpa),
+        .pointer => |ptr| if (ptr.size == .slice) for (v.*) |*x| try gather(ptr.child, x, list, gpa),
+        .@"union" => switch (v.*) {
+            inline else => |*x| try gather(@TypeOf(x.*), x, list, gpa),
+        },
+        else => {},
+    }
+}
diff --git a/zig/src/families/hy4_flash/weights.zig b/zig/src/families/hy4_flash/weights.zig
new file mode 100644
index 0000000000000000000000000000000000000000..bd54995199c171162ee18855c8fce850241f0db7
--- /dev/null
+++ b/zig/src/families/hy4_flash/weights.zig
@@ -0,0 +1,184 @@
+//! Required tensor names and logical dimensions for the Hy4-flash backbone and DFly2.
+const std = @import("std");
+const config = @import("config.zig");
+
+pub const Model = config.Model;
+
+pub const Affine = struct {
+    bits: u8,
+    group_size: u16,
+
+    pub fn check(self: Affine, weights: anytype, prefix: []const u8, name: []const u8, logical: []const usize) !void {
+        if ((self.bits != 4 and self.bits != 8) or
+            (self.group_size != 32 and self.group_size != 64) or
+            logical.len < 2 or logical.len > 3) return error.UnsupportedHy4Affine;
+        const last = logical.len - 1;
+        const width = logical[last];
+        if (width == 0 or width % self.group_size != 0) return error.UnsupportedHy4Affine;
+        var shape: [3]usize = undefined;
+        @memcpy(shape[0..logical.len], logical);
+        shape[last] = try std.math.mul(usize, width, self.bits) / 32;
+        try expect(weights, prefix, name, ".weight", .u32, shape[0..logical.len]);
+        shape[last] = width / self.group_size;
+        try expect(weights, prefix, name, ".scales", .bf16, shape[0..logical.len]);
+        try expect(weights, prefix, name, ".biases", .bf16, shape[0..logical.len]);
+    }
+};
+
+pub const DType = enum { bf16, f32, i32, u32 };
+
+fn expect(weights: anytype, prefix: []const u8, name: []const u8, suffix: []const u8, dtype: DType, shape: []const usize) !void {
+    var name_buffer: [200]u8 = undefined;
+    const full = try std.fmt.bufPrint(&name_buffer, "{s}{s}{s}", .{ prefix, name, suffix });
+    _ = try weights.expect(full, dtype, shape);
+}
+
+fn checkLayerNorms(weights: anytype, layer: []const u8, t: config.Text) !void {
+    for ([_][]const u8{ "input_layernorm", "post_attention_layernorm", "self_attn.post_proj_norm" }) |name| {
+        try expect(weights, layer, name, ".weight", .bf16, &.{t.hidden_size});
+    }
+    try expect(weights, layer, "self_attn.q_a_layernorm", ".weight", .bf16, &.{t.q_lora_rank});
+    try expect(weights, layer, "self_attn.kv_a_layernorm", ".weight", .bf16, &.{t.kv_lora_rank});
+}
+
+fn affineMlp(weights: anytype, layer: []const u8, comptime mlp: []const u8, affine: Affine, h: usize, inner: usize) !void {
+    try affine.check(weights, layer, mlp ++ "gate_proj", &.{ inner, h });
+    try affine.check(weights, layer, mlp ++ "up_proj", &.{ inner, h });
+    try affine.check(weights, layer, mlp ++ "down_proj", &.{ h, inner });
+}
+
+fn checkEngram(weights: anytype, t: config.Text, layer: []const u8, number: u32, affine: Affine) !void {
+    const orders = t.engram_max_ngram_size - 1;
+    const rows = try t.engramRows(number);
+    const head_width = t.engram_n_embed_per_ngram / t.engram_n_head_per_ngram;
+    const input = @as(usize, orders) * t.engram_n_embed_per_ngram;
+    const table_affine: Affine = .{ .bits = affine.bits, .group_size = 32 };
+    try table_affine.check(weights, layer, "engram_layer.multi_head_embedding.embedding", &.{ rows, head_width });
+    try expect(weights, layer, "engram_layer.lookup_table", "", .i32, &.{t.engram_lookup_table_size});
+    try affine.check(weights, layer, "engram_layer.value_proj", &.{ t.hidden_size, input });
+    try expect(weights, layer, "engram_layer.value_proj", ".bias", .bf16, &.{t.hidden_size});
+    try expect(weights, layer, "engram_layer.unified_pre_gamma", "", .bf16, &.{t.hidden_size});
+    for (0..@as(usize, orders) * t.engram_n_head_per_ngram) |head| {
+        var buffer: [68]u8 = undefined;
+        const name = try std.fmt.bufPrint(&buffer, "engram_layer.lookup_per_head_norms.{d}", .{head});
+        try expect(weights, layer, name, ".weight", .bf16, &.{head_width});
+    }
+    for (0..t.hc_mult) |stream| {
+        var buffer: [68]u8 = undefined;
+        const key = try std.fmt.bufPrint(&buffer, "engram_layer.key_projs.{d}", .{stream});
+        try affine.check(weights, layer, key, &.{ t.hidden_size, input });
+        try expect(weights, layer, key, ".bias", .bf16, &.{t.hidden_size});
+        const fields = [_][]const u8{ "norm_key", "norm_query", "unified_per_hc_scales" };
+        for (fields, [_][]const u8{ ".weight", ".weight", "" }) |field, suffix| {
+            const name = try std.fmt.bufPrint(&buffer, "engram_layer.{s}.{d}", .{ field, stream });
+            try expect(weights, layer, name, suffix, .bf16, &.{t.hidden_size});
+        }
+    }
+}
+
+pub fn check(weights: anytype, model: config.Model, bits: u8) !void {
+    try model.validate();
+    const t = model.text_config;
+    const affine: Affine = .{ .bits = bits, .group_size = 64 };
+    const h = t.hidden_size;
+    const hcs = t.hc_mult;
+    try affine.check(weights, "model.", "embed_tokens", &.{ t.vocab_size, h });
+    try affine.check(weights, "", "lm_head", &.{ t.vocab_size, h });
+    try expect(weights, "model.", "norm.weight", "", .bf16, &.{h});
+    try expect(weights, "model.hc_head.", "hc_head_fn", "", .f32, &.{ hcs, @as(usize, hcs) * h });
+    try expect(weights, "model.hc_head.", "hc_head_base", "", .f32, &.{hcs});
+    try expect(weights, "model.hc_head.", "hc_head_scale", "", .f32, &.{1});
+    for (0..t.num_hidden_layers) |index| {
+        var prefix_buffer: [56]u8 = undefined;
+        const layer = try std.fmt.bufPrint(&prefix_buffer, "model.layers.{d}.", .{index});
+        const heads = t.headShape(@intCast(index));
+        const values = @as(usize, heads.heads) * heads.value;
+        try checkLayerNorms(weights, layer, t);
+        try affine.check(weights, layer, "self_attn.q_a_proj", &.{ t.q_lora_rank, h });
+        try affine.check(weights, layer, "self_attn.q_b_proj", &.{ heads.queryRows(), t.q_lora_rank });
+        try affine.check(weights, layer, "self_attn.kv_a_proj_with_mqa", &.{ @as(usize, t.kv_lora_rank) + heads.rotary, h });
+        try affine.check(weights, layer, "self_attn.kv_b_proj", &.{ heads.kvRows(), t.kv_lora_rank });
+        try affine.check(weights, layer, "self_attn.linear_gate", &.{ values, h });
+        try affine.check(weights, layer, "self_attn.o_proj", &.{ h, values });
+        try expect(weights, layer, "self_attn.learnable_sink_param", "", .f32, &.{heads.heads});
+        for ([_][]const u8{ "hc_attn_layer.hc_pre.", "hc_mlp_layer.hc_pre." }) |hc| {
+            try expect(weights, layer, hc, "hc_fn", .f32, &.{ @as(usize, hcs) * 2, @as(usize, hcs) * h });
+            try expect(weights, layer, hc, "hc_base", .f32, &.{@as(usize, hcs) * 2});
+            try expect(weights, layer, hc, "hc_scale", .f32, &.{2});
+        }
+        if (t.layer_types[index] == .deepseek_sparse_attention) {
+            const c = t.compressed_indexer_head_dim;
+            const num_heads = t.compressed_indexer_num_attention_heads;
+            const prefix = "self_attn.compressed_indexer.";
+            try affine.check(weights, layer, prefix ++ "token_key_projection", &.{ c, h });
+            try affine.check(weights, layer, prefix ++ "query_projection", &.{ @as(usize, num_heads) * c, t.q_lora_rank });
+            try affine.check(weights, layer, prefix ++ "head_weight_projection", &.{ num_heads, h });
+            try expect(weights, layer, prefix, "key_value_projection.weight", .f32, &.{ c, c });
+            try expect(weights, layer, prefix, "key_gate_projection.weight", .f32, &.{ c, c });
+            try expect(weights, layer, prefix, "intra_group_ape", .f32, &.{ t.compressed_indexer_compress_ratio, c });
+            try expect(weights, layer, prefix, "key_norm.weight", .f32, &.{c});
+            try expect(weights, layer, prefix, "token_key_norm.weight", .bf16, &.{c});
+        }
+        if (t.mlp_layer_types[index] == .sparse) {
+            const expert = t.n_routed_experts;
+            const inner = t.moe_intermediate_size;
+            const latent = t.routed_expert_hidden_size;
+            try expect(weights, layer, "mlp.gate.weight", "", .bf16, &.{ expert, h });
+            try expect(weights, layer, "mlp.gate.e_score_correction_bias", "", .f32, &.{expert});
+            try affine.check(weights, layer, "mlp.routed_expert_down_proj", &.{ latent, h });
+            try affine.check(weights, layer, "mlp.routed_expert_up_proj", &.{ h, latent });
+            try affine.check(weights, layer, "mlp.experts.gate_up_proj", &.{ expert, @as(usize, inner) * 2, latent });
+            try affine.check(weights, layer, "mlp.experts.down_proj", &.{ expert, latent, inner });
+            try affineMlp(weights, layer, "mlp.shared_experts.", affine, h, @as(usize, inner) * t.n_shared_experts);
+            try expect(weights, layer, "mlp.combine_output_norm", ".weight", .bf16, &.{h});
+        } else {
+            try affineMlp(weights, layer, "mlp.", affine, h, t.intermediate_size);
+            try expect(weights, layer, "mlp.post_fc2_norm", ".weight", .bf16, &.{h});
+        }
+        if (std.mem.indexOfScalar(u32, t.engram_layer_ids, @intCast(index + 1)) != null) {
+            try checkEngram(weights, t, layer, @intCast(index + 1), affine);
+        }
+    }
+
+    try expect(weights, "vit.embeddings.", "patch_embedding.weight", "", .bf16, &.{ model.vision_config.hidden_size, 3, model.vision_config.patch_size, model.vision_config.patch_size });
+    try checkDraft(weights, model);
+}
+
+fn checkDraft(weights: anytype, model: config.Model) !void {
+    const t = model.text_config;
+    const h = t.hidden_size;
+    const inner = model.dfly_intermediate_size orelse try std.math.mul(u32, h, 3);
+    const root = "model.dfly_layers.";
+    const fusion = root ++ "mtp_fusion.";
+    const correction = root ++ "hidden_correction.";
+    try expect(weights, root, "final_norm.weight", "", .bf16, &.{h});
+    try expect(weights, root ++ "confidence_head.", "proj.weight", "", .bf16, &.{ 1, h });
+    try expect(weights, root ++ "confidence_head.", "proj.bias", "", .bf16, &.{1});
+    for ([_][]const u8{ "enorm.weight", "hnorm.weight", "gate" }) |name| {
+        try expect(weights, fusion, name, "", .bf16, &.{h});
+    }
+    try expect(weights, fusion, "eh_proj.weight", "", .bf16, &.{ h, @as(usize, h) * 2 });
+    for ([_][]const u8{ "embed_norm.weight", "hidden_norm.weight" }) |name| {
+        try expect(weights, correction, name, "", .bf16, &.{h});
+    }
+    try expect(weights, correction, "gate_proj.weight", "", .bf16, &.{ h, @as(usize, h) * 2 });
+    try expect(weights, correction, "up_proj.weight", "", .bf16, &.{ h, @as(usize, h) * 2 });
+    try expect(weights, correction, "down_proj.weight", "", .bf16, &.{ h, h });
+    for (model.dfly_target_kv_layers, 0..) |target_layer, draft_layer| {
+        var prefix_buffer: [60]u8 = undefined;
+        const layer = try std.fmt.bufPrint(&prefix_buffer, root ++ "{d}.", .{draft_layer});
+        const heads = t.headShape(target_layer);
+        const channels = @as(usize, heads.heads) * heads.value;
+        try checkLayerNorms(weights, layer, t);
+        try expect(weights, layer, "self_attn.q_a_proj.weight", "", .bf16, &.{ t.q_lora_rank, h });
+        try expect(weights, layer, "self_attn.q_b_proj.weight", "", .bf16, &.{ heads.queryRows(), t.q_lora_rank });
+        try expect(weights, layer, "self_attn.kv_a_proj_with_mqa.weight", "", .bf16, &.{ @as(usize, t.kv_lora_rank) + heads.rotary, h });
+        try expect(weights, layer, "self_attn.kv_b_proj.weight", "", .bf16, &.{ heads.kvRows(), t.kv_lora_rank });
+        try expect(weights, layer, "self_attn.linear_gate.weight", "", .bf16, &.{ channels, h });
+        try expect(weights, layer, "self_attn.o_proj.weight", "", .bf16, &.{ h, channels });
+        try expect(weights, layer, "self_attn.learnable_sink_param", "", .bf16, &.{heads.heads});
+        try expect(weights, layer, "mlp.gate_proj.weight", "", .bf16, &.{ inner, h });
+        try expect(weights, layer, "mlp.up_proj.weight", "", .bf16, &.{ inner, h });
+        try expect(weights, layer, "mlp.down_proj.weight", "", .bf16, &.{ h, inner });
+    }
+}
