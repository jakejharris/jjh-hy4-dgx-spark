index 0000000000000000000000000000000000000000..c46b34cd5e6dea616e63f1b5cb326463b3e1ff5a
--- /dev/null
+++ b/zig/build/hy4_cuda.zig
@@ -0,0 +1,98 @@
+//! Hy4 CUDA tools, native family module, and host checks: full Hy4 oracle runner (`tf-hy4-oracle`),
+//! host tests (`test-hy4-host`), native server registration (`module`), and donor `tf-hy4-cuda-generate`.
+const std = @import("std");
+
+pub fn module(
+    b: *std.Build,
+    target: std.Build.ResolvedTarget,
+    optimize: std.builtin.OptimizeMode,
+    cuda: *std.Build.Module,
+    core: *std.Build.Module,
+    lanes: *std.Build.Module,
+    tp: *std.Build.Module,
+) *std.Build.Module {
+    return b.createModule(.{
+        .root_source_file = b.path("zig/src/families/hy4/hy4.zig"),
+        .target = target,
+        .optimize = optimize,
+        .link_libc = true,
+        .imports = &.{
+            .{ .name = "cuda", .module = cuda },
+            .{ .name = "core", .module = core },
+            .{ .name = "lanes", .module = lanes },
+            .{ .name = "tp", .module = tp },
+        },
+    });
+}
+
+pub fn install(
+    b: *std.Build,
+    target: std.Build.ResolvedTarget,
+    optimize: std.builtin.OptimizeMode,
+    strip: ?bool,
+    cuda: *std.Build.Module,
+    core: *std.Build.Module,
+) void {
+    // Donor Hy4-flash generator kept compiling unchanged.
+    const strip_opt: ?bool = if (strip == true) true else null;
+    const flash_root = b.createModule(.{
+        .root_source_file = b.path("zig/src/families/hy4_flash/cuda_generate.zig"),
+        .target = target,
+        .optimize = optimize,
+        .strip = strip_opt,
+        .link_libc = true,
+        .imports = &.{ .{ .name = "cuda", .module = cuda }, .{ .name = "core", .module = core } },
+    });
+    flash_root.addImport("engram_hash_core", b.createModule(.{
+        .root_source_file = b.path("zig/src/families/deepseek_v41/engram_hash.zig"),
+        .target = target,
+        .optimize = optimize,
+    }));
+    const flash_exe = b.addExecutable(.{ .name = "tf-hy4-cuda-generate", .root_module = flash_root });
+    b.step("hy4-cuda-generate", "Build the Hy4-flash CUDA greedy generator for EXL3 checkpoints").dependOn(&b.addInstallArtifact(flash_exe, .{}).step);
+
+    // Full Hy4 (`hy_v4_vl` / `hy_v4`) layer-streamed CUDA forward and oracle dump CLI.
+    const lanes = b.createModule(.{
+        .root_source_file = b.path("zig/src/core/lanes/lanes.zig"),
+        .target = target,
+        .optimize = optimize,
+        .link_libc = true,
+    });
+    const tp = @import("tp.zig").module(b, target, optimize, cuda);
+    const hy4_root = module(b, target, optimize, cuda, core, lanes, tp);
+    hy4_root.strip = strip_opt;
+    const oracle_exe = b.addExecutable(.{ .name = "tf-hy4-oracle", .root_module = hy4_root });
+    const oracle_install = b.addInstallArtifact(oracle_exe, .{});
+    b.getInstallStep().dependOn(&oracle_install.step);
+    b.step("hy4-oracle", "Build the full Hy4 CUDA layer-streamed forward and oracle dump runner").dependOn(&oracle_install.step);
+}
+
+pub fn tests(b: *std.Build, test_step: *std.Build.Step) void {
+    const host = b.graph.host;
+    const cuda = @import("cuda_runtime.zig").runtime(b, host, .ReleaseSafe, &.{});
+    const tokenizer = b.createModule(.{
+        .root_source_file = b.path("zig/src/core/tokenizer/tokenizer.zig"),
+        .target = host,
+        .link_libc = true,
+    });
+    const core = b.createModule(.{
+        .root_source_file = b.path("zig/src/core/root.zig"),
+        .target = host,
+        .link_libc = true,
+        .imports = &.{
+            .{ .name = "gpu_memory", .module = @import("gpu_memory.zig").module(b, host) },
+            .{ .name = "tokenizer", .module = tokenizer },
+        },
+    });
+    const lanes = b.createModule(.{
+        .root_source_file = b.path("zig/src/core/lanes/lanes.zig"),
+        .target = host,
+        .link_libc = true,
+    });
+    const tp = @import("tp.zig").module(b, host, .ReleaseSafe, cuda);
+    const hy4_mod = module(b, host, .ReleaseSafe, cuda, core, lanes, tp);
+    hy4_mod.addCSourceFile(.{ .file = b.path("zig/kernels/cuda/hy4/vision_pos.h"), .language = .c });
+    const run = b.addRunArtifact(b.addTest(.{ .root_module = hy4_mod }));
+    test_step.dependOn(&run.step);
+    b.step("test-hy4-host", "Full Hy4 config, streaming shard loader, KV pool, native registration, and forward ABI checks").dependOn(&run.step);
+}
