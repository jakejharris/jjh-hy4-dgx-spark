+const direct_load = @import("direct_load.zig");
+const cuda_native = @import("cuda_native.zig");
+const trunk_exl3 = @import("trunk_exl3.zig");
+
+const Uploader = cuda.exl3_upload.Uploader;
+
+const full_cfg_json =
+    \\{"text_config":{"model_type":"hy_v4_vl","hidden_size":6144,"intermediate_size":18432,"moe_intermediate_size":2048,
+    \\"num_hidden_layers":2,"vocab_size":120832,"q_lora_rank":2048,"kv_lora_rank":512,"num_attention_heads":64,
+    \\"qk_nope_head_dim":192,"qk_rope_head_dim":64,"v_head_dim":256,"index_n_heads":32,"index_head_dim":128,
+    \\"index_topk":2048,"indexer_types":["full","full"],"mlp_layer_types":["dense","sparse"],
+    \\"n_routed_experts":256,"n_shared_experts":1,"num_experts_per_tok":8,"tie_word_embeddings":false}}
+;
+
+test "TP=4 verifyPackReassembly and column-slice plan pinning cover all 8 trunk matrices at 3, 4, and 6 bits" {
+    const gpa = std.testing.allocator;
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const dir = try tmp.dir.realPathFileAlloc(io, ".", gpa);
+    defer gpa.free(dir);
+    try tmp.dir.writeFile(io, .{ .sub_path = "config.json", .data = full_cfg_json });
+
+    var prng = std.Random.DefaultPrng.init(20261120);
+    const mul1 = [_]u8{ 0x2D, 0xD1, 0xDC, 0x83 };
