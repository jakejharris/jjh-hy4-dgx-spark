+#include "../exl3_grouped.cuh"
+#include "routed_wide.cuh"
+#include <cooperative_groups.h>
+
+namespace tf_hy4_routed {
+using namespace tf_exl3;
+using namespace tf_hy4_wide;
+constexpr int dims = 6144, inter = 512, slots = 8, max_rows = 8, pitch = 132;
+
+// Rank-local trellises occupy 192 disjoint 8x8-tile patches per projection.
+// Fixture experts may share a trellis pointer within a projection table.
+extern "C" __global__ void __launch_bounds__(256) tf_full_hy4_routed_widen(
+    Word* const* gate, Word* const* up, Word* const* down) {
+    const int expert = blockIdx.y, matrix = blockIdx.z;
+    Word* const* table = matrix == 0 ? gate : (matrix == 1 ? up : down);
+    Word* weight = table[expert];
+    if (__syncthreads_or(threadIdx.x < expert && table[threadIdx.x] == weight)) return;
+    const int nt = (matrix == 2 ? dims : inter) / 16;
+    const int nb = blockIdx.x % (nt / 8), group = blockIdx.x / (nt / 8);
+    const int tile = threadIdx.x / 32, lane = threadIdx.x % 32;
+    Word words[3] = {};
+#pragma unroll
+    for (int h = 0; h < 8; ++h) {
+        const auto* w = reinterpret_cast<const unsigned*>(weight) + ((group * 8 + h) * nt + nb * 8 + tile) * 24;
+        const int wi = lane * 3 / 4, off = lane * 24 % 32;
+        const Word pair = (Word(w[wi]) << 32) | w[min(wi + 1, 23)];
+        const Word c = (pair >> (40 - off)) & 0xffffffu;
+        const int bit = h * 24, i = bit / 64, shift = bit % 64;
+        words[i] |= c << shift;
+        if (shift > 40) words[i + 1] |= c >> (64 - shift);
+    }
+    __syncthreads(); // Every original word in this patch has been read.
+#pragma unroll
+    for (int i = 0; i < 3; ++i) weight[wordOffset(group, nb, nt, tile, i, lane)] = words[i];
+}
+
+struct Fused {
+    const Word* const *gate, *const *up, *const *down;
+    const half *sv_g, *sv_u, *su_d, *sv_d;
+    half *xg, *xu, *xd;
+    const int* ids;
+    const float* weights;
+    float *z, *y, *out;
+    int rows;
+    const __nv_bfloat16* x;
+    const half *su_g, *su_u;
+    int x_stride;
+};
+
+// One block owns 128 output columns of a unique expert. A warp multiplies a
+// 16-column weight tile by up to eight member rows. Its transposed MMA has the
+// same 16 products per step. Each of the four logical K chains starts at zero.
+template<int K, int N, int SK>
+__device__ void project(const Word* w, const half* x, int nb, int split, const int* members, int count,
+                        float* dst, float* partial) {
+    constexpr int chains = 4, physical = 2, steps = K / (SK * chains * 16);
+    const int lane = threadIdx.x % 32, warp = threadIdx.x / 32, tile = warp % 8;
+    const int g = lane / 4, t = lane % 4;
+    const int member = g < count ? members[g] : -1;
+    const auto* row = reinterpret_cast<const unsigned*>(x + max(0, member) * K) + t;
+    float accum[chains / physical][4] = {};
+#pragma unroll
+    for (int part = 0; part < chains / physical; ++part) {
+        const int chain = part * physical + warp / 8;
+        const int begin = (split * chains + chain) * steps;
+        for (int step = begin; step < begin + steps; step += 8) {
+            Word record[3];
+#pragma unroll
+            for (int i = 0; i < 3; ++i) record[i] = __ldg(w + wordOffset(step / 8, nb, N / 16, tile, i, lane));
+            unsigned inputs[8][2];
+#pragma unroll
+            for (int h = 0; h < 8; ++h) {
+                const int at = (step + h) * 8;
+                inputs[h][0] = member < 0 ? 0 : row[at];
+                inputs[h][1] = member < 0 ? 0 : row[at + 4];
+            }
+#pragma unroll
+            for (int h = 0; h < 8; ++h) {
+                unsigned a[4];
+                fragments(chunk(record, h), a);
+                mma16816(accum[part], a, inputs[h]);
+            }
+        }
+    }
+#pragma unroll
+    for (int part = 0; part < chains / physical; ++part) {
+        const int chain = part * physical + warp / 8;
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {
+            const int r = 2 * t + h;
+            if (r < count) {
+                float* p = partial + (chain * count + r) * pitch + tile * 16 + g;
+                p[0] = accum[part][h];
+                p[8] = accum[part][h + 2];
+            }
+        }
+    }
+    __syncthreads();
+    if (warp < count) {
+        const int col = nb * 128 + 4 * lane;
+        float v[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const float* p = partial + warp * pitch + 4 * lane + i;
+            v[i] = p[0];
+#pragma unroll
+            for (int a = 1; a < chains; ++a) v[i] += p[a * count * pitch];
+        }
+        *reinterpret_cast<float4*>(dst + members[warp] * N + col) = make_float4(v[0], v[1], v[2], v[3]);
+    }
+    __syncthreads();
+}
+
+// Prefill uses the same resident format. Consume the original 16-member work
+// descriptors in two eight-row batches, writing split partials for the stock epilogues.
+extern "C" __global__ void __launch_bounds__(512) tf_full_hy4_routed_grouped(GroupedArgs a) {
+    const int u = blockIdx.x;
+    if (u >= a.ucount[0]) return;
+    const int mt = (a.maxm + 15) / 16, tile = blockIdx.z % mt;
+    const int split = (blockIdx.z / mt) % a.sk, mat = blockIdx.z / mt / a.sk;
+    const int e = a.standard ? a.uids[3 * u] : a.uids[u];
+    if (a.standard && e == a.skip) return;
+    const int first = a.standard ? a.uids[3 * u + 1] : u * a.maxm;
+    const int limit = a.standard ? a.uids[3 * u + 2] : a.maxm;
+    __shared__ int members[16];
+    __shared__ float partial[4 * max_rows * pitch];
+    if (threadIdx.x < 16) {
+        const int at = tile * 16 + threadIdx.x;
+        const int code = at < limit ? a.members[first + at] : -1;
+        members[threadIdx.x] = a.standard || code < 0 ? code : (code >> 5) * a.slots + (code & 31);
+    }
+    __syncthreads();
+    const Word* w = reinterpret_cast<const Word*>((mat ? a.tp1 : a.tp0)[e]);
+    const half* x = mat ? a.x1 : a.x0;
+    float* z = a.z + (size_t)(mat * a.sk + split) * a.p * a.n;
+    for (int start = 0; start < 16; start += max_rows) {
+        int count = 0;
+        while (count < max_rows && members[start + count] >= 0) ++count;
+        if (count == 0) break;
+        if (a.mats == 2) project<dims, inter, 4>(w, x, blockIdx.y, split, members + start, count, z, partial);
+        else project<inter, dims, 1>(w, x, blockIdx.y, split, members + start, count, z, partial);
+    }
+}
+
+__device__ void rotateInput(const Fused& a, int p, int col, int e, int lane) {
+    float gate[4], up[4];
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        const float x = __bfloat162float(a.x[(p / slots) * (size_t)a.x_stride + col + j]);
+        gate[j] = x * __half2float(a.su_g[e * dims + col + j]);
+        up[j] = x * __half2float(a.su_u[e * dims + col + j]);
+    }
+    fwht128(gate, lane);
+    fwht128(up, lane);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        a.xg[p * dims + col + j] = __float2half_rn(gate[j] * HAD_SCALE);
+        a.xu[p * dims + col + j] = __float2half_rn(up[j] * HAD_SCALE);
+    }
+}
+
+__device__ __forceinline__ float bf16(float x) { return __bfloat162float(__float2bfloat16_rn(x)); }
+
+__device__ void activate(const Fused& a, int p, int col, int e, int lane) {
+    float g[4] = {}, u[4] = {};
+    const int pairs = a.rows * slots, at = p * inter + col;
+#pragma unroll
+    for (int s = 0; s < 4; ++s)
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            g[j] += a.z[s * pairs * inter + at + j];
+            u[j] += a.z[(4 + s) * pairs * inter + at + j];
+        }
+    fwht128(g, lane);
+    fwht128(u, lane);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        const int k = e * inter + col + j;
+        float gate = bf16(g[j] * HAD_SCALE * __half2float(a.sv_g[k]));
+        float up = bf16(u[j] * HAD_SCALE * __half2float(a.sv_u[k]));
+        gate = gate > 10.f ? 10.f : gate;
+        up = up > 10.f ? 10.f : (up < -10.f ? -10.f : up);
+        g[j] = bf16(bf16(gate / (1.f + expf(-gate))) * up) * __half2float(a.su_d[k]);
+    }
+    fwht128(g, lane);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) a.xd[at + j] = __float2half_rn(g[j] * HAD_SCALE);
+}
+
+// Two independent 128-column tiles per block. Each warp rotates one slot's
+// canonical down partial. The first warp in each tile folds its eight slots in order.
+__device__ void combine(const Fused& a, const int* ids, float* workspace) {
+    constexpr int groups = 2, tiles_per_row = dims / 128;
+    const int lane = threadIdx.x % 32, warp = threadIdx.x / 32;
+    const int group = warp / slots, slot = warp % slots;
+    auto* parts = reinterpret_cast<float4*>(workspace) + group * slots * 32;
+    for (int base = blockIdx.x * groups; base < a.rows * tiles_per_row; base += gridDim.x * groups) {
+        const int tile = base + group, row = tile / tiles_per_row;
+        const int col = (tile % tiles_per_row) * 128 + 4 * lane;
+        const int p = row * slots + slot;
+        float v[4];
+#pragma unroll
+        for (int j = 0; j < 4; ++j) v[j] = __fadd_rn(0.f, a.z[p * dims + col + j]);
+        fwht128(v, lane);
+#pragma unroll
+        for (int j = 0; j < 4; ++j) v[j] = v[j] * HAD_SCALE * __half2float(a.sv_d[ids[p] * dims + col + j]);
+        const float4 out = make_float4(v[0], v[1], v[2], v[3]);
+        *reinterpret_cast<float4*>(a.y + p * dims + col) = out;
+        parts[slot * 32 + lane] = out;
+        __syncthreads();
+        if (slot == 0) {
+            float sum[4] = {};
+#pragma unroll
+            for (int k = 0; k < slots; ++k) {
+                const float4 part = parts[k * 32 + lane];
+                const float weight = a.weights[row * slots + k];
+                sum[0] = fmaf(weight, part.x, sum[0]);
+                sum[1] = fmaf(weight, part.y, sum[1]);
+                sum[2] = fmaf(weight, part.z, sum[2]);
+                sum[3] = fmaf(weight, part.w, sum[3]);
+            }
+#pragma unroll
+            for (int j = 0; j < 4; ++j) a.out[row * dims + col + j] = sum[j];
+        }
+        __syncthreads();
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(512) tf_full_hy4_routed_experts(const Fused a) {
+    __shared__ int ids[64], unique[64], members[64][max_rows], counts[64], total;
+    __shared__ unsigned leaders[2];
+    extern __shared__ float partial[];
+    const auto grid = cooperative_groups::this_grid();
+    const int th = threadIdx.x, lane = th % 32, warp = th / 32, pairs = a.rows * slots;
+    if (th < 64) ids[th] = th < pairs ? a.ids[th] : -1;
+    __syncthreads();
+    if (th < 64) {
+        int first = 0;
+        while (first < th && ids[first] != ids[th]) ++first;
+        const unsigned mask = __ballot_sync(0xffffffffu, th < pairs && first == th);
+        if (lane == 0) leaders[warp] = mask;
+    }
+    __syncthreads();
+    if (th < pairs && ((leaders[warp] >> lane) & 1)) {
+        const int u = __popc(leaders[warp] & ((1u << lane) - 1)) + (warp ? __popc(leaders[0]) : 0);
+        unique[u] = ids[th];
+        int count = 0;
+        for (int p = th; p < pairs && count < a.rows; ++p)
+            if (ids[p] == ids[th]) members[u][count++] = p;
+        counts[u] = count;
+    }
+    if (th == 0) total = __popc(leaders[0]) + __popc(leaders[1]);
+    __syncthreads();
+    constexpr int warps = 16;
+    for (int item = blockIdx.x * warps + warp; item < pairs * 48; item += gridDim.x * warps) {
+        const int p = item / 48;
+        rotateInput(a, p, (item % 48) * 128 + 4 * lane, ids[p], lane);
+    }
+    grid.sync();
+    for (int item = blockIdx.x; item < total * 32; item += gridDim.x) {
+        const int nb = item % 4, split = item / 4 % 4, mat = item / 16 % 2, u = item / 32;
+        const Word* w = (mat ? a.up : a.gate)[unique[u]];
+        project<dims, inter, 4>(w, mat ? a.xu : a.xg, nb, split, members[u], counts[u],
+                                a.z + (mat * 4 + split) * pairs * inter, partial);
+    }
+    grid.sync();
+    for (int item = blockIdx.x * warps + warp; item < pairs * 4; item += gridDim.x * warps) {
+        const int p = item / 4;
+        activate(a, p, item % 4 * 128 + 4 * lane, ids[p], lane);
+    }
+    grid.sync();
+    for (int item = blockIdx.x; item < total * 48; item += gridDim.x) {
+        const int u = item / 48, e = unique[u];
+        project<inter, dims, 1>(a.down[e], a.xd, item % 48, 0, members[u], counts[u], a.z, partial);
+    }
+    grid.sync();
+    combine(a, ids, partial);
+}
+
+// Persistent-style BM=64 prefill routed experts directly over HY4_ROUTED_FAST Word[3] layout.
+// Zero split-K z scratch; fused ACT_BF16 4-cut clamped SwiGLU + Hadamard epilogue; deterministic combine.
+struct PrefillGuArgs {
+    const Word* const *gate;
+    const Word* const *up;
+    const half *xg, *xu;
+    const half *sv_g, *sv_u, *su_d;
+    const int *items, *counts, *members;
+    half *xd;
+};
+
+struct PrefillDnArgs {
+    const Word* const *down;
+    const half *xd;
+    const half *sv_d;
+    const int *items, *counts, *members;
+    __nv_bfloat16 *y_bf16;
+};
+
+extern "C" __global__ void __launch_bounds__(256) tf_full_hy4_routed_prefill_gu(const PrefillGuArgs a) {
+    constexpr int BM = 64, NG = 8, KGRP = dims / 128, NT = inter / 16, LDA = 136, LDE = 132;
+    const int u = blockIdx.x, nb = blockIdx.y;
+    if (u >= a.counts[0]) return;
+    const int e = a.items[3 * u], first = a.items[3 * u + 1], cnt = a.items[3 * u + 2];
+    if (cnt <= 0) return;
+
+    __shared__ int rows_sh[BM];
+    extern __shared__ __align__(16) unsigned char smem[];
+    half *smX0 = reinterpret_cast<half*>(smem);               // [64][136]
+    half *smX1 = smX0 + BM * LDA;                             // [64][136]
+    float *smEpi = reinterpret_cast<float*>(smem);            // [2][16][132] (aliases smX in epilogue)
+
+    const int th = threadIdx.x, warp = th >> 5, lane = th & 31;
+    const int mat = warp >> 2, slice = warp & 3, g = lane >> 2, tt = lane & 3;
+    if (th < BM) rows_sh[th] = th < cnt ? a.members[first + th] : -1;
+    __syncthreads();
+
+    const Word *w = (mat ? a.up : a.gate)[e];
+    const half *smMyX = mat ? smX1 : smX0;
+    float acc[2][NG][4] = {};
+
+    for (int grp = 0; grp < KGRP; ++grp) {
+        const int k0 = grp * 128;
+        // 16-byte vectorized load of Xg and Xu for live rows (64 * 16 = 1024 uint4s per matrix -> 4/thread)
+        for (int idx = th; idx < cnt * 16; idx += 256) {
+            const int r = idx >> 4, c8 = idx & 15;
+            const int p = rows_sh[r];
+            *reinterpret_cast<uint4*>(smX0 + r * LDA + c8 * 8) =
+                *reinterpret_cast<const uint4*>(a.xg + (size_t)p * dims + k0 + c8 * 8);
+            *reinterpret_cast<uint4*>(smX1 + r * LDA + c8 * 8) =
+                *reinterpret_cast<const uint4*>(a.xu + (size_t)p * dims + k0 + c8 * 8);
+        }
+        __syncthreads();
+
+        Word rec[2][3];
+#pragma unroll
+        for (int l = 0; l < 2; ++l) {
+            const int tile = slice * 2 + l;
+#pragma unroll
+            for (int i = 0; i < 3; ++i) rec[l][i] = __ldg(w + wordOffset(grp, nb, NT, tile, i, lane));
+        }
+
+#pragma unroll
+        for (int h = 0; h < 8; ++h) {
+            unsigned af[2][4];
+            fragments(chunk(rec[0], h), af[0]);
+            fragments(chunk(rec[1], h), af[1]);
+#pragma unroll
+            for (int ng = 0; ng < NG; ++ng) {
+                if (ng * 8 < cnt) {
+                    const int rr = ng * 8 + g;
+                    unsigned b[2] = {0u, 0u};
+                    if (rr < cnt) {
+                        const half *xp = smMyX + rr * LDA + h * 16;
+                        b[0] = *reinterpret_cast<const unsigned*>(xp + 2 * tt);
+                        b[1] = *reinterpret_cast<const unsigned*>(xp + 2 * tt + 8);
+                    }
+                    mma16816(acc[0][ng], af[0], b);
+                    mma16816(acc[1][ng], af[1], b);
+                }
+            }
+        }
+        __syncthreads();
+    }
+
+    // Fused epilogue: 4 rounds of 16 rows in smEpi[2][16][132] (fully unrolled so acc stays in registers)
+#pragma unroll
+    for (int rnd = 0; rnd < 4; ++rnd) {
+        const int r_base = rnd * 16;
+        if (r_base < cnt) {
+            const int live = cnt - r_base < 16 ? cnt - r_base : 16;
+#pragma unroll
+            for (int rh = 0; rh < 2; ++rh) {
+                const int ng = rnd * 2 + rh;
+                if (rh * 8 < live) {
+#pragma unroll
+                    for (int l = 0; l < 2; ++l) {
+                        const int col0 = (slice * 2 + l) * 16 + g;
+#pragma unroll
+                        for (int hh = 0; hh < 2; ++hh) {
+                            const int rloc = rh * 8 + 2 * tt + hh;
+                            if (rloc < live) {
+                                float *ep = smEpi + (mat * 16 + rloc) * LDE + col0;
+                                ep[0] = acc[l][ng][hh];
+                                ep[8] = acc[l][ng][hh + 2];
+                            }
+                        }
+                    }
+                }
+            }
+            __syncthreads();
+            for (int rloc = warp; rloc < live; rloc += 8) {
+                const int p = rows_sh[r_base + rloc];
+                const int col = nb * 128 + 4 * lane;
+                float gv[4], uv[4];
+                const float4 gf = *reinterpret_cast<const float4*>(smEpi + rloc * LDE + 4 * lane);
+                const float4 uf = *reinterpret_cast<const float4*>(smEpi + (16 + rloc) * LDE + 4 * lane);
+                gv[0] = gf.x; gv[1] = gf.y; gv[2] = gf.z; gv[3] = gf.w;
+                uv[0] = uf.x; uv[1] = uf.y; uv[2] = uf.z; uv[3] = uf.w;
+                fwht128(gv, lane);
+                fwht128(uv, lane);
+#pragma unroll
+                for (int j = 0; j < 4; ++j) {
+                    const int k = e * inter + col + j;
+                    float gate = bf16(gv[j] * HAD_SCALE * __half2float(__ldg(a.sv_g + k)));
+                    float up = bf16(uv[j] * HAD_SCALE * __half2float(__ldg(a.sv_u + k)));
+                    gate = gate > 10.f ? 10.f : gate;
+                    up = up > 10.f ? 10.f : (up < -10.f ? -10.f : up);
+                    gv[j] = bf16(bf16(gate / (1.f + expf(-gate))) * up) * __half2float(__ldg(a.su_d + k));
+                }
+                fwht128(gv, lane);
+                half2 h0 = __floats2half2_rn(gv[0] * HAD_SCALE, gv[1] * HAD_SCALE);
+                half2 h1 = __floats2half2_rn(gv[2] * HAD_SCALE, gv[3] * HAD_SCALE);
+                uint2 hu;
+                hu.x = *reinterpret_cast<const uint32_t*>(&h0);
+                hu.y = *reinterpret_cast<const uint32_t*>(&h1);
+                *reinterpret_cast<uint2*>(a.xd + (size_t)p * inter + col) = hu;
+            }
+            __syncthreads();
+        }
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(256) tf_full_hy4_routed_prefill_dn(const PrefillDnArgs a) {
+    constexpr int BM = 64, NG = 8, KGRP = inter / 128, NT = dims / 16, LDA = 136, LDE = 132;
+    const int u = blockIdx.x, nb = blockIdx.y;
+    if (u >= a.counts[0]) return;
+    const int e = a.items[3 * u], first = a.items[3 * u + 1], cnt = a.items[3 * u + 2];
+    if (cnt <= 0) return;
+
+    __shared__ int rows_sh[BM];
+    extern __shared__ __align__(16) unsigned char smem[];
+    half *smX = reinterpret_cast<half*>(smem);                // [64][136] = 17,408 B
+    float *smEpi = reinterpret_cast<float*>(smem);            // [16][132] =  8,448 B
+
+    const int th = threadIdx.x, warp = th >> 5, lane = th & 31;
+    const int tile = warp, g = lane >> 2, tt = lane & 3;
+    if (th < BM) rows_sh[th] = th < cnt ? a.members[first + th] : -1;
+    __syncthreads();
+
+    const Word *w = a.down[e];
+    float acc[NG][4] = {};
+
+    for (int grp = 0; grp < KGRP; ++grp) {
+        const int k0 = grp * 128;
+        for (int idx = th; idx < cnt * 16; idx += 256) {
+            const int r = idx >> 4, c8 = idx & 15;
+            const int p = rows_sh[r];
+            *reinterpret_cast<uint4*>(smX + r * LDA + c8 * 8) =
+                *reinterpret_cast<const uint4*>(a.xd + (size_t)p * inter + k0 + c8 * 8);
+        }
+        __syncthreads();
+
+        Word rec[3];
+#pragma unroll
+        for (int i = 0; i < 3; ++i) rec[i] = __ldg(w + wordOffset(grp, nb, NT, tile, i, lane));
+
+#pragma unroll
+        for (int h = 0; h < 8; ++h) {
+            unsigned af[4];
+            fragments(chunk(rec, h), af);
+#pragma unroll
+            for (int ng = 0; ng < NG; ++ng) {
+                if (ng * 8 < cnt) {
+                    const int rr = ng * 8 + g;
+                    unsigned b[2] = {0u, 0u};
+                    if (rr < cnt) {
+                        const half *xp = smX + rr * LDA + h * 16;
+                        b[0] = *reinterpret_cast<const unsigned*>(xp + 2 * tt);
+                        b[1] = *reinterpret_cast<const unsigned*>(xp + 2 * tt + 8);
+                    }
+                    mma16816(acc[ng], af, b);
+                }
+            }
+        }
+        __syncthreads();
+    }
+
+#pragma unroll
+    for (int rnd = 0; rnd < 4; ++rnd) {
+        const int r_base = rnd * 16;
+        if (r_base < cnt) {
+            const int live = cnt - r_base < 16 ? cnt - r_base : 16;
+#pragma unroll
+            for (int rh = 0; rh < 2; ++rh) {
+                const int ng = rnd * 2 + rh;
+                if (rh * 8 < live) {
+                    const int col0 = tile * 16 + g;
+#pragma unroll
+                    for (int hh = 0; hh < 2; ++hh) {
+                        const int rloc = rh * 8 + 2 * tt + hh;
+                        if (rloc < live) {
+                            float *ep = smEpi + rloc * LDE + col0;
+                            ep[0] = acc[ng][hh];
+                            ep[8] = acc[ng][hh + 2];
+                        }
+                    }
+                }
+            }
+            __syncthreads();
+            for (int rloc = warp; rloc < live; rloc += 8) {
+                const int p = rows_sh[r_base + rloc];
+                const int col = nb * 128 + 4 * lane;
+                const float4 vf = *reinterpret_cast<const float4*>(smEpi + rloc * LDE + 4 * lane);
+                float v[4] = {vf.x, vf.y, vf.z, vf.w};
+                fwht128(v, lane);
+#pragma unroll
+                for (int j = 0; j < 4; ++j) v[j] = v[j] * HAD_SCALE * __half2float(__ldg(a.sv_d + (size_t)e * dims + col + j));
+                const __nv_bfloat162 o0 = __floats2bfloat162_rn(v[0], v[1]);
+                const __nv_bfloat162 o1 = __floats2bfloat162_rn(v[2], v[3]);
+                uint2 ou;
+                ou.x = *reinterpret_cast<const uint32_t*>(&o0);
+                ou.y = *reinterpret_cast<const uint32_t*>(&o1);
+                *reinterpret_cast<uint2*>(a.y_bf16 + (size_t)p * dims + col) = ou;
+            }
+            __syncthreads();
+        }
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(256) tf_full_hy4_routed_prefill_combine(
+    const __nv_bfloat16 * __restrict__ y_bf16, const float * __restrict__ weights,
+    float * __restrict__ out, int rows) {
+    const int row = blockIdx.x;
+    const int col = (blockIdx.y * 256 + threadIdx.x) * 4;
+    if (row >= rows || col >= dims) return;
+    float s0 = 0.f, s1 = 0.f, s2 = 0.f, s3 = 0.f;
+#pragma unroll
+    for (int slot = 0; slot < slots; ++slot) {
+        const float w = weights[row * slots + slot];
+        const uint2 u = *reinterpret_cast<const uint2*>(y_bf16 + (size_t)(row * slots + slot) * dims + col);
+        const float2 f0 = __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(&u.x));
+        const float2 f1 = __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(&u.y));
+        s0 = fmaf(w, f0.x, s0);
+        s1 = fmaf(w, f0.y, s1);
+        s2 = fmaf(w, f1.x, s2);
+        s3 = fmaf(w, f1.y, s3);
+    }
+    *reinterpret_cast<float4*>(out + (size_t)row * dims + col) = make_float4(s0, s1, s2, s3);
+}
+} // namespace tf_hy4_routed
