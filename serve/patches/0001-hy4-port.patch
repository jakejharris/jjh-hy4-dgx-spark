+    var lcfg = try lanes.Config.init(std.testing.allocator, .{
+        .fixed_draft_block = true, .plain_guard = true, .copy_drafts = false, .lone_copies = false,
+        .exact_width = cuda_backend.max_window, .mtp = true, .speculate = true, .speculate_early = false,
+        .draft_prior = &draft_policy.default_rates, .drafts = 6, .window_costs = &wc, .window_costs_lone = true,
+        .mtp_step_ms = 0.0, .hidden_rows = true, .batch_rows = cuda_backend.round_rows, .max_streams = 1,
+    }, cuda_backend.max_window, cuda_backend.max_window - 1);
