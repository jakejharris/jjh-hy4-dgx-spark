+            else if (std.mem.eql(u8, arg, "--check-tp4-pack")) check_tp4_pack = val
+            else if (std.mem.eql(u8, arg, "--prompt-safetensors")) prompt_st = val
+            else if (std.mem.eql(u8, arg, "--tokens")) tokens_csv = val
+            else if (std.mem.eql(u8, arg, "--tokens-u32")) tokens_u32 = val
+            else if (std.mem.eql(u8, arg, "--forced-indices")) forced_st = val
+            else if (std.mem.eql(u8, arg, "--inputs")) inputs_arg = val
+            else if (std.mem.eql(u8, arg, "--layer")) layer_arg = try std.fmt.parseInt(usize, val, 10)
+            else if (std.mem.eql(u8, arg, "--end-layer")) end_layer_arg = try std.fmt.parseInt(usize, val, 10)
+            else if (std.mem.eql(u8, arg, "--max-layers")) max_layers = try std.fmt.parseInt(usize, val, 10)
+            else if (std.mem.eql(u8, arg, "--synthetic-len")) synthetic_len = try std.fmt.parseInt(usize, val, 10)
