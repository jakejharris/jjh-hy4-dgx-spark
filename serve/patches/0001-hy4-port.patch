+    var ths: [3]std.Thread = undefined;
+    for (0..3) |ti| ths[ti] = try std.Thread.spawn(.{}, TopPeer.run, .{ l.port, @as(u32, @intCast(ti + 1)), p_vals[ti], p_cols[ti], &p_ids[ti], &p_errs[ti] });
+    var b0 = try tp.Bootstrap.acceptOn(l.fd, 4, 10 * std.time.ns_per_s);
+    defer b0.close();
+    var stripe0: [32]f32 = @splat(-5.0);
+    stripe0[5] = 11.0;
+    const win0 = try boundary.gatherTop1OnBootstrap(&b0, 0, &stripe0, 32, 128);
