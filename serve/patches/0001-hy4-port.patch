+test "directUploadF32 widens multi-chunk O_DIRECT BF16 lm_head on TP=1 and TP=4 without u26 overflow" {
+    const gpa = std.testing.allocator;
+    const io = std.testing.io;
+
+    // 1. Exact 64 MiB chunk step on real 774B lm_head.weight ([120832, 6144] BF16 = 742,391,808 elems).
+    const real_step = try f32StreamStep(stream_chunk_bytes, 120_832 * 6144);
+    try std.testing.expectEqual(@as(usize, 33_554_432), real_step.elems);
+    try std.testing.expectEqual(@as(usize, 67_108_864), real_step.raw_bytes);
+    try std.testing.expectEqual(@as(usize, 134_217_728), real_step.wide_bytes);
+
+    // 2. Live multi-chunk directUploadF32 streaming across 3 O_DIRECT chunks (chunk_bytes = 8192).
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const dir = try tmp.dir.realPathFileAlloc(io, ".", gpa);
+    defer gpa.free(dir);
+
+    try tmp.dir.writeFile(io, .{ .sub_path = "config.json", .data =
+        \\{"text_config":{"model_type":"hy_v4","hidden_size":32,"intermediate_size":64,"moe_intermediate_size":16,
+        \\"num_hidden_layers":1,"vocab_size":512,"q_lora_rank":12,"kv_lora_rank":8,"num_attention_heads":4,
+        \\"qk_nope_head_dim":10,"qk_rope_head_dim":6,"v_head_dim":16,"index_n_heads":4,"index_head_dim":16,
+        \\"index_topk":16,"indexer_types":["full"],"mlp_layer_types":["dense"],
+        \\"n_routed_experts":4,"num_experts_per_tok":2,"tie_word_embeddings":false}}
+    });
+
+    const vocab: usize = 512;
+    const hidden: usize = 32;
+    const lm_bf16 = try gpa.alloc(u16, vocab * hidden); // 16,384 elems = 32,768 bytes (> 8192 chunk_bytes)
+    defer gpa.free(lm_bf16);
+    for (lm_bf16, 0..) |*slot, i| {
+        slot.* = core.quant.convert.bf16(@as(f32, @floatFromInt(@as(i32, @intCast(i % 251)) - 125)) * 0.125);
+    }
+    const hc_fn: [4 * 4 * hidden]f32 = @splat(0.25);
+    const hc_base: [4]f32 = @splat(1.0);
+    const hc_scale: [1]f32 = @splat(1.0);
+    const norm_w: [hidden]u16 = @splat(0x3f80);
+
+    const shard_path = try std.fs.path.join(gpa, &.{ dir, "model.safetensors" });
+    defer gpa.free(shard_path);
+    try core.shard_edit.create(gpa, shard_path, &.{}, &.{
+        .{ .name = "model.hc_head.hc_head_fn", .dtype = .f32, .shape = &.{ 4, 4 * hidden }, .bytes = std.mem.sliceAsBytes(&hc_fn) },
+        .{ .name = "model.hc_head.hc_head_base", .dtype = .f32, .shape = &.{4}, .bytes = std.mem.sliceAsBytes(&hc_base) },
+        .{ .name = "model.hc_head.hc_head_scale", .dtype = .f32, .shape = &.{1}, .bytes = std.mem.sliceAsBytes(&hc_scale) },
+        .{ .name = "model.norm.weight", .dtype = .bf16, .shape = &.{hidden}, .bytes = std.mem.sliceAsBytes(&norm_w) },
+        .{ .name = "lm_head.weight", .dtype = .bf16, .shape = &.{ vocab, hidden }, .bytes = std.mem.sliceAsBytes(lm_bf16) },
+    });
+
+    var idx = try weights.ShardIndex.open(gpa, io, dir);
+    defer idx.deinit();
+    const mock = @import("cache.zig").TestMock;
+
+    // TP=1: 32,768 B BF16 (> 4096 gather_limit_bytes) streams across 4 x 8,192 B O_DIRECT chunks into 65,536 B FP32.
+    {
+        var d = mock.init();
+        const sink_f32 = try gpa.alloc(f32, vocab * hidden);
+        defer gpa.free(sink_f32);
+        @memset(sink_f32, -999.0);
+        mock.sink = std.mem.sliceAsBytes(sink_f32);
+        defer mock.sink = null;
+
+        var pf = DirectPrefetcher.init(gpa, io, &idx);
+        defer pf.deinit();
+        pf.enabled = true;
+        pf.gather_limit_bytes = 4096;
+        pf.chunk_bytes = 8192;
+        var up: Uploader = .{ .d = &d, .gpa = gpa, .max_buffers = 16, .slab = 64 << 10 };
+        defer up.deinit();
+        const head = try pf.loadHead(&up);
+        try std.testing.expectEqual(mock.last_alloc_ptr, head.lm_head_f32);
+        for (lm_bf16, 0..) |u, i| {
+            const want: f32 = @bitCast(@as(u32, u) << 16);
+            try std.testing.expectEqual(want, sink_f32[i]);
+        }
+    }
+
+    // TP=4 rank 2: contiguous [128, 32] BF16 stripe = 8,192 B (> 2048 gather_limit_bytes) streams across 2 x 4,096 B chunks.
+    {
+        var d = mock.init();
+        const r2_elems: usize = 128 * hidden;
+        const sink_r2 = try gpa.alloc(f32, r2_elems);
+        defer gpa.free(sink_r2);
+        @memset(sink_r2, -999.0);
+        mock.sink = std.mem.sliceAsBytes(sink_r2);
+        defer mock.sink = null;
+
+        var pf = DirectPrefetcher.initWithRank(gpa, io, &idx, try ranks.Rank.init(2, 4));
+        defer pf.deinit();
+        pf.enabled = true;
+        pf.gather_limit_bytes = 2048;
+        pf.chunk_bytes = 4096;
+        var up: Uploader = .{ .d = &d, .gpa = gpa, .max_buffers = 16, .slab = 64 << 10 };
+        defer up.deinit();
+        const head = try pf.loadHead(&up);
+        try std.testing.expectEqual(mock.last_alloc_ptr, head.lm_head_f32);
+        const r2_base = 2 * r2_elems;
+        for (0..r2_elems) |i| {
+            const want: f32 = @bitCast(@as(u32, lm_bf16[r2_base + i]) << 16);
+            try std.testing.expectEqual(want, sink_r2[i]);
+        }
+    }
+}
diff --git a/zig/src/families/hy4/draft_policy.zig b/zig/src/families/hy4/draft_policy.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d3ed0a0df6689526a851f7d83145b6622e850ee0
--- /dev/null
+++ b/zig/src/families/hy4/draft_policy.zig
@@ -0,0 +1,599 @@
+//! Swappable DFly2 projection / head-readout quantization seams (`DraftLinear`, `DraftMlp`, `DraftHead`)
+//! over `trunk_exl3.LinearProj`, plus measured row-cost table & adaptive draft-depth policy (`CostParams`,
+//! `DepthTracker`) ported from MIT `kindlingai/gr8` (`engine/runtime/spec_len.h`, `engine/scheduler-rs/src/spec_len.rs`,
+//! and `engine/runtime/s2_batch.h` `DSelTable`; full MIT license notice at end of file).
+//!
+//! Every proposed token is verified by the lossless target pass, so the drafter's 44 projections and proposal
+//! head readout can run EXL3 (`trunk_exl3.LinearProj.exl3`) without changing output distribution.
+const std = @import("std");
+const cuda = @import("cuda");
+const ranks = @import("ranks.zig");
+const boundary = @import("boundary.zig");
+const weights = @import("weights.zig");
+const forward = @import("forward.zig");
+const trunk_exl3 = @import("trunk_exl3.zig");
+
+/// Parses `TF_HY4_DRAFT_MIN_MARGIN` (`null` / `""` / `"0"` / `"off"` / `"none"` -> disabled `null`;
+/// finite `> 0` -> active logit-margin cutoff; negative, non-finite, or malformed -> `error.BadDraftMinMargin`).
+pub fn parseMinMarginStr(raw: []const u8) !?f32 {
+    const s = std.mem.trim(u8, raw, " \t\r\n");
+    if (s.len == 0 or std.ascii.eqlIgnoreCase(s, "off") or std.ascii.eqlIgnoreCase(s, "none") or std.ascii.eqlIgnoreCase(s, "false")) return null;
+    const v = std.fmt.parseFloat(f32, s) catch return error.BadDraftMinMargin;
+    if (!std.math.isFinite(v) or v < 0.0) return error.BadDraftMinMargin;
+    return if (v == 0.0) null else v;
+}
+
+pub fn envMinMargin() !?f32 {
+    const raw = boundary.envStr("TF_HY4_DRAFT_MIN_MARGIN") orelse return null;
+    return parseMinMarginStr(raw);
+}
+
+/// Composition rule between `DepthTracker` (`tracker_depth`) and `TF_HY4_DRAFT_MIN_MARGIN` (`margin_cut_depth`):
+/// the smaller depth wins (`@min`). `DepthTracker` caps how many proposals may be attempted (`ask_depth`);
+/// `TF_HY4_DRAFT_MIN_MARGIN` stops early inside `0..ask_depth` at the first proposal with `top1 - top2 < min_margin`.
+pub fn resolveEffectiveDepth(tracker_depth: usize, margin_cut_depth: usize) usize {
+    return @min(tracker_depth, margin_cut_depth);
+}
+
+pub const max_draft_depth: usize = 15;
+pub const max_verify_rows: usize = 16;
+pub const num_conf_buckets: usize = 8;
+
+/// Conditional acceptance seeds matching `gr8`'s `SpecLen::seed` (`spec_len.h:68`), extended to `max_draft_depth`.
+pub const default_rates = [max_draft_depth]f64{
+    0.75, 0.72, 0.70, 0.70, 0.70, 0.68, 0.68, 0.65, 0.60, 0.55, 0.50, 0.45, 0.40, 0.35, 0.30,
+};
+
+const conf_bucket_edges = [num_conf_buckets - 1]f64{ 0.2, 0.4, 0.6, 0.75, 0.88, 0.95, 0.99 };
+
+pub const DraftLinear = trunk_exl3.LinearProj;
+
+pub const QuantWidthMask = struct {
+    b3: bool = false, b4: bool = false, b6: bool = false, other: bool = false,
+    pub fn note(self: *QuantWidthMask, p: DraftLinear) void {
+        if (p != .exl3) return;
+        switch (p.exl3.weight.halves) {
+            6 => self.b3 = true, 8 => self.b4 = true, 12 => self.b6 = true, else => self.other = true,
+        }
+    }
+    pub fn dflyLabel(self: QuantWidthMask) []const u8 {
+        if (!self.b3 and !self.b4 and !self.b6 and !self.other) return "DFly2 BF16";
+        if (self.b4 and self.b6 and !self.b3 and !self.other) return "DFly2 4b6b";
+        if (self.b4 and !self.b6 and !self.b3 and !self.other) return "DFly2 4-bit";
+        if (self.b6 and !self.b4 and !self.b3 and !self.other) return "DFly2 6-bit";
+        if (self.b3 and !self.b4 and !self.b6 and !self.other) return "DFly2 3-bit";
+        return "DFly2 EXL3";
+    }
+};
+
+pub fn isUnpaddedAlignedBf16(proj: DraftLinear) ?weights.LinearBf16 {
+    return switch (proj) {
+        .bf16 => |b| if (!b.padded) b else null,
+        .exl3 => null,
+    };
+}
+
+pub fn runDraftBf16(proj: DraftLinear, rt: *forward.Runtime, sc: *forward.Scratch, x_bf16: u64, y_bf16: u64, rows: usize) !void {
+    return rt.runProj(sc, x_bf16, proj, y_bf16, rows, false);
+}
+
+pub fn runDraftPartialF32(proj: DraftLinear, rt: *forward.Runtime, sc: *forward.Scratch, x_bf16: u64, y_f32: u64, rows: usize) !void {
+    return rt.runProjRowPartialF32(sc, x_bf16, proj, y_f32, rows);
+}
+
+pub const DraftMlp = struct {
+    gate: DraftLinear = .{ .bf16 = .{} },
+    up: DraftLinear = .{ .bf16 = .{} },
+    down: DraftLinear = .{ .bf16 = .{} },
+
+    pub fn hasExl3(self: DraftMlp) bool {
+        return self.gate == .exl3 or self.up == .exl3 or self.down == .exl3;
+    }
+
+    pub fn reserve(self: DraftMlp, s: *cuda.hy4_ops.ShortTrunk, de: *cuda.exl3.Dense, stream: cuda.Stream) !void {
+        try trunk_exl3.reserveProj(s, de, stream, self.gate);
+        try trunk_exl3.reserveProj(s, de, stream, self.up);
+        try trunk_exl3.reserveProj(s, de, stream, self.down);
+        if (self.gate == .exl3 and self.up == .exl3 and self.gate.exl3.k_pad == self.gate.exl3.k and self.gate.exl3.n_pad == self.gate.exl3.n and self.up.exl3.n_pad == self.up.exl3.n) {
+            try de.reserveGroup(stream, &.{ self.gate.exl3.weight, self.up.exl3.weight });
+        }
+    }
+
+    pub fn runBranch(self: DraftMlp, rt: *forward.Runtime, sc: *forward.Scratch, x_ptr: u64, rows: usize, out_bf16: u64) !void {
+        try rt.runProjPair(sc, x_ptr, self.gate, sc.ff_gate.ptr, false, self.up, sc.ff_up.ptr, false, rows);
+        try rt.runSwigluBf16(sc, sc.ff_gate.ptr, sc.ff_up.ptr, sc.ff_inner.ptr, rows, self.gate.logicalN());
+        try runDraftBf16(self.down, rt, sc, sc.ff_inner.ptr, out_bf16, rows);
+    }
+
+    pub fn runPartialF32(self: DraftMlp, rt: *forward.Runtime, sc: *forward.Scratch, x_ptr: u64, rows: usize, out_f32: u64) !void {
+        if (try trunk_exl3.tryGated(&rt.short_trunk, &rt.exl3_dense, rt.stream, .{ .gate = self.gate, .up = self.up, .down = self.down }, x_ptr, out_f32, rows)) return;
+        try rt.runProjPair(sc, x_ptr, self.gate, sc.ff_gate.ptr, false, self.up, sc.ff_up.ptr, false, rows);
+        try rt.runSwigluBf16(sc, sc.ff_gate.ptr, sc.ff_up.ptr, sc.ff_inner.ptr, rows, self.gate.logicalN());
+        try runDraftPartialF32(self.down, rt, sc, sc.ff_inner.ptr, out_f32, rows);
+    }
+};
+
+pub const DraftHead = union(enum) {
+    shared_f32: weights.HeadWeights,
+    proj: struct {
+        p: trunk_exl3.LinearProj,
+        vocab_local: usize,
+        vocab_pad: usize,
+        vocab_full: usize,
+    },
+
+    pub fn hasExl3(self: DraftHead) bool {
+        return self == .proj and self.proj.p == .exl3;
+    }
+
+    pub fn reserve(self: DraftHead, s: *cuda.hy4_ops.ShortTrunk, de: *cuda.exl3.Dense, stream: cuda.Stream) !void {
+        if (self == .proj) try trunk_exl3.reserveProj(s, de, stream, self.proj.p);
+    }
+
+    pub fn vocabLocal(self: DraftHead) usize {
+        return switch (self) {
+            .shared_f32 => |h| h.vocab_local,
+            .proj => |h| h.vocab_local,
+        };
+    }
+
+    pub fn vocabPad(self: DraftHead) usize {
+        return switch (self) {
+            .shared_f32 => |h| h.vocab_pad,
+            .proj => |h| h.vocab_pad,
+        };
+    }
+
+    pub fn vocabFull(self: DraftHead) usize {
+        return switch (self) {
+            .shared_f32 => |h| h.vocab_full,
+            .proj => |h| h.vocab_full,
+        };
+    }
+
+    pub fn evalLogitsRow(
+        self: DraftHead,
+        rt: *forward.Runtime,
+        msc: *forward.Scratch,
+        readout_bf16: u64,
+        logits_f32_ptr: u64,
+        h: usize,
+    ) !void {
+        switch (self) {
+            .shared_f32 => |hd| {
+                if (hd.lm_head_bf16 != 0) return cuda.hy4_ops.headBf16(&rt.ops, rt.stream, readout_bf16, hd.lm_head_bf16, logits_f32_ptr, 1, hd.vocab_pad, h, hd.vocab_pad);
+                const head_f32 = try rt.widenBf16ToF32(msc, readout_bf16, 1, h);
+                try rt.runVocabF32(head_f32, hd.lm_head_f32, logits_f32_ptr, 1, hd.vocab_pad, hd.vocab_full, h, 0);
+            },
+            .proj => |hd| try runDraftPartialF32(hd.p, rt, msc, readout_bf16, logits_f32_ptr, 1),
+        }
+    }
+};
+
+pub fn quantizeGrid1e4(x: f64) f64 {
+    return if (std.math.isFinite(x)) @round(x * 1e4) / 1e4 else x;
+}
+
+/// Measured 32K-context per-row component table across 78 layers (4-rank TP=4 shapes on GB10),
+/// after removing the two-row cliff (`W1..W7`: `40.63, 55.22, 71.24, 87.87, 99.54, 113.08, 127.15` ms).
+pub const r11_per_row_32k_78l = [7]f64{ 40.63, 55.22, 71.24, 87.87, 99.54, 113.08, 127.15 };
+pub const r11_fixed_bf16_trunk_78l_ms: f64 = 112.1;
+
+/// Scales the measured 32K-context 78-layer TP=4 row-cost table (`r11_per_row_32k_78l` + fixed trunk/head/network pass cost)
+/// to `num_layers` on TP=4 or TP=1.
+pub fn defaultR11CostParams(num_layers: usize, is_tp: bool, draft_round_ms: f64, draft_each_ms: f64) CostParams {
+    const scale = @as(f64, @floatFromInt(@max(num_layers, @as(usize, 1)))) / 78.0;
+    const tp_mul: f64 = if (is_tp) 1.0 else 3.1;
+    const fixed_ms = r11_fixed_bf16_trunk_78l_ms * scale * tp_mul;
+    var rows_ms: [7]f64 = undefined;
+    for (&rows_ms, r11_per_row_32k_78l) |*dst, comp_ms| {
+        dst.* = @max(0.05, fixed_ms + comp_ms * scale * tp_mul);
+    }
+    return CostParams.fromTable(&rows_ms, draft_round_ms, draft_each_ms) catch
+        CostParams.fromLinear(rows_ms[0], 14.42 * scale * tp_mul, draft_round_ms, draft_each_ms);
+}
+
+/// Measured row-cost table (`verify_ms_by_rows[rows - 1]` for `rows = 1..max_verify_rows`), plus `draft_round_ms`
+/// (5-block DFly2 body + first readout) and `draft_each_ms` (each extra `hidden_correction` + `lm_head` readout),
+/// following `gr8`'s `SpecLen::table` (`spec_len.h:67`) and `DSelTable` (`s2_batch.h:259-332`).
+pub const CostParams = struct {
+    verify_ms_by_rows: [max_verify_rows]f64,
+    draft_round_ms: f64,
+    draft_each_ms: f64,
+    plain_margin: f64 = 1.02,
+
+    pub fn fromLinear(step_ms: f64, extra_row_ms: f64, draft_block_ms: f64, draft_readout_ms: f64) CostParams {
+        var v: [max_verify_rows]f64 = undefined;
+        for (&v, 0..) |*slot, k| {
+            slot.* = quantizeGrid1e4(@max(1e-3, step_ms + @as(f64, @floatFromInt(k)) * extra_row_ms));
+        }
+        return .{
+            .verify_ms_by_rows = v,
+            .draft_round_ms = quantizeGrid1e4(@max(0.0, draft_block_ms + draft_readout_ms)),
+            .draft_each_ms = quantizeGrid1e4(@max(0.0, draft_readout_ms)),
+        };
+    }
+
+    pub fn fromTable(verify_rows_ms: []const f64, draft_round_ms: f64, draft_each_ms: f64) !CostParams {
+        if (verify_rows_ms.len == 0 or verify_rows_ms.len > max_verify_rows) return error.BadCostTable;
+        var v: [max_verify_rows]f64 = undefined;
+        for (verify_rows_ms, 0..) |x, i| {
+            if (!std.math.isFinite(x) or x <= 0) return error.BadCostTable;
+            v[i] = quantizeGrid1e4(x);
+        }
+        const slope = if (verify_rows_ms.len >= 2)
+            @max(0.0, v[verify_rows_ms.len - 1] - v[verify_rows_ms.len - 2])
+        else
+            0.2 * v[0];
+        for (verify_rows_ms.len..max_verify_rows) |i| {
+            v[i] = quantizeGrid1e4(@max(1e-3, v[i - 1] + slope));
+        }
+        if (!std.math.isFinite(draft_round_ms) or draft_round_ms < 0 or !std.math.isFinite(draft_each_ms) or draft_each_ms < 0)
+            return error.BadCostTable;
+        return .{
+            .verify_ms_by_rows = v,
+            .draft_round_ms = quantizeGrid1e4(draft_round_ms),
+            .draft_each_ms = quantizeGrid1e4(draft_each_ms),
+        };
+    }
+
+    /// Parses `gr8`'s `DSelTable` key:value or key=value syntax (`v1:39.44,v2:94.41,...,d:7.0,e:0.5`),
+    /// env-file assignment lines (`TF_HY4_ROW_COST_TABLE=...` with `#` comments), or plain CSV `m1,m2,...,mK`.
+    pub fn parseTableSpec(text: []const u8, default_draft_round_ms: f64, default_draft_each_ms: f64) !CostParams {
+        var cleaned_buf: [4096]u8 = undefined;
+        var clen: usize = 0;
+        var lines = std.mem.splitScalar(u8, text, '\n');
+        while (lines.next()) |raw_line| {
+            const no_comment = if (std.mem.indexOfScalar(u8, raw_line, '#')) | idx | raw_line[0..idx] else raw_line;
+            var line = std.mem.trim(u8, no_comment, " \t\r");
+            if (line.len == 0) continue;
+            if (std.mem.startsWith(u8, line, "export ")) line = std.mem.trim(u8, line["export ".len..], " \t");
+            if (std.mem.startsWith(u8, line, "TF_HY4_ROW_COST_TABLE=")) line = std.mem.trim(u8, line["TF_HY4_ROW_COST_TABLE=".len..], " \t");
+            if (line.len >= 2 and (line[0] == '"' or line[0] == '\'') and line[line.len - 1] == line[0]) line = line[1 .. line.len - 1];
+            if (line.len == 0) continue;
+            if (clen + line.len + 1 > cleaned_buf.len) return error.BadCostTable;
+            if (clen > 0) { cleaned_buf[clen] = ','; clen += 1; }
+            @memcpy(cleaned_buf[clen..][0..line.len], line);
+            clen += line.len;
+        }
+        const cleaned = cleaned_buf[0..clen];
+        if (cleaned.len == 0) return error.BadCostTable;
+
+        if (std.mem.indexOfAny(u8, cleaned, ":=") == null) {
+            var vals: [max_verify_rows]f64 = undefined;
+            var n: usize = 0;
+            var it = std.mem.tokenizeAny(u8, cleaned, ", \t\r\n");
+            while (it.next()) |tok| {
+                if (n >= max_verify_rows) return error.BadCostTable;
+                vals[n] = std.fmt.parseFloat(f64, tok) catch return error.BadCostTable;
+                n += 1;
+            }
+            return fromTable(vals[0..n], default_draft_round_ms, default_draft_each_ms);
+        }
+
+        var have: [max_verify_rows]bool = @splat(false);
+        var v: [max_verify_rows]f64 = @splat(0);
+        var d_round: f64 = default_draft_round_ms;
+        var d_each: f64 = default_draft_each_ms;
+        var margin: f64 = 1.02;
+
+        var it = std.mem.tokenizeAny(u8, cleaned, ",;\r\n");
+        while (it.next()) |raw_item| {
+            const item = std.mem.trim(u8, raw_item, " \t");
+            if (item.len == 0) continue;
+            const sep = std.mem.indexOfAny(u8, item, ":=") orelse return error.BadCostTable;
+            const key = std.mem.trim(u8, item[0..sep], " \t");
+            const val_str = std.mem.trim(u8, item[sep + 1 ..], " \t");
+            const val = quantizeGrid1e4(std.fmt.parseFloat(f64, val_str) catch return error.BadCostTable);
+            if (!std.math.isFinite(val) or val < 0) return error.BadCostTable;
+            if (key.len >= 2 and (key[0] == 'v' or key[0] == 'w')) {
+                const r = std.fmt.parseInt(usize, key[1..], 10) catch return error.BadCostTable;
+                if (r < 1 or r > max_verify_rows or val <= 0) return error.BadCostTable;
+                v[r - 1] = val;
+                have[r - 1] = true;
+            } else if (std.mem.eql(u8, key, "d") or std.mem.eql(u8, key, "draft_round_ms")) {
+                d_round = val;
+            } else if (std.mem.eql(u8, key, "e") or std.mem.eql(u8, key, "draft_each_ms")) {
+                d_each = val;
+            } else if (std.mem.eql(u8, key, "margin") or std.mem.eql(u8, key, "plain_margin")) {
+                margin = @max(1.0, val);
+            } else return error.BadCostTable;
+        }
+
+        var given: [max_verify_rows]usize = undefined;
+        var gn: usize = 0;
+        for (0..max_verify_rows) |idx| if (have[idx]) {
+            given[gn] = idx;
+            gn += 1;
+        };
+        if (gn < 2) return error.BadCostTable;
+        for (0..max_verify_rows) |r| {
+            if (have[r]) continue;
+            var j: usize = 1;
+            while (j + 1 < gn and given[j] < r) : (j += 1) {}
+            const lo = given[j - 1];
+            const hi = given[j];
+            const frac = (@as(f64, @floatFromInt(@as(isize, @intCast(r)) - @as(isize, @intCast(lo))))) /
+                @as(f64, @floatFromInt(hi - lo));
+            v[r] = quantizeGrid1e4(v[lo] + (v[hi] - v[lo]) * frac);
+            if (v[r] <= 0) return error.BadCostTable;
+        }
+        var out = try fromTable(&v, d_round, d_each);
+        out.plain_margin = margin;
+        return out;
+    }
+
+    /// Accepts either an inline spec (`v1:...,v2:...,d:...,e:...` or CSV) or a file path (`@/path/file` or `/path/file`).
+    pub fn parseSpecOrFile(gpa: std.mem.Allocator, io: std.Io, raw: []const u8, default_draft_round_ms: f64, default_draft_each_ms: f64) !CostParams {
+        const trimmed = std.mem.trim(u8, raw, " \t\r\n");
+        if (trimmed.len == 0) return error.BadCostTable;
+        const explicit_file = trimmed[0] == '@';
+        const cand_path = if (explicit_file) std.mem.trim(u8, trimmed[1..], " \t") else trimmed;
+        const looks_like_path = explicit_file or (std.mem.indexOfScalar(u8, cand_path, ',') == null and
+            (std.mem.indexOfScalar(u8, cand_path, '/') != null or std.mem.endsWith(u8, cand_path, ".env") or
+            std.mem.endsWith(u8, cand_path, ".txt") or std.mem.endsWith(u8, cand_path, ".cfg") or
+            std.mem.endsWith(u8, cand_path, ".csv") or std.mem.endsWith(u8, cand_path, ".table")));
+        if (looks_like_path) {
+            const bytes = std.Io.Dir.cwd().readFileAlloc(io, cand_path, gpa, .limited(64 << 10)) catch |err| {
+                return if (explicit_file or std.mem.indexOfScalar(u8, cand_path, ':') == null) error.BadCostTable else err;
+            };
+            defer gpa.free(bytes);
+            return parseTableSpec(bytes, default_draft_round_ms, default_draft_each_ms);
+        }
+        return parseTableSpec(trimmed, default_draft_round_ms, default_draft_each_ms);
+    }
+
+    pub fn verifyMs(self: CostParams, rows: usize) f64 {
+        if (rows == 0) return 0.0;
+        return @max(1e-3, self.verify_ms_by_rows[@min(rows, max_verify_rows) - 1]);
+    }
+
+    pub fn draftMs(self: CostParams, depth: usize) f64 {
+        if (depth == 0) return 0.0;
+        return self.draft_round_ms + self.draft_each_ms * @as(f64, @floatFromInt(depth - 1));
+    }
+
+    pub fn roundMs(self: CostParams, depth: usize) f64 {
+        if (depth == 0) return self.verifyMs(1);
+        return @max(1e-3, self.verifyMs(depth + 1) + self.draftMs(depth));
+    }
+
+    pub fn chooseDepth(
+        self: CostParams,
+        rates: []const f64,
+        max_depth: usize,
+        allow_zero: bool,
+    ) struct { depth: usize, expected_tokens: f64, expected_ms: f64 } {
+        const cap = @min(max_depth, @min(max_draft_depth, max_verify_rows - 1));
+        if (cap == 0) return .{ .depth = 0, .expected_tokens = 1.0, .expected_ms = self.roundMs(0) };
+
+        var best_d: usize = if (allow_zero) 0 else 1;
+        var best_toks: f64 = 1.0;
+        var best_ms: f64 = self.roundMs(0);
+        var best_rate: f64 = if (allow_zero) (self.plain_margin / best_ms) else -1.0;
+
+        var expected: f64 = 1.0;
+        var chain: f64 = 1.0;
+        for (1..cap + 1) |d| {
+            const p = if (d - 1 < rates.len) rates[d - 1] else rates[rates.len - 1];
+            chain *= std.math.clamp(p, 0.0, 1.0);
+            expected += chain;
+            const ms = self.roundMs(d);
+            const rate = expected / ms;
+            if (rate > best_rate * (1.0 + 1e-9)) {
+                best_rate = rate;
+                best_d = d;
+                best_toks = expected;
+                best_ms = ms;
+            }
+        }
+        return .{ .depth = best_d, .expected_tokens = best_toks, .expected_ms = best_ms };
+    }
+};
+
+/// Port of `gr8`'s `g6rt::SpecLen` (`spec_len.h:59-186`): decayed pseudo-count shrinkage (`prior = 4`,
+/// `pos_decay = 0.9`, `bucket_decay = 0.998`), censored prefix updates, sequential `more()`, and `FNV-1a` hash.
+pub const DepthTracker = struct {
+    seed: [max_draft_depth]f64 = default_rates,
+    pn: [max_draft_depth]f64 = @splat(0.0),
+    pk: [max_draft_depth]f64 = @splat(0.0),
+    bn: [max_draft_depth][num_conf_buckets]f64 = @splat(@splat(0.0)),
+    bk: [max_draft_depth][num_conf_buckets]f64 = @splat(@splat(0.0)),
+    pos_decay: f64 = 0.96,
+    bucket_decay: f64 = 0.998,
+    prior: f64 = 2.0,
+    probe_every: u64 = 8,
+    rounds: u64 = 0,
+    plain_streak: u64 = 0,
+
+    pub fn bucket(lp: f32) usize {
+        if (!std.math.isFinite(lp)) return 0;
+        const p = @exp(@as(f64, lp));
+        var b: usize = 0;
+        while (b < num_conf_buckets - 1 and p >= conf_bucket_edges[b]) : (b += 1) {}
+        return b;
+    }
+
+    pub fn rate(self: *const DepthTracker, j: usize) f64 {
+        return (self.pk[j] + self.prior * self.seed[j]) / (self.pn[j] + self.prior);
+    }
+
+    pub fn cond(self: *const DepthTracker, j: usize, lp: f32) f64 {
+        const r = self.rate(j);
+        if (std.math.isNan(lp)) return r;
+        const b = bucket(lp);
+        var n: f64 = 0;
+        var k: f64 = 0;
+        for (0..max_draft_depth) |i| {
+            n += self.bn[i][b];
+            k += self.bk[i][b];
+        }
+        const pool = (k + self.prior * r) / (n + self.prior);
+        return (self.bk[j][b] + self.prior * pool) / (self.bn[j][b] + self.prior);
+    }
+
+    pub fn currentRates(self: *const DepthTracker) [max_draft_depth]f64 {
+        var r: [max_draft_depth]f64 = undefined;
+        for (&r, 0..) |*dst, j| dst.* = self.rate(j);
+        return r;
+    }
+
+    pub fn nextDepth(self: *DepthTracker, costs: CostParams, max_depth: usize) usize {
+        if (max_depth == 0) return 0;
+        const r = self.currentRates();
+        const pick = costs.chooseDepth(&r, max_depth, true);
+        self.rounds += 1;
+        if (pick.depth == 0) {
+            self.plain_streak += 1;
+            if (self.probe_every > 0 and self.plain_streak >= self.probe_every) {
+                self.plain_streak = 0;
+                // Probe at the best positive depth (skips any 2-row cliff when d=2..3 is cheaper per token!).
+                return costs.chooseDepth(&r, max_depth, false).depth;
+            }
+            return 0;
+        }
+        self.plain_streak = 0;
+        return pick.depth;
+    }
+
+    /// `gr8` `SpecLen::more`: after sequentially reading out `n` drafts with `lp[0..n]`, returns whether reading
+    /// out additional drafts up to `max_depth` improves expected tokens/ms over stopping at `1..n`.
+    pub fn more(self: *const DepthTracker, costs: CostParams, lp: []const f32, n: usize, max_depth: usize) bool {
+        const cap = @min(max_depth, @min(max_draft_depth, max_verify_rows - 1));
+        if (n >= cap) return false;
+        var best_now: f64 = 0.0;
+        var e_now: f64 = 1.0;
+        var s_now: f64 = 1.0;
+        for (1..n + 1) |k| {
+            s_now *= self.cond(k - 1, if (k - 1 < lp.len) lp[k - 1] else std.math.nan(f32));
+            e_now += s_now;
+            const ratio_k = e_now / (costs.verifyMs(k + 1) + costs.draftMs(n));
+            if (ratio_k > best_now) best_now = ratio_k;
+        }
+        var e_next = e_now;
+        var s_next = s_now;
+        for (n + 1..cap + 1) |next_k| {
+            s_next *= self.rate(next_k - 1);
+            e_next += s_next;
+            if (e_next / costs.roundMs(next_k) > best_now) return true;
+        }
+        return false;
+    }
+
+    pub fn observe(self: *DepthTracker, offered: usize, accepted: usize) void {
+        self.observeWithLp(offered, accepted, null);
+    }
+
+    pub fn observeWithLp(self: *DepthTracker, offered: usize, accepted: usize, lp_opt: ?[]const f32) void {
+        const lim = @min(@min(offered, accepted + 1), max_draft_depth);
+        for (0..lim) |j| {
+            const acc: f64 = if (j < accepted) 1.0 else 0.0;
+            self.pn[j] = self.pn[j] * self.pos_decay + 1.0;
+            self.pk[j] = self.pk[j] * self.pos_decay + acc;
+            if (lp_opt) |lps| if (j < lps.len and std.math.isFinite(lps[j])) {
+                const b = bucket(lps[j]);
+                self.bn[j][b] = self.bn[j][b] * self.bucket_decay + 1.0;
+                self.bk[j][b] = self.bk[j][b] * self.bucket_decay + acc;
+            };
+        }
+    }
+
+    /// `gr8` `SpecLen::hash` (`FNV-1a` over little-endian `lp[0..n]` and `chosen_k` for cross-rank lockstep checks).
+    pub fn decisionHash(lp_opt: ?[]const f32, chosen_k: u32) u32 {
+        var h: u32 = 2166136261;
+        if (lp_opt) |lps| for (lps) |x| {
+            var le = std.mem.nativeToLittle(u32, @bitCast(x));
+            for (std.mem.asBytes(&le)) |byte| h = (h ^ byte) *% 16777619;
+        };
+        var k_le = std.mem.nativeToLittle(u32, chosen_k);
+        for (std.mem.asBytes(&k_le)) |byte| h = (h ^ byte) *% 16777619;
+        return h;
+    }
+};
+
+test "gr8 SpecLen + measured 32K-context 78-layer TP=4 row-cost table select prose depth 2..3, code depth 4..6, and hash deterministically" {
