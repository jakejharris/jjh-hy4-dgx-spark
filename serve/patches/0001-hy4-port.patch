+    const r11_78l = defaultR11CostParams(78, true, 8.0, 0.5);
+    try std.testing.expectApproxEqAbs(@as(f64, 152.73), r11_78l.verifyMs(1), 1e-3);
+    try std.testing.expectApproxEqAbs(@as(f64, 167.32), r11_78l.verifyMs(2), 1e-3);
+    try std.testing.expectApproxEqAbs(@as(f64, 183.34), r11_78l.verifyMs(3), 1e-3);
+
+    const prose_rates = [_]f64{ 0.62, 0.52, 0.42, 0.35, 0.30, 0.25 };
