+test "hy4-exl3-trunk-v1 sidecar overlay keeps lossless default untouched, prunes shadowed .weight, and rejects missing profile" {
+    const gpa = std.testing.allocator;
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const dir = try tmp.dir.realPathFileAlloc(io, ".", gpa);
+    defer gpa.free(dir);
+
+    try tmp.dir.writeFile(io, .{ .sub_path = "config.json", .data =
+        \\{"text_config":{"model_type":"hy_v4","hidden_size":128,"intermediate_size":256,"moe_intermediate_size":128,
+        \\"num_hidden_layers":1,"vocab_size":128,"q_lora_rank":128,"kv_lora_rank":64,"num_attention_heads":4,
+        \\"qk_nope_head_dim":16,"qk_rope_head_dim":16,"v_head_dim":32,"index_n_heads":4,"index_head_dim":32,
+        \\"index_topk":16,"indexer_types":["full"],"mlp_layer_types":["dense"],
+        \\"n_routed_experts":4,"num_experts_per_tok":2,"tie_word_embeddings":false}}
+    });
+
+    // Base MODEL_DIR has lossless BF16 q_a_proj.weight ([128, 128] BF16 = 32,768 B) + lm_head.weight ([128, 128] BF16 = 32,768 B -> 65,536 B FP32).
+    const bf16_w: [128 * 128 * 2]u8 = @splat(0x3c);
+    const base_shard = try std.fs.path.join(gpa, &.{ dir, "model.layers.0.safetensors" });
+    defer gpa.free(base_shard);
+    try core.shard_edit.create(gpa, base_shard, &.{}, &.{
+        .{ .name = "model.layers.0.self_attn.q_a_proj.weight", .dtype = .bf16, .shape = &.{ 128, 128 }, .bytes = &bf16_w },
+        .{ .name = "lm_head.weight", .dtype = .bf16, .shape = &.{ 128, 128 }, .bytes = &bf16_w },
+    });
+    try tmp.dir.writeFile(io, .{ .sub_path = "model.safetensors.index.json", .data =
+        \\{"weight_map":{
+        \\  "model.layers.0.self_attn.q_a_proj.weight":"model.layers.0.safetensors",
+        \\  "lm_head.weight":"model.layers.0.safetensors"
+        \\}}
+    });
+
+    // Sidecar MODEL_DIR/trunk-4b/ has EXL3 4-bit q_a_proj (trellis [8, 8, 64] I16 = 8,192 B + suh 256 B + svh 256 B + mul1 4 B = 8,708 B).
+    try tmp.dir.createDirPath(io, "trunk-4b");
+    const tr_4b: [8 * 8 * 64 * 2]u8 = @splat(0x11);
+    const sc_f16: [128 * 2]u8 = @splat(0x3c);
+    const mul1 = [_]u8{ 0x2D, 0xD1, 0xDC, 0x83 };
+    const side_shard = try std.fs.path.join(gpa, &.{ dir, "trunk-4b", "model.layers.0.safetensors" });
+    defer gpa.free(side_shard);
+    try core.shard_edit.create(gpa, side_shard, &.{}, &.{
+        .{ .name = "model.layers.0.self_attn.q_a_proj.mul1", .dtype = .i32, .shape = &.{}, .bytes = &mul1 },
+        .{ .name = "model.layers.0.self_attn.q_a_proj.trellis", .dtype = .i16, .shape = &.{ 8, 8, 64 }, .bytes = &tr_4b },
+        .{ .name = "model.layers.0.self_attn.q_a_proj.suh", .dtype = .f16, .shape = &.{128}, .bytes = &sc_f16 },
+        .{ .name = "model.layers.0.self_attn.q_a_proj.svh", .dtype = .f16, .shape = &.{128}, .bytes = &sc_f16 },
+    });
+    try tmp.dir.writeFile(io, .{ .sub_path = "trunk-4b/trunk.index.json", .data =
+        \\{"weight_map":{
+        \\  "model.layers.0.self_attn.q_a_proj.mul1":"model.layers.0.safetensors",
+        \\  "model.layers.0.self_attn.q_a_proj.trellis":"model.layers.0.safetensors",
+        \\  "model.layers.0.self_attn.q_a_proj.suh":"model.layers.0.safetensors",
+        \\  "model.layers.0.self_attn.q_a_proj.svh":"model.layers.0.safetensors"
+        \\}}
+    });
+
+    // 1. Default open (no --trunk / TF_HY4_TRUNK) ignores trunk-4b/ completely!
+    var idx_lossless = try weights.ShardIndex.openWithTrunk(gpa, io, dir, null, null);
+    defer idx_lossless.deinit();
+    try std.testing.expectEqualStrings("", idx_lossless.trunk_tag);
+    try std.testing.expect(idx_lossless.has("model.layers.0.self_attn.q_a_proj.weight"));
+    try std.testing.expect(!idx_lossless.has("model.layers.0.self_attn.q_a_proj.trellis"));
+
+    // 2. Selecting "4b" (or opening dir/trunk-4b directly) overlays trunk-4b and prunes shadowed .weight!
+    var idx_4b = try weights.ShardIndex.openWithTrunk(gpa, io, dir, null, "4b");
+    defer idx_4b.deinit();
+    try std.testing.expectEqualStrings("profile:trunk-4b", idx_4b.trunk_tag);
+    try std.testing.expect(!idx_4b.has("model.layers.0.self_attn.q_a_proj.weight"));
+    try std.testing.expect(idx_4b.has("model.layers.0.self_attn.q_a_proj.trellis"));
+    try std.testing.expect(idx_4b.has("lm_head.weight"));
+
+    const sub_dir = try std.fs.path.join(gpa, &.{ dir, "trunk-4b" });
+    defer gpa.free(sub_dir);
+    var idx_direct = try weights.ShardIndex.openWithTrunk(gpa, io, sub_dir, null, null);
+    defer idx_direct.deinit();
+    try std.testing.expectEqualStrings("profile:trunk-4b", idx_direct.trunk_tag);
+    try std.testing.expect(idx_direct.has("lm_head.weight"));
+    try std.testing.expect(idx_direct.has("model.layers.0.self_attn.q_a_proj.trellis"));
+
+    // 3. Placement bytes drop by 32,768 - 8,708 = 24,060 B, and pack SHA-256 differs between lossless and 4b!
+    const b_lossless = try cuda_native.hy4PlacementWeightBytesIndex(gpa, io, &idx_lossless, 1, 0);
+    const b_4b = try cuda_native.hy4PlacementWeightBytesIndex(gpa, io, &idx_4b, 1, 0);
+    try std.testing.expectEqual(@as(u64, 32768 + 65536), b_lossless);
+    try std.testing.expectEqual(@as(u64, 8708 + 65536), b_4b);
+
+    const d_lossless = try boundary.computePackDigest(gpa, io, &idx_lossless);
+    const d_4b = try boundary.computePackDigest(gpa, io, &idx_4b);
+    try std.testing.expect(!std.mem.eql(u8, &d_lossless, &d_4b));
+
+    // 4. DirectPrefetcher gathers ONLY the overlay tensors for layer 0, never the shadowed BF16 .weight!
+    var pf = direct_load.DirectPrefetcher.init(gpa, io, &idx_4b);
+    defer pf.deinit();
+    try pf.startLayerPrefetch(0);
+    try pf.pair.wait();
+    pf.active_slot = 1 - pf.active_slot;
+    try pf.slots[pf.active_slot].indexCopies(gpa);
+    try std.testing.expect(pf.slots[pf.active_slot].copies.get("model.layers.0.self_attn.q_a_proj.weight") == null);
+    try std.testing.expect(pf.slots[pf.active_slot].copies.get("model.layers.0.self_attn.q_a_proj.trellis") != null);
+
+    // 5. Missing profile fails closed with error.MissingHy4TrunkProfile (with user-facing explanation).
+    try std.testing.expectError(error.MissingHy4TrunkProfile, weights.ShardIndex.openWithTrunk(gpa, io, dir, null, "9b"));
+    try std.testing.expect(cuda_native.native.explain(null, error.MissingHy4TrunkProfile) != null);
+}
