+
+    var d_tp = mock.init();
+    var tp_sc = try Scratch.initWith(&d_tp, real_cfg, 1024, .{ .logits_rows = 1, .single_layer_cache_cap = 0, .rank = try ranks.Rank.init(1, 4) });
