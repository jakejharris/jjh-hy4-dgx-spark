+        defer t.allocator.free(expected);
+        try t.expectEqualSlices(u8, expected, try self.rig.bytes(routed, expected.len));
+        try cuda.hy4_ops.addExpertPartial(self.k, self.rig.s, routed, shared, self.partial.ptr, 48 * D);
+        try self.fold(48);
+        try self.equal("moe", 48, 48);
+        if (self.rank == .zero) try cuda.hy4_ops.addExpertPartial(self.k, self.rig.s, self.partial.ptr, shared, self.partial.ptr, 48 * D);
+        try self.fold(48);
+        try self.equal("moe-double-shared", 48, 48);
+        const shared_changed = try self.reference("moe", 48, 48);
+        std.debug.print("CONTROL doubled_shared folded_changed={d}/{d}\n", .{ shared_changed, 48 * D });
+        try t.expectEqual(@as(usize, 292619), shared_changed);
+        try cuda.hy4_ops.addExpertPartial(self.k, self.rig.s, routed, shared, self.partial.ptr, 48 * D);
+        var row: usize = 48;
+        while (row < 2048) : (row += 48) try self.partial.copyFrom(row * D * 4, self.partial.ptr, @min(48, 2048 - row) * D * 4, self.rig.s.handle);
+        try self.fold(1);
+        try self.equal("moe", 48, 1);
+        try self.fold(2048);
+        try self.equal("moe", 48, 2048);
+        try self.link.check();
+        self.rig.reset();
+    }
+
+    fn writeBoundary(self: *Worker, fused: bool, w: cuda.hy4_ops.IhcWrite) !void {
+        if (fused) {
+            const used = try self.link.tryFoldWrite(self.rig.s, 1, .{
+                .partial = .{ .ptr = self.partial.ptr, .bytes = self.partial.len },
+                .gathered = .{ .ptr = self.all.ptr, .bytes = self.all.len },
+                .branch = .{ .ptr = self.branch.ptr, .bytes = self.branch.len },
+            }, w);
+            if (!used) return error.Hy4DirectSlotsUnavailable;
+        } else {
+            try self.fold(1);
+            try cuda.hy4_ops.ihcWrite(self.k, self.rig.s, .{ .rows = 1 }, w);
+        }
+    }
+
+    fn pairedWrite(self: *Worker, bootstrap: anytype) !void {
+        // Changing the rank order changes the cancellation result at every fourth column.
+        const cancellation = [_]f32{ 16777216, 1, -16777216, 3 };
+        var plane: [D]f32 = undefined;
+        const rank: usize = @backingInt(self.rank);
+        for (&plane, 0..) |*v, i| v.* = if (i % 4 == 0) cancellation[rank] else @as(f32, @floatFromInt((i + rank * 7) % 73)) / 64;
+        try self.partial.upload(0, std.mem.asBytes(&plane));
