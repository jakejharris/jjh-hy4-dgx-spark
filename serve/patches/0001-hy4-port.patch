+    const s = arena.allocator();
+    const vocab = try json.newObject(s);
+    for (0..128) |id| try vocab.put(s, try s.dupe(u8, &.{@intCast(id)}), try json.intValue(s, id));
+    const added = try s.alloc(json.Value, special_tokens.len);
+    for (special_tokens, 0..) |m, i| {
+        try vocab.put(s, m.text, try json.intValue(s, m.id));
+        const entry = try json.newObject(s);
+        try entry.put(s, "id", try json.intValue(s, m.id));
+        try entry.put(s, "content", .{ .string = m.text });
+        try entry.put(s, "special", .{ .bool = true });
+        added[i] = .{ .object = entry };
+    }
+    const model = try json.newObject(s);
+    try model.put(s, "type", .{ .string = "BPE" });
+    try model.put(s, "vocab", .{ .object = vocab });
+    try model.put(s, "merges", .{ .array = &.{} });
+    const decoder = try json.newObject(s);
+    try decoder.put(s, "type", .{ .string = "Fuse" });
+    const tok = try json.newObject(s);
+    try tok.put(s, "model", .{ .object = model });
+    try tok.put(s, "decoder", .{ .object = decoder });
+    try tok.put(s, "added_tokens", .{ .array = added });
+    try f.tmp.dir.writeFile(io, .{ .sub_path = "tokenizer.json", .data = try json.stringify(s, .{ .object = tok }, .{}) });
+    try f.tmp.dir.writeFile(io, .{ .sub_path = "config.json", .data = "{\"model_type\":\"hy_v4_vl\",\"eos_token_id\":120025,\"pad_token_id\":120002,\"vocab_size\":120832}" });
+    try f.tmp.dir.writeFile(io, .{ .sub_path = "tokenizer_config.json", .data = @embedFile("fixtures/thinking/hy4-tokenizer_config.json") });
+    try f.tmp.dir.writeFile(io, .{ .sub_path = "chat_template.jinja", .data = @embedFile("fixtures/thinking/hy4.jinja") });
+    return f;
+}
+
+fn rawDecoded(hf: *const HfText, a: Allocator, ids: []const u32) ![]u8 {
+    return hf.tok.decode(a, ids, false);
+}
+
+test "thinking request: Hy4 renders exact Python prompts for unset, high, no_think and enable_thinking false, and refuses unsupported efforts" {
+    const t = std.testing;
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+
+    var f = try initHy4Fixture(t.allocator, t.io);
+    defer f.deinit();
+    var problem: []const u8 = "";
