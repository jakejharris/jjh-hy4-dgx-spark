+        const tr = try a.alloc(u8, kt * nt * words * 2);
+        prng.random().bytes(tr);
+        const suh = try a.alloc(u8, sp.k_pad * 2);
+        prng.random().bytes(suh);
+        const svh = try a.alloc(u8, sp.n_pad * 2);
+        prng.random().bytes(svh);
+        const pfx = try std.fmt.allocPrint(a, "model.layers.1.{s}", .{sp.sfx});
+        const sh_tr = try a.dupe(usize, &.{ kt, nt, words });
+        const sh_su = try a.dupe(usize, &.{sp.k_pad});
+        const sh_sv = try a.dupe(usize, &.{sp.n_pad});
+        try entries.appendSlice(a, &.{
