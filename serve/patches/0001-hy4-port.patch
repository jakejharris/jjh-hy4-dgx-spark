+//! Hy4 chat_template.jinja exact rendering and refusals for `no_think`, `high`, unset, and `enable_thinking: false`.
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json");
+const openai = @import("openai.zig");
+const Server = @import("server.zig").Server;
+const Conn = @import("http_conn.zig").Conn;
+const Fixture = @import("hf_eos_fixture.zig").Fixture;
+const HfText = @import("hf_text.zig").HfText;
+const exchange = @import("late_system_test.zig").exchange;
+const Allocator = std.mem.Allocator;
+
+const expected_high = "<｜hy_start:opensource｜>system<｜hy_middle:opensource｜><｜reasoning_mode:opensource｜>reasoning_effort:high<｜hy_end:opensource｜><｜hy_start:opensource｜>user<｜hy_middle:opensource｜>Reply with exactly one digit: What is 2 + 2?<｜hy_end:opensource｜><｜hy_start:opensource｜>assistant<｜hy_middle:opensource｜><think:opensource>";
+const expected_no_think = "<｜hy_start:opensource｜>system<｜hy_middle:opensource｜><｜reasoning_mode:opensource｜>reasoning_effort:no_think<｜hy_end:opensource｜><｜hy_start:opensource｜>user<｜hy_middle:opensource｜>Reply with exactly one digit: What is 2 + 2?<｜hy_end:opensource｜><｜hy_start:opensource｜>assistant<｜hy_middle:opensource｜><think:opensource></think:opensource>";
+
+const special_tokens = [_]struct { text: []const u8, id: usize }{
+    .{ .text = "<｜hy_start:opensource｜>", .id = 120000 },
+    .{ .text = "<｜hy_middle:opensource｜>", .id = 120001 },
+    .{ .text = "<｜hy_pad:opensource｜>", .id = 120002 },
+    .{ .text = "<｜hy_image▁start:opensource｜>", .id = 120010 },
+    .{ .text = "<｜hy_image▁pad:opensource｜>", .id = 120011 },
+    .{ .text = "<｜hy_image▁end:opensource｜>", .id = 120012 },
+    .{ .text = "<｜hy_image▁newline:opensource｜>", .id = 120013 },
+    .{ .text = "<｜hy_video▁start:opensource｜>", .id = 120014 },
+    .{ .text = "<｜hy_video▁pad:opensource｜>", .id = 120015 },
+    .{ .text = "<｜hy_video▁end:opensource｜>", .id = 120016 },
+    .{ .text = "<｜hy_end:opensource｜>", .id = 120025 },
