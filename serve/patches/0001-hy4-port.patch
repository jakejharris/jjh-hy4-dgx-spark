+//! Host unit tests for `trunk_exl3`: `hy4-exl3-trunk-v1` coexistence overlays, `TF_HY4_TRUNK` selection and
+//! fail-closed refusal, shadowed `.weight` pruning in `DirectPrefetcher` and `hy4PlacementWeightBytes`,
+//! TP=4 pack reassembly of all 8 trunk matrices (`3`, `4`, `6` bits, including `576 -> 640` `kv_a`), and
+//! column-slice `(sk, wk)` plan pinning.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const ranks = @import("ranks.zig");
+const boundary = @import("boundary.zig");
+const weights = @import("weights.zig");
