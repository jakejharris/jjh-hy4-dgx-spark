+        for (off_cases) |extra| {
+            const body = (try json.parse(a, try std.fmt.allocPrint(a, "{{\"model\":\"hy4\",\"messages\":[{{\"role\":\"user\",\"content\":\"Reply with exactly one digit: What is 2 + 2?\"}}],\"max_tokens\":2{s}}}", .{extra}))).ok;
+            var conn: Conn = .{ .fd = -1, .peer = "", .buf = &.{}, .gpa = a };
+            var resp: Reply = .{};
