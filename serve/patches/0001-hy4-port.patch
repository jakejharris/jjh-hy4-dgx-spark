+pub const DraftBlockWeights = struct {
+    target_kv: u32, target_index: u32, input_norm: weights.RmsNormWeight,
+    q_a: draft_policy.DraftLinear, q_a_norm: weights.RmsNormWeight, q_b: draft_policy.DraftLinear,
+    kv_a: draft_policy.DraftLinear, kv_a_norm_bf16: u64, kv_b: u64,
+    linear_gate: draft_policy.DraftLinear, o_proj: draft_policy.DraftLinear,
+    sinks: u64, post_attn_norm: weights.RmsNormWeight, mlp: draft_policy.DraftMlp,
+
+    pub fn hasExl3(self: DraftBlockWeights) bool {
+        return self.q_a == .exl3 or self.q_b == .exl3 or self.kv_a == .exl3 or
+            self.linear_gate == .exl3 or self.o_proj == .exl3 or self.mlp.hasExl3();
+    }
+
+    pub fn reserveExl3(self: DraftBlockWeights, s: *cuda.hy4_ops.ShortTrunk, de: *cuda.exl3.Dense, stream: cuda.Stream) !void {
+        inline for (.{ self.q_a, self.q_b, self.kv_a, self.linear_gate, self.o_proj }) |p| try trunk_exl3.reserveProj(s, de, stream, p);
+        if (self.q_a == .exl3 and self.kv_a == .exl3 and self.q_a.exl3.k_pad == self.q_a.exl3.k and self.q_a.exl3.n_pad == self.q_a.exl3.n) {
+            try de.reserveGroup(stream, &.{ self.q_a.exl3.weight, self.kv_a.exl3.weight });
+        }
+        try self.mlp.reserve(s, de, stream);
+    }
+};
+
+pub const DraftWeights = struct {
+    blocks: []DraftBlockWeights, block_size: u32, mask_token_id: u32, enable_hidden_correction: bool,
+    enorm: weights.RmsNormWeight = .{}, hnorm: weights.RmsNormWeight = .{},
+    eh_proj: draft_policy.DraftLinear = .{ .bf16 = .{} }, fusion_gate_f32: u64 = 0,
+    final_norm: weights.RmsNormWeight = .{},
+    corr_hidden_norm: weights.RmsNormWeight = .{}, corr_embed_norm: weights.RmsNormWeight = .{},
+    corr_mlp: draft_policy.DraftMlp = .{}, custom_head: ?draft_policy.DraftHead = null,
+
+    pub fn maxProposals(self: DraftWeights) u32 { return self.block_size - 1; }
+    pub fn hasExl3(self: DraftWeights) bool {
+        if (self.eh_proj == .exl3 or self.corr_mlp.hasExl3()) return true;
+        if (self.custom_head) |ch| if (ch.hasExl3()) return true;
+        for (self.blocks) |b| if (b.hasExl3()) return true;
+        return false;
+    }
+    pub fn quantLabel(self: DraftWeights) []const u8 {
+        var m: draft_policy.QuantWidthMask = .{};
+        m.note(self.eh_proj);
+        inline for (.{ self.corr_mlp.gate, self.corr_mlp.up, self.corr_mlp.down }) |p| m.note(p);
+        if (self.custom_head) |ch| if (ch == .proj) m.note(ch.proj.p);
+        for (self.blocks) |b| inline for (.{ b.q_a, b.q_b, b.kv_a, b.linear_gate, b.o_proj, b.mlp.gate, b.mlp.up, b.mlp.down }) |p| m.note(p);
+        return m.dflyLabel();
+    }
+    pub fn reserveExl3(self: DraftWeights, s: *cuda.hy4_ops.ShortTrunk, de: *cuda.exl3.Dense, stream: cuda.Stream) !void {
+        try trunk_exl3.reserveProj(s, de, stream, self.eh_proj);
+        try self.corr_mlp.reserve(s, de, stream);
+        if (self.custom_head) |ch| try ch.reserve(s, de, stream);
+        for (self.blocks) |b| try b.reserveExl3(s, de, stream);
+    }
+    pub fn deinitHost(self: *DraftWeights, gpa: std.mem.Allocator) void { gpa.free(self.blocks); self.* = undefined; }
+};
+
+pub fn argminF32(logits: []const f32) !u32 {
+    if (logits.len == 0) return error.EmptyVocab;
+    var worst_id: u32 = 0;
+    var worst_val: f32 = std.math.inf(f32);
+    for (logits, 0..) |v, id| {
+        if (!std.math.isFinite(v)) return error.NonFiniteLogits;
+        if (v < worst_val) { worst_val = v; worst_id = @intCast(id); }
+    }
+    return worst_id;
+}
+
+pub fn resolveTargetLayers(cfg_kv: u32, cfg_ix: u32, t: config.Text, loaded_layers: usize) !struct { kv: usize, ix: usize } {
+    if (loaded_layers == 0 or loaded_layers > t.num_hidden_layers) return error.BadLayerIndex;
+    if (cfg_kv < loaded_layers and cfg_ix < loaded_layers and t.indexer_types[cfg_ix] == .full) {
+        return .{ .kv = cfg_kv, .ix = cfg_ix };
+    }
+    const kv_l: usize = @min(@as(usize, cfg_kv), loaded_layers - 1);
+    var ix_l: usize = @min(@as(usize, cfg_ix), loaded_layers - 1);
+    while (ix_l > 0 and t.indexer_types[ix_l] != .full) : (ix_l -= 1) {}
+    if (t.indexer_types[ix_l] != .full) return error.BadDraftGeometry;
+    return .{ .kv = kv_l, .ix = ix_l };
+}
+
+pub fn buildDraftIndices(base_recalled: []const i32, p: usize, width: usize, stride: usize, out: []i32) !void {
+    if (width == 0 or stride < width or out.len < width * stride or p + width > std.math.maxInt(i32))
+        return error.BadDraftIndices;
+    const prefix_cap = stride - width;
+    for (0..width) |i| {
+        const row = out[i * stride ..][0..stride];
+        @memset(row, -1);
+        var k: usize = 0;
+        for (base_recalled) |slot| {
+            if (slot >= 0 and @as(usize, @intCast(slot)) < p and k < prefix_cap) { row[k] = slot; k += 1; }
+        }
+        for (0 .. i + 1) |d| { row[k] = @intCast(p + d); k += 1; }
+    }
+}
