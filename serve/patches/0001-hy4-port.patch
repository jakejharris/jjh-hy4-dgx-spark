+    var gscript: Script = .{};
+    const gsrv = try Server.init(t.allocator, t.io, gscript.engine(), ghf.text(), .{ .served_name = "glm", .model_ids = &.{"glm"}, .use_drafts = false }, null);
+    defer gsrv.deinit();
+    const gbody = (try json.parse(a, "{\"model\":\"glm\",\"messages\":[{\"role\":\"user\",\"content\":\"H\"}],\"max_tokens\":2,\"reasoning_effort\":\"no_think\"}")).ok;
+    var gconn: Conn = .{ .fd = -1, .peer = "", .buf = &.{}, .gpa = a };
+    var gresp: Reply = .{};
+    openai.run(gsrv, a, gresp.out(), .{ .conn = &gconn }, true, gbody);
+    try t.expectEqual(@as(?u16, 400), gresp.status);
+    try t.expect(!gscript.seen);
