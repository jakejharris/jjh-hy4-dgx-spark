diff --git a/zig/src/families/hy4/rank_picks.zig b/zig/src/families/hy4/rank_picks.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8d2312fff43da83e0869b6afb060e4cdb8006133
--- /dev/null
+++ b/zig/src/families/hy4/rank_picks.zig
@@ -0,0 +1,284 @@
+//! Cross-rank MoE `router_ids` and token-indexer `index_positions` SHA-256 verifier (`--dump-all-ranks` /
+//! `--verify-rank-picks`) across all 4 TP ranks (`ranks 0..3`), plus per-rank dump path naming.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const tp = @import("tp");
+const config = @import("config.zig");
+const cache = @import("cache.zig");
+const dump_oracle = @import("dump_oracle.zig");
+
+const Sha256 = std.crypto.hash.sha2.Sha256;
+
+pub fn memAvailableBytes() usize {
+    var buf: [4096]u8 = undefined;
+    const fd = std.c.open("/proc/meminfo", .{});
+    if (fd < 0) return 0;
+    defer _ = std.c.close(fd);
+    const got = std.c.read(fd, &buf, buf.len);
+    if (got <= 0) return 0;
+    var it = std.mem.tokenizeScalar(u8, buf[0..@intCast(got)], '\n');
+    while (it.next()) |line| if (std.mem.startsWith(u8, line, "MemAvailable:")) {
+        var f = std.mem.tokenizeScalar(u8, line["MemAvailable:".len..], ' ');
+        return (std.fmt.parseInt(usize, f.next() orelse return 0, 10) catch return 0) * 1024;
+    };
+    return 0;
+}
+
+pub fn checkMemFloor(floor_gib: usize) !void {
+    if (floor_gib == 0) return;
+    const avail = memAvailableBytes();
+    if (avail > 0 and avail < (floor_gib << 30)) {
+        std.log.err("hy4 stopping: MemAvailable {d:.2} GiB below {d} GiB floor", .{ @as(f64, @floatFromInt(avail)) / (1 << 30), floor_gib });
+        return error.Hy4MemoryFloor;
+    }
+}
+
+pub fn readForcedLayerIndices(gpa: std.mem.Allocator, io: std.Io, path: []const u8, layer: usize, batch: usize, seq_len: usize, k_eff: usize) ![]i32 {
+    var file = try core.safetensors.File.open(gpa, io, path);
+    defer file.close(io);
+    var kbuf: [64]u8 = undefined;
+    const t = file.get(try std.fmt.bufPrint(&kbuf, "layer.{d:0>3}.index_positions", .{layer})) orelse return error.MissingForcedIndices;
+    if (!t.is(.i32, &.{ batch, seq_len, k_eff })) return error.BadForcedIndices;
+    const out = try gpa.alloc(i32, batch * seq_len * k_eff);
+    for (out, 0..) |*dst, i| dst.* = std.mem.readInt(i32, t.bytes[i * 4 ..][0..4], .little);
+    return out;
+}
+
+pub fn parseCsvTokens(gpa: std.mem.Allocator, text: []const u8) !dump_oracle.PromptTokens {
+    var list: std.ArrayList(u32) = .empty;
+    errdefer list.deinit(gpa);
+    var it = std.mem.tokenizeAny(u8, text, ", \t\r\n");
+    while (it.next()) |tok| try list.append(gpa, try std.fmt.parseInt(u32, tok, 10));
+    if (list.items.len == 0) return error.EmptyPrompt;
+    return .{ .batch = 1, .seq_len = list.items.len, .ids = try list.toOwnedSlice(gpa) };
+}
+
+pub fn rankDumpPath(gpa: std.mem.Allocator, out_path: []const u8, rank_idx: u32, dump_all_ranks: bool, is_tp: bool) ![]u8 {
+    if (!is_tp or !dump_all_ranks) return gpa.dupe(u8, out_path);
+    const sfx = ".safetensors";
+    if (std.mem.endsWith(u8, out_path, sfx)) {
+        return std.fmt.allocPrint(gpa, "{s}.rank{d}{s}", .{ out_path[0 .. out_path.len - sfx.len], rank_idx, sfx });
+    }
+    return std.fmt.allocPrint(gpa, "{s}.rank{d}", .{ out_path, rank_idx });
+}
+
+pub const LayerPickDigests = extern struct {
+    has_router: u8 = 0,
+    has_index: u8 = 0,
+    router_sha256: [32]u8 = @splat(0),
+    index_sha256: [32]u8 = @splat(0),
+};
+
+pub fn hashI32Slice(vals: []const i32) [32]u8 {
+    var sha = Sha256.init(.{});
+    sha.update(std.mem.sliceAsBytes(vals));
+    return sha.finalResult();
+}
+
+pub fn verifyLayerDigests(b: *tp.Bootstrap, layer: usize, local: LayerPickDigests) !void {
+    const mine = std.mem.asBytes(&local);
+    var storage: [cuda.hy4_tp.world * @sizeOf(LayerPickDigests)]u8 = undefined;
+    var blobs: [tp.bootstrap.max_ranks][]const u8 = undefined;
+    const parts = b.allGather(mine, &storage, &blobs) catch |err| {
+        return if (err == error.Timeout) error.Hy4BootstrapTimeout else err;
+    };
+    const ref: *const LayerPickDigests = @ptrCast(@alignCast(parts[0].ptr));
+    for (parts[1..], 1..) |p_bytes, rk| {
+        if (p_bytes.len != @sizeOf(LayerPickDigests)) return error.Hy4RankPickMismatch;
+        const peer: *const LayerPickDigests = @ptrCast(@alignCast(p_bytes.ptr));
+        if (peer.has_router != ref.has_router or !std.mem.eql(u8, &peer.router_sha256, &ref.router_sha256)) {
+            if (b.rank == 0 and !@import("builtin").is_test) {
+                std.log.err("hy4 rank-pick MISMATCH at layer {d} router_ids: rank 0 sha256={x} != rank {d} sha256={x}", .{
+                    layer, ref.router_sha256, rk, peer.router_sha256,
+                });
+            }
+            return error.Hy4RankPickMismatch;
+        }
+        if (peer.has_index != ref.has_index or !std.mem.eql(u8, &peer.index_sha256, &ref.index_sha256)) {
+            if (b.rank == 0 and !@import("builtin").is_test) {
+                std.log.err("hy4 rank-pick MISMATCH at layer {d} index_positions: rank 0 sha256={x} != rank {d} sha256={x}", .{
+                    layer, ref.index_sha256, rk, peer.index_sha256,
+                });
+            }
+            return error.Hy4RankPickMismatch;
+        }
+    }
+}
+
+pub const PickRecorder = struct {
+    gpa: std.mem.Allocator,
+    router_hashers: []Sha256,
+    index_hashers: []Sha256,
+    has_router: []bool,
+    has_index: []bool,
+    scratch: std.ArrayList(i32) = .empty,
+    steps: usize = 0,
+
+    pub fn init(gpa: std.mem.Allocator, num_layers: usize) !PickRecorder {
+        const rh = try gpa.alloc(Sha256, num_layers);
+        errdefer gpa.free(rh);
+        const ih = try gpa.alloc(Sha256, num_layers);
+        errdefer gpa.free(ih);
+        const hr = try gpa.alloc(bool, num_layers);
+        errdefer gpa.free(hr);
+        const hi = try gpa.alloc(bool, num_layers);
+        for (rh) |*h| h.* = Sha256.init(.{});
+        for (ih) |*h| h.* = Sha256.init(.{});
+        @memset(hr, false);
+        @memset(hi, false);
+        return .{ .gpa = gpa, .router_hashers = rh, .index_hashers = ih, .has_router = hr, .has_index = hi };
+    }
+
+    pub fn deinit(self: *PickRecorder) void {
+        self.scratch.deinit(self.gpa);
+        self.gpa.free(self.has_index);
+        self.gpa.free(self.has_router);
+        self.gpa.free(self.index_hashers);
+        self.gpa.free(self.router_hashers);
+        self.* = undefined;
+    }
+
+    pub fn observeHostLayer(self: *PickRecorder, layer: usize, router_ids: ?[]const i32, index_pos: ?[]const i32) void {
+        if (layer >= self.router_hashers.len) return;
+        if (layer == 0) self.steps += 1;
+        if (router_ids) |r| {
+            self.router_hashers[layer].update(std.mem.sliceAsBytes(r));
+            self.has_router[layer] = true;
+        }
+        if (index_pos) |ix| {
+            self.index_hashers[layer].update(std.mem.sliceAsBytes(ix));
+            self.has_index[layer] = true;
+        }
+    }
+
+    pub fn observeDeviceLayer(
+        self: *PickRecorder,
+        d: *const cuda.Driver,
+        stream: cuda.Stream,
+        t: config.Text,
+        layer: usize,
+        first_pos: usize,
+        rows: usize,
+        has_prefix: bool,
+        router_ids_ptr: u64,
+        indices_ptr: u64,
+    ) !void {
+        if (rows == 0 or layer >= self.router_hashers.len) return;
+        if (layer == 0) self.steps += 1;
+        const need_router = t.mlpKind(layer) != .dense and t.num_experts_per_tok > 0;
+        const need_index = t.indexer_types[layer] == .full;
+        if (!need_router and !need_index) return;
+
+        const r_len: usize = if (need_router) rows * t.num_experts_per_tok else 0;
+        const k_eff: usize = if (need_index) cache.selectionWidth(t.index_topk, first_pos, rows, has_prefix) else 0;
+        const i_len: usize = rows * k_eff;
+        try self.scratch.resize(self.gpa, @max(r_len, i_len));
+        try stream.synchronize();
+
+        if (r_len > 0) {
+            const dst = self.scratch.items[0..r_len];
+            try cuda.memory.download(d, router_ids_ptr, std.mem.sliceAsBytes(dst));
+            self.router_hashers[layer].update(std.mem.sliceAsBytes(dst));
+            self.has_router[layer] = true;
+        }
+        if (i_len > 0) {
+            const dst = self.scratch.items[0..i_len];
+            try cuda.memory.download(d, indices_ptr, std.mem.sliceAsBytes(dst));
+            self.index_hashers[layer].update(std.mem.sliceAsBytes(dst));
+            self.has_index[layer] = true;
+        }
+    }
+
+    pub fn verifyAcrossRanks(self: *PickRecorder, b: *tp.Bootstrap) !void {
+        var r_summary = Sha256.init(.{});
+        var i_summary = Sha256.init(.{});
+        var n_router: usize = 0;
+        var n_index: usize = 0;
+        for (0..self.router_hashers.len) |l| {
+            var r_cp = self.router_hashers[l];
+            var i_cp = self.index_hashers[l];
+            const dig: LayerPickDigests = .{
+                .has_router = @intFromBool(self.has_router[l]),
+                .has_index = @intFromBool(self.has_index[l]),
+                .router_sha256 = if (self.has_router[l]) r_cp.finalResult() else @splat(0),
+                .index_sha256 = if (self.has_index[l]) i_cp.finalResult() else @splat(0),
+            };
+            try verifyLayerDigests(b, l, dig);
+            if (self.has_router[l]) {
+                n_router += 1;
+                r_summary.update(&dig.router_sha256);
+            }
+            if (self.has_index[l]) {
+                n_index += 1;
+                i_summary.update(&dig.index_sha256);
+            }
+        }
+        if (b.rank == 0 and !@import("builtin").is_test) {
+            std.debug.print(
+                "hy4 rank-pick check PASS (tp=4 layers={d} steps={d}): router_layers={d} index_layers={d} router_sha256={x} index_sha256={x}\n",
+                .{ self.router_hashers.len, self.steps, n_router, n_index, r_summary.finalResult()[0..8], i_summary.finalResult()[0..8] },
+            );
+        }
+    }
+};
+
+test "rankDumpPath and 4-rank PickRecorder pass when identical and fail with Hy4RankPickMismatch on 1-unit skew" {
+    const gpa = std.testing.allocator;
+    const p1 = try rankDumpPath(gpa, "/tmp/pick.safetensors", 2, true, true);
+    defer gpa.free(p1);
+    try std.testing.expectEqualStrings("/tmp/pick.rank2.safetensors", p1);
+
+    const l = try tp.bootstrap.testListener();
+    defer tp.sock.close(l.fd);
+    const Peer = struct {
+        fn run(rk: u32, port: u16, err_out: *?anyerror) void {
+            var b = tp.Bootstrap.open(.{ .world = 4, .rank = rk, .link_port = port, .connect_timeout_ns = 5 * std.time.ns_per_s }) catch |e| {
+                err_out.* = e;
+                return;
+            };
+            defer b.close();
+            var rec_ok = PickRecorder.init(std.testing.allocator, 2) catch |e| {
+                err_out.* = e;
+                return;
+            };
+            defer rec_ok.deinit();
+            rec_ok.observeHostLayer(0, null, &.{ 0, 1, 2 });
+            rec_ok.observeHostLayer(1, &.{ 7, 19, 44, 102 }, &.{ 0, 1, 2 });
+            rec_ok.verifyAcrossRanks(&b) catch |e| {
+                err_out.* = e;
+                return;
+            };
+
+            var rec_bad = PickRecorder.init(std.testing.allocator, 2) catch |e| {
+                err_out.* = e;
+                return;
+            };
+            defer rec_bad.deinit();
+            const bad_r: [4]i32 = if (rk == 2) .{ 7, 19, 45, 102 } else .{ 7, 19, 44, 102 };
+            rec_bad.observeHostLayer(0, null, &.{ 0, 1, 2 });
+            rec_bad.observeHostLayer(1, &bad_r, &.{ 0, 1, 2 });
+            err_out.* = if (rec_bad.verifyAcrossRanks(&b)) |_| null else |e| e;
+        }
+    };
+    var errs: [3]?anyerror = @splat(null);
+    var ths: [3]std.Thread = undefined;
+    for (0..3) |i| ths[i] = try std.Thread.spawn(.{}, Peer.run, .{ @as(u32, @intCast(i + 1)), l.port, &errs[i] });
+    var b0 = try tp.Bootstrap.acceptOn(l.fd, 4, 5 * std.time.ns_per_s);
+    defer b0.close();
+
+    var rec0 = try PickRecorder.init(gpa, 2);
+    defer rec0.deinit();
+    rec0.observeHostLayer(0, null, &.{ 0, 1, 2 });
+    rec0.observeHostLayer(1, &.{ 7, 19, 44, 102 }, &.{ 0, 1, 2 });
+    try rec0.verifyAcrossRanks(&b0);
+
+    var rec0_bad = try PickRecorder.init(gpa, 2);
+    defer rec0_bad.deinit();
+    rec0_bad.observeHostLayer(0, null, &.{ 0, 1, 2 });
+    rec0_bad.observeHostLayer(1, &.{ 7, 19, 44, 102 }, &.{ 0, 1, 2 });
+    try std.testing.expectError(error.Hy4RankPickMismatch, rec0_bad.verifyAcrossRanks(&b0));
+
+    for (ths) |th| th.join();
+    for (errs) |e| try std.testing.expectEqual(@as(?anyerror, error.Hy4RankPickMismatch), e);
+}
diff --git a/zig/src/families/hy4/ranks.zig b/zig/src/families/hy4/ranks.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8fbd45ad1366e4529e34a23a0412cfb8aed7836d
--- /dev/null
+++ b/zig/src/families/hy4/ranks.zig
@@ -0,0 +1,453 @@
+//! Four-rank tensor-parallel geometry and read-only pack slice reassembly for Full Hy4 (`hy_v4_vl` / `hy_v4`).
+//!
+//! Uses `cuda.hy4_tp.Rank.init`, `rank.stripe`, and `rank.expertPart(core.exl3_layout, ...)` directly for
+//! all checkpoint tensor slice spans (`16` heads, `512` routed/shared expert width, `4,608` dense Layer 0
+//! width, `30,208` vocabulary rows, and `128`-value EXL3 block spans). Supports `hidden_size != 6144` tiny
+//! BF16 fixtures by scaling the rank's quarter index over `num_attention_heads`, `intermediate_size`,
+//! `moe_intermediate_size`, and ceiling-strided `vocab_size`.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const config = @import("config.zig");
+const trunk_exl3 = @import("trunk_exl3.zig");
+
+const st = core.safetensors;
+const layout = core.exl3_layout;
+const htp = cuda.hy4_tp;
+
+pub const Span = layout.Span;
+pub const Rank = htp.Rank;
+pub const world: usize = htp.world;
+
+pub const LocalShape = struct {
+    rank: ?Rank = null,
+    heads: u32,
+    heads_first: u32,
+    dense: usize,
+    dense_first: usize,
+    shared: usize,
+    shared_first: usize,
+    expert: usize,
+    expert_first: usize,
+    vocab_full: usize,
+    vocab_stride: usize,
+    vocab_first: usize,
+    vocab_local: usize,
+
+    pub fn queryRows(self: LocalShape, t: config.Text) usize {
+        return @as(usize, self.heads) * t.qkHeadDim();
+    }
+
+    pub fn kvBRows(self: LocalShape, t: config.Text) usize {
+        return @as(usize, self.heads) * (t.qk_nope_head_dim + t.v_head_dim);
+    }
+
+    pub fn valueRows(self: LocalShape, t: config.Text) usize {
+        return @as(usize, self.heads) * t.v_head_dim;
+    }
+
+    pub fn forText(t: config.Text, rank_opt: ?Rank) !LocalShape {
+        const full_shared: usize = @as(usize, t.moe_intermediate_size) * t.n_shared_experts;
+        const r = rank_opt orelse return .{
+            .rank = null,
+            .heads = t.num_attention_heads,
+            .heads_first = 0,
+            .dense = t.intermediate_size,
+            .dense_first = 0,
+            .shared = full_shared,
+            .shared_first = 0,
+            .expert = t.moe_intermediate_size,
+            .expert_first = 0,
+            .vocab_full = t.vocab_size,
+            .vocab_stride = t.vocab_size,
+            .vocab_first = 0,
+            .vocab_local = t.vocab_size,
+        };
+
+        if (t.hidden_size == htp.hidden) {
+            const sh = r.stripe(.heads);
+            const sd = r.stripe(.dense);
+            const ss = r.stripe(.shared);
+            const se = r.stripe(.expert);
+            const sv = r.stripe(.vocab);
+            if (sh.count * htp.world != t.num_attention_heads) return error.BadHy4TpShape;
+            if (t.intermediate_size != 0 and sd.count * htp.world != t.intermediate_size) return error.BadHy4TpShape;
+            if (t.moe_intermediate_size != 0 and (se.count * htp.world != t.moe_intermediate_size or ss.count * htp.world != full_shared))
+                return error.BadHy4TpShape;
+            if (sv.count * htp.world != t.vocab_size) return error.BadHy4TpShape;
+            return .{
+                .rank = r,
+                .heads = sh.count,
+                .heads_first = sh.first,
+                .dense = if (t.intermediate_size != 0) sd.count else 0,
+                .dense_first = if (t.intermediate_size != 0) sd.first else 0,
+                .shared = if (full_shared != 0) ss.count else 0,
+                .shared_first = if (full_shared != 0) ss.first else 0,
+                .expert = if (t.moe_intermediate_size != 0) se.count else 0,
+                .expert_first = if (t.moe_intermediate_size != 0) se.first else 0,
+                .vocab_full = t.vocab_size,
+                .vocab_stride = sv.count,
+                .vocab_first = sv.first,
+                .vocab_local = sv.count,
+            };
+        }
+
+        const sh_ref = r.stripe(.heads);
+        const slot: usize = sh_ref.first / sh_ref.count;
+        if (t.num_attention_heads % htp.world != 0) return error.BadHy4TpShape;
+        if (t.intermediate_size != 0 and t.intermediate_size % htp.world != 0) return error.BadHy4TpShape;
+        if (t.moe_intermediate_size != 0 and (t.moe_intermediate_size % htp.world != 0 or full_shared % htp.world != 0))
+            return error.BadHy4TpShape;
+        const h_cnt: u32 = t.num_attention_heads / htp.world;
+        const d_cnt: usize = t.intermediate_size / htp.world;
+        const s_cnt: usize = full_shared / htp.world;
+        const e_cnt: usize = t.moe_intermediate_size / htp.world;
+        const v_stride: usize = (@as(usize, t.vocab_size) + htp.world - 1) / htp.world;
+        const v_first: usize = @min(@as(usize, t.vocab_size), slot * v_stride);
+        const v_local: usize = @min(v_stride, @as(usize, t.vocab_size) -| v_first);
+        return .{
+            .rank = r,
+            .heads = h_cnt,
+            .heads_first = @as(u32, @intCast(slot)) * h_cnt,
+            .dense = d_cnt,
+            .dense_first = slot * d_cnt,
+            .shared = s_cnt,
+            .shared_first = slot * s_cnt,
+            .expert = e_cnt,
+            .expert_first = slot * e_cnt,
+            .vocab_full = t.vocab_size,
+            .vocab_stride = v_stride,
+            .vocab_first = v_first,
+            .vocab_local = v_local,
+        };
+    }
+};
+
+fn proportionalStripe(rank: Rank, total_units: usize) !htp.Stripe {
+    if (total_units == 0 or total_units % htp.world != 0) return error.BadHy4TpShape;
+    const sh = rank.stripe(.heads);
+    const slot: u32 = sh.first / sh.count;
+    const per: u32 = @intCast(total_units / htp.world);
+    return .{ .first = slot * per, .count = per };
+}
+
+fn axisStripe(t_opt: ?config.Text, rank: Rank, axis: htp.Axis, total_units: usize) !htp.Stripe {
+    const s = rank.stripe(axis);
+    if ((t_opt == null or t_opt.?.hidden_size == htp.hidden) and @as(usize, s.count) * htp.world == total_units) return s;
+    return proportionalStripe(rank, total_units);
+}
+
+fn stripedSpan(bytes: u64, count: u64, s: htp.Stripe) !Span {
+    if (count == 0 or bytes % count != 0) return error.BadHy4TpSpan;
+    const stride = bytes / count;
+    const full_units: u64 = @as(u64, s.count) * htp.world;
+    if (full_units == 0 or stride % full_units != 0) return error.BadHy4TpSpan;
+    const unit = stride / full_units;
+    return .{ .offset = @as(u64, s.first) * unit, .len = @as(u64, s.count) * unit, .stride = stride, .count = count };
+}
+
+/// Computes `rank`'s exact byte `Span` inside `e` using `cuda.hy4_tp` (`expertPart` and `stripe`).
+pub fn tensorSpan(
+    file: *const st.File,
+    name: []const u8,
+    e: st.Entry,
+    t_opt: ?config.Text,
+    rank: Rank,
+    force_vocab_slice: bool,
+) !Span {
+    return headerTensorSpan(&file.names, name, e, t_opt, rank, force_vocab_slice);
+}
+
+pub fn headerTensorSpan(
+    names: *const st.Header,
+    name: []const u8,
+    e: st.Entry,
+    t_opt: ?config.Text,
+    rank: Rank,
+    force_vocab_slice: bool,
+) !Span {
+    const bytes: u64 = e.end - e.begin;
+    const whole: Span = .{ .offset = 0, .len = bytes };
+
+    if (std.mem.indexOf(u8, name, ".experts.") != null) {
+        if (std.mem.endsWith(u8, name, ".gate_up_proj")) {
+            if (e.rank != 3 or e.shape[1] % (2 * htp.world) != 0) return error.BadHy4TpShape;
+            const s = try axisStripe(t_opt, rank, .expert, e.shape[1] / 2);
+            return stripedSpan(bytes, 2 * e.shape[0], s);
+        }
+        if (std.mem.endsWith(u8, name, ".down_proj")) {
+            if (e.rank != 3 or e.shape[2] % htp.world != 0) return error.BadHy4TpShape;
+            const s = try axisStripe(t_opt, rank, .expert, e.shape[2]);
+            return stripedSpan(bytes, e.shape[0] * e.shape[1], s);
+        }
+        const dot = std.mem.lastIndexOfScalar(u8, name, '.') orelse return error.UnknownExpertField;
+        const suffix = name[dot + 1 ..];
+        if (std.mem.eql(u8, suffix, "mul1")) return whole;
+        var buf: [192]u8 = undefined;
+        const key = try std.fmt.bufPrint(&buf, "{s}.trellis", .{name[0..dot]});
+        const trellis = names.get(key) orelse return error.MissingTrellis;
+        const group = try layout.Group.fromShape(trellis.shape[0..trellis.rank]);
+        const proj: htp.Projection = if (std.mem.endsWith(u8, name[0..dot], "down_proj"))
+            .down
+        else if (std.mem.endsWith(u8, name[0..dot], "gate_proj"))
+            .gate
+        else if (std.mem.endsWith(u8, name[0..dot], "up_proj"))
+            .up
+        else
+            return error.UnknownExpertField;
+        const part = try rank.expertPart(layout, group, proj);
+        if (std.mem.eql(u8, suffix, "trellis")) return part.trellis;
+        if (std.mem.eql(u8, suffix, "suh")) return part.suh;
+        if (std.mem.eql(u8, suffix, "svh")) return part.svh;
+        if (std.mem.eql(u8, suffix, "su")) return .{ .offset = part.suh.offset / 16, .len = part.suh.len / 16 };
+        if (std.mem.eql(u8, suffix, "sv")) return .{ .offset = part.svh.offset / 16, .len = part.svh.len / 16 };
+        return error.UnknownExpertField;
+    }
+
+    if (try trunk_exl3.headerSpan(names, name, e, rank)) |sp| return sp;
+
+    if (std.mem.eql(u8, name, "lm_head.weight") or (force_vocab_slice and std.mem.eql(u8, name, "model.embed_tokens.weight"))) {
+        if (e.rank != 2 or e.shape[0] == 0 or bytes % e.shape[0] != 0) return error.BadHy4TpSpan;
+        const row_bytes = bytes / e.shape[0];
+        const sv = rank.stripe(.vocab);
+        if (e.shape[0] == @as(usize, sv.count) * htp.world) {
+            return .{ .offset = @as(u64, sv.first) * row_bytes, .len = @as(u64, sv.count) * row_bytes };
+        }
+        const slot: usize = sv.first / sv.count;
+        const v_stride: usize = (e.shape[0] + htp.world - 1) / htp.world;
+        const v_first: usize = @min(e.shape[0], slot * v_stride);
+        const v_local: usize = @min(v_stride, e.shape[0] -| v_first);
+        return .{ .offset = v_first * row_bytes, .len = v_local * row_bytes };
+    }
+
+    if (std.mem.indexOf(u8, name, ".shared_experts.") != null) {
+        const row_split = std.mem.endsWith(u8, name, "down_proj.weight");
+        const full_u = if (row_split) e.shape[1] else e.shape[0];
+        const s = try axisStripe(t_opt, rank, .shared, full_u);
+        return stripedSpan(bytes, if (row_split) e.shape[0] else 1, s);
+    }
+
+    if (std.mem.indexOf(u8, name, ".hidden_correction.") != null and
+        (std.mem.endsWith(u8, name, "gate_proj.weight") or
+        std.mem.endsWith(u8, name, "up_proj.weight") or
+        std.mem.endsWith(u8, name, "down_proj.weight")))
+    {
+        const row_split = std.mem.endsWith(u8, name, "down_proj.weight");
+        const full_u = if (row_split) e.shape[1] else e.shape[0];
+        const s = try proportionalStripe(rank, full_u);
+        return stripedSpan(bytes, if (row_split) e.shape[0] else 1, s);
+    }
+
+    if (std.mem.indexOf(u8, name, ".mlp.") != null and
+        (std.mem.endsWith(u8, name, "mlp.gate_proj.weight") or
+        std.mem.endsWith(u8, name, "mlp.up_proj.weight") or
+        std.mem.endsWith(u8, name, "mlp.down_proj.weight")))
+    {
+        const row_split = std.mem.endsWith(u8, name, "down_proj.weight");
+        const full_u = if (row_split) e.shape[1] else e.shape[0];
+        const s = try axisStripe(t_opt, rank, .dense, full_u);
+        return stripedSpan(bytes, if (row_split) e.shape[0] else 1, s);
+    }
+
+    const not_indexer = std.mem.indexOf(u8, name, ".indexer.") == null;
+    const is_heads = not_indexer and (std.mem.endsWith(u8, name, "learnable_sink_param") or
+        std.mem.endsWith(u8, name, "kv_b_proj.weight") or
+        std.mem.endsWith(u8, name, "q_b_proj.weight") or
+        std.mem.endsWith(u8, name, "linear_gate.weight") or
+        std.mem.endsWith(u8, name, "o_proj.weight"));
+    if (is_heads) {
+        const row_split = std.mem.endsWith(u8, name, "o_proj.weight");
+        const heads_total = if (t_opt) |t| @as(usize, t.num_attention_heads) else @as(usize, rank.stripe(.heads).count) * htp.world;
+        const s = try axisStripe(t_opt, rank, .heads, heads_total);
+        return stripedSpan(bytes, if (row_split) e.shape[0] else 1, s);
+    }
+
+    return whole;
+}
+
+pub fn extractSpanAlloc(gpa: std.mem.Allocator, src: []const u8, span: Span) ![]u8 {
+    const out = try gpa.alloc(u8, @intCast(span.bytes()));
+    for (0..@intCast(span.count)) |j| {
+        const off: usize = @intCast(span.at(j));
+        const len: usize = @intCast(span.len);
+        @memcpy(out[j * len ..][0..len], src[off..][0..len]);
+    }
+    return out;
+}
+
+pub const PackCheckStats = struct {
+    tensors: usize,
+    split: usize,
+    replicated: usize,
+    bytes: usize,
+    sha256: [32]u8,
+};
+
+/// Slices every tensor in `path` across all 4 `Rank`s using `tensorSpan` and verifies byte-for-byte reassembly.
+pub fn verifyPackReassembly(gpa: std.mem.Allocator, io: std.Io, path: []const u8) !PackCheckStats {
+    var file = try st.File.open(gpa, io, path);
+    defer file.close(io);
+
+    var split: usize = 0;
+    var at = file.data;
+    var hasher = std.crypto.hash.sha2.Sha256.init(.{});
+    hasher.update(file.map.memory[0..at]);
+
+    for (file.names.keys(), file.names.values()) |key, e| {
+        if (file.data + e.begin != at) return error.NonContiguousPackPayload;
+        const src = file.map.memory[file.data + e.begin .. file.data + e.end];
+
+        var arena = std.heap.ArenaAllocator.init(gpa);
+        defer arena.deinit();
+        const a = arena.allocator();
+
+        var parts: [htp.world][]u8 = undefined;
+        var spans: [htp.world]Span = undefined;
+        for (&parts, &spans, 0..) |*piece, *sp, r_idx| {
+            sp.* = try tensorSpan(&file, key, e, null, try Rank.init(r_idx, htp.world), false);
+            piece.* = try extractSpanAlloc(a, src, sp.*);
+        }
+
+        if (parts[0].len == src.len and spans[0].count == 1) {
+            for (parts) |piece| if (!std.mem.eql(u8, src, piece)) return error.PackReassemblyMismatch;
+        } else {
+            var pos: usize = 0;
+            for (0..@intCast(spans[0].count)) |j| {
+                for (parts, spans) |piece, sp| {
+                    const run_len: usize = @intCast(sp.len);
+                    const stripe = piece[j * run_len ..][0..run_len];
+                    if (pos + run_len > src.len or !std.mem.eql(u8, src[pos..][0..run_len], stripe))
+                        return error.PackReassemblyMismatch;
+                    pos += run_len;
+                }
+            }
+            if (pos != src.len) return error.PackReassemblyMismatch;
+            split += 1;
+        }
+
+        hasher.update(src);
+        at = file.data + e.end;
+    }
+    if (at != file.map.memory.len) return error.TruncatedPackPayload;
+
+    return .{
+        .tensors = file.names.count(),
+        .split = split,
+        .replicated = file.names.count() - split,
+        .bytes = at,
+        .sha256 = hasher.finalResult(),
+    };
+}
+
