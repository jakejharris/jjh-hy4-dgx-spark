+pub const AnchorState = struct {
+    gpa: std.mem.Allocator,
+    num_blocks: usize,
+    max_rows: usize,
+    index_topk: usize,
+    hidden_size: usize,
+    hidden_bf16: cuda.DeviceBuffer,
+    recalled: []i32,
+    has_recalled: [16]bool = @splat(false),
+    captured_rows: usize = 0,
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, t: config.Text, num_blocks: usize, max_rows: usize) !AnchorState {
+        if (num_blocks == 0 or num_blocks > 16 or max_rows == 0) return error.BadDraftGeometry;
+        var hidden_bf16 = try cuda.DeviceBuffer.alloc(d, max_rows * t.hidden_size * 2);
+        errdefer hidden_bf16.free();
+        const recalled = try gpa.alloc(i32, num_blocks * max_rows * t.index_topk);
+        @memset(recalled, -1);
+        return .{
+            .gpa = gpa, .num_blocks = num_blocks, .max_rows = max_rows,
+            .index_topk = t.index_topk, .hidden_size = t.hidden_size,
+            .hidden_bf16 = hidden_bf16, .recalled = recalled,
+        };
+    }
+
+    pub fn deinit(self: *AnchorState) void {
+        self.gpa.free(self.recalled);
+        self.hidden_bf16.free();
+        self.* = undefined;
+    }
+
+    pub fn beginPass(self: *AnchorState, rows: usize) void {
+        self.has_recalled = @splat(false);
+        self.captured_rows = rows;
+    }
+
+    pub fn captureRecalledBlock(self: *AnchorState, d: *const cuda.Driver, stream: cuda.Stream, block_idx: usize, active_dev_ptr: u64, src_row_off: usize, rows: usize) !void {
+        if (block_idx >= self.num_blocks or rows > self.max_rows) return error.BadDraftGeometry;
+        const dst = self.recalled[block_idx * self.max_rows * self.index_topk ..][0 .. rows * self.index_topk];
+        try stream.synchronize();
+        try cuda.memory.download(d, active_dev_ptr + src_row_off * self.index_topk * 4, std.mem.sliceAsBytes(dst));
+        self.has_recalled[block_idx] = true;
+    }
+
+    pub fn captureHidden(self: *AnchorState, stream: cuda.Stream, hidden_dev_ptr: u64, rows: usize) !void {
+        if (rows == 0 or rows > self.max_rows) return error.BadDraftGeometry;
+        try self.hidden_bf16.copyFrom(0, hidden_dev_ptr, rows * self.hidden_size * 2, stream.handle);
+        self.captured_rows = rows;
+    }
+
+    pub fn recalledRow(self: *const AnchorState, block_idx: usize, row: usize) []const i32 {
+        if (!self.has_recalled[block_idx] or row >= self.max_rows) return &.{};
+        return self.recalled[(block_idx * self.max_rows + row) * self.index_topk ..][0..self.index_topk];
+    }
+};
+
+pub const DraftScratch = struct {
+    gpa: std.mem.Allocator, dense_rows: cuda.dense_rows.DenseRows, draft_stride: usize,
+    ids_i32: cuda.DeviceBuffer, streams_0: cuda.DeviceBuffer, streams_1: cuda.DeviceBuffer,
+    after_attn: cuda.DeviceBuffer, normalized: cuda.DeviceBuffer, concat: cuda.DeviceBuffer,
+    delta_f32: cuda.DeviceBuffer, delta_bf16: cuda.DeviceBuffer, prev_embed: cuda.DeviceBuffer,
+    indices_dev: cuda.DeviceBuffer, host_indices: []i32, host_logits: []f32, local_logits: []f32,
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, t: config.Text, block_size: u32) !DraftScratch {
+        const w: usize = block_size;
+        const h: usize = t.hidden_size;
+        const stride: usize = @as(usize, t.index_topk) + w;
+        const loc_cap: usize = std.mem.alignForward(usize, t.vocab_size, 64);
+        var dense_rows = try cuda.dense_rows.DenseRows.load(d); errdefer dense_rows.unload();
+        var ids_i32 = try cuda.DeviceBuffer.alloc(d, max_block_size * 4); errdefer ids_i32.free();
+        var streams_0 = try cuda.DeviceBuffer.alloc(d, w * h * 2); errdefer streams_0.free();
+        var streams_1 = try cuda.DeviceBuffer.alloc(d, w * h * 2); errdefer streams_1.free();
+        var after_attn = try cuda.DeviceBuffer.alloc(d, w * h * 2); errdefer after_attn.free();
+        var normalized = try cuda.DeviceBuffer.alloc(d, w * h * 2); errdefer normalized.free();
+        var concat = try cuda.DeviceBuffer.alloc(d, 2 * h * 2); errdefer concat.free();
+        var delta_f32 = try cuda.DeviceBuffer.alloc(d, h * 4); errdefer delta_f32.free();
+        var delta_bf16 = try cuda.DeviceBuffer.alloc(d, h * 2); errdefer delta_bf16.free();
+        var prev_embed = try cuda.DeviceBuffer.alloc(d, h * 2); errdefer prev_embed.free();
+        var indices_dev = try cuda.DeviceBuffer.alloc(d, w * stride * 4); errdefer indices_dev.free();
+        const host_indices = try gpa.alloc(i32, w * stride); errdefer gpa.free(host_indices);
+        const host_logits = try gpa.alloc(f32, t.vocab_size); errdefer gpa.free(host_logits);
+        const local_logits = try gpa.alloc(f32, loc_cap);
+        return .{
+            .gpa = gpa, .dense_rows = dense_rows, .draft_stride = stride,
+            .ids_i32 = ids_i32, .streams_0 = streams_0, .streams_1 = streams_1,
+            .after_attn = after_attn, .normalized = normalized, .concat = concat,
+            .delta_f32 = delta_f32, .delta_bf16 = delta_bf16, .prev_embed = prev_embed,
+            .indices_dev = indices_dev, .host_indices = host_indices, .host_logits = host_logits,
+            .local_logits = local_logits,
+        };
+    }
+
+    pub fn deinit(self: *DraftScratch) void {
+        self.gpa.free(self.local_logits); self.gpa.free(self.host_logits); self.gpa.free(self.host_indices);
+        self.indices_dev.free(); self.prev_embed.free(); self.delta_bf16.free(); self.delta_f32.free();
+        self.concat.free(); self.normalized.free(); self.after_attn.free();
+        self.streams_1.free(); self.streams_0.free(); self.ids_i32.free();
+        self.dense_rows.unload();
+        self.* = undefined;
+    }
+};
+
+fn inferOutDim(sess: *weights.ShardSession, prefix: []const u8, expect_k: usize) !usize {
+    var nb: [224]u8 = undefined;
+    const w_name = try std.fmt.bufPrint(&nb, "{s}.weight", .{prefix});
+    if (sess.idx.has(w_name)) {
+        const g = try sess.get(w_name);
+        if (g.tensor.rank != 2 or g.tensor.shape[1] != expect_k) return error.UnexpectedTensor;
+        return g.tensor.shape[0];
+    }
+    const tr_name = try std.fmt.bufPrint(&nb, "{s}.trellis", .{prefix});
+    const tr = try sess.getSlice(sess.idx.gpa, tr_name, false);
+    defer if (tr.owned) sess.idx.gpa.free(tr.bytes);
+    if (tr.tensor.rank != 3 or tr.tensor.shape[0] * 16 != std.mem.alignForward(usize, expect_k, 128))
+        return error.UnexpectedTensor;
+    return tr.tensor.shape[1] * 16;
+}
