+const BlockLoadCtx = struct {
+    gpa: std.mem.Allocator, up: *Uploader, m: config.Model, rank: ?ranks.Rank, layer: usize, out: *DraftBlockWeights,
+
+    fn call(raw: *anyopaque, sess: *weights.ShardSession) !void {
+        const c: *@This() = @ptrCast(@alignCast(raw));
+        const t = c.m.text_config;
