+    try std.testing.expectError(error.OutOfDeviceMemory, sc.ensureAuxScratch(1024));
+    try std.testing.expectEqual(old_mla, sc.mla_scratch.ptr);
+    try std.testing.expectEqual(old_aux, sc.aux_scratch.ptr);
+    _ = try cuda.memory.setAllocationLimit(tight);
