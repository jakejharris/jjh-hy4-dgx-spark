new file mode 100644
index 0000000000000000000000000000000000000000..ff5b6008c1509eebf1e26c1222f8b2dec44f5391
--- /dev/null
+++ b/zig/kernels/metal/hy4_flash/affine_experts.metal
@@ -0,0 +1,97 @@
+// Routed rows over group-64 affine experts, with checkpoint SwiGLU rounding.
+#include <metal_stdlib>
+using namespace metal;
+#pragma clang fp contract(off)
+
+struct Hy4ExpertShape {
+    uint width, inner, first, experts, pairs, rows;
+    float swiglu_limit;
+};
+
+template<uint Bits>
+inline float affine_expert_dot(
+    const device bfloat *input, const device uint *words, const device bfloat *scale,
+    const device bfloat *bias, uint width, uint lane) {
+    constexpr uint mask = (1u << Bits) - 1;
+    float acc = 0.0f;
+    for (uint group = 0; group < width / 64; ++group) {
+        const float s = float(scale[group]), b = float(bias[group]);
+        for (uint i = lane; i < 64; i += 32) {
+            const uint index = group * 64 + i, bit = index * Bits;
+            const float code = float((words[bit / 32] >> (bit % 32)) & mask);
+            const float w = float(bfloat(fma(code, s, b)));
+            acc = fma(float(input[index]), w, acc);
+        }
+    }
+    for (ushort d = 16; d > 0; d >>= 1) acc += simd_shuffle_xor(acc, d);
+    return acc;
+}
+
+template<uint Bits, bool Up, typename Output>
+inline void affine_expert_rows(
+    const device bfloat *x, const device int *ids, const device int *row_ids,
+    const device uint *words, const device bfloat *scale, const device bfloat *bias,
+    device Output *result, constant Hy4ExpertShape &s, uint2 group, uint simd, uint lane) {
+    const uint pair = group.y, n = group.x * 4 + simd;
+    const uint width = Up ? s.width : s.inner, size = Up ? s.inner : s.width;
+    if (n >= size) return;
+    const ulong out = ulong(pair) * size + n;
+    const int id = ids[pair], row = Up ? row_ids[pair] : int(pair);
+    if (id < 0 || uint(id) < s.first || uint(id) - s.first >= s.experts ||
+        row < 0 || (Up && uint(row) >= s.rows)) {
+        if (lane == 0) result[out] = Output(0);
+        return;
+    }
+    const device bfloat *input = x + ulong(row) * width;
+    const ulong expert_row = ulong(uint(id) - s.first) * (Up ? 2 * size : size) + n;
+    const uint packed_width = width * Bits / 32, groups = width / 64;
+    const ulong wc = expert_row * packed_width, gc = expert_row * groups;
+    const float first = affine_expert_dot<Bits>(input, words + wc, scale + gc, bias + gc, width, lane);
+    if (Up) {
+        const ulong wu = wc + ulong(size) * packed_width, gu = gc + ulong(size) * groups;
+        const float second = affine_expert_dot<Bits>(input, words + wu, scale + gu, bias + gu, width, lane);
+        if (lane == 0) {
+            float gate = float(bfloat(first)), value = float(bfloat(second));
+            if (s.swiglu_limit > 0) {
+                gate = min(gate, s.swiglu_limit);
+                value = clamp(value, -s.swiglu_limit, s.swiglu_limit);
+            }
+            const float a = float(bfloat(precise::divide(gate, 1.0f + precise::exp(-gate))));
+            result[out] = Output(a * value);
+        }
+    } else if (lane == 0) {
+        result[out] = Output(first);
+    }
+}
+
+#define TF_HY4_EXPERTS(bits, direction, up, out_type)                                                       \
+kernel void tf_affine_experts_##direction##_##bits(                                                        \
+    const device bfloat *x [[buffer(0)]], const device int *ids [[buffer(1)]],                               \
+    const device int *rows [[buffer(2)]], const device uint *words [[buffer(3)]],                            \
+    const device bfloat *scale [[buffer(4)]], const device bfloat *bias [[buffer(5)]],                       \
+    device out_type *output [[buffer(6)]], constant Hy4ExpertShape &shape [[buffer(7)]],                     \
+    uint2 group [[threadgroup_position_in_grid]], uint simd [[simdgroup_index_in_threadgroup]],              \
+    uint lane [[thread_index_in_simdgroup]]) {                                                              \
+    affine_expert_rows<bits, up>(x, ids, rows, words, scale, bias, output, shape, group, simd, lane);         \
+}
+
+TF_HY4_EXPERTS(4, up, true, bfloat)
+TF_HY4_EXPERTS(4, down, false, float)
+TF_HY4_EXPERTS(8, up, true, bfloat)
+TF_HY4_EXPERTS(8, down, false, float)
+
+// All expert contributions remain FP32 until the weighted latent sum is ready for the next projection.
+kernel void tf_hy4_routed_sum(
+    const device float *parts [[buffer(0)]],
+    const device float *weights [[buffer(1)]],
+    device bfloat *out [[buffer(2)]],
+    constant uint2 &shape [[buffer(3)]],
+    uint2 at [[thread_position_in_grid]]) {
+    const uint width = shape.x, picks = shape.y;
+    const ulong row = ulong(at.y) * picks;
+    float sum = 0.0f;
+    for (uint slot = 0; slot < picks; ++slot) {
+        sum = fma(weights[row + slot], parts[(row + slot) * width + at.x], sum);
+    }
+    out[ulong(at.y) * width + at.x] = bfloat(sum);
+}
diff --git a/zig/kernels/metal/hy4_flash/attention_sink.metal b/zig/kernels/metal/hy4_flash/attention_sink.metal
new file mode 100644
index 0000000000000000000000000000000000000000..1d58a18412abad4f5d9261573ea228584c4a579a
--- /dev/null
+++ b/zig/kernels/metal/hy4_flash/attention_sink.metal
@@ -0,0 +1,30 @@
+// Finish a head's online softmax with its learned, zero-value sink.
+#include <metal_stdlib>
+using namespace metal;
+#pragma clang fp contract(off)
+
+struct Hy4SinkArgs {
+    uint rows;
+    uint heads;
+    uint width;
+};
+
+kernel void tf_hy4_finish_attention(
+    const device float *maxima [[buffer(0)]],
+    const device float *mass [[buffer(1)]],
+    const device float *numerator [[buffer(2)]],
+    const device float *sinks [[buffer(3)]],
+    device float *output [[buffer(4)]],
+    constant Hy4SinkArgs &args [[buffer(5)]],
+    uint2 tid [[thread_position_in_grid]]) {
+    const uint column = tid.x;
+    const uint row_head = tid.y;
+    if (column >= args.width || row_head >= ulong(args.rows) * args.heads) return;
+
+    const float sink = sinks[row_head % args.heads];
+    const float top = max(maxima[row_head], sink);
+    const float prior = precise::exp(maxima[row_head] - top);
+    const float denominator = mass[row_head] * prior + precise::exp(sink - top);
+    const ulong offset = ulong(row_head) * args.width + column;
+    output[offset] = numerator[offset] * prior / denominator;
+}
diff --git a/zig/kernels/metal/hy4_flash/engram.metal b/zig/kernels/metal/hy4_flash/engram.metal
new file mode 100644
index 0000000000000000000000000000000000000000..f0bbad8d76e0ec93ca87aa659d790173e9624240
--- /dev/null
+++ b/zig/kernels/metal/hy4_flash/engram.metal
@@ -0,0 +1,145 @@
+// Hy4-flash's file-backed rows enter this pass as BF16. Only the trained Engram branch simulates FP8.
+#include <metal_stdlib>
+using namespace metal;
+#pragma clang fp contract(off)
+
+constant constexpr uint heads = 16, head_width = 96, streams = 4, threads = 128;
+constant constexpr float rms_epsilon = 0x1.0p-23f;
+
+inline float bf(float x) { return float(bfloat(x)); }
+
+// E4M3FN rounds ties to even, includes subnormals and saturates at 448.
+inline float hy4_e4m3(float x) {
+    const float a = fabs(x);
+    if (a == 0.0f) return x;
+    const float step = exp2(max(floor(log2(a)), -6.0f) - 3.0f);
+    return copysign(min(448.0f, rint(a / step) * step), x);
+}
+
+kernel void tf_hy4_engram_lookup(
+    const device bfloat *raw [[buffer(0)]],
+    const device bfloat *gamma [[buffer(1)]],
+    device bfloat *out [[buffer(2)]],
+    constant uint &fp8 [[buffer(3)]],
+    uint2 group [[threadgroup_position_in_grid]],
+    uint lane [[thread_index_in_simdgroup]]) {
+    const uint head = group.x;
+    const ulong start = (ulong(group.y) * heads + head) * head_width;
+    float x[3], maximum = 0.0f;
+    for (uint i = 0; i < 3; ++i) {
+        x[i] = float(raw[start + lane + i * 32]);
+        maximum = max(maximum, fabs(x[i]));
+    }
+    if (fp8 != 0) {
+        const float scale = bf(precise::divide(max(simd_max(maximum), bf(1e-12f)), 448.0f));
+        for (uint i = 0; i < 3; ++i) {
+            const float code = hy4_e4m3(clamp(bf(precise::divide(x[i], scale)), -448.0f, 448.0f));
+            const float quantized = bf(code * scale);
+            x[i] = bf(x[i] + bf(quantized - x[i]));
+        }
+    }
+    const float sum = simd_sum(x[0] * x[0] + x[1] * x[1] + x[2] * x[2]);
+    const float inv = precise::rsqrt(sum / float(head_width) + rms_epsilon);
+    for (uint i = 0; i < 3; ++i) {
+        const uint col = lane + 32 * i;
+        out[start + col] = bfloat((x[i] * inv) * float(gamma[head * head_width + col]));
+    }
+}
+
+struct Hy4EngramArgs { uint rows, hidden; };
+
+kernel void tf_hy4_engram_apply(
+    const device bfloat *state [[buffer(0)]],
+    const device bfloat *keys [[buffer(1)]],
+    const device bfloat *key_bias [[buffer(2)]],
+    const device bfloat *key_gain [[buffer(3)]],
+    const device bfloat *query_gain [[buffer(4)]],
+    const device bfloat *delta_gain [[buffer(5)]],
+    const device bfloat *value [[buffer(6)]],
+    const device bfloat *value_bias [[buffer(7)]],
+    const device bfloat *value_gain [[buffer(8)]],
+    const device uint *media_mask [[buffer(9)]],
+    device bfloat *out [[buffer(10)]],
+    constant Hy4EngramArgs &a [[buffer(11)]],
+    uint2 group [[threadgroup_position_in_grid]],
+    uint t [[thread_index_in_threadgroup]],
+    uint sg [[simdgroup_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]]) {
+    const uint stream = group.x, row = group.y, h = a.hidden;
+    const ulong base = (ulong(row) * streams + stream) * h;
+    if (media_mask[row] != 0) {
+        for (uint j = t; j < h; j += threads) out[base + j] = state[base + j];
+        return;
+    }
+    const ulong kbase = (ulong(stream) * a.rows + row) * h, vbase = ulong(row) * h;
+    const uint gain = stream * h;
+    float sq_key = 0.0f, sq_query = 0.0f, sq_value = 0.0f;
+    for (uint j = t; j < h; j += threads) {
+        const float k = bf(float(keys[kbase + j]) + float(key_bias[gain + j]));
+        const float q = float(state[base + j]);
+        const float v = bf(float(value[vbase + j]) + float(value_bias[j]));
+        sq_key = fma(k, k, sq_key);
+        sq_query = fma(q, q, sq_query);
+        sq_value = fma(v, v, sq_value);
+    }
+    const float key_sum = simd_sum(sq_key), query_sum = simd_sum(sq_query), value_sum = simd_sum(sq_value);
+    threadgroup float partial[3][4];
+    if (lane == 0) { partial[0][sg] = key_sum; partial[1][sg] = query_sum; partial[2][sg] = value_sum; }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float norm[3];
+    for (uint i = 0; i < 3; ++i) {
+        const float sum = (partial[i][0] + partial[i][2]) + (partial[i][1] + partial[i][3]);
+        norm[i] = precise::rsqrt(sum / float(h) + rms_epsilon);
+    }
+    float dot = 0.0f;
+    for (uint j = t; j < h; j += threads) {
+        const float k = bf(float(keys[kbase + j]) + float(key_bias[gain + j]));
+        const float q = float(state[base + j]);
+        const float key = bf((k * norm[0]) * float(key_gain[gain + j]));
+        const float query = bf((q * norm[1]) * float(query_gain[gain + j]));
+        dot += bf(key * query);
+    }
+    const float sum = simd_sum(dot);
+    threadgroup float parts[4], gate;
+    if (lane == 0) parts[sg] = sum;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (t == 0) {
+        const float scaled = bf(bf((parts[0] + parts[2]) + (parts[1] + parts[3])) * precise::rsqrt(float(h)));
+        const float x = scaled == 0.0f ? 0.0f : copysign(bf(precise::sqrt(max(fabs(scaled), bf(1e-6f)))), scaled);
+        gate = bf(precise::divide(1.0f, 1.0f + precise::exp(-x)));
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint j = t; j < h; j += threads) {
+        const float v = bf(float(value[vbase + j]) + float(value_bias[j]));
+        const float signal = bf(bf(v * norm[2]) * float(value_gain[j]));
+        const float delta = bf(bf(gate * signal) + bf(float(delta_gain[gain + j]) * signal));
+        out[base + j] = bfloat(float(state[base + j]) + delta);
+    }
+}
+
+// Engram tables resident in GPU memory: each cell's affine code times its group's scale
+inline ushort hy4_engram_round(float v) {
+    const uint u = as_type<uint>(v);
+    if ((u & 0x7fffffffu) > 0x7f800000u) return ushort((u >> 16) | 0x40u);
+    return ushort((u + 0x7fffu + ((u >> 16) & 1u)) >> 16);
+}
+
+kernel void tf_hy4_engram_gather(
+    const device uint *words [[buffer(0)]],
+    const device ushort *scales [[buffer(1)]],
+    const device ushort *biases [[buffer(2)]],
+    const device uint *rows [[buffer(3)]],
+    device ushort *out [[buffer(4)]],
+    constant uint2 &a [[buffer(5)]],
+    uint gid [[thread_position_in_grid]]) {
+    if (gid >= a.y) return;
+    const uint cell = gid / head_width, i = gid % head_width, bits = a.x;
+    const ulong row = rows[cell];
+    const uint bit = i * bits;
+    const uint word = words[row * (head_width * bits / 32) + bit / 32];
+    const float code = float((word >> (bit % 32)) & ((1u << bits) - 1u));
+    const ulong g = row * (head_width / 32) + i / 32;
+    const float s = as_type<float>(uint(scales[g]) << 16), b = as_type<float>(uint(biases[g]) << 16);
+    const float prod = code * s;
+    out[gid] = hy4_engram_round(prod + b);
+}
diff --git a/zig/kernels/metal/hy4_flash/ihc.metal b/zig/kernels/metal/hy4_flash/ihc.metal
new file mode 100644
index 0000000000000000000000000000000000000000..6b982f31cfad00a07f86e757cea1d175f0bf90fc
--- /dev/null
+++ b/zig/kernels/metal/hy4_flash/ihc.metal
@@ -0,0 +1,531 @@
+// Hy4-flash reads independent stream gates in FP32 and stores BF16 hidden rows.
+#include <metal_stdlib>
+using namespace metal;
+#pragma clang fp contract(off)
+
+struct Hy4IhcShape {
+    uint rows, width, gates;
+    float eps, gate_eps, post_magnitude;
+};
+
+inline float ihc_simd_sum(float score) {
+    for (ushort s = 16; s > 0; s >>= 1) score += simd_shuffle_xor(score, s);
+    return score;
+}
+
+kernel void tf_hy4_ihc_collapse(
+    const device bfloat *hidden [[buffer(0)]],
+    const device float *project [[buffer(1)]],
+    const device float *bias [[buffer(2)]],
+    const device float *scale [[buffer(3)]],
+    device bfloat *collapsed [[buffer(4)]],
+    device float *post [[buffer(5)]],
+    constant Hy4IhcShape &a [[buffer(6)]],
+    uint row [[threadgroup_position_in_grid]],
+    uint t [[thread_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]],
+    uint simd [[simdgroup_index_in_threadgroup]]) {
+    threadgroup float partial[9][8], pre[4];
+    const uint wide = 4 * a.width;
+    const device bfloat *x = hidden + ulong(row) * wide;
+    float sq = 0.0f, logits[8] = {};
+    for (uint i = t; i < wide; i += 256) {
+        const float v = float(x[i]);
+        sq = fma(v, v, sq);
+        for (uint j = 0; j < a.gates; ++j) logits[j] = fma(v, project[j * wide + i], logits[j]);
+    }
+    sq = ihc_simd_sum(sq);
+    if (lane == 0) partial[8][simd] = sq;
+    for (uint j = 0; j < a.gates; ++j) {
+        const float score = ihc_simd_sum(logits[j]);
+        if (lane == 0) partial[j][simd] = score;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (t < a.gates) {
+        float sum = 0.0f, dot = 0.0f;
+        for (uint i = 0; i < 8; ++i) {
+            sum += partial[8][i];
+            dot += partial[t][i];
+        }
+        const float mix = dot * precise::rsqrt(sum / float(wide) + a.eps);
+        const float gate = 1.0f / (1.0f + precise::exp(-(mix * scale[t / 4] + bias[t])));
+        if (t < 4) pre[t] = gate + a.gate_eps;
+        else post[ulong(row) * 4 + t - 4] = a.post_magnitude * gate + a.gate_eps;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint i = t; i < a.width; i += 256) {
+        float v = 0.0f;
+        for (uint stream = 0; stream < 4; ++stream) v += pre[stream] * float(x[stream * a.width + i]);
+        collapsed[ulong(row) * a.width + i] = bfloat(v);
+    }
+}
+
+// tf_hy4_ihc_collapse with the gate count fixed at compile time
+template <uint G>
+inline void ihc_collapse_fixed(
+    const device bfloat *hidden, const device float *project, const device float *bias, const device float *scale,
+    device bfloat *collapsed, device float *post, constant Hy4IhcShape &a,
+    uint row, uint t, uint lane, uint simd, threadgroup float (&partial)[9][8], threadgroup float (&pre)[4]) {
+    const uint wide = 4 * a.width;
+    const device bfloat *x = hidden + ulong(row) * wide;
+    float sq = 0.0f, logits[G];
+#pragma unroll
+    for (uint j = 0; j < G; ++j) logits[j] = 0.0f;
+    for (uint i = t; i < wide; i += 256) {
+        const float v = float(x[i]);
+        sq = fma(v, v, sq);
+#pragma unroll
+        for (uint j = 0; j < G; ++j) logits[j] = fma(v, project[j * wide + i], logits[j]);
+    }
+    sq = ihc_simd_sum(sq);
+    if (lane == 0) partial[8][simd] = sq;
+#pragma unroll
+    for (uint j = 0; j < G; ++j) {
+        const float score = ihc_simd_sum(logits[j]);
+        if (lane == 0) partial[j][simd] = score;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (t < G) {
+        float sum = 0.0f, dot = 0.0f;
+        for (uint i = 0; i < 8; ++i) {
+            sum += partial[8][i];
+            dot += partial[t][i];
+        }
+        const float mix = dot * precise::rsqrt(sum / float(wide) + a.eps);
+        const float gate = 1.0f / (1.0f + precise::exp(-(mix * scale[t / 4] + bias[t])));
+        if (t < 4) pre[t] = gate + a.gate_eps;
+        else post[ulong(row) * 4 + t - 4] = a.post_magnitude * gate + a.gate_eps;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint i = t; i < a.width; i += 256) {
+        float v = 0.0f;
+        for (uint stream = 0; stream < 4; ++stream) v += pre[stream] * float(x[stream * a.width + i]);
+        collapsed[ulong(row) * a.width + i] = bfloat(v);
+    }
+}
+
+#define HY4_IHC_FIXED(G)                                                                                         \
+    kernel void tf_hy4_ihc_collapse_g##G(                                                                        \
+        const device bfloat *hidden [[buffer(0)]], const device float *project [[buffer(1)]],                    \
+        const device float *bias [[buffer(2)]], const device float *scale [[buffer(3)]],                         \
+        device bfloat *collapsed [[buffer(4)]], device float *post [[buffer(5)]], constant Hy4IhcShape &a [[buffer(6)]], \
+        uint row [[threadgroup_position_in_grid]], uint t [[thread_index_in_threadgroup]],                       \
+        uint lane [[thread_index_in_simdgroup]], uint simd [[simdgroup_index_in_threadgroup]]) {                  \
+        threadgroup float partial[9][8], pre[4];                                                                 \
+        ihc_collapse_fixed<G>(hidden, project, bias, scale, collapsed, post, a, row, t, lane, simd, partial, pre); \
+    }
+HY4_IHC_FIXED(4)
+HY4_IHC_FIXED(8)
+
+// The same collapse in two launches.
+template <uint G>
+inline void ihc_partials_fixed(const device bfloat *hidden, const device float *project, device float *part,
+                               constant Hy4IhcShape &a, uint row, uint simd, uint lane) {
+    const uint wide = 4 * a.width, t = 32 * simd + lane;
+    const device bfloat *x = hidden + ulong(row) * wide;
+    float sq = 0.0f, logits[G];
+#pragma unroll
+    for (uint j = 0; j < G; ++j) logits[j] = 0.0f;
+#pragma unroll 4
+    for (uint i = t; i < wide; i += 256) {
+        const float v = float(x[i]);
+        sq = fma(v, v, sq);
+#pragma unroll
+        for (uint j = 0; j < G; ++j) logits[j] = fma(v, project[j * wide + i], logits[j]);
+    }
+    device float *p = part + ulong(row) * 72;
+    sq = ihc_simd_sum(sq);
+    if (lane == 0) p[64 + simd] = sq;
+#pragma unroll
+    for (uint j = 0; j < G; ++j) {
+        const float score = ihc_simd_sum(logits[j]);
+        if (lane == 0) p[8 * j + simd] = score;
+    }
+}
+
+// Threadgroup `slice` of a row writes columns [256 slice, 256 slice + 256)
+template <uint G>
+inline void ihc_finish_fixed(const device bfloat *hidden, const device float *part, const device float *bias,
+                             const device float *scale, device bfloat *collapsed, device float *post,
+                             constant Hy4IhcShape &a, uint row, uint t, uint slice, threadgroup float (&pre)[4]) {
+    const uint wide = 4 * a.width;
+    const device bfloat *x = hidden + ulong(row) * wide;
+    const device float *p = part + ulong(row) * 72;
+    if (t < G && (t < 4 || slice == 0)) {
+        float sum = 0.0f, dot = 0.0f;
+        for (uint i = 0; i < 8; ++i) {
+            sum += p[64 + i];
+            dot += p[8 * t + i];
+        }
+        const float mix = dot * precise::rsqrt(sum / float(wide) + a.eps);
+        const float gate = 1.0f / (1.0f + precise::exp(-(mix * scale[t / 4] + bias[t])));
+        if (t < 4) pre[t] = gate + a.gate_eps;
+        else post[ulong(row) * 4 + t - 4] = a.post_magnitude * gate + a.gate_eps;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    const uint i = 256 * slice + t;
+    if (i < a.width) {
+        float v = 0.0f;
+        for (uint stream = 0; stream < 4; ++stream) v += pre[stream] * float(x[stream * a.width + i]);
+        collapsed[ulong(row) * a.width + i] = bfloat(v);
+    }
+}
+
+#define HY4_IHC_SPLIT(G)                                                                                         \
+    kernel void tf_hy4_ihc_partials_g##G(                                                                        \
+        const device bfloat *hidden [[buffer(0)]], const device float *project [[buffer(1)]],                    \
+        device float *part [[buffer(2)]], constant Hy4IhcShape &a [[buffer(3)]],                                 \
+        uint2 group [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {                  \
+        ihc_partials_fixed<G>(hidden, project, part, a, group.y, group.x, lane);                                 \
+    }                                                                                                            \
+    kernel void tf_hy4_ihc_finish_g##G(                                                                          \
+        const device bfloat *hidden [[buffer(0)]], const device float *part [[buffer(1)]],                       \
+        const device float *bias [[buffer(2)]], const device float *scale [[buffer(3)]],                         \
+        device bfloat *collapsed [[buffer(4)]], device float *post [[buffer(5)]], constant Hy4IhcShape &a [[buffer(6)]], \
+        uint2 group [[threadgroup_position_in_grid]], uint t [[thread_index_in_threadgroup]]) {                  \
+        threadgroup float pre[4];                                                                                \
+        ihc_finish_fixed<G>(hidden, part, bias, scale, collapsed, post, a, group.y, t, group.x, pre);            \
+    }
+HY4_IHC_SPLIT(4)
+HY4_IHC_SPLIT(8)
+
+kernel void tf_hy4_ihc_add(
+    const device bfloat *residual [[buffer(0)]],
+    const device bfloat *branch [[buffer(1)]],
+    const device float *post [[buffer(2)]],
+    device bfloat *output [[buffer(3)]],
+    constant Hy4IhcShape &a [[buffer(4)]],
+    uint2 tid [[thread_position_in_grid]]) {
+    const ulong full = ulong(tid.y) * 4 * a.width + tid.x;
+    const ulong local = ulong(tid.y) * a.width + tid.x % a.width;
+    output[full] = bfloat(float(residual[full]) + post[ulong(tid.y) * 4 + tid.x / a.width] * float(branch[local]));
+}
+
+// The fusion is attached only to slot zero of every DFly2 block.
+kernel void tf_hy4_draft_fuse(
+    device bfloat *embedded [[buffer(0)]],
+    const device bfloat *delta [[buffer(1)]],
+    const device bfloat *gain [[buffer(2)]],
+    constant uint2 &shape [[buffer(3)]],
+    uint2 tid [[thread_position_in_grid]]) {
+    const ulong anchor = ulong(tid.y) * shape.x * shape.y + tid.x;
+    const bfloat update = bfloat(float(delta[ulong(tid.y) * shape.x + tid.x]) * float(gain[tid.x]));
+    embedded[anchor] = bfloat(float(embedded[anchor]) + float(update));
+}
+
+kernel void tf_hy4_draft_residual(
+    const device bfloat *base [[buffer(0)]],
+    const device bfloat *branch [[buffer(1)]],
+    device bfloat *out [[buffer(2)]],
+    constant uint2 &shape [[buffer(3)]],
+    uint2 tid [[thread_position_in_grid]]) {
+    const ulong o = ulong(tid.y) * shape.x + tid.x;
+    const ulong i = ulong(tid.y) * shape.y + tid.x;
+    out[o] = bfloat(float(base[i]) + float(branch[o]));
+}
+
+// ---- Sub-block seams in two launches instead of five (decode and prompt alike) ---- tail
+constant constexpr uint seam_tgs = 12;
+struct Hy4TailShape { uint rows, width, two, partials; float eps; uint mode; };
+
+inline float seam_tg_sum(float v, uint lane, uint sg, threadgroup float *scratch) {
+    v = ihc_simd_sum(v);
+    if (lane == 0) scratch[sg] = v;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float total = 0.0f;
+    for (uint i = 0; i < 8; ++i) total += scratch[i];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    return total;
+}
+
+// The 10 stream products sum_i m[s][i] m[u][i] (s <= u) a row
+constant constexpr uint seam_gram = 10;
+constant constexpr uint seam_slots = 16;
+
+template <uint G>
+inline void ihc_tail(const device bfloat *branch, const device bfloat *branch2, const device bfloat *gain,
+                     const device bfloat *residual, const device float *post, device bfloat *out,
+                     const device float *project, device float *part, constant Hy4TailShape &a, uint row, uint tg,
+                     uint t, uint lane, uint sg, threadgroup float *scratch, threadgroup float (&sums)[9 + seam_gram][8]) {
+    const uint W = a.width, wide = 4 * W;
+    const device bfloat *b0 = branch + ulong(row) * W;
+    const device bfloat *b1 = branch2 + ulong(row) * W;
+    float inv = 0.0f;
+    if (a.mode != 0) {
+        float sq = 0.0f;
+        for (uint i = t; i < W; i += 256) {
+            const float v = a.two ? float(bfloat(b0[i] + b1[i])) : float(b0[i]);
+            sq = fma(v, v, sq);
+        }
+        inv = precise::rsqrt(seam_tg_sum(sq, lane, sg, scratch) / float(W) + a.eps);
+    }
+    float msq = 0.0f, logits[G], gram[seam_gram];
+#pragma unroll
+    for (uint j = 0; j < G; ++j) logits[j] = 0.0f;
+#pragma unroll
+    for (uint k = 0; k < seam_gram; ++k) gram[k] = 0.0f;
+    // a column's four streams together (for the 3072 width, thread t of threadgroup tg owns one column;
+    for (uint col = tg * 256 + t; col < W; col += seam_tgs * 256) {
+        float m[4];
+        float v = 0.0f, normed = 0.0f;
+        if (a.mode != 0) {
+            v = a.two ? float(bfloat(b0[col] + b1[col])) : float(b0[col]);
+            normed = float(bfloat(float(bfloat(v * inv)) * float(gain[col])));
+        }
+#pragma unroll
+        for (uint stream = 0; stream < 4; ++stream) {
+            const ulong i = ulong(row) * wide + stream * W + col;
+            if (a.mode != 0) {
+                m[stream] = float(bfloat(float(residual[i]) + post[ulong(row) * 4 + stream] * normed));
+                out[i] = bfloat(m[stream]);
+            } else {
+                m[stream] = float(residual[i]);
+            }
+        }
+        if (a.partials) {
+#pragma unroll
+            for (uint stream = 0; stream < 4; ++stream) {
+                msq = fma(m[stream], m[stream], msq);
+#pragma unroll
+                for (uint j = 0; j < G; ++j) logits[j] = fma(m[stream], project[j * wide + stream * W + col], logits[j]);
+            }
+            uint k = 0;
+#pragma unroll
+            for (uint s = 0; s < 4; ++s)
+#pragma unroll
+                for (uint u = s; u < 4; ++u, ++k) gram[k] = fma(m[s], m[u], gram[k]);
+        }
+    }
+    if (!a.partials) return;
+    // every sum's simdgroup totals in one threadgroup step, then each added over the 8 simdgroups in order
+#pragma unroll
+    for (uint j = 0; j < G; ++j) {
+        const float v = ihc_simd_sum(logits[j]);
+        if (lane == 0) sums[j][sg] = v;
+    }
+    {
+        const float v = ihc_simd_sum(msq);
+        if (lane == 0) sums[8][sg] = v;
+    }
+#pragma unroll
+    for (uint k = 0; k < seam_gram; ++k) {
+        const float v = ihc_simd_sum(gram[k]);
+        if (lane == 0) sums[9 + k][sg] = v;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    device float *p = part + ulong(row) * (9 + seam_gram) * seam_slots;
+    if (t < G || t == 8 || (t >= 9 && t < 9 + seam_gram)) {
+        float total = 0.0f;
+        for (uint i = 0; i < 8; ++i) total += sums[t][i];
+        p[t * seam_slots + tg] = total;
+    }
+}
+
+// head: the collapse's gates from the tail's partials (added over the 12 threadgroups in order)
+template <uint G>
+inline void ihc_head(const device bfloat *hidden, const device float *part, const device float *bias,
+                     const device float *scale, const device bfloat *gain, device bfloat *collapsed,
+                     device bfloat *normalized, device float *post, constant Hy4IhcShape &a, float norm_eps, uint row,
+                     uint slice, uint t, threadgroup float (&pre)[4], threadgroup float (&gram)[seam_gram]) {
+    const uint W = a.width, wide = 4 * W;
+    const device bfloat *x = hidden + ulong(row) * wide;
+    const device float *p = part + ulong(row) * (9 + seam_gram) * seam_slots;
+    if (t < G && (t < 4 || slice == 0)) {
+        float sum = 0.0f, dot = 0.0f;
+        for (uint i = 0; i < seam_tgs; ++i) {
+            sum += p[8 * seam_slots + i];
+            dot += p[t * seam_slots + i];
+        }
+        const float mix = dot * precise::rsqrt(sum / float(wide) + a.eps);
+        const float gate = 1.0f / (1.0f + precise::exp(-(mix * scale[t / 4] + bias[t])));
+        if (t < 4) pre[t] = gate + a.gate_eps;
+        else post[ulong(row) * 4 + t - 4] = a.post_magnitude * gate + a.gate_eps;
+    } else if (t >= 32 && t < 32 + seam_gram) {
+        float g = 0.0f;
+        for (uint i = 0; i < seam_tgs; ++i) g += p[(9 + t - 32) * seam_slots + i];
+        gram[t - 32] = g;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float sq = 0.0f;
+    uint k = 0;
+    for (uint s = 0; s < 4; ++s)
+        for (uint u = s; u < 4; ++u, ++k) sq = fma((s == u ? 1.0f : 2.0f) * pre[s] * pre[u], gram[k], sq);
+    const float inv = precise::rsqrt(sq / float(W) + norm_eps);
+    for (uint i = slice * 256 + t; i < W; i += seam_tgs * 256) {
+        float v = 0.0f;
+        for (uint stream = 0; stream < 4; ++stream) v += pre[stream] * float(x[stream * W + i]);
+        const float c = float(bfloat(v));
+        collapsed[ulong(row) * W + i] = bfloat(v);
+        normalized[ulong(row) * W + i] = bfloat(float(bfloat(c * inv)) * float(gain[i]));
+    }
+}
+
+// ---- tail and the next head in one launch (decode passes)
+struct Hy4SeamBarrier { atomic_uint count; atomic_uint gen; };
+
+inline void seam_barrier(device Hy4SeamBarrier* b, uint t) {
+    // every thread's stores published, then one thread a threadgroup arrives and waits for the row's other 11
+    atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
+    threadgroup_barrier(mem_flags::mem_device);
+    if (t == 0) {
+        const uint gen = atomic_load_explicit(&b->gen, memory_order_relaxed);
+        // the generation read stays ahead of the arrival (else the last arrival's bump could come first)
+        atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
+        const uint seen = atomic_fetch_add_explicit(&b->count, 1u, memory_order_relaxed);
+        if (seen + 1 == seam_tgs) {
+            atomic_store_explicit(&b->count, 0u, memory_order_relaxed);
+            atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
+            atomic_fetch_add_explicit(&b->gen, 1u, memory_order_relaxed);
+        } else {
+            while (atomic_load_explicit(&b->gen, memory_order_relaxed) == gen) {
+            }
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_device);
+    atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
+}
+
+template <uint G>
+inline void ihc_seam(const device bfloat *branch, const device bfloat *branch2, const device bfloat *gain,
+                     const device bfloat *residual, device float *post, device bfloat *out,
+                     const device float *project, device atomic_float *part, constant Hy4TailShape &a,
+                     const device float *bias, const device float *scale, const device bfloat *next_gain,
+                     device bfloat *collapsed, device bfloat *normalized, constant Hy4IhcShape &n, float norm_eps,
+                     device Hy4SeamBarrier *bars, uint row, uint tg, uint t, uint lane, uint sg,
+                     threadgroup float *scratch, threadgroup float (&sums)[9 + seam_gram][8],
+                     threadgroup float (&pre)[4], threadgroup float (&gram)[seam_gram]) {
+    const uint W = a.width, wide = 4 * W;
+    const device bfloat *b0 = branch + ulong(row) * W;
+    const device bfloat *b1 = branch2 + ulong(row) * W;
+    float sq = 0.0f;
+    for (uint i = t; i < W; i += 256) {
+        const float v = a.two ? float(bfloat(b0[i] + b1[i])) : float(b0[i]);
+        sq = fma(v, v, sq);
+    }
+    const float inv = precise::rsqrt(seam_tg_sum(sq, lane, sg, scratch) / float(W) + a.eps);
+    const uint col = tg * 256 + t;
+    float m[4];
+    const float v = a.two ? float(bfloat(b0[col] + b1[col])) : float(b0[col]);
+    const float normed = float(bfloat(float(bfloat(v * inv)) * float(gain[col])));
+#pragma unroll
+    for (uint stream = 0; stream < 4; ++stream) {
+        const ulong i = ulong(row) * wide + stream * W + col;
+        m[stream] = float(bfloat(float(residual[i]) + post[ulong(row) * 4 + stream] * normed));
+        out[i] = bfloat(m[stream]);
+    }
+    float msq = 0.0f, logits[G], gr[seam_gram];
+#pragma unroll
+    for (uint j = 0; j < G; ++j) logits[j] = 0.0f;
+#pragma unroll
+    for (uint k = 0; k < seam_gram; ++k) gr[k] = 0.0f;
+#pragma unroll
+    for (uint stream = 0; stream < 4; ++stream) {
+        msq = fma(m[stream], m[stream], msq);
+#pragma unroll
+        for (uint j = 0; j < G; ++j) logits[j] = fma(m[stream], project[j * wide + stream * W + col], logits[j]);
+    }
+    {
+        uint k = 0;
+#pragma unroll
+        for (uint s0 = 0; s0 < 4; ++s0)
+#pragma unroll
+            for (uint u = s0; u < 4; ++u, ++k) gr[k] = fma(m[s0], m[u], gr[k]);
+    }
+#pragma unroll
+    for (uint j = 0; j < G; ++j) {
+        const float x = ihc_simd_sum(logits[j]);
+        if (lane == 0) sums[j][sg] = x;
+    }
+    {
+        const float x = ihc_simd_sum(msq);
+        if (lane == 0) sums[8][sg] = x;
+    }
+#pragma unroll
+    for (uint k = 0; k < seam_gram; ++k) {
+        const float x = ihc_simd_sum(gr[k]);
+        if (lane == 0) sums[9 + k][sg] = x;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    device atomic_float *p = part + ulong(row) * (9 + seam_gram) * seam_slots;
+    if (t < G || t == 8 || (t >= 9 && t < 9 + seam_gram)) {
+        float total = 0.0f;
+        for (uint i = 0; i < 8; ++i) total += sums[t][i];
+        atomic_store_explicit(p + t * seam_slots + tg, total, memory_order_relaxed);
+    }
+    // every threadgroup has read this sub-block's post gates above; the head may now overwrite them
+    seam_barrier(bars + row, t);
+    if (t < G && (t < 4 || tg == 0)) {
+        float sum = 0.0f, dot = 0.0f;
+        for (uint i = 0; i < seam_tgs; ++i) {
+            sum += atomic_load_explicit(p + 8 * seam_slots + i, memory_order_relaxed);
+            dot += atomic_load_explicit(p + t * seam_slots + i, memory_order_relaxed);
+        }
+        const float mix = dot * precise::rsqrt(sum / float(wide) + n.eps);
+        const float gate = 1.0f / (1.0f + precise::exp(-(mix * scale[t / 4] + bias[t])));
+        if (t < 4) pre[t] = gate + n.gate_eps;
+        else post[ulong(row) * 4 + t - 4] = n.post_magnitude * gate + n.gate_eps;
+    } else if (t >= 32 && t < 32 + seam_gram) {
+        float g = 0.0f;
+        for (uint i = 0; i < seam_tgs; ++i) g += atomic_load_explicit(p + (9 + t - 32) * seam_slots + i, memory_order_relaxed);
+        gram[t - 32] = g;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float hsq = 0.0f;
+    uint k = 0;
+    for (uint s0 = 0; s0 < 4; ++s0)
+        for (uint u = s0; u < 4; ++u, ++k) hsq = fma((s0 == u ? 1.0f : 2.0f) * pre[s0] * pre[u], gram[k], hsq);
+    const float hinv = precise::rsqrt(hsq / float(W) + norm_eps);
+    float c = 0.0f;
+    for (uint stream = 0; stream < 4; ++stream) c += pre[stream] * m[stream];
+    const float cb = float(bfloat(c));
+    collapsed[ulong(row) * W + col] = bfloat(c);
+    normalized[ulong(row) * W + col] = bfloat(float(bfloat(cb * hinv)) * float(next_gain[col]));
+}
+
+#define HY4_IHC_SEAM_FUSED(G)                                                                                    \
+    kernel void tf_hy4_seam_g##G(                                                                                \
+        const device bfloat *branch [[buffer(0)]], const device bfloat *branch2 [[buffer(1)]],                   \
+        const device bfloat *gain [[buffer(2)]], const device bfloat *residual [[buffer(3)]],                    \
+        device float *post [[buffer(4)]], device bfloat *out [[buffer(5)]],                                      \
+        const device float *project [[buffer(6)]], device atomic_float *part [[buffer(7)]],                      \
+        constant Hy4TailShape &a [[buffer(8)]], const device float *bias [[buffer(9)]],                          \
+        const device float *scale [[buffer(10)]], const device bfloat *next_gain [[buffer(11)]],                 \
+        device bfloat *collapsed [[buffer(12)]], device bfloat *normalized [[buffer(13)]],                       \
+        constant Hy4IhcShape &n [[buffer(14)]], constant float &norm_eps [[buffer(15)]],                         \
+        device Hy4SeamBarrier *bars [[buffer(16)]], uint2 group [[threadgroup_position_in_grid]],                \
+        uint t [[thread_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]],                         \
+        uint sg [[simdgroup_index_in_threadgroup]]) {                                                            \
+        threadgroup float scratch[8], sums[9 + seam_gram][8], pre[4], gram[seam_gram];                           \
+        ihc_seam<G>(branch, branch2, gain, residual, post, out, project, part, a, bias, scale, next_gain,        \
+                    collapsed, normalized, n, norm_eps, bars, group.y, group.x, t, lane, sg, scratch, sums, pre,  \
+                    gram);                                                                                       \
+    }
+HY4_IHC_SEAM_FUSED(4)
+HY4_IHC_SEAM_FUSED(8)
+
+#define HY4_IHC_SEAMS(G)                                                                                         \
+    kernel void tf_hy4_tail_g##G(                                                                                \
+        const device bfloat *branch [[buffer(0)]], const device bfloat *branch2 [[buffer(1)]],                   \
+        const device bfloat *gain [[buffer(2)]], const device bfloat *residual [[buffer(3)]],                    \
+        const device float *post [[buffer(4)]], device bfloat *out [[buffer(5)]],                                \
+        const device float *project [[buffer(6)]], device float *part [[buffer(7)]],                             \
+        constant Hy4TailShape &a [[buffer(8)]], uint2 group [[threadgroup_position_in_grid]],                    \
+        uint t [[thread_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]],                         \
+        uint sg [[simdgroup_index_in_threadgroup]]) {                                                            \
+        threadgroup float scratch[8], sums[9 + seam_gram][8];                                                    \
+        ihc_tail<G>(branch, branch2, gain, residual, post, out, project, part, a, group.y, group.x, t, lane, sg,  \
+                    scratch, sums);                                                                              \
+    }                                                                                                            \
+    kernel void tf_hy4_head_g##G(                                                                                \
+        const device bfloat *hidden [[buffer(0)]], const device float *part [[buffer(1)]],                       \
+        const device float *bias [[buffer(2)]], const device float *scale [[buffer(3)]],                         \
+        const device bfloat *gain [[buffer(4)]], device bfloat *collapsed [[buffer(5)]],                         \
+        device bfloat *normalized [[buffer(6)]], device float *post [[buffer(7)]],                               \
+        constant Hy4IhcShape &a [[buffer(8)]], constant float &norm_eps [[buffer(9)]],                           \
+        uint2 group [[threadgroup_position_in_grid]], uint t [[thread_index_in_threadgroup]]) {                  \
+        threadgroup float pre[4], gram[seam_gram];                                                               \
+        ihc_head<G>(hidden, part, bias, scale, gain, collapsed, normalized, post, a, norm_eps, group.y, group.x, \
+                    t, pre, gram);                                                                               \
+    }
+HY4_IHC_SEAMS(4)
+HY4_IHC_SEAMS(8)
diff --git a/zig/kernels/metal/hy4_flash/index_build.metal b/zig/kernels/metal/hy4_flash/index_build.metal
new file mode 100644
index 0000000000000000000000000000000000000000..a54efbaa659a7eb587cd041a4308c1e0daadc1c3
--- /dev/null
+++ b/zig/kernels/metal/hy4_flash/index_build.metal
@@ -0,0 +1,84 @@
+// Hy4-flash's compressed indexer, the parts before scoring
+#include <metal_stdlib>
+using namespace metal;
+#pragma clang fp contract(off)
+
+struct Hy4IndexKeys { uint rows, capacity; float epsilon; };
+struct Hy4IndexGroups { uint first, count, capacity_groups; float epsilon; };
+
+inline float hy4_ix_value(ushort word) { return as_type<float>(uint(word) << 16); }
+
+inline ushort hy4_ix_round(float value) {
+    const uint bits = as_type<uint>(value);
+    if ((bits & 0x7fffffffu) > 0x7f800000u) return ushort((bits >> 16) | 0x0040u);
+    return ushort((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
+}
+
+// One threadgroup of 128 a row: RMS over the 128 key columns in fp32, the normalized value rounded to BF16
+kernel void tf_hy4_index_keys(
+    const device ushort *keys [[buffer(0)]],
+    const device ushort *gain [[buffer(1)]],
+    const device int *slots [[buffer(2)]],
+    device ushort *cache [[buffer(3)]],
+    constant Hy4IndexKeys &a [[buffer(4)]],
+    uint row [[threadgroup_position_in_grid]],
+    uint t [[thread_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]],
+    uint simd [[simdgroup_index_in_threadgroup]]) {
+    threadgroup float partial[4];
+    const int slot = slots[row];
+    const float x = hy4_ix_value(keys[ulong(row) * 128 + t]);
+    float sq = simd_sum(x * x);
+    if (lane == 0) partial[simd] = sq;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    const float total = ((partial[0] + partial[1]) + partial[2]) + partial[3];
+    if (slot < 0 || uint(slot) >= a.capacity) return;
+    const float inv = precise::rsqrt(total / 128.0f + a.epsilon);
+    const float normed = hy4_ix_value(hy4_ix_round(x * inv));
+    cache[ulong(slot) * 128 + t] = hy4_ix_round(hy4_ix_value(gain[t]) * normed);
+}
+
+// One threadgroup of 128 a group (thread = output column)
+kernel void tf_hy4_index_groups(
+    const device ushort *token_keys [[buffer(0)]],
+    const device float *value_w [[buffer(1)]],
+    const device float *gate_w [[buffer(2)]],
+    const device float *bias [[buffer(3)]],
+    const device float *norm_w [[buffer(4)]],
+    device ushort *group_keys [[buffer(5)]],
+    constant Hy4IndexGroups &a [[buffer(6)]],
+    uint tg [[threadgroup_position_in_grid]],
+    uint c [[thread_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]],
+    uint simd [[simdgroup_index_in_threadgroup]]) {
+    threadgroup float x[4][128];
+    threadgroup float partial[4];
+    const uint g = a.first + tg;
+    if (g >= a.capacity_groups) return;
+    for (uint s = 0; s < 4; ++s) x[s][c] = hy4_ix_value(token_keys[(ulong(g) * 4 + s) * 128 + c]);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    const device float *wv = value_w + ulong(c) * 128;
+    const device float *wg = gate_w + ulong(c) * 128;
+    float v[4], z[4];
+    for (uint s = 0; s < 4; ++s) {
+        float sv = 0.0f, sg = 0.0f;
+        for (uint k = 0; k < 128; ++k) {
+            sv = fma(wv[k], x[s][k], sv);
+            sg = fma(wg[k], x[s][k], sg);
+        }
+        v[s] = sv;
+        z[s] = sg + bias[s * 128 + c];
+    }
+    const float top = max(max(z[0], z[1]), max(z[2], z[3]));
+    float w[4];
+    for (uint s = 0; s < 4; ++s) w[s] = precise::exp(z[s] - top);
+    const float denom = ((w[0] + w[1]) + w[2]) + w[3];
+    float pooled = 0.0f;
+    for (uint s = 0; s < 4; ++s) pooled += v[s] * (w[s] / denom);
+    const float sq = simd_sum(pooled * pooled);
+    if (lane == 0) partial[simd] = sq;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    const float total = ((partial[0] + partial[1]) + partial[2]) + partial[3];
+    const float inv = precise::rsqrt(total / 128.0f + a.epsilon);
+    group_keys[ulong(g) * 128 + c] = hy4_ix_round(norm_w[c] * (pooled * inv));
+}
diff --git a/zig/kernels/metal/hy4_flash/index_recall.metal b/zig/kernels/metal/hy4_flash/index_recall.metal
new file mode 100644
index 0000000000000000000000000000000000000000..093c865b9093bb13c829be32763a9de9628d7e6b
--- /dev/null
+++ b/zig/kernels/metal/hy4_flash/index_recall.metal
@@ -0,0 +1,117 @@
+// Recall complete index groups in logical token order, including the causal part of the current group.
+#include <metal_stdlib>
+using namespace metal;
+
+struct Hy4RecallShape { uint rows, score_groups, group_budget; };
+struct Hy4RecallRow { uint group_base, token; };
+
+kernel void tf_hy4_group_scores(
+    const device bfloat *query [[buffer(0)]],
+    const device bfloat *keys [[buffer(1)]],
+    const device bfloat *head_weights [[buffer(2)]],
+    const device Hy4RecallRow *rows [[buffer(3)]],
+    device float *scores [[buffer(4)]],
+    constant Hy4RecallShape &a [[buffer(5)]],
+    constant float &head_scale [[buffer(6)]],
+    uint2 tg [[threadgroup_position_in_grid]],
+    uint lane [[thread_index_in_simdgroup]],
+    uint simd [[simdgroup_index_in_threadgroup]]) {
+    const uint r = tg.y, group = tg.x * 4 + simd;
+    const Hy4RecallRow row = rows[r];
+    const uint closed = row.token / 4;
+    if (closed < a.group_budget || closed > a.score_groups || group >= closed) return;
+    const device bfloat *key = keys + (ulong(row.group_base) + group) * 128;
+    float cached[4];
+    for (uint d = 0; d < 4; ++d) cached[d] = float(key[lane + d * 32]);
+    float score = 0.0f;
+    for (uint head = 0; head < 16; ++head) {
+        const device bfloat *q = query + (ulong(r) * 16 + head) * 128;
+        float dot = 0.0f;
+        for (uint d = 0; d < 4; ++d) dot = fma(float(q[lane + d * 32]), cached[d], dot);
+        for (ushort d = 16; d > 0; d >>= 1) dot += simd_shuffle_xor(dot, d);
+        const float w = float(head_weights[ulong(r) * 16 + head]) * head_scale;
+        score = fma(w, max(dot, 0.0f), score);
+    }
+    if (lane == 0) scores[ulong(r) * a.score_groups + group] = score;
+}
+
+inline uint hy4_order(float x) {
+    const uint bits = as_type<uint>(x + 0.0f);
+    return (bits & 0x80000000u) ? ~bits : bits | 0x80000000u;
+}
+
+kernel void tf_hy4_recall_groups(
+    const device float *scores [[buffer(0)]],
+    const device Hy4RecallRow *rows [[buffer(1)]],
+    device int *tokens [[buffer(2)]],
+    device int *counts [[buffer(3)]],
+    constant Hy4RecallShape &a [[buffer(4)]],
+    uint r [[threadgroup_position_in_grid]],
+    uint t [[thread_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]],
+    uint simd [[simdgroup_index_in_threadgroup]]) {
+    threadgroup atomic_uint hist[256];
+    threadgroup uint picked[511], digit, next_need, included[8], equal[8], run_gt, run_eq;
+    const uint position = rows[r].token, closed = position / 4, keep = min(closed, a.group_budget - 1);
+    if (closed > a.score_groups) {
+        if (t == 0) counts[r] = 0;
+        return;
+    }
+    if (closed > keep) {
+        const device float *row_scores = scores + ulong(r) * a.score_groups;
+        uint prefix = 0, mask = 0, need = keep;
+        for (int shift = 24; shift >= 0; shift -= 8) {
+            atomic_store_explicit(&hist[t], 0u, memory_order_relaxed);
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            for (uint i = t; i < closed; i += 256) {
+                const uint k = hy4_order(row_scores[i]);
+                if ((k & mask) == prefix) atomic_fetch_add_explicit(&hist[(k >> shift) & 255u], 1u, memory_order_relaxed);
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            if (t == 0) {
+                uint above = 0, b = 255;
+                for (;;) {
+                    const uint n = atomic_load_explicit(&hist[b], memory_order_relaxed);
+                    if (above + n >= need || b == 0) break;
+                    above += n;
+                    --b;
+                }
+                digit = b;
+                next_need = need - above;
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            prefix |= digit << shift;
+            mask |= 255u << shift;
+            need = next_need;
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+        if (t == 0) run_gt = run_eq = 0;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (uint base = 0; base < closed; base += 256) {
+            const uint i = base + t, k = i < closed ? hy4_order(row_scores[i]) : 0u;
+            const uint gt = i < closed && k > prefix ? 1u : 0u;
+            const uint eq = i < closed && k == prefix ? 1u : 0u;
+            const uint ix_gt = simd_prefix_exclusive_sum(gt), ix_eq = simd_prefix_exclusive_sum(eq);
+            if (lane == 31) { included[simd] = ix_gt + gt; equal[simd] = ix_eq + eq; }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            uint prior_gt = run_gt + ix_gt, prior_eq = run_eq + ix_eq;
+            for (uint j = 0; j < simd; ++j) { prior_gt += included[j]; prior_eq += equal[j]; }
+            if (gt != 0 || (eq != 0 && prior_eq < need)) picked[prior_gt + min(prior_eq, need)] = i;
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            if (t == 0) {
+                for (uint j = 0; j < 8; ++j) { run_gt += included[j]; run_eq += equal[j]; }
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+    } else {
+        for (uint i = t; i < keep; i += 256) picked[i] = i;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    device int *out = tokens + ulong(r) * a.group_budget * 4;
+    const uint count = keep * 4 + position % 4 + 1;
+    for (uint i = t; i < count; i += 256) {
+        const uint group = i / 4 < keep ? picked[i / 4] : closed;
+        out[i] = int(group * 4 + i % 4);
+    }
+    if (t == 0) counts[r] = int(count);
+}
diff --git a/zig/kernels/metal/hy4_flash/indexpool.metal b/zig/kernels/metal/hy4_flash/indexpool.metal
new file mode 100644
index 0000000000000000000000000000000000000000..3070c5fab9b84b71aca753b2989f4d9065a6dfdf
--- /dev/null
+++ b/zig/kernels/metal/hy4_flash/indexpool.metal
@@ -0,0 +1,37 @@
+// Hy4-flash's four-slot sparse index pooling before key normalization and RoPE.
+#include <metal_stdlib>
+using namespace metal;
+#pragma clang fp contract(off)
+
+struct Hy4PoolArgs {
+    uint groups;
+    uint width;
+};
+
+kernel void tf_hy4_pool_groups(
+    const device float *values [[buffer(0)]],
+    const device float *gates [[buffer(1)]],
+    const device float *position_bias [[buffer(2)]],
+    device float *output [[buffer(3)]],
+    constant Hy4PoolArgs &args [[buffer(4)]],
+    uint2 tid [[thread_position_in_grid]]) {
+    const uint column = tid.x;
+    const uint group = tid.y;
+    if (column >= args.width || group >= args.groups) return;
+
+    const ulong base = ulong(group) * 4 * args.width + column;
+    float logits[4];
+    for (uint slot = 0; slot < 4; ++slot) {
+        const uint offset = slot * args.width;
+        logits[slot] = gates[base + offset] + position_bias[offset + column];
+    }
+    const float maximum = max(max(logits[0], logits[1]), max(logits[2], logits[3]));
+    float weights[4];
+    for (uint slot = 0; slot < 4; ++slot) weights[slot] = precise::exp(logits[slot] - maximum);
+    const float normalizer = ((weights[0] + weights[1]) + weights[2]) + weights[3];
+    float projected[4];
+    for (uint slot = 0; slot < 4; ++slot) {
+        projected[slot] = values[base + slot * args.width] * (weights[slot] / normalizer);
+    }
+    output[ulong(group) * args.width + column] = ((projected[0] + projected[1]) + projected[2]) + projected[3];
+}
diff --git a/zig/kernels/metal/hy4_flash/mla_attention.metal b/zig/kernels/metal/hy4_flash/mla_attention.metal
new file mode 100644
index 0000000000000000000000000000000000000000..fef8fc07a54e9ab4196c7447af93504375f7d80e
--- /dev/null
+++ b/zig/kernels/metal/hy4_flash/mla_attention.metal
@@ -0,0 +1,184 @@
+// Absorbed MLA using physical BF16 KV slots and rank-local attention sinks.
+#include <metal_stdlib>
+using namespace metal;
+
+constant constexpr uint lat = 512, key = 576, chunk_keys = 512, heads_per_group = 4;
+
+struct Hy4AttendShape {
+    uint rows, heads, key_stride, chunks;
+};
+
+inline float hy4_float(ushort word) { return as_type<float>(uint(word) << 16); }
+
+inline ushort hy4_bf16(float x) {
+    const uint word = as_type<uint>(x);
+    if (isnan(x)) return ushort((word >> 16) | 0x40u);
+    return ushort((word + 0x7fffu + ((word >> 16) & 1u)) >> 16);
+}
+
+kernel void tf_hy4_attend_chunks(
+    const device ushort *query [[buffer(0)]],
+    const device ushort *cache [[buffer(1)]],
+    const device uint *slots [[buffer(2)]],
+    const device uint *counts [[buffer(3)]],
+    device float *scratch [[buffer(4)]],
+    constant Hy4AttendShape &shape [[buffer(5)]],
+    constant float &scale [[buffer(6)]],
+    uint3 group [[threadgroup_position_in_grid]],
+    uint simd [[simdgroup_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]]) {
+    const uint row = group.z, head = group.x * heads_per_group + simd, chunk = group.y;
+    if (head >= shape.heads) return;
+    const ulong row_head = ulong(row) * shape.heads + head;
+    const device ushort *q = query + row_head * key;
+    const ulong plane = ulong(shape.rows) * shape.heads;
+    device float *out = scratch + (ulong(chunk) * plane + row_head) * (lat + 2);
+    const uint start = chunk * chunk_keys, end = min(start + chunk_keys, counts[row]);
+    const uint latent_col = 16 * lane, rope_col = lat + 2 * lane;
+    float ql[16], accum[16] = {}, top = -INFINITY, denom = 0.0f;
+    for (uint i = 0; i < 16; ++i) ql[i] = hy4_float(q[latent_col + i]);
+    const float q0 = hy4_float(q[rope_col]), q1 = hy4_float(q[rope_col + 1]);
+    const device uint *list = slots + ulong(row) * shape.key_stride;
+    for (uint j = start; j < end; ++j) {
+        const device ushort *k = cache + ulong(list[j]) * key;
+        float kv[16], dot = 0.0f;
+        for (uint i = 0; i < 16; ++i) {
+            kv[i] = hy4_float(k[latent_col + i]);
+            dot = fma(ql[i], kv[i], dot);
+        }
+        dot = fma(q0, hy4_float(k[rope_col]), dot);
+        dot = fma(q1, hy4_float(k[rope_col + 1]), dot);
+        for (ushort d = 16; d > 0; d >>= 1) dot += simd_shuffle_xor(dot, d);
+        const float score = dot * scale, next = max(top, score);
+        const float old = precise::exp(top - next), p = precise::exp(score - next);
+        denom = fma(denom, old, p);
+        for (uint i = 0; i < 16; ++i) accum[i] = fma(p, kv[i], accum[i] * old);
+        top = next;
+    }
+    if (lane == 0) {
+        out[lat] = top;
+        out[lat + 1] = denom;
+    }
+    for (uint i = 0; i < 16; ++i) out[latent_col + i] = accum[i];
+}
+
+kernel void tf_hy4_attend_merge(
+    const device float *scratch [[buffer(0)]],
+    const device float *sinks [[buffer(1)]],
+    device ushort *output [[buffer(2)]],
+    constant Hy4AttendShape &shape [[buffer(3)]],
+    uint2 group [[threadgroup_position_in_grid]],
+    uint lane [[thread_index_in_threadgroup]]) {
+    const ulong head = group.x, row_head = ulong(group.y) * shape.heads + head;
+    const ulong step = ulong(shape.rows) * shape.heads * (lat + 2);
+    const device float *base = scratch + row_head * (lat + 2);
+    const uint column = lane * 4;
+    float top = sinks[head];
+    for (uint i = 0; i < shape.chunks; ++i) top = max(top, base[i * step + lat]);
+    float denom = precise::exp(sinks[head] - top), acc[4] = {};
+    for (uint i = 0; i < shape.chunks; ++i) {
+        const device float *part = base + i * step;
+        const float p = precise::exp(part[lat] - top);
+        denom = fma(part[lat + 1], p, denom);
+        for (uint j = 0; j < 4; ++j) acc[j] = fma(part[column + j], p, acc[j]);
+    }
+    for (uint j = 0; j < 4; ++j) output[row_head * lat + column + j] = hy4_bf16(precise::divide(acc[j], denom));
+}
+
+// Chunked attention in two steps.
+kernel void tf_hy4_attend_scores(
+    const device ushort *query [[buffer(0)]],
+    const device ushort *cache [[buffer(1)]],
+    const device uint *slots [[buffer(2)]],
+    const device uint *counts [[buffer(3)]],
+    device float *scores [[buffer(4)]],
+    constant Hy4AttendShape &shape [[buffer(5)]],
+    constant float &scale [[buffer(6)]],
+    uint3 group [[threadgroup_position_in_grid]],
+    uint simd [[simdgroup_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]]) {
+    const uint row = group.z, head = group.x * heads_per_group + simd;
+    if (head >= shape.heads) return;
+    const ulong row_head = ulong(row) * shape.heads + head;
+    const device ushort *q = query + row_head * key;
+    const uint start = group.y * 64, end = min(start + 64, counts[row]);
+    if (start >= end) return;
+    const uint latent_col = 16 * lane, rope_col = lat + 2 * lane;
+    float ql[16];
+    for (uint i = 0; i < 16; ++i) ql[i] = hy4_float(q[latent_col + i]);
+    const float q0 = hy4_float(q[rope_col]), q1 = hy4_float(q[rope_col + 1]);
+    const device uint *list = slots + ulong(row) * shape.key_stride;
+    device float *out = scores + row_head * shape.key_stride;
+    for (uint j = start; j < end; ++j) {
+        const device ushort *k = cache + ulong(list[j]) * key;
+        float dot = 0.0f;
+        for (uint i = 0; i < 16; ++i) dot = fma(ql[i], hy4_float(k[latent_col + i]), dot);
+        dot = fma(q0, hy4_float(k[rope_col]), dot);
+        dot = fma(q1, hy4_float(k[rope_col + 1]), dot);
+        for (ushort d = 16; d > 0; d >>= 1) dot += simd_shuffle_xor(dot, d);
+        if (lane == 0) out[j] = dot * scale;
+    }
+}
+
+kernel void tf_hy4_attend_scored(
+    const device float *scores [[buffer(0)]],
+    const device ushort *cache [[buffer(1)]],
+    const device uint *slots [[buffer(2)]],
+    const device uint *counts [[buffer(3)]],
+    device float *scratch [[buffer(4)]],
+    constant Hy4AttendShape &shape [[buffer(5)]],
+    uint3 group [[threadgroup_position_in_grid]],
+    uint tid [[thread_index_in_threadgroup]],
+    uint simd [[simdgroup_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]]) {
+    // The threadgroup's four heads share one row's keys
+    threadgroup uint4 tile[16][64];
+    const uint row = group.z, head = group.x * heads_per_group + simd, chunk = group.y;
+    const bool live = head < shape.heads;
+    const ulong row_head = ulong(row) * shape.heads + head;
+    const ulong plane = ulong(shape.rows) * shape.heads;
+    const uint start = chunk * chunk_keys, end = min(start + chunk_keys, counts[row]);
+    const uint latent_col = 16 * lane;
+    float accum[16] = {}, top = -INFINITY, denom = 0.0f;
+    const device uint *list = slots + ulong(row) * shape.key_stride;
+    const device float *score_row = scores + (live ? row_head : 0) * shape.key_stride;
+    // 32 keys of scores a step (lane t: key j + t)
+    for (uint j = start; j < end; j += 32) {
+        const uint n = min(32u, end - j);
+        const float score = lane < n ? score_row[j + lane] : -INFINITY;
+        float m = score;
+        for (ushort d = 1; d < 32; d <<= 1) {
+            const float o = simd_shuffle_up(m, d);
+            if (lane >= d) m = max(m, o);
+        }
+        const float next = max(top, m);
+        float before = simd_shuffle_up(next, 1);
+        if (lane == 0) before = top;
+        const float old = precise::exp(before - next), p = precise::exp(score - next);
+        for (uint h = 0; h < n; h += 16) {
+            const uint tn = min(16u, n - h);
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            for (uint e = tid; e < tn * 64; e += 128) {
+                const uint t = e / 64, part = e % 64;
+                tile[t][part] = *((const device uint4 *)(cache + ulong(list[j + h + t]) * key) + part);
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            if (live) {
+                for (uint t = 0; t < tn; ++t) {
+                    const threadgroup ushort *kv_row = (const threadgroup ushort *)&tile[t][0];
+                    const float pt = simd_shuffle(p, ushort(h + t)), ot = simd_shuffle(old, ushort(h + t));
+                    denom = fma(denom, ot, pt);
+                    for (uint i = 0; i < 16; ++i) accum[i] = fma(pt, hy4_float(kv_row[latent_col + i]), accum[i] * ot);
+                }
+            }
+        }
+        top = simd_shuffle(next, ushort(n - 1));
+    }
+    if (!live) return;
+    device float *out = scratch + (ulong(chunk) * plane + row_head) * (lat + 2);
+    if (lane == 0) {
+        out[lat] = top;
+        out[lat + 1] = denom;
+    }
+    for (uint i = 0; i < 16; ++i) out[latent_col + i] = accum[i];
+}
diff --git a/zig/kernels/metal/hy4_flash/mla_nax.metal b/zig/kernels/metal/hy4_flash/mla_nax.metal
new file mode 100644
index 0000000000000000000000000000000000000000..c075d70af0cad80a8f9b6be39454443ee6007684
--- /dev/null
+++ b/zig/kernels/metal/hy4_flash/mla_nax.metal
@@ -0,0 +1,273 @@
+// Hy4-flash's absorbed-MLA BF16 products on the tensor units (nax.h's 16x32x16 op)
+#include "../nax.h"
+using namespace tfp;
+
+struct Hy4MlaProjectArgs { uint rows; uint heads; };
+
+inline float hy4n_value(bfloat w) { return float(w); }
+inline bfloat hy4n_round(float value) {
+    const uint bits = as_type<uint>(value);
+    if ((bits & 0x7fffffffu) > 0x7f800000u) return as_type<bfloat>(ushort((bits >> 16) | 0x0040u));
+    return as_type<bfloat>(ushort((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16));
+}
+
+// absorbed[r][h][0, 512) = q[r][h][0, 192) W_UK[h], W_UK[h] row-major [192][512]; rows 576 apart a head.
+[[kernel]] void tf_hy4_absorb_nax(const device bfloat* query [[buffer(0)]], const device bfloat* wk [[buffer(1)]],
+                                  device bfloat* absorbed [[buffer(2)]], constant Hy4MlaProjectArgs& args [[buffer(3)]],
+                                  uint3 group [[threadgroup_position_in_grid]], uint sg [[simdgroup_index_in_threadgroup]],
+                                  uint lane [[thread_index_in_simdgroup]]) {
+    const short2 home = frag_home(ushort(lane));
+    const int heads = int(args.heads), h = int(group.y), r0 = int(group.z) * 16, n0 = int(group.x) * 128 + int(sg) * 32;
+    const int live = int(args.rows) - r0;
+    const device bfloat* a_rows = query + long(r0) * heads * 256 + h * 256;
+    const device bfloat* b = wk + long(h) * 192 * 512;
+    frag<float> lo = 0.0f, hi = 0.0f;
+    for (int k = 0; k < 192; k += 16) {
+        frag<bfloat> a, b0, b1;
+        frag_get_in(a, a_rows, heads * 256, 0, k, home, live, 192);
+        frag_get(b0, b, 512, k, n0, home);
+        frag_get(b1, b, 512, k, n0 + 16, home);
+        mma_16x32<false, false>(lo, hi, a, b0, b1);
+    }
+    device bfloat* c = absorbed + long(r0) * heads * 576 + h * 576;
+    TF_UNROLL
+    for (short e = 0; e < 8; e++) {
+        const int rr = home.y + (e >> 2) * 8, cc = home.x + TF_COL(e);
+        if (rr < live) {
+            c[long(rr) * heads * 576 + n0 + cc] = hy4n_round(lo[e]);
+            c[long(rr) * heads * 576 + n0 + 16 + cc] = hy4n_round(hi[e]);
+        }
+    }
+}
+
+// values[r][h][0, 256) = gate(latent[r][h][0, 512) W_UV[h]^T), W_UV[h] stored [256][512];
+[[kernel]] void tf_hy4_expand_gated_nax(const device bfloat* latent [[buffer(0)]], const device bfloat* wv [[buffer(1)]],
+                                        device bfloat* values [[buffer(2)]], constant Hy4MlaProjectArgs& args [[buffer(3)]],
+                                        const device bfloat* logits [[buffer(4)]], uint3 group [[threadgroup_position_in_grid]],
+                                        uint sg [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]]) {
+    const short2 home = frag_home(ushort(lane));
+    const int heads = int(args.heads), h = int(group.y), r0 = int(group.z) * 16, n0 = int(group.x) * 128 + int(sg) * 32;
+    const int live = int(args.rows) - r0;
+    const device bfloat* a_rows = latent + long(r0) * heads * 512 + h * 512;
+    const device bfloat* bt = wv + long(h) * 256 * 512;
+    frag<float> lo = 0.0f, hi = 0.0f;
+    for (int k = 0; k < 512; k += 16) {
+        frag<bfloat> a, b0, b1;
+        frag_get_in(a, a_rows, heads * 512, 0, k, home, live, 512);
+        frag_get_t(b0, bt, 512, n0, k, home);
+        frag_get_t(b1, bt, 512, n0 + 16, k, home);
+        mma_16x32<false, true>(lo, hi, a, b0, b1);
+    }
+    TF_UNROLL
+    for (short e = 0; e < 8; e++) {
+        const int rr = home.y + (e >> 2) * 8, cc = home.x + TF_COL(e);
+        if (rr < live) {
+            for (int side = 0; side < 2; ++side) {
+                const long at = long(r0 + rr) * heads * 256 + h * 256 + n0 + 16 * side + cc;
+                const bfloat v = hy4n_round(side ? hi[e] : lo[e]);
+                const float gate = 1.0f / (1.0f + precise::exp(-float(logits[at])));
+                values[at] = hy4n_round(float(v) * float(hy4n_round(gate)));
+            }
+        }
+    }
+}
+
+// Absorbed MLA attention on the tensor units, flash style
+constant constexpr int hy4_tk = 32, hy4_kw = 576, hy4_lw = 512;
+struct Hy4FlashShape { uint rows, heads; float scale; uint pad; };
+
+// SPLIT (decode passes, one row block): threadgroup z of `a.pad` takes the z-th run of the tiles and stores its
+template <bool SPLIT>
+inline void hy4_attend_nax(const device bfloat* query, const device bfloat* cache, const device uint2* ranges,
+                           const device uint* tiles, const device float* sinks, device bfloat* out,
+                           constant Hy4FlashShape& a, uint3 group, uint sg, uint lane, device float* o_part,
+                           device float* ml_part, threadgroup float (&part)[4][16][hy4_tk]) {
+    const short2 home = frag_home(ushort(lane));
+    const int heads = int(a.heads), h = int(group.x), r0 = int(group.y) * 16;
+    const int live = min(16, int(a.rows) - r0);
+    uint lo[2] = {0u, 0u}, hi[2] = {0u, 0u};
+    for (int i = 0; i < 2; ++i) {
+        const int rr = home.y + 8 * i;
+        if (rr < live) { const uint2 g = ranges[r0 + rr]; lo[i] = g.x; hi[i] = g.y; }
+    }
+    uint blo = 0xffffffffu, bhi = 0u;
+    for (int r = 0; r < live; ++r) { const uint2 g = ranges[r0 + r]; blo = min(blo, g.x); bhi = max(bhi, g.y); }
+    const device bfloat* q = query + (long(r0) * heads + h) * hy4_kw;
+    const int ldq = heads * hy4_kw;
+    frag<float> o[4][2];
+    TF_UNROLL
+    for (int j = 0; j < 4; ++j) { o[j][0] = 0.0f; o[j][1] = 0.0f; }
+    float m[2] = {-INFINITY, -INFINITY}, l[2] = {0.0f, 0.0f};
+    int t0 = int(blo / hy4_tk), t1 = int((bhi + hy4_tk - 1) / hy4_tk);
+    if (SPLIT) {
+        const int per = (t1 - t0 + int(a.pad) - 1) / int(a.pad);
+        t0 = min(t1, t0 + int(group.z) * per);
+        t1 = min(t1, t0 + per);
+    }
+    for (int t = t0; t < t1; ++t) {
+        const device bfloat* k = cache + long(tiles[t]) * hy4_kw;
+        frag<float> slo = 0.0f, shi = 0.0f;
+        for (int d = int(sg) * 144; d < int(sg) * 144 + 144; d += 16) {
+            frag<bfloat> qa, k0, k1;
+            frag_get_in(qa, q, ldq, 0, d, home, live, hy4_kw);
+            frag_get_t(k0, k, hy4_kw, 0, d, home);
+            frag_get_t(k1, k, hy4_kw, 16, d, home);
+            mma_16x32<false, true>(slo, shi, qa, k0, k1);
+        }
+        TF_UNROLL
+        for (short e = 0; e < 8; e++) {
+            const int rr = home.y + (e >> 2) * 8, cc = home.x + TF_COL(e);
+            part[sg][rr][cc] = slo[e];
+            part[sg][rr][16 + cc] = shi[e];
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        float p[2][8];
+        float tmax[2] = {-INFINITY, -INFINITY};
+        TF_UNROLL
+        for (short e = 0; e < 8; e++) {
+            const int i = e >> 2, rr = home.y + i * 8, cc = home.x + TF_COL(e);
+            for (int side = 0; side < 2; ++side) {
+                const int col = side * 16 + cc;
+                float s = part[0][rr][col];
+                s += part[1][rr][col];
+                s += part[2][rr][col];
+                s += part[3][rr][col];
+                const uint key = uint(t * hy4_tk + col);
+                s = (key >= lo[i] && key < hi[i]) ? s * a.scale : -INFINITY;
+                p[side][e] = s;
+                tmax[i] = max(tmax[i], s);
+            }
+        }
+        float alpha[2];
+        for (int i = 0; i < 2; ++i) {
+            tmax[i] = max(tmax[i], simd_shuffle_xor(tmax[i], ushort(1)));
+            tmax[i] = max(tmax[i], simd_shuffle_xor(tmax[i], ushort(8)));
+            const float next = max(m[i], tmax[i]);
+            alpha[i] = next == -INFINITY ? 1.0f : precise::exp(m[i] - next);
+            m[i] = next;
+        }
+        float sum[2] = {0.0f, 0.0f};
+        frag<bfloat> plo, phi;
+        TF_UNROLL
+        for (short e = 0; e < 8; e++) {
+            const int i = e >> 2;
+            for (int side = 0; side < 2; ++side) {
+                const float v = m[i] == -INFINITY ? 0.0f : precise::exp(p[side][e] - m[i]);
+                p[side][e] = v;
+                sum[i] += v;
+            }
+            plo[e] = bfloat(p[0][e]);
+            phi[e] = bfloat(p[1][e]);
+        }
+        for (int i = 0; i < 2; ++i) {
+            sum[i] += simd_shuffle_xor(sum[i], ushort(1));
+            sum[i] += simd_shuffle_xor(sum[i], ushort(8));
+            l[i] = l[i] * alpha[i] + sum[i];
+        }
+        TF_UNROLL
+        for (int j = 0; j < 4; ++j) {
+            TF_UNROLL
+            for (short e = 0; e < 8; e++) {
+                o[j][0][e] *= alpha[e >> 2];
+                o[j][1][e] *= alpha[e >> 2];
+            }
+            const int n = int(sg) * 128 + j * 32;
+            frag<bfloat> v0, v1;
+            frag_get(v0, k, hy4_kw, 0, n, home);
+            frag_get(v1, k, hy4_kw, 0, n + 16, home);
+            mma_16x32<false, false>(o[j][0], o[j][1], plo, v0, v1);
+            frag_get(v0, k, hy4_kw, 16, n, home);
+            frag_get(v1, k, hy4_kw, 16, n + 16, home);
+            mma_16x32<false, false>(o[j][0], o[j][1], phi, v0, v1);
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if (SPLIT) {
+        const long z = long(group.z), rows = long(a.rows);
+        for (int i = 0; i < 2; ++i) {
+            const int rr = home.y + 8 * i;
+            if (rr < live && sg == 0) {
+                device float* ml = ml_part + ((z * rows + r0 + rr) * heads + h) * 2;
+                ml[0] = m[i];
+                ml[1] = l[i];
+            }
+        }
+        TF_UNROLL
+        for (int j = 0; j < 4; ++j) {
+            TF_UNROLL
+            for (short e = 0; e < 8; e++) {
+                const int i = e >> 2, rr = home.y + i * 8, cc = home.x + TF_COL(e);
+                if (rr < live) {
+                    device float* row = o_part + ((z * rows + r0 + rr) * heads + h) * hy4_lw + int(sg) * 128 + j * 32 + cc;
+                    row[0] = o[j][0][e];
+                    row[16] = o[j][1][e];
+                }
+            }
+        }
+        return;
+    }
+    const float sink = sinks[h];
+    float keep[2], denom[2];
+    for (int i = 0; i < 2; ++i) {
+        const float top = max(m[i], sink);
+        keep[i] = m[i] == -INFINITY ? 0.0f : precise::exp(m[i] - top);
+        denom[i] = l[i] * keep[i] + precise::exp(sink - top);
+    }
+    TF_UNROLL
+    for (int j = 0; j < 4; ++j) {
+        TF_UNROLL
+        for (short e = 0; e < 8; e++) {
+            const int i = e >> 2, rr = home.y + i * 8, cc = home.x + TF_COL(e);
+            if (rr < live) {
+                device bfloat* row = out + (long(r0 + rr) * heads + h) * hy4_lw + int(sg) * 128 + j * 32 + cc;
+                row[0] = bfloat(precise::divide(o[j][0][e] * keep[i], denom[i]));
+                row[16] = bfloat(precise::divide(o[j][1][e] * keep[i], denom[i]));
+            }
+        }
+    }
+}
+
+[[kernel]] void tf_hy4_attend_nax(const device bfloat* query [[buffer(0)]], const device bfloat* cache [[buffer(1)]],
+                                  const device uint2* ranges [[buffer(2)]], const device uint* tiles [[buffer(3)]],
+                                  const device float* sinks [[buffer(4)]], device bfloat* out [[buffer(5)]],
+                                  constant Hy4FlashShape& a [[buffer(6)]], uint3 group [[threadgroup_position_in_grid]],
+                                  uint sg [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]]) {
+    threadgroup float part[4][16][hy4_tk];
+    hy4_attend_nax<false>(query, cache, ranges, tiles, sinks, out, a, group, sg, lane, nullptr, nullptr, part);
+}
+
+[[kernel]] void tf_hy4_attend_nax_split(const device bfloat* query [[buffer(0)]], const device bfloat* cache [[buffer(1)]],
+                                        const device uint2* ranges [[buffer(2)]], const device uint* tiles [[buffer(3)]],
+                                        const device float* sinks [[buffer(4)]], device bfloat* out [[buffer(5)]],
+                                        constant Hy4FlashShape& a [[buffer(6)]], device float* o_part [[buffer(7)]],
+                                        device float* ml_part [[buffer(8)]], uint3 group [[threadgroup_position_in_grid]],
+                                        uint sg [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]]) {
+    threadgroup float part[4][16][hy4_tk];
+    hy4_attend_nax<true>(query, cache, ranges, tiles, sinks, out, a, group, sg, lane, o_part, ml_part, part);
+}
+
+// The split runs of tf_hy4_attend_nax_split joined with the learned sink
+[[kernel]] void tf_hy4_attend_combine(const device float* o_part [[buffer(0)]], const device float* ml_part [[buffer(1)]],
+                                      const device float* sinks [[buffer(2)]], device bfloat* out [[buffer(3)]],
+                                      constant Hy4FlashShape& a [[buffer(4)]], uint2 group [[threadgroup_position_in_grid]],
+                                      uint t [[thread_index_in_threadgroup]]) {
+    const int h = int(group.x), r = int(group.y), heads = int(a.heads), splits = min(int(a.pad), 8);
+    const long rows = long(a.rows);
+    const float sink = sinks[h];
+    float top = sink;
+    for (int z = 0; z < splits; ++z) top = max(top, ml_part[((z * rows + r) * heads + h) * 2]);
+    float w[8];
+    float denom = precise::exp(sink - top);
+    for (int z = 0; z < 8; ++z) {
+        w[z] = 0.0f;
+        if (z >= splits) continue;
+        const device float* ml = ml_part + ((z * rows + r) * heads + h) * 2;
+        w[z] = ml[0] == -INFINITY ? 0.0f : precise::exp(ml[0] - top);
+        denom += ml[1] * w[z];
+    }
+    for (int c = int(t) * 4; c < int(t) * 4 + 4; ++c) {
+        float v = 0.0f;
+        for (int z = 0; z < splits; ++z) v += o_part[((z * rows + r) * heads + h) * hy4_lw + c] * w[z];
+        out[(long(r) * heads + h) * hy4_lw + c] = bfloat(precise::divide(v, denom));
+    }
+}
diff --git a/zig/kernels/metal/hy4_flash/mla_project.metal b/zig/kernels/metal/hy4_flash/mla_project.metal
new file mode 100644
index 0000000000000000000000000000000000000000..f44055f52623a32a33268351cf4d0c1ba6898da6
--- /dev/null
+++ b/zig/kernels/metal/hy4_flash/mla_project.metal
@@ -0,0 +1,158 @@
+// Hy4-flash projections around absorbed MLA. The rotary lanes are filled separately.
+#include <metal_stdlib>
+using namespace metal;
+#pragma clang fp contract(off)
+
+struct Hy4MlaProjectArgs { uint rows; uint heads; };
+struct Hy4RopeParameters { float frequencies[32]; uint axes[32]; };
+struct Hy4RopeView { uint rows, heads, input_stride, output_stride; };
+struct Hy4CacheWrite { uint rows, capacity; float epsilon; };
+
+inline float hy4_mla_value(ushort word) { return as_type<float>(uint(word) << 16); }
+
+inline ushort hy4_mla_round(float value) {
+    const uint bits = as_type<uint>(value);
+    if ((bits & 0x7fffffffu) > 0x7f800000u) return ushort((bits >> 16) | 0x0040u);
+    return ushort((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
+}
+
+// Match the checkpoint's BF16 trigonometric coefficients before the FP32 pair rotation.
+kernel void tf_hy4_rotary_table(
+    const device int *positions [[buffer(0)]],
+    device ushort *table [[buffer(1)]],
+    constant Hy4RopeParameters &p [[buffer(2)]],
+    uint2 tid [[thread_position_in_grid]]) {
+    const uint pair = tid.x, row = tid.y;
+    const float phase = float(positions[ulong(row) * 3 + p.axes[pair]]) * p.frequencies[pair];
+    table[ulong(row) * 64 + 2 * pair] = hy4_mla_round(precise::cos(phase));
+    table[ulong(row) * 64 + 2 * pair + 1] = hy4_mla_round(precise::sin(phase));
+}
+
+kernel void tf_hy4_rotate(
+    const device ushort *input [[buffer(0)]],
+    const device ushort *table [[buffer(1)]],
+    device ushort *output [[buffer(2)]],
+    constant Hy4RopeView &v [[buffer(3)]],
+    uint3 tid [[thread_position_in_grid]]) {
+    const ulong row_head = ulong(tid.z) * v.heads + tid.y;
+    const uint col = 2 * tid.x;
+    const ulong i = row_head * v.input_stride + col, o = row_head * v.output_stride + col;
+    const ulong base = ulong(tid.z) * 64 + col;
+    const float a = hy4_mla_value(input[i]), b = hy4_mla_value(input[i + 1]);
+    const float c = hy4_mla_value(table[base]), s = hy4_mla_value(table[base + 1]);
+    output[o] = hy4_mla_round(a * c - b * s);
+    output[o + 1] = hy4_mla_round(b * c + a * s);
+}
+
+kernel void tf_hy4_cache_keys(
+    const device ushort *input [[buffer(0)]],
+    const device ushort *gain [[buffer(1)]],
+    const device ushort *table [[buffer(2)]],
+    const device int *slots [[buffer(3)]],
+    device ushort *cache [[buffer(4)]],
+    constant Hy4CacheWrite &a [[buffer(5)]],
+    uint row [[threadgroup_position_in_grid]],
+    uint t [[thread_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]],
+    uint simd [[simdgroup_index_in_threadgroup]]) {
+    const int slot = slots[row];
+    if (slot < 0 || uint(slot) >= a.capacity) return;
+    const device ushort *x = input + ulong(row) * 576;
+    device ushort *y = cache + ulong(slot) * 576;
+    float v[4], sq = 0.0f;
+    for (uint i = 0; i < 4; ++i) {
+        v[i] = hy4_mla_value(x[t + i * 128]);
+        sq = fma(v[i], v[i], sq);
+    }
+    for (ushort d = 16; d > 0; d >>= 1) sq += simd_shuffle_xor(sq, d);
+    threadgroup float part[4];
+    if (lane == 0) part[simd] = sq;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    const float sum = (part[0] + part[2]) + (part[1] + part[3]);
+    const float inverse = precise::rsqrt(sum / 512.0f + a.epsilon);
+    for (uint i = 0; i < 4; ++i) {
+        const uint col = t + i * 128;
+        const float normalized = hy4_mla_value(hy4_mla_round(v[i] * inverse));
+        y[col] = hy4_mla_round(normalized * hy4_mla_value(gain[col]));
+    }
+    if (t < 32) {
+        const uint col = 2 * t;
+        const float u = hy4_mla_value(x[512 + col]), v1 = hy4_mla_value(x[513 + col]);
+        const float c = hy4_mla_value(table[ulong(row) * 64 + col]);
+        const float s = hy4_mla_value(table[ulong(row) * 64 + col + 1]);
+        y[512 + col] = hy4_mla_round(u * c - v1 * s);
+        y[513 + col] = hy4_mla_round(v1 * c + u * s);
+    }
+}
+
+kernel void tf_hy4_gate_values(
+    device ushort *values [[buffer(0)]],
+    const device ushort *logits [[buffer(1)]],
+    constant uint &columns [[buffer(2)]],
+    uint2 tid [[thread_position_in_grid]]) {
+    const ulong i = ulong(tid.y) * columns + tid.x;
+    const float gate = 1.0f / (1.0f + precise::exp(-hy4_mla_value(logits[i])));
+    values[i] = hy4_mla_round(hy4_mla_value(values[i]) * hy4_mla_value(hy4_mla_round(gate)));
+}
+
+kernel void tf_hy4_absorb_q(
+    const device ushort *query [[buffer(0)]],
+    const device ushort *key_projection [[buffer(1)]],
+    device ushort *absorbed [[buffer(2)]],
+    constant Hy4MlaProjectArgs &args [[buffer(3)]],
+    uint2 tid [[thread_position_in_grid]]) {
+    const uint column = tid.x;
+    const uint row_head = tid.y;
+    if (column >= 512 || row_head >= ulong(args.rows) * args.heads) return;
+
+    const ulong q = ulong(row_head) * 256;
+    const ulong wk = ulong(row_head % args.heads) * 192 * 512 + column;
+    float sum = 0.0f;
+    for (uint i = 0; i < 192; ++i) {
+        sum = fma(hy4_mla_value(query[q + i]), hy4_mla_value(key_projection[wk + i * 512]), sum);
+    }
+    absorbed[ulong(row_head) * 576 + column] = hy4_mla_round(sum);
+}
+
+kernel void tf_hy4_expand_v(
+    const device ushort *latent [[buffer(0)]],
+    const device ushort *value_projection [[buffer(1)]],
+    device ushort *expanded [[buffer(2)]],
+    constant Hy4MlaProjectArgs &args [[buffer(3)]],
+    uint2 tid [[thread_position_in_grid]]) {
+    const uint column = tid.x;
+    const uint row_head = tid.y;
+    if (column >= 256 || row_head >= ulong(args.rows) * args.heads) return;
+
+    const ulong from = ulong(row_head) * 512;
+    const ulong wv = (ulong(row_head % args.heads) * 256 + column) * 512;
+    float sum = 0.0f;
+    for (uint i = 0; i < 512; ++i) {
+        sum = fma(hy4_mla_value(latent[from + i]), hy4_mla_value(value_projection[wv + i]), sum);
+    }
+    expanded[ulong(row_head) * 256 + column] = hy4_mla_round(sum);
+}
+
+// tf_hy4_expand_v then tf_hy4_gate_values in one launch
+kernel void tf_hy4_expand_v_gated(
+    const device ushort *latent [[buffer(0)]],
+    const device ushort *value_projection [[buffer(1)]],
+    device ushort *expanded [[buffer(2)]],
+    constant Hy4MlaProjectArgs &args [[buffer(3)]],
+    const device ushort *logits [[buffer(4)]],
+    uint2 tid [[thread_position_in_grid]]) {
+    const uint column = tid.x;
+    const uint row_head = tid.y;
+    if (column >= 256 || row_head >= ulong(args.rows) * args.heads) return;
+
+    const ulong from = ulong(row_head) * 512;
+    const ulong wv = (ulong(row_head % args.heads) * 256 + column) * 512;
+    float sum = 0.0f;
+    for (uint i = 0; i < 512; ++i) {
+        sum = fma(hy4_mla_value(latent[from + i]), hy4_mla_value(value_projection[wv + i]), sum);
+    }
+    const ulong at = ulong(row_head) * 256 + column;
+    const ushort value = hy4_mla_round(sum);
+    const float gate = 1.0f / (1.0f + precise::exp(-hy4_mla_value(logits[at])));
+    expanded[at] = hy4_mla_round(hy4_mla_value(value) * hy4_mla_value(hy4_mla_round(gate)));
+}
diff --git a/zig/kernels/metal/hy4_flash/route_rows.metal b/zig/kernels/metal/hy4_flash/route_rows.metal
new file mode 100644
index 0000000000000000000000000000000000000000..0dffb2a09541160daa9966c23f1ea704415dcf93
--- /dev/null
+++ b/zig/kernels/metal/hy4_flash/route_rows.metal
@@ -0,0 +1,77 @@
+
+// Appended to the core router source (its TF_E, TF_TOPK, PER, RouteArgs and tf_sigmoid_precise).
+[[kernel]] void tf_hy4_route_select_rows(const device float* LOGITS [[buffer(0)]], const device float* BIAS [[buffer(1)]],
+                                         constant RouteArgs& a [[buffer(2)]], device int* PICK [[buffer(3)]],
+                                         device float* WTS [[buffer(4)]], uint r_ [[threadgroup_position_in_grid]],
+                                         uint lane [[thread_index_in_simdgroup]]) {
+  const int r = int(r_);
+  if (r >= a.rows) return;
+  float c[PER], sc[PER];
+  for (int j = 0; j < PER; j++) {
+    const int id = j * 32 + int(lane);
+    if (id < TF_E) {
+      sc[j] = tf_sigmoid_precise(LOGITS[r * TF_E + id]);
+      c[j] = sc[j] + BIAS[id];
+    } else {
+      sc[j] = 0.0f; c[j] = -INFINITY;
+    }
+  }
+  float w[TF_TOPK];
+  for (int k = 0; k < TF_TOPK; k++) {
+    float best = -INFINITY, bsc = 0.0f;
+    int bid = TF_E;
+    for (int j = 0; j < PER; j++) {
+      const int id = j * 32 + int(lane);
+      if (id < TF_E && (c[j] > best || (c[j] == best && id < bid))) { best = c[j]; bid = id; bsc = sc[j]; }
+    }
+    for (int off = 16; off > 0; off /= 2) {
+      const float ob = simd_shuffle_xor(best, off);
+      const int oi = simd_shuffle_xor(bid, off);
+      const float os = simd_shuffle_xor(bsc, off);
+      if (ob > best || (ob == best && oi < bid)) { best = ob; bid = oi; bsc = os; }
+    }
+    w[k] = bsc;
+    if (int(lane) == bid % 32) c[bid / 32] = -INFINITY;
+    if (lane == 0) PICK[r * TF_TOPK + k] = bid;
+  }
+  if (lane == 0) {
+    float total = w[0];
+    for (int k = 1; k < TF_TOPK; k++) total = total + w[k];
+    for (int k = 0; k < TF_TOPK; k++) WTS[r * TF_TOPK + k] = (w[k] / total) * a.scale;
+  }
+}
+
+// tf_hy4_route_select_rows as ranks: one thread an expert (TF_E <= 512, threadgroup 512)
+[[kernel]] void tf_hy4_route_select_rank(const device float* LOGITS [[buffer(0)]], const device float* BIAS [[buffer(1)]],
+                                         constant RouteArgs& a [[buffer(2)]], device int* PICK [[buffer(3)]],
+                                         device float* WTS [[buffer(4)]], uint r_ [[threadgroup_position_in_grid]],
+                                         uint t [[thread_index_in_threadgroup]]) {
+  threadgroup float cs[512];
+  threadgroup float w[TF_TOPK];
+  const int r = int(r_), id = int(t);
+  if (r >= a.rows) return;
+  float sc = 0.0f, c = -INFINITY;
+  if (id < TF_E) {
+    sc = tf_sigmoid_precise(LOGITS[r * TF_E + id]);
+    c = sc + BIAS[id];
+  }
+  cs[t] = c;
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (id < TF_E) {
+    int rank = 0;
+    for (int j = 0; j < TF_E; ++j) {
+      const float o = cs[j];
+      rank += (o > c || (o == c && j < id)) ? 1 : 0;
+    }
+    if (rank < TF_TOPK) {
+      PICK[r * TF_TOPK + rank] = id;
+      w[rank] = sc;
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (t == 0) {
+    float total = w[0];
+    for (int k = 1; k < TF_TOPK; k++) total = total + w[k];
+    for (int k = 0; k < TF_TOPK; k++) WTS[r * TF_TOPK + k] = (w[k] / total) * a.scale;
+  }
+}
diff --git a/zig/kernels/metal/hy4_flash/rows.metal b/zig/kernels/metal/hy4_flash/rows.metal
new file mode 100644
index 0000000000000000000000000000000000000000..74bc8e330a3c71124fc23612051a341210d2f517
--- /dev/null
+++ b/zig/kernels/metal/hy4_flash/rows.metal
@@ -0,0 +1,86 @@
+
+// Hy4-flash lane windows (compiled after the chip's core row projection source, whose helpers it calls).
+template <int RPS, int MB, int BITS, bool SH>
+inline void tf_hy4_rows_block(const device uint8_t* wr, const device bfloat* sr, const device bfloat* br,
+                              const device bfloat* X, int K, int N, int GS, int m, int row0, uint lane,
+                              device bfloat* OUT) {
+  float acc[MB][RPS];
+  tf_rp_rows<RPS, MB, BITS, false, SH && (MB >= 3)>(wr, sr, br, X + size_t(m) * K, K, GS, lane, acc);
+  if (lane == 0)
+    for (int b = 0; b < MB; b++)
+      for (int j = 0; j < RPS; j++) OUT[size_t(m + b) * N + row0 + j] = tf_rp_out<false>(acc[b][j]);
+}
+
+// dims: K, N, GS, rows (as tf_row_projection). X [rows, K]; W [N, K*BITS/32] words; S, B [N, K/GS].
+template <int RPS, int SG, int BITS, bool SH = false>
+[[kernel]] void tf_hy4_rows(const device bfloat* X [[buffer(0)]], const device uint32_t* W [[buffer(1)]],
+                            const device bfloat* S [[buffer(2)]], const device bfloat* B [[buffer(3)]],
+                            constant int* dims [[buffer(4)]], device bfloat* OUT [[buffer(5)]],
+                            uint sg [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]],
+                            uint3 tg [[threadgroup_position_in_grid]]) {
+  const int K = dims[0], N = dims[1], GS = dims[2], rows = dims[3];
+  const int row0 = (int(tg.x) * SG + int(sg)) * RPS;
+  if (row0 >= N) return;
+  const size_t at = size_t(row0);
+  const device uint8_t* wr = (const device uint8_t*)W + at * (K * BITS / 8);
+  const device bfloat* sr = S + at * (K / GS);
+  const device bfloat* br = B + at * (K / GS);
+  int m = 0;
+  #pragma clang loop unroll(disable)
+  for (; m + 8 <= rows; m += 8) tf_hy4_rows_block<RPS, 8, BITS, SH>(wr, sr, br, X, K, N, GS, m, row0, lane, OUT);
+  if (m + 6 <= rows) {
+    tf_hy4_rows_block<RPS, 6, BITS, SH>(wr, sr, br, X, K, N, GS, m, row0, lane, OUT);
+    m += 6;
+  } else if (m + 4 <= rows) {
+    tf_hy4_rows_block<RPS, 4, BITS, SH>(wr, sr, br, X, K, N, GS, m, row0, lane, OUT);
+    m += 4;
+  }
+  if (m + 2 <= rows) {
+    tf_hy4_rows_block<RPS, 2, BITS, SH>(wr, sr, br, X, K, N, GS, m, row0, lane, OUT);
+    m += 2;
+  }
+  if (m < rows) tf_hy4_rows_block<RPS, 1, BITS, SH>(wr, sr, br, X, K, N, GS, m, row0, lane, OUT);
+}
+
+template [[host_name("tf_hy4_rows_r2_q4")]] [[kernel]] decltype(tf_hy4_rows<2, 4, 4>) tf_hy4_rows<2, 4, 4>;
+template [[host_name("tf_hy4_rows_r2_q8")]] [[kernel]] decltype(tf_hy4_rows<2, 4, 8>) tf_hy4_rows<2, 4, 8>;
+template [[host_name("tf_hy4_rows_r4_q4")]] [[kernel]] decltype(tf_hy4_rows<4, 4, 4>) tf_hy4_rows<4, 4, 4>;
+template [[host_name("tf_hy4_rows_r4_q8")]] [[kernel]] decltype(tf_hy4_rows<4, 4, 8>) tf_hy4_rows<4, 4, 8>;
+template [[host_name("tf_hy4_rows_r2s_q4")]] [[kernel]] decltype(tf_hy4_rows<2, 4, 4, true>) tf_hy4_rows<2, 4, 4, true>;
+template [[host_name("tf_hy4_rows_r2s_q8")]] [[kernel]] decltype(tf_hy4_rows<2, 4, 8, true>) tf_hy4_rows<2, 4, 8, true>;
+template [[host_name("tf_hy4_rows_r1s_q4")]] [[kernel]] decltype(tf_hy4_rows<1, 8, 4, true>) tf_hy4_rows<1, 8, 4, true>;
+template [[host_name("tf_hy4_rows_r1s_q8")]] [[kernel]] decltype(tf_hy4_rows<1, 8, 8, true>) tf_hy4_rows<1, 8, 8, true>;
+template [[host_name("tf_hy4_rows_r1_q4")]] [[kernel]] decltype(tf_hy4_rows<1, 8, 4>) tf_hy4_rows<1, 8, 4>;
+template [[host_name("tf_hy4_rows_r1_q8")]] [[kernel]] decltype(tf_hy4_rows<1, 8, 8>) tf_hy4_rows<1, 8, 8>;
+
+// Greedy pick on the GPU: the first index of a row's largest BF16 logit (NaN never wins), as the host's scan.
+[[kernel]] void tf_hy4_argmax(const device ushort* logits [[buffer(0)]], device uint* out [[buffer(1)]],
+                              constant uint2& a [[buffer(2)]], uint row [[threadgroup_position_in_grid]],
+                              uint t [[thread_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]],
+                              uint sg [[simdgroup_index_in_threadgroup]]) {
+  const device ushort* x = logits + size_t(row) * a.x;
+  float best = -INFINITY;
+  uint id = 0xffffffffu;
+  for (uint i = t; i < a.x; i += 1024) {
+    const float v = as_type<float>(uint(x[i]) << 16);
+    if (v > best) { best = v; id = i; }
+  }
+  for (ushort o = 16; o > 0; o >>= 1) {
+    const float ov = simd_shuffle_xor(best, o);
+    const uint oi = simd_shuffle_xor(id, o);
+    if (ov > best || (ov == best && oi < id)) { best = ov; id = oi; }
+  }
+  threadgroup float bv[32];
+  threadgroup uint bi[32];
+  if (lane == 0) { bv[sg] = best; bi[sg] = id; }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (sg == 0) {
+    best = bv[lane]; id = bi[lane];
+    for (ushort o = 16; o > 0; o >>= 1) {
+      const float ov = simd_shuffle_xor(best, o);
+      const uint oi = simd_shuffle_xor(id, o);
+      if (ov > best || (ov == best && oi < id)) { best = ov; id = oi; }
+    }
+    if (lane == 0) out[a.y + row] = id;
+  }
+}
