diff --git a/zig/src/cuda/hy4_column_plan.zig b/zig/src/cuda/hy4_column_plan.zig
new file mode 100644
index 0000000000000000000000000000000000000000..02438774c8da6b03a161f6f07183833cb20cfffc
--- /dev/null
+++ b/zig/src/cuda/hy4_column_plan.zig
@@ -0,0 +1,47 @@
+//! Match the full-width reduction order on disjoint Hy4 output-column slices.
+const std = @import("std");
+const lt = @import("cublaslt.zig");
+
+fn planFailure(err: lt.Error) (lt.Error || error{Hy4ColumnPlanFailed}) {
+    return switch (err) {
+        error.CublasFailed => error.Hy4ColumnPlanFailed,
+        else => err,
+    };
+}
+
+fn checkStatus(lib: anytype, status: lt.Status, op: []const u8) !void {
+    if (status == 15) return error.NoMatchingHy4ColumnPlan; // CUBLAS_STATUS_NOT_SUPPORTED
+    lib.check(status, op) catch |err| return planFailure(err);
+}
+
+/// For disjoint output rows, check and reuse the full-width GEMM algorithm before the first launch.
+pub fn matchColumnPlan(reference: *const lt.Linear, local: *lt.Linear, workspace_bytes: usize) !void {
+    var checked: lt.Heuristic = undefined;
+    try checkStatus(local.lt, local.lt.api.cublasLtMatmulAlgoCheck(local.handle, local.desc, local.a, local.b, local.c, local.c, &reference.algo, &checked), "check full-width column algorithm");
+    try checkStatus(local.lt, checked.state, "full-width column algorithm state");
+    if (checked.workspace_size > workspace_bytes) return error.NoMatchingHy4ColumnPlan;
+    local.algo = reference.algo;
+    local.workspace_need = checked.workspace_size;
+}
+
+/// Next-token-only FP32 vocabulary plan, pinned to the caller's full chunk plan.
+pub fn lastHeadPlan(reference: *const lt.Linear, vocab: u32, hidden: u32, workspace_bytes: usize) !lt.Linear {
+    var last = lt.Linear.initTyped(reference.lt, 1, vocab, hidden, .f32, .f32, workspace_bytes, .none) catch |err| return planFailure(err);
+    errdefer last.deinit();
+    try matchColumnPlan(reference, &last, workspace_bytes);
+    return last;
+}
+
+test "Hy4 ABI only cuBLAS not-supported admits the column heuristic fallback" {
+    const Lib = struct {
+        fn check(_: @This(), status: lt.Status, _: []const u8) lt.Error!void {
+            if (status != 0) return error.CublasFailed;
+        }
+    };
+    try checkStatus(Lib{}, 0, "ok");
+    try std.testing.expectError(error.NoMatchingHy4ColumnPlan, checkStatus(Lib{}, 15, "unsupported"));
+    for ([_]lt.Status{ 1, 3, 7, 8, 11, 13, 14, 16 }) |rc|
+        try std.testing.expectError(error.Hy4ColumnPlanFailed, checkStatus(Lib{}, rc, "failed"));
+    try std.testing.expectEqual(error.Hy4ColumnPlanFailed, planFailure(error.CublasFailed));
+    try std.testing.expectEqual(error.NoAlgorithm, planFailure(error.NoAlgorithm));
+}
