+    .{ .image = "trunk", .symbol = "trunk_down8", .threads = 1024, .shared = 48, .dynamic = 49152, .regs = .{ 64, 64, 64, 64, 64 } },
+    .{ .image = "trunk", .symbol = "trunk_glu", .threads = 1024, .shared = 16, .dynamic = 49152, .regs = .{ 64, 64, 64, 64, 64 } },
+    .{ .image = "trunk", .symbol = "trunk_pair", .threads = 1024, .shared = 16, .dynamic = 49152, .regs = .{ 63, 63, 63, 54, 63 }, .regs_133 = .{ 63, 63, 63, 63, 63 } },
+    .{ .image = "ihc", .symbol = "expert_partial", .threads = 256, .shared = 0, .regs = .{ 16, 16, 16, 16, 16 } },
+    .{ .image = "ihc", .symbol = "rank_fold", .threads = 256, .shared = 0, .regs = .{ 16, 16, 16, 18, 18 } },
+    .{ .image = "ihc", .symbol = "ihc_add", .threads = 256, .shared = 0, .regs = .{ 14, 14, 14, 14, 14 } },
+    .{ .image = "ihc", .symbol = "ihc_partials", .threads = 512, .shared = 8192, .regs = .{ 29, 34, 34, 38, 38 } },
+    .{ .image = "ihc", .symbol = "ihc_norm", .threads = 256, .shared = 48, .regs = .{ 40, 40, 40, 40, 40 } },
+    .{ .image = "ihc", .symbol = "ihc_read", .threads = 512, .shared = 8244, .regs = .{ 40, 40, 40, 40, 40 } },
+    .{ .image = "ihc", .symbol = "head_bf16", .threads = 128, .shared = 20480, .regs = .{ 96, 96, 96, 96, 96 } },
+    .{ .image = "ihc", .symbol = "ihc_collapse", .threads = 256, .shared = 304, .regs = .{ 64, 63, 63, 48, 48 }, .regs_133 = .{ 64, 63, 63, 40, 40 } },
+    .{ .image = "mla_project", .symbol = "attn_front", .threads = 128, .shared = 3072, .regs = .{ 30, 33, 33, 40, 40 } },
+    .{ .image = "mla_project", .symbol = "project_q", .threads = 128, .shared = 0, .regs = .{ 32, 33, 33, 40, 44 }, .regs_133 = .{ 32, 33, 33, 40, 40 } },
+    .{ .image = "mla_project", .symbol = "cache_k", .threads = 128, .shared = 16, .regs = .{ 24, 24, 24, 30, 30 } },
+    .{ .image = "mla_project", .symbol = "gated_value", .threads = 128, .shared = 16, .regs = .{ 18, 23, 18, 26, 26 } },
+    .{ .image = "mla_project", .symbol = "gated_value_rows", .threads = 128, .shared = 16512, .regs = .{ 56, 62, 62, 60, 60 } },
+    .{ .image = "mla_attention", .symbol = "scores", .threads = 128, .shared = 8320, .regs = .{ 126, 124, 124, 111, 111 } },
+    .{ .image = "mla_attention", .symbol = "context", .threads = 128, .shared = 2176, .regs = .{ 64, 56, 56, 48, 48 } },
+    .{ .image = "mla_attention", .symbol = "context_group", .threads = 32, .shared = 0, .regs = .{ 70, 104, 85, 64, 64 }, .regs_133 = .{ 70, 104, 85, 62, 62 } },
+    .{ .image = "attention_sink", .symbol = "softmax", .threads = 128, .shared = 16, .regs = .{ 20, 22, 22, 22, 22 } },
+    .{ .image = "token_indexer", .symbol = "index_linear", .threads = 128, .shared = 0, .regs = .{ 32, 34, 34, 44, 40 }, .regs_133 = .{ 32, 34, 34, 40, 40 } },
+    .{ .image = "token_indexer", .symbol = "index_prepare", .threads = 128, .shared = 528, .regs = .{ 21, 21, 21, 27, 27 } },
+    .{ .image = "token_indexer", .symbol = "index_scores", .threads = 128, .shared = 0, .regs = .{ 63, 56, 56, 63, 63 } },
+    .{ .image = "token_indexer", .symbol = "index_scores_rows", .threads = 256, .shared = 2048, .regs = .{ 58, 58, 58, 62, 62 } },
+    .{ .image = "token_indexer", .symbol = "index_select", .threads = 256, .shared = 33864, .regs = .{ 50, 65, 65, 56, 56 }, .regs_133 = .{ 50, 65, 65, 50, 50 } },
+};
+
+/// Use the tree's cubin reader and limits checker on the actual embedded images.
+/// A single-SM build checks that SM. A release image checks every SM it contains.
+pub fn audit(comptime contract: type, comptime blobs: type) !void {
+    const a = std.testing.allocator;
+    var diagnostics: std.ArrayList(u8) = .empty;
+    defer diagnostics.deinit(a);
+    var count: usize = 0;
+    inline for (records) |r| {
+        const launch: contract.limits.CudaLaunch = .{ .name = "full_hy4_" ++ r.symbol, .image = "full_hy4_" ++ r.image, .symbol = "tf_full_hy4_" ++ r.symbol, .threads = r.threads, .dynamic = r.dynamic, .opt_in = r.dynamic != 0 };
+        const images = try contract.cubin.images(a, @field(blobs, launch.image));
+        defer contract.cubin.freeImages(a, images);
+        try std.testing.expect(images.len != 0);
+        for (images) |img| {
+            const compiled = try contract.cubin.kernels(a, img.elf, img.sm);
+            defer a.free(compiled);
+            const u = for (compiled) |kernel| {
+                if (std.mem.eql(u8, kernel.name, launch.symbol)) break kernel.usage;
+            } else return error.MissingHy4Kernel;
+            try std.testing.expectEqual(r.threads, u.bound);
+            const release = try contract.cubin.release(a, img.elf);
+            for (contract.limits.sms, 0..) |sm, i| {
+                if (sm.sm != img.sm) continue;
+                if (release) |v| if (v.major == 13 and (v.minor == 0 or v.minor == 3)) {
+                    const regs = if (v.minor == 3) r.regs_133 orelse r.regs else r.regs;
+                    try std.testing.expectEqual(regs[i], u.regs);
+                    try std.testing.expectEqual(r.shared, u.static);
+                };
+                if (try contract.limits.cuda(launch, u, sm, &diagnostics, a) != 0) {
+                    std.debug.print("{s}", .{diagnostics.items});
+                    return error.Hy4LaunchLimit;
+                }
+                count += 1;
+            }
+        }
+    }
+    std.debug.print("Hy4 launch records {d} image/symbol checks\n", .{count});
+}
diff --git a/zig/kernels/cuda/contract_hy4_long.zig b/zig/kernels/cuda/contract_hy4_long.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ade1411a746959bca17ac3d7eb36cac6dfd07b4a
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_long.zig
@@ -0,0 +1,336 @@
+//! Long-history device checks through the same MLA and iHC wrappers as serving.
+const std = @import("std");
+const ops = @import("cuda").hy4_ops;
+const Rig = @import("rig").Rig;
+const bf = @import("bf16_round");
+const t = std.testing;
+
+fn zeros(a: std.mem.Allocator, comptime T: type, n: usize) ![]T {
+    const values = try a.alloc(T, n);
+    @memset(values, 0);
+    return values;
+}
+
+pub fn late(r: *Rig, k: *const ops.Kernels) !void {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const history = 131072;
+    const first = history - 2;
+    const heads = 16;
+    const shape: ops.MlaShape = .{
+        .rows = 2,
+        .heads = heads,
+        .capacity = history,
+        .key_count = history,
+        .first_pos = first,
+        .latent = 1,
+        .nope = 1,
+        .rope = 2,
+        .value = 1,
+    };
+    const cache = try zeros(a, u16, history * 3);
+    cache[first * 3] = bf.bits(4);
+    cache[(first + 1) * 3] = bf.bits(12);
+    cache[first * 3 + 1] = bf.bits(128);
+    cache[(first + 1) * 3 + 1] = bf.bits(128);
+    const q: [2 * heads][3]u16 = @splat(.{ 0, bf.bits(1), 0 });
+    const weights: [heads][2]u16 = @splat(.{ 0, bf.bits(1) });
+    const gate: [2 * heads]u16 = @splat(0);
+    const sinks: [heads]f32 = @splat(bf.round32(128 / @sqrt(@as(f32, 3))));
+    const n = try ops.scratchBytes(shape);
+    var b: ops.MlaAttend = .{
+        .cache = try r.input(std.mem.sliceAsBytes(cache)),
+        .absorbed_q = try r.input(std.mem.asBytes(&q)),
+        .kv_b = try r.input(std.mem.asBytes(&weights)),
+        .gate = try r.input(std.mem.asBytes(&gate)),
+        .sinks = try r.input(std.mem.asBytes(&sinks)),
+        .scratch = try r.scratch(n),
+        .scratch_bytes = n,
+        .output = try r.output(2 * heads * 2),
+    };
+    try ops.mlaAttend(k, r.s, shape, b);
+    const ref = try a.dupe(u8, try r.bytes(b.output, 2 * heads * 2));
+    const expected = [_]u16{ bf.bits(1), bf.bits(bf.round32(1.0 / 3.0) * 8) };
+    const words = std.mem.bytesAsSlice(u16, ref);
+    for (0..2) |row| for (words[row * heads ..][0..heads]) |v| try t.expectEqual(expected[row], v);
+
+    // The first query cannot read the second winner. Indexer IDs are absolute.
+    var ids: [2][2048]i32 = @splat(@splat(-1));
+    for (&ids) |*row| {
+        row[2045] = 0;
+        row[2046] = first;
+        row[2047] = first + 1;
+    }
+    var sparse = shape;
+    sparse.key_count = 2048;
+    b.indices = try r.input(std.mem.asBytes(&ids));
+    try ops.mlaAttend(k, r.s, sparse, b);
+    try t.expectEqualSlices(u8, ref, try r.bytes(b.output, ref.len));
+
+    // Poison all old keys. Dense and selected calls must exclude them before
+    // scoring AND before value accumulation (zero times NaN would leak).
+    @memset(cache[0 .. first * 3], 0xffff);
+    b.cache = try r.input(std.mem.sliceAsBytes(cache));
+    try ops.mlaAttendWindow(k, r.s, sparse, b, first);
+    try t.expectEqualSlices(u8, ref, try r.bytes(b.output, ref.len));
+    b.indices = 0;
+    var cold = shape;
+    cold.key_count = 2;
+    try ops.mlaAttendWindow(k, r.s, cold, b, first);
+    try t.expectEqualSlices(u8, ref, try r.bytes(b.output, ref.len));
+    try t.expectError(error.ShortHy4DensePrefix, ops.mlaAttend(k, r.s, cold, b));
+    try ops.mlaAttend(k, r.s, shape, b);
+    const poisoned = std.mem.bytesAsSlice(u16, try r.bytes(b.output, ref.len));
+    for (poisoned) |v| try t.expect(std.math.isNan(bf.value(v)));
+
+    // A stale selection drops the late winner on row 1. The exact gate must fail.
+    ids[1][2047] = -1;
+    b.indices = try r.input(std.mem.asBytes(&ids));
+    try ops.mlaAttendWindow(k, r.s, sparse, b, first);
+    const stale = std.mem.bytesAsSlice(u16, try r.bytes(b.output, ref.len));
+    for (stale[heads..]) |v| try t.expectEqual(expected[0], v);
+    try t.expect(stale[heads] != expected[1]);
+    std.debug.print("Hy4 128K dense/selected/cold: last two winners exact for 16 heads; stale pick changed {d} to {d}, poisoned warm control NaN\n", .{ bf.value(expected[1]), bf.value(stale[heads]) });
+}
+
+pub fn ihc(r: *Rig, k: *const ops.Kernels) !void {
+    const rows = 131072;
+    const x = try t.allocator.alloc(u16, rows * 4);
+    defer t.allocator.free(x);
+    for (0..rows) |i| @memset(x[i * 4 ..][0..4], bf.bits(@floatFromInt(i % 7 + 1)));
+    const projection: [8 * 4]f32 = @splat(0);
+    const base: [8]f32 = @splat(0);
+    const scale = [_]f32{ 1, 1 };
+    const shape: ops.IhcShape = .{ .rows = rows, .width = 1, .hc_eps = 0 };
+    const b: ops.IhcRead = .{
+        .streams = try r.input(std.mem.sliceAsBytes(x)),
+        .projection = try r.input(std.mem.asBytes(&projection)),
+        .base = try r.input(std.mem.asBytes(&base)),
+        .scale = try r.input(std.mem.asBytes(&scale)),
+        .output = try r.output(rows * 2),
+        .post = try r.output(rows * 16),
+    };
+    try ops.ihcRead(k, r.s, shape, b);
+    const read = try t.allocator.dupe(u8, try r.bytes(b.output, rows * 2));
+    defer t.allocator.free(read);
+    for (std.mem.bytesAsSlice(u16, read), 0..) |v, i| try t.expectEqual(bf.bits(@floatFromInt(2 * (i % 7 + 1))), v);
+    try ops.ihcHead(k, r.s, shape, b);
+    try t.expectEqualSlices(u8, read, try r.bytes(b.output, rows * 2));
+    try ops.ihcWrite(k, r.s, shape, .{ .residual = b.streams, .branch = b.output, .post = b.post, .output = b.streams });
+    const mixed = std.mem.bytesAsSlice(u16, try r.bytes(b.streams, rows * 8));
+    for (0..rows) |i| for (mixed[i * 4 ..][0..4]) |v| try t.expectEqual(bf.bits(@floatFromInt(3 * (i % 7 + 1))), v);
+    std.debug.print("Hy4 iHC read/head/write exact on all 131072 rows\n", .{});
+}
+
+// Process just this query slice. KV storage stays at its absolute sequence base.
+fn chunk(r: *Rig, k: *const ops.Kernels, shape: ops.MlaShape, project: ops.MlaProject, attend: ops.MlaAttend, first: u32, count: u32) !void {
+    var s = shape;
+    s.first_pos = first;
+    s.rows = count;
+    var p = project;
+    p.q += @as(u64, first) * s.q_row_stride * 2;
+    p.kv += @as(u64, first) * s.kv_row_stride * 2;
+    p.absorbed_q += @as(u64, first) * s.absorbed_row_stride * 2;
+    var b = attend;
+    b.absorbed_q = p.absorbed_q;
+    b.cache = p.cache;
+    b.gate += @as(u64, first) * s.value_row_stride * 2;
+    b.output += @as(u64, first) * s.value_row_stride * 2;
+    if (b.indices != 0) {
+        b.indices += @as(u64, first) * s.index_row_stride * 4;
+    } else s.key_count = first + count;
+    try ops.mlaProject(k, r.s, s, p);
+    try ops.mlaAttend(k, r.s, s, b);
+}
+
+fn sequence(r: *Rig, k: *const ops.Kernels, rows: u32, dense: bool) !void {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const shape: ops.MlaShape = .{
+        .rows = rows,
+        .capacity = rows,
+        .heads = 2,
+        .key_count = if (dense) rows else 4,
+        .latent = 8,
+        .nope = 4,
+        .rope = 4,
+        .value = 4,
+        .q_row_stride = 18,
+        .absorbed_row_stride = 25,
+        .kv_row_stride = 13,
+        .cache_stride = 13,
+        .value_row_stride = 9,
+        .index_row_stride = if (dense) 0 else 5,
+    };
+    var prng = std.Random.DefaultPrng.init(0x54494c45);
+    const q = try a.alloc(u16, rows * 18);
+    const kv = try a.alloc(u16, rows * 13);
+    const gate = try a.alloc(u16, rows * 9);
+    var w: [2 * 8 * 8]u16 = undefined;
+    for ([_][]u16{ q, kv, gate, &w }) |values| {
+        for (values) |*v| v.* = bf.bits(prng.random().float(f32) * 2 - 1);
+    }
+    const gains: [8]u16 = @splat(bf.bits(1));
+    const sinks = [_]f32{ 0.125, -0.5 };
+    const ids = try a.alloc(i32, rows * 5);
+    for (0..rows) |i| {
+        const row: i32 = @intCast(i);
+        ids[i * 5 ..][0..5].* = .{ if (row >= 128) row - 128 else -1, if (row > 0) row - 1 else -1, row, -1, 0x7fffffff };
+    }
+    var p: ops.MlaProject = .{
+        .q = try r.input(std.mem.sliceAsBytes(q)),
+        .kv = try r.input(std.mem.sliceAsBytes(kv)),
+        .kv_b = try r.input(std.mem.asBytes(&w)),
+        .kv_norm = try r.input(std.mem.asBytes(&gains)),
+        .cache = try r.output(rows * 13 * 2),
+        .absorbed_q = try r.output(rows * 25 * 2),
+    };
+    const n = try ops.scratchBytes(shape);
+    var b: ops.MlaAttend = .{
+        .kv_b = p.kv_b,
+        .cache = p.cache,
+        .absorbed_q = p.absorbed_q,
+        .gate = try r.input(std.mem.sliceAsBytes(gate)),
+        .sinks = try r.input(std.mem.asBytes(&sinks)),
+        .indices = if (dense) 0 else try r.input(std.mem.sliceAsBytes(ids)),
+        .scratch = try r.scratch(n),
+        .scratch_bytes = n,
+        .output = try r.output(rows * 9 * 2),
+    };
+    try chunk(r, k, shape, p, b, 0, rows);
+    const ref = try a.dupe(u8, try r.bytes(b.output, rows * 9 * 2));
+    const history = try a.dupe(u8, try r.bytes(p.cache, rows * 13 * 2));
+    const words = std.mem.bytesAsSlice(u16, ref);
+    for (0..rows) |row| {
+        for (words[row * 9 ..][0..8]) |v| try t.expect(std.math.isFinite(bf.value(v)));
+        try t.expectEqual(@as(u16, 0xffff), words[row * 9 + 8]);
+    }
+
+    p.cache = try r.output(history.len);
+    p.absorbed_q = try r.output(rows * 25 * 2);
+    b.output = try r.output(ref.len);
+    var first: u32 = 0;
+    while (first < rows - 1) {
+        const count = @min(511, rows - 1 - first);
+        try chunk(r, k, shape, p, b, first, count);
+        first += count;
+    }
+    try chunk(r, k, shape, p, b, first, 1); // cached decode of last token
+    try t.expectEqualSlices(u8, ref, try r.bytes(b.output, ref.len));
+    try t.expectEqualSlices(u8, history, try r.bytes(p.cache, history.len));
+    std.debug.print("Hy4 {s} plain vs 511-row chunks + final decode: T={d} exact outputs={d} BF16 cache elements={d}\n", .{ if (dense) "dense" else "selected", rows, rows * 8, rows * 12 });
+}
+
+pub fn prefill(r: *Rig, k: *const ops.Kernels) !void {
+    try sequence(r, k, 2113, true);
+    try t.expect(try r.intact());
+    r.reset();
+    for ([_]u32{ 8192, 32768, 131072 }) |rows| {
+        try sequence(r, k, rows, false);
+        try t.expect(try r.intact());
+        r.reset();
+    }
+}
+
+// A single real-size cache layer, with generated weights. Only selected rows
+// of the latent cache are initialized. The indexer's output goes straight into MLA.
+pub fn selectedLayer(r: *Rig, k: *const ops.Kernels) !void {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const cap = 131072;
+    const last = cap - 1;
+    const keep = 2048;
+    const ix: ops.IndexShape = .{
+        .rows = 1,
+        .capacity = cap,
+        .first_pos = last,
+        .x_row_stride = 0,
+        .q_row_stride = 0,
+        .cache_stride = 0,
+        .indices_stride = 0,
+    };
+    const resid = try zeros(a, u16, 2048);
+    resid[0] = bf.bits(1);
+    const x = try zeros(a, u16, 6144);
+    x[0] = bf.bits(1);
+    const wq = try zeros(a, u16, 32 * 128 * 2048);
+    const head = try zeros(a, f32, 32 * 6144);
+    for (0..32) |h| {
+        wq[h * 128 * 2048] = bf.bits(1);
+        head[h * 6144] = 1;
+    }
+    const wk = try zeros(a, u16, 128 * 6144);
+    const norm: [128]f32 = @splat(1);
+    var bias: [128]f32 = @splat(0);
+    bias[0] = 101;
+    const history = try zeros(a, u16, cap * 128);
+    history[(last - 1) * 128] = bf.bits(100);
+    const n = try ops.indexScratchBytes(ix);
+    var ib: ops.IndexBuffers = .{
+        .q_resid = try r.input(std.mem.sliceAsBytes(resid)),
+        .x = try r.input(std.mem.sliceAsBytes(x)),
+        .wq_b = try r.input(std.mem.sliceAsBytes(wq)),
+        .wk = try r.input(std.mem.sliceAsBytes(wk)),
+        .weights_proj = try r.input(std.mem.sliceAsBytes(head)),
+        .k_norm = try r.input(std.mem.asBytes(&norm)),
+        .k_bias = try r.input(std.mem.asBytes(&bias)),
+        .cache = try r.input(std.mem.sliceAsBytes(history)),
+        .indices = try r.output(keep * 4),
+        .scratch_bytes = n,
+        .scratch = try r.scratch(n + (24 << 10)),
+    };
+    // Starts 13 and 0 cover a short final page, ties between pages, and both allocations.
+    for ([_]u32{ 13, 0 }) |start| {
+        for ([_]usize{ n, n + (24 << 10) - 1, n + (24 << 10) }) |available| {
+            ib.scratch_bytes = available;
+            try r.zero(ib.indices, keep * 4);
+            try ops.selectTokensWindow(k, r.s, ix, ib, start);
+            const ids = std.mem.bytesAsSlice(i32, try r.bytes(ib.indices, keep * 4));
+            for (ids[0 .. keep - 2], 0..) |id, j| try t.expectEqual(@as(i32, @intCast(start + j)), id);
+            try t.expectEqual(@as(i32, last - 1), ids[keep - 2]);
+            try t.expectEqual(@as(i32, last), ids[keep - 1]);
+        }
+    }
+
+    const heads = 64;
+    const att: ops.MlaShape = .{ .rows = 1, .heads = heads, .capacity = cap, .first_pos = last, .key_count = keep };
+    const cache_bytes = cap * 576 * 2;
+    const cache: @import("cuda").DeviceBuffer = .{ .d = r.s.d, .ptr = try r.output(cache_bytes), .len = cache_bytes };
+    try r.zero(cache.ptr, (keep - 2) * 576 * 2);
+    var late_keys: [2][576]u16 = @splat(@splat(0));
+    late_keys[0][0] = bf.bits(4);
+    late_keys[1][0] = bf.bits(12);
+    late_keys[0][512] = bf.bits(1024);
+    late_keys[1][512] = bf.bits(1024);
+    try cache.upload((last - 1) * 576 * 2, std.mem.asBytes(&late_keys));
+    const q = try zeros(a, u16, heads * 576);
+    const kv_b = try zeros(a, u16, heads * (192 + 256) * 512);
+    for (0..heads) |h| {
+        q[h * 576 + 512] = bf.bits(1);
+        kv_b[(h * (192 + 256) + 192) * 512] = bf.bits(1);
+    }
+    const gate = try zeros(a, u16, heads * 256);
+    const sinks: [heads]f32 = @splat(64);
+    const bytes = try ops.scratchBytes(att);
+    const b: ops.MlaAttend = .{
+        .cache = cache.ptr,
+        .absorbed_q = try r.input(std.mem.sliceAsBytes(q)),
+        .indices = ib.indices,
+        .kv_b = try r.input(std.mem.sliceAsBytes(kv_b)),
+        .gate = try r.input(std.mem.sliceAsBytes(gate)),
+        .sinks = try r.input(std.mem.asBytes(&sinks)),
+        .scratch = try r.scratch(bytes),
+        .scratch_bytes = bytes,
+        .output = try r.output(heads * 256 * 2),
+    };
+    try ops.mlaAttend(k, r.s, att, b);
+    const out = std.mem.bytesAsSlice(u16, try r.bytes(b.output, heads * 256 * 2));
+    for (0..heads) |h| {
+        try t.expectEqual(bf.bits(bf.round32(1.0 / 3.0) * 8), out[h * 256]);
+        for (out[h * 256 + 1 ..][0..255]) |value| try t.expectEqual(@as(u16, 0), value);
+    }
+    std.debug.print("Hy4 checkpoint dimensions T=131072: 2048 exact index IDs include 131070 and 131071; all 16384 gated MLA values exact, unselected cache poisoned\n", .{});
+}
