+        const mid = work.ptr + m_count * out_d * 2;
+        try self.vk.mergeGather(self.stream, normed.ptr, gathered, gh, gw, d);
+        try cuda.vit.linearAct(&self.gemm, &self.vit_k, self.stream, acc_f32.ptr, gathered, perc.proj0.weight, perc.proj0.bias, mid, m_count, out_d, 4 * d, null, mid, .gelu);
+        try cuda.vit.linear(&self.gemm, &self.vit_k, self.stream, acc_f32.ptr, mid, perc.proj2.weight, perc.proj2.bias, gathered, m_count, out_d, out_d);
+        try self.vk.appendNewline(self.stream, gathered, perc.image_newline, dst_ptr, hm, wm, out_d);
+    }
+};
+
+pub fn visionFrameWords(prompt_len: usize, n_spans: usize, image_tokens: usize, out_hidden_size: usize) ?usize {
+    const header_words: usize = 6;
+    const span_words = std.math.mul(usize, n_spans, 3) catch return null;
+    const thw_bytes = std.math.mul(usize, prompt_len, 12) catch return null;
+    const thw_words = (std.math.add(usize, thw_bytes, 7) catch return null) / 8;
+    const row_bytes = std.math.mul(usize, out_hidden_size, 2) catch return null;
+    const feat_bytes = std.math.mul(usize, image_tokens, row_bytes) catch return null;
+    const feat_words = (std.math.add(usize, feat_bytes, 7) catch return null) / 8;
+    const a = std.math.add(usize, header_words, span_words) catch return null;
+    const b = std.math.add(usize, a, thw_words) catch return null;
+    return std.math.add(usize, b, feat_words) catch null;
+}
+
+pub fn maxFrameImageTokens(context: usize, max_images: u32, out_hidden_size: usize) usize {
+    const base_words = visionFrameWords(context, max_images, 0, out_hidden_size) orelse return 0;
+    if (base_words >= tp.planlink.max_frame_words) return 0;
+    const rem_bytes = (tp.planlink.max_frame_words - base_words) * 8;
+    const row_bytes = out_hidden_size * 2;
+    return if (row_bytes == 0) 0 else rem_bytes / row_bytes;
+}
+
+pub fn validateStartupLimits(limits: vimg.Limits, context: usize, out_hidden_size: usize) !void {
+    const words = visionFrameWords(context, limits.max_images, limits.image_tokens, out_hidden_size) orelse return error.VisionTokensPastFrame;
+    if (words > tp.planlink.max_frame_words) return error.VisionTokensPastFrame;
+}
+
+pub const VisionRuntime = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+    cfg: vcfg.Config,
+    limits: vimg.Limits,
+    offer: vimg.VisionOffer,
+    vk: cuda.hy4_vision.Kernels,
+    encoder: ?Rank0Encoder = null,
+    slots: []SlotState,
+    chunk_map_dev: cuda.DeviceBuffer,
+    chunk_thw_dev: cuda.DeviceBuffer,
+    host_map: []i32,
+
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, stream: cuda.Stream, cfg: vcfg.Config, limits: vimg.Limits, n_slots: usize, max_chunk_rows: usize, is_rank0: bool, model_dir: []const u8) !VisionRuntime {
+        var enc: ?Rank0Encoder = if (is_rank0) try Rank0Encoder.init(gpa, io, d, stream, cfg, model_dir) else null;
+        errdefer if (enc) |*e| e.deinit();
+        return initWithEncoder(gpa, io, d, stream, cfg, limits, n_slots, max_chunk_rows, enc);
+    }
+
+    pub fn initWithEncoder(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, stream: cuda.Stream, cfg: vcfg.Config, limits: vimg.Limits, n_slots: usize, max_chunk_rows: usize, enc: ?Rank0Encoder) !VisionRuntime {
+        var vk = try cuda.hy4_vision.Kernels.load(d);
+        errdefer vk.unload();
+
+        const slots = try gpa.alloc(SlotState, n_slots);
+        errdefer gpa.free(slots);
+        var made: usize = 0;
+        errdefer for (slots[0..made]) |*s| s.deinit(gpa);
+        const row_bytes = @as(usize, limits.image_tokens) * cfg.out_hidden_size * 2;
+        for (slots) |*s| {
+            s.* = .{ .rows_dev = try cuda.DeviceBuffer.alloc(d, @max(row_bytes, 16)) };
+            made += 1;
+        }
+        var chunk_map_dev = try cuda.DeviceBuffer.alloc(d, max_chunk_rows * 4);
+        errdefer chunk_map_dev.free();
+        var chunk_thw_dev = try cuda.DeviceBuffer.alloc(d, max_chunk_rows * 3 * 4);
+        errdefer chunk_thw_dev.free();
+        const host_map = try gpa.alloc(i32, max_chunk_rows);
+        return .{
+            .gpa = gpa, .d = d, .stream = stream, .cfg = cfg, .limits = limits,
+            .offer = vimg.VisionOffer.init(io, cfg, limits), .vk = vk, .encoder = enc,
+            .slots = slots, .chunk_map_dev = chunk_map_dev, .chunk_thw_dev = chunk_thw_dev, .host_map = host_map,
+        };
+    }
+
+    pub fn deinit(self: *VisionRuntime) void {
+        self.gpa.free(self.host_map);
+        self.chunk_thw_dev.free();
+        self.chunk_map_dev.free();
+        for (self.slots) |*s| s.deinit(self.gpa);
+        self.gpa.free(self.slots);
+        if (self.encoder) |*e| e.deinit();
+        self.vk.unload();
+        self.* = undefined;
+    }
+
+    pub fn towerBytes(self: *const VisionRuntime) u64 {
+        return if (self.encoder) |e| e.tower.bytes else 0;
+    }
+
+    pub fn clearSlot(self: *VisionRuntime, slot: usize, plan_link: ?*tp.planlink.PlanLink, tp_sess: ?*boundary.TpSession) !void {
+        if (!self.slots[slot].active) return;
+        self.slots[slot].reset();
+        if (plan_link) |pl| if (pl.rank == 0) {
+            pl.send(&.{ @intFromEnum(boundary.PlanOp.vision_clear), @intCast(slot) }) catch |err| {
+                abortFanOut(pl, tp_sess);
+                return err;
+            };
+        };
+    }
+
+    pub fn prepareSlotRank0(self: *VisionRuntime, slot: usize, prompt_len: usize, images: []const lanes.stream.Image, plan_link: ?*tp.planlink.PlanLink, tp_sess: ?*boundary.TpSession) !void {
+        if (images.len == 0) return self.clearSlot(slot, plan_link, tp_sess);
+        const st_slot = &self.slots[slot];
+        st_slot.reset();
+        const enc = &(self.encoder orelse return error.NotRankZero);
+        var plan = try vimg.buildMropePlan(self.gpa, prompt_len, images, self.cfg.spatial_merge_size, self.cfg.max_vit_seq_len);
+        defer plan.deinit(self.gpa);
+        if (plan.total_image_tokens > self.limits.image_tokens) return error.Oversized;
+
+        for (images, plan.spans) |img, sp| {
+            const dst = st_slot.rows_dev.ptr + @as(u64, sp.row_offset) * self.cfg.out_hidden_size * 2;
+            try enc.encodeIntoDevice(img.gh, img.gw, img.pixels, dst);
+        }
+        try stageAndFanOutSlot(st_slot, self.gpa, slot, prompt_len, plan, self.cfg.out_hidden_size, null, self.d, self.stream, plan_link, tp_sess);
+    }
+
+    pub fn applyFollowerMsg(self: *VisionRuntime, msg: []const i64) !void {
+        const op: boundary.PlanOp = @enumFromInt(msg[0]);
+        if (op == .vision_clear) {
+            if (msg.len != 2) return error.Protocol;
+            const slot: usize = @intCast(msg[1]);
+            if (slot >= self.slots.len) return error.Protocol;
+            self.slots[slot].reset();
+            return;
+        }
+        if (msg.len < 6) return error.Protocol;
+        const slot: usize = @intCast(msg[1]);
+        const prompt_len: usize = @intCast(msg[2]);
+        const rope_delta: i32 = @intCast(msg[3]);
+        const total_tokens: u32 = @intCast(msg[4]);
+        const n_spans: usize = @intCast(msg[5]);
+        if (slot >= self.slots.len or total_tokens > self.limits.image_tokens) return error.Protocol;
+        const span_words = n_spans * 3;
+        const thw_len = prompt_len * 3;
+        const thw_words = (thw_len * 4 + 7) / 8;
+        const feat_bytes = @as(usize, total_tokens) * self.cfg.out_hidden_size * 2;
+        const feat_words = (feat_bytes + 7) / 8;
+        if (msg.len != 6 + span_words + thw_words + feat_words) return error.Protocol;
+
+        const st_slot = &self.slots[slot];
+        st_slot.reset();
+        try st_slot.spans.ensureTotalCapacity(self.gpa, n_spans);
+        for (0..n_spans) |i| {
+            st_slot.spans.appendAssumeCapacity(.{
+                .at = @intCast(msg[6 + i * 3 + 0]), .tokens = @intCast(msg[6 + i * 3 + 1]),
+                .gh = 0, .gw = 0, .row_offset = @intCast(msg[6 + i * 3 + 2]),
+            });
+        }
+        try st_slot.thw_host.resize(self.gpa, thw_len);
+        @memcpy(std.mem.sliceAsBytes(st_slot.thw_host.items), std.mem.sliceAsBytes(msg[6 + span_words ..][0..thw_words])[0 .. thw_len * 4]);
+        const feat_src = std.mem.sliceAsBytes(msg[6 + span_words + thw_words ..][0..feat_words])[0..feat_bytes];
+        try st_slot.rows_dev.uploadAsync(0, feat_src, self.stream.handle);
+        st_slot.prompt_len = prompt_len;
+        st_slot.rope_delta = rope_delta;
+        st_slot.total_tokens = total_tokens;
+        st_slot.active = true;
+    }
+
+    pub fn prepareStep(self: *VisionRuntime, slot: usize, first_pos: usize, rows: usize, streams_a_ptr: u64) !?LanePositions {
+        const st_slot = &self.slots[slot];
+        const cp = try st_slot.planChunk(first_pos, rows, self.host_map);
+        if (!cp.active) return null;
+        if (cp.thw_slice) |thw_slice| {
+            if (cp.has_overlap) {
+                try self.chunk_map_dev.uploadAsync(0, std.mem.sliceAsBytes(self.host_map[0..rows]), self.stream.handle);
+                try self.vk.spliceIhc(self.stream, st_slot.rows_dev.ptr, self.chunk_map_dev.ptr, streams_a_ptr, rows, self.cfg.out_hidden_size);
+            }
+            try self.chunk_thw_dev.uploadAsync(0, std.mem.sliceAsBytes(thw_slice), self.stream.handle);
+            return LanePositions.forStep(&self.vk, self.chunk_thw_dev.ptr, cp.prompt_len, cp.rope_delta);
+        }
+        return LanePositions.forStep(&self.vk, 0, cp.prompt_len, cp.rope_delta);
+    }
+
+    pub fn slotRopeDelta(self: *const VisionRuntime, slot: usize) ?LanePositions {
+        const st_slot = &self.slots[slot];
+        if (!st_slot.active) return null;
+        return LanePositions.forStep(&self.vk, 0, st_slot.prompt_len, st_slot.rope_delta);
+    }
+};
+
+pub fn openSlot(vr_opt: ?*VisionRuntime, slot: usize, prompt_len: usize, images: []const lanes.stream.Image, plan_link: ?*tp.planlink.PlanLink, tp_sess: ?*boundary.TpSession) !void {
+    if (images.len == 0) {
+        if (vr_opt) |vr| try vr.clearSlot(slot, plan_link, tp_sess);
+        return;
+    }
+    const vr = vr_opt orelse return error.Hy4TextOnly;
+    try vr.prepareSlotRank0(slot, prompt_len, images, plan_link, tp_sess);
+}
+
+pub fn hasActiveSlot(vr_opt: ?*const VisionRuntime, slot: usize) bool {
+    return if (vr_opt) |vr| vr.slots[slot].active else false;
+}
+
+pub fn runVisionOnlyCli(gpa: std.mem.Allocator, io: std.Io, args: []const []const u8) !bool {
+    var found_flag = false;
+    for (args[1..]) |a| if (std.mem.eql(u8, a, "--vision-only")) { found_flag = true; break; };
+    if (!found_flag) return false;
+
+    var model_dir: ?[]const u8 = null;
+    var out_path: ?[]const u8 = null;
+    var max_tokens: u32 = vimg.default_image_tokens;
+    var device: i32 = 0;
+    var dump_layers = false;
+    var image_paths: std.ArrayList([]const u8) = .empty;
+    defer image_paths.deinit(gpa);
+
+    var i: usize = 1;
+    while (i < args.len) : (i += 1) {
+        const arg = args[i];
+        if (std.mem.eql(u8, arg, "--vision-only")) continue;
+        if (std.mem.eql(u8, arg, "--dump-layers")) { dump_layers = true; continue; }
+        if (i + 1 >= args.len) return error.BadArgs;
+        const val = args[i + 1];
+        i += 1;
+        if (std.mem.eql(u8, arg, "--model")) model_dir = val
+        else if (std.mem.eql(u8, arg, "--image")) try image_paths.append(gpa, val)
+        else if (std.mem.eql(u8, arg, "--output")) out_path = val
+        else if (std.mem.eql(u8, arg, "--vision-image-tokens")) max_tokens = try std.fmt.parseInt(u32, val, 10)
+        else if (std.mem.eql(u8, arg, "--device")) device = try std.fmt.parseInt(i32, val, 10)
+        else return error.BadArgs;
+    }
+    const mdir = model_dir orelse return error.BadArgs;
+    const out = out_path orelse return error.BadArgs;
+    if (image_paths.items.len == 0) return error.BadArgs;
+
+    const cfg = (try vcfg.readFromDir(gpa, io, mdir)) orelse return error.MissingVisionWeights;
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, device);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, false);
+    defer stream.deinit();
+    var enc = try Rank0Encoder.init(gpa, io, &driver, stream, cfg, mdir);
+    defer enc.deinit();
+
+    const per_img_cap: u32 = max_tokens / @as(u32, @intCast(image_paths.items.len));
+    var dump = @import("dump_oracle.zig").Dump.init(gpa);
+    defer dump.deinit();
+
+    for (image_paths.items, 0..) |img_path, idx| {
+        const raw = try std.Io.Dir.cwd().readFileAlloc(io, img_path, gpa, .limited(64 << 20));
+        defer gpa.free(raw);
+        const prep = try vimg.prepareBytes(io, gpa, raw, cfg, per_img_cap);
+        defer gpa.free(prep.pixels);
+        const feat_bytes_len = @as(usize, prep.tokens) * cfg.out_hidden_size * 2;
+        var dev_out = try cuda.DeviceBuffer.alloc(&driver, feat_bytes_len);
+        defer dev_out.free();
+        try enc.encodeIntoDeviceTrace(prep.gh, prep.gw, prep.pixels, dev_out.ptr, if (dump_layers) &dump else null, idx);
+        try stream.synchronize();
+        const host_bf16 = try gpa.alloc(u8, feat_bytes_len);
+        defer gpa.free(host_bf16);
+        try cuda.memory.download(&driver, dev_out.ptr, host_bf16);
+        var key_buf: [64]u8 = undefined;
+        const feat_key = try std.fmt.bufPrint(&key_buf, "vision.{d}.features", .{idx});
+        try dump.put(feat_key, .bf16, &.{ prep.tokens, cfg.out_hidden_size }, host_bf16);
+        var grid_key_buf: [64]u8 = undefined;
+        const grid_key = try std.fmt.bufPrint(&grid_key_buf, "vision.{d}.grid_thw", .{idx});
+        const grid_vals = [3]i32{ 1, @intCast(prep.gh), @intCast(prep.gw) };
+        try dump.put(grid_key, .i32, &.{3}, std.mem.sliceAsBytes(&grid_vals));
+        std.debug.print("hy4 vision-only [{d}] {s}: grid=1x{d}x{d} tokens={d} bytes={d}\n", .{ idx, img_path, prep.gh, prep.gw, prep.tokens, feat_bytes_len });
+    }
+    try dump.write(out);
+    return true;
+}
+
+test "enterRowPositionGuard disables row-position fast paths on image lanes and preserves text-only and MoE fast paths" {
+    const MockOps = struct {
+        fast_prefill: bool = true,
+        fast_routed: bool = true,
+        fast_mla: bool = true,
+        fast_indexer: bool = true,
+    };
+    var ops: MockOps = .{};
+    const g_text = enterRowPositionGuard(&ops, null);
+    try std.testing.expect(!g_text.active);
+    try std.testing.expect(ops.fast_prefill and ops.fast_routed and ops.fast_mla and ops.fast_indexer);
+    g_text.leave(&ops);
+
+    var dummy_vk: cuda.hy4_vision.Kernels = undefined;
+    const lane_pos = LanePositions.forStep(&dummy_vk, 0x1000, 128, -40);
+    const g_img = enterRowPositionGuard(&ops, &lane_pos);
+    try std.testing.expect(g_img.active);
+    try std.testing.expect(!ops.fast_prefill and !ops.fast_mla and !ops.fast_indexer);
+    try std.testing.expect(ops.fast_routed);
+    g_img.leave(&ops);
+    try std.testing.expect(ops.fast_prefill and ops.fast_routed and ops.fast_mla and ops.fast_indexer);
+}
