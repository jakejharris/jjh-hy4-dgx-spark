+        else if (std.mem.eql(u8, arg, "--check-load")) check_load = true
+        else if (std.mem.eql(u8, arg, "--skip-head")) skip_head = true
+        else if (std.mem.eql(u8, arg, "--with-head")) with_head = true
+        else if (std.mem.eql(u8, arg, "--dump-shared-indices")) dump_shared = true
+        else if (std.mem.eql(u8, arg, "--dump-all-ranks")) { dump_all_ranks = true; verify_picks = true; }
+        else if (std.mem.eql(u8, arg, "--verify-rank-picks")) verify_picks = true
