+fn appendPngChunk(a: std.mem.Allocator, out: *std.ArrayList(u8), kind: *const [4]u8, body: []const u8) !void {
+    var len_be: [4]u8 = undefined;
+    std.mem.writeInt(u32, &len_be, @intCast(body.len), .big);
+    try out.appendSlice(a, &len_be);
+    const start = out.items.len;
+    try out.appendSlice(a, kind);
+    try out.appendSlice(a, body);
+    var crc_be: [4]u8 = undefined;
+    std.mem.writeInt(u32, &crc_be, std.hash.Crc32.hash(out.items[start..]), .big);
+    try out.appendSlice(a, &crc_be);
