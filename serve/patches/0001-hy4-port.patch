+test "Hy4 serve run_tag distinguishes every prefill and vision switch, refuses mismatched ranks, and stays untouched by RowPositionGuard" {
+    const Sw = cuda.hy4_kernels.PrefillSwitches;
+    const base: Sw = .{ .fast_prefill = true, .fast_routed = true, .fast_mla = true, .fast_indexer = true, .prefill_ar = .fp32, .min_prefill_rows = 256 };
+    var b0: [320]u8 = undefined;
+    const t0 = try cuda_native.formatServeRunTag(&b0, 131072, 1, false, true, false, 2048, base, "4b", .{ .image_tokens = 8192, .max_images = 8 });
+    const variants = [_]Sw{
+        .{ .fast_prefill = true, .fast_routed = true, .fast_mla = true, .fast_indexer = true, .prefill_ar = .bf16, .min_prefill_rows = 256 },
+        .{ .fast_prefill = true, .fast_routed = true, .fast_mla = true, .fast_indexer = true, .prefill_ar = .off, .min_prefill_rows = 256 },
+        .{ .fast_prefill = true, .fast_routed = true, .fast_mla = true, .fast_indexer = true, .prefill_ar = .fp32, .min_prefill_rows = 64 },
+        .{ .fast_prefill = true, .fast_routed = false, .fast_mla = true, .fast_indexer = true, .prefill_ar = .fp32, .min_prefill_rows = 256 },
+        .{ .fast_prefill = true, .fast_routed = true, .fast_mla = false, .fast_indexer = true, .prefill_ar = .fp32, .min_prefill_rows = 256 },
+        .{ .fast_prefill = true, .fast_routed = true, .fast_mla = true, .fast_indexer = false, .prefill_ar = .fp32, .min_prefill_rows = 256 },
+    };
+    for (variants) |v| {
+        var b1: [320]u8 = undefined;
+        const t1 = try cuda_native.formatServeRunTag(&b1, 131072, 1, false, true, false, 2048, v, "4b", .{ .image_tokens = 8192, .max_images = 8 });
+        try std.testing.expect(!std.mem.eql(u8, t0, t1));
+    }
+    var b_novis: [320]u8 = undefined;
+    const t_novis = try cuda_native.formatServeRunTag(&b_novis, 131072, 1, false, true, false, 2048, base, "4b", null);
+    try std.testing.expect(!std.mem.eql(u8, t0, t_novis));
+
+    // Check 2: enterRowPositionGuard mutates only rt.ops booleans; run_tag stays untouched.
+    var tag_copy: [320]u8 = undefined;
+    @memcpy(tag_copy[0..t0.len], t0);
+    const MockOps = struct { fast_prefill: bool, fast_routed: bool, fast_mla: bool, fast_indexer: bool };
+    var ops: MockOps = .{ .fast_prefill = base.fast_prefill, .fast_routed = base.fast_routed, .fast_mla = base.fast_mla, .fast_indexer = base.fast_indexer };
+    var vk: cuda.hy4_vision.Kernels = undefined;
+    const mr = vision_runtime.LanePositions.forStep(&vk, 0x2000, 512, -100);
+    {
+        const g = vision_runtime.enterRowPositionGuard(&ops, &mr);
+        defer g.leave(&ops);
+        try std.testing.expectEqualStrings(tag_copy[0..t0.len], t0);
+        try std.testing.expect(!ops.fast_prefill and !ops.fast_mla and !ops.fast_indexer and ops.fast_routed);
+    }
+    try std.testing.expect(ops.fast_prefill and ops.fast_mla and ops.fast_indexer and ops.fast_routed);
+
+    const l = try tp.bootstrap.testListener();
+    defer tp.sock.close(l.fd);
+    var b_peer: [320]u8 = undefined;
+    const t_peer = try cuda_native.formatServeRunTag(&b_peer, 131072, 1, false, true, false, 2048, variants[0], "4b", .{ .image_tokens = 8192, .max_images = 8 });
+    const Peer = struct {
+        fn run(port: u16, tag: []const u8, out_err: *?anyerror) void {
+            var b = tp.Bootstrap.open(.{ .world = 2, .rank = 1, .link_port = port, .connect_timeout_ns = 5 * std.time.ns_per_s }) catch |e| { out_err.* = e; return; };
+            defer b.close();
+            b.agree(tag, "Hy4 run settings") catch |e| { out_err.* = if (e == error.Mismatch) error.Hy4RunMismatch else e; };
+        }
+    };
+    var peer_err: ?anyerror = null;
+    const th = try std.Thread.spawn(.{}, Peer.run, .{ l.port, t_peer, &peer_err });
+    var bs0 = try tp.Bootstrap.acceptOn(l.fd, 2, 5 * std.time.ns_per_s);
+    defer bs0.close();
+    try std.testing.expectError(error.Mismatch, bs0.agree(t0, "Hy4 run settings"));
+    th.join();
+    try std.testing.expectEqual(@as(?anyerror, error.Hy4RunMismatch), peer_err);
+}
+
+fn makePngHeaderOnly(w: u32, h: u32) [8 + 25 + 12 + 12]u8 {
+    var out: [57]u8 = undefined;
+    @memcpy(out[0..8], "\x89PNG\r\n\x1a\n");
+    std.mem.writeInt(u32, out[8..12], 13, .big);
+    @memcpy(out[12..16], "IHDR");
+    std.mem.writeInt(u32, out[16..20], w, .big);
+    std.mem.writeInt(u32, out[20..24], h, .big);
+    out[24..29].* = .{ 8, 2, 0, 0, 0 };
+    std.mem.writeInt(u32, out[29..33], std.hash.Crc32.hash(out[12..29]), .big);
+    std.mem.writeInt(u32, out[33..37], 0, .big);
+    @memcpy(out[37..41], "IDAT");
+    std.mem.writeInt(u32, out[41..45], std.hash.Crc32.hash("IDAT"), .big);
+    std.mem.writeInt(u32, out[45..49], 0, .big);
+    @memcpy(out[49..53], "IEND");
+    std.mem.writeInt(u32, out[53..57], std.hash.Crc32.hash("IEND"), .big);
+    return out;
+}
+
+test "Hostile PNG headers, aspect ratios, and tiny budgets are refused before any heap allocation" {
+    const vcfg: vision_config.Config = .{};
+    var fail_zero = std.testing.FailingAllocator.init(std.testing.allocator, .{ .fail_index = 0 });
+    const zero_alloc = fail_zero.allocator();
+
+    // Zero dimensions and >89.47 MP bomb headers fail with Invalid before any allocation.
+    const png_zero = makePngHeaderOnly(0, 16);
+    try std.testing.expectError(error.Invalid, vision_image.prepareBytes(std.testing.io, zero_alloc, &png_zero, vcfg, 8192));
+    const png_bomb = makePngHeaderOnly(10_000, 10_000);
+    try std.testing.expectError(error.Invalid, vision_image.prepareBytes(std.testing.io, zero_alloc, &png_bomb, vcfg, 8192));
+
+    // >8192 px side and >16 MP (e.g. 5000x5000 = 25 MP) fail with Oversized before any allocation.
+    const png_wide = makePngHeaderOnly(8193, 32);
+    try std.testing.expectError(error.Oversized, vision_image.prepareBytes(std.testing.io, zero_alloc, &png_wide, vcfg, 8192));
+    const png_area = makePngHeaderOnly(5000, 5000);
+    try std.testing.expectError(error.Oversized, vision_image.prepareBytes(std.testing.io, zero_alloc, &png_area, vcfg, 8192));
+
+    // >200:1 aspect ratio and <2 token budget are refused with explicit explanations.
+    try std.testing.expectError(error.AspectRatio, vision_image.smartResizeForTokens(10, 2001, vcfg, 8192));
+    try std.testing.expectError(error.ImageTooSmall, vision_image.smartResizeForTokens(64, 64, vcfg, 1));
+    try std.testing.expect(vision_image.VisionOffer.explain(error.AspectRatio) != null);
+    try std.testing.expect(vision_image.VisionOffer.explain(error.ImageTooSmall) != null);
+    try std.testing.expect(vision_image.VisionOffer.explain(error.NoJpegLibrary) != null);
+    try std.testing.expect(vision_image.VisionOffer.explain(error.NoWebpLibrary) != null);
+    _ = core;
+}
