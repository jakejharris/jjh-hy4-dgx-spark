+pub fn smooth(r: *Rig, k: *const ops.Kernels) !void {
+    const dir = @import("hy4_options").index_oracle.?;
+    var w0 = try tiny.open(dir, "tiny-smooth/model-00001-of-00002.safetensors");
+    defer w0.close(t.io);
+    var w1 = try tiny.open(dir, "tiny-smooth/model-00002-of-00002.safetensors");
+    defer w1.close(t.io);
+    inline for (.{ "prompt16", "prune48" }, .{ 16, 48 }) |prompt, rows| {
+        var dump = try tiny.open(dir, "dumps-smooth/" ++ prompt ++ ".safetensors");
+        defer dump.close(t.io);
+        inline for (.{ "0", "1", "5" }, .{ "000", "001", "005" }) |layer, id| {
+            var input = try tiny.open(dir, "inputs-smooth/" ++ prompt ++ "/layer." ++ id ++ ".safetensors");
+            defer input.close(t.io);
+            try fixture(r, k, &.{ w0, w1 }, dump, input, "model.layers." ++ layer ++ ".", "layer." ++ id, rows);
+            try t.expect(try r.intact());
+            r.reset();
+        }
+    }
+}
+
+fn zeros(a: std.mem.Allocator, comptime T: type, n: usize) ![]T {
+    const data = try a.alloc(T, n);
+    @memset(data, 0);
+    return data;
+}
+
+// At full size every odd key has a positive dot and every even key a
+// negative dot. ReLU therefore creates ties with known causal winners.
+pub fn full(r: *Rig, k: *const ops.Kernels) !void {
+    var pool = std.heap.ArenaAllocator.init(t.allocator);
+    defer pool.deinit();
+    const a = pool.allocator();
+    const rows = 2560;
+    const keep = 2048;
+    const shape: ops.IndexShape = .{
+        .rows = rows,
+        .first_pos = 0,
+        .capacity = rows,
+        .x_row_stride = 6144,
+        .q_row_stride = 2048,
+        .indices_stride = keep,
+        .cache_stride = 128,
+    };
+    const x = try zeros(a, u16, rows * 6144);
+    const q = try zeros(a, u16, rows * 2048);
+    for (0..rows) |i| {
+        x[i * 6144] = bf.bits(if (i % 2 == 1) 1 else -1);
+        x[i * 6144 + 1] = bf.bits(1);
+        q[i * 2048] = bf.bits(1);
+    }
+    const wk = try zeros(a, u16, 128 * 6144);
+    wk[0] = bf.bits(1);
+    const wq = try zeros(a, u16, 32 * 128 * 2048);
+    const head = try zeros(a, f32, 32 * 6144);
+    for (0..32) |h| {
+        wq[h * 128 * 2048] = bf.bits(1);
+        head[h * 6144 + 1] = 1;
+    }
+    const norm: [128]f32 = @splat(1);
+    const bias: [128]f32 = @splat(0);
+    const n = try ops.indexScratchBytes(shape);
+    const b: ops.IndexBuffers = .{
+        .q_resid = try r.input(std.mem.sliceAsBytes(q)),
+        .x = try r.input(std.mem.sliceAsBytes(x)),
+        .wq_b = try r.input(std.mem.sliceAsBytes(wq)),
+        .wk = try r.input(std.mem.sliceAsBytes(wk)),
+        .k_norm = try r.input(std.mem.asBytes(&norm)),
+        .k_bias = try r.input(std.mem.asBytes(&bias)),
+        .weights_proj = try r.input(std.mem.sliceAsBytes(head)),
+        .cache = try r.output(rows * 128 * 2),
+        .indices = try r.output(rows * keep * 4),
+        .scratch = try r.scratch(n),
+        .scratch_bytes = n,
+    };
+    try ops.selectTokens(k, r.s, shape, b);
+    const ids = std.mem.bytesAsSlice(i32, try r.bytes(b.indices, rows * keep * 4));
+    for (0..rows) |i| {
+        const out = ids[i * keep ..][0..keep];
+        const valid = @min(i + 1, keep);
+        var j = keep - valid;
+        for (out[0..j]) |v| try t.expectEqual(@as(i32, -1), v);
+        const keep_even = valid - (i + 1) / 2;
+        for (0..i + 1) |pos| {
+            if (pos % 2 == 0 and pos / 2 >= keep_even) continue;
+            try t.expectEqual(@as(i32, @intCast(pos)), out[j]);
+            j += 1;
+        }
+        try t.expectEqual(@as(usize, keep), j);
+    }
+    std.debug.print("Hy4 index full 2560x6144 heads=32 dim=128 top=2048 exact={d} scratch={d}\n", .{ rows * keep, n });
+}
+
+pub fn shifted(r: *Rig, k: *const ops.Kernels) !void {
+    try sharedScores(r, k);
+    try shiftedPages(r, k, 3, 70000, 65000, 17);
+    for ([_]u32{ 8191, 8192, 8193 }) |span| try shiftedPages(r, k, 2, 300 + span - 2, 300, 7);
+    // The second query tile has one row; the first merges ties across four wide pages.
+    try shiftedPages(r, k, 65, 70000, 40000, 97);
+}
+
+fn shiftedPages(r: *Rig, k: *const ops.Kernels, comptime rows: u32, first: u32, start: u32, comptime keep: u32) !void {
+    var pool = std.heap.ArenaAllocator.init(t.allocator);
+    defer pool.deinit();
+    const a = pool.allocator();
+    const cap = first + rows;
+    const shape: ops.IndexShape = .{
+        .rows = rows,
+        .first_pos = first,
+        .capacity = cap,
+        .top_k = keep,
+        .width = 2,
+        .q_rank = 2,
+        .heads = 1,
+        .dim = 4,
+        .rope = 2,
+        .x_row_stride = 3,
+        .q_row_stride = 3,
+        .cache_stride = 5,
+        .indices_stride = keep + 1,
+    };
+    const n = try ops.indexScratchBytes(shape);
+    const x: [rows][3]u16 = @splat(.{ bf.bits(1), 0, 0x7fc0 });
+    const wq = [8]u16{ bf.bits(1), 0, 0, 0, 0, 0, 0, 0 };
+    const wk: [8]u16 = @splat(0);
+    const norm: [4]f32 = @splat(1);
+    const bias = [_]f32{ 512, 0, 1, 0 };
+    const head = [_]f32{ 1, 0 };
+    const cache = try zeros(a, u16, cap * 5);
+    for (0..cap) |i| cache[i * 5] = bf.bits(if (i < start) 1000 else @as(f32, @floatFromInt(i % 257)));
+    cache[(first - 1) * 5] = bf.bits(500);
+    const b: ops.IndexBuffers = .{
+        .q_resid = try r.input(std.mem.asBytes(&x)),
+        .x = try r.input(std.mem.asBytes(&x)),
+        .wq_b = try r.input(std.mem.asBytes(&wq)),
+        .wk = try r.input(std.mem.asBytes(&wk)),
+        .k_norm = try r.input(std.mem.asBytes(&norm)),
+        .k_bias = try r.input(std.mem.asBytes(&bias)),
+        .weights_proj = try r.input(std.mem.asBytes(&head)),
+        .cache = try r.input(std.mem.sliceAsBytes(cache)),
+        .indices = try r.output(rows * (keep + 1) * 4),
+        .scratch = try r.scratch(n),
+        .scratch_bytes = n,
+    };
+    var short = b;
+    short.scratch_bytes -= 1;
+    try t.expectError(error.BadHy4Scratch, ops.selectTokensWindow(k, r.s, shape, short, start));
+    try ops.selectTokensWindow(k, r.s, shape, b, start);
+    const expected = try a.dupe(u8, try r.bytes(b.indices, rows * (keep + 1) * 4));
+    const preferred = try ops.indexWindowScratchBytes(shape, start);
+    try t.expectEqual(n + (if (cap - start >= 8192) @as(usize, @min(rows, 64)) * 6144 * 4 else 0), preferred);
+    try t.expectEqual(n, try ops.indexWindowScratchBytes(shape, first));
+    if (preferred > n) {
+        var wide = b;
+        for ([_]usize{ preferred - 1, preferred }) |available| {
+            wide.indices = try r.output(expected.len);
+            wide.scratch = try r.scratch(available);
+            wide.scratch_bytes = available;
+            try ops.selectTokensWindow(k, r.s, shape, wide, start);
+            try t.expectEqualSlices(u8, expected, try r.bytes(wide.indices, expected.len));
+        }
+    }
+    const ids = std.mem.bytesAsSlice(i32, expected);
+    for (0..rows) |row| {
+        const got = ids[row * (keep + 1) ..][0..keep];
+        const first_max = start + (256 - start % 257);
+        const tied = keep - 2 - row;
+        for (got[0..tied], 0..) |v, j| try t.expectEqual(@as(i32, @intCast(first_max + j * 257)), v);
+        for (got[tied..], 0..) |v, j| try t.expectEqual(@as(i32, @intCast(first - 1 + j)), v);
+    }
+    const keys = std.mem.bytesAsSlice(u16, try r.bytes(b.cache + first * 5 * 2, rows * 5 * 2));
+    for (0..rows) |i| {
+        const pos: f32 = @floatFromInt(first + i);
+        try t.expectEqual(bf.bits(@cos(pos)), keys[i * 5 + 2]);
+        try t.expectEqual(bf.bits(@sin(pos)), keys[i * 5 + 3]);
+    }
+    // A fresh replay at the same offset has a different population of keys.
+    try ops.selectTokensWindow(k, r.s, shape, b, first);
+    const cold = std.mem.bytesAsSlice(i32, try r.bytes(b.indices, rows * (keep + 1) * 4));
+    for (0..rows) |i| {
+        const out = cold[i * (keep + 1) ..][0..keep];
+        for (out[0 .. keep - i - 1]) |v| try t.expectEqual(@as(i32, -1), v);
+        for (out[keep - i - 1 ..], 0..) |v, j| try t.expectEqual(@as(i32, @intCast(first + j)), v);
+    }
+    std.debug.print("Hy4 index: {d} rows, {d} populated keys, tied IDs, scratch boundary and shifted RoPE exact\n", .{ rows, cap - start });
+}
+
+// Compare the shared eight-key tile against the canonical scorer before selection.
+// A page crosses the diagonal of a verify window and stops in a partial key tile.
+fn sharedScores(r: *Rig, k: *const ops.Kernels) !void {
+    const heads: u32 = 32;
+    const dim: u32 = 128;
+    const keep: u32 = 17;
+    const start: u32 = 3;
+    const first: u32 = 41;
+    const cache_pitch: u32 = 131;
+    const pitch: u32 = 74;
+    const max: u32 = 16;
+    var random = std.Random.DefaultPrng.init(39);
+    const rng = random.random();
+    var queries: [max * heads * dim]u16 = undefined;
+    var keys: [(first + max) * cache_pitch]u16 = undefined;
+    var weights: [max * heads]f32 = undefined;
+    for (&queries) |*x| x.* = bf.bits(rng.float(f32) * 2 - 1);
+    for (&keys) |*x| x.* = bf.bits(rng.float(f32) * 2 - 1);
+    for (&weights) |*x| x.* = rng.float(f32) * 2 - 1;
+    const q = try r.input(std.mem.asBytes(&queries));
+    const cache = try r.input(std.mem.asBytes(&keys));
+    const w = try r.input(std.mem.asBytes(&weights));
+    for ([_]u32{ 2, 3, 4, 5, 7, 8, 15, 16 }) |rows| {
+        for ([_]u32{ start, first - 18 }) |page| {
+            const count = first + rows - page;
+            const bytes = rows * pitch * 4;
+            const expected = try r.output(bytes);
+            const got = try r.output(bytes);
+            var scalar: cuda.Args = .{};
+            inline for (.{ q, cache, w, expected, heads, dim, cache_pitch, pitch, first, start, page, count, keep }) |v| scalar.add(v);
+            try cuda.launch.launch(k.index_scores, .{ .grid = .{ .x = (count + 15) / 16, .y = rows }, .block = .{ .x = 64 } }, r.s, &scalar);
+            var tile: cuda.Args = .{};
+            inline for (.{ q, cache, w, got, cache_pitch, pitch, first, start, page, count, keep, rows }) |v| tile.add(v);
+            const warps: u32 = if (rows <= 2) 2 else if (rows <= 4) 4 else 8;
+            try cuda.launch.launch(k.index_scores_rows, .{ .grid = .{ .x = (count + 7) / 8, .y = (rows + warps - 1) / warps }, .block = .{ .x = warps * 32 } }, r.s, &tile);
+            const ref = try t.allocator.dupe(u8, try r.bytes(expected, bytes));
+            defer t.allocator.free(ref);
+            try t.expectEqualSlices(u8, ref, try r.bytes(got, bytes));
+        }
+    }
+}
