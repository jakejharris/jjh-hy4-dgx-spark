+    try std.testing.expectError(error.Hy4PackTrunkMismatch, weights.ShardIndex.openWithTrunkAndHead(gpa, io, c46, null, null, "fp32", null));
+
+    // 3. Four Sparks, each with common/ + only its own rank<R>/ from --trunk 4b, agree on TP pack digest (and differ from 4b6b+head).
+    var s4_dig: [4][32]u8 = undefined;
+    for (0..4) |r| {
+        const d = try sub(a, root, try std.fmt.allocPrint(a, "spark4b-{d}", .{r}));
+        var want_r: [4]bool = @splat(false);
+        want_r[r] = true;
+        _ = try pack_export.exportPack(gpa, io, .{ .src = src, .out = d, .ranks = want_r, .trunk = "4b" });
+        var sidx = try weights.ShardIndex.open(gpa, io, try sub(a, d, "common"));
