+//! Host HYV4VLImageProcessor, 3D interleaved M-RoPE [12, 10, 10] planner, and server VisionOffer adapter.
+const std = @import("std");
+const core = @import("core");
+const lanes = @import("lanes");
+const vcfg = @import("vision_config.zig");
+
+const picture = core.picture;
+const patches_mod = picture.patches;
+
+pub const default_image_tokens: u32 = 8192;
+pub const identity_tag: u64 = 0x4859_3456_4c5f_3031;
+
+pub const Limits = struct {
+    image_tokens: u32 = default_image_tokens,
+    max_images: u32 = 8,
+};
+
+pub const Prepared = struct {
+    pixels: []f32,
+    gh: u32,
+    gw: u32,
+    tokens: u32,
+    hash: u64,
+};
+
+pub fn mergedTokens(gh: u32, gw: u32, merge: u32) u32 {
+    const hm = gh / merge;
+    const wm = gw / merge;
+    return hm * (wm + 1);
+}
+
+pub fn smartResizeForTokens(height: u32, width: u32, cfg: vcfg.Config, max_tokens: u32) !patches_mod.Size {
+    if (max_tokens < 2) return error.ImageTooSmall;
+    const factor = cfg.gridFactor();
+    const min_unit: u64 = @as(u64, factor) * factor;
+    const lo_px: u64 = @min(cfg.min_pixels, cfg.max_pixels);
+    var hi_px: u64 = @min(cfg.max_pixels, @as(u64, max_tokens) * min_unit);
+    var sz = try patches_mod.smartResize(height, width, factor, @min(lo_px, hi_px), hi_px);
+    while (mergedTokens(sz.h / cfg.patch_size, sz.w / cfg.patch_size, cfg.spatial_merge_size) > max_tokens) {
+        const cur_tok: u64 = mergedTokens(sz.h / cfg.patch_size, sz.w / cfg.patch_size, cfg.spatial_merge_size);
+        const cur_px: u64 = @as(u64, sz.h) * sz.w;
+        var next_hi: u64 = (cur_px * max_tokens) / cur_tok;
+        if (next_hi >= hi_px) next_hi = if (hi_px > min_unit) hi_px - min_unit else 0;
+        if (next_hi >= min_unit) {
+            hi_px = next_hi;
+            sz = try patches_mod.smartResize(height, width, factor, @min(lo_px, hi_px), hi_px);
+        } else {
+            if (sz.h >= sz.w and sz.h > factor) {
+                sz.h -= factor;
+            } else if (sz.w > factor) {
+                sz.w -= factor;
+            } else {
+                return error.ImageTooSmall;
+            }
+        }
+    }
+    return sz;
+}
+
+pub fn patchifyRaster(gpa: std.mem.Allocator, img: picture.Rgb, cfg: vcfg.Config) ![]f32 {
+    const ps: usize = cfg.patch_size;
+    if (img.height == 0 or img.width == 0 or img.height % (ps * cfg.spatial_merge_size) != 0 or img.width % (ps * cfg.spatial_merge_size) != 0)
+        return error.Invalid;
+    const gh: usize = img.height / ps;
+    const gw: usize = img.width / ps;
+    const p_dim: usize = cfg.patchDim();
+    const out = try gpa.alloc(f32, gh * gw * p_dim);
+    var at: usize = 0;
+    for (0..gh) |py| {
+        for (0..gw) |px| {
+            const top = py * ps;
+            const left = px * ps;
+            for (0..3) |channel| {
+                const mean = cfg.image_mean[channel];
+                const inv_std = 1.0 / cfg.image_std[channel];
+                for (0..ps) |y| {
+                    for (0..ps) |x| {
+                        const raw = img.pixels[((top + y) * img.width + (left + x)) * 3 + channel];
+                        const scaled: f32 = @floatCast(@as(f64, @floatFromInt(raw)) * cfg.rescale_factor);
+                        out[at] = (scaled - mean) * inv_std;
+                        at += 1;
+                    }
+                }
+            }
+        }
+    }
+    return out;
+}
+
+pub fn prepareRgb(gpa: std.mem.Allocator, rgb: picture.Rgb, bytes_hash: u64, cfg: vcfg.Config, max_tokens: u32) !Prepared {
+    const size = try smartResizeForTokens(@intCast(rgb.height), @intCast(rgb.width), cfg, max_tokens);
+    const resized = try picture.resample.resize(gpa, .pillow, .of(rgb.pixels, rgb.width, rgb.height), size.w, size.h);
+    defer gpa.free(resized);
+    const gh: u32 = size.h / cfg.patch_size;
+    const gw: u32 = size.w / cfg.patch_size;
+    if (@as(u64, gh) * gw > cfg.max_vit_seq_len) return error.Oversized;
+    const pixels = try patchifyRaster(gpa, .{ .width = size.w, .height = size.h, .pixels = resized }, cfg);
+    return .{
+        .pixels = pixels,
+        .gh = gh,
+        .gw = gw,
+        .tokens = mergedTokens(gh, gw, cfg.spatial_merge_size),
+        .hash = picture.identity.withGrid(bytes_hash, .{ gh, gw }),
+    };
+}
+
+pub fn prepareBytes(io: std.Io, gpa: std.mem.Allocator, bytes: []const u8, cfg: vcfg.Config, max_tokens: u32) !Prepared {
+    var rgb = try picture.decode(io, gpa, bytes);
+    defer rgb.deinit(gpa);
+    return prepareRgb(gpa, rgb, picture.identity.ofBytes(identity_tag, bytes), cfg, max_tokens);
+}
+
+pub const VisionOffer = struct {
+    pub const template_wraps = true;
+
+    io: std.Io,
+    cfg: vcfg.Config,
+    limits: Limits,
+    marks: struct { open: u32, image: u32, close: u32 },
+    mark_ids: [4]u32,
+
+    pub fn init(io: std.Io, cfg: vcfg.Config, limits: Limits) VisionOffer {
+        return .{
+            .io = io,
+            .cfg = cfg,
+            .limits = limits,
+            .marks = .{ .open = cfg.image_start_token_id, .image = cfg.image_token_id, .close = cfg.image_end_token_id },
+            .mark_ids = .{ cfg.image_start_token_id, cfg.image_token_id, cfg.image_end_token_id, cfg.image_newline_token_id },
+        };
+    }
+
+    pub fn prepare(self: *VisionOffer, a: std.mem.Allocator, bytes: []const u8, max_tokens: u32) !Prepared {
+        return prepareBytes(self.io, a, bytes, self.cfg, max_tokens);
+    }
+
+    pub fn explain(err: anyerror) ?[]const u8 {
+        if (err == error.ImageTooSmall) return "the per-image token budget is under 2 tokens; raise --vision-image-tokens or send fewer images";
+        return patches_mod.problem(err);
+    }
+};
+
+pub fn mropeAxisForPair(pair: u32) u2 {
+    return if (pair < 30) @intCast(pair % 3) else 0;
+}
+
+pub const ImageSpan = struct {
+    at: u32,
+    tokens: u32,
+    gh: u32,
+    gw: u32,
+    row_offset: u32,
+};
+
+pub const MropePlan = struct {
+    thw: []i32,
+    spans: []ImageSpan,
+    total_image_tokens: u32,
+    rope_delta: i32,
+
+    pub fn deinit(self: *MropePlan, gpa: std.mem.Allocator) void {
+        gpa.free(self.thw);
+        gpa.free(self.spans);
+        self.* = undefined;
+    }
+};
+
+pub fn buildMropePlan(gpa: std.mem.Allocator, prompt_len: usize, images: []const lanes.stream.Image, merge_size: u32, max_vit_seq_len: u32) !MropePlan {
+    if (prompt_len == 0 or prompt_len > std.math.maxInt(i32)) return error.BadHy4VisionPrompt;
+    var thw = try gpa.alloc(i32, prompt_len * 3);
+    errdefer gpa.free(thw);
+    var spans = try gpa.alloc(ImageSpan, images.len);
+    errdefer gpa.free(spans);
+
+    var cursor: usize = 0;
+    var c_pos: i64 = 0;
+    var feat_off: u32 = 0;
+    for (images, 0..) |img, idx| {
+        if (img.gh < merge_size or img.gw < merge_size or img.gh % merge_size != 0 or img.gw % merge_size != 0)
+            return error.BadHy4VisionShape;
+        if (@as(u64, img.gh) * img.gw > max_vit_seq_len) return error.BadHy4VisionShape;
+        const hm: u32 = img.gh / merge_size;
+        const wm: u32 = img.gw / merge_size;
+        const expected_toks: u32 = hm * (wm + 1);
+        if (img.tokens != expected_toks) return error.BadHy4VisionShape;
+        const at: usize = img.at;
+        const end: usize = at + img.tokens;
+        if (at < cursor or end > prompt_len) return error.BadHy4VisionPrompt;
+
+        for (cursor..at) |slot| {
+            const p: i32 = @intCast(c_pos);
+            thw[slot * 3 + 0] = p;
+            thw[slot * 3 + 1] = p;
+            thw[slot * 3 + 2] = p;
+            c_pos += 1;
+        }
+        for (0..hm) |r| {
+            for (0..wm + 1) |col| {
+                const slot = at + r * (wm + 1) + col;
+                thw[slot * 3 + 0] = @intCast(c_pos);
+                thw[slot * 3 + 1] = @intCast(c_pos + @as(i64, @intCast(r)));
+                thw[slot * 3 + 2] = @intCast(c_pos + @as(i64, @intCast(col)));
+            }
+        }
+        c_pos += @as(i64, @intCast(@max(hm, wm + 1)));
+        cursor = end;
+        spans[idx] = .{ .at = img.at, .tokens = img.tokens, .gh = img.gh, .gw = img.gw, .row_offset = feat_off };
+        feat_off = try std.math.add(u32, feat_off, img.tokens);
+    }
+    for (cursor..prompt_len) |slot| {
+        const p: i32 = @intCast(c_pos);
+        thw[slot * 3 + 0] = p;
+        thw[slot * 3 + 1] = p;
+        thw[slot * 3 + 2] = p;
+        c_pos += 1;
+    }
+    const delta_i64 = c_pos - @as(i64, @intCast(prompt_len));
+    const rope_delta = std.math.cast(i32, delta_i64) orelse return error.BadHy4VisionPrompt;
+    return .{ .thw = thw, .spans = spans, .total_image_tokens = feat_off, .rope_delta = rope_delta };
+}
