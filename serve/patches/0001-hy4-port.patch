+    defer tf.close(io);
+    for (tf.names.keys(), tf.names.values()) |k, e| {
+        const src = tf.map.memory[tf.data + e.begin .. tf.data + e.end];
+        var parts: [4][]u8 = undefined;
+        var spans: [4]Span = undefined;
+        defer for (parts) |p| gpa.free(p);
+        for (&parts, &spans, 0..) |*p, *sp, r_i| {
+            sp.* = try tensorSpan(&tf, k, e, tiny_t, try Rank.init(r_i, 4), false);
+            p.* = try extractSpanAlloc(gpa, src, sp.*);
+        }
+        var pos: usize = 0;
+        for (0..@intCast(spans[0].count)) |j| for (parts, spans) |p, sp| {
+            const rl: usize = @intCast(sp.len);
+            try std.testing.expectEqualSlices(u8, src[pos..][0..rl], p[j * rl ..][0..rl]);
+            pos += rl;
+        };
+        try std.testing.expectEqual(src.len, pos);
+    }
+}
