+test "real Full Hy4 shapes (120832 vocab, 6144 hidden, 78 layers, 128K context): gather, direct-load, budget, and KV pool never wrap" {
+    const gpa = std.testing.allocator;
+    const io = std.testing.io;
+
+    var ix_types: [78]config.IndexerType = @splat(.shared);
+    ix_types[0] = .full;
+    for (0..20) |j| ix_types[1 + j * 3] = .full; // 21 .full + 57 .shared = 78 layers
+
+    const full_t: config.Text = .{
+        .hidden_size = 6144, .intermediate_size = 18432, .moe_intermediate_size = 2048,
+        .num_hidden_layers = 78, .vocab_size = 120_832, .max_position_embeddings = 131_072,
+        .q_lora_rank = 2048, .kv_lora_rank = 512, .num_attention_heads = 64,
+        .qk_nope_head_dim = 192, .qk_rope_head_dim = 64, .v_head_dim = 256,
+        .index_n_heads = 32, .index_head_dim = 128, .index_topk = 2048,
+        .indexer_types = &ix_types, .n_routed_experts = 256, .num_experts_per_tok = 8,
+    };
+
+    // 1. Real 4-rank TCP gatherVocabOnBootstrap with 120,832 vocab (rank_bytes = 120,832 and 362,496 > 16,384 chunk_cap).
+    const l = try tp.bootstrap.testListener();
+    defer tp.sock.close(l.fd);
+    const vocab_stride: usize = 30_208;
+    const rows: usize = 3; // rank_bytes = 3 * 30,208 * 4 = 362,496 bytes (22.125 chunks of 16,384!)
+    const Peer = struct {
+        fn run(port: u16, rank_idx: u32, err_out: *?anyerror) void {
+            const a = std.heap.page_allocator;
+            var b = tp.Bootstrap.open(.{
+                .world = 4, .rank = rank_idx, .link_port = port, .connect_timeout_ns = 10 * std.time.ns_per_s,
+            }) catch |e| { err_out.* = e; return; };
+            defer b.close();
+            const loc = a.alloc(f32, rows * vocab_stride) catch |e| { err_out.* = e; return; };
+            defer a.free(loc);
+            for (0..rows) |r| for (0..vocab_stride) |c| {
+                loc[r * vocab_stride + c] = @floatFromInt(r * 200_000 + @as(usize, rank_idx) * vocab_stride + c);
+            };
+            const full_out = a.alloc(f32, rows * 120_832) catch |e| { err_out.* = e; return; };
+            defer a.free(full_out);
+            boundary.gatherVocabOnBootstrap(&b, a, loc, rows, vocab_stride, 120_832, full_out) catch |e| {
+                err_out.* = e;
+            };
+        }
+    };
+    var peer_errs: [3]?anyerror = @splat(null);
+    var threads: [3]std.Thread = undefined;
+    for (0..3) |ti| threads[ti] = try std.Thread.spawn(.{}, Peer.run, .{ l.port, @as(u32, @intCast(ti + 1)), &peer_errs[ti] });
+
+    var b0 = try tp.Bootstrap.acceptOn(l.fd, 4, 10 * std.time.ns_per_s);
+    defer b0.close();
+    const loc0 = try gpa.alloc(f32, rows * vocab_stride);
+    defer gpa.free(loc0);
+    for (0..rows) |r| for (0..vocab_stride) |c| {
+        loc0[r * vocab_stride + c] = @floatFromInt(r * 200_000 + c);
+    };
+    const full0 = try gpa.alloc(f32, rows * 120_832);
+    defer gpa.free(full0);
+    try boundary.gatherVocabOnBootstrap(&b0, gpa, loc0, rows, vocab_stride, 120_832, full0);
+    for (threads) |th| th.join();
+    for (peer_errs) |pe| try std.testing.expectEqual(@as(?anyerror, null), pe);
+    for (0..rows) |r| for ([_]usize{ 0, 16_384, 30_207, 30_208, 60_416, 90_624, 120_831 }) |v| {
+        try std.testing.expectEqual(@as(f32, @floatFromInt(r * 200_000 + v)), full0[r * 120_832 + v]);
+    };
+
+    // 2. Real O_DIRECT lm_head.weight (742,391,808 elements on TP=1, 185,597,952 on TP=4) streaming step math.
+    for ([_]usize{ 120_832 * 6144, 30_208 * 6144 }) |total_elems| {
+        var done: usize = 0;
+        var chunks: usize = 0;
+        while (done < total_elems) : (chunks += 1) {
+            const stp = try direct_load.f32StreamStep(direct_load.stream_chunk_bytes, total_elems - done);
+            try std.testing.expectEqual(stp.elems * 2, stp.raw_bytes);
+            try std.testing.expectEqual(stp.elems * 4, stp.wide_bytes);
+            done += stp.elems;
+        }
+        try std.testing.expectEqual(total_elems, done);
+        try std.testing.expect(chunks >= 6);
+    }
+
+    // 3. Real 78-layer per-rank placement bytes + 128K KvPool + stream budget admission.
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const aa = arena.allocator();
+    var trunk_hdr: st.Header = .empty;
+    try putEntry(aa, &trunk_hdr, "model.embed_tokens.weight", .bf16, &.{ 120_832, 6144 });
+    try putEntry(aa, &trunk_hdr, "lm_head.weight", .bf16, &.{ 120_832, 6144 });
+    try putEntry(aa, &trunk_hdr, "model.norm.weight", .bf16, &.{6144});
+    try putEntry(aa, &trunk_hdr, "model.hc_head.fn.weight", .f32, &.{ 24576 });
+
+    const l0_hdr = try buildRealLayerHeader(aa, 0, true, true);
+    const l_full_hdr = try buildRealLayerHeader(aa, 1, false, true);
+    const l_shared_hdr = try buildRealLayerHeader(aa, 2, false, false);
+
+    const r0 = try ranks.Rank.init(0, 4);
+    const tp1_78 = (try sumHeaderGpuBytes(&trunk_hdr, full_t, null)) +
+        (try sumHeaderGpuBytes(&l0_hdr, full_t, null)) +
+        20 * (try sumHeaderGpuBytes(&l_full_hdr, full_t, null)) +
+        57 * (try sumHeaderGpuBytes(&l_shared_hdr, full_t, null));
+    const tp4_78 = (try sumHeaderGpuBytes(&trunk_hdr, full_t, r0)) +
+        (try sumHeaderGpuBytes(&l0_hdr, full_t, r0)) +
+        20 * (try sumHeaderGpuBytes(&l_full_hdr, full_t, r0)) +
+        57 * (try sumHeaderGpuBytes(&l_shared_hdr, full_t, r0));
+
+    const g: u64 = 1 << 30;
+    try std.testing.expect(tp1_78 > 290 * g); // unsharded > 290 GiB (exceeds 120 GiB Spark!)
+    try std.testing.expect(tp4_78 > 75 * g and tp4_78 < 92 * g); // sharded ~85 GiB fits 103 GiB budget!
+
+    const phys_128k = try cuda_backend.capacity(131_072);
+    const slot_128k: u64 = kv_pool.poolBytes(full_t, phys_128k);
+    try std.testing.expectEqual(@as(u64, 95_232) * 131_088, slot_128k);
+    const mla_cap: u64 = try cuda.hy4_ops.scratchBytes(.{
+        .rows = cuda_backend.prompt_rows, .heads = 16, .capacity = @intCast(phys_128k),
+        .key_count = 2048, .latent = 512, .nope = 192, .rope = 64, .value = 256,
+    });
+    const spark_room_after_weights: u64 = (103 * g) - tp4_78;
+    try std.testing.expectEqual(@as(usize, 1), try cuda_native.fitSlots(spark_room_after_weights, 8, false, mla_cap, slot_128k));
+
+    // 4. End-to-end disk placementWeightBytes on a 2-shard checkpoint directory (TP=4 < 40% of TP=1).
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const dir = try tmp.dir.realPathFileAlloc(io, ".", gpa);
+    defer gpa.free(dir);
+    try tmp.dir.writeFile(io, .{ .sub_path = "config.json", .data =
+        \\{"model_type":"hy_v4_vl","text_config":{"model_type":"hy_v4","hidden_size":32,"intermediate_size":64,"moe_intermediate_size":16,"num_hidden_layers":1,"vocab_size":101,"q_lora_rank":12,"kv_lora_rank":8,"num_attention_heads":4,"qk_nope_head_dim":10,"qk_rope_head_dim":6,"v_head_dim":16,"index_n_heads":4,"index_head_dim":16,"index_topk":16,"indexer_types":["full"],"mlp_layer_types":["dense"],"n_routed_experts":4,"num_experts_per_tok":2,"rope_parameters":{"rope_type":"default","rope_theta":10000000,"mrope_section":[1,1,1]}}}
+    });
+    try tmp.dir.writeFile(io, .{ .sub_path = "model.safetensors.index.json", .data =
+        \\{"weight_map":{"model.embed_tokens.weight":"s0.safetensors","lm_head.weight":"s0.safetensors","model.layers.0.mlp.gate_proj.weight":"s1.safetensors","model.layers.0.mlp.up_proj.weight":"s1.safetensors","model.layers.0.mlp.down_proj.weight":"s1.safetensors","visual.patch.weight":"s1.safetensors"}}
+    });
+    const s0 = try std.fs.path.join(gpa, &.{ dir, "s0.safetensors" }); defer gpa.free(s0);
+    const s1 = try std.fs.path.join(gpa, &.{ dir, "s1.safetensors" }); defer gpa.free(s1);
+    const emb_b: [101 * 32 * 2]u8 = @splat(0);
+    const mlp_b: [64 * 32 * 2]u8 = @splat(0);
+    const vis_b: [64 * 32 * 2]u8 = @splat(0);
+    try core.shard_edit.create(gpa, s0, &.{}, &.{
+        .{ .name = "model.embed_tokens.weight", .dtype = .bf16, .shape = &.{ 101, 32 }, .bytes = &emb_b },
+        .{ .name = "lm_head.weight", .dtype = .bf16, .shape = &.{ 101, 32 }, .bytes = &emb_b },
+    });
+    try core.shard_edit.create(gpa, s1, &.{}, &.{
+        .{ .name = "model.layers.0.mlp.gate_proj.weight", .dtype = .bf16, .shape = &.{ 64, 32 }, .bytes = &mlp_b },
+        .{ .name = "model.layers.0.mlp.up_proj.weight", .dtype = .bf16, .shape = &.{ 64, 32 }, .bytes = &mlp_b },
+        .{ .name = "model.layers.0.mlp.down_proj.weight", .dtype = .bf16, .shape = &.{ 32, 64 }, .bytes = &mlp_b },
+        .{ .name = "visual.patch.weight", .dtype = .bf16, .shape = &.{ 64, 32 }, .bytes = &vis_b },
+    });
+    const b_tp1 = try cuda_native.native.placementWeightBytes(gpa, io, dir, 1, 0, false);
+    const b_tp4_r0 = try cuda_native.native.placementWeightBytes(gpa, io, dir, 4, 0, false);
+    const b_tp4_r3 = try cuda_native.native.placementWeightBytes(gpa, io, dir, 4, 3, false);
+    try std.testing.expectEqual(@as(u64, 101 * 32 * 2 + 101 * 32 * 4 + 3 * (64 * 32 * 2)), b_tp1);
+    try std.testing.expectEqual(@as(u64, 101 * 32 * 2 + 26 * 32 * 4 + 3 * (16 * 32 * 2)), b_tp4_r0);
+    try std.testing.expectEqual(@as(u64, 101 * 32 * 2 + 23 * 32 * 4 + 3 * (16 * 32 * 2)), b_tp4_r3);
+    try std.testing.expectError(error.BadHy4Rank, cuda_native.native.placementWeightBytes(gpa, io, dir, 2, 0, false));
+    _ = resident;
+}
