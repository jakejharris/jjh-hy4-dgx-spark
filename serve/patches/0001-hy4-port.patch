+pub fn explainCommon(_: ?*anyopaque, err: anyerror) ?[]const u8 {
+    return switch (err) {
+        error.PastContext => "the prompt and its reply exceed this Hy4 server's context window: shorten it or lower max_tokens",
+        error.NoFreeSlot => "every Hy4 stream's KV caches are in use: retry once another request ends",
+        error.NoDraftHead => "Hy4 on CUDA has no draft head: serve with --drafter for DFly2 or let drafts come from prompt copies",
+        error.Hy4TextOnly => "this Hy4 server started without --vision: restart with --vision (and TF_HY4_VISION_DIR if vit.* is in a sidecar) to send images",
+        error.MissingVisionWeights => "--vision: no vit.* tensors found in MODEL_DIR or TF_HY4_VISION_DIR; point TF_HY4_VISION_DIR at the vit.* sidecar",
+        error.VisionTokensPastFrame => "--vision-image-tokens: requested image-token budget exceeds the 512 MiB Hy4 TP plan frame limit (~43.5K image tokens at 128K context); lower --vision-image-tokens",
+        error.UnsupportedHy4Vision => "--vision: checkpoint vision_config or processor_config.json uses unsupported Hy4 vision settings",
+        error.DuplicateVisionTensor => "--vision: duplicate vit.* tensor found across vision shards",
+        error.BadHy4VisionShape, error.BadHy4VisionPrompt => "Hy4 vision prompt tokens and image grid shapes did not match",
+        error.StructuresUnsupported => "structured output masks are not built for Hy4 on CUDA yet",
+        error.NonFiniteLogits => "Hy4 logits went non-finite at this row: stopping request rather than emitting invalid tokens",
+        error.CapturedKernels => "Hy4 runs on the engine's own CUDA kernels: unset TENSORFOLD_CUDA_KERNELS",
+        error.BuiltWithoutKernels => "this build carries no Hy4 CUDA kernel images: build with -Dnvcc or -Dfatbins",
+        error.ParallelPastRound => "--parallel: Hy4 on CUDA holds at most 16 streams per round: serve --parallel 16 or fewer, or auto",
+        error.ParallelPastMemory => "--parallel: the CUDA memory budget fits fewer Hy4 streams than asked (each stream holds lossless BF16 MLA + indexer KV): lower --parallel or --context",
+        error.NoStreamFits => "the CUDA memory budget fits no Hy4 stream after the weights: lower --context, free device memory, or adjust TENSORFOLD_MEMORY_RESERVE_GIB / TENSORFOLD_CUDA_MEMORY_LIMIT_GB",
+        error.BadHy4Rank => "--tp: Hy4 supports --tp 1 or --tp 4 with --rank 0..3",
+        error.Hy4DrafterOneRankOnly => "--drafter: Hy4 DFly2 drafter currently runs on one rank (--tp 1); serve without --tp or without --drafter",
+        error.MissingDrafterWeights, error.BadDraftGeometry => "--drafter: path contains no valid Full Hy4 DFly2 (model.dfly_layers.*) weights",
+        error.Hy4BuildMismatch => "Hy4 TP=4 refused to start: running executable SHA-256 differs across ranks",
+        error.Hy4PackMismatch => "Hy4 TP=4 refused to start: checkpoint pack SHA-256 differs across ranks",
+        error.Hy4RunMismatch => "Hy4 TP=4 refused to start: context, stream count, or --vision settings differ across ranks",
+        error.Hy4RankPickMismatch => "Hy4 TP=4 failed cross-rank parity: MoE router_ids or indexer index_positions diverged across ranks",
+        error.Hy4LoadTimeout => "Hy4 TP=4 timed out waiting for all ranks to finish loading weights (raise TF_HY4_LOAD_TIMEOUT_S)",
+        error.Hy4BootstrapTimeout => "Hy4 TP=4 rank-to-rank coordination timed out mid-run (check peer rank health or TF_HY4_TP_TIMEOUT_S)",
+        error.Hy4SocketTransportRefused => "Hy4 TP=4 refused NET/Socket while IB transport is required (set NCCL_NET=IB)",
+        error.MissingHy4TrunkProfile => "TF_HY4_TRUNK / --trunk or drafter sidecar directory was not found",
+        error.MissingHy4TargetHead => "TF_HY4_TARGET_HEAD / --target-head sidecar with lm_head.trellis was not found; refusing to fall back silently to FP32",
+        error.InvalidHy4TargetHead => "TF_HY4_TARGET_HEAD / --target-head is invalid (expected off/fp32, 4b, 6b, 4b=/path, or a sidecar path)",
+        error.InvalidHy4TrunkRecipe => "TF_HY4_TRUNK / --trunk syntax is invalid (expected e.g. 4b, 6b, 4b6b, or 4b,o_proj=6b,kv_a=6b)",
+        error.TrunkBitWidthMismatch => "EXL3 sidecar bit-width (k2) does not match requested profile or trunk.index.json metadata",
+        error.Hy4PackTrunkMismatch => "per-rank Hy4 pack was cut with a different --trunk or --target-head recipe than requested; unset TF_HY4_TRUNK / TF_HY4_TARGET_HEAD or re-export the pack",
+        error.BadCostTable => "Hy4 row-cost table (TF_HY4_ROW_COST_TABLE) is malformed or missing: pass v1:..,v2:..,d:..,e:.., CSV, or a readable file path",
+        else => null,
+    };
+}
+
+pub fn isLoadedModelTensor(name: []const u8, num_layers: u32) bool {
+    if (std.mem.eql(u8, name, "model.embed_tokens.weight") or
+        std.mem.startsWith(u8, name, "lm_head.") or
+        std.mem.eql(u8, name, "model.norm.weight") or
+        std.mem.startsWith(u8, name, "model.hc_head."))
+    {
+        return true;
+    }
+    const pfx = "model.layers.";
+    if (!std.mem.startsWith(u8, name, pfx)) return false;
+    const rest = name[pfx.len..];
+    const dot = std.mem.indexOfScalar(u8, rest, '.') orelse return false;
+    const l = std.fmt.parseInt(u32, rest[0..dot], 10) catch return false;
+    return l < num_layers;
+}
+
+pub fn isLoadedDrafterTensor(name: []const u8, num_draft_layers: u32) bool {
+    const pfx = "model.dfly_layers.";
+    if (!std.mem.startsWith(u8, name, pfx)) return false;
+    const rest = name[pfx.len..];
+    if (std.mem.startsWith(u8, rest, "confidence_head.")) return false;
+    if (std.mem.startsWith(u8, rest, "mtp_fusion.") or
+        std.mem.startsWith(u8, rest, "final_norm.") or
+        std.mem.startsWith(u8, rest, "hidden_correction."))
+    {
+        return num_draft_layers > 0;
+    }
+    const dot = std.mem.indexOfScalar(u8, rest, '.') orelse return false;
+    const l = std.fmt.parseInt(u32, rest[0..dot], 10) catch return false;
+    return l < num_draft_layers;
+}
+
+pub fn entryGpuBytes(
+    names: *const core.safetensors.Header,
+    name: []const u8,
+    e: core.safetensors.Entry,
+    t: config.Text,
+    rank_opt: ?ranks.Rank,
+) !u64 {
+    const disk_bytes: u64 = if (rank_opt) |r|
+        (try ranks.headerTensorSpan(names, name, e, t, r, false)).bytes()
+    else
+        @intCast(e.end - e.begin);
+    if (std.mem.eql(u8, name, "lm_head.weight") and (e.dtype == .bf16 or e.dtype == .f16)) return disk_bytes * 2;
+    if (std.mem.eql(u8, name, "model.dfly_layers.mtp_fusion.gate") and (e.dtype == .bf16 or e.dtype == .f16)) return disk_bytes * 2;
+    if (std.mem.endsWith(u8, name, "learnable_sink_param") and (e.dtype == .bf16 or e.dtype == .f16)) return disk_bytes * 2;
+    if (std.mem.endsWith(u8, name, ".mlp.gate.weight") and (e.dtype == .bf16 or e.dtype == .f16)) return disk_bytes * 3;
+    if (e.dtype == .i16 and (std.mem.endsWith(u8, name, ".su") or std.mem.endsWith(u8, name, ".sv"))) return disk_bytes * 16;
+    return disk_bytes;
+}
+
+pub fn hy4PlacementWeightBytes(
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    dir: []const u8,
+    tp_world: usize,
+    rank_idx: usize,
+    with_drafts: bool,
+) !u64 {
+    var idx = try weights.ShardIndex.open(gpa, io, dir);
+    defer idx.deinit();
+    return hy4PlacementWeightBytesIndexWithDrafts(gpa, io, &idx, tp_world, rank_idx, with_drafts);
+}
+
+pub fn hy4PlacementWeightBytesIndex(
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    idx: *const weights.ShardIndex,
+    tp_world: usize,
+    rank_idx: usize,
+) !u64 {
+    return hy4PlacementWeightBytesIndexWithDrafts(gpa, io, idx, tp_world, rank_idx, false);
+}
+
+pub fn hy4PlacementWeightBytesIndexWithDrafts(
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    idx: *const weights.ShardIndex,
+    tp_world: usize,
+    rank_idx: usize,
+    with_drafts: bool,
+) !u64 {
+    if (tp_world != 1 and tp_world != cuda.hy4_tp.world) return error.BadHy4Rank;
+    if (rank_idx >= tp_world) return error.BadHy4Rank;
+    const rank_opt: ?ranks.Rank = if (tp_world == cuda.hy4_tp.world) try ranks.Rank.init(rank_idx, tp_world) else null;
+    const m = idx.cfg.value;
+    const t = m.text_config;
+    const ls = try ranks.LocalShape.forText(t, rank_opt);
+    const count_dfly = with_drafts and m.dfly_num_hidden_layers > 0;
+
+    var unique: std.StringHashMapUnmanaged(void) = .empty;
+    defer unique.deinit(gpa);
+    var map_it = idx.weight_map.iterator();
+    while (map_it.next()) |kv| {
+        const k = kv.key_ptr.*;
+        if (isLoadedModelTensor(k, t.num_hidden_layers) or (count_dfly and isLoadedDrafterTensor(k, m.dfly_num_hidden_layers))) {
+            try unique.put(gpa, kv.value_ptr.*, {});
+        }
+    }
+
+    var total: u64 = 0;
+    var saw_lm_head = false;
+    var shard_it = unique.keyIterator();
+    while (shard_it.next()) |rel_ptr| {
+        const rel = rel_ptr.*;
+        const path = try std.fs.path.join(gpa, &.{ idx.dir, rel });
+        defer gpa.free(path);
+        var f = try core.safetensors.File.open(gpa, io, path);
+        defer f.close(io);
+        for (f.names.keys(), f.names.values()) |k, e| {
+            const take = isLoadedModelTensor(k, t.num_hidden_layers) or (count_dfly and isLoadedDrafterTensor(k, m.dfly_num_hidden_layers));
+            if (!take) continue;
+            if (idx.weight_map.get(k)) |mapped_rel| {
+                if (!std.mem.eql(u8, mapped_rel, rel)) continue;
+            } else continue;
+            if (std.mem.eql(u8, k, "lm_head.weight") or std.mem.eql(u8, k, "lm_head.trellis")) saw_lm_head = true;
+            total = try std.math.add(u64, total, try entryGpuBytes(&f.names, k, e, t, if (idx.pack != null) null else rank_opt));
+        }
+    }
+    if (!saw_lm_head and t.tie_word_embeddings) {
+        total = try std.math.add(u64, total, @as(u64, ls.vocab_local) * t.hidden_size * 4);
+    }
+    return total;
+}
+
+/// `HostRoom.read` (`cuda.zig` `Probe.read`) queries `pool.room(cuda.usage(false).device - held0)` AFTER
+/// `ResidentModel.load` has already allocated both trunk and drafter weights: on unified memory without
+/// `TENSORFOLD_CUDA_MEMORY_LIMIT_GB` (`MemAvailable - reserve`) AND under an explicit cap (`cap - held`),
+/// `draft_weight_bytes` is already deducted in `room_opt.read()`. Never subtract `draft_weight_bytes` a second time.
+pub fn admitSlotsAfterLoad(room_opt: ?HostRoom, asked: u32, fixed: bool, fixed_bytes: u64, slot_bytes: u64) !struct { slots: usize, logged_room: u64 } {
+    const room: u64 = if (room_opt) |r| r.read(r.ctx) orelse 0 else std.math.maxInt(u64);
+    const n_slots = try fitSlots(room, asked, fixed, fixed_bytes, slot_bytes);
+    return .{ .slots = n_slots, .logged_room = if (room_opt != null) room else 0 };
+}
+
+const BaseOptions = struct {
+    context: usize, drafts: bool, drafter: ?[]const u8 = null, mtp_drafts: ?u32 = null,
+    segments: usize = 1, slide: bool = false, lanes: u32 = 8, lanes_fixed: bool = false,
+    tp: u32 = 1, rank: u32 = 0, master: ?[]const u8 = null, master_port: ?u16 = null, room: ?HostRoom = null,
+};
+
+const Owned = struct {
+    gpa: std.mem.Allocator, idx: weights.ShardIndex, drafter_idx: ?weights.ShardIndex = null,
+    stream: cuda.Stream, tp_sess: ?boundary.TpSession = null, model: resident.ResidentModel,
+    vision: ?vision_runtime.VisionRuntime = null, hb: cuda_backend.Hy4Backend,
+};
+
+fn followOwned(p: *anyopaque) anyerror!void { return @as(*Owned, @ptrCast(@alignCast(p))).hb.followLoop(); }
+
+fn releaseOwned(p: *anyopaque) void {
+    const own: *Owned = @ptrCast(@alignCast(p));
+    if (own.tp_sess) |*tps| if (tps.rank == .zero) if (tps.plan_link) |*pl| pl.send(&.{@intFromEnum(boundary.PlanOp.stop)}) catch {};
+    own.hb.deinit();
+    own.model.vision = null;
+    if (own.vision) |*vr| vr.deinit();
+    own.model.deinit();
+    if (own.tp_sess) |*tps| tps.close();
+    own.stream.deinit();
+    if (own.drafter_idx) |*didx| didx.deinit();
+    own.idx.deinit();
+    own.gpa.destroy(own);
+}
+
+fn openCommon(
+    comptime mt: []const u8, gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context,
+    dir: []const u8, kernels: ?[]const u8, o: BaseOptions, vis_limits: ?vision_image.Limits,
+) !struct { own: *Owned, slot_bytes: u64, n_slots: usize, p_rows: u32 } {
+    if (kernels != null) return error.CapturedKernels;
+    if (o.tp != 1 and o.tp != cuda.hy4_tp.world) return error.BadHy4Rank;
+    if (o.tp == 1 and o.rank != 0) return error.BadHy4Rank;
+    if (o.lanes_fixed and o.lanes > cuda_backend.round_rows) return error.ParallelPastRound;
+    const physical = try cuda_backend.capacity(o.context);
+    const p_rows: u32 = @intCast(@min(@as(usize, try cuda_backend.activePromptRows()), physical));
+    const sw = try cuda.hy4_kernels.PrefillSwitches.fromProcess();
+    if (vis_limits != null) _ = try vision_weights.resolveVisionTarget(dir);
+    const vcfg: ?vision_config.Config = if (vis_limits != null)
+        ((try vision_config.readFromDir(gpa, io, dir)) orelse return error.MissingVisionWeights)
+    else null;
+    if (vis_limits) |vl| try vision_runtime.validateStartupLimits(vl, o.context, vcfg.?.out_hidden_size);
+
+    const own = try gpa.create(Owned);
+    errdefer gpa.destroy(own);
+    own.gpa = gpa; own.drafter_idx = null; own.tp_sess = null; own.vision = null;
+    own.idx = try weights.ShardIndex.openWithTrunkAndHead(gpa, io, dir, null, null, null, o.drafter);
+    errdefer own.idx.deinit();
+
+    const t = own.idx.cfg.value.text_config;
+    if (o.context > t.max_position_embeddings) return error.PastContext;
+
+    own.drafter_idx = if (o.drafts) try trunk_exl3.openDrafterIndex(gpa, io, &own.idx, null, o.drafter, null, null) else null;
+    errdefer if (own.drafter_idx) |*didx| didx.deinit();
+    const inline_dfly = o.drafts and own.drafter_idx == null and own.idx.cfg.value.dfly_num_hidden_layers > 0;
+
+    own.stream = try cuda.Stream.init(ctx.d, false);
+    errdefer own.stream.deinit();
+    if (o.tp == cuda.hy4_tp.world) {
+        const env_opts = try boundary.ConnectOptions.fromEnv();
+        own.tp_sess = try boundary.TpSession.openWithStream(io, own.stream, .{
+            .tp_world = o.tp, .rank = o.rank, .master = o.master orelse env_opts.master,
+            .port = o.master_port orelse env_opts.port, .timeout_s = env_opts.timeout_s,
+            .load_timeout_s = env_opts.load_timeout_s, .require_ib = env_opts.require_ib, .with_plan_link = true,
+        });
+    }
+    errdefer if (own.tp_sess) |*tps| tps.abortAndClose();
+
+    var tag_buf: [320]u8 = undefined;
+    const d_tag = if (own.drafter_idx) |didx| didx.trunk_tag else "";
+    const run_tag = try formatServeRunTag(
+        &tag_buf, o.context, o.lanes, o.lanes_fixed, own.drafter_idx != null or inline_dfly,
+        boundary.envFlag("HY4_TP_DIRECT_WRITE"), p_rows, sw, d_tag, vis_limits,
+    );
+    if (own.tp_sess) |*tps| {
+        try tps.agreePackAndRun(gpa, io, &own.idx, run_tag);
+        if (own.drafter_idx) |*didx| try tps.agreeDrafterPack(gpa, io, didx);
+    }
+
+    const drafter_ptr: ?*const weights.ShardIndex = if (own.drafter_idx) |*didx| didx else if (inline_dfly) &own.idx else null;
+    own.model = try resident.ResidentModel.load(gpa, io, ctx.d, own.stream, &own.idx, .{
+        .chunk_rows = p_rows, .logits_rows = cuda_backend.max_window,
+        .tp_sess = if (own.tp_sess) |*tps| tps else null, .drafter_idx = drafter_ptr,
+    }, null);
+    errdefer own.model.deinit();
+
+    var v_enc: ?vision_runtime.Rank0Encoder = if (vcfg != null and o.rank == 0)
+        try vision_runtime.Rank0Encoder.init(gpa, io, ctx.d, own.stream, vcfg.?, dir) else null;
+    var v_enc_moved = false;
+    errdefer if (!v_enc_moved) if (v_enc) |*e| e.deinit();
+
+    const ls = try ranks.LocalShape.forText(t, if (own.tp_sess) |tps| tps.rank else null);
+    const kv_slot_bytes: u64 = kv_pool.poolBytesSlice(t, 0, own.model.layers.len, physical);
+    const vis_slot_bytes: u64 = if (vis_limits) |vl| @as(u64, vl.image_tokens) * vcfg.?.out_hidden_size * 2 else 0;
+    const vis_chunk_bytes: u64 = if (vis_limits != null) @as(u64, p_rows) * 16 else 0;
+    const mla_shape: cuda.hy4_ops.MlaShape = .{
+        .rows = p_rows, .heads = ls.heads, .capacity = @intCast(physical),
+        .key_count = @intCast(@as(usize, @max(@as(usize, 1), @as(usize, @min(@as(usize, t.index_topk), physical))))),
+        .latent = t.kv_lora_rank, .nope = t.qk_nope_head_dim, .rope = t.qk_rope_head_dim, .value = t.v_head_dim,
+    };
+    const mla_cur = try cuda.hy4_ops.scratchBytesFor(&own.model.rt.ops, mla_shape);
+    const mla_cap: u64 = if (vis_limits != null) @max(mla_cur, try cuda.hy4_ops.scratchBytes(mla_shape)) else mla_cur;
+    if (vis_limits != null and own.model.rt.ops.fast_prefill) try own.model.sc.ensureMlaScratch(mla_cap);
+    const pending_mla: u64 = mla_cap -| own.model.sc.mla_scratch.len;
+    const admitted = try admitSlotsAfterLoad(o.room, o.lanes, o.lanes_fixed, pending_mla + vis_chunk_bytes, kv_slot_bytes + vis_slot_bytes);
+    var n_slots = admitted.slots;
+    if (own.tp_sess) |*tps| {
+        var slot_le = std.mem.nativeToLittle(u64, n_slots);
+        try tps.broadcastPostLoad(std.mem.asBytes(&slot_le), std.mem.asBytes(&slot_le));
+        n_slots = @intCast(std.mem.littleToNative(u64, slot_le));
+    }
+
+    if (vis_limits) |vl| {
+        own.vision = try vision_runtime.VisionRuntime.initWithEncoder(gpa, io, ctx.d, own.stream, vcfg.?, vl, n_slots, p_rows, v_enc);
+        v_enc_moved = true;
+        own.model.vision = &own.vision.?;
+    }
+    errdefer { own.model.vision = null; if (own.vision) |*vr| vr.deinit(); }
+
+    own.hb = try cuda_backend.Hy4Backend.init(gpa, &own.model, n_slots, physical);
+    own.hb.priority_copies = o.drafts and own.model.drafter == null;
+    if (own.tp_sess) |*tps| own.hb.plan_link = &tps.plan_link.?;
+
+    const resident_wb: u64 = own.model.weight_bytes + own.model.draft_weight_bytes + (if (own.vision) |vr| vr.towerBytes() else 0);
+    const t_lbl = trunkLabel(own.model.layers);
+    const d_lbl = drafterLabel(o.drafts, if (own.model.drafter) |*dr| dr else null);
+    const h_lbl = trunk_exl3.headLabel(own.model.head);
+    var info_buf: [512]u8 = undefined;
+    std.log.info("{s}", .{try formatLoadedLog(&info_buf, mt, o.tp, o.rank, own.model.load_ns + own.model.draft_load_ns, own.model.layers.len, n_slots, kv_slot_bytes, o.context, resident_wb, admitted.logged_room, t_lbl, d_lbl, h_lbl, own.hb.untimed)});
+    return .{ .own = own, .slot_bytes = kv_slot_bytes + vis_slot_bytes, .n_slots = n_slots, .p_rows = p_rows };
+}
+
+pub fn Native(comptime mt: []const u8) type {
+    if (comptime std.mem.eql(u8, mt, "hy_v4_vl")) {
+        return struct {
+            pub const model_type = mt;
+            pub const formats: []const []const u8 = &.{ "exl3", "bf16" };
+            pub const default_context: i64 = 131_072;
+            pub const default_image_tokens: u32 = vision_image.default_image_tokens;
+            pub const max_segments: u32 = 1;
+            pub const prompt_rows: u32 = cuda_backend.prompt_rows;
+            pub const window_rows: u32 = cuda_backend.max_window;
+            pub const keeps_no_prompts = true;
+            pub const takes_drafter = true;
+            pub const explains_open = true;
+            pub const placementWeightBytes = hy4PlacementWeightBytes;
+            pub const visionBytes = vision_weights.visionGpuBytes;
+            pub const Room = HostRoom;
+            pub const explain = explainCommon;
+
+            pub const Options = struct {
+                context: usize, drafts: bool, drafter: ?[]const u8 = null, mtp_drafts: ?u32 = null,
+                segments: usize = 1, slide: bool = false, lanes: u32 = 8, lanes_fixed: bool = false,
+                tp: u32 = 1, rank: u32 = 0, master: ?[]const u8 = null, master_port: ?u16 = null,
+                room: ?HostRoom = null, vision: ?vision_image.Limits = null,
+            };
+
+            pub const Loaded = struct {
+                draft_kind: ?[]const u8 = null, backend: lanes.backend.Backend, facts: lanes.Model, rows: u32,
+                prompt_rows: u32 = cuda_backend.prompt_rows,
+                stream_bytes: usize, free_streams: u32, ctx: *anyopaque, deinit: *const fn (*anyopaque) void,
+                target: *cuda_backend.Hy4Backend, follow: ?*const fn (*anyopaque) anyerror!void = null,
+                layout: ?core.kv_pool.Layout = null, vision: ?*vision_image.VisionOffer = null,
+            };
+
+            pub fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, kernels: ?[]const u8, o: Options) !Loaded {
+                const res = try openCommon(mt, gpa, io, ctx, dir, kernels, .{
+                    .context = o.context, .drafts = o.drafts, .drafter = o.drafter, .mtp_drafts = o.mtp_drafts,
+                    .segments = o.segments, .slide = o.slide, .lanes = o.lanes, .lanes_fixed = o.lanes_fixed,
+                    .tp = o.tp, .rank = o.rank, .master = o.master, .master_port = o.master_port, .room = o.room,
+                }, o.vision);
+                return .{
+                    .draft_kind = if (res.own.model.drafter != null) "DFly2" else null,
+                    .backend = res.own.hb.backend(), .facts = res.own.hb.facts(), .rows = cuda_backend.max_window,
+                    .prompt_rows = res.p_rows,
+                    .stream_bytes = @intCast(res.slot_bytes), .free_streams = @intCast(res.n_slots),
+                    .ctx = res.own, .deinit = releaseOwned, .target = &res.own.hb,
+                    .follow = if (o.tp > 1 and o.rank != 0) followOwned else null,
+                    .vision = if (o.rank == 0 and res.own.vision != null) &res.own.vision.?.offer else null,
+                };
+            }
+        };
+    }
+    return struct {
+        pub const model_type = mt;
+        pub const formats: []const []const u8 = &.{ "exl3", "bf16" };
+        pub const default_context: i64 = 131_072;
+        pub const max_segments: u32 = 1;
+        pub const prompt_rows: u32 = cuda_backend.prompt_rows;
+        pub const window_rows: u32 = cuda_backend.max_window;
+        pub const keeps_no_prompts = true;
+        pub const takes_drafter = true;
+        pub const explains_open = true;
+        pub const placementWeightBytes = hy4PlacementWeightBytes;
+        pub const Room = HostRoom;
+        pub const explain = explainCommon;
+        pub const Options = BaseOptions;
+
+        pub const Loaded = struct {
+            draft_kind: ?[]const u8 = null, backend: lanes.backend.Backend, facts: lanes.Model, rows: u32,
+            prompt_rows: u32 = cuda_backend.prompt_rows,
+            stream_bytes: usize, free_streams: u32, ctx: *anyopaque, deinit: *const fn (*anyopaque) void,
+            target: *cuda_backend.Hy4Backend, follow: ?*const fn (*anyopaque) anyerror!void = null,
+            layout: ?core.kv_pool.Layout = null,
+        };
+
+        pub fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, kernels: ?[]const u8, o: Options) !Loaded {
+            const res = try openCommon(mt, gpa, io, ctx, dir, kernels, o, null);
+            return .{
+                .draft_kind = if (res.own.model.drafter != null) "DFly2" else null,
+                .backend = res.own.hb.backend(), .facts = res.own.hb.facts(), .rows = cuda_backend.max_window,
+                .prompt_rows = res.p_rows,
+                .stream_bytes = @intCast(res.slot_bytes), .free_streams = @intCast(res.n_slots),
+                .ctx = res.own, .deinit = releaseOwned, .target = &res.own.hb,
+                .follow = if (o.tp > 1 and o.rank != 0) followOwned else null,
+            };
+        }
+    };
+}
diff --git a/zig/src/families/hy4/direct_load.zig b/zig/src/families/hy4/direct_load.zig
new file mode 100644
index 0000000000000000000000000000000000000000..bed310985eefb76c22aa5790246b0702c665a2ef
--- /dev/null
+++ b/zig/src/families/hy4/direct_load.zig
@@ -0,0 +1,597 @@
+//! Fast O_DIRECT weight gather + double-buffered layer prefetch for Full Hy4 (`hy_v4_vl` / `hy_v4`).
+//!
+//! Uses `core.direct_gather.Pair` (multi-threaded 8 MiB `O_DIRECT` reads, skipping Linux page cache).
+//! On TP=4 (`rank != null`), gathers and streams ONLY this rank's byte `Span` (`ranks.tensorSpan`) of
+//! every sliced tensor so unowned stripes are never read into host arenas or uploaded to device memory.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const ranks = @import("ranks.zig");
+const weights = @import("weights.zig");
+const trunk_exl3 = @import("trunk_exl3.zig");
+
+const st = core.safetensors;
+const direct_io = core.direct_io;
+const direct_gather = core.direct_gather;
+const Uploader = cuda.exl3_upload.Uploader;
+
+pub const max_gather_tensor_bytes: usize = 256 << 20;
+pub const stream_chunk_bytes: usize = 64 << 20;
+
+const GatherEntry = struct {
+    name: []const u8,
+    first_view: usize,
+    count: usize,
+    len: usize,
+};
+
+const UnitSlot = struct {
+    sess: weights.ShardSession,
+    sources: std.ArrayList(direct_gather.Source) = .empty,
+    entries: std.ArrayList(GatherEntry) = .empty,
+    views: std.ArrayList([]const u8) = .empty,
+    ptrs: std.ArrayList(*[]const u8) = .empty,
+    packed_bufs: std.ArrayList([]u8) = .empty,
+    copies: std.StringHashMapUnmanaged([]const u8) = .empty,
+    force_vocab_on_embed: bool = false,
+    valid: bool = false,
+
+    fn init(idx: *const weights.ShardIndex, io: std.Io, rank: ?ranks.Rank) UnitSlot {
+        return .{ .sess = weights.ShardSession.initWithRank(idx, io, rank) };
+    }
+
+    fn reset(self: *UnitSlot, gpa: std.mem.Allocator) void {
+        const idx = self.sess.idx;
+        const io = self.sess.io;
+        const rk = self.sess.rank;
+        for (self.packed_bufs.items) |b| gpa.free(b);
+        self.packed_bufs.clearRetainingCapacity();
+        self.sources.clearRetainingCapacity();
+        self.entries.clearRetainingCapacity();
+        self.views.clearRetainingCapacity();
+        self.ptrs.clearRetainingCapacity();
+        self.copies.clearRetainingCapacity();
+        self.sess.close();
+        self.sess = weights.ShardSession.initWithRank(idx, io, rk);
+        self.valid = false;
+    }
+
+    fn deinit(self: *UnitSlot, gpa: std.mem.Allocator) void {
+        for (self.packed_bufs.items) |b| gpa.free(b);
+        self.packed_bufs.deinit(gpa);
+        self.sources.deinit(gpa);
+        self.entries.deinit(gpa);
+        self.views.deinit(gpa);
+        self.ptrs.deinit(gpa);
+        self.copies.deinit(gpa);
+        self.sess.close();
+        self.* = undefined;
+    }
+
+    fn prepare(self: *UnitSlot, gpa: std.mem.Allocator, prefixes: []const []const u8, gather_limit_bytes: usize) !void {
+        const force_vocab = self.force_vocab_on_embed;
+        self.reset(gpa);
+        self.force_vocab_on_embed = force_vocab;
+        const idx = self.sess.idx;
+        var shard_ids: std.StringHashMapUnmanaged(usize) = .empty;
+        defer shard_ids.deinit(gpa);
+
+        var it = idx.weight_map.iterator();
+        while (it.next()) |entry| {
+            const tname = entry.key_ptr.*;
+            var matched = false;
+            for (prefixes) |pfx| if (std.mem.startsWith(u8, tname, pfx)) {
+                matched = true;
+                break;
+            };
+            if (!matched) continue;
+
+            const rel = try self.sess.relFor(tname);
+            const fptr = try self.sess.openShard(rel);
+            if (!shard_ids.contains(rel)) {
+                try self.sources.append(gpa, .{ .path = fptr.path, .memory = fptr.map.memory });
+                try shard_ids.put(gpa, rel, self.sources.items.len - 1);
+            }
+            const tensor = fptr.get(tname) orelse continue;
+            const st_entry = fptr.names.get(tname) orelse continue;
+
+            if (self.sess.rank) |rk| {
+                const fv = self.force_vocab_on_embed and std.mem.eql(u8, tname, "model.embed_tokens.weight");
+                const span = try self.sess.spanOf(fptr, tname, st_entry, rk, fv);
+                const sb: usize = @intCast(span.bytes());
+                if (sb == 0 or sb > gather_limit_bytes) continue;
+                const first_v = self.views.items.len;
+                const cnt: usize = @intCast(span.count);
+                const rlen: usize = @intCast(span.len);
+                try self.views.ensureUnusedCapacity(gpa, cnt);
+                for (0..cnt) |j| {
+                    const off: usize = @intCast(span.at(j));
+                    self.views.appendAssumeCapacity(tensor.bytes[off..][0..rlen]);
+                }
+                try self.entries.append(gpa, .{ .name = tname, .first_view = first_v, .count = cnt, .len = rlen });
+            } else {
+                if (tensor.bytes.len == 0 or tensor.bytes.len > gather_limit_bytes) continue;
+                const first_v = self.views.items.len;
+                try self.views.append(gpa, tensor.bytes);
+                try self.entries.append(gpa, .{ .name = tname, .first_view = first_v, .count = 1, .len = tensor.bytes.len });
+            }
+        }
+
+        try self.ptrs.ensureTotalCapacity(gpa, self.views.items.len);
+        for (self.views.items) |*v| self.ptrs.appendAssumeCapacity(v);
+        self.valid = true;
+    }
+
+    pub fn indexCopies(self: *UnitSlot, gpa: std.mem.Allocator) !void {
+        self.copies.clearRetainingCapacity();
+        try self.copies.ensureTotalCapacity(gpa, @intCast(self.entries.items.len));
+        for (self.entries.items) |ent| {
+            if (ent.count == 1) {
+                self.copies.putAssumeCapacity(ent.name, self.views.items[ent.first_view]);
+            } else {
+                const buf = try gpa.alloc(u8, ent.count * ent.len);
+                errdefer gpa.free(buf);
+                try self.packed_bufs.append(gpa, buf);
+                for (0..ent.count) |j| {
+                    @memcpy(buf[j * ent.len ..][0..ent.len], self.views.items[ent.first_view + j]);
+                }
+                self.copies.putAssumeCapacity(ent.name, buf);
+            }
+        }
+    }
+};
+
+pub fn f32StreamStep(chunk_bytes: usize, rem_elems: usize) !struct { elems: usize, raw_bytes: usize, wide_bytes: usize } {
+    const max_chunk_elems: usize = chunk_bytes / 2;
+    if (max_chunk_elems == 0) return error.UnexpectedTensor;
+    const cur_elems: usize = @min(max_chunk_elems, rem_elems);
+    return .{ .elems = cur_elems, .raw_bytes = cur_elems * 2, .wide_bytes = cur_elems * 4 };
+}
+
+pub const DirectPrefetcher = struct {
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    idx: *const weights.ShardIndex,
+    rank: ?ranks.Rank = null,
+    enabled: bool,
+    gather_limit_bytes: usize = max_gather_tensor_bytes,
+    chunk_bytes: usize = stream_chunk_bytes,
+    pair: direct_gather.Pair,
+    slots: [2]UnitSlot,
+    active_slot: usize = 0,
+    prefetched_layer: ?usize = null,
+    stream_buf: []align(direct_io.alignment) u8 = &.{},
+    widen_buf: []u8 = &.{},
+
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, idx: *const weights.ShardIndex) DirectPrefetcher {
+        return initWithRank(gpa, io, idx, null);
+    }
+
+    pub fn initWithRank(gpa: std.mem.Allocator, io: std.Io, idx: *const weights.ShardIndex, rank: ?ranks.Rank) DirectPrefetcher {
+        const on = direct_gather.enabled();
+        const readers = if (on) (core.checkpoint.loadReaders() catch 4) else 1;
+        return .{
+            .gpa = gpa,
+            .io = io,
+            .idx = idx,
+            .rank = rank,
+            .enabled = on,
+            .pair = direct_gather.Pair.init(gpa, readers),
+            .slots = .{ UnitSlot.init(idx, io, rank), UnitSlot.init(idx, io, rank) },
+        };
+    }
+
+    pub fn deinit(self: *DirectPrefetcher) void {
+        self.pair.deinit();
+        self.slots[0].deinit(self.gpa);
+        self.slots[1].deinit(self.gpa);
+        if (self.stream_buf.len != 0) self.gpa.free(self.stream_buf);
+        if (self.widen_buf.len != 0) self.gpa.free(self.widen_buf);
+        self.* = undefined;
+    }
+
+    fn ensureStreamBuf(self: *DirectPrefetcher) !direct_io.Buffer {
+        const cap: usize = self.chunk_bytes + 2 * direct_io.alignment;
+        if (self.stream_buf.len < cap) {
+            if (self.stream_buf.len != 0) self.gpa.free(self.stream_buf);
+            self.stream_buf = try self.gpa.alignedAlloc(u8, .fromByteUnits(direct_io.alignment), cap);
+        }
+        return self.stream_buf;
+    }
+
+    fn ensureWidenBuf(self: *DirectPrefetcher, need: usize) ![]u8 {
+        if (self.widen_buf.len < need) {
+            if (self.widen_buf.len != 0) self.gpa.free(self.widen_buf);
+            self.widen_buf = try self.gpa.alloc(u8, need);
+        }
+        return self.widen_buf[0..need];
+    }
+
+    const HookCtx = struct {
+        pf: *DirectPrefetcher,
+        slot: *UnitSlot,
+
+        fn copy(raw: *anyopaque, name: []const u8) ?[]const u8 {
+            const c: *const @This() = @ptrCast(@alignCast(raw));
+            return c.slot.copies.get(name);
+        }
+
+        fn streamRaw(raw: *anyopaque, file: *const st.File, rel: []const u8, bytes: []const u8, up: *Uploader) anyerror!?u64 {
+            const c: *@This() = @ptrCast(@alignCast(raw));
+            if (!c.pf.enabled or bytes.len <= c.pf.gather_limit_bytes) return null;
+            return try c.pf.directUploadRaw(file, rel, bytes, up);
+        }
+
+        fn streamF32(raw: *anyopaque, file: *const st.File, rel: []const u8, tensor: st.Tensor, up: *Uploader) anyerror!?u64 {
+            const c: *@This() = @ptrCast(@alignCast(raw));
+            if (!c.pf.enabled or tensor.bytes.len <= c.pf.gather_limit_bytes) return null;
+            return try c.pf.directUploadF32(file, rel, tensor, up);
+        }
+    };
+
+    fn allocUploaderBuf(up: *Uploader, len: usize) !cuda.DeviceBuffer {
+        if (up.bufs.items.len >= up.max_buffers) return error.UploadLimit;
+        const total = std.math.add(usize, up.bytes, len) catch return error.UploadLimit;
+        try up.bufs.ensureUnusedCapacity(up.gpa, 1);
+        const b = try cuda.DeviceBuffer.alloc(up.d, len);
+        up.bufs.appendAssumeCapacity(b);
+        up.bytes = total;
+        return b;
+    }
+
+    fn directUploadRaw(self: *DirectPrefetcher, file: *const st.File, _: []const u8, bytes: []const u8, up: *Uploader) !u64 {
+        const base = @intFromPtr(file.map.memory.ptr);
+        const p = @intFromPtr(bytes.ptr);
+        if (p < base or p + bytes.len > base + file.map.memory.len) return error.UnmappedView;
+        const file_off: u64 = p - base;
+
+        var df = try direct_io.File.open(file.path);
+        defer df.close();
+        const buf = try self.ensureStreamBuf();
+        const dst_buf = try allocUploaderBuf(up, bytes.len);
+
+        var off: usize = 0;
+        while (off < bytes.len) {
+            const step: usize = @min(self.chunk_bytes, bytes.len - off);
+            const slice = try df.read(buf, file_off + off, step);
+            try dst_buf.upload(off, slice);
+            off += step;
+        }
+        return dst_buf.ptr;
+    }
+
+    fn directUploadF32(self: *DirectPrefetcher, file: *const st.File, rel: []const u8, tensor: st.Tensor, up: *Uploader) !u64 {
+        if (tensor.dtype == .f32) return self.directUploadRaw(file, rel, tensor.bytes, up);
+        if (tensor.dtype != .bf16 and tensor.dtype != .f16) return error.UnexpectedTensor;
+
+        const base = @intFromPtr(file.map.memory.ptr);
+        const p = @intFromPtr(tensor.bytes.ptr);
+        if (p < base or p + tensor.bytes.len > base + file.map.memory.len) return error.UnmappedView;
+        const file_off: u64 = p - base;
+
+        var df = try direct_io.File.open(file.path);
+        defer df.close();
+        const buf = try self.ensureStreamBuf();
+        const total_elems: usize = tensor.numel();
+        const dst_buf = try allocUploaderBuf(up, total_elems * 4);
+
+        const first_step = try f32StreamStep(self.chunk_bytes, total_elems);
+        const wide = try self.ensureWidenBuf(first_step.wide_bytes);
+        var elem_off: usize = 0;
+        while (elem_off < total_elems) {
+            const step = try f32StreamStep(self.chunk_bytes, total_elems - elem_off);
+            const raw_slice = try df.read(buf, file_off + elem_off * 2, step.raw_bytes);
+            const sub_t: st.Tensor = .{ .dtype = tensor.dtype, .rank = 1, .shape = .{ step.elems, 0, 0, 0, 0 }, .bytes = raw_slice };
+            try core.quant.convert.widenInto(wide[0..step.wide_bytes], sub_t);
+            try dst_buf.upload(elem_off * 4, wide[0..step.wide_bytes]);
+            elem_off += step.elems;
+        }
+        return dst_buf.ptr;
+    }
+
+    fn gatherSync(self: *DirectPrefetcher, slot_idx: usize, prefixes: []const []const u8, rank_override: ?ranks.Rank, force_vocab: bool) !*UnitSlot {
+        const slot = &self.slots[slot_idx];
+        slot.sess.idx = self.idx;
+        slot.sess.io = self.io;
+        slot.sess.rank = rank_override;
+        slot.force_vocab_on_embed = force_vocab;
+        if (!self.enabled) {
+            slot.reset(self.gpa);
+            slot.sess.rank = rank_override;
+            slot.force_vocab_on_embed = force_vocab;
+            return slot;
+        }
+        try slot.prepare(self.gpa, prefixes, self.gather_limit_bytes);
+        if (slot.ptrs.items.len > 0) try self.pair.read(slot.sources.items, slot.ptrs.items);
+        try slot.indexCopies(self.gpa);
+        return slot;
+    }
+
+    pub fn startLayerPrefetch(self: *DirectPrefetcher, layer: usize) !void {
+        if (!self.enabled or layer >= self.idx.cfg.value.text_config.num_hidden_layers) return;
+        if (self.prefetched_layer == layer) return;
+        try self.pair.wait();
+        const next_idx = 1 - self.active_slot;
+        const slot = &self.slots[next_idx];
+        slot.sess.idx = self.idx;
+        slot.sess.io = self.io;
+        slot.sess.rank = self.rank;
+        slot.force_vocab_on_embed = false;
+        var pbuf: [64]u8 = undefined;
+        const pfx = try std.fmt.bufPrint(&pbuf, "model.layers.{d}.", .{layer});
+        try slot.prepare(self.gpa, &.{pfx}, self.gather_limit_bytes);
+        if (slot.ptrs.items.len > 0) try self.pair.start(slot.sources.items, slot.ptrs.items, null);
+        self.prefetched_layer = layer;
+    }
+
+    pub fn loadTrunk(self: *DirectPrefetcher, up: *Uploader) !weights.TrunkWeights {
+        self.prefetched_layer = null;
+        const slot = try self.gatherSync(self.active_slot, &.{"model.embed_tokens."}, null, false);
+        defer slot.reset(self.gpa);
+        var hc: HookCtx = .{ .pf = self, .slot = slot };
+        slot.sess.direct = .{ .ctx = &hc, .copy = HookCtx.copy, .streamRaw = HookCtx.streamRaw, .streamF32 = HookCtx.streamF32 };
+        return weights.loadTrunkSession(&slot.sess, up);
+    }
+
+    pub fn runWithPrefixes(self: *DirectPrefetcher, prefixes: []const []const u8, ctx: *anyopaque, call: *const fn (*anyopaque, *weights.ShardSession) anyerror!void) !void {
+        self.prefetched_layer = null;
+        const slot = try self.gatherSync(self.active_slot, prefixes, self.rank, false);
+        defer slot.reset(self.gpa);
+        var hc: HookCtx = .{ .pf = self, .slot = slot };
+        slot.sess.direct = .{ .ctx = &hc, .copy = HookCtx.copy, .streamRaw = HookCtx.streamRaw, .streamF32 = HookCtx.streamF32 };
+        try call(ctx, &slot.sess);
+    }
+
+    pub fn loadHead(self: *DirectPrefetcher, up: *Uploader) !weights.HeadWeights {
+        self.prefetched_layer = null;
+        const t = self.idx.cfg.value.text_config;
+        const tied = !self.idx.has("lm_head.weight") and !self.idx.has("lm_head.trellis") and t.tie_word_embeddings;
+        const prefixes: []const []const u8 = if (tied)
+            &.{ "model.hc_head.", "model.norm.", "model.embed_tokens." }
+        else
+            &.{ "model.hc_head.", "model.norm.", "lm_head." };
+        const slot = try self.gatherSync(self.active_slot, prefixes, self.rank, tied);
+        defer slot.reset(self.gpa);
+        var hc: HookCtx = .{ .pf = self, .slot = slot };
+        slot.sess.direct = .{ .ctx = &hc, .copy = HookCtx.copy, .streamRaw = HookCtx.streamRaw, .streamF32 = HookCtx.streamF32 };
+        return weights.loadHeadSession(&slot.sess, self.gpa, up);
+    }
+
+    pub fn loadLayer(self: *DirectPrefetcher, up: *Uploader, layer: usize, next_layer: ?usize) !weights.LayerWeights {
+        var slot: *UnitSlot = undefined;
+        if (self.enabled and self.prefetched_layer == layer) {
+            try self.pair.wait();
+            self.active_slot = 1 - self.active_slot;
+            self.prefetched_layer = null;
+            slot = &self.slots[self.active_slot];
+            try slot.indexCopies(self.gpa);
+        } else {
+            self.prefetched_layer = null;
+            var pbuf: [64]u8 = undefined;
+            const pfx = try std.fmt.bufPrint(&pbuf, "model.layers.{d}.", .{layer});
+            slot = try self.gatherSync(self.active_slot, &.{pfx}, self.rank, false);
+        }
+        defer slot.reset(self.gpa);
+
+        if (next_layer) |nl| try self.startLayerPrefetch(nl);
+
+        var hc: HookCtx = .{ .pf = self, .slot = slot };
+        slot.sess.direct = .{ .ctx = &hc, .copy = HookCtx.copy, .streamRaw = HookCtx.streamRaw, .streamF32 = HookCtx.streamF32 };
+        return weights.loadLayerSession(&slot.sess, self.gpa, up, layer);
+    }
+};
+
+pub const CheckLoadStats = struct {
+    has_trunk: bool = false,
+    has_head: bool = false,
+    n_dense: usize = 0,
+    n_bf16: usize = 0,
+    n_exl3: usize = 0,
+    n_trunk_exl3: usize = 0,
+    trunk_exl3_mats: usize = 0,
+    exl3_dims: usize = 0,
+    exl3_width: usize = 0,
+};
+
+pub fn checkLoad(
+    gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, idx: *const weights.ShardIndex,
+    only_layer: ?usize, max_layers: ?usize, skip_head: bool,
+) !CheckLoadStats {
+    return checkLoadRank(gpa, io, d, idx, only_layer, max_layers, skip_head, null);
+}
+
+pub fn checkLoadRank(
+    gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, idx: *const weights.ShardIndex,
+    only_layer: ?usize, max_layers: ?usize, skip_head: bool, rank: ?ranks.Rank,
+) !CheckLoadStats {
+    const t = idx.cfg.value.text_config;
+    const start: usize = only_layer orelse 0;
+    const end: usize = if (only_layer) |l| l + 1 else @min(max_layers orelse @as(usize, t.num_hidden_layers), @as(usize, t.num_hidden_layers));
+    if (start >= t.num_hidden_layers or end > t.num_hidden_layers) return error.BadLayerIndex;
+
+    var pf = DirectPrefetcher.initWithRank(gpa, io, idx, rank);
+    defer pf.deinit();
+    var up: Uploader = .{ .d = d, .gpa = gpa, .max_buffers = 1 << 16, .slab = 64 << 20 };
+    defer up.deinit();
+
+    var stats: CheckLoadStats = .{};
+    if (only_layer == null) {
+        _ = try pf.loadTrunk(&up);
+        up.rollback(0);
+        stats.has_trunk = true;
+    }
+    if (start < end) try pf.startLayerPrefetch(start);
+    for (start..end) |l| {
+        const next_l: ?usize = if (l + 1 < end) l + 1 else null;
+        var lw = try pf.loadLayer(&up, l, next_l);
+        const tm = trunk_exl3.countLayerExl3(&lw);
+        if (tm > 0) { stats.n_trunk_exl3 += 1; stats.trunk_exl3_mats += tm; }
+        switch (lw.mlp) {
+            .dense => stats.n_dense += 1,
+            .sparse_bf16 => stats.n_bf16 += 1,
+            .sparse_exl3 => |sp| {
+                stats.n_exl3 += 1;
+                stats.exl3_dims = sp.exl3_layer.dims;
+                stats.exl3_width = sp.exl3_layer.width;
+            },
+        }
+        lw.deinitHost(gpa);
+        up.rollback(0);
+    }
+    if (only_layer == null and !skip_head) {
+        _ = try pf.loadHead(&up);
+        up.rollback(0);
+        stats.has_head = true;
+    }
+    return stats;
+}
+
+test "DirectPrefetcher gathers multi-layer and TP=4 strided shards via O_DIRECT arenas" {
+    const gpa = std.testing.allocator;
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const dir = try tmp.dir.realPathFileAlloc(io, ".", gpa);
+    defer gpa.free(dir);
+
+    try tmp.dir.writeFile(io, .{ .sub_path = "config.json", .data =
+        \\{"text_config":{"model_type":"hy_v4","hidden_size":32,"intermediate_size":64,"moe_intermediate_size":16,
+        \\"num_hidden_layers":2,"vocab_size":16,"q_lora_rank":12,"kv_lora_rank":8,"num_attention_heads":4,
+        \\"qk_nope_head_dim":10,"qk_rope_head_dim":6,"v_head_dim":16,"index_n_heads":4,"index_head_dim":16,
+        \\"index_topk":16,"indexer_types":["full","shared"],"mlp_layer_types":["dense","dense"],
+        \\"n_routed_experts":4,"num_experts_per_tok":2}}
+    });
+
+    const shard_path = try std.fs.path.join(gpa, &.{ dir, "model.safetensors" });
+    defer gpa.free(shard_path);
+    const v0 = [_]u16{ 0x3f80, 0x4000, 0x4040, 0x4080 };
+    var down0: [2 * 8]u16 = undefined;
+    for (&down0, 0..) |*x, k| x.* = @intCast(k + 10);
+    try core.shard_edit.create(gpa, shard_path, &.{}, &.{
+        .{ .name = "model.layers.0.probe", .dtype = .bf16, .shape = &.{4}, .bytes = std.mem.sliceAsBytes(&v0) },
+        .{ .name = "model.layers.1.mlp.down_proj.weight", .dtype = .bf16, .shape = &.{ 2, 8 }, .bytes = std.mem.sliceAsBytes(&down0) },
+    });
+
+    var idx = try weights.ShardIndex.open(gpa, io, dir);
+    defer idx.deinit();
+    var pf = DirectPrefetcher.initWithRank(gpa, io, &idx, try ranks.Rank.init(2, 4));
+    defer pf.deinit();
+
+    try pf.startLayerPrefetch(0);
+    try pf.pair.wait();
+    pf.active_slot = 1 - pf.active_slot;
+    pf.prefetched_layer = null;
+    try pf.slots[pf.active_slot].indexCopies(gpa);
+    try pf.startLayerPrefetch(1);
+
+    try std.testing.expectEqualSlices(u8, std.mem.sliceAsBytes(&v0), pf.slots[pf.active_slot].copies.get("model.layers.0.probe").?);
+
+    try pf.pair.wait();
+    pf.active_slot = 1 - pf.active_slot;
+    try pf.slots[pf.active_slot].indexCopies(gpa);
+    const got_d = pf.slots[pf.active_slot].copies.get("model.layers.1.mlp.down_proj.weight").?;
+    // Rank 2 owns columns [4..6) of each row in [2, 8]: values {14, 15, 22, 23}.
+    const expect_r2 = [_]u16{ 14, 15, 22, 23 };
+    try std.testing.expectEqualSlices(u8, std.mem.sliceAsBytes(&expect_r2), got_d);
+}
