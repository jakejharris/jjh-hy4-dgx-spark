+            else if (std.mem.eql(u8, arg, "--chunk-size")) chunk_size = try std.fmt.parseInt(usize, val, 10)
+            else if (std.mem.eql(u8, arg, "--greedy")) greedy_tokens = try std.fmt.parseInt(usize, val, 10)
+            else if (std.mem.eql(u8, arg, "--bench-window")) bench_window_iters = try std.fmt.parseInt(usize, val, 10)
