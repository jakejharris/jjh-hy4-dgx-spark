+    .{ .image = "router", .symbol = "router", .threads = 256, .shared = 0, .dynamic = 33280, .regs = .{ 40, 40, 40, 64, 64 } },
+    .{ .image = "trunk", .symbol = "range_finish", .threads = 256, .shared = 0, .regs = .{ 27, 28, 28, 27, 27 } },
+    .{ .image = "trunk", .symbol = "range_prepare", .threads = 256, .shared = 32, .regs = .{ 26, 28, 28, 26, 26 } },
