+/// Valid RFC 1950/1951 fixed-Huffman zlib stream inflating to `n` bytes of `fill` (~635x compression).
+fn makeZlibRepeat(a: std.mem.Allocator, fill: u8, n: usize) ![]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(a);
+    try out.appendSlice(a, &.{ 0x78, 0x01 });
+    var bit_buf: u64 = 0;
+    var bit_cnt: u6 = 0;
+    const putLsb = struct {
+        fn f(al: std.mem.Allocator, list: *std.ArrayList(u8), b: *u64, c: *u6, val: u32, width: u5) !void {
+            b.* |= (@as(u64, val) << c.*);
+            c.* += width;
+            while (c.* >= 8) {
+                try list.append(al, @truncate(b.*));
+                b.* >>= 8;
+                c.* -= 8;
+            }
+        }
+        fn huff(al: std.mem.Allocator, list: *std.ArrayList(u8), b: *u64, c: *u6, code: u16, width: u4) !void {
+            var rev: u32 = 0;
+            for (0..width) |i| rev |= @as(u32, (code >> @intCast(width - 1 - i)) & 1) << @intCast(i);
+            try f(al, list, b, c, rev, width);
+        }
+    };
+    try putLsb.f(a, &out, &bit_buf, &bit_cnt, 0b011, 3); // BFINAL=1, BTYPE=01 (fixed Huffman)
+    if (n > 0) {
+        if (fill < 144) try putLsb.huff(a, &out, &bit_buf, &bit_cnt, 0x30 + @as(u16, fill), 8)
