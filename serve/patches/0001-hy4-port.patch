+//! Opt-in repeat-stable adaptive drafting (`TF_HY4_REPEAT_STABLE=1` or `untimed:1` in `TF_HY4_ROW_COST_TABLE`).
+const std = @import("std");
+const lanes = @import("lanes");
+const draft_policy = @import("draft_policy.zig");
+
+pub const Resolved = struct {
+    untimed: bool = false,
+    table_spec: ?[]const u8 = null,
+};
+
+pub fn parseFlag(raw_opt: ?[]const u8) !bool {
+    const raw = raw_opt orelse return false;
+    const s = std.mem.trim(u8, raw, " \t\r\n");
+    if (s.len == 0 or std.ascii.eqlIgnoreCase(s, "0") or std.ascii.eqlIgnoreCase(s, "false") or std.ascii.eqlIgnoreCase(s, "off")) return false;
+    if (std.ascii.eqlIgnoreCase(s, "1") or std.ascii.eqlIgnoreCase(s, "true") or std.ascii.eqlIgnoreCase(s, "on")) return true;
+    return error.BadRepeatStable;
+}
+
+/// Resolves `TF_HY4_REPEAT_STABLE` and inline `untimed:0|1` or `repeat_stable:0|1` items in `TF_HY4_ROW_COST_TABLE`.
+pub fn resolve(raw_table: ?[]const u8, raw_flag: ?[]const u8, buf: *[4096]u8) !Resolved {
+    var untimed = try parseFlag(raw_flag);
+    const tbl_raw = raw_table orelse return .{ .untimed = untimed, .table_spec = null };
+    const trimmed = std.mem.trim(u8, tbl_raw, " \t\r\n");
+    if (trimmed.len == 0) return .{ .untimed = untimed, .table_spec = null };
+    if (trimmed[0] == '@' or (std.mem.indexOfScalar(u8, trimmed, ',') == null and std.mem.indexOfScalar(u8, trimmed, '/') != null)) {
+        return .{ .untimed = untimed, .table_spec = trimmed };
+    }
+    if (std.mem.indexOfAny(u8, trimmed, ":=") == null) {
+        return .{ .untimed = untimed, .table_spec = trimmed };
+    }
+
+    var out_len: usize = 0;
+    var it = std.mem.tokenizeAny(u8, trimmed, ",;\r\n");
+    while (it.next()) |raw_item| {
+        const item = std.mem.trim(u8, raw_item, " \t");
+        if (item.len == 0) continue;
+        if (std.mem.indexOfAny(u8, item, ":=")) |sep| {
+            const key = std.mem.trim(u8, item[0..sep], " \t");
+            const val = std.mem.trim(u8, item[sep + 1 ..], " \t");
+            if (std.mem.eql(u8, key, "untimed") or std.mem.eql(u8, key, "repeat_stable")) {
+                untimed = untimed or try parseFlag(val);
+                continue;
+            }
+        }
+        if (out_len + item.len + 1 > buf.len) return error.BadCostTable;
+        if (out_len > 0) {
+            buf[out_len] = ',';
+            out_len += 1;
+        }
+        @memcpy(buf[out_len..][0..item.len], item);
+        out_len += item.len;
+    }
+    return .{ .untimed = untimed, .table_spec = if (out_len > 0) buf[0..out_len] else null };
+}
+
+test "repeat_stable.resolve defaults off, accepts env flag and inline untimed:1, and rejects invalid flags" {
+    var buf: [4096]u8 = undefined;
+    const d0 = try resolve(null, null, &buf);
+    try std.testing.expect(!d0.untimed and d0.table_spec == null);
+
+    const d1 = try resolve("v1:56.14,v7:112.07,d:6.44,e:0.41", null, &buf);
+    try std.testing.expect(!d1.untimed);
+    try std.testing.expectEqualStrings("v1:56.14,v7:112.07,d:6.44,e:0.41", d1.table_spec.?);
+
+    const d2 = try resolve("v1:56.14,v7:112.07,d:6.44,e:0.41,untimed:1", null, &buf);
+    try std.testing.expect(d2.untimed);
+    try std.testing.expectEqualStrings("v1:56.14,v7:112.07,d:6.44,e:0.41", d2.table_spec.?);
+
+    const d3 = try resolve("v1:56.14,v7:112.07", "1", &buf);
+    try std.testing.expect(d3.untimed);
+    try std.testing.expectError(error.BadRepeatStable, resolve(null, "invalid", &buf));
+}
+
+test "untimed adaptive drafting is repeat-stable under wall-clock spikes while timed drifts across a width near-tie" {
+    const gpa = std.testing.allocator;
+    const be = lanes.backend;
+    const tbl = try draft_policy.CostParams.parseTableSpec(
+        "v1:56.14,v2:69.85,v3:78.43,v4:86.84,v5:95.25,v6:103.66,v7:112.07,d:6.44,e:0.41",
+        0,
+        0,
+    );
+    var wc: [7]lanes.config.Cost = undefined;
+    for (&wc, 0..) |*slot, d| slot.* = .{ .width = @intCast(d + 1), .ms = tbl.roundMs(d) };
+
+    const JitterClock = struct {
+        spike_ms: f64 = 102.5,
+        round_calls: usize = 0,
+        fn startFn(_: *anyopaque) void {}
+        fn elapsedFn(ptr: *anyopaque, mark: be.Mark) f64 {
+            const c: *@This() = @ptrCast(@alignCast(ptr));
+            if (mark == .overhead) return 1.0;
+            c.round_calls += 1;
+            return if (c.round_calls == 2) c.spike_ms else 102.5;
+        }
+        fn clock(c: *@This()) be.Clock {
+            return .{ .ptr = c, .vtable = &.{ .start = startFn, .elapsed_ms = elapsedFn } };
+        }
+    };
+
+    const NearTieTarget = struct {
+        inner: be.Backend,
+        fn prefill(p: *anyopaque, s: *lanes.Stream) anyerror!void {
+            const t: *@This() = @ptrCast(@alignCast(p));
+            return t.inner.vtable.prefill(t.inner.ptr, s);
+        }
+        fn first(p: *anyopaque, s: *lanes.Stream, pos: u64) anyerror!u64 {
+            const t: *@This() = @ptrCast(@alignCast(p));
+            return t.inner.vtable.first(t.inner.ptr, s, pos);
+        }
+        fn queue(p: *anyopaque, s: *lanes.Stream, f: be.Feed, pos: u64) anyerror!u64 {
+            const t: *@This() = @ptrCast(@alignCast(p));
+            return t.inner.vtable.queue(t.inner.ptr, s, f, pos);
+        }
+        fn read(p: *anyopaque, h: u64) anyerror!u32 {
+            const t: *@This() = @ptrCast(@alignCast(p));
+            return t.inner.vtable.read(t.inner.ptr, h);
+        }
+        fn verify(p: *anyopaque, windows: []const be.Window, out: []be.Verified) anyerror!void {
+            const t: *@This() = @ptrCast(@alignCast(p));
+            try t.inner.vtable.verify(t.inner.ptr, windows, out);
+            // Model a 78-layer BF16 verify-width near-tie: 4-row verify flips row 0 vs 5-row verify.
+            if (windows.len == 1 and windows[0].positions.len > 0 and windows[0].positions[0] >= 12 and windows[0].rows() == 4) {
+                out[0].sampled[0] = @intCast((out[0].sampled[0] + 1) % lanes.fake.vocab);
+            }
+        }
+        fn keep(p: *anyopaque, windows: []const be.Window, paths: []const []const u32) anyerror!void {
+            const t: *@This() = @ptrCast(@alignCast(p));
+            return t.inner.vtable.keep(t.inner.ptr, windows, paths);
+        }
+        fn draft(p: *anyopaque, reqs: []const be.DraftRequest) anyerror!void {
+            const t: *@This() = @ptrCast(@alignCast(p));
+            return t.inner.vtable.draft(t.inner.ptr, reqs);
+        }
+        fn held(p: *anyopaque, s: *lanes.Stream, dst: []u32) anyerror!void {
+            const t: *@This() = @ptrCast(@alignCast(p));
+            return t.inner.vtable.held.?(t.inner.ptr, s, dst);
+        }
+        fn release(p: *anyopaque, s: *lanes.Stream) void {
+            const t: *@This() = @ptrCast(@alignCast(p));
+            t.inner.vtable.release(t.inner.ptr, s);
+        }
+        fn backend(t: *@This()) be.Backend {
+            return .{ .ptr = t, .vtable = &.{
+                .prefill = prefill, .first = first, .queue = queue, .read = read,
+                .verify = verify, .keep = keep, .draft = draft, .held = held, .release = release,
+            } };
+        }
+    };
+
+    const spikes = [3]f64{ 102.5, 135.0, 102.5 };
+    const prompt = [_]u32{ 3, 1, 4, 1 };
+
+    for ([_]bool{ false, true }) |untimed| {
+        var cfg = try lanes.Config.init(gpa, .{
+            .fixed_draft_block = true, .plain_guard = true, .copy_drafts = false, .lone_copies = false,
+            .untimed = untimed, .exact_width = 16, .mtp = true, .speculate = true, .speculate_early = false,
+            .draft_prior = &draft_policy.default_rates, .drafts = 6, .window_costs = &wc, .window_costs_lone = true,
+            .mtp_step_ms = 0.0, .hidden_rows = true, .batch_rows = 16, .max_streams = 1,
+        }, 16, 15);
+        defer cfg.deinit(gpa);
+        try std.testing.expectEqual(!untimed, cfg.timed);
+
+        var fake_target: lanes.fake.Fake = .{ .gpa = gpa, .head_accepts = 3 };
+        defer fake_target.deinit();
+        var tie_target: NearTieTarget = .{ .inner = fake_target.backend() };
+        var clk: JitterClock = .{};
+        var engine = lanes.Engine.init(gpa, &cfg, tie_target.backend(), clk.clock());
+        defer engine.deinit();
+
+        var drafted_counts: [3]u64 = undefined;
+        var outs: [3][]u32 = undefined;
+        defer for (outs) |o| gpa.free(o);
+
+        for (spikes, 0..) |sp_ms, idx| {
+            clk = .{ .spike_ms = sp_ms, .round_calls = 0 };
+            var s = try lanes.Stream.init(gpa, .{ .id = "rep", .prompt = &prompt, .max_new = 24, .eos = &.{96} });
+            defer s.deinit(gpa);
+            try engine.addStream(&s);
+            while (engine.activeCount() > 0) try engine.step();
+            drafted_counts[idx] = s.drafted;
+            outs[idx] = try gpa.dupe(u32, s.emitted());
+        }
+
+        if (!untimed) {
+            // Timed default: repeat 2's wall-clock spike shifts d=4 -> d=3 (rows=4) and flips the near-tie token.
+            try std.testing.expect(drafted_counts[0] != drafted_counts[1]);
+            try std.testing.expect(!std.mem.eql(u32, outs[0], outs[1]));
+            try std.testing.expectEqualSlices(u32, outs[0], outs[2]);
+        } else {
+            // Untimed repeat-stable mode: all 3 warm repeats keep identical offered counts and emitted tokens.
+            try std.testing.expectEqual(drafted_counts[0], drafted_counts[1]);
+            try std.testing.expectEqual(drafted_counts[0], drafted_counts[2]);
+            try std.testing.expectEqualSlices(u32, outs[0], outs[1]);
+            try std.testing.expectEqualSlices(u32, outs[0], outs[2]);
+        }
+    }
+}
diff --git a/zig/src/families/hy4/resident.zig b/zig/src/families/hy4/resident.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9c8a15a7dcd050429f02d287def08daad4bbfc1c
--- /dev/null
+++ b/zig/src/families/hy4/resident.zig
@@ -0,0 +1,584 @@
+//! GPU-resident Full Hy4 model runner (`ResidentModel`): fast `O_DIRECT` slice load, chunked prefill over
+//! `KvPool`, 1-row / window cached decode, optional DFly2 speculative decode (`--drafter`), and TP=1 / TP=4.
+const std = @import("std");
+const cuda = @import("cuda");
+const config = @import("config.zig");
+const boundary = @import("boundary.zig");
+const weights = @import("weights.zig");
+const kv_pool = @import("kv_pool.zig");
+const direct_load = @import("direct_load.zig");
+const greedy = @import("greedy.zig");
+const forward = @import("forward.zig");
+const dump_oracle = @import("dump_oracle.zig");
+const rank_picks = @import("rank_picks.zig");
+const trunk_exl3 = @import("trunk_exl3.zig");
+const drafter_mod = @import("drafter.zig");
+const draft_policy = @import("draft_policy.zig");
+const speculative = @import("speculative.zig");
+const window_bench = @import("window_bench.zig");
+
+const Uploader = cuda.exl3_upload.Uploader;
+
+pub const default_chunk_rows: usize = 1024;
+pub const max_decode_window: usize = greedy.max_rows;
+pub const GreedyResult = speculative.GreedyResult;
+pub const runGreedyGeneration = speculative.runGreedyGeneration;
+pub const runGreedyGenerationWithDepth = speculative.runGreedyGenerationWithDepth;
+pub const runGreedyGenerationWithOpts = speculative.runGreedyGenerationWithOpts;
+pub const benchDrafterVsVerify = speculative.benchDrafterVsVerify;
+pub const benchDecodeWindow = window_bench.benchDecodeWindow;
+
+/// Picks the greedy argmax token ID from `logits` (lowest token ID breaks exact ties; fails on NaN/Inf).
+pub fn argmaxF32(logits: []const f32) !u32 {
+    if (logits.len == 0) return error.EmptyVocab;
+    var best_id: u32 = 0;
+    var best_val: f32 = -std.math.inf(f32);
+    for (logits, 0..) |v, id| {
+        if (!std.math.isFinite(v)) return error.NonFiniteLogits;
+        if (v > best_val) {
+            best_val = v;
+            best_id = @intCast(id);
+        }
+    }
+    return best_id;
+}
+
+/// Deterministic synthetic token sequence in `[1, vocab_size)` for long-context (`8K`, `32K`, `128K`) checks.
+pub fn syntheticPrompt(gpa: std.mem.Allocator, vocab_size: u32, seq_len: usize, seed: u64) !dump_oracle.PromptTokens {
+    if (seq_len == 0 or vocab_size < 2) return error.BadInputIds;
+    const ids = try gpa.alloc(u32, seq_len);
+    var prng = std.Random.DefaultPrng.init(seed);
+    const rnd = prng.random();
+    const span = vocab_size - 1;
+    for (ids) |*dst| dst.* = 1 + rnd.uintLessThan(u32, span);
+    return .{ .batch = 1, .seq_len = seq_len, .ids = ids };
+}
+
+pub const LoadOptions = struct {
+    max_layers: ?usize = null, skip_head: bool = false, chunk_rows: usize = default_chunk_rows,
+    logits_rows: usize = max_decode_window, mem_floor_gib: usize = 0, tp_sess: ?*boundary.TpSession = null,
+    drafter_idx: ?*const weights.ShardIndex = null, drafter_synthetic: bool = false, drafter_wrong: bool = false,
+};
+
+fn nowNs(io: std.Io) u64 { return @intCast(@max(@as(i128, 0), std.Io.Clock.awake.now(io).toNanoseconds())); }
+
+pub fn prefillStepCap(prompt_len: usize, chunk_opt: usize, max_rows: usize) !usize {
+    if (prompt_len == 0) return error.EmptyPrompt;
+    const step_cap: usize = if (chunk_opt == 0) prompt_len else @min(chunk_opt, prompt_len);
+    return if (step_cap > max_rows) error.BadHy4PassRows else step_cap;
+}
+
+pub const ResidentModel = struct {
+    gpa: std.mem.Allocator, io: std.Io, t: config.Text, rt: forward.Runtime, up: Uploader,
+    trunk: weights.TrunkWeights, layers: []weights.LayerWeights, head: ?weights.HeadWeights,
+    sc: forward.Scratch, steps: @import("step_graph.zig").Steps = .{},
+    drafter: ?drafter_mod.Drafter = null, anchor: ?drafter_mod.AnchorState = null,
+    pick_recorder: ?*rank_picks.PickRecorder = null, vision: ?*@import("vision_runtime.zig").VisionRuntime = null,
+    tp_sess: ?*boundary.TpSession = null, chunk_rows: usize, load_ns: u64, draft_load_ns: u64 = 0,
+    weight_bytes: u64, draft_weight_bytes: u64 = 0,
+
+    pub fn load(
+        gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, stream: cuda.Stream,
+        idx: *const weights.ShardIndex, opts: LoadOptions,
+        memFloorCheck: ?*const fn (usize) anyerror!void,
+    ) !ResidentModel {
+        const t = idx.cfg.value.text_config;
+        const has_drafter = opts.drafter_idx != null or opts.drafter_synthetic;
+        const layer_count: usize = @min(opts.max_layers orelse @as(usize, t.num_hidden_layers), @as(usize, t.num_hidden_layers));
+        const chunk_rows: usize = @max(opts.chunk_rows, max_decode_window);
+        const logits_rows: usize = if (opts.skip_head) 0 else if (has_drafter) max_decode_window else @as(usize, @max(opts.logits_rows, @as(usize, 1)));
+        const rank_opt = if (opts.tp_sess) |tps| tps.rank else null;
+
+        const t0 = nowNs(io);
+        const dev_before = cuda.memory.usage(false).device;
+
+        var rt = try forward.Runtime.init(gpa, d, stream);
+        errdefer rt.deinit();
+
+        var up: Uploader = .{ .d = d, .gpa = gpa, .max_buffers = 1 << 18, .slab = 64 << 20 };
+        errdefer up.deinit();
+
+        var pf = direct_load.DirectPrefetcher.initWithRank(gpa, io, idx, rank_opt);
+        defer pf.deinit();
+
+        if (memFloorCheck) |chk| try chk(opts.mem_floor_gib);
+        const trunk = try pf.loadTrunk(&up);
+        if (layer_count > 0) try pf.startLayerPrefetch(0);
+
+        const layers = try gpa.alloc(weights.LayerWeights, layer_count);
+        var loaded_layers: usize = 0;
+        errdefer {
+            for (layers[0..loaded_layers]) |*lw| lw.deinitHost(gpa);
+            gpa.free(layers);
+        }
+
+        for (0..layer_count) |l| {
+            if (memFloorCheck) |chk| try chk(opts.mem_floor_gib);
+            const next_l: ?usize = if (l + 1 < layer_count) l + 1 else null;
+            layers[l] = try pf.loadLayer(&up, l, next_l);
+            loaded_layers += 1;
+            try trunk_exl3.reserveLayer(&rt.short_trunk, &rt.exl3_dense, stream, &rt.ops, &layers[l]);
+        }
+
+        const head: ?weights.HeadWeights = if (opts.skip_head) null else blk: {
+            if (memFloorCheck) |chk| try chk(opts.mem_floor_gib);
+            const hd = try pf.loadHead(&up);
+            if (hd.lm_head_exl3) |ex| try trunk_exl3.reserveProj(&rt.short_trunk, &rt.exl3_dense, stream, .{ .exl3 = ex });
+            break :blk hd;
+        };
+
+        const trunk_dev = cuda.memory.usage(false).device;
+        const weight_bytes = trunk_dev -| dev_before;
+        const load_ns: u64 = nowNs(io) -| t0;
+
+        var dfly: ?drafter_mod.Drafter = null;
+        errdefer if (dfly) |*dr| dr.deinit();
+        var anchor: ?drafter_mod.AnchorState = null;
+        errdefer if (anchor) |*anc| anc.deinit();
+        var draft_load_ns: u64 = 0;
+        var draft_weight_bytes: u64 = 0;
+
+        if (opts.drafter_idx) |didx| {
+            const dt0 = nowNs(io);
+            var loaded_d = try drafter_mod.Drafter.loadDirectWithRank(gpa, io, d, didx, &up, rank_opt, memFloorCheck, opts.mem_floor_gib);
+            errdefer loaded_d.deinit();
+            try loaded_d.weights.reserveExl3(&rt.short_trunk, &rt.exl3_dense, stream);
+            loaded_d.fault_wrong_token = opts.drafter_wrong;
+            loaded_d.step_ms = if (rank_opt != null) 4.0 else 14.0;
+            draft_load_ns = nowNs(io) -| dt0;
+            draft_weight_bytes = cuda.memory.usage(false).device -| trunk_dev;
+            anchor = try drafter_mod.AnchorState.init(gpa, d, t, loaded_d.weights.blocks.len, max_decode_window);
+            dfly = loaded_d;
+        } else if (opts.drafter_synthetic) {
+            const dt0 = nowNs(io);
+            var synth_d = try speculative.initSyntheticDrafterWithRank(gpa, d, t, &up, rank_opt, 20261120);
+            errdefer synth_d.deinit();
+            synth_d.fault_wrong_token = opts.drafter_wrong;
+            synth_d.step_ms = 0.5;
+            draft_load_ns = nowNs(io) -| dt0;
+            draft_weight_bytes = cuda.memory.usage(false).device -| trunk_dev;
+            anchor = try drafter_mod.AnchorState.init(gpa, d, t, synth_d.weights.blocks.len, max_decode_window);
+            dfly = synth_d;
+        }
+
+        var sc = try forward.Scratch.initWith(d, t, chunk_rows, .{
+            .logits_rows = logits_rows, .single_layer_cache_cap = 0, .rank = rank_opt,
+        });
+        errdefer sc.deinit();
+        if (rt.ops.fast_prefill) {
+            const pf_plan = try @import("cache.zig").planFastPrefill(&rt.ops, t, rank_opt, layers, chunk_rows);
+            if (pf_plan.mla_bytes > 0) try sc.ensureMlaScratch(pf_plan.mla_bytes);
+            if (pf_plan.aux_bytes > 0) try sc.ensureAuxScratch(pf_plan.aux_bytes);
+            try rt.short_trunk.reservePrefill(pf_plan.pf_w_bytes, pf_plan.pf_x_bytes, pf_plan.pf_part_bytes);
+        }
+
+        if (boundary.envStr("HY4_DECODE_GRAPH")) |v| {
+            const device_path = if (opts.tp_sess) |sess| sess.boundary.relay != null else true;
+            if (device_path and std.mem.eql(u8, v, "1") and t.hidden_size == 6144 and
+                t.index_topk <= 2048 and layers.len != 0)
+            {
+                for (layers) |lw| {
+                    if (lw.mlp == .sparse_bf16) break;
+                } else sc.graph_mode = .warm;
+            }
+        }
+
+        return .{
+            .gpa = gpa, .io = io, .t = t, .rt = rt, .up = up,
+            .trunk = trunk, .layers = layers, .head = head, .sc = sc,
+            .drafter = dfly, .anchor = anchor, .tp_sess = opts.tp_sess,
+            .chunk_rows = chunk_rows, .load_ns = load_ns, .draft_load_ns = draft_load_ns,
+            .weight_bytes = weight_bytes, .draft_weight_bytes = draft_weight_bytes,
+        };
+    }
+
+    pub fn deinit(self: *ResidentModel) void {
+        self.steps.deinit();
+        if (self.anchor) |*anc| anc.deinit();
+        if (self.drafter) |*dr| dr.deinit();
+        self.sc.deinit();
+        for (self.layers) |*lw| lw.deinitHost(self.gpa);
+        self.gpa.free(self.layers);
+        self.up.deinit();
+        self.rt.deinit();
+        self.* = undefined;
+    }
+
+    pub fn forwardStep(self: *ResidentModel, pool: *kv_pool.KvPool, first_pos: usize, tokens: []const u32) !void {
+        return self.forwardStepAnchor(pool, first_pos, tokens, null, 0, 0);
+    }
+
+    fn hasVisionSlot(self: *const ResidentModel) bool {
+        const s = self.sc.vision_slot orelse return false;
+        return if (self.vision) |vr| vr.slots[s].active else false;
+    }
+
+    fn applyVisionEmbed(self: *ResidentModel, first_pos: usize, rows: usize) !void {
+        const s = self.sc.vision_slot orelse { self.sc.mrope = null; return; };
+        self.sc.mrope = if (self.vision) |vr| try vr.prepareStep(s, first_pos, rows, self.sc.streams_a.ptr) else null;
+    }
+
+    pub fn forwardStepAnchor(
+        self: *ResidentModel, pool: *kv_pool.KvPool, first_pos: usize, tokens: []const u32,
+        anchor_out: ?*drafter_mod.AnchorState, anchor_src_off: usize, anchor_rows: usize,
+    ) !void {
+        if (anchor_out == null) return self.step(pool, first_pos, tokens, false);
+        if (tokens.len == 0 or tokens.len > self.sc.max_rows) return error.BadHy4PassRows;
+        if (first_pos > pool.capacity or tokens.len > pool.capacity - first_pos) return error.PastContext;
+        anchor_out.?.beginPass(anchor_rows);
+        try forward.embedTokens(&self.rt, &self.sc, self.trunk.embed_bf16, tokens, self.t.vocab_size, self.t.hidden_size);
+        try self.applyVisionEmbed(first_pos, tokens.len);
+        defer self.sc.mrope = null;
+        try self.forwardLayersAnchor(pool, first_pos, tokens.len, anchor_out, anchor_src_off, anchor_rows);
+    }
+
+    /// Verify the target tokens through the local head and device top-1 on one stream.
+    pub fn forwardGreedy(self: *ResidentModel, pool: *kv_pool.KvPool, pos: usize, tokens: []const u32, ids: []u32) !void {
+        if (ids.len != tokens.len or ids.len > greedy.max_rows) return error.BadHy4PassRows;
+        if (self.head == null) return error.HeadSkipped;
+        if (boundary.envFlag("TF_HY4_GREEDY_FULL_GATHER")) {
+            try self.step(pool, pos, tokens, false);
+            return self.computeGreedyAnchor(0, ids, null);
+        }
+        try self.step(pool, pos, tokens, true);
+        try self.readGreedy(ids);
+    }
+
+    fn step(self: *ResidentModel, pool: *kv_pool.KvPool, pos: usize, tokens: []const u32, pick: bool) !void {
+        if (tokens.len == 0 or tokens.len > self.sc.max_rows) return error.BadHy4PassRows;
+        if (pos > pool.capacity or tokens.len > pool.capacity - pos) return error.PastContext;
+        if (!self.hasVisionSlot() and try self.steps.run(self, pool, pos, tokens, pick)) return;
+        try forward.embedTokens(&self.rt, &self.sc, self.trunk.embed_bf16, tokens, self.t.vocab_size, self.t.hidden_size);
+        try self.applyVisionEmbed(pos, tokens.len);
+        defer self.sc.mrope = null;
+        try self.forwardLayers(pool, pos, tokens.len);
+        if (pick) try self.deviceGreedy(0, tokens.len);
+    }
+
+    pub fn forwardLayers(self: *ResidentModel, pool: *kv_pool.KvPool, first_pos: usize, rows: usize) !void {
+        return self.forwardLayersAnchor(pool, first_pos, rows, null, 0, 0);
+    }
+
+    fn forwardLayersAnchor(
+        self: *ResidentModel, pool: *kv_pool.KvPool, first_pos: usize, rows: usize,
+        anchor_out: ?*drafter_mod.AnchorState, anchor_src_off: usize, anchor_rows: usize,
+    ) !void {
+        var unused_k: usize = 0;
+        self.sc.has_active_dev = false;
+        self.sc.active_k_dev = 0;
+        for (self.layers) |*lw| {
+            const lc = try pool.layerCache(lw.index);
+            try forward.forwardLayerTp(&self.rt, &self.sc, self.t, lw, first_pos, rows, lc, null, &unused_k, null, self.tp_sess, null);
+            if (self.pick_recorder) |rec| {
+                try rec.observeDeviceLayer(self.rt.d, self.rt.stream, self.t, lw.index, first_pos, rows, lc.has_prefix, self.sc.router_ids.ptr, self.sc.indices_buf.ptr);
+            }
+            if (anchor_out) |anc| if (self.drafter) |*dr| {
+                if (first_pos + rows > self.t.index_topk and self.sc.has_active_dev and self.sc.active_k_dev == self.t.index_topk and anchor_rows > 0) {
+                    for (dr.weights.blocks, 0..) |blk, b_idx| {
+                        const tgt = try drafter_mod.resolveTargetLayers(blk.target_kv, blk.target_index, self.t, self.layers.len);
+                        if (tgt.ix == lw.index) {
+                            try anc.captureRecalledBlock(self.rt.d, self.rt.stream, b_idx, self.sc.active_indices_dev.ptr, anchor_src_off, anchor_rows);
+                        }
+                    }
+                }
+            };
+        }
+    }
+
+    pub fn computeLogits(self: *ResidentModel, row_offset: usize, rows: usize, logits_out: []f32) !void {
+        return self.computeLogitsAnchor(row_offset, rows, logits_out, null);
+    }
+
+    pub fn computeLogitsAnchor(self: *ResidentModel, row_offset: usize, rows: usize, logits_out: []f32, anchor_out: ?*drafter_mod.AnchorState) !void {
+        const hd = self.head orelse return error.HeadSkipped;
+        if (logits_out.len != rows * self.t.vocab_size) return error.BadOracleShape;
+        const stream_row_bytes = @as(usize, 4) * self.t.hidden_size * 2;
+        const streams_ptr = self.sc.streams_a.ptr + row_offset * stream_row_bytes;
+        const ref_rows: usize = if (row_offset > 0 and rows == 1) row_offset + 1 else 0;
+        try forward.forwardHeadTp(&self.rt, &self.sc, self.t, hd, streams_ptr, rows, ref_rows, self.tp_sess, std.mem.sliceAsBytes(logits_out));
+        if (anchor_out) |anc| try anc.captureHidden(self.rt.stream, self.sc.hidden.ptr, rows);
+    }
+
+    pub fn computeGreedy(self: *ResidentModel, row_offset: usize, ids: []u32) !void {
+        return self.computeGreedyAnchor(row_offset, ids, null);
+    }
+
+    /// Runs the same FP32 head and GEMM plan as computeLogits, exchanging only the 8-byte winners per row.
+    pub fn computeGreedyAnchor(self: *ResidentModel, row_offset: usize, ids: []u32, anchor_out: ?*drafter_mod.AnchorState) !void {
+        if (boundary.envFlag("TF_HY4_GREEDY_FULL_GATHER")) {
+            const logits_host = try self.gpa.alloc(f32, ids.len * self.t.vocab_size);
+            defer self.gpa.free(logits_host);
+            try self.computeLogitsAnchor(row_offset, ids.len, logits_host, anchor_out);
+            for (ids, 0..) |*dst, r| dst.* = try argmaxF32(logits_host[r * self.t.vocab_size ..][0..self.t.vocab_size]);
+            return;
+        }
+        try self.deviceGreedyAnchor(row_offset, ids.len, anchor_out);
+        try self.readGreedy(ids);
+    }
+
+    pub fn deviceGreedy(self: *ResidentModel, row_offset: usize, rows: usize) !void {
+        return self.deviceGreedyAnchor(row_offset, rows, null);
+    }
+
+    fn deviceGreedyAnchor(self: *ResidentModel, row_offset: usize, rows: usize, anchor_out: ?*drafter_mod.AnchorState) !void {
+        const hd = self.head orelse return error.HeadSkipped;
+        if (rows == 0 or rows > greedy.max_rows or row_offset > self.sc.max_rows or
+            rows > self.sc.max_rows - row_offset or rows * @sizeOf(greedy.Pair) > self.sc.f32_in.len)
+            return error.BadHy4PassRows;
+        const streams = self.sc.streams_a.ptr + row_offset * 4 * self.t.hidden_size * 2;
+        const ref_rows = if (row_offset > 0 and rows == 1) row_offset + 1 else 0;
+        const logits = try forward.forwardHeadDeviceWithRef(&self.rt, &self.sc, self.t, hd, streams, rows, ref_rows);
+        if (anchor_out) |anc| try anc.captureHidden(self.rt.stream, self.sc.hidden.ptr, rows);
+        // The head consumed f32_in on this stream. It can now hold the compact result.
+        const buf = self.sc.f32_in.ptr;
+        const rank: usize = if (self.tp_sess) |sess| sess.rank_idx else 0;
+        try greedy.reduce(&self.rt.ops, self.rt.stream, logits, buf, rows, hd.vocab_pad, hd.vocab_local, rank * hd.vocab_pad);
+    }
+
+    fn readGreedy(self: *ResidentModel, ids: []u32) !void {
+        const hd = self.head orelse return error.HeadSkipped;
+        const buf = self.sc.f32_in.ptr;
+        if (self.tp_sess) |sess| {
+            return sess.gatherGreedyDevice(self.rt.d, self.rt.stream, buf, self.sc.f32_tmp.ptr, ids.len, hd.vocab_pad, hd.vocab_full, ids);
+        }
+        try self.rt.stream.synchronize();
+        var local: [greedy.max_rows]greedy.Pair = undefined;
+        try cuda.memory.download(self.rt.d, buf, std.mem.sliceAsBytes(local[0..ids.len]));
+        try greedy.gather(null, local[0..ids.len], hd.vocab_pad, hd.vocab_full, ids);
+    }
+
+    /// Prefills `prompt` in chunks of `chunk_opt` (`0` = plain single-pass prefill) and writes the last row's logits if `last_logits != null`.
+    pub fn prefill(self: *ResidentModel, pool: *kv_pool.KvPool, prompt: []const u32, chunk_opt: usize, last_logits: ?[]f32) !void {
+        const step_cap = try prefillStepCap(prompt.len, chunk_opt, self.sc.max_rows);
+        const time_pf = try @import("sys").environment.read(bool, "TF_HY4_PREFILL_TIMERS", false);
+        var pt: forward.PartTimers = .{};
+        var chunks: usize = 0;
+        const t0: u64 = if (time_pf) blk: {
+            self.rt.parts = &pt;
+            self.rt.parts_io = self.io;
+            break :blk nowNs(self.io);
+        } else 0;
+        defer if (time_pf) {
+            self.rt.parts = null;
+            self.rt.parts_io = null;
+        };
+        var pos: usize = 0;
+        while (pos < prompt.len) {
+            const cur: usize = @min(step_cap, prompt.len - pos);
+            const is_last = (pos + cur == prompt.len);
+            const anc: ?*drafter_mod.AnchorState = if (is_last and last_logits != null and self.anchor != null) &self.anchor.? else null;
+            try self.forwardStepAnchor(pool, pos, prompt[pos .. pos + cur], anc, cur - 1, if (anc != null) 1 else 0);
+            chunks += 1;
+            if (is_last) {
+                const th0: u64 = if (time_pf) nowNs(self.io) else 0;
+                if (last_logits) |dst| try self.computeLogitsAnchor(cur - 1, 1, dst, anc);
+                if (time_pf) {
+                    try self.rt.stream.synchronize();
+                    pt.head_ns += nowNs(self.io) -| th0;
+                }
+            }
+            pos += cur;
+        }
+        if (time_pf) {
+            const is_r0 = if (self.tp_sess) |tps| tps.rank_idx == 0 else true;
+            if (is_r0) {
+                const wall_s = @as(f64, @floatFromInt(nowNs(self.io) -| t0)) / 1e9;
+                const tok_s = if (wall_s > 0) @as(f64, @floatFromInt(prompt.len)) / wall_s else 0;
+                std.log.info("hy4 prefill-parts: T={d} chunks={d} chunk_rows={d} wall_s={d:.3} trunk_s={d:.3} experts_s={d:.3} attn_s={d:.3} index_s={d:.3} other_local_s={d:.3} tp_gather_s={d:.3} head_s={d:.3} tok_s={d:.2}", .{
+                    prompt.len, chunks, step_cap, wall_s,
+                    @as(f64, @floatFromInt(pt.trunk_ns)) / 1e9,
+                    @as(f64, @floatFromInt(pt.experts_ns)) / 1e9,
+                    @as(f64, @floatFromInt(pt.attn_ns)) / 1e9,
+                    @as(f64, @floatFromInt(pt.index_ns)) / 1e9,
+                    @as(f64, @floatFromInt(pt.other_local_ns)) / 1e9,
+                    @as(f64, @floatFromInt(pt.tp_gather_ns)) / 1e9,
+                    @as(f64, @floatFromInt(pt.head_ns)) / 1e9,
+                    tok_s,
+                });
+            }
+        }
+    }
+
+    pub fn decodeWindow(self: *ResidentModel, pool: *kv_pool.KvPool, first_pos: usize, tokens: []const u32, logits_out: []f32) !void {
+        const anc: ?*drafter_mod.AnchorState = if (self.anchor != null) &self.anchor.? else null;
+        try self.forwardStepAnchor(pool, first_pos, tokens, anc, 0, tokens.len);
+        try self.computeLogitsAnchor(0, tokens.len, logits_out, anc);
+    }
+
+    pub fn decodeWindowGreedy(self: *ResidentModel, pool: *kv_pool.KvPool, first_pos: usize, tokens: []const u32, ids_out: []u32) !void {
+        if (self.anchor == null) return self.forwardGreedy(pool, first_pos, tokens, ids_out);
+        const anc: ?*drafter_mod.AnchorState = &self.anchor.?;
+        try self.forwardStepAnchor(pool, first_pos, tokens, anc, 0, tokens.len);
+        try self.computeGreedyAnchor(0, ids_out, anc);
+    }
+};
+pub const CliOptions = struct {
+    max_layers: ?usize = null,
+    skip_head: bool = false,
+    chunk_size: usize = default_chunk_rows,
+    greedy_tokens: usize = 0,
+    bench_window_iters: usize = 0,
+    bench_widths: ?[]const usize = null,
+    bench_parts_iters: usize = 0,
+    cached_last_token: bool = false,
+    verify_rank_picks: bool = false,
+    kv_capacity: ?usize = null,
+    full_kv_pool: bool = false,
+    mem_floor_gib: usize = 8,
+    tp_sess: ?*boundary.TpSession = null,
+    drafter_idx: ?*const weights.ShardIndex = null,
+    drafter_synthetic: bool = false,
+    drafter_wrong: bool = false,
+    draft_depth: ?usize = null,
+    draft_min_margin: ?f32 = null,
+    auto_depth: bool = false,
+    explicit_costs: ?draft_policy.CostParams = null,
+    bench_drafter_iters: usize = 0,
+};
+
+pub fn runResidentToDump(
+    gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, stream: cuda.Stream,
+    idx: *const weights.ShardIndex, prompt: dump_oracle.PromptTokens, opts: CliOptions,
+    memFloorCheck: *const fn (usize) anyerror!void, memAvailFn: *const fn () usize, dump: *dump_oracle.Dump,
+) !void {
+    const t = idx.cfg.value.text_config;
+    if (prompt.batch != 1) return error.BadInputIds;
+    try dump_oracle.validateTokenIds(prompt.ids, t.vocab_size);
+    if (!opts.skip_head and opts.greedy_tokens > 0 and t.vocab_size == 0) return error.EmptyVocab;
+
+    const any_bench = opts.bench_window_iters > 0 or opts.bench_parts_iters > 0;
+    const spec_pad: usize = if (opts.drafter_idx != null or opts.drafter_synthetic or any_bench) max_decode_window else 0;
+    const need_cap = prompt.seq_len + opts.greedy_tokens + spec_pad;
+    const cap = opts.kv_capacity orelse need_cap;
+    if (cap < need_cap) return error.PastContext;
+
+    const max_step: usize = if (opts.chunk_size == 0) prompt.seq_len else @min(opts.chunk_size, prompt.seq_len);
+    var model = try ResidentModel.load(gpa, io, d, stream, idx, .{
+        .max_layers = opts.max_layers, .skip_head = opts.skip_head, .chunk_rows = max_step,
+        .logits_rows = if (any_bench) max_decode_window else 1,
+        .mem_floor_gib = opts.mem_floor_gib, .tp_sess = opts.tp_sess,
+        .drafter_idx = opts.drafter_idx, .drafter_synthetic = opts.drafter_synthetic, .drafter_wrong = opts.drafter_wrong,
+    }, memFloorCheck);
+    defer model.deinit();
+    if (opts.draft_min_margin) |mm| if (model.drafter) |*dr| { dr.min_margin_override = mm; };
+    var pick_rec: ?rank_picks.PickRecorder = if (opts.verify_rank_picks and opts.tp_sess != null)
+        try rank_picks.PickRecorder.init(gpa, model.layers.len) else null;
+    defer {
+        model.pick_recorder = null;
+        if (pick_rec) |*pr| pr.deinit();
+    }
+    if (opts.tp_sess) |tps| try tps.agreePostLoad("RESIDENT_LOADED", "Hy4 resident weight load");
+
+    try memFloorCheck(opts.mem_floor_gib);
+    var pool = if (opts.full_kv_pool)
+        try kv_pool.KvPool.init(gpa, d, t, cap)
+    else
+        try kv_pool.KvPool.initSlice(gpa, d, t, 0, model.layers.len, cap);
+    defer pool.deinit();
+    try memFloorCheck(opts.mem_floor_gib);
+
+    if (opts.bench_drafter_iters > 0) {
+        try benchDrafterVsVerify(gpa, &model, &pool, prompt.ids, opts.bench_drafter_iters);
+    }
+
+    if (pick_rec) |*pr| model.pick_recorder = pr;
+    try dump.recordInputIds(prompt.ids, 1, prompt.seq_len);
+
+    if (opts.skip_head) {
+        try pool.zeroFill(stream.handle);
+        const pf_t0 = nowNs(io);
+        if (opts.cached_last_token and prompt.seq_len >= 2) {
+            try model.prefill(&pool, prompt.ids[0 .. prompt.seq_len - 1], opts.chunk_size, null);
+            try model.forwardStep(&pool, prompt.seq_len - 1, prompt.ids[prompt.seq_len - 1 .. prompt.seq_len]);
+            if (opts.tp_sess) |tps| try tps.boundary.finish(stream) else try stream.synchronize();
+            const last_row = try gpa.alloc(u8, 4 * t.hidden_size * 2);
+            defer gpa.free(last_row);
+            try cuda.memory.download(d, model.sc.streams_a.ptr, last_row);
+            if (model.layers.len > 0) try dump.recordStreams(model.layers.len - 1, true, last_row, 1, 1, 4, t.hidden_size);
+        } else {
+            try model.prefill(&pool, prompt.ids, opts.chunk_size, null);
+            if (opts.tp_sess) |tps| try tps.boundary.finish(stream) else try stream.synchronize();
+            const last_off = if (opts.chunk_size == 0) prompt.seq_len - 1 else (prompt.seq_len - 1) % opts.chunk_size;
+            const last_row = try gpa.alloc(u8, 4 * t.hidden_size * 2);
+            defer gpa.free(last_row);
+            try cuda.memory.download(d, model.sc.streams_a.ptr + last_off * 4 * t.hidden_size * 2, last_row);
+            if (model.layers.len > 0) try dump.recordStreams(model.layers.len - 1, true, last_row, 1, 1, 4, t.hidden_size);
+        }
+        if (pick_rec) |*pr| {
+            model.pick_recorder = null;
+            try pr.verifyAcrossRanks(&opts.tp_sess.?.bootstrap);
+        }
+        const pf_ms = @as(f64, @floatFromInt(nowNs(io) -| pf_t0)) / 1e6;
+        std.debug.print("hy4 resident slice: T={d} chunk={d} layers={d} load={d:.2}s prefill={d:.2}ms kv_pool={d:.3}GiB scratch={d:.3}GiB MemAvailable={d:.2}GiB\n", .{
+            prompt.seq_len, opts.chunk_size, model.layers.len, @as(f64, @floatFromInt(model.load_ns)) / 1e9, pf_ms,
+            @as(f64, @floatFromInt(pool.totalBytes())) / (1 << 30), @as(f64, @floatFromInt(model.sc.totalBytes())) / (1 << 30),
+            @as(f64, @floatFromInt(memAvailFn())) / (1 << 30),
+        });
+        return;
+    }
+
+    var res = try runGreedyGenerationWithOpts(gpa, &model, &pool, prompt.ids, opts.chunk_size, opts.cached_last_token, opts.greedy_tokens, opts.draft_depth, opts.auto_depth, opts.explicit_costs);
+    defer res.deinit(gpa);
+    if (pick_rec) |*pr| {
+        model.pick_recorder = null;
+        try pr.verifyAcrossRanks(&opts.tp_sess.?.bootstrap);
+    }
+    try memFloorCheck(opts.mem_floor_gib);
+
+    try dump.recordLogits(std.mem.sliceAsBytes(res.last_logits), 1, 1, t.vocab_size);
+    const first_tok = try argmaxF32(res.last_logits);
+    if (opts.bench_window_iters > 0) {
+        try window_bench.benchDecodeWindowWidths(gpa, &model, &pool, prompt.seq_len, first_tok, opts.bench_window_iters, opts.bench_widths);
+        try memFloorCheck(opts.mem_floor_gib);
+    }
+    if (opts.bench_parts_iters > 0) {
+        const pw = if (opts.bench_window_iters == 0) opts.bench_widths else null;
+        try window_bench.benchDecodeParts(gpa, &model, &pool, prompt.seq_len, first_tok, opts.bench_parts_iters, pw);
+        try memFloorCheck(opts.mem_floor_gib);
+    }
+    try dump.recordTokenIdsNamed("first_token.input_ids", &.{first_tok}, 1, 1);
+    if (res.generated.len > 0) {
+        try dump.recordTokenIdsNamed("greedy.input_ids", res.generated, 1, res.generated.len);
+    }
+
+    const pf_ms = @as(f64, @floatFromInt(res.prefill_ns)) / 1e6;
+    const dec_steps = if (res.generated.len > 1) res.generated.len - 1 else 0;
+    const dec_ms_tok = if (dec_steps > 0) (@as(f64, @floatFromInt(res.decode_ns)) / 1e6) / @as(f64, @floatFromInt(dec_steps)) else 0;
+    if (model.drafter != null) {
+        std.debug.print(
+            "hy4 resident run: T={d} chunk={d} greedy={d} first_tok={d} load={d:.2}s+{d:.2}s(dfly={d:.3}GiB) prefill={d:.2}ms decode={d:.2}ms/tok draft_calls={d} offered={d} cut={d} accepted={d} verify_steps={d} kv_pool={d:.3}GiB scratch={d:.3}GiB MemAvailable={d:.2}GiB\n",
+            .{
+                prompt.seq_len, opts.chunk_size, opts.greedy_tokens, first_tok,
+                @as(f64, @floatFromInt(model.load_ns)) / 1e9, @as(f64, @floatFromInt(model.draft_load_ns)) / 1e9,
+                @as(f64, @floatFromInt(model.draft_weight_bytes)) / (1 << 30), pf_ms, dec_ms_tok,
+                res.draft_calls, res.offered_tokens, res.cut_tokens, res.accepted_tokens, res.verify_steps,
+                @as(f64, @floatFromInt(pool.totalBytes())) / (1 << 30), @as(f64, @floatFromInt(model.sc.totalBytes())) / (1 << 30),
+                @as(f64, @floatFromInt(memAvailFn())) / (1 << 30),
+            },
+        );
+    } else {
+        std.debug.print("hy4 resident run: T={d} chunk={d} cached_last={} greedy={d} first_tok={d} load={d:.2}s prefill={d:.2}ms decode={d:.2}ms/tok kv_pool={d:.3}GiB scratch={d:.3}GiB MemAvailable={d:.2}GiB\n", .{
+            prompt.seq_len, opts.chunk_size, opts.cached_last_token, opts.greedy_tokens, first_tok,
+            @as(f64, @floatFromInt(model.load_ns)) / 1e9, pf_ms, dec_ms_tok,
+            @as(f64, @floatFromInt(pool.totalBytes())) / (1 << 30), @as(f64, @floatFromInt(model.sc.totalBytes())) / (1 << 30),
+            @as(f64, @floatFromInt(memAvailFn())) / (1 << 30),
+        });
+    }
+}
+
+test "argmaxF32, syntheticPrompt, and prefillStepCap enforce tie-breaking and chunk clamping" {
+    try std.testing.expectEqual(@as(u32, 1), try argmaxF32(&.{ 0.5, 2.0, 2.0, -1.0 }));
+    try std.testing.expectError(error.NonFiniteLogits, argmaxF32(&.{ 1.0, std.math.nan(f32) }));
+
+    const p1 = try syntheticPrompt(std.testing.allocator, 101, 256, 42);
+    defer p1.deinit(std.testing.allocator);
+    const p2 = try syntheticPrompt(std.testing.allocator, 101, 256, 42);
+    defer p2.deinit(std.testing.allocator);
+    try std.testing.expectEqualSlices(u32, p1.ids, p2.ids);
+    try dump_oracle.validateTokenIds(p1.ids, 101);
+
+    try std.testing.expectEqual(@as(usize, 16), try prefillStepCap(16, 1024, 16));
+    try std.testing.expectEqual(@as(usize, 5), try prefillStepCap(5, 1024, 16));
+    try std.testing.expectEqual(@as(usize, 16), try prefillStepCap(16, 0, 16));
+    try std.testing.expectError(error.BadHy4PassRows, prefillStepCap(64, 1024, 16));
+}
diff --git a/zig/src/families/hy4/self_test.zig b/zig/src/families/hy4/self_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..60487c25342eaa7f0e73887bdb9092ac79ae6ce0
--- /dev/null
+++ b/zig/src/families/hy4/self_test.zig
@@ -0,0 +1,177 @@
+//! Weight-free GB10 GPU self-test for Full Hy4 (`tf-hy4-oracle --self-test`).
+//! Verifies BF16->FP32 widening, odd-vocab FP32 `lm_head`, padded BF16 GEMMs, narrow SwiGLU,
+//! 4-stream embeddings, FP32 router precision, and TP=4 `matchColumnPlan` + `lastHeadPlan` exactness.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const config = @import("config.zig");
+const forward = @import("forward.zig");
+
+pub fn run(gpa: std.mem.Allocator, device: i32, memAvailBytes: *const fn () usize) !void {
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, device);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var rt = try forward.Runtime.init(gpa, &driver, stream);
+    defer rt.deinit();
+    try checkGreedy(&rt);
+
+    const tiny_cfg: config.Text = .{
+        .hidden_size = 32, .intermediate_size = 64, .moe_intermediate_size = 16,
+        .num_hidden_layers = 1, .vocab_size = 101, .q_lora_rank = 12, .kv_lora_rank = 8,
+        .num_attention_heads = 4, .qk_nope_head_dim = 10, .qk_rope_head_dim = 6, .v_head_dim = 16,
+        .index_n_heads = 4, .index_head_dim = 16, .index_topk = 16, .indexer_types = &.{.full},
+        .n_routed_experts = 256, .num_experts_per_tok = 8,
+    };
+    var sc = try forward.Scratch.init(&driver, tiny_cfg, 4, 16);
+    defer sc.deinit();
+
+    // 1. Exact BF16 -> FP32 widening + odd-vocab (V=101, H=32) FP32 lm_head GEMM.
+    var x_u16: [4 * 32]u16 = undefined;
+    for (&x_u16, 0..) |*v, k| v.* = core.quant.convert.bf16(@as(f32, @floatFromInt(@as(i32, @intCast(k % 17)) - 8)) * 0.25);
+    var x_dev = try cuda.DeviceBuffer.fromHost(&driver, std.mem.sliceAsBytes(&x_u16));
+    defer x_dev.free();
+    const x_f32_ptr = try rt.widenBf16ToF32(&sc, x_dev.ptr, 4, 32);
+    var w_lm: [101 * 32]f32 = undefined;
+    for (&w_lm, 0..) |*v, k| v.* = @as(f32, @floatFromInt(@as(i32, @intCast(k % 13)) - 6)) * 0.1;
+    var w_lm_dev = try cuda.DeviceBuffer.fromHost(&driver, std.mem.sliceAsBytes(&w_lm));
+    defer w_lm_dev.free();
+    try rt.runLinearF32(x_f32_ptr, w_lm_dev.ptr, sc.logits_f32.ptr, 4, 101, 32);
+    try stream.synchronize();
+    var got_logits: [4 * 101]f32 = undefined;
+    try cuda.memory.download(&driver, sc.logits_f32.ptr, std.mem.sliceAsBytes(&got_logits));
+    for (0..4) |r| for (0..101) |n| {
+        var ref_sum: f64 = 0;
+        for (0..32) |c| ref_sum += @as(f64, core.quant.convert.load(.bf16, std.mem.asBytes(&x_u16[r * 32 + c]), 0)) * @as(f64, w_lm[n * 32 + c]);
+        if (@abs(@as(f64, got_logits[r * 101 + n]) - ref_sum) > 1e-4) return error.SelfTestLmHeadMismatch;
+    };
+
+    // 2. Padded BF16 Linear + narrow SwiGLU + 4-stream embed + vocab range guard.
+    var w_pad_host: [64 * 64]u16 = @splat(0);
+    for (0..14) |n| for (0..32) |c| {
+        w_pad_host[n * 64 + c] = core.quant.convert.bf16(if (n == c) 1.0 else 0.0);
+    };
+    var w_pad_dev = try cuda.DeviceBuffer.fromHost(&driver, std.mem.sliceAsBytes(&w_pad_host));
+    defer w_pad_dev.free();
+    try rt.runLinearBf16(&sc, x_dev.ptr, .{ .ptr = w_pad_dev.ptr, .n = 14, .k = 32, .n_pad = 64, .k_pad = 64, .padded = true }, sc.kv.ptr, 4);
+    try rt.runSwigluBf16(&sc, x_dev.ptr, x_dev.ptr, sc.ff_inner.ptr, 4, 16);
+    if (forward.embedTokens(&rt, &sc, x_dev.ptr, &.{ 0, 101 }, 101, 32)) |_| return error.SelfTestMissedBadToken else |err| {
+        if (err != error.TokenOutOfRange) return err;
+    }
+    try forward.embedTokens(&rt, &sc, x_dev.ptr, &.{ 0, 2, 1, 3 }, 101, 32);
+    try stream.synchronize();
+    var emb_out: [4 * 4 * 32]u16 = undefined;
+    try cuda.memory.download(&driver, sc.streams_a.ptr, std.mem.sliceAsBytes(&emb_out));
+    for (0..4) |st_i| {
+        if (!std.mem.eql(u16, emb_out[(1 * 4 + st_i) * 32 ..][0..32], x_u16[2 * 32 ..][0..32])) return error.SelfTestEmbedMismatch;
+    }
+
+    // 3. FP32 router [256, 128] preserves 1.0001 (+1e-5 bias) vs 1.0002 -> picks expert 8.
+    var unit_x: [128]u16 = @splat(0);
+    unit_x[0] = core.quant.convert.bf16(1.0);
+    var unit_dev = try cuda.DeviceBuffer.fromHost(&driver, std.mem.sliceAsBytes(&unit_x));
+    defer unit_dev.free();
+    const r_host = try gpa.alloc(f32, 256 * 128);
+    defer gpa.free(r_host);
+    @memset(r_host, 0);
+    for (0..7) |ex| r_host[ex * 128] = 2.0;
+    r_host[7 * 128] = 1.0001;
+    r_host[8 * 128] = 1.0002;
+    var r_dev = try cuda.DeviceBuffer.fromHost(&driver, std.mem.sliceAsBytes(r_host));
+    defer r_dev.free();
+    var bias_host: [256]f32 = @splat(0);
+    bias_host[7] = 0.00001;
+    var bias_dev = try cuda.DeviceBuffer.fromHost(&driver, std.mem.sliceAsBytes(&bias_host));
+    defer bias_dev.free();
+    try forward.routeF32LogitsAndTopk(&rt, &sc, unit_dev.ptr, r_dev.ptr, bias_dev.ptr, 1, 128, 256, 8, true, 2.827);
+    try stream.synchronize();
+    var got_ids: [8]i32 = undefined;
+    try cuda.memory.download(&driver, sc.router_ids.ptr, std.mem.sliceAsBytes(&got_ids));
+    var has_8 = false;
+    var has_7 = false;
+    for (got_ids) |id| {
+        if (id == 8) has_8 = true;
+        if (id == 7) has_7 = true;
+    }
+    if (!has_8 or has_7) return error.SelfTestFp32RouterFlip;
+
+    // 4. TP=4 matchColumnPlan bit-exact stripe check (BF16 256 vs 4x64, and FP32 lastHeadPlan).
+    const m_rows = 4;
+    const n_full = 256;
+    const n_loc = 64;
+    const k_dim = 128;
+    const x_col = try gpa.alloc(u16, m_rows * k_dim);
+    defer gpa.free(x_col);
+    const w_col = try gpa.alloc(u16, n_full * k_dim);
+    defer gpa.free(w_col);
+    for (x_col, 0..) |*v, idx_i| v.* = core.quant.convert.bf16(@as(f32, @floatFromInt(@as(i32, @intCast(idx_i % 23)) - 11)) * 0.125);
+    for (w_col, 0..) |*v, idx_i| v.* = core.quant.convert.bf16(@as(f32, @floatFromInt(@as(i32, @intCast(idx_i % 19)) - 9)) * 0.0625);
+    var x_col_dev = try cuda.DeviceBuffer.fromHost(&driver, std.mem.sliceAsBytes(x_col));
+    defer x_col_dev.free();
+    var w_col_dev = try cuda.DeviceBuffer.fromHost(&driver, std.mem.sliceAsBytes(w_col));
+    defer w_col_dev.free();
+    var y_full_dev = try cuda.DeviceBuffer.alloc(&driver, m_rows * n_full * 2);
+    defer y_full_dev.free();
+    var y_loc_dev = try cuda.DeviceBuffer.alloc(&driver, m_rows * n_loc * 2);
+    defer y_loc_dev.free();
+    try rt.runLinearBf16(&sc, x_col_dev.ptr, .{ .ptr = w_col_dev.ptr, .n = n_full, .k = k_dim, .n_pad = n_full, .k_pad = k_dim, .padded = false }, y_full_dev.ptr, m_rows);
+    const full_words = try gpa.alloc(u16, m_rows * n_full);
+    defer gpa.free(full_words);
+    const loc_words = try gpa.alloc(u16, m_rows * n_loc);
+    defer gpa.free(loc_words);
+    try stream.synchronize();
+    try cuda.memory.download(&driver, y_full_dev.ptr, std.mem.sliceAsBytes(full_words));
+    for (0..4) |rk| {
+        try rt.runLinearBf16(&sc, x_col_dev.ptr, .{ .ptr = w_col_dev.ptr + rk * n_loc * k_dim * 2, .n = n_loc, .n_full = n_full, .k = k_dim, .n_pad = n_loc, .k_pad = k_dim, .padded = false }, y_loc_dev.ptr, m_rows);
+        try stream.synchronize();
+        try cuda.memory.download(&driver, y_loc_dev.ptr, std.mem.sliceAsBytes(loc_words));
+        for (0..m_rows) |rr| {
+            if (!std.mem.eql(u16, full_words[rr * n_full + rk * n_loc ..][0..n_loc], loc_words[rr * n_loc ..][0..n_loc]))
+                return error.SelfTestColumnPlanMismatch;
+        }
+    }
+
+    std.debug.print("hy4 gpu self-test PASS (sm_{d}, MemAvailable {d:.2} GiB)\n", .{
+        try ctx.capability(), @as(f64, @floatFromInt(memAvailBytes())) / (1 << 30),
+    });
+}
+
+// Six rows cover a multi-warp tie, masked poison, a narrow FP32 margin, and all nonfinite classes.
+fn checkGreedy(rt: *forward.Runtime) !void {
+    const greedy = @import("greedy.zig");
+    const stride = 320;
+    const valid = 315;
+    const base = 640;
+    var rows: [6][stride]f32 = @splat(@splat(-5));
+    for (&rows) |*row| @memset(row[valid..], std.math.nan(f32));
+    rows[0][257] = 0.0;
+    rows[0][128] = -0.0;
+    rows[1][0] = 1.0001;
+    rows[1][valid - 1] = 1.0002;
+    rows[2][valid - 1] = std.math.nan(f32);
+    rows[3][257] = std.math.inf(f32);
+    rows[4][31] = -std.math.inf(f32);
+    rows[5][0] = -std.math.floatMax(f32);
+    var input = try cuda.DeviceBuffer.fromHost(rt.d, std.mem.asBytes(&rows));
+    defer input.free();
+    var out = try cuda.DeviceBuffer.alloc(rt.d, rows.len * @sizeOf(greedy.Pair));
+    defer out.free();
+    var picks: [rows.len]greedy.Pair = undefined;
+    try greedy.reduce(&rt.ops, rt.stream, input.ptr, out.ptr, rows.len, stride, valid, base);
+    try rt.stream.synchronize();
+    try cuda.memory.download(rt.d, out.ptr, std.mem.asBytes(&picks));
+    const argmax = @import("resident.zig").argmaxF32;
+    for (rows, picks) |row, p| {
+        if (argmax(row[0..valid])) |id| {
+            if (p.id != base + id or @as(u32, @bitCast(p.value)) != @as(u32, @bitCast(row[id]))) return error.SelfTestGreedyMismatch;
+        } else |err| {
+            if (err != error.NonFiniteLogits or !std.math.isNan(p.value) or p.id != std.math.maxInt(u32)) return error.SelfTestGreedyMismatch;
+        }
+    }
+    try greedy.reduce(&rt.ops, rt.stream, input.ptr, out.ptr, 1, stride, 0, base);
+    try rt.stream.synchronize();
+    try cuda.memory.download(rt.d, out.ptr, std.mem.asBytes(&picks[0]));
+    if (picks[0].value != -std.math.inf(f32) or picks[0].id != std.math.maxInt(u32)) return error.SelfTestGreedyMismatch;
+}
diff --git a/zig/src/families/hy4/speculative.zig b/zig/src/families/hy4/speculative.zig
new file mode 100644
index 0000000000000000000000000000000000000000..97d3efd9427ebfbe9d21c35ceee031887b0bd17f
--- /dev/null
+++ b/zig/src/families/hy4/speculative.zig
@@ -0,0 +1,424 @@
+//! Speculative greedy decode driver, synthetic DFly2 fixture builder, measured-cost adaptive depth loop,
+//! and interleaved drafter-vs-verify timing harness for Full Hy4 (`hy_v4_vl` / `hy_v4`) on TP=1 and TP=4.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const config = @import("config.zig");
+const ranks = @import("ranks.zig");
+const weights = @import("weights.zig");
+const kv_pool = @import("kv_pool.zig");
+const drafter_mod = @import("drafter.zig");
+const draft_policy = @import("draft_policy.zig");
+const window_bench = @import("window_bench.zig");
+const resident = @import("resident.zig");
+
+const Uploader = cuda.exl3_upload.Uploader;
+
+fn nowNs(io: std.Io) u64 {
+    return @intCast(@max(@as(i128, 0), std.Io.Clock.awake.now(io).toNanoseconds()));
+}
+
+fn synthNorm(gpa: std.mem.Allocator, up: *Uploader, width: usize) !weights.RmsNormWeight {
+    const bf16_h = try gpa.alloc(u16, width);
+    defer gpa.free(bf16_h);
+    @memset(bf16_h, 0x3f80);
+    const bf16_ptr = try up.dev(std.mem.sliceAsBytes(bf16_h));
+    if (width % 64 == 0) return .{ .bf16_ptr = bf16_ptr, .f32_ptr = 0, .width = width };
+    const f32_h = try gpa.alloc(f32, width);
+    defer gpa.free(f32_h);
+    @memset(f32_h, 1.0);
+    return .{ .bf16_ptr = bf16_ptr, .f32_ptr = try up.dev(std.mem.sliceAsBytes(f32_h)), .width = width };
+}
+
+fn synthLinear(gpa: std.mem.Allocator, up: *Uploader, rnd: std.Random, full_n: usize, full_k: usize, n_off: usize, n_loc: usize, k_off: usize, k_loc: usize) !draft_policy.DraftLinear {
+    const full = try gpa.alloc(u16, full_n * full_k);
+    defer gpa.free(full);
+    for (0..full_n) |r| for (0..full_k) |c| {
+        const v = @as(f32, @floatFromInt(rnd.intRangeAtMost(i16, -64, 64))) / 1024.0;
+        full[r * full_k + c] = core.quant.convert.bf16(v);
+    };
+    const n_pad = std.mem.alignForward(usize, n_loc, 64);
+    const k_pad = std.mem.alignForward(usize, k_loc, 64);
+    const buf = try gpa.alloc(u16, n_pad * k_pad);
+    defer gpa.free(buf);
+    @memset(buf, 0);
+    for (0..n_loc) |r| for (0..k_loc) |c| {
+        buf[r * k_pad + c] = full[(n_off + r) * full_k + (k_off + c)];
+    };
+    return .{ .bf16 = .{
+        .ptr = try up.dev(std.mem.sliceAsBytes(buf)),
+        .n = n_loc, .n_full = full_n, .k = k_loc, .n_pad = n_pad, .k_pad = k_pad,
+        .padded = (n_pad != n_loc or k_pad != k_loc),
+    } };
+}
+
+pub fn initSyntheticDrafter(gpa: std.mem.Allocator, d: *const cuda.Driver, t: config.Text, up: *Uploader, seed: u64) !drafter_mod.Drafter {
+    return initSyntheticDrafterWithRank(gpa, d, t, up, null, seed);
+}
+
+pub fn initSyntheticDrafterWithRank(gpa: std.mem.Allocator, d: *const cuda.Driver, t: config.Text, up: *Uploader, rank: ?ranks.Rank, seed: u64) !drafter_mod.Drafter {
+    var prng = std.Random.DefaultPrng.init(seed);
+    const rnd = prng.random();
+    const ls = try ranks.LocalShape.forText(t, rank);
+    const slot: usize = if (rank != null) ls.heads_first / ls.heads else 0;
+    const h: usize = t.hidden_size;
+    const d_ffn: usize = t.intermediate_size;
+    const d_ffn_loc: usize = ls.dense;
+    const d_ffn_off: usize = ls.dense_first;
+    const h_corr_loc: usize = if (rank != null) h / cuda.hy4_tp.world else h;
+    const h_corr_off: usize = slot * h_corr_loc;
+    const n_blocks: usize = 2;
+    const blocks = try gpa.alloc(drafter_mod.DraftBlockWeights, n_blocks);
+    errdefer gpa.free(blocks);
+
+    const kv_norm = try synthNorm(gpa, up, t.kv_lora_rank);
+    const sinks_h = try gpa.alloc(f32, ls.heads);
+    defer gpa.free(sinks_h);
+    @memset(sinks_h, 0.0);
+    const sinks_ptr = try up.dev(std.mem.sliceAsBytes(sinks_h));
+
+    for (blocks, 0..) |*blk, i| {
+        const kv_b_full = try gpa.alloc(u16, t.kvBRows() * t.kv_lora_rank);
+        defer gpa.free(kv_b_full);
+        for (kv_b_full) |*dst| dst.* = core.quant.convert.bf16(@as(f32, @floatFromInt(rnd.intRangeAtMost(i16, -64, 64))) / 1024.0);
+        const kvb_loc = ls.kvBRows(t) * t.kv_lora_rank;
+        const kvb_off = slot * kvb_loc;
+        const kv_b_ptr = try up.dev(std.mem.sliceAsBytes(kv_b_full[kvb_off .. kvb_off + kvb_loc]));
+
+        const last_l: u32 = t.num_hidden_layers - 1;
+        var ix_l: u32 = if (i == 0) 0 else last_l;
+        while (ix_l > 0 and t.indexer_types[ix_l] != .full) : (ix_l -= 1) {}
+        const q_loc = ls.queryRows(t);
+        const v_loc = ls.valueRows(t);
+        blk.* = .{
+            .target_kv = if (i == 0) 0 else last_l,
+            .target_index = ix_l,
+            .input_norm = try synthNorm(gpa, up, h),
+            .q_a = try synthLinear(gpa, up, rnd, t.q_lora_rank, h, 0, t.q_lora_rank, 0, h),
+            .q_a_norm = try synthNorm(gpa, up, t.q_lora_rank),
+            .q_b = try synthLinear(gpa, up, rnd, t.queryRows(), t.q_lora_rank, slot * q_loc, q_loc, 0, t.q_lora_rank),
+            .kv_a = try synthLinear(gpa, up, rnd, t.kvARows(), h, 0, t.kvARows(), 0, h),
+            .kv_a_norm_bf16 = kv_norm.bf16_ptr,
+            .kv_b = kv_b_ptr,
+            .linear_gate = try synthLinear(gpa, up, rnd, t.valueRows(), h, slot * v_loc, v_loc, 0, h),
+            .o_proj = try synthLinear(gpa, up, rnd, h, t.valueRows(), 0, h, slot * v_loc, v_loc),
+            .sinks = sinks_ptr,
+            .post_attn_norm = try synthNorm(gpa, up, h),
+            .mlp = .{
+                .gate = try synthLinear(gpa, up, rnd, d_ffn, h, d_ffn_off, d_ffn_loc, 0, h),
+                .up = try synthLinear(gpa, up, rnd, d_ffn, h, d_ffn_off, d_ffn_loc, 0, h),
+                .down = try synthLinear(gpa, up, rnd, h, d_ffn, 0, h, d_ffn_off, d_ffn_loc),
+            },
+        };
+    }
+    const gate_f32 = try gpa.alloc(f32, h);
+    defer gpa.free(gate_f32);
+    @memset(gate_f32, 0.5);
+    var dw: drafter_mod.DraftWeights = .{
+        .blocks = blocks, .block_size = 5, .mask_token_id = t.vocab_size - 1, .enable_hidden_correction = true,
+        .enorm = try synthNorm(gpa, up, h), .hnorm = try synthNorm(gpa, up, h),
+        .eh_proj = try synthLinear(gpa, up, rnd, h, 2 * h, 0, h, 0, 2 * h),
+        .fusion_gate_f32 = try up.dev(std.mem.sliceAsBytes(gate_f32)),
+        .final_norm = try synthNorm(gpa, up, h),
+        .corr_hidden_norm = try synthNorm(gpa, up, h), .corr_embed_norm = try synthNorm(gpa, up, h),
+        .corr_mlp = .{
+            .gate = try synthLinear(gpa, up, rnd, h, 2 * h, h_corr_off, h_corr_loc, 0, 2 * h),
+            .up = try synthLinear(gpa, up, rnd, h, 2 * h, h_corr_off, h_corr_loc, 0, 2 * h),
+            .down = try synthLinear(gpa, up, rnd, h, h, 0, h, h_corr_off, h_corr_loc),
+        },
+    };
+    errdefer dw.deinitHost(gpa);
+    const sc = try drafter_mod.DraftScratch.init(gpa, d, t, dw.block_size);
+    return .{ .gpa = gpa, .weights = dw, .sc = sc };
+}
+
+pub const GreedyResult = struct {
+    last_logits: []f32,
+    generated: []u32,
+    prefill_ns: u64,
+    decode_ns: u64,
+    draft_calls: usize = 0,
+    offered_tokens: usize = 0,
+    cut_tokens: usize = 0,
+    accepted_tokens: usize = 0,
+    verify_steps: usize = 0,
+
+    pub fn deinit(self: *GreedyResult, gpa: std.mem.Allocator) void {
+        gpa.free(self.last_logits);
+        gpa.free(self.generated);
+        self.* = undefined;
+    }
+};
+
+pub fn runGreedyGeneration(
+    gpa: std.mem.Allocator, model: *resident.ResidentModel, pool: *kv_pool.KvPool,
+    prompt: []const u32, chunk_size: usize, cached_last_token: bool, new_tokens: usize,
+) !GreedyResult {
+    return runGreedyGenerationWithOpts(gpa, model, pool, prompt, chunk_size, cached_last_token, new_tokens, null, false, null);
+}
+
+pub fn runGreedyGenerationWithDepth(
+    gpa: std.mem.Allocator, model: *resident.ResidentModel, pool: *kv_pool.KvPool,
+    prompt: []const u32, chunk_size: usize, cached_last_token: bool, new_tokens: usize,
+    draft_depth_override: ?usize,
+) !GreedyResult {
+    return runGreedyGenerationWithOpts(gpa, model, pool, prompt, chunk_size, cached_last_token, new_tokens, draft_depth_override, false, null);
+}
+
+pub fn runGreedyGenerationWithOpts(
+    gpa: std.mem.Allocator, model: *resident.ResidentModel, pool: *kv_pool.KvPool,
+    prompt: []const u32, chunk_size: usize, cached_last_token: bool, new_tokens: usize,
+    draft_depth_override: ?usize, auto_depth: bool, explicit_costs: ?draft_policy.CostParams,
+) !GreedyResult {
+    if (prompt.len == 0) return error.EmptyPrompt;
+    const max_spec: usize = if (model.drafter) |*dr| dr.maxProposals() else 0;
+    if (prompt.len + new_tokens + max_spec > pool.capacity) return error.PastContext;
+
+    try pool.zeroFill(model.rt.stream.handle);
+    const last_logits = try gpa.alloc(f32, model.t.vocab_size);
+    errdefer gpa.free(last_logits);
+    const generated = try gpa.alloc(u32, new_tokens);
+    errdefer gpa.free(generated);
+
+    const pf_t0 = nowNs(model.io);
+    if (cached_last_token and prompt.len >= 2) {
+        try model.prefill(pool, prompt[0 .. prompt.len - 1], chunk_size, null);
+        try model.decodeWindow(pool, prompt.len - 1, prompt[prompt.len - 1 .. prompt.len], last_logits);
+    } else {
+        try model.prefill(pool, prompt, chunk_size, last_logits);
+    }
+    try model.rt.stream.synchronize();
+    const prefill_ns: u64 = nowNs(model.io) -| pf_t0;
+
+    if (new_tokens == 0) return .{ .last_logits = last_logits, .generated = generated, .prefill_ns = prefill_ns, .decode_ns = 0 };
+
+    generated[0] = try resident.argmaxF32(last_logits);
+    if (model.drafter == null) {
+        const dec_t0 = nowNs(model.io);
+        for (1..new_tokens) |step| {
+            const prev_tok = generated[step - 1];
+            try model.forwardStep(pool, prompt.len + step - 1, &.{prev_tok});
+            try model.computeGreedy(0, generated[step..][0..1]);
+        }
+        try model.rt.stream.synchronize();
+        const decode_ns: u64 = nowNs(model.io) -| dec_t0;
+        return .{ .last_logits = last_logits, .generated = generated, .prefill_ns = prefill_ns, .decode_ns = decode_ns, .verify_steps = new_tokens - 1 };
+    }
+
+    var costs: ?draft_policy.CostParams = explicit_costs;
+    if (costs == null and auto_depth and draft_depth_override == null and prompt.len + 7 <= pool.capacity) {
+        costs = try window_bench.calibrateCostParams(gpa, model, pool, prompt.len, generated[0]);
+    }
+    if (costs) |c| if (model.tp_sess == null or model.tp_sess.?.rank == .zero) {
+        const init_pick = c.chooseDepth(&draft_policy.default_rates, max_spec, true);
+        std.debug.print("hy4 auto-depth table: v1={d:.2} v2={d:.2} v3={d:.2} v4={d:.2} v7={d:.2}ms draft_round={d:.2}ms draft_each={d:.2}ms initial_depth={d} hash={x}\n", .{
+            c.verifyMs(1), c.verifyMs(2), c.verifyMs(3), c.verifyMs(4), c.verifyMs(7),
+            c.draft_round_ms, c.draft_each_ms, init_pick.depth, draft_policy.DepthTracker.decisionHash(null, @intCast(init_pick.depth)),
+        });
+    };
+
+    const dr = &model.drafter.?;
+    const anc = &model.anchor.?;
+    const hd = model.head orelse return error.HeadSkipped;
+    const max_depth: usize = @min(@as(usize, dr.maxProposals()), draft_depth_override orelse dr.maxProposals());
+
+    var tracker: draft_policy.DepthTracker = .{};
+    var emitted: usize = 1;
+    var cur_pos: usize = prompt.len;
+    var pending: u32 = generated[0];
+    var anchor_row: usize = 0;
+    var draft_calls: usize = 0;
+    var offered: usize = 0;
+    var cut: usize = 0;
+    var accepted: usize = 0;
+    var verify_steps: usize = 0;
+    var proposals: [drafter_mod.max_block_size]u32 = @splat(0);
+    var window: [drafter_mod.max_block_size]u32 = @splat(0);
+    var verified_ids: [drafter_mod.max_block_size]u32 = @splat(0);
+
+    const dec_t0 = nowNs(model.io);
+    while (emitted < new_tokens) {
+        const chosen_d: usize = if (costs) |c| tracker.nextDepth(c, max_depth) else max_depth;
+        const ask_depth = if (chosen_d > 0 and cur_pos + dr.weights.block_size <= pool.capacity) chosen_d else 0;
+        var d_cnt: usize = 0;
+        if (ask_depth > 0) {
+            d_cnt = draft_policy.resolveEffectiveDepth(ask_depth, try dr.proposeTp(
+                &model.rt, &model.sc, model.t, model.trunk.embed_bf16, hd, model.layers.len,
+                pool, anc, anchor_row, cur_pos, pending, ask_depth, model.tp_sess, true, null, null, proposals[0..ask_depth],
+            ));
+            draft_calls += 1;
+            offered += d_cnt;
+            cut += ask_depth - d_cnt;
+        }
+
+        const w_len = 1 + d_cnt;
+        window[0] = pending;
+        @memcpy(window[1..w_len], proposals[0..d_cnt]);
+        try model.decodeWindowGreedy(pool, cur_pos, window[0..w_len], verified_ids[0..w_len]);
+        verify_steps += 1;
+
+        var kept: usize = w_len;
+        var step_accepted: usize = 0;
+        var next_pending: u32 = 0;
+        for (0..d_cnt) |r| {
+            const target_tok = verified_ids[r];
+            if (target_tok == proposals[r]) {
+                accepted += 1;
+                step_accepted += 1;
+                if (emitted < new_tokens) {
+                    generated[emitted] = target_tok;
+                    emitted += 1;
+                }
+            } else {
+                if (emitted < new_tokens) {
+                    generated[emitted] = target_tok;
+                    emitted += 1;
+                }
+                kept = r + 1;
+                next_pending = target_tok;
+                break;
+            }
+        }
+        if (d_cnt > 0) tracker.observe(d_cnt, step_accepted);
+        if (kept == w_len) {
+            const bonus_tok = verified_ids[d_cnt];
+            if (emitted < new_tokens) {
+                generated[emitted] = bonus_tok;
+                emitted += 1;
+            }
+            next_pending = bonus_tok;
+        } else {
+            try pool.clearRange(model.t, cur_pos + kept, cur_pos + w_len, model.rt.stream.handle);
+        }
+        cur_pos += kept;
+        pending = next_pending;
+        anchor_row = kept - 1;
+    }
+    try model.rt.stream.synchronize();
+    const decode_ns: u64 = nowNs(model.io) -| dec_t0;
+    return .{
+        .last_logits = last_logits, .generated = generated, .prefill_ns = prefill_ns, .decode_ns = decode_ns,
+        .draft_calls = draft_calls, .offered_tokens = offered, .cut_tokens = cut, .accepted_tokens = accepted, .verify_steps = verify_steps,
+    };
+}
+
+pub fn medianMs(samples_ns: []u64) f64 {
+    if (samples_ns.len == 0) return 0;
+    std.mem.sort(u64, samples_ns, {}, std.sort.asc(u64));
+    return @as(f64, @floatFromInt(samples_ns[samples_ns.len / 2])) / 1e6;
+}
+
+pub fn meanMs(samples_ns: []const u64) f64 {
+    if (samples_ns.len == 0) return 0;
+    var sum: u128 = 0;
+    for (samples_ns) |x| sum += x;
+    return (@as(f64, @floatFromInt(sum)) / @as(f64, @floatFromInt(samples_ns.len))) / 1e6;
+}
+
+pub fn breakEvenAccepted(draft_ms: f64, verify_win_ms: f64, verify1_ms: f64) f64 {
+    if (verify1_ms <= 0) return 0;
+    return @max(0.0, (draft_ms + verify_win_ms) / verify1_ms - 1.0);
+}
+
+pub fn benchDrafterVsVerify(gpa: std.mem.Allocator, model: *resident.ResidentModel, pool: *kv_pool.KvPool, prompt: []const u32, iters: usize) !void {
+    const dr = &(model.drafter orelse return error.MissingDrafterWeights);
+    const anc = &(model.anchor orelse return error.MissingDrafterWeights);
+    const hd = model.head orelse return error.HeadSkipped;
+    if (iters == 0) return error.BadArgs;
+
+    const depth: usize = dr.maxProposals();
+    const d_short: usize = @min(@as(usize, 2), depth);
+    const w_verify: usize = 1 + depth;
+    const w_short: usize = 1 + d_short;
+    const v: usize = model.t.vocab_size;
+    try pool.zeroFill(model.rt.stream.handle);
+    const last_logits = try gpa.alloc(f32, v);
+    defer gpa.free(last_logits);
+    try model.prefill(pool, prompt, model.chunk_rows, last_logits);
+    const bonus = try resident.argmaxF32(last_logits);
+    const p = prompt.len;
+
+    var verified_ids: [drafter_mod.max_block_size]u32 = @splat(bonus);
+    var proposals: [drafter_mod.max_block_size]u32 = @splat(bonus);
+    var window: [drafter_mod.max_block_size]u32 = @splat(bonus);
+
+    for (0..2) |_| {
+        _ = try dr.proposeTp(&model.rt, &model.sc, model.t, model.trunk.embed_bf16, hd, model.layers.len, pool, anc, 0, p, bonus, depth, model.tp_sess, true, null, null, proposals[0..depth]);
+        window[0] = bonus;
+        @memcpy(window[1..w_verify], proposals[0..depth]);
+        try model.decodeWindowGreedy(pool, p, window[0..1], verified_ids[0..1]);
+        try pool.clearRange(model.t, p, p + 1, model.rt.stream.handle);
+        try model.decodeWindowGreedy(pool, p, window[0..w_verify], verified_ids[0..w_verify]);
+        try pool.clearRange(model.t, p, p + w_verify, model.rt.stream.handle);
+    }
+
+    try pool.zeroFill(model.rt.stream.handle);
+    try model.prefill(pool, prompt, model.chunk_rows, last_logits);
+    if (model.tp_sess) |tps| try tps.boundary.finish(model.rt.stream) else try model.rt.stream.synchronize();
+
+    const draft_ns = try gpa.alloc(u64, iters); defer gpa.free(draft_ns);
+    const draft2_ns = try gpa.alloc(u64, iters); defer gpa.free(draft2_ns);
+    const ver1_ns = try gpa.alloc(u64, iters); defer gpa.free(ver1_ns);
+    const ver3_ns = try gpa.alloc(u64, iters); defer gpa.free(ver3_ns);
+    const verw_ns = try gpa.alloc(u64, iters); defer gpa.free(verw_ns);
+
+    // Interleave all 5 measurements per iteration so shared farm bursts never skew one width against another.
+    for (0..iters) |it| {
+        const td6 = nowNs(model.io);
+        _ = try dr.proposeTp(&model.rt, &model.sc, model.t, model.trunk.embed_bf16, hd, model.layers.len, pool, anc, 0, p, bonus, depth, model.tp_sess, true, null, null, proposals[0..depth]);
+        if (model.tp_sess) |tps| try tps.boundary.finish(model.rt.stream) else try model.rt.stream.synchronize();
+        draft_ns[it] = nowNs(model.io) -| td6;
+
+        const td2 = nowNs(model.io);
+        _ = try dr.proposeTp(&model.rt, &model.sc, model.t, model.trunk.embed_bf16, hd, model.layers.len, pool, anc, 0, p, bonus, d_short, model.tp_sess, true, null, null, window[1 .. 1 + d_short]);
+        if (model.tp_sess) |tps| try tps.boundary.finish(model.rt.stream) else try model.rt.stream.synchronize();
+        draft2_ns[it] = nowNs(model.io) -| td2;
+
+        window[0] = bonus;
+        @memcpy(window[1..w_verify], proposals[0..depth]);
+
+        const tv1 = nowNs(model.io);
+        try model.decodeWindowGreedy(pool, p, window[0..1], verified_ids[0..1]);
+        if (model.tp_sess) |tps| try tps.boundary.finish(model.rt.stream) else try model.rt.stream.synchronize();
+        ver1_ns[it] = nowNs(model.io) -| tv1;
+        try pool.clearRange(model.t, p, p + 1, model.rt.stream.handle);
+
+        const tv3 = nowNs(model.io);
+        try model.decodeWindowGreedy(pool, p, window[0..w_short], verified_ids[0..w_short]);
+        if (model.tp_sess) |tps| try tps.boundary.finish(model.rt.stream) else try model.rt.stream.synchronize();
+        ver3_ns[it] = nowNs(model.io) -| tv3;
+        try pool.clearRange(model.t, p, p + w_short, model.rt.stream.handle);
+
+        const tvw = nowNs(model.io);
+        try model.decodeWindowGreedy(pool, p, window[0..w_verify], verified_ids[0..w_verify]);
+        if (model.tp_sess) |tps| try tps.boundary.finish(model.rt.stream) else try model.rt.stream.synchronize();
+        verw_ns[it] = nowNs(model.io) -| tvw;
+        try pool.clearRange(model.t, p, p + w_verify, model.rt.stream.handle);
+        try model.rt.stream.synchronize();
+    }
+
+    const d_med = medianMs(draft_ns);
+    const d2_med = medianMs(draft2_ns);
+    const v1_med = medianMs(ver1_ns);
+    const v3_med = medianMs(ver3_ns);
+    const vw_med = medianMs(verw_ns);
+    const e_acc = breakEvenAccepted(d_med, vw_med, v1_med);
+    const e_acc2 = breakEvenAccepted(d2_med, v3_med, v1_med);
+    if (model.tp_sess == null or model.tp_sess.?.rank == .zero) {
+        std.debug.print(
+            "hy4 drafter bench (tp={d} iters={d} layers={d} block={d} depth={d}): draft{d}_med={d:.2}ms draft{d}_med={d:.2}ms verify1_med={d:.2}ms verify{d}_med={d:.2}ms verify{d}_med={d:.2}ms breakeven_d{d}={d:.3}/{d} breakeven_d{d}={d:.3}/{d}\n",
+            .{
+                if (model.tp_sess != null) @as(usize, cuda.hy4_tp.world) else @as(usize, 1),
+                iters, model.layers.len, dr.weights.block_size, depth,
+                depth, d_med, d_short, d2_med, v1_med, w_short, v3_med, w_verify, vw_med,
+                depth, e_acc, depth, d_short, e_acc2, d_short,
+            },
+        );
+    }
+}
+
+test "medianMs and breakEvenAccepted compute expected break-even accepted draft count" {
+    var samples = [_]u64{ 50_000_000, 30_000_000, 40_000_000 };
+    try std.testing.expectApproxEqAbs(@as(f64, 40.0), medianMs(&samples), 1e-6);
+    try std.testing.expectApproxEqAbs(@as(f64, 0.5), breakEvenAccepted(40.0, 200.0, 160.0), 1e-6);
+}
diff --git a/zig/src/families/hy4/step_graph.zig b/zig/src/families/hy4/step_graph.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d843c702b528842e4e5fc410ec3fd9c568306c80
--- /dev/null
+++ b/zig/src/families/hy4/step_graph.zig
@@ -0,0 +1,80 @@
+//! An executable per verify width and body. Recapture position, KV addresses
+//! and geometry, then update that width's executable on the same ordered stream.
+const std = @import("std");
+const cuda = @import("cuda");
+const Resident = @import("resident.zig").ResidentModel;
+const Pool = @import("kv_pool.zig").KvPool;
+const dump = @import("dump_oracle.zig");
+
+const Slot = struct { warmed: bool = false, exec: ?cuda.graph.Exec = null };
+
+pub const Steps = struct {
+    slots: [2][3]Slot = @splat(@splat(.{})),
+
+    pub fn deinit(self: *Steps) void {
+        for (&self.slots) |*mode| for (mode) |*slot| {
+            if (slot.exec) |*e| e.deinit();
+        };
+    }
+
+    pub fn run(self: *Steps, model: *Resident, pool: *Pool, pos: usize, tokens: []const u32, pick: bool) !bool {
+        const rows = tokens.len;
+        if (model.sc.graph_mode == .off or rows > 3 or pos < model.t.index_topk) return false;
+        if (model.rt.parts != null or model.pick_recorder != null) return false;
+        if (pick and @import("boundary.zig").envFlag("TF_HY4_GREEDY_FULL_GATHER")) return false;
+        if (model.tp_sess) |tp| {
+            const relay = tp.boundary.relay orelse return false;
+            if (!relay.fits(relay.ctx, rows * cuda.hy4_tp.hidden * 4)) return false;
+        }
+        try dump.validateTokenIds(tokens, model.t.vocab_size);
+        // Each replay reads the newly staged IDs. Captures never retain a host slice.
+        try model.sc.ids_i32.uploadAsync(0, std.mem.sliceAsBytes(tokens), model.rt.stream.handle);
+        const slot = &self.slots[@intFromBool(pick)][rows - 1];
+        if (slot.warmed and try capture(slot, model, pool, pos, rows, pick)) return true;
+        try body(model, pool, pos, rows, pick);
+        slot.warmed = true;
+        if (model.sc.graph_mode == .warm) model.sc.graph_mode = .ready;
+        return true;
+    }
+
+    fn body(model: *Resident, pool: *Pool, pos: usize, rows: usize, pick: bool) !void {
+        try model.rt.embed.bf16Copies(model.rt.stream, model.sc.ids_i32.ptr, model.trunk.embed_bf16, model.sc.streams_a.ptr, rows, model.t.hidden_size, 4);
+        try model.forwardLayers(pool, pos, rows);
+        if (pick) try model.deviceGreedy(0, rows);
+    }
+
+    fn capture(slot: *Slot, model: *Resident, pool: *Pool, pos: usize, rows: usize, pick: bool) !bool {
+        const stream = model.rt.stream;
+        try cuda.graph.beginCapture(stream, .thread_local);
+        model.sc.graph_mode = .capturing;
+        body(model, pool, pos, rows, pick) catch |err| {
+            model.sc.graph_mode = .ready;
+            var abandoned = try cuda.graph.endCapture(stream);
+            abandoned.deinit();
+            if (err == error.Hy4GraphNeedsWarmup) return false;
+            return err;
+        };
+        model.sc.graph_mode = .ready;
+        var captured = try cuda.graph.endCapture(stream);
+        defer captured.deinit();
+        if (slot.exec) |exe| {
+            if (try exe.update(captured) == .success) {
+                try exe.launchOn(stream);
+                return true;
+            }
+        }
+        const next = captured.instantiate() catch |err| {
+            if (err != error.GraphNotPermitted) return err;
+            model.sc.graph_mode = .off;
+            return false;
+        };
+        if (slot.exec) |*old| {
+            old.deinit();
+        } else {
+            std.log.info("hy4 decode graph active layers={d} rows={d} greedy={}", .{ model.layers.len, rows, pick });
+        }
+        slot.exec = next;
+        try next.launchOn(stream);
+        return true;
+    }
+};
diff --git a/zig/src/families/hy4/step_graph_check.zig b/zig/src/families/hy4/step_graph_check.zig
new file mode 100644
index 0000000000000000000000000000000000000000..00ac71d9682ac46777004eb91fb138ae2f70f280
--- /dev/null
+++ b/zig/src/families/hy4/step_graph_check.zig
@@ -0,0 +1,64 @@
+//! The real-model --check-window7 gate also checks greedy verify graphs when enabled.
+const std = @import("std");
+const cuda = @import("cuda");
+const Resident = @import("resident.zig").ResidentModel;
+const pool_mod = @import("kv_pool.zig");
+const Pool = pool_mod.KvPool;
+const Hash = std.crypto.hash.sha2.Sha256;
+
+fn append(model: *Resident, hash: *Hash, ptr: u64, bytes: usize) !void {
+    const buf = try model.gpa.alloc(u8, bytes);
+    defer model.gpa.free(buf);
+    try cuda.memory.download(model.rt.d, ptr, buf);
+    hash.update(buf);
+}
+
+fn fingerprint(model: *Resident, pool: *Pool, pos: usize, rows: usize) ![32]u8 {
+    var hash = Hash.init(.{});
+    try append(model, &hash, model.sc.streams_a.ptr, rows * 4 * model.t.hidden_size * 2);
+    try append(model, &hash, model.sc.logits_f32.ptr, rows * model.head.?.vocab_pad * 4);
+    const kv_bytes = pool_mod.kvRowBytes(model.t);
+    const ix_bytes = pool_mod.indexRowBytes(model.t);
+    for (pool.kv_bufs, pool.index_bufs) |kv, ix| {
+        try append(model, &hash, kv.ptr + pos * kv_bytes, rows * kv_bytes);
+        if (ix.len > 0) try append(model, &hash, ix.ptr + pos * ix_bytes, rows * ix_bytes);
+    }
+    return hash.finalResult();
+}
+
+pub fn check(model: *Resident, a: *Pool, b: *Pool, prefix: usize, tokens: []const u32) !void {
+    if (model.sc.graph_mode == .off) return error.Hy4VerifyGraphInactive;
+    try a.clearRange(model.t, prefix, prefix + 7, model.rt.stream.handle);
+    try b.clearRange(model.t, prefix, prefix + 7, model.rt.stream.handle);
+    const offsets = [_]usize{ 0, 2, 1, 3, 0, 1, 3, 2, 1, 4, 0, 2 };
+    for (offsets, 0..) |off, i| {
+        const rows = 2 + i % 2;
+        const pos = prefix + off;
+        const toks = tokens[off..][0..rows];
+        var sums: [2][32]u8 = undefined;
+        var picked: [2][3]u32 = undefined;
+        var time_us: [2]i64 = undefined;
+        for (0..2) |arm| {
+            const graph = (i / 2 + arm) % 2;
+            const pool = if ((arm + i / 4) % 2 == 0) a else b;
+            try model.rt.stream.synchronize();
+            const start = std.Io.Clock.awake.now(model.io);
+            if (graph == 1) {
+                try model.forwardGreedy(pool, pos, toks, picked[graph][0..rows]);
+            } else {
+                const saved = model.sc.graph_mode;
+                model.sc.graph_mode = .off;
+                defer model.sc.graph_mode = saved;
+                try model.forwardStep(pool, pos, toks);
+                try model.computeGreedy(0, picked[graph][0..rows]);
+            }
+            time_us[graph] = @intCast(start.durationTo(std.Io.Clock.awake.now(model.io)).toMicroseconds());
+            sums[graph] = try fingerprint(model, pool, pos, rows);
+        }
+        if (!std.mem.eql(u8, &sums[0], &sums[1]) or !std.mem.eql(u32, picked[0][0..rows], picked[1][0..rows]))
+            return error.Hy4VerifyGraphMismatch;
+        std.debug.print("hy4 verify graph rows={d} pos={d} eager_us={d} graph_us={d} exact={x} ids={any}\n", .{ rows, pos, time_us[0], time_us[1], sums[1][0..8], picked[1][0..rows] });
+    }
+    if (model.sc.graph_mode == .off) return error.Hy4VerifyGraphInactive;
+    for (model.steps.slots[1][1..3]) |slot| if (slot.exec == null) return error.Hy4VerifyGraphInactive;
+}
diff --git a/zig/src/families/hy4/trunk_exl3.zig b/zig/src/families/hy4/trunk_exl3.zig
new file mode 100644
index 0000000000000000000000000000000000000000..cf1e46bdeecd3fa7ad91583be387ae709d513b48
--- /dev/null
+++ b/zig/src/families/hy4/trunk_exl3.zig
@@ -0,0 +1,615 @@
+//! Common EXL3 quantized linear loader, sidecar overlay (`hy4-exl3-trunk-v1`), TP=4 slice geometry, and dispatch.
+//!
+//! Supports the 8 trunk matrices per layer (`q_a_proj`, `q_b_proj`, `kv_a_proj_with_mqa` zero-padded `576 -> 640`,
+//! `linear_gate`, `o_proj`, and `mlp.shared_experts.{gate,up,down}_proj`, plus optional dense `mlp.{gate,up,down}_proj`),
+//! all 44 DFly2 drafter matrices (`model.dfly_layers.*`), and EXL3 vocabulary heads (`lm_head.*`) at whatever bit width
+//! each `.trellis` header declares (`3`, `4`, `6`, and `mul1` half steps), with per-matrix width selection via
+//! `trunk_exl3_overlay.zig` and `ShortTrunk` fused short-window kernels on GB10 (`sm_121`).
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const cache = @import("cache.zig");
+const ranks = @import("ranks.zig");
+const weights = @import("weights.zig");
+const overlay = @import("trunk_exl3_overlay.zig");
+
+const st = core.safetensors;
+const layout = core.exl3_layout;
+const prepare = core.exl3_prepare;
+const Uploader = cuda.exl3_upload.Uploader;
+
+pub const TrunkSpec = overlay.TrunkSpec;
+pub const parseTrunkSpec = overlay.parseTrunkSpec;
+pub const OpenTarget = overlay.OpenTarget;
+pub const normalizeOpenTarget = overlay.normalizeOpenTarget;
+pub const applyOverlayAndPrune = overlay.applyOverlayAndPrune;
+pub const applyDrafterOverlays = overlay.applyDrafterOverlays;
+
+pub fn openDrafterIndex(
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    model_idx: *const weights.ShardIndex,
+    explicit_config: ?[]const u8,
+    drafter_dir: ?[]const u8,
+    explicit_dfly_exl3: ?[]const u8,
+    explicit_head_exl3: ?[]const u8,
+) !?weights.ShardIndex {
+    const b = @import("boundary.zig");
+    const has_dfly_opt = explicit_dfly_exl3 != null or explicit_head_exl3 != null or
+        b.envStr("TF_HY4_DRAFTER_EXL3") != null or b.envStr("TF_HY4_DRAFTER_HEAD") != null;
+    var didx: weights.ShardIndex = if (drafter_dir) |ddir| blk: {
+        if (weights.ShardIndex.openRaw(gpa, io, ddir, null)) |opened| break :blk opened else |_| {}
+        const cfg_p = if (explicit_config) |c| try gpa.dupe(u8, c) else try std.fs.path.join(gpa, &.{ model_idx.dir, "config.json" });
+        defer gpa.free(cfg_p);
+        break :blk try weights.ShardIndex.openRaw(gpa, io, ddir, cfg_p);
+    } else if (model_idx.cfg.value.dfly_num_hidden_layers > 0 and (has_dfly_opt or model_idx.has("lm_head.trellis")))
+        try weights.ShardIndex.openRaw(gpa, io, model_idx.dir, explicit_config)
+    else
+        return null;
+    errdefer didx.deinit();
+    try applyDrafterOverlays(&didx, io, model_idx.dir, explicit_dfly_exl3, explicit_head_exl3);
+    return didx;
+}
+
+/// Identifies trunk linear prefixes under `model.layers.<L>.` and their TP=4 `exl3_layout.Split`.
+pub fn trunkSplitForPrefix(prefix: []const u8) ?layout.Split {
+    if (!std.mem.startsWith(u8, prefix, "model.layers.")) return null;
+    if (std.mem.indexOf(u8, prefix, ".experts.") != null) return null;
+    if (std.mem.indexOf(u8, prefix, ".indexer.") != null) return null;
+
+    if (std.mem.endsWith(u8, prefix, ".self_attn.q_a_proj") or
+        std.mem.endsWith(u8, prefix, ".self_attn.kv_a_proj_with_mqa"))
+    {
+        return .whole;
+    }
+    if (std.mem.endsWith(u8, prefix, ".self_attn.q_b_proj") or
+        std.mem.endsWith(u8, prefix, ".self_attn.linear_gate") or
+        std.mem.endsWith(u8, prefix, ".mlp.shared_experts.gate_proj") or
+        std.mem.endsWith(u8, prefix, ".mlp.shared_experts.up_proj") or
+        std.mem.endsWith(u8, prefix, ".mlp.gate_proj") or
+        std.mem.endsWith(u8, prefix, ".mlp.up_proj"))
+    {
+        return .col;
+    }
+    if (std.mem.endsWith(u8, prefix, ".self_attn.o_proj") or
+        std.mem.endsWith(u8, prefix, ".mlp.shared_experts.down_proj") or
+        std.mem.endsWith(u8, prefix, ".mlp.down_proj"))
+    {
+        return .row;
+    }
+    return null;
+}
+
+/// Identifies DFly2 drafter (`model.dfly_layers.*`) and proposal `lm_head` prefixes and their TP=4 `Split`.
+pub fn drafterOrHeadSplitForPrefix(prefix: []const u8) ?layout.Split {
+    if (std.mem.eql(u8, prefix, "lm_head")) return .col;
+    if (!std.mem.startsWith(u8, prefix, "model.dfly_layers.")) return null;
+    if (std.mem.eql(u8, prefix, "model.dfly_layers.mtp_fusion.eh_proj")) return .whole;
+    if (std.mem.eql(u8, prefix, "model.dfly_layers.hidden_correction.gate_proj") or
+        std.mem.eql(u8, prefix, "model.dfly_layers.hidden_correction.up_proj")) return .col;
+    if (std.mem.eql(u8, prefix, "model.dfly_layers.hidden_correction.down_proj")) return .row;
+    if (std.mem.endsWith(u8, prefix, ".self_attn.q_a_proj") or
+        std.mem.endsWith(u8, prefix, ".self_attn.kv_a_proj_with_mqa")) return .whole;
+    if (std.mem.endsWith(u8, prefix, ".self_attn.q_b_proj") or
+        std.mem.endsWith(u8, prefix, ".self_attn.linear_gate") or
+        std.mem.endsWith(u8, prefix, ".mlp.gate_proj") or
+        std.mem.endsWith(u8, prefix, ".mlp.up_proj")) return .col;
+    if (std.mem.endsWith(u8, prefix, ".self_attn.o_proj") or
+        std.mem.endsWith(u8, prefix, ".mlp.down_proj")) return .row;
+    return null;
+}
+
+pub fn exl3SplitForPrefix(prefix: []const u8) ?layout.Split {
+    return trunkSplitForPrefix(prefix) orelse drafterOrHeadSplitForPrefix(prefix);
+}
+
+/// Computes `rank`'s TP=4 byte `Span` for EXL3 trunk, drafter, and head tensors (`trellis`, `suh`, `svh`, `su`, `sv`, `mul1`, `mcg`, `bias`).
+/// Returns `null` for `.weight` and non-EXL3 tensors so lossless slicing stays untouched.
+pub fn headerSpan(names: *const st.Header, name: []const u8, e: st.Entry, rank: ranks.Rank) !?ranks.Span {
+    const dot = std.mem.lastIndexOfScalar(u8, name, '.') orelse return null;
+    const suffix = name[dot + 1 ..];
+    if (std.mem.eql(u8, suffix, "weight")) return null;
+    const prefix = name[0..dot];
+    const split = exl3SplitForPrefix(prefix) orelse return null;
+
+    const whole: ranks.Span = .{ .offset = 0, .len = e.end - e.begin };
+    if (std.mem.eql(u8, suffix, "mul1") or std.mem.eql(u8, suffix, "mcg")) return whole;
+
+    var key_buf: [224]u8 = undefined;
+    const tr_key = try std.fmt.bufPrint(&key_buf, "{s}.trellis", .{prefix});
+    const tr_entry = names.get(tr_key) orelse return error.MissingTrellis;
+    const group = try layout.Group.fromShape(tr_entry.shape[0..tr_entry.rank]);
+    const sh = rank.stripe(.heads);
+    const r_slot: u32 = sh.first / sh.count;
+    const part = try group.part(split, r_slot, cuda.hy4_tp.world);
+
+    if (std.mem.eql(u8, suffix, "trellis")) return part.trellis;
+    if (std.mem.eql(u8, suffix, "suh")) return part.suh;
+    if (std.mem.eql(u8, suffix, "svh")) return part.svh;
+    if (std.mem.eql(u8, suffix, "su")) return .{ .offset = part.suh.offset / 16, .len = part.suh.len / 16 };
+    if (std.mem.eql(u8, suffix, "sv")) return .{ .offset = part.svh.offset / 16, .len = part.svh.len / 16 };
+    if (std.mem.eql(u8, suffix, "bias")) return if (split == .col) part.svh else whole;
+    return error.UnknownTrunkExl3Field;
+}
+
+pub const LinearExl3 = struct {
+    weight: cuda.exl3.Weight,
+    n: usize,
+    n_full: usize,
+    k: usize,
+    n_pad: usize,
+    k_pad: usize,
+    pinned_col_plan: bool = false,
+    range_protected: bool = false,
+};
+
+pub const LinearProj = union(enum) {
+    bf16: weights.LinearBf16,
+    exl3: LinearExl3,
+
+    pub fn logicalN(self: LinearProj) usize {
+        return switch (self) {
+            .bf16 => |w| w.n,
+            .exl3 => |w| w.n,
+        };
+    }
+
+    pub fn kvRowStride(self: LinearProj) u32 {
+        return switch (self) {
+            .bf16 => 0,
+            .exl3 => |w| if (w.n_pad != w.n) @intCast(w.n_pad) else 0,
+        };
+    }
+};
+
+fn expandSignsAlloc(alloc: std.mem.Allocator, words: []const u8, elems: usize) ![]u8 {
+    if (elems % 16 != 0 or words.len != (elems / 16) * 2) return error.BadScales;
+    const dest = try alloc.alloc(u8, elems * 2);
+    for (0..elems) |i| {
+        const word = std.mem.readInt(u16, words[(i / 16) * 2 ..][0..2], .little);
+        const value: u16 = if (word & (@as(u16, 1) << @intCast(i % 16)) != 0) 0xbc00 else 0x3c00;
+        std.mem.writeInt(u16, dest[i * 2 ..][0..2], value, .little);
+    }
+    return dest;
+}
+
+fn readCodebook(alloc: std.mem.Allocator, sess: *weights.ShardSession, prefix: []const u8) !cuda.exl3.Codebook {
+    var b_mul: [224]u8 = undefined;
+    var b_mcg: [224]u8 = undefined;
+    const mul_name = try std.fmt.bufPrint(&b_mul, "{s}.mul1", .{prefix});
+    const mcg_name = try std.fmt.bufPrint(&b_mcg, "{s}.mcg", .{prefix});
+    const has_mul = sess.idx.has(mul_name);
+    const has_mcg = sess.idx.has(mcg_name);
+    if (has_mul and has_mcg) return error.BadHy4TrunkMarker;
+    if (!has_mul and !has_mcg) return .inst3;
+
+    const mname = if (has_mul) mul_name else mcg_name;
+    const got = try sess.getSlice(alloc, mname, false);
+    if ((!got.tensor.is(.i32, &.{}) and !got.tensor.is(.i32, &.{1})) or got.bytes.len != 4)
+        return error.BadHy4TrunkMarker;
+    const magic = std.mem.readInt(u32, got.bytes[0..4], .little);
+    return switch (try layout.fromMarker(magic)) {
+        .mul1 => .mul1,
+        .mcg => .mcg,
+        .inst3 => .inst3,
+    };
+}
+
+/// Uploads `<prefix>.{trellis,suh,svh,mul1}` when `<prefix>.trellis` is present in `sess.idx`, verifying
+/// `trunk_k2` metadata against `trellis.shape[2] == 8 * k2`, repacking trellis tiles to `strips`, and pinning
+/// parent `(sk, wk)` on TP=4 column slices; falls back to BF16 `.weight` otherwise.
+pub fn uploadProj(
+    sess: *weights.ShardSession,
+    gpa: std.mem.Allocator,
+    up: *Uploader,
+    prefix: []const u8,
+    full_n: usize,
+    full_k: usize,
+    local_n: usize,
+    local_k: usize,
+    split: layout.Split,
+) !LinearProj {
+    var nb: [224]u8 = undefined;
+    const tr_name = try std.fmt.bufPrint(&nb, "{s}.trellis", .{prefix});
+    if (!sess.idx.has(tr_name)) {
+        const w_name = try std.fmt.bufPrint(&nb, "{s}.weight", .{prefix});
+        return .{ .bf16 = try weights.uploadLinearBf16(sess, gpa, up, w_name, full_n, full_k, local_n, local_k) };
+    }
+
+    const k_full_pad = std.mem.alignForward(usize, full_k, 128);
+    const n_full_pad = std.mem.alignForward(usize, full_n, 128);
+    const k_local_pad = std.mem.alignForward(usize, local_k, 128);
+    const n_local_pad = std.mem.alignForward(usize, local_n, 128);
+    if (k_full_pad == 0 or n_full_pad == 0 or k_local_pad == 0 or n_local_pad == 0) return error.BadHy4Trellis;
+    if (split == .col and n_local_pad != n_full_pad and (local_n % 128 != 0 or local_n * cuda.hy4_tp.world != full_n or local_k != full_k))
+        return error.BadHy4TpShape;
+    if (split == .row and k_local_pad != k_full_pad and (local_k % 128 != 0 or local_k * cuda.hy4_tp.world != full_k or local_n != full_n))
+        return error.BadHy4TpShape;
+
+    var tmp_arena = std.heap.ArenaAllocator.init(gpa);
+    defer tmp_arena.deinit();
+    const ta = tmp_arena.allocator();
+
+    const tr_got = try sess.getSlice(ta, tr_name, false);
+    if (tr_got.tensor.dtype != .i16 or tr_got.tensor.rank != 3) return error.BadHy4Trellis;
+    const g = try layout.Group.fromShape(tr_got.tensor.shape[0..3]);
+    if (g.k() != k_full_pad or g.n() != n_full_pad or tr_got.tensor.numel() * 2 != g.trellisBytes())
+        return error.BadHy4Trellis;
+    if (sess.idx.trunk_k2.get(prefix)) |exp_k2| {
+        if (g.k2() != exp_k2) return error.TrunkBitWidthMismatch;
+    }
+    const kt_loc = k_local_pad / 16;
+    const nt_loc = n_local_pad / 16;
+    if (tr_got.bytes.len != kt_loc * nt_loc * @as(usize, @intCast(g.tileBytes())))
+        return error.BadHy4Trellis;
+
+    const codebook = try readCodebook(ta, sess, prefix);
+    var b_su: [224]u8 = undefined;
+    var b_sv: [224]u8 = undefined;
+    const suh_name = try std.fmt.bufPrint(&b_su, "{s}.suh", .{prefix});
+    const svh_name = try std.fmt.bufPrint(&b_sv, "{s}.svh", .{prefix});
+    const has_suh = sess.idx.has(suh_name);
+    const has_svh = sess.idx.has(svh_name);
+    if (has_suh != has_svh) return error.BadScales;
+
+    const mark = up.bufs.items.len;
+    errdefer up.rollback(mark);
+
+    const suh_ptr = if (has_suh) blk: {
+        const suh = try sess.getSlice(ta, suh_name, false);
+        if (!suh.tensor.is(.f16, &.{k_full_pad}) or suh.bytes.len != k_local_pad * 2) return error.BadScales;
+        break :blk try up.dev(suh.bytes);
+    } else blk: {
+        const su = try sess.getSlice(ta, try std.fmt.bufPrint(&b_su, "{s}.su", .{prefix}), false);
+        if (!su.tensor.is(.i16, &.{k_full_pad / 16}) or su.bytes.len != (k_local_pad / 16) * 2) return error.BadScales;
+        break :blk try up.dev(try expandSignsAlloc(ta, su.bytes, k_local_pad));
+    };
+
+    const svh_ptr = if (has_svh) blk: {
+        const svh = try sess.getSlice(ta, svh_name, false);
+        if (!svh.tensor.is(.f16, &.{n_full_pad}) or svh.bytes.len != n_local_pad * 2) return error.BadScales;
+        break :blk try up.dev(svh.bytes);
+    } else blk: {
+        const sv = try sess.getSlice(ta, try std.fmt.bufPrint(&b_sv, "{s}.sv", .{prefix}), false);
+        if (!sv.tensor.is(.i16, &.{n_full_pad / 16}) or sv.bytes.len != (n_local_pad / 16) * 2) return error.BadScales;
+        break :blk try up.dev(try expandSignsAlloc(ta, sv.bytes, n_local_pad));
+    };
+
+    var b_bias: [224]u8 = undefined;
+    const bias_name = try std.fmt.bufPrint(&b_bias, "{s}.bias", .{prefix});
+    const bias_ptr: u64 = if (sess.idx.has(bias_name)) blk: {
+        if (split == .row and k_local_pad != k_full_pad) return error.UnsupportedRowSplitBias;
+        const b = try sess.getSlice(ta, bias_name, false);
+        if (!b.tensor.is(.f16, &.{n_full_pad}) or b.bytes.len != n_local_pad * 2) return error.BadBias;
+        break :blk try up.dev(b.bytes);
+    } else 0;
+
+    const strip_bytes = try prepare.strips(ta, tr_got.bytes, kt_loc, nt_loc, g.words);
+    const tr_ptr = try up.dev(strip_bytes);
+    if (!tr_got.direct_hit and tr_got.bytes.len >= (64 << 20)) tr_got.file.release(sess.idx.gpa);
+
+    const st_strides = cuda.exl3.strides(k_local_pad, n_local_pad, g.k2(), true);
+    const pin_col = split == .col and n_local_pad != n_full_pad;
+    const full_p = cuda.exl3.plan(k_full_pad, n_full_pad, 192, 8);
+    const loc_p = if (pin_col) full_p else cuda.exl3.plan(k_local_pad, n_local_pad, 192, 8);
+    if (kt_loc % (loc_p.sk * loc_p.wk) != 0) return error.Exl3Shape;
+    if (cuda.exl3.variantIndex(g.k2(), codebook, loc_p.wk) == null) return error.UnsupportedExl3Width;
+
+    return .{ .exl3 = .{
+        .weight = .{
+            .trellis = tr_ptr,
+            .suh = suh_ptr,
+            .svh = svh_ptr,
+            .bias = bias_ptr,
+            .k = @intCast(k_local_pad),
+            .n = @intCast(n_local_pad),
+            .halves = g.k2(),
+            .codebook = codebook,
+            .stride_k = st_strides.k,
+            .stride_nb = st_strides.nb,
+            .sk = if (pin_col) full_p.sk else 0,
+            .wk = if (pin_col) full_p.wk else 0,
+        },
+        .n = local_n,
+        .n_full = full_n,
+        .k = local_k,
+        .n_pad = n_local_pad,
+        .k_pad = k_local_pad,
+        .pinned_col_plan = pin_col,
+        .range_protected = split == .row,
+    } };
+}
+
+pub fn reserveProj(s: *cuda.hy4_ops.ShortTrunk, de: *cuda.exl3.Dense, stream: cuda.Stream, p: LinearProj) !void {
+    if (p == .exl3) {
+        try de.reserve(stream, p.exl3.weight);
+        if (p.exl3.range_protected) _ = try s.range.reserve(stream, p.exl3.weight, 128);
+    }
+}
+
+pub fn countLayerExl3(lw: *const weights.LayerWeights) usize {
+    var n: usize = 0;
+    inline for (.{ lw.q_a, lw.q_b, lw.kv_a, lw.linear_gate, lw.o_proj }) |p| {
+        if (p == .exl3) n += 1;
+    }
+    const dn_opt: ?weights.DenseMlp = switch (lw.mlp) {
+        .dense => |dn| dn,
+        .sparse_bf16 => |sp| sp.shared,
+        .sparse_exl3 => |sp| sp.shared,
+    };
+    if (dn_opt) |dn| inline for (.{ dn.gate, dn.up, dn.down }) |p| {
+        if (p == .exl3) n += 1;
+    };
+    return n;
+}
+
+pub fn reserveLayer(s: *cuda.hy4_ops.ShortTrunk, de: *cuda.exl3.Dense, stream: cuda.Stream, ops: *const cuda.hy4_ops.Kernels, lw: *weights.LayerWeights) !void {
+    if (ops.short_route) |fast| switch (lw.mlp) {
+        .sparse_exl3 => |*sp| if (sp.router_bf16 != 0) try fast.prepare(stream, &sp.exl3_layer),
+        else => {},
+    };
+    inline for (.{ lw.q_a, lw.q_b, lw.kv_a, lw.linear_gate, lw.o_proj }) |p| try reserveProj(s, de, stream, p);
+    if (lw.q_a == .exl3 and lw.kv_a == .exl3 and lw.q_a.exl3.k_pad == lw.q_a.exl3.k and lw.q_a.exl3.n_pad == lw.q_a.exl3.n) {
+        try de.reserveGroup(stream, &.{ lw.q_a.exl3.weight, lw.kv_a.exl3.weight });
+    }
+    const dn: weights.DenseMlp = switch (lw.mlp) {
+        .dense => |d| d,
+        .sparse_bf16 => |sp| sp.shared,
+        .sparse_exl3 => |sp| sp.shared,
+    };
+    inline for (.{ dn.gate, dn.up, dn.down }) |p| try reserveProj(s, de, stream, p);
+    if (dn.gate == .exl3 and dn.up == .exl3 and dn.gate.exl3.k_pad == dn.gate.exl3.k and dn.gate.exl3.n_pad == dn.gate.exl3.n and dn.up.exl3.n_pad == dn.up.exl3.n) {
+        try de.reserveGroup(stream, &.{ dn.gate.exl3.weight, dn.up.exl3.weight });
+    }
+}
+
+fn copy2d(d: *const cuda.Driver, stream: cuda.Stream, dst: u64, dst_pitch: usize, src: u64, src_pitch: usize, width: usize, rows: usize) !void {
+    if (rows == 0 or width == 0) return;
+    const c: cuda.abi.Memcpy2D = .{ .src = src, .src_pitch = src_pitch, .dst = dst, .dst_pitch = dst_pitch, .width = width, .height = rows };
+    try d.check(d.api.cuMemcpy2DAsync_v2(&c, stream.handle), "cuMemcpy2DAsync");
+}
+
+pub fn tryGated(s: *cuda.hy4_ops.ShortTrunk, de: *cuda.exl3.Dense, stream: cuda.Stream, dn: weights.DenseMlp, x: u64, y: u64, rows: usize) !bool {
+    for ([_]weights.LinearProj{ dn.gate, dn.up, dn.down }) |v| {
+        if (v != .exl3 or v.exl3.k != v.exl3.k_pad or v.exl3.n != v.exl3.n_pad) return false;
+    }
+    return s.gated(de, stream, .{ dn.gate.exl3.weight, dn.up.exl3.weight }, dn.down.exl3.weight, x, y, rows);
+}
+
+pub fn runExl3(short: *cuda.hy4_ops.ShortTrunk, de: *cuda.exl3.Dense, stream: cuda.Stream, sc: *cache.Scratch, x: u64, w: LinearExl3, y: u64, rows: usize, allow_strided_pad: bool) !void {
+    return runExl3Impl(short, de, null, stream, sc, x, w, y, rows, allow_strided_pad);
+}
+
+pub fn runExl3Gemm(short: *cuda.hy4_ops.ShortTrunk, de: *cuda.exl3.Dense, gemm: *cuda.vit.Gemms, stream: cuda.Stream, sc: *cache.Scratch, x: u64, w: LinearExl3, y: u64, rows: usize, allow_strided_pad: bool) !void {
+    return runExl3Impl(short, de, gemm, stream, sc, x, w, y, rows, allow_strided_pad);
+}
+
+fn runExl3Impl(short: *cuda.hy4_ops.ShortTrunk, de: *cuda.exl3.Dense, gemm_opt: ?*cuda.vit.Gemms, stream: cuda.Stream, sc: *cache.Scratch, x: u64, w: LinearExl3, y: u64, rows: usize, allow_strided_pad: bool) !void {
+    if (rows == 0) return;
+    const need_k_pad = w.k_pad != w.k;
+    const need_n_crop = w.n_pad != w.n and !allow_strided_pad;
+    if (!need_k_pad and !need_n_crop) {
+        if (gemm_opt) |gemm| if (try short.prefillGemm(gemm, stream, w.weight, x, y, .bf16, rows)) return;
+        if (w.range_protected) return short.projectRange(de, stream, w.weight, x, y, .bf16, rows);
+        if (try short.single(de, stream, w.weight, x, y, .bf16, rows)) return;
+        return de.decode(stream, w.weight, x, .bf16, rows, y, .bf16);
+    }
+    try sc.ensurePadScratch(rows * @as(usize, @max(w.k_pad, w.n_pad)) * 2);
+    const x_in = if (!need_k_pad) x else blk: {
+        const pad_view: cuda.DeviceBuffer = .{ .d = de.d, .ptr = sc.pad_in.ptr, .len = rows * w.k_pad * 2, .borrowed = true };
+        try pad_view.fill8(0, stream.handle);
+        try copy2d(de.d, stream, sc.pad_in.ptr, w.k_pad * 2, x, w.k * 2, w.k * 2, rows);
+        break :blk sc.pad_in.ptr;
+    };
+    const y_out = if (need_n_crop) sc.pad_out.ptr else y;
+    const ran_pf = if (gemm_opt) |gemm| try short.prefillGemm(gemm, stream, w.weight, x_in, y_out, .bf16, rows) else false;
+    if (!ran_pf) {
+        if (w.range_protected) {
+            try short.projectRange(de, stream, w.weight, x_in, y_out, .bf16, rows);
+        } else {
+            try de.decode(stream, w.weight, x_in, .bf16, rows, y_out, .bf16);
+        }
+    }
+    if (need_n_crop) {
+        try copy2d(de.d, stream, y, w.n * 2, sc.pad_out.ptr, w.n_pad * 2, w.n * 2, rows);
+    }
+}
+
+pub fn runExl3RowPartialF32(short: *cuda.hy4_ops.ShortTrunk, de: *cuda.exl3.Dense, stream: cuda.Stream, sc: *cache.Scratch, x: u64, w: LinearExl3, y_f32: u64, rows: usize) !void {
+    return runExl3RowPartialF32Impl(short, de, null, stream, sc, x, w, y_f32, rows);
+}
+
+pub fn runExl3RowPartialF32Gemm(short: *cuda.hy4_ops.ShortTrunk, de: *cuda.exl3.Dense, gemm: *cuda.vit.Gemms, stream: cuda.Stream, sc: *cache.Scratch, x: u64, w: LinearExl3, y_f32: u64, rows: usize) !void {
+    return runExl3RowPartialF32Impl(short, de, gemm, stream, sc, x, w, y_f32, rows);
+}
+
+fn runExl3RowPartialF32Impl(short: *cuda.hy4_ops.ShortTrunk, de: *cuda.exl3.Dense, gemm_opt: ?*cuda.vit.Gemms, stream: cuda.Stream, sc: *cache.Scratch, x: u64, w: LinearExl3, y_f32: u64, rows: usize) !void {
+    if (rows == 0) return;
+    // Row-split projections take the range-protected path; the opt-in packed head (column split) keeps its kernels.
+    if (w.k_pad == w.k and w.n_pad == w.n) {
+        if (gemm_opt) |gemm| if (try short.prefillGemm(gemm, stream, w.weight, x, y_f32, .f32, rows)) return;
+        if (w.range_protected) return short.projectRange(de, stream, w.weight, x, y_f32, .f32, rows);
+        if (try short.single(de, stream, w.weight, x, y_f32, .f32, rows)) return;
+        return de.decode(stream, w.weight, x, .bf16, rows, y_f32, .f32);
+    }
+    const need_tmp_pad = w.n_pad != w.n and rows * w.n_pad * 4 > sc.f32_tmp.len;
+    try sc.ensurePadScratch(rows * @as(usize, @max(w.k_pad, if (need_tmp_pad) w.n_pad * 2 else w.n_pad)) * 2);
+    const x_in = if (w.k_pad == w.k) x else blk: {
+        const pad_view: cuda.DeviceBuffer = .{ .d = de.d, .ptr = sc.pad_in.ptr, .len = rows * w.k_pad * 2, .borrowed = true };
+        try pad_view.fill8(0, stream.handle);
+        try copy2d(de.d, stream, sc.pad_in.ptr, w.k_pad * 2, x, w.k * 2, w.k * 2, rows);
+        break :blk sc.pad_in.ptr;
+    };
+    const y_out = if (w.n_pad == w.n) y_f32 else if (need_tmp_pad) sc.pad_out.ptr else sc.f32_tmp.ptr;
+    const ran_pf = if (gemm_opt) |gemm| try short.prefillGemm(gemm, stream, w.weight, x_in, y_out, .f32, rows) else false;
+    if (!ran_pf) {
+        if (w.range_protected) {
+            try short.projectRange(de, stream, w.weight, x_in, y_out, .f32, rows);
+        } else {
+            try de.decode(stream, w.weight, x_in, .bf16, rows, y_out, .f32);
+        }
+    }
+    if (w.n_pad != w.n) {
+        try copy2d(de.d, stream, y_f32, w.n * 4, y_out, w.n_pad * 4, w.n * 4, rows);
+    }
+}
+
+pub fn headLabel(head_opt: ?weights.HeadWeights) []const u8 {
+    const hd = head_opt orelse return "none";
+    const ex = hd.lm_head_exl3 orelse return if (hd.lm_head_bf16 != 0) "bf16" else "fp32";
+    return switch (ex.weight.halves) {
+        6 => "3b",
+        8 => "4b",
+        12 => "6b",
+        16 => "8b",
+        else => "exl3",
+    };
+}
+
+pub fn parseHeadWidthK2(tok: []const u8) ?u8 {
+    if (std.ascii.eqlIgnoreCase(tok, "3b")) return 6;
+    if (std.ascii.eqlIgnoreCase(tok, "4b")) return 8;
+    if (std.ascii.eqlIgnoreCase(tok, "6b")) return 12;
+    if (std.ascii.eqlIgnoreCase(tok, "8b")) return 16;
+    return null;
+}
+
+pub fn k2WidthName(k2: u8) ?[]const u8 {
+    return switch (k2) {
+        6 => "3b",
+        8 => "4b",
+        12 => "6b",
+        16 => "8b",
+        else => null,
+    };
+}
+
+pub fn canonicalTargetHeadSpec(raw: []const u8) ![]const u8 {
+    const trimmed = std.mem.trim(u8, raw, " \t\r\n");
+    if (trimmed.len == 0 or overlay.isLosslessToken(trimmed) or std.ascii.eqlIgnoreCase(trimmed, "fp32") or std.ascii.eqlIgnoreCase(trimmed, "32b"))
+        return "fp32";
+    if (std.mem.indexOfAny(u8, trimmed, "=:")) |sep| {
+        const lhs = std.mem.trim(u8, trimmed[0..sep], " \t");
+        const rhs = std.mem.trim(u8, trimmed[sep + 1 ..], " \t");
+        if (rhs.len == 0) return error.InvalidHy4TargetHead;
+        const k2 = parseHeadWidthK2(lhs) orelse return error.InvalidHy4TargetHead;
+        return k2WidthName(k2).?;
+    }
+    if (parseHeadWidthK2(trimmed)) |k2| return k2WidthName(k2).?;
+    if (std.mem.indexOfAny(u8, trimmed, "/.") == null and trimmed.len <= 4) return error.InvalidHy4TargetHead;
+    return trimmed;
+}
+
+fn stripTargetHeadExl3(idx: *weights.ShardIndex) !void {
+    var rem: std.ArrayList([]const u8) = .empty;
+    defer rem.deinit(idx.gpa);
+    var it = idx.weight_map.keyIterator();
+    while (it.next()) |kptr| {
+        const name = kptr.*;
+        if (!std.mem.startsWith(u8, name, "lm_head.")) continue;
+        if (overlay.isTrunkExl3Suffix(name["lm_head.".len..])) try rem.append(idx.gpa, name);
+    }
+    for (rem.items) |k| _ = idx.weight_map.remove(k);
+    _ = idx.trunk_k2.remove("lm_head");
+}
+
+fn readMappedHeadK2(idx: *const weights.ShardIndex, io: std.Io) !?u8 {
+    const rel = idx.weight_map.get("lm_head.trellis") orelse return null;
+    const full = try std.fs.path.join(idx.gpa, &.{ idx.dir, rel });
+    defer idx.gpa.free(full);
+    var f = try st.File.openPrefixes(idx.gpa, io, full, &.{"lm_head."});
+    defer f.close(io);
+    const e = f.names.get("lm_head.trellis") orelse return error.MissingHy4TargetHead;
+    if (e.dtype != .i16 or e.rank != 3) return error.BadHy4Trellis;
+    const g = try layout.Group.fromShape(e.shape[0..3]);
+    return @intCast(g.k2());
+}
+
+fn tryCandidateHeadPath(idx: *weights.ShardIndex, io: std.Io, path: []const u8, req_k2: ?u8, saw_mismatch: *bool) !?u8 {
+    if (path.len == 0) return null;
+    if (!(try overlay.loadSidecarPath(idx, io, path, false, true))) return null;
+    const got_k2 = (try readMappedHeadK2(idx, io)) orelse {
+        try stripTargetHeadExl3(idx);
+        return null;
+    };
+    if (req_k2) |want| if (got_k2 != want) {
+        saw_mismatch.* = true;
+        try stripTargetHeadExl3(idx);
+        return null;
+    };
+    return got_k2;
+}
+
+/// Applies optional target `lm_head` EXL3 sidecar (`--target-head` or `TF_HY4_TARGET_HEAD`).
+/// Off by default: strips any inline `lm_head.*` EXL3 keys so target `lm_head` stays lossless FP32 unless requested.
+/// When requested (`4b`, `6b`, `4b=/path`, or `/path`), refuses at load (`error.MissingHy4TargetHead` / `error.TrunkBitWidthMismatch`) if missing or mismatched.
+pub fn applyTargetHeadOverlay(idx: *weights.ShardIndex, io: std.Io, explicit_target_head: ?[]const u8, extra_dir: ?[]const u8) !void {
+    const raw = explicit_target_head orelse @import("boundary.zig").envStr("TF_HY4_TARGET_HEAD") orelse {
+        try stripTargetHeadExl3(idx);
+        return;
+    };
+    const trimmed = std.mem.trim(u8, raw, " \t\r\n");
+    if (trimmed.len == 0 or overlay.isLosslessToken(trimmed) or std.ascii.eqlIgnoreCase(trimmed, "fp32") or std.ascii.eqlIgnoreCase(trimmed, "32b")) {
+        try stripTargetHeadExl3(idx);
+        return;
+    }
+    try stripTargetHeadExl3(idx);
+
+    const gpa = idx.gpa;
+    const a = idx.arena.allocator();
+    var req_k2: ?u8 = null;
+    var path_part: ?[]const u8 = null;
+    if (std.mem.indexOfAny(u8, trimmed, "=:")) |sep| {
+        const lhs = std.mem.trim(u8, trimmed[0..sep], " \t");
+        const rhs = std.mem.trim(u8, trimmed[sep + 1 ..], " \t");
+        if (rhs.len == 0) return error.InvalidHy4TargetHead;
+        req_k2 = parseHeadWidthK2(lhs) orelse return error.InvalidHy4TargetHead;
+        path_part = rhs;
+    } else if (parseHeadWidthK2(trimmed)) |k2| {
+        req_k2 = k2;
+    } else {
+        if (std.mem.indexOfAny(u8, trimmed, "/.") == null and trimmed.len <= 4) return error.InvalidHy4TargetHead;
+        path_part = trimmed;
+    }
+
+    var saw_mismatch = false;
+    var loaded_k2: ?u8 = null;
+    if (path_part) |pp| {
+        if (try tryCandidateHeadPath(idx, io, pp, req_k2, &saw_mismatch)) |k2| {
+            loaded_k2 = k2;
+        } else {
+            const joined = try std.fs.path.join(gpa, &.{ idx.dir, pp });
+            defer gpa.free(joined);
+            loaded_k2 = try tryCandidateHeadPath(idx, io, joined, req_k2, &saw_mismatch);
+        }
+        if (loaded_k2 == null and saw_mismatch) return error.TrunkBitWidthMismatch;
+    } else {
+        const w_str = trimmed;
+        for ([_][]const u8{ "head-", "trunk-", "" }) |pfx| {
+            const sub = try std.fmt.allocPrint(gpa, "{s}{s}", .{ pfx, w_str });
+            defer gpa.free(sub);
+            const cand = try std.fs.path.join(gpa, &.{ idx.dir, sub });
+            defer gpa.free(cand);
+            if (try tryCandidateHeadPath(idx, io, cand, req_k2, &saw_mismatch)) |k2| {
+                loaded_k2 = k2;
+                break;
+            }
+        }
+        if (loaded_k2 == null) {
+            const b = @import("boundary.zig");
+            for ([_]?[]const u8{ extra_dir, b.envStr("TF_HY4_DRAFTER_HEAD"), b.envStr("TF_HY4_DRAFTER_EXL3"), b.envStr("DRAFTER_DIR") }) |hint_opt| {
+                if (hint_opt) |hint| if (try tryCandidateHeadPath(idx, io, hint, req_k2, &saw_mismatch)) |k2| {
+                    loaded_k2 = k2;
+                    break;
+                };
+            }
+        }
+    }
+    const final_k2 = loaded_k2 orelse return error.MissingHy4TargetHead;
+    try idx.trunk_k2.put(a, "lm_head", final_k2);
+    if (idx.weight_map.getKey("lm_head.weight")) |wk| _ = idx.weight_map.remove(wk);
+    idx.trunk_tag = if (idx.trunk_tag.len == 0)
+        try std.fmt.allocPrint(a, "target_head:k2={d}", .{final_k2})
+    else
+        try std.fmt.allocPrint(a, "{s};target_head:k2={d}", .{ idx.trunk_tag, final_k2 });
+}
diff --git a/zig/src/families/hy4/trunk_exl3_overlay.zig b/zig/src/families/hy4/trunk_exl3_overlay.zig
new file mode 100644
index 0000000000000000000000000000000000000000..27749ddc9d74721e4110789ac197db17ca6d0595
--- /dev/null
+++ b/zig/src/families/hy4/trunk_exl3_overlay.zig
@@ -0,0 +1,594 @@
+//! Sidecar overlay discovery (`hy4-exl3-trunk-v1`) and per-matrix width selection at load time.
+//!
+//! Supports single-profile sidecars (`4b`, `6b`, `3b`, `trunk-mixed`), built-in mixed recipes (`4b6b`,
+//! `vendor-4b`, `vendor-6b`), and arbitrary comma-separated per-matrix width rules (`4b,o_proj=6b,kv_a=6b`
+//! or `4b,o_proj=bf16`) across coexisting sidecars in `MODEL_DIR` without re-quantizing or duplicating files.
+//! Verifies `metadata.matrices[prefix].k2` from `trunk.index.json` against loaded `.trellis` headers.
+const std = @import("std");
+const core = @import("core");
+const boundary = @import("boundary.zig");
+const weights = @import("weights.zig");
+const trunk_exl3 = @import("trunk_exl3.zig");
+
+const st = core.safetensors;
+
+pub const TrunkSpec = union(enum) {
+    auto,
+    force_bf16,
+    profile: []const u8,
+};
+
+pub fn isLosslessToken(raw: []const u8) bool {
+    return std.ascii.eqlIgnoreCase(raw, "off") or
+        std.ascii.eqlIgnoreCase(raw, "0") or
+        std.ascii.eqlIgnoreCase(raw, "none") or
+        std.ascii.eqlIgnoreCase(raw, "bf16") or
+        std.ascii.eqlIgnoreCase(raw, "16b") or
+        std.ascii.eqlIgnoreCase(raw, "16") or
+        std.ascii.eqlIgnoreCase(raw, "lossless");
+}
+
+pub fn parseTrunkSpec(explicit: ?[]const u8) TrunkSpec {
+    const raw = explicit orelse boundary.envStr("TF_HY4_TRUNK") orelse return .auto;
+    const trimmed = std.mem.trim(u8, raw, " \t\r\n");
+    if (trimmed.len == 0 or std.ascii.eqlIgnoreCase(trimmed, "auto")) return .auto;
+    if (isLosslessToken(trimmed)) return .force_bf16;
+    return .{ .profile = trimmed };
+}
+
+pub const OpenTarget = struct {
+    target: []u8, spec: TrunkSpec, owned_profile: ?[]u8 = null,
+    pub fn deinit(self: *OpenTarget, gpa: std.mem.Allocator) void {
+        gpa.free(self.target);
+        if (self.owned_profile) |p| gpa.free(p);
+        self.* = undefined;
+    }
+};
+
+fn fileExists(io: std.Io, gpa: std.mem.Allocator, dir: []const u8, sub: []const u8) bool {
+    const full = std.fs.path.join(gpa, &.{ dir, sub }) catch return false;
+    defer gpa.free(full);
+    if (std.Io.Dir.cwd().openFile(io, full, .{})) |f| { f.close(io); return true; } else |_| return false;
+}
+
+pub fn normalizeOpenTarget(
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    dir_or_index: []const u8,
+    explicit_config: ?[]const u8,
+    explicit_trunk: ?[]const u8,
+) !OpenTarget {
+    const base_spec = parseTrunkSpec(explicit_trunk);
+    const trimmed = std.mem.trimEnd(u8, dir_or_index, "/");
+    const path_in = if (trimmed.len > 0) trimmed else dir_or_index;
+
+    const sub_dir_opt: ?[]const u8 = if (std.mem.endsWith(u8, path_in, "trunk.index.json"))
+        (std.fs.path.dirname(path_in) orelse ".")
+    else if (!std.mem.endsWith(u8, path_in, ".json") and !std.mem.endsWith(u8, path_in, ".safetensors") and fileExists(io, gpa, path_in, "trunk.index.json"))
+        path_in
+    else
+        null;
+
+    if (sub_dir_opt) |sub_dir| {
+        if (explicit_config != null or !fileExists(io, gpa, sub_dir, "config.json")) {
+            if (std.fs.path.dirname(sub_dir)) |parent_dir| {
+                if (explicit_config != null or fileExists(io, gpa, parent_dir, "config.json")) {
+                    const prof = try gpa.dupe(u8, std.fs.path.basename(sub_dir));
+                    errdefer gpa.free(prof);
+                    return .{
+                        .target = try gpa.dupe(u8, parent_dir),
+                        .spec = if (explicit_trunk != null) base_spec else .{ .profile = prof },
+                        .owned_profile = prof,
+                    };
+                }
+            }
+        }
+    }
+    return .{ .target = try gpa.dupe(u8, path_in), .spec = base_spec };
+}
+
+pub fn isTrunkExl3Suffix(sfx: []const u8) bool {
+    return std.mem.eql(u8, sfx, "trellis") or
+        std.mem.eql(u8, sfx, "suh") or
+        std.mem.eql(u8, sfx, "svh") or
+        std.mem.eql(u8, sfx, "su") or
+        std.mem.eql(u8, sfx, "sv") or
+        std.mem.eql(u8, sfx, "mul1") or
+        std.mem.eql(u8, sfx, "mcg") or
+        std.mem.eql(u8, sfx, "bias");
+}
+
+pub fn validateSelector(sel: []const u8) !void {
+    for ([_][]const u8{
+        "q_a", "q_a_proj", "self_attn.q_a_proj", "q_b", "q_b_proj", "self_attn.q_b_proj",
+        "kv_a", "kv_a_proj_with_mqa", "self_attn.kv_a_proj_with_mqa", "linear_gate", "self_attn.linear_gate",
+        "o", "o_proj", "self_attn.o_proj", "shared", "shared_experts",
+        "shared.gate", "shared_experts.gate_proj", "mlp.shared_experts.gate_proj",
+        "shared.up", "shared_experts.up_proj", "mlp.shared_experts.up_proj",
+        "shared.down", "shared_experts.down_proj", "mlp.shared_experts.down_proj",
+        "dense", "dense.gate", "mlp.gate_proj", "dense.up", "mlp.up_proj", "dense.down", "mlp.down_proj",
+    }) |v| if (std.mem.eql(u8, sel, v)) return;
+    return error.InvalidHy4TrunkRecipe;
+}
+
+fn prefixMatchesSelector(prefix: []const u8, sel: []const u8) bool {
+    if (trunk_exl3.trunkSplitForPrefix(prefix) == null) return false;
+    const eql = std.mem.eql;
+    const ends = std.mem.endsWith;
+    if (eql(u8, sel, "q_a") or eql(u8, sel, "q_a_proj") or eql(u8, sel, "self_attn.q_a_proj")) return ends(u8, prefix, ".self_attn.q_a_proj");
+    if (eql(u8, sel, "q_b") or eql(u8, sel, "q_b_proj") or eql(u8, sel, "self_attn.q_b_proj")) return ends(u8, prefix, ".self_attn.q_b_proj");
+    if (eql(u8, sel, "kv_a") or eql(u8, sel, "kv_a_proj_with_mqa") or eql(u8, sel, "self_attn.kv_a_proj_with_mqa")) return ends(u8, prefix, ".self_attn.kv_a_proj_with_mqa");
+    if (eql(u8, sel, "linear_gate") or eql(u8, sel, "self_attn.linear_gate")) return ends(u8, prefix, ".self_attn.linear_gate");
+    if (eql(u8, sel, "o") or eql(u8, sel, "o_proj") or eql(u8, sel, "self_attn.o_proj")) return ends(u8, prefix, ".self_attn.o_proj");
+    if (eql(u8, sel, "shared") or eql(u8, sel, "shared_experts")) return std.mem.indexOf(u8, prefix, ".mlp.shared_experts.") != null;
+    if (eql(u8, sel, "shared.gate") or eql(u8, sel, "shared_experts.gate_proj") or eql(u8, sel, "mlp.shared_experts.gate_proj")) return ends(u8, prefix, ".mlp.shared_experts.gate_proj");
+    if (eql(u8, sel, "shared.up") or eql(u8, sel, "shared_experts.up_proj") or eql(u8, sel, "mlp.shared_experts.up_proj")) return ends(u8, prefix, ".mlp.shared_experts.up_proj");
+    if (eql(u8, sel, "shared.down") or eql(u8, sel, "shared_experts.down_proj") or eql(u8, sel, "mlp.shared_experts.down_proj")) return ends(u8, prefix, ".mlp.shared_experts.down_proj");
+    if (eql(u8, sel, "dense")) return ends(u8, prefix, ".mlp.gate_proj") or ends(u8, prefix, ".mlp.up_proj") or ends(u8, prefix, ".mlp.down_proj");
+    if (eql(u8, sel, "dense.gate") or eql(u8, sel, "mlp.gate_proj")) return ends(u8, prefix, ".mlp.gate_proj");
+    if (eql(u8, sel, "dense.up") or eql(u8, sel, "mlp.up_proj")) return ends(u8, prefix, ".mlp.up_proj");
+    if (eql(u8, sel, "dense.down") or eql(u8, sel, "mlp.down_proj")) return ends(u8, prefix, ".mlp.down_proj");
+    return false;
+}
+
+fn tensorMatchesFilter(tname: []const u8, filter_sel: ?[]const u8) bool {
+    const dot = std.mem.lastIndexOfScalar(u8, tname, '.') orelse return false;
+    if (trunk_exl3.trunkSplitForPrefix(tname[0..dot]) == null) return false;
+    const sel = filter_sel orelse return true;
+    return prefixMatchesSelector(tname[0..dot], sel);
+}
+
+fn recordMetadataMatrices(idx: *weights.ShardIndex, parsed: std.json.Value, filter_sel: ?[]const u8) !void {
+    const a = idx.arena.allocator();
+    if (parsed != .object) return;
+    const meta = parsed.object.get("metadata") orelse return;
+    if (meta != .object) return;
+    const mats = meta.object.get("matrices") orelse return;
+    if (mats != .object) return;
+    var it = mats.object.iterator();
+    while (it.next()) |kv| {
+        const prefix = kv.key_ptr.*;
+        if (trunk_exl3.trunkSplitForPrefix(prefix) == null) continue;
+        if (filter_sel) |sel| {
+            if (!prefixMatchesSelector(prefix, sel)) continue;
+        }
+        if (kv.value_ptr.* != .object) continue;
+        const k2_val = kv.value_ptr.object.get("k2") orelse continue;
+        const k2_i64: i64 = switch (k2_val) {
+            .integer => |v| v,
+            else => continue,
+        };
+        if (k2_i64 <= 0 or k2_i64 > 16) return error.TrunkBitWidthMismatch;
+        try idx.trunk_k2.put(a, try a.dupe(u8, prefix), @intCast(k2_i64));
+    }
+}
+
+fn loadOverlayFromSubdirFiltered(idx: *weights.ShardIndex, io: std.Io, sub_rel: []const u8, filter_sel: ?[]const u8) !bool {
+    const gpa = idx.gpa;
+    const a = idx.arena.allocator();
+
+    const idx_rel = try std.fs.path.join(gpa, &.{ sub_rel, "trunk.index.json" });
+    defer gpa.free(idx_rel);
+    const idx_full = try std.fs.path.join(gpa, &.{ idx.dir, idx_rel });
+    defer gpa.free(idx_full);
+
+    if (std.Io.Dir.cwd().readFileAlloc(io, idx_full, gpa, .limited(64 << 20))) |bytes| {
+        defer gpa.free(bytes);
+        const parsed = try std.json.parseFromSliceLeaky(std.json.Value, a, bytes, .{});
+        const map = try st.index.weightMap(parsed);
+        try idx.weight_map.ensureUnusedCapacity(a, @intCast(map.count()));
+        var it = map.iterator();
+        while (it.next()) |kv| {
+            const tname = kv.key_ptr.*;
+            if (!tensorMatchesFilter(tname, filter_sel)) continue;
+            if (filter_sel != null) {
+                const dot = std.mem.lastIndexOfScalar(u8, tname, '.').?;
+                _ = idx.trunk_k2.remove(tname[0..dot]);
+            }
+            const raw_rel = kv.value_ptr.string;
+            const rel = if (std.mem.indexOfScalar(u8, raw_rel, '/') != null and fileExists(io, gpa, idx.dir, raw_rel))
+                try a.dupe(u8, raw_rel)
+            else
+                try std.fs.path.join(a, &.{ sub_rel, raw_rel });
+            try idx.weight_map.put(a, try a.dupe(u8, tname), rel);
+        }
+        try recordMetadataMatrices(idx, parsed, filter_sel);
+        return true;
+    } else |err| switch (err) {
+        error.FileNotFound => {},
+        else => return err,
+    }
+
+    const dir_full = try std.fs.path.join(gpa, &.{ idx.dir, sub_rel });
+    defer gpa.free(dir_full);
+    var d = std.Io.Dir.cwd().openDir(io, dir_full, .{ .iterate = true }) catch |err| switch (err) {
+        error.FileNotFound => return false,
+        else => return err,
+    };
+    defer d.close(io);
+
+    var found: usize = 0;
+    var dit = d.iterate();
+    while (try dit.next(io)) |entry| {
+        if (entry.kind != .file and entry.kind != .sym_link) continue;
+        if (!std.mem.endsWith(u8, entry.name, ".safetensors") or std.mem.startsWith(u8, entry.name, ".")) continue;
+        const shard_rel = try std.fs.path.join(a, &.{ sub_rel, entry.name });
+        const shard_full = try std.fs.path.join(gpa, &.{ idx.dir, shard_rel });
+        defer gpa.free(shard_full);
+        var f = try st.File.openPrefixes(gpa, io, shard_full, &.{ "model.", "lm_head." });
+        defer f.close(io);
+        for (f.names.keys()) |tname| {
+            if (!tensorMatchesFilter(tname, filter_sel)) continue;
+            if (filter_sel != null) {
+                const dot = std.mem.lastIndexOfScalar(u8, tname, '.').?;
+                _ = idx.trunk_k2.remove(tname[0..dot]);
+            }
+            try idx.weight_map.put(a, try a.dupe(u8, tname), shard_rel);
+        }
+        found += 1;
+    }
+    return found > 0;
+}
+
+fn loadNamedProfileFiltered(idx: *weights.ShardIndex, io: std.Io, prof: []const u8, filter_sel: ?[]const u8) ![]const u8 {
+    const a = idx.arena.allocator();
+    if (try loadOverlayFromSubdirFiltered(idx, io, prof, filter_sel)) return try a.dupe(u8, prof);
+    if (!std.mem.startsWith(u8, prof, "trunk-")) {
+        const alt = try std.fmt.allocPrint(a, "trunk-{s}", .{prof});
+        if (try loadOverlayFromSubdirFiltered(idx, io, alt, filter_sel)) return alt;
+    }
+    return error.MissingHy4TrunkProfile;
+}
+
+fn removeMatchingExl3(idx: *weights.ShardIndex, filter_sel: ?[]const u8) !usize {
+    const gpa = idx.gpa;
+    var to_remove: std.ArrayList([]const u8) = .empty;
+    defer to_remove.deinit(gpa);
+    var it = idx.weight_map.keyIterator();
+    while (it.next()) |kptr| {
+        const name = kptr.*;
+        const dot = std.mem.lastIndexOfScalar(u8, name, '.') orelse continue;
+        const prefix = name[0..dot];
+        if (trunk_exl3.trunkSplitForPrefix(prefix) == null) continue;
+        if (filter_sel) |sel| {
+            if (!prefixMatchesSelector(prefix, sel)) continue;
+        }
+        if (isTrunkExl3Suffix(name[dot + 1 ..])) {
+            try to_remove.append(gpa, name);
+            _ = idx.trunk_k2.remove(prefix);
+        }
+    }
+    for (to_remove.items) |k| _ = idx.weight_map.remove(k);
+    return to_remove.items.len;
+}
+
+pub fn expandPreset(prof: []const u8) []const u8 {
+    if (std.ascii.eqlIgnoreCase(prof, "4b6b") or std.ascii.eqlIgnoreCase(prof, "default-mixed"))
+        return "4b,o_proj=6b,kv_a=6b";
+    if (std.ascii.eqlIgnoreCase(prof, "vendor-4b"))
+        return "bf16,o_proj=4b,linear_gate=4b";
+    if (std.ascii.eqlIgnoreCase(prof, "vendor-6b"))
+        return "bf16,o_proj=6b,linear_gate=6b";
+    return prof;
+}
+
+pub fn applyOverlayAndPrune(idx: *weights.ShardIndex, io: std.Io, spec: TrunkSpec) !void {
+    const gpa = idx.gpa;
+    const a = idx.arena.allocator();
+
+    switch (spec) {
+        .force_bf16 => {
+            if (try removeMatchingExl3(idx, null) > 0) idx.trunk_tag = "force_bf16";
+            return;
+        },
+        .profile => |raw_prof| {
+            const expanded = expandPreset(raw_prof);
+            if (std.mem.indexOfScalar(u8, expanded, ',') == null and std.mem.indexOfScalar(u8, expanded, '=') == null) {
+                const chosen = try loadNamedProfileFiltered(idx, io, expanded, null);
+                idx.trunk_tag = try std.fmt.allocPrint(a, "profile:{s}", .{chosen});
+            } else {
+                var tag_buf: std.ArrayList(u8) = .empty;
+                defer tag_buf.deinit(gpa);
+                try tag_buf.appendSlice(gpa, "recipe:");
+                var tok_it = std.mem.splitScalar(u8, expanded, ',');
+                var first = true;
+                while (tok_it.next()) |raw_part| {
+                    const part = std.mem.trim(u8, raw_part, " \t");
+                    if (part.len == 0) return error.InvalidHy4TrunkRecipe;
+                    if (first and std.mem.indexOfScalar(u8, part, '=') == null) {
+                        if (isLosslessToken(part)) {
+                            _ = try removeMatchingExl3(idx, null);
+                            try tag_buf.appendSlice(gpa, "bf16");
+                        } else {
+                            const chosen = try loadNamedProfileFiltered(idx, io, part, null);
+                            try tag_buf.appendSlice(gpa, chosen);
+                        }
+                        first = false;
+                        continue;
+                    }
+                    first = false;
+                    const eq = std.mem.indexOfScalar(u8, part, '=') orelse return error.InvalidHy4TrunkRecipe;
+                    const sel = std.mem.trim(u8, part[0..eq], " \t");
+                    const tgt = std.mem.trim(u8, part[eq + 1 ..], " \t");
+                    if (sel.len == 0 or tgt.len == 0) return error.InvalidHy4TrunkRecipe;
+                    try validateSelector(sel);
+                    try tag_buf.append(gpa, ',');
+                    try tag_buf.appendSlice(gpa, sel);
+                    try tag_buf.append(gpa, '=');
+                    if (isLosslessToken(tgt)) {
+                        _ = try removeMatchingExl3(idx, sel);
+                        try tag_buf.appendSlice(gpa, "bf16");
+                    } else {
+                        _ = try removeMatchingExl3(idx, sel);
+                        const chosen = try loadNamedProfileFiltered(idx, io, tgt, sel);
+                        try tag_buf.appendSlice(gpa, chosen);
+                    }
+                }
+                idx.trunk_tag = try a.dupe(u8, tag_buf.items);
+            }
+        },
+        .auto => {},
+    }
+
+    var shadowed: std.ArrayList([]const u8) = .empty;
+    defer shadowed.deinit(gpa);
+    var saw_trunk_trellis = false;
+    var it = idx.weight_map.keyIterator();
+    while (it.next()) |kptr| {
+        const name = kptr.*;
+        if (!std.mem.endsWith(u8, name, ".trellis")) continue;
+        const prefix = name[0 .. name.len - ".trellis".len];
+        if (trunk_exl3.trunkSplitForPrefix(prefix) == null) continue;
+        saw_trunk_trellis = true;
+        var wbuf: [224]u8 = undefined;
+        const wname = std.fmt.bufPrint(&wbuf, "{s}.weight", .{prefix}) catch continue;
+        if (idx.weight_map.getKey(wname)) |existing_key| try shadowed.append(gpa, existing_key);
+    }
+    for (shadowed.items) |k| _ = idx.weight_map.remove(k);
+    if (saw_trunk_trellis and idx.trunk_tag.len == 0) idx.trunk_tag = "inline_exl3";
+}
+
+fn parseDrafterSpec(raw: []const u8) TrunkSpec {
+    const trimmed = std.mem.trim(u8, raw, " \t\r\n");
+    if (trimmed.len == 0 or std.ascii.eqlIgnoreCase(trimmed, "auto")) return .auto;
+    if (isLosslessToken(trimmed) or std.ascii.eqlIgnoreCase(trimmed, "shared")) return .force_bf16;
+    return .{ .profile = trimmed };
+}
+
+fn relPathForIdx(gpa: std.mem.Allocator, arena: std.mem.Allocator, base_dir: []const u8, target_path: []const u8) ![]const u8 {
+    const base_real = std.Io.Dir.cwd().realPathFileAlloc(std.Options.debug_io, base_dir, gpa) catch return arena.dupe(u8, target_path);
+    defer gpa.free(base_real);
+    const parent_real = std.Io.Dir.cwd().realPathFileAlloc(std.Options.debug_io, std.fs.path.dirname(target_path) orelse ".", gpa) catch return arena.dupe(u8, target_path);
+    defer gpa.free(parent_real);
+    const tgt_real = try std.fs.path.join(gpa, &.{ parent_real, std.fs.path.basename(target_path) });
+    defer gpa.free(tgt_real);
+    var b_parts: std.ArrayList([]const u8) = .empty;
+    defer b_parts.deinit(gpa);
+    var t_parts: std.ArrayList([]const u8) = .empty;
+    defer t_parts.deinit(gpa);
+    var bit = std.mem.tokenizeScalar(u8, base_real, '/');
+    while (bit.next()) |p| try b_parts.append(gpa, p);
+    var tit = std.mem.tokenizeScalar(u8, tgt_real, '/');
+    while (tit.next()) |p| try t_parts.append(gpa, p);
+    var c: usize = 0;
+    while (c < b_parts.items.len and c < t_parts.items.len and std.mem.eql(u8, b_parts.items[c], t_parts.items[c])) : (c += 1) {}
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(arena);
+    for (c..b_parts.items.len) |_| {
+        if (out.items.len > 0) try out.append(arena, '/');
+        try out.appendSlice(arena, "..");
+    }
+    for (t_parts.items[c..]) |p| {
+        if (out.items.len > 0) try out.append(arena, '/');
+        try out.appendSlice(arena, p);
+    }
+    return if (out.items.len == 0) arena.dupe(u8, ".") else out.toOwnedSlice(arena);
+}
+
+pub fn loadSidecarPath(idx: *weights.ShardIndex, io: std.Io, path: []const u8, only_dfly: bool, only_head: bool) !bool {
+    const gpa = idx.gpa;
+    const a = idx.arena.allocator();
+    if (std.mem.endsWith(u8, path, ".safetensors")) {
+        var f = st.File.openPrefixes(gpa, io, path, &.{ "model.", "lm_head." }) catch |err| switch (err) {
+            error.FileNotFound => return false,
+            else => return err,
+        };
+        defer f.close(io);
+        const shard_rel = try relPathForIdx(gpa, a, idx.dir, path);
+        var added: usize = 0;
+        for (f.names.keys()) |tname| {
+            if ((only_dfly and !std.mem.startsWith(u8, tname, "model.dfly_layers.")) or (only_head and !std.mem.startsWith(u8, tname, "lm_head."))) continue;
+            try idx.weight_map.put(a, try a.dupe(u8, tname), shard_rel);
+            added += 1;
+        }
+        return added > 0;
+    }
+
+    const idx_path = if (std.mem.endsWith(u8, path, ".json")) try gpa.dupe(u8, path) else try std.fs.path.join(gpa, &.{ path, "trunk.index.json" });
+    defer gpa.free(idx_path);
+    const dir_base = if (std.mem.endsWith(u8, path, ".json")) (std.fs.path.dirname(path) orelse ".") else path;
+
+    if (std.Io.Dir.cwd().readFileAlloc(io, idx_path, gpa, .limited(64 << 20))) |bytes| {
+        defer gpa.free(bytes);
+        const parsed = try std.json.parseFromSliceLeaky(std.json.Value, a, bytes, .{});
+        const map = try st.index.weightMap(parsed);
+        var added: usize = 0;
+        var it = map.iterator();
+        while (it.next()) |kv| {
+            const k = kv.key_ptr.*;
+            if ((only_dfly and !std.mem.startsWith(u8, k, "model.dfly_layers.")) or (only_head and !std.mem.startsWith(u8, k, "lm_head."))) continue;
+            const shard_full = try std.fs.path.join(gpa, &.{ dir_base, kv.value_ptr.string });
+            defer gpa.free(shard_full);
+            try idx.weight_map.put(a, try a.dupe(u8, k), try relPathForIdx(gpa, a, idx.dir, shard_full));
+            added += 1;
+        }
+        if (added > 0) {
+            if (parsed == .object) if (parsed.object.get("metadata")) |meta| if (meta == .object) if (meta.object.get("matrices")) |mats| if (mats == .object) {
+                var mit = mats.object.iterator();
+                while (mit.next()) |mkv| {
+                    const pfx = mkv.key_ptr.*;
+                    if ((only_dfly and !std.mem.startsWith(u8, pfx, "model.dfly_layers.")) or (only_head and !std.mem.eql(u8, pfx, "lm_head"))) continue;
+                    if (mkv.value_ptr.* == .object) if (mkv.value_ptr.object.get("k2")) |kv2| if (kv2 == .integer and kv2.integer > 0 and kv2.integer <= 16)
+                        try idx.trunk_k2.put(a, try a.dupe(u8, pfx), @intCast(kv2.integer));
+                }
+            };
+            return true;
+        }
+    } else |err| switch (err) {
+        error.FileNotFound => {},
+        else => return err,
+    }
+
+    var d = std.Io.Dir.cwd().openDir(io, dir_base, .{ .iterate = true }) catch |err| switch (err) {
+        error.FileNotFound => return false,
+        else => return err,
+    };
+    defer d.close(io);
+    var added: usize = 0;
+    var dit = d.iterate();
+    while (try dit.next(io)) |entry| {
+        if ((entry.kind != .file and entry.kind != .sym_link) or !std.mem.endsWith(u8, entry.name, ".safetensors") or std.mem.startsWith(u8, entry.name, ".")) continue;
+        const shard_full = try std.fs.path.join(gpa, &.{ dir_base, entry.name });
+        defer gpa.free(shard_full);
+        var f = try st.File.openPrefixes(gpa, io, shard_full, &.{ "model.", "lm_head." });
+        defer f.close(io);
+        const shard_rel = try relPathForIdx(gpa, a, idx.dir, shard_full);
+        for (f.names.keys()) |tname| {
+            if ((only_dfly and !std.mem.startsWith(u8, tname, "model.dfly_layers.")) or (only_head and !std.mem.startsWith(u8, tname, "lm_head."))) continue;
+            try idx.weight_map.put(a, try a.dupe(u8, tname), shard_rel);
+            added += 1;
+        }
+    }
+    return added > 0;
+}
+
+pub var last_drafter_refusal_buf: [320]u8 = undefined;
+pub var last_drafter_refusal_len: usize = 0;
+pub fn lastDrafterRefusal() []const u8 { return last_drafter_refusal_buf[0..last_drafter_refusal_len]; }
+
+fn refuseDrafter(comptime fmt: []const u8, args: anytype, err: anyerror) anyerror {
+    const msg = std.fmt.bufPrint(&last_drafter_refusal_buf, "hy4 drafter: " ++ fmt, args) catch "hy4 drafter: invalid sidecar configuration";
+    last_drafter_refusal_len = msg.len;
+    if (!@import("builtin").is_test) std.log.err("{s}", .{msg});
+    return err;
+}
+
+fn resolveAndLoadSidecar(idx: *weights.ShardIndex, io: std.Io, fallback_dir: []const u8, env_name: []const u8, raw_spec: []const u8, only_dfly: bool, only_head: bool) ![]const u8 {
+    const gpa = idx.gpa;
+    const a = idx.arena.allocator();
+    var req_k2: ?u8 = null;
+    var req_lbl: []const u8 = "";
+    var raw = raw_spec;
+    if (std.mem.indexOfAny(u8, raw_spec, "=:")) |sep| {
+        req_lbl = std.mem.trim(u8, raw_spec[0..sep], " \t");
+        raw = std.mem.trim(u8, raw_spec[sep + 1 ..], " \t");
+        req_k2 = trunk_exl3.parseHeadWidthK2(req_lbl) orelse return refuseDrafter("{s}='{s}' has invalid width '{s}'", .{ env_name, raw_spec, req_lbl }, error.TrunkBitWidthMismatch);
+        if (raw.len == 0) return refuseDrafter("{s}='{s}' is missing a sidecar path", .{ env_name, raw_spec }, error.MissingHy4TrunkProfile);
+    }
+    var chosen: ?[]const u8 = null;
+    if (try loadSidecarPath(idx, io, raw, only_dfly, only_head)) chosen = try a.dupe(u8, raw);
+    if (chosen == null) for ([_][]const u8{ idx.dir, fallback_dir }) |base| {
+        if (base.len == 0) continue;
+        const p1 = try std.fs.path.join(gpa, &.{ base, raw });
+        defer gpa.free(p1);
+        if (try loadSidecarPath(idx, io, p1, only_dfly, only_head)) { chosen = try a.dupe(u8, raw); break; }
+        if (!std.mem.startsWith(u8, raw, "trunk-")) {
+            const p2_sub = try std.fmt.allocPrint(gpa, "trunk-{s}", .{raw});
+            defer gpa.free(p2_sub);
+            const p2 = try std.fs.path.join(gpa, &.{ base, p2_sub });
+            defer gpa.free(p2);
+            if (try loadSidecarPath(idx, io, p2, only_dfly, only_head)) { chosen = try a.dupe(u8, p2_sub); break; }
+        }
+    };
+    const ok = chosen orelse return refuseDrafter("{s}='{s}' was not found in '{s}' or '{s}'", .{ env_name, raw_spec, idx.dir, fallback_dir }, error.MissingHy4TrunkProfile);
+    if (req_k2) |want| {
+        var it = idx.weight_map.iterator();
+        while (it.next()) |kv| {
+            const k = kv.key_ptr.*;
+            if (!std.mem.endsWith(u8, k, ".trellis")) continue;
+            if ((only_dfly and !std.mem.startsWith(u8, k, "model.dfly_layers.")) or (only_head and !std.mem.eql(u8, k, "lm_head.trellis"))) continue;
+            const full = try std.fs.path.join(gpa, &.{ idx.dir, kv.value_ptr.* });
+            defer gpa.free(full);
+            var f = try st.File.openPrefixes(gpa, io, full, &.{ "model.", "lm_head." });
+            defer f.close(io);
+            const e = f.names.get(k) orelse break;
+            const got_k2: u8 = @intCast((try core.exl3_layout.Group.fromShape(e.shape[0..3])).k2());
+            if (got_k2 != want) return refuseDrafter("{s}='{s}' requests {s} (k2={d}) which disagrees with sidecar '{s}' ({s}, k2={d})", .{ env_name, raw_spec, req_lbl, want, ok, trunk_exl3.k2WidthName(got_k2) orelse "exl3", got_k2 }, error.TrunkBitWidthMismatch);
+            try idx.trunk_k2.put(a, k[0 .. k.len - ".trellis".len], got_k2);
+            break;
+        }
+    }
+    return ok;
+}
+
+pub fn applyDrafterOverlays(didx: *weights.ShardIndex, io: std.Io, model_dir: []const u8, explicit_dfly_exl3: ?[]const u8, explicit_head_exl3: ?[]const u8) !void {
+    const gpa = didx.gpa;
+    const a = didx.arena.allocator();
+    const dfly_spec = parseDrafterSpec(explicit_dfly_exl3 orelse boundary.envStr("TF_HY4_DRAFTER_EXL3") orelse "");
+    const head_raw = explicit_head_exl3 orelse boundary.envStr("TF_HY4_DRAFTER_HEAD");
+    const head_spec: TrunkSpec = if (head_raw) |hr| parseDrafterSpec(hr) else .auto;
+    if (didx.pack != null and (dfly_spec != .auto or head_spec != .auto))
+        return refuseDrafter("--model '{s}' is a per-rank pack while TF_HY4_DRAFTER_EXL3/HEAD is set; pass --drafter DRAFTER_DIR for a separate drafter index", .{didx.dir}, error.Hy4PackMix);
+
+    var tag_parts: std.ArrayList(u8) = .empty;
+    defer tag_parts.deinit(gpa);
+
+    switch (dfly_spec) {
+        .force_bf16 => {
+            var rem: std.ArrayList([]const u8) = .empty;
+            defer rem.deinit(gpa);
+            var it = didx.weight_map.keyIterator();
+            while (it.next()) |kptr| {
+                const name = kptr.*;
+                const dot = std.mem.lastIndexOfScalar(u8, name, '.') orelse continue;
+                if (std.mem.startsWith(u8, name, "model.dfly_layers.") and trunk_exl3.drafterOrHeadSplitForPrefix(name[0..dot]) != null and isTrunkExl3Suffix(name[dot + 1 ..])) {
+                    try rem.append(gpa, name);
+                    _ = didx.trunk_k2.remove(name[0..dot]);
+                }
+            }
+            for (rem.items) |k| _ = didx.weight_map.remove(k);
+            try tag_parts.appendSlice(gpa, "dfly:bf16");
+        },
+        .profile => |prof| {
+            try tag_parts.print(gpa, "dfly:{s}", .{try resolveAndLoadSidecar(didx, io, model_dir, "TF_HY4_DRAFTER_EXL3", prof, true, false)});
+            if (head_raw == null) _ = resolveAndLoadSidecar(didx, io, model_dir, "TF_HY4_DRAFTER_HEAD", prof, false, true) catch {};
+        },
+        .auto => {},
+    }
+
+    switch (head_spec) {
+        .force_bf16 => {
+            var rem: std.ArrayList([]const u8) = .empty;
+            defer rem.deinit(gpa);
+            var it = didx.weight_map.keyIterator();
+            while (it.next()) |kptr| if (std.mem.startsWith(u8, kptr.*, "lm_head.")) try rem.append(gpa, kptr.*);
+            for (rem.items) |k| _ = didx.weight_map.remove(k);
+            _ = didx.trunk_k2.remove("lm_head");
+            if (tag_parts.items.len > 0) try tag_parts.append(gpa, ';');
+            try tag_parts.appendSlice(gpa, "head:shared");
+        },
+        .profile => |prof| {
+            const chosen = try resolveAndLoadSidecar(didx, io, model_dir, "TF_HY4_DRAFTER_HEAD", prof, false, true);
+            if (tag_parts.items.len > 0) try tag_parts.append(gpa, ';');
+            try tag_parts.print(gpa, "head:{s}", .{chosen});
+        },
+        .auto => {},
+    }
+
+    var shadowed: std.ArrayList([]const u8) = .empty;
+    defer shadowed.deinit(gpa);
+    var saw = false;
+    var it = didx.weight_map.keyIterator();
+    while (it.next()) |kptr| {
+        const name = kptr.*;
+        if (!std.mem.endsWith(u8, name, ".trellis")) continue;
+        const prefix = name[0 .. name.len - ".trellis".len];
+        if (trunk_exl3.drafterOrHeadSplitForPrefix(prefix) == null) continue;
+        saw = true;
+        var wbuf: [224]u8 = undefined;
+        const wname = std.fmt.bufPrint(&wbuf, "{s}.weight", .{prefix}) catch continue;
+        if (didx.weight_map.getKey(wname)) |existing_key| try shadowed.append(gpa, existing_key);
+    }
+    for (shadowed.items) |k| _ = didx.weight_map.remove(k);
+    if (tag_parts.items.len > 0) didx.trunk_tag = try a.dupe(u8, tag_parts.items) else if (saw and didx.trunk_tag.len == 0) didx.trunk_tag = "dfly:inline_exl3";
+}
diff --git a/zig/src/families/hy4/trunk_exl3_replay.zig b/zig/src/families/hy4/trunk_exl3_replay.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f6651b0c26438d5651763c6957af1ade0088df45
--- /dev/null
+++ b/zig/src/families/hy4/trunk_exl3_replay.zig
@@ -0,0 +1,576 @@
+//! Single-GPU four-slice sequential replay (`--tp4-slice-replay`) for Full Hy4 quantized and lossless trunks.
+//!
+//! Executes the exact four `Rank` slices (`0, 1, 2, 3`) on one GPU, accumulates `[4, rows, 6144]` FP32 branch
+//! planes in rank order, and calls `cuda.hy4_ops.foldRank4` + `boundary.interleaveVocabStripes` to produce a
+//! deterministic single-GPU reference for four-process `TP=4` runs.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const config = @import("config.zig");
+const ranks = @import("ranks.zig");
+const boundary = @import("boundary.zig");
+const weights = @import("weights.zig");
+const cache = @import("cache.zig");
+const forward = @import("forward.zig");
+const moe_forward = @import("moe_forward.zig");
+const dump_oracle = @import("dump_oracle.zig");
+const trunk_exl3 = @import("trunk_exl3.zig");
+
+const htp = cuda.hy4_tp;
+const Uploader = cuda.exl3_upload.Uploader;
+
+fn copy2d(rt: *forward.Runtime, dst: u64, dst_pitch: usize, src: u64, src_pitch: usize, width: usize, rows: usize) !void {
+    return rt.copy2dAsync(dst, dst_pitch, src, src_pitch, width, rows);
+}
+
+fn storeRankPlane(rt: *forward.Runtime, gathered_ptr: u64, rk: usize, rows: usize, h: usize, partial_ptr: u64) !void {
+    const plane_elems = rows * htp.hidden;
+    const dst_plane = gathered_ptr + rk * plane_elems * 4;
+    if (h == htp.hidden) {
+        const view: cuda.DeviceBuffer = .{ .d = rt.d, .ptr = dst_plane, .len = plane_elems * 4, .borrowed = true };
+        try view.copyFrom(0, partial_ptr, plane_elems * 4, rt.stream.handle);
+        return;
+    }
+    const zero_view: cuda.DeviceBuffer = .{ .d = rt.d, .ptr = dst_plane, .len = plane_elems * 4, .borrowed = true };
+    try zero_view.fill8(0, rt.stream.handle);
+    try copy2d(rt, dst_plane, htp.hidden * 4, partial_ptr, h * 4, h * 4, rows);
+}
+
+fn runLocalSparseFfnPartial(
+    rt: *forward.Runtime,
+    sc: *forward.Scratch,
+    t: config.Text,
+    lw: *const weights.LayerWeights,
+    rows: usize,
+    dst_partial_f32: u64,
+    cap: ?forward.LayerCaptureHost,
+) !void {
+    const h: usize = t.hidden_size;
+    switch (lw.mlp) {
+        .dense => |dn| try forward.runDensePartialF32(rt, sc, dn, rows, dst_partial_f32),
+        .sparse_bf16 => |sp| {
+            try moe_forward.runSparseBf16(rt, sc, t, sp, rows, null, cap);
+            // Recompute exact FP32 sum before BF16 cast (`routed_f32` holds routed FP32; rerun shared into `tp_partial`).
+            try forward.runDensePartialF32(rt, sc, sp.shared, rows, sc.tp_partial.ptr);
+            try cuda.hy4_ops.addExpertPartial(&rt.ops, rt.stream, sc.routed_f32.ptr, sc.tp_partial.ptr, dst_partial_f32, rows * h);
+        },
+        .sparse_exl3 => |sp| {
+            const r_dims = sp.exl3_layer.dims;
+            const top_k: usize = t.num_experts_per_tok;
+            const x_ptr = if (r_dims == h) sc.hidden.ptr else blk: {
+                try sc.ensurePadScratch(rows * r_dims * 2);
+                const sub: cuda.DeviceBuffer = .{ .d = rt.d, .ptr = sc.pad_in.ptr, .len = rows * r_dims * 2, .borrowed = true };
+                try sub.fill8(0, rt.stream.handle);
+                try copy2d(rt, sc.pad_in.ptr, r_dims * 2, sc.hidden.ptr, h * 2, h * 2, rows);
+                break :blk sc.pad_in.ptr;
+            };
+            if (sp.router_f32 != 0) {
+                try forward.routeF32LogitsAndTopk(rt, sc, x_ptr, sp.router_f32, sp.correction_bias, rows, r_dims, t.n_routed_experts, top_k, t.norm_topk_prob, t.routed_scaling_factor);
+                const chunk_cap: usize = if (rows > 1024) 1024 else rows;
+                try sc.ensureAuxScratch(@as(usize, @max(try cuda.exl3_experts.scratchBytes(sp.exl3_layer, chunk_cap, top_k), @as(usize, 256))));
+                var first: usize = 0;
+                while (first < rows) {
+                    const cur: usize = @min(chunk_cap, rows - first);
+                    const work = try cuda.exl3_experts.scratch(sc.aux_scratch.ptr, sp.exl3_layer, cur, top_k);
+                    try rt.ops.experts.run(
+                        rt.stream, sp.exl3_layer, x_ptr + first * r_dims * 2, r_dims, .bf16,
+                        sc.router_ids.ptr + first * top_k * 4, sc.router_weights.ptr + first * top_k * 4,
+                        cur, sc.routed_f32.ptr + first * r_dims * 4, work,
+                    );
+                    first += cur;
+                }
+            } else {
+                const r_shape: cuda.hy4_ops.RoutedShape = .{
+                    .rows = @intCast(rows), .top_k = t.num_experts_per_tok,
+                    .x_row_stride = @intCast(r_dims), .output_row_stride = @intCast(r_dims),
+                    .route_scale = t.routed_scaling_factor,
+                };
+                try sc.ensureAuxScratch(@as(usize, @max(try cuda.hy4_ops.routedScratchBytes(r_shape, sp.exl3_layer), @as(usize, 256))));
+                try cuda.hy4_ops.routedExperts(&rt.ops, rt.stream, r_shape, .{
+                    .layer = sp.exl3_layer, .x = x_ptr, .router = sp.router_bf16,
+                    .correction_bias = sp.correction_bias, .ids = sc.router_ids.ptr,
+                    .weights = sc.router_weights.ptr, .output = sc.routed_f32.ptr,
+                    .scratch = sc.aux_scratch.ptr, .scratch_bytes = sc.aux_scratch.len,
+                });
+            }
+            const f32_src = if (r_dims == h) sc.routed_f32.ptr else blk: {
+                try copy2d(rt, sc.f32_in.ptr, h * 4, sc.routed_f32.ptr, r_dims * 4, h * 4, rows);
+                break :blk sc.f32_in.ptr;
+            };
+            try forward.runDensePartialF32(rt, sc, sp.shared, rows, sc.shared_f32.ptr);
+            try cuda.hy4_ops.addExpertPartial(&rt.ops, rt.stream, f32_src, sc.shared_f32.ptr, dst_partial_f32, rows * h);
+            if (cap) |c| {
+                try rt.stream.synchronize();
+                if (c.router_ids) |dst| try cuda.memory.download(rt.d, sc.router_ids.ptr, std.mem.sliceAsBytes(dst));
+                if (c.router_weights) |dst| try cuda.memory.download(rt.d, sc.router_weights.ptr, std.mem.sliceAsBytes(dst));
+            }
+        },
+    }
+}
+
+/// Runs one layer across all 4 `Rank` slices (`0, 1, 2, 3`) sequentially on one GPU and folds via `foldRank4`.
+pub fn forwardLayerFourSliceReplay(
+    rt: *forward.Runtime,
+    sc: *forward.Scratch,
+    t: config.Text,
+    idx: *const weights.ShardIndex,
+    io: std.Io,
+    layer_idx: usize,
+    first_pos: usize,
+    rows: usize,
+    lc: forward.LayerCache,
+    active_indices: ?*?[]i32,
+    active_k: *usize,
+    forced_full_indices: ?[]const i32,
+    cap: ?forward.LayerCaptureHost,
+) !void {
+    const gpa = rt.gpa;
+    const h: usize = t.hidden_size;
+    const total_seq = first_pos + rows;
+    if (rows == 0 or rows > sc.max_rows or total_seq > lc.capacity) return error.BadHy4PassRows;
+
+    var up: Uploader = .{ .d = rt.d, .gpa = gpa, .max_buffers = 1 << 17, .slab = 64 << 20 };
+    defer up.deinit();
+
+    var r_layers: [htp.world]weights.LayerWeights = undefined;
+    var loaded_r: usize = 0;
+    defer for (r_layers[0..loaded_r]) |*lw| lw.deinitHost(gpa);
+    for (0..htp.world) |rk| {
+        var sess = weights.ShardSession.initWithRank(idx, io, try ranks.Rank.init(rk, htp.world));
+        defer sess.close();
+        r_layers[rk] = try weights.loadLayerSession(&sess, gpa, &up, layer_idx);
+        loaded_r += 1;
+        try trunk_exl3.reserveLayer(&rt.short_trunk, &rt.exl3_dense, rt.stream, &rt.ops, &r_layers[rk]);
+    }
+
+    const lw0 = &r_layers[0];
+    if (cap) |c| if (c.streams_in) |dst| {
+        try rt.stream.synchronize();
+        try cuda.memory.download(rt.d, sc.streams_a.ptr, dst);
+    };
+
+    const ihc_shape: cuda.hy4_ops.IhcShape = .{ .rows = @intCast(rows), .width = t.hidden_size, .rms_eps = t.rms_norm_eps, .hc_eps = t.hc_eps, .magnitude = t.hc_magnitude };
+    try cuda.hy4_ops.ihcRead(&rt.ops, rt.stream, ihc_shape, .{
+        .streams = sc.streams_a.ptr, .projection = lw0.attn_hc.fn_ptr, .base = lw0.attn_hc.base_ptr,
+        .scale = lw0.attn_hc.scale_ptr, .output = sc.collapsed.ptr, .post = sc.post.ptr,
+    });
+    try rt.runRmsNorm(sc, sc.collapsed.ptr, lw0.input_norm, sc.hidden.ptr, rows, t.rms_norm_eps);
+    try rt.runProj(sc, sc.hidden.ptr, lw0.q_a, sc.q_raw.ptr, rows, false);
+    try rt.runRmsNorm(sc, sc.q_raw.ptr, lw0.q_a_norm, sc.q_resid.ptr, rows, t.rms_norm_eps);
+    try rt.runProj(sc, sc.hidden.ptr, lw0.kv_a, sc.kv.ptr, rows, true);
+
+    const avail_keys = cache.availableKeys(first_pos, rows, lc.has_prefix);
+    const k_eff = cache.selectionWidth(t.index_topk, first_pos, rows, lc.has_prefix);
+    var use_indices: u64 = 0;
+    var key_count: usize = total_seq;
+
+    switch (t.indexer_types[layer_idx]) {
+        .full => {
+            const ix = lw0.indexer orelse return error.MissingIndexerWeights;
+            if (forced_full_indices) |forced| {
+                if (forced.len != rows * k_eff) return error.BadForcedIndices;
+                try sc.indices_buf.uploadAsync(0, std.mem.sliceAsBytes(forced), rt.stream.handle);
+                use_indices = sc.indices_buf.ptr;
+                key_count = k_eff;
+                if (active_indices) |slot| try cache.saveActiveIndices(gpa, slot, forced);
+                active_k.* = k_eff;
+                if (cap) |c| if (c.index_positions) |dst| @memcpy(dst, forced);
+            } else {
+                const idx_shape: cuda.hy4_ops.IndexShape = .{
+                    .rows = @intCast(rows), .first_pos = @intCast(first_pos), .capacity = @intCast(lc.capacity),
+                    .top_k = @intCast(k_eff), .width = t.hidden_size, .q_rank = t.q_lora_rank,
+                    .heads = t.index_n_heads, .dim = t.index_head_dim, .rope = t.qk_rope_head_dim,
+                    .x_row_stride = t.hidden_size, .q_row_stride = t.q_lora_rank,
+                    .cache_stride = t.index_head_dim, .indices_stride = @intCast(k_eff),
+                    .theta = t.rope_parameters.rope_theta, .norm_eps = t.rms_norm_eps,
+                };
+                if (cuda.hy4_ops.indexScratchBytes(idx_shape)) |idx_sc_bytes| {
+                    const extra_8k: usize = if (rows == 1) (8192 - 2048) * 4 else 0;
+                    try sc.ensureAuxScratch(@as(usize, @max(idx_sc_bytes + extra_8k, @as(usize, 256))));
+                    const idx_bufs: cuda.hy4_ops.IndexBuffers = .{
+                        .q_resid = sc.q_resid.ptr, .x = sc.hidden.ptr, .wq_b = ix.wq_b, .wk = ix.wk,
+                        .k_norm = ix.k_norm_weight, .k_bias = ix.k_norm_bias, .weights_proj = ix.weights_proj,
+                        .cache = lc.index_ptr, .indices = sc.indices_buf.ptr,
+                        .scratch = sc.aux_scratch.ptr, .scratch_bytes = sc.aux_scratch.len,
+                    };
+                    if (!lc.has_prefix and first_pos > 0)
+                        try cuda.hy4_ops.selectTokensWindow(&rt.ops, rt.stream, idx_shape, idx_bufs, @intCast(first_pos))
+                    else
+                        try cuda.hy4_ops.selectTokens(&rt.ops, rt.stream, idx_shape, idx_bufs);
+                    use_indices = sc.indices_buf.ptr; key_count = k_eff; active_k.* = k_eff;
+                    if (active_indices != null or (cap != null and cap.?.index_positions != null)) {
+                        const host_idx = try gpa.alloc(i32, rows * k_eff); defer gpa.free(host_idx);
+                        try rt.stream.synchronize();
+                        try cuda.memory.download(rt.d, sc.indices_buf.ptr, std.mem.sliceAsBytes(host_idx));
+                        if (active_indices) |slot| try cache.saveActiveIndices(gpa, slot, host_idx);
+                        if (cap) |c| if (c.index_positions) |dst| @memcpy(dst, host_idx);
+                    }
+                } else |err| {
+                    if (err != error.Hy4KernelNotImplemented or avail_keys > t.index_topk) return err;
+                    const canon = try gpa.alloc(i32, rows * k_eff); defer gpa.free(canon);
+                    if (!lc.has_prefix and first_pos > 0) {
+                        try dump_oracle.fillCanonicalCausalIndices(canon, 0, rows, k_eff);
+                        const bias: i32 = @intCast(first_pos);
+                        for (canon) |*v| if (v.* >= 0) { v.* += bias; };
+                    } else try dump_oracle.fillCanonicalCausalIndices(canon, first_pos, rows, k_eff);
+                    try sc.indices_buf.uploadAsync(0, std.mem.sliceAsBytes(canon), rt.stream.handle);
+                    use_indices = sc.indices_buf.ptr; key_count = k_eff;
+                    if (active_indices) |slot| try cache.saveActiveIndices(gpa, slot, canon);
+                    active_k.* = k_eff;
+                    if (cap) |c| if (c.index_positions) |dst| @memcpy(dst, canon);
+                }
+            }
+        },
+        .shared => {
+            const slot = active_indices orelse return error.MissingSharedTopkIndices;
+            const shared_idx = slot.* orelse return error.MissingSharedTopkIndices;
+            if (shared_idx.len != rows * active_k.*) return error.BadSharedTopkIndices;
+            try sc.indices_buf.uploadAsync(0, std.mem.sliceAsBytes(shared_idx), rt.stream.handle);
+            use_indices = sc.indices_buf.ptr; key_count = active_k.*;
+            if (cap) |c| if (c.index_positions) |dst| @memcpy(dst, shared_idx);
+        },
+    }
+
+    const ls0 = try ranks.LocalShape.forText(t, try ranks.Rank.init(0, htp.world));
+    const cache_start: usize = if (!lc.has_prefix and first_pos > 0) first_pos else 0;
+    const eff_keys: usize = if (use_indices != 0) key_count else first_pos + rows - cache_start;
+    const mla_shape: cuda.hy4_ops.MlaShape = .{
+        .rows = @intCast(rows), .heads = ls0.heads, .capacity = @intCast(lc.capacity),
+        .key_count = @intCast(@as(usize, @max(eff_keys, @as(usize, 1)))), .first_pos = @intCast(first_pos),
+        .latent = t.kv_lora_rank, .nope = t.qk_nope_head_dim, .rope = t.qk_rope_head_dim, .value = t.v_head_dim,
+        .kv_row_stride = lw0.kv_a.kvRowStride(), .theta = t.rope_parameters.rope_theta, .rms_eps = t.rms_norm_eps,
+    };
+    try sc.ensureMlaScratch(try cuda.hy4_ops.scratchBytes(mla_shape));
+
+    for (0..htp.world) |rk| {
+        const lwr = &r_layers[rk];
+        try rt.runProj(sc, sc.q_resid.ptr, lwr.q_b, sc.q.ptr, rows, false);
+        try rt.runProj(sc, sc.hidden.ptr, lwr.linear_gate, sc.gate.ptr, rows, false);
+        try cuda.hy4_ops.mlaProject(&rt.ops, rt.stream, mla_shape, .{
+            .q = sc.q.ptr, .kv = sc.kv.ptr, .kv_norm = lwr.kv_a_norm_bf16,
+            .kv_b = lwr.kv_b, .absorbed_q = sc.absorbed_q.ptr, .cache = lc.kv_ptr,
+        });
+        try cuda.hy4_ops.mlaAttendWindow(&rt.ops, rt.stream, mla_shape, .{
+            .absorbed_q = sc.absorbed_q.ptr, .cache = lc.kv_ptr, .kv_b = lwr.kv_b,
+            .gate = sc.gate.ptr, .sinks = lwr.sinks, .indices = use_indices,
+            .scratch = sc.mla_scratch.ptr, .scratch_bytes = sc.mla_scratch.len, .output = sc.gated_values.ptr,
+        }, @intCast(cache_start));
+        try rt.runProjRowPartialF32(sc, sc.gated_values.ptr, lwr.o_proj, sc.tp_partial.ptr, rows);
+        try storeRankPlane(rt, sc.tp_gathered.ptr, rk, rows, h, sc.tp_partial.ptr);
+    }
+    try cuda.hy4_ops.foldRank4(&rt.ops, rt.stream, sc.tp_gathered.ptr, sc.branch.ptr, rows * htp.hidden);
+    if (cap) |c| if (c.attention_out) |dst| {
+        try rt.stream.synchronize();
+        try cuda.memory.download(rt.d, sc.branch.ptr, dst);
+    };
+
+    try cuda.hy4_ops.ihcWrite(&rt.ops, rt.stream, ihc_shape, .{
+        .residual = sc.streams_a.ptr, .branch = sc.branch.ptr, .post = sc.post.ptr, .output = sc.streams_b.ptr,
+    });
+    try cuda.hy4_ops.ihcRead(&rt.ops, rt.stream, ihc_shape, .{
+        .streams = sc.streams_b.ptr, .projection = lw0.ffn_hc.fn_ptr, .base = lw0.ffn_hc.base_ptr,
+        .scale = lw0.ffn_hc.scale_ptr, .output = sc.collapsed.ptr, .post = sc.post.ptr,
+    });
+    try rt.runRmsNorm(sc, sc.collapsed.ptr, lw0.post_attn_norm, sc.hidden.ptr, rows, t.rms_norm_eps);
+
+    for (0..htp.world) |rk| {
+        sc.rank = try ranks.Rank.init(rk, htp.world);
+        try runLocalSparseFfnPartial(rt, sc, t, &r_layers[rk], rows, sc.tp_partial.ptr, if (rk == 0) cap else null);
+        try storeRankPlane(rt, sc.tp_gathered.ptr, rk, rows, h, sc.tp_partial.ptr);
+    }
+    sc.rank = try ranks.Rank.init(0, htp.world);
+    try cuda.hy4_ops.foldRank4(&rt.ops, rt.stream, sc.tp_gathered.ptr, sc.branch.ptr, rows * htp.hidden);
+    if (cap) |c| {
+        const ffn_dst = if (lw0.mlp == .dense) c.dense_out else c.moe_out;
+        if (ffn_dst) |dst| {
+            try rt.stream.synchronize();
+            try cuda.memory.download(rt.d, sc.branch.ptr, dst);
+        }
+    }
+
+    try cuda.hy4_ops.ihcWrite(&rt.ops, rt.stream, ihc_shape, .{
+        .residual = sc.streams_b.ptr, .branch = sc.branch.ptr, .post = sc.post.ptr, .output = sc.streams_a.ptr,
+    });
+    if (cap) |c| if (c.streams_out) |dst| {
+        try rt.stream.synchronize();
+        try cuda.memory.download(rt.d, sc.streams_a.ptr, dst);
+    };
+}
+
+pub fn forwardHeadFourSliceReplay(
+    rt: *forward.Runtime,
+    sc: *forward.Scratch,
+    t: config.Text,
+    idx: *const weights.ShardIndex,
+    io: std.Io,
+    streams_ptr: u64,
+    rows: usize,
+    logits_out: []u8,
+) !void {
+    if (logits_out.len != rows * t.vocab_size * 4) return error.BadOracleShape;
+    var up: Uploader = .{ .d = rt.d, .gpa = rt.gpa, .max_buffers = 128, .slab = 64 << 20 };
+    defer up.deinit();
+
+    const ls0 = try ranks.LocalShape.forText(t, try ranks.Rank.init(0, htp.world));
+    const stripe_bytes = rows * ls0.vocab_stride * 4;
+    const all_stripes = try rt.gpa.alloc(u8, htp.world * stripe_bytes);
+    defer rt.gpa.free(all_stripes);
+
+    for (0..htp.world) |rk| {
+        up.rollback(0);
+        var sess = weights.ShardSession.initWithRank(idx, io, try ranks.Rank.init(rk, htp.world));
+        defer sess.close();
+        const hd = try weights.loadHeadSession(&sess, rt.gpa, &up);
+        if (hd.lm_head_exl3) |ex| try trunk_exl3.reserveProj(&rt.short_trunk, &rt.exl3_dense, rt.stream, .{ .exl3 = ex });
+        const ptr = try forward.forwardHeadDevice(rt, sc, t, hd, streams_ptr, rows);
+        try rt.stream.synchronize();
+        try cuda.memory.download(rt.d, ptr, all_stripes[rk * stripe_bytes ..][0..stripe_bytes]);
+    }
+    const views: [htp.world][]const u8 = .{
+        all_stripes[0 * stripe_bytes ..][0..stripe_bytes],
+        all_stripes[1 * stripe_bytes ..][0..stripe_bytes],
+        all_stripes[2 * stripe_bytes ..][0..stripe_bytes],
+        all_stripes[3 * stripe_bytes ..][0..stripe_bytes],
+    };
+    const out_f32: []f32 = @alignCast(std.mem.bytesAsSlice(f32, logits_out));
+    try boundary.interleaveVocabStripes(&views, rows, ls0.vocab_stride, t.vocab_size, out_f32);
+}
+
+pub fn runReplayFourSliceToDump(
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    rt: *forward.Runtime,
+    idx: *const weights.ShardIndex,
+    start_layer: usize,
+    end_layer: usize,
+    inputs_path: []const u8,
+    forced_indices_path: ?[]const u8,
+    with_head: bool,
+    dump_shared_indices: bool,
+    mem_floor_gib: usize,
+    memFloorCheck: *const fn (usize) anyerror!void,
+    dump: *dump_oracle.Dump,
+) !void {
+    const t = idx.cfg.value.text_config;
+    if (start_layer > end_layer or end_layer >= t.num_hidden_layers) return error.BadLayerIndex;
+    const h: usize = t.hidden_size;
+    const k_top: usize = t.num_experts_per_tok;
+
+    var replay = try dump_oracle.ReplayInputs.load(gpa, io, inputs_path, 4, h, t.max_position_embeddings, t.index_topk, t.indexer_types[start_layer] == .shared);
+    defer replay.deinit();
+    const batch = replay.batch;
+    const seq_len = replay.seq_len;
+    const cap_len = replay.max_first_pos + seq_len;
+    const k_eff = replay.topk_width;
+
+    var sc = try forward.Scratch.initWith(rt.d, t, seq_len, .{
+        .logits_rows = if (with_head) seq_len else 0,
+        .single_layer_cache_cap = cap_len,
+        .rank = try ranks.Rank.init(0, htp.world),
+    });
+    defer sc.deinit();
+
+    const cur_streams = try gpa.dupe(u8, replay.streams_bf16);
+    defer gpa.free(cur_streams);
+    const active_per_batch = try gpa.alloc(?[]i32, batch);
+    @memset(active_per_batch, null);
+    defer {
+        for (active_per_batch) |slot| if (slot) |s| gpa.free(s);
+        gpa.free(active_per_batch);
+    }
+    const active_k_per_batch = try gpa.alloc(usize, batch);
+    defer gpa.free(active_k_per_batch);
+    @memset(active_k_per_batch, 0);
+    if (t.indexer_types[start_layer] == .shared) {
+        for (0..batch) |b| {
+            const bias: i32 = @intCast(replay.first_pos[b]);
+            const dup = try gpa.dupe(i32, replay.prev_topk.?[b * seq_len * k_eff ..][0 .. seq_len * k_eff]);
+            for (dup) |*v| if (v.* >= 0) { v.* += bias; };
+            active_per_batch[b] = dup;
+            active_k_per_batch[b] = k_eff;
+        }
+    }
+
+    const s_in_all = try gpa.alloc(u8, batch * seq_len * 4 * h * 2); defer gpa.free(s_in_all);
+    const s_out_all = try gpa.alloc(u8, batch * seq_len * 4 * h * 2); defer gpa.free(s_out_all);
+    const attn_all = try gpa.alloc(u8, batch * seq_len * h * 2); defer gpa.free(attn_all);
+    const ffn_all = try gpa.alloc(u8, batch * seq_len * h * 2); defer gpa.free(ffn_all);
+    const idx_all = try gpa.alloc(i32, batch * seq_len * k_eff); defer gpa.free(idx_all);
+    const r_ids_all = try gpa.alloc(i32, batch * seq_len * @as(usize, @max(k_top, @as(usize, 1)))); defer gpa.free(r_ids_all);
+    const r_wts_all = try gpa.alloc(f32, batch * seq_len * @as(usize, @max(k_top, @as(usize, 1)))); defer gpa.free(r_wts_all);
+
+    const lc: forward.LayerCache = .{ .kv_ptr = sc.kv_cache.ptr, .index_ptr = sc.index_cache.ptr, .capacity = cap_len, .has_prefix = false };
+
+    for (start_layer..end_layer + 1) |l| {
+        try memFloorCheck(mem_floor_gib);
+        const is_full = t.indexer_types[l] == .full;
+        const is_dense = t.mlpKind(l) == .dense;
+        const record_idx = is_full or dump_shared_indices;
+        const forced_file: ?[]i32 = if (forced_indices_path != null and is_full) blk: {
+            var file = try core.safetensors.File.open(gpa, io, forced_indices_path.?);
+            defer file.close(io);
+            var kbuf: [64]u8 = undefined;
+            const key = try std.fmt.bufPrint(&kbuf, "layer.{d:0>3}.index_positions", .{l});
+            const ft = file.get(key) orelse return error.MissingForcedIndices;
+            if (!ft.is(.i32, &.{ batch, seq_len, k_eff })) return error.BadForcedIndices;
+            const out = try gpa.alloc(i32, batch * seq_len * k_eff);
+            for (out, 0..) |*dst, j| dst.* = std.mem.readInt(i32, ft.bytes[j * 4 ..][0..4], .little);
+            break :blk out;
+        } else null;
+        defer if (forced_file) |f| gpa.free(f);
+
+        for (0..batch) |b| {
+            const fp_b = replay.first_pos[b];
+            const bias_b: i32 = @intCast(fp_b);
+            var local_forced: ?[]i32 = null;
+            defer if (local_forced) |lf| gpa.free(lf);
+            if (forced_file) |ff| {
+                const f_b = try gpa.dupe(i32, ff[b * seq_len * k_eff ..][0 .. seq_len * k_eff]);
+                for (f_b) |*v| if (v.* >= 0) { v.* += bias_b; };
+                local_forced = f_b;
+            }
+            const s_slice = cur_streams[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2];
+            try sc.streams_a.uploadAsync(0, s_slice, rt.stream.handle);
+            try sc.kv_cache.fill8(0, rt.stream.handle);
+            try sc.index_cache.fill8(0, rt.stream.handle);
+            try forwardLayerFourSliceReplay(rt, &sc, t, idx, io, l, fp_b, seq_len, lc, &active_per_batch[b], &active_k_per_batch[b], local_forced, .{
+                .streams_in = s_in_all[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2],
+                .attention_out = attn_all[b * seq_len * h * 2 ..][0 .. seq_len * h * 2],
+                .index_positions = if (record_idx) idx_all[b * seq_len * k_eff ..][0 .. seq_len * k_eff] else null,
+                .dense_out = if (is_dense) ffn_all[b * seq_len * h * 2 ..][0 .. seq_len * h * 2] else null,
+                .router_ids = if (!is_dense) r_ids_all[b * seq_len * k_top ..][0 .. seq_len * k_top] else null,
+                .router_weights = if (!is_dense) r_wts_all[b * seq_len * k_top ..][0 .. seq_len * k_top] else null,
+                .moe_out = if (!is_dense) ffn_all[b * seq_len * h * 2 ..][0 .. seq_len * h * 2] else null,
+                .streams_out = s_out_all[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2],
+            });
+            if (record_idx and bias_b > 0) for (idx_all[b * seq_len * k_eff ..][0 .. seq_len * k_eff]) |*v| if (v.* >= bias_b) { v.* -= bias_b; };
+            @memcpy(s_slice, s_out_all[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2]);
+        }
+
+        try dump.recordStreams(l, false, s_in_all, batch, seq_len, 4, h);
+        try dump.recordLayerBf16(l, "attention_out", attn_all, batch, seq_len, h);
+        if (record_idx) try dump.recordIndexPositions(l, idx_all, batch, seq_len, k_eff, 0);
+        if (is_dense) try dump.recordLayerBf16(l, "dense_out", ffn_all, batch, seq_len, h) else {
+            try dump.recordRouter(l, r_ids_all[0 .. batch * seq_len * k_top], r_wts_all[0 .. batch * seq_len * k_top], batch, seq_len, k_top);
+            try dump.recordLayerBf16(l, "moe_out", ffn_all, batch, seq_len, h);
+        }
+        try dump.recordStreams(l, true, s_out_all, batch, seq_len, 4, h);
+    }
+
+    if (with_head) {
+        try memFloorCheck(mem_floor_gib);
+        const logits_bytes = try gpa.alloc(u8, batch * seq_len * t.vocab_size * 4);
+        defer gpa.free(logits_bytes);
+        for (0..batch) |b| {
+            try sc.streams_a.uploadAsync(0, cur_streams[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2], rt.stream.handle);
+            try forwardHeadFourSliceReplay(rt, &sc, t, idx, io, sc.streams_a.ptr, seq_len, logits_bytes[b * seq_len * t.vocab_size * 4 ..][0 .. seq_len * t.vocab_size * 4]);
+        }
+        try dump.recordLogits(logits_bytes, batch, seq_len, t.vocab_size);
+    }
+}
+
+pub fn runPromptFourSliceToDump(
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    rt: *forward.Runtime,
+    idx: *const weights.ShardIndex,
+    prompt: dump_oracle.PromptTokens,
+    max_layers: ?usize,
+    skip_head: bool,
+    mem_floor_gib: usize,
+    memFloorCheck: *const fn (usize) anyerror!void,
+    dump: *dump_oracle.Dump,
+) !void {
+    const t = idx.cfg.value.text_config;
+    try dump_oracle.validateTokenIds(prompt.ids, t.vocab_size);
+    const h: usize = t.hidden_size;
+    const batch = prompt.batch;
+    const seq_len = prompt.seq_len;
+    const layer_limit: usize = @min(max_layers orelse @as(usize, t.num_hidden_layers), @as(usize, t.num_hidden_layers));
+    const k_eff: usize = @min(@as(usize, t.index_topk), seq_len);
+    const k_top: usize = t.num_experts_per_tok;
+
+    try dump.recordInputIds(prompt.ids, batch, seq_len);
+    var sc = try forward.Scratch.initWith(rt.d, t, seq_len, .{
+        .logits_rows = if (skip_head) 0 else seq_len,
+        .single_layer_cache_cap = seq_len,
+        .rank = try ranks.Rank.init(0, htp.world),
+    });
+    defer sc.deinit();
+
+    const cur_streams = try gpa.alloc(u8, batch * seq_len * 4 * h * 2);
+    defer gpa.free(cur_streams);
+    {
+        try memFloorCheck(mem_floor_gib);
+        var trunk_up: Uploader = .{ .d = rt.d, .gpa = gpa, .max_buffers = 64, .slab = 64 << 20 };
+        defer trunk_up.deinit();
+        const trk = try weights.loadTrunk(gpa, io, idx, &trunk_up);
+        for (0..batch) |b| {
+            try forward.embedTokens(rt, &sc, trk.embed_bf16, prompt.ids[b * seq_len ..][0..seq_len], t.vocab_size, h);
+            try rt.stream.synchronize();
+            try cuda.memory.download(rt.d, sc.streams_a.ptr, cur_streams[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2]);
+        }
+    }
+
+    const active_per_batch = try gpa.alloc(?[]i32, batch);
+    @memset(active_per_batch, null);
+    defer {
+        for (active_per_batch) |slot| if (slot) |s| gpa.free(s);
+        gpa.free(active_per_batch);
+    }
+    const active_k_per_batch = try gpa.alloc(usize, batch);
+    defer gpa.free(active_k_per_batch);
+    @memset(active_k_per_batch, 0);
+
+    const s_in_all = try gpa.alloc(u8, batch * seq_len * 4 * h * 2); defer gpa.free(s_in_all);
+    const s_out_all = try gpa.alloc(u8, batch * seq_len * 4 * h * 2); defer gpa.free(s_out_all);
+    const attn_all = try gpa.alloc(u8, batch * seq_len * h * 2); defer gpa.free(attn_all);
+    const ffn_all = try gpa.alloc(u8, batch * seq_len * h * 2); defer gpa.free(ffn_all);
+    const idx_all = try gpa.alloc(i32, batch * seq_len * k_eff); defer gpa.free(idx_all);
+    const r_ids_all = try gpa.alloc(i32, batch * seq_len * @as(usize, @max(k_top, @as(usize, 1)))); defer gpa.free(r_ids_all);
+    const r_wts_all = try gpa.alloc(f32, batch * seq_len * @as(usize, @max(k_top, @as(usize, 1)))); defer gpa.free(r_wts_all);
+
+    const lc: forward.LayerCache = .{ .kv_ptr = sc.kv_cache.ptr, .index_ptr = sc.index_cache.ptr, .capacity = seq_len, .has_prefix = false };
+
+    for (0..layer_limit) |l| {
+        try memFloorCheck(mem_floor_gib);
+        const is_dense = t.mlpKind(l) == .dense;
+        const is_full = t.indexer_types[l] == .full;
+        for (0..batch) |b| {
+            const s_slice = cur_streams[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2];
+            try sc.streams_a.uploadAsync(0, s_slice, rt.stream.handle);
+            try sc.kv_cache.fill8(0, rt.stream.handle);
+            try sc.index_cache.fill8(0, rt.stream.handle);
+            try forwardLayerFourSliceReplay(rt, &sc, t, idx, io, l, 0, seq_len, lc, &active_per_batch[b], &active_k_per_batch[b], null, .{
+                .streams_in = s_in_all[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2],
+                .attention_out = attn_all[b * seq_len * h * 2 ..][0 .. seq_len * h * 2],
+                .index_positions = if (is_full) idx_all[b * seq_len * k_eff ..][0 .. seq_len * k_eff] else null,
+                .dense_out = if (is_dense) ffn_all[b * seq_len * h * 2 ..][0 .. seq_len * h * 2] else null,
+                .router_ids = if (!is_dense) r_ids_all[b * seq_len * k_top ..][0 .. seq_len * k_top] else null,
+                .router_weights = if (!is_dense) r_wts_all[b * seq_len * k_top ..][0 .. seq_len * k_top] else null,
+                .moe_out = if (!is_dense) ffn_all[b * seq_len * h * 2 ..][0 .. seq_len * h * 2] else null,
+                .streams_out = s_out_all[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2],
+            });
+            @memcpy(s_slice, s_out_all[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2]);
+        }
+        try dump.recordStreams(l, false, s_in_all, batch, seq_len, 4, h);
+        try dump.recordLayerBf16(l, "attention_out", attn_all, batch, seq_len, h);
+        if (is_full) try dump.recordIndexPositions(l, idx_all, batch, seq_len, k_eff, 0);
+        if (is_dense) try dump.recordLayerBf16(l, "dense_out", ffn_all, batch, seq_len, h) else {
+            try dump.recordRouter(l, r_ids_all[0 .. batch * seq_len * k_top], r_wts_all[0 .. batch * seq_len * k_top], batch, seq_len, k_top);
+            try dump.recordLayerBf16(l, "moe_out", ffn_all, batch, seq_len, h);
+        }
+        try dump.recordStreams(l, true, s_out_all, batch, seq_len, 4, h);
+    }
+
+    if (!skip_head) {
+        try memFloorCheck(mem_floor_gib);
+        const logits_bytes = try gpa.alloc(u8, batch * seq_len * t.vocab_size * 4);
+        defer gpa.free(logits_bytes);
+        for (0..batch) |b| {
+            try sc.streams_a.uploadAsync(0, cur_streams[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2], rt.stream.handle);
+            try forwardHeadFourSliceReplay(rt, &sc, t, idx, io, sc.streams_a.ptr, seq_len, logits_bytes[b * seq_len * t.vocab_size * 4 ..][0 .. seq_len * t.vocab_size * 4]);
+        }
+        try dump.recordLogits(logits_bytes, batch, seq_len, t.vocab_size);
+    }
+}
diff --git a/zig/src/families/hy4/trunk_exl3_test.zig b/zig/src/families/hy4/trunk_exl3_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8a46df7f7280aa4e6742769dc551646585bc2129
