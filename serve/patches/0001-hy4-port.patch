@@ -0,0 +1,49 @@
+//! Host tests for `weights.zig` (moved out of it unchanged so the loader file stays under 600 lines).
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const weights = @import("weights.zig");
+
+const Uploader = cuda.exl3_upload.Uploader;
+const ShardIndex = weights.ShardIndex;
+const ShardSession = weights.ShardSession;
+const uploadRouterExl3 = weights.uploadRouterExl3;
+const checkLoad = weights.checkLoad;
+
+test "ShardIndex opens single-shard packs with stale index.json and preserves FP32 EXL3 router weights" {
+    const gpa = std.testing.allocator;
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const dir = try tmp.dir.realPathFileAlloc(io, ".", gpa);
+    defer gpa.free(dir);
+    try tmp.dir.writeFile(io, .{ .sub_path = "config.json", .data =
+        \\{"text_config":{"model_type":"hy_v4","hidden_size":32,"intermediate_size":64,"moe_intermediate_size":16,
+        \\"num_hidden_layers":2,"vocab_size":16,"q_lora_rank":12,"kv_lora_rank":8,"num_attention_heads":4,
+        \\"qk_nope_head_dim":10,"qk_rope_head_dim":6,"v_head_dim":16,"index_n_heads":4,"index_head_dim":16,
+        \\"index_topk":16,"indexer_types":["full","full"],"mlp_layer_types":["dense","sparse"],
+        \\"n_routed_experts":4,"num_experts_per_tok":2}}
+    });
+    const single_path = try std.fs.path.join(gpa, &.{ dir, "model.safetensors" });
+    defer gpa.free(single_path);
+    var r_f32: [16 * 8]f32 = @splat(0);
+    r_f32[7 * 8] = 1.0001; r_f32[8 * 8] = 1.0002;
+    try core.shard_edit.create(gpa, single_path, &.{}, &.{
+        .{ .name = "model.layers.1.mlp.gate.weight", .dtype = .f32, .shape = &.{ 16, 8 }, .bytes = std.mem.sliceAsBytes(&r_f32) },
+    });
+    try tmp.dir.writeFile(io, .{ .sub_path = "index.json", .data = "{\"weight_map\":{\"missing\":\"gone.safetensors\"}}" });
+    var idx = try ShardIndex.open(gpa, io, dir);
+    defer idx.deinit();
+    try std.testing.expect(idx.has("model.layers.1.mlp.gate.weight"));
+    const mock = @import("cache.zig").TestMock;
+    var d = mock.init();
+    var sess = ShardSession.init(&idx, io);
+    defer sess.close();
+    var up: Uploader = .{ .d = &d, .gpa = gpa, .max_buffers = 8 };
+    defer up.deinit();
+    const ur = try uploadRouterExl3(&sess, gpa, &up, "model.layers.1.mlp.gate.weight", 16, 8, 8);
+    try std.testing.expectEqual(@as(u64, 0), ur.bf16);
+    try std.testing.expectEqual(@as(f32, 1.0001), @as(f32, @bitCast(std.mem.readInt(u32, mock.copied[7 * 8 * 4 ..][0..4], .little))));
+    try std.testing.expectEqual(@as(f32, 1.0002), @as(f32, @bitCast(std.mem.readInt(u32, mock.copied[8 * 8 * 4 ..][0..4], .little))));
+    try std.testing.expectError(error.MissingTensor, checkLoad(gpa, io, &d, &idx, null, null, false));
+}
diff --git a/zig/src/families/hy4/window_bench.zig b/zig/src/families/hy4/window_bench.zig
new file mode 100644
index 0000000000000000000000000000000000000000..0796507698b086c48e9ea3be5302b82053629481
--- /dev/null
+++ b/zig/src/families/hy4/window_bench.zig
@@ -0,0 +1,397 @@
+//! Interleaved multi-width target verify benchmark (`--bench-window`, `--bench-widths 1,2,3,7`),
+//! per-part synchronized 4-rank decode split (`--bench-parts` across trunk, experts, attention, index, head, and TP),
+//! A/B `TF_HY4_GREEDY_FULL_GATHER=1` toggle, and live `CostParams` table calibration for adaptive draft depth.
+const std = @import("std");
+const cuda = @import("cuda");
+const boundary = @import("boundary.zig");
+const kv_pool = @import("kv_pool.zig");
+const greedy = @import("greedy.zig");
+const forward = @import("forward.zig");
+const draft_policy = @import("draft_policy.zig");
+const resident = @import("resident.zig");
+
+pub const max_sweep_widths: usize = 8;
+pub const default_sweep_widths = [_]usize{ 1, 2, 3, 7 };
+
+pub const PartBucket = enum { trunk, experts, attn, index, other_local, tp_gather };
+
+pub const PartTimers = struct {
+    trunk_ns: u64 = 0, experts_ns: u64 = 0, attn_ns: u64 = 0, index_ns: u64 = 0,
+    other_local_ns: u64 = 0, tp_gather_ns: u64 = 0, head_ns: u64 = 0, vocab_gather_ns: u64 = 0, mark_ns: u64 = 0,
+
+    pub fn add(self: *PartTimers, b: PartBucket, dt: u64) void {
+        switch (b) {
+            .trunk => self.trunk_ns += dt, .experts => self.experts_ns += dt,
+            .attn => self.attn_ns += dt, .index => self.index_ns += dt,
+            .other_local => self.other_local_ns += dt, .tp_gather => self.tp_gather_ns += dt,
+        }
+    }
+
+    pub fn totalNs(self: PartTimers) u64 {
+        return self.trunk_ns + self.experts_ns + self.attn_ns + self.index_ns +
+            self.other_local_ns + self.tp_gather_ns + self.head_ns + self.vocab_gather_ns;
+    }
+};
+
+pub const WindowSample = struct { total_ns: u64, fwd_ns: u64, head_ns: u64, gather_ns: u64 };
+
+fn nowNs(io: std.Io) u64 {
+    return @intCast(@max(@as(i128, 0), std.Io.Clock.awake.now(io).toNanoseconds()));
+}
+
+fn medianU64(gpa: std.mem.Allocator, vals: []const u64) !f64 {
+    if (vals.len == 0) return 0;
+    const cp = try gpa.dupe(u64, vals);
+    defer gpa.free(cp);
+    std.mem.sort(u64, cp, {}, std.sort.asc(u64));
+    return @as(f64, @floatFromInt(cp[cp.len / 2])) / 1e6;
+}
+
+fn minU64Ms(vals: []const u64) f64 {
+    if (vals.len == 0) return 0;
+    var best = vals[0];
+    for (vals[1..]) |v| if (v < best) { best = v; };
+    return @as(f64, @floatFromInt(best)) / 1e6;
+}
+
+fn medianI64Ms(gpa: std.mem.Allocator, vals: []const i64) !f64 {
+    if (vals.len == 0) return 0;
+    const cp = try gpa.dupe(i64, vals);
+    defer gpa.free(cp);
+    std.mem.sort(i64, cp, {}, std.sort.asc(i64));
+    return @as(f64, @floatFromInt(cp[cp.len / 2])) / 1e6;
+}
+
+pub fn parseBenchWidths(gpa: std.mem.Allocator, text: []const u8) ![]usize {
+    var list: std.ArrayList(usize) = .empty;
+    errdefer list.deinit(gpa);
+    var it = std.mem.tokenizeAny(u8, text, ", \t\r\n");
+    while (it.next()) |tok| {
+        if (list.items.len >= max_sweep_widths) return error.BadArgs;
+        const w = std.fmt.parseInt(usize, tok, 10) catch return error.BadArgs;
+        if (w == 0 or w > greedy.max_rows) return error.BadArgs;
+        try list.append(gpa, w);
+    }
+    if (list.items.len == 0) return error.BadArgs;
+    return list.toOwnedSlice(gpa);
+}
+
+fn runHeadAndGatherTimed(model: *resident.ResidentModel, hd: @TypeOf(model.head.?), rows: usize) !struct { head_ns: u64, gather_ns: u64 } {
+    const t1 = nowNs(model.io);
+    const logits = try forward.forwardHeadDeviceWithRef(&model.rt, &model.sc, model.t, hd, model.sc.streams_a.ptr, rows, 0);
+    if (boundary.envFlag("TF_HY4_GREEDY_FULL_GATHER")) {
+        if (model.tp_sess) |sess| try sess.boundary.finish(model.rt.stream) else try model.rt.stream.synchronize();
+        const tg0 = nowNs(model.io);
+        if (model.tp_sess) |tps| {
+            const local_f32 = try model.gpa.alloc(f32, rows * hd.vocab_pad);
+            defer model.gpa.free(local_f32);
+            const full_f32 = try model.gpa.alloc(f32, rows * hd.vocab_full);
+            defer model.gpa.free(full_f32);
+            try cuda.memory.download(model.rt.d, logits, std.mem.sliceAsBytes(local_f32));
+            try tps.gatherVocabLogits(model.gpa, model.rt.stream, local_f32, rows, hd.vocab_pad, hd.vocab_full, full_f32);
+            for (0..rows) |r| _ = try resident.argmaxF32(full_f32[r * hd.vocab_full ..][0..hd.vocab_full]);
+        } else {
+            const full_f32 = try model.gpa.alloc(f32, rows * hd.vocab_full);
+            defer model.gpa.free(full_f32);
+            try cuda.memory.download(model.rt.d, logits, std.mem.sliceAsBytes(full_f32));
+            for (0..rows) |r| _ = try resident.argmaxF32(full_f32[r * hd.vocab_full ..][0..hd.vocab_full]);
+        }
+        const t2 = nowNs(model.io);
+        return .{ .head_ns = tg0 -| t1, .gather_ns = t2 -| tg0 };
+    }
+    const buf = model.sc.f32_in.ptr;
+    const rank: usize = if (model.tp_sess) |sess| sess.rank_idx else 0;
+    try greedy.reduce(&model.rt.ops, model.rt.stream, logits, buf, rows, hd.vocab_pad, hd.vocab_local, rank * hd.vocab_pad);
+    if (model.tp_sess) |sess| {
+        try model.rt.stream.synchronize();
+        const tg0 = nowNs(model.io);
+        var ids: [greedy.max_rows]u32 = undefined;
+        try sess.gatherGreedyDevice(model.rt.d, model.rt.stream, buf, model.sc.f32_tmp.ptr, rows, hd.vocab_pad, hd.vocab_full, ids[0..rows]);
+        const t2 = nowNs(model.io);
+        return .{ .head_ns = tg0 -| t1, .gather_ns = t2 -| tg0 };
+    }
+    try model.rt.stream.synchronize();
+    const tg0 = nowNs(model.io);
+    var local: [greedy.max_rows]greedy.Pair = undefined;
+    var ids: [greedy.max_rows]u32 = undefined;
+    try cuda.memory.download(model.rt.d, buf, std.mem.sliceAsBytes(local[0..rows]));
+    try greedy.gather(null, local[0..rows], hd.vocab_pad, hd.vocab_full, ids[0..rows]);
+    const t2 = nowNs(model.io);
+    return .{ .head_ns = tg0 -| t1, .gather_ns = t2 -| tg0 };
+}
+
+pub fn timeDecodeWindowOnce(model: *resident.ResidentModel, pool: *kv_pool.KvPool, pos: usize, toks: []const u32) !WindowSample {
+    const hd = model.head orelse return error.HeadSkipped;
+    try pool.clearRange(model.t, pos, @min(pos + greedy.max_rows, pool.capacity), model.rt.stream.handle);
+    if (model.tp_sess) |tps| try tps.boundary.finish(model.rt.stream) else try model.rt.stream.synchronize();
+    const t0 = nowNs(model.io);
+    try model.forwardStep(pool, pos, toks);
+    if (model.tp_sess) |tps| try tps.boundary.finish(model.rt.stream) else try model.rt.stream.synchronize();
+    const fwd_ns = nowNs(model.io) -| t0;
+    const hg = try runHeadAndGatherTimed(model, hd, toks.len);
+    return .{ .total_ns = fwd_ns + hg.head_ns + hg.gather_ns, .fwd_ns = fwd_ns, .head_ns = hg.head_ns, .gather_ns = hg.gather_ns };
+}
+
+pub fn calibrateCostParams(gpa: std.mem.Allocator, model: *resident.ResidentModel, pool: *kv_pool.KvPool, pos: usize, bonus: u32) !draft_policy.CostParams {
+    const dr = &(model.drafter orelse return error.MissingDrafterWeights);
+    const anc = &(model.anchor orelse return error.MissingDrafterWeights);
+    const hd = model.head orelse return error.HeadSkipped;
+    const max_d: usize = @min(@as(usize, dr.maxProposals()), @as(usize, 7));
+    const max_w: usize = 1 + max_d;
+    var win_toks: [8]u32 = @splat(bonus);
+    var props: [16]u32 = @splat(bonus);
+
+    const saved_rows = anc.captured_rows;
+    const saved_has = anc.has_recalled;
+    const saved_rec = try gpa.dupe(i32, anc.recalled);
+    defer gpa.free(saved_rec);
+    var saved_hid = try cuda.DeviceBuffer.alloc(model.rt.d, anc.hidden_bf16.len);
+    defer saved_hid.free();
+    try saved_hid.copyFrom(0, anc.hidden_bf16.ptr, anc.hidden_bf16.len, model.rt.stream.handle);
+
+    _ = try timeDecodeWindowOnce(model, pool, pos, win_toks[0..1]);
+    _ = try timeDecodeWindowOnce(model, pool, pos, win_toks[0..max_w]);
+
+    var row_ms: [8]f64 = @splat(1.0);
+    for (1..max_w + 1) |w| {
+        const s = try timeDecodeWindowOnce(model, pool, pos, win_toks[0..w]);
+        row_ms[w - 1] = @max(0.05, @as(f64, @floatFromInt(s.total_ns)) / 1e6);
+    }
+
+    try anc.hidden_bf16.copyFrom(0, saved_hid.ptr, saved_hid.len, model.rt.stream.handle);
+    @memcpy(anc.recalled, saved_rec);
+    anc.has_recalled = saved_has;
+    anc.captured_rows = saved_rows;
+
+    _ = try dr.proposeTp(&model.rt, &model.sc, model.t, model.trunk.embed_bf16, hd, model.layers.len, pool, anc, 0, pos, bonus, 1, model.tp_sess, true, null, null, props[0..1]);
+    if (model.tp_sess) |tps| try tps.boundary.finish(model.rt.stream) else try model.rt.stream.synchronize();
+    const dt1_0 = nowNs(model.io);
+    _ = try dr.proposeTp(&model.rt, &model.sc, model.t, model.trunk.embed_bf16, hd, model.layers.len, pool, anc, 0, pos, bonus, 1, model.tp_sess, true, null, null, props[0..1]);
+    if (model.tp_sess) |tps| try tps.boundary.finish(model.rt.stream) else try model.rt.stream.synchronize();
+    var d1_ms = @max(0.05, @as(f64, @floatFromInt(nowNs(model.io) -| dt1_0)) / 1e6);
+
+    var d_each_ms: f64 = 0.2 * d1_ms;
+    if (max_d > 1) {
+        const dtm_0 = nowNs(model.io);
+        _ = try dr.proposeTp(&model.rt, &model.sc, model.t, model.trunk.embed_bf16, hd, model.layers.len, pool, anc, 0, pos, bonus, max_d, model.tp_sess, true, null, null, props[0..max_d]);
+        if (model.tp_sess) |tps| try tps.boundary.finish(model.rt.stream) else try model.rt.stream.synchronize();
+        const dmax_ms = @max(d1_ms, @as(f64, @floatFromInt(nowNs(model.io) -| dtm_0)) / 1e6);
+        d_each_ms = @max(0.02, (dmax_ms - d1_ms) / @as(f64, @floatFromInt(max_d - 1)));
+    }
+    try pool.clearRange(model.t, pos, @min(pos + 16, pool.capacity), model.rt.stream.handle);
+    try model.rt.stream.synchronize();
+
+    if (model.tp_sess) |tps| {
+        var wire: [10]u64 = @splat(0);
+        for (0..max_w) |i| wire[i] = @bitCast(draft_policy.quantizeGrid1e4(row_ms[i]));
+        wire[8] = @bitCast(draft_policy.quantizeGrid1e4(d1_ms));
+        wire[9] = @bitCast(draft_policy.quantizeGrid1e4(d_each_ms));
+        tps.bootstrap.broadcast(std.mem.asBytes(&wire), std.mem.asBytes(&wire)) catch |err| {
+            return if (err == error.Timeout) error.Hy4BootstrapTimeout else error.Hy4RunMismatch;
+        };
+        for (0..max_w) |i| row_ms[i] = @bitCast(wire[i]);
+        d1_ms = @bitCast(wire[8]);
+        d_each_ms = @bitCast(wire[9]);
+    }
+    return draft_policy.CostParams.fromTable(row_ms[0..max_w], d1_ms, d_each_ms);
+}
+
+pub fn benchDecodeWindow(gpa: std.mem.Allocator, model: *resident.ResidentModel, pool: *kv_pool.KvPool, pos: usize, first_tok: u32, iters: usize) !void {
+    return benchDecodeWindowWidths(gpa, model, pool, pos, first_tok, iters, null);
+}
+
+pub fn benchDecodeWindowWidths(
+    gpa: std.mem.Allocator, model: *resident.ResidentModel, pool: *kv_pool.KvPool,
+    pos: usize, first_tok: u32, iters: usize, custom_widths: ?[]const usize,
+) !void {
+    if (iters == 0) return;
+    const widths = custom_widths orelse &default_sweep_widths;
+    if (widths.len == 0 or widths.len > max_sweep_widths) return error.BadArgs;
+    var max_w: usize = 1;
+    for (widths) |w| {
+        if (w == 0 or w > greedy.max_rows) return error.BadArgs;
+        if (w > max_w) max_w = w;
+    }
+    if (pos + max_w > pool.capacity) return error.PastContext;
+
+    const v: usize = model.t.vocab_size;
+    var win: [greedy.max_rows]u32 = @splat(first_tok);
+    for (1..greedy.max_rows) |j| win[j] = @intCast((@as(usize, first_tok) + j * 131) % @as(usize, @max(@as(usize, v - 1), @as(usize, 1))) + 1);
+    try pool.clearRange(model.t, pos, @min(pos + 32, pool.capacity), model.rt.stream.handle);
+
+    var colds: [max_sweep_widths]WindowSample = undefined;
+    for (widths, 0..) |w, idx| colds[idx] = try timeDecodeWindowOnce(model, pool, pos, win[0..w]);
+    for (widths) |w| _ = try timeDecodeWindowOnce(model, pool, pos, win[0..w]);
+
+    const nw = widths.len;
+    const tot = try gpa.alloc(u64, nw * iters); defer gpa.free(tot);
+    const fwd = try gpa.alloc(u64, nw * iters); defer gpa.free(fwd);
+    const hd = try gpa.alloc(u64, nw * iters); defer gpa.free(hd);
+    const gt = try gpa.alloc(u64, nw * iters); defer gpa.free(gt);
+
+    for (0..iters) |it| {
+        for (0..nw) |step| {
+            const idx = (it + step) % nw;
+            const s = try timeDecodeWindowOnce(model, pool, pos, win[0..widths[idx]]);
+            tot[idx * iters + it] = s.total_ns;
+            fwd[idx * iters + it] = s.fwd_ns;
+            hd[idx * iters + it] = s.head_ns;
+            gt[idx * iters + it] = s.gather_ns;
+        }
+    }
+    try pool.clearRange(model.t, pos, pos + max_w, model.rt.stream.handle);
+
+    if (model.tp_sess == null or model.tp_sess.?.rank == .zero) {
+        var line: std.ArrayList(u8) = .empty;
+        defer line.deinit(gpa);
+        const tp_w: usize = if (model.tp_sess != null) cuda.hy4_tp.world else 1;
+        const l_cnt: f64 = @floatFromInt(@max(model.layers.len, @as(usize, 1)));
+        const idx1: ?usize = std.mem.indexOfScalar(usize, widths, 1);
+        const idx7: ?usize = std.mem.indexOfScalar(usize, widths, 7);
+        const base_idx: usize = idx1 orelse 0;
+        const base_w: usize = widths[base_idx];
+        const base_med = try medianU64(gpa, tot[base_idx * iters ..][0..iters]);
+
+        try line.print(gpa, "hy4 bench-window (tp={d} layers={d} T={d} iters={d} page2k={} full_gather={}):", .{
+            tp_w, model.layers.len, pos, iters,
+            boundary.envFlag("TF_HY4_INDEX_PAGE_2K"), boundary.envFlag("TF_HY4_GREEDY_FULL_GATHER"),
+        });
+        for (widths, 0..) |w, idx| {
+            try line.print(gpa, " cold{d}={d:.2}ms", .{ w, @as(f64, @floatFromInt(colds[idx].total_ns)) / 1e6 });
+        }
+        for (widths, 0..) |w, idx| {
+            const t_sl = tot[idx * iters ..][0..iters];
+            const f_sl = fwd[idx * iters ..][0..iters];
+            const h_sl = hd[idx * iters ..][0..iters];
+            const g_sl = gt[idx * iters ..][0..iters];
+            const med = try medianU64(gpa, t_sl);
+            try line.print(gpa, " verify{d}_med={d:.2}ms (min={d:.2} fwd={d:.2} head={d:.2} gather={d:.3}", .{
+                w, med, minU64Ms(t_sl), try medianU64(gpa, f_sl), try medianU64(gpa, h_sl), try medianU64(gpa, g_sl),
+            });
+            if (w > base_w) {
+                const extra: f64 = @floatFromInt(w - base_w);
+                const dlt = med - base_med;
+                try line.print(gpa, " delta={d:.2} slope={d:.2}ms/row layer_slope={d:.3}ms/row/layer)", .{ dlt, dlt / extra, dlt / (extra * l_cnt) });
+            } else {
+                try line.appendSlice(gpa, ")");
+            }
+        }
+        if (idx1 != null and idx7 != null) {
+            const k1 = idx1.?;
+            const k7 = idx7.?;
+            const d_tot = try gpa.alloc(i64, iters); defer gpa.free(d_tot);
+            const d_fwd = try gpa.alloc(i64, iters); defer gpa.free(d_fwd);
+            const d_hd = try gpa.alloc(i64, iters); defer gpa.free(d_hd);
+            for (0..iters) |it| {
+                d_tot[it] = @as(i64, @intCast(tot[k7 * iters + it])) - @as(i64, @intCast(tot[k1 * iters + it]));
+                d_fwd[it] = @as(i64, @intCast(fwd[k7 * iters + it])) - @as(i64, @intCast(fwd[k1 * iters + it]));
+                d_hd[it] = @as(i64, @intCast(hd[k7 * iters + it])) - @as(i64, @intCast(hd[k1 * iters + it]));
+            }
+            const dt_med = try medianI64Ms(gpa, d_tot);
+            const df_med = try medianI64Ms(gpa, d_fwd);
+            const dh_med = try medianI64Ms(gpa, d_hd);
+            try line.print(gpa, " delta7_1_med={d:.2}ms (fwd_delta={d:.2} head_delta={d:.2}) total_slope={d:.3}ms/row/layer fwd_slope={d:.3}ms/row/layer", .{
+                dt_med, df_med, dh_med, dt_med / (6.0 * l_cnt), df_med / (6.0 * l_cnt),
+            });
+        }
+        try line.append(gpa, '\n');
+        std.debug.print("{s}", .{line.items});
+    }
+}
+
+fn timeDecodePartsOnce(model: *resident.ResidentModel, pool: *kv_pool.KvPool, pos: usize, toks: []const u32) !forward.PartTimers {
+    const hd = model.head orelse return error.HeadSkipped;
+    try pool.clearRange(model.t, pos, @min(pos + greedy.max_rows, pool.capacity), model.rt.stream.handle);
+    if (model.tp_sess) |tps| try tps.boundary.finish(model.rt.stream) else try model.rt.stream.synchronize();
+
+    var pt: forward.PartTimers = .{};
+    model.rt.parts = &pt;
+    model.rt.parts_io = model.io;
+    defer {
+        model.rt.parts = null;
+        model.rt.parts_io = null;
+    }
+
+    try model.rt.resetPartMark();
+    try forward.embedTokens(&model.rt, &model.sc, model.trunk.embed_bf16, toks, model.t.vocab_size, model.t.hidden_size);
+    try model.rt.stampPart(.other_local, null);
+
+    var unused_k: usize = 0;
+    model.sc.has_active_dev = false;
+    model.sc.active_k_dev = 0;
+    for (model.layers) |*lw| {
+        const lc = try pool.layerCache(lw.index);
+        try forward.forwardLayerTp(&model.rt, &model.sc, model.t, lw, pos, toks.len, lc, null, &unused_k, null, model.tp_sess, null);
+    }
+
+    const hg = try runHeadAndGatherTimed(model, hd, toks.len);
+    pt.head_ns = hg.head_ns;
+    pt.vocab_gather_ns = hg.gather_ns;
+    return pt;
+}
+
+pub fn benchDecodeParts(
+    gpa: std.mem.Allocator, model: *resident.ResidentModel, pool: *kv_pool.KvPool,
+    pos: usize, first_tok: u32, iters: usize, widths_opt: ?[]const usize,
+) !void {
+    if (iters == 0) return;
+    const one = [_]usize{1};
+    const widths = widths_opt orelse &one;
+    const v: usize = model.t.vocab_size;
+    var win: [greedy.max_rows]u32 = @splat(first_tok);
+    for (1..greedy.max_rows) |j| win[j] = @intCast((@as(usize, first_tok) + j * 131) % @as(usize, @max(@as(usize, v - 1), @as(usize, 1))) + 1);
+
+    const b_tr = try gpa.alloc(u64, iters); defer gpa.free(b_tr);
+    const b_ex = try gpa.alloc(u64, iters); defer gpa.free(b_ex);
+    const b_at = try gpa.alloc(u64, iters); defer gpa.free(b_at);
+    const b_ix = try gpa.alloc(u64, iters); defer gpa.free(b_ix);
+    const b_ot = try gpa.alloc(u64, iters); defer gpa.free(b_ot);
+    const b_tp = try gpa.alloc(u64, iters); defer gpa.free(b_tp);
+    const b_hd = try gpa.alloc(u64, iters); defer gpa.free(b_hd);
+    const b_vg = try gpa.alloc(u64, iters); defer gpa.free(b_vg);
+    const b_tt = try gpa.alloc(u64, iters); defer gpa.free(b_tt);
+
+    for (widths) |w| {
+        if (w == 0 or w > greedy.max_rows or pos + w > pool.capacity) return error.PastContext;
+        for (0..2) |_| _ = try timeDecodePartsOnce(model, pool, pos, win[0..w]);
+        for (0..iters) |it| {
+            const p = try timeDecodePartsOnce(model, pool, pos, win[0..w]);
+            b_tr[it] = p.trunk_ns; b_ex[it] = p.experts_ns; b_at[it] = p.attn_ns; b_ix[it] = p.index_ns;
+            b_ot[it] = p.other_local_ns; b_tp[it] = p.tp_gather_ns; b_hd[it] = p.head_ns; b_vg[it] = p.vocab_gather_ns;
+            b_tt[it] = p.totalNs();
+        }
+        try pool.clearRange(model.t, pos, pos + w, model.rt.stream.handle);
+        if (model.tp_sess == null or model.tp_sess.?.rank == .zero) {
+            const tp_w: usize = if (model.tp_sess != null) cuda.hy4_tp.world else 1;
+            const tr_m = try medianU64(gpa, b_tr);
+            const ex_m = try medianU64(gpa, b_ex);
+            const at_m = try medianU64(gpa, b_at);
+            const ix_m = try medianU64(gpa, b_ix);
+            const ot_m = try medianU64(gpa, b_ot);
+            const tp_m = try medianU64(gpa, b_tp);
+            const hd_m = try medianU64(gpa, b_hd);
+            const vg_m = try medianU64(gpa, b_vg);
+            const tt_m = try medianU64(gpa, b_tt);
+            const scale78 = 78.0 / @as(f64, @floatFromInt(@max(model.layers.len, @as(usize, 1))));
+            const proj78_fwd = (tr_m + ex_m + at_m + ix_m + ot_m + tp_m) * scale78;
+            std.debug.print(
+                "hy4 bench-parts (tp={d} layers={d} T={d} rows={d} iters={d}): trunk={d:.2}ms experts={d:.2}ms attn={d:.2}ms index={d:.2}ms other_local={d:.2}ms tp_gather={d:.2}ms head={d:.2}ms vocab_gather={d:.3}ms total={d:.2}ms | proj78: trunk={d:.2} experts={d:.2} attn={d:.2} index={d:.2} other_local={d:.2} tp_gather={d:.2} head={d:.2} vocab_gather={d:.3} total={d:.2}ms\n",
+                .{
+                    tp_w, model.layers.len, pos, w, iters,
+                    tr_m, ex_m, at_m, ix_m, ot_m, tp_m, hd_m, vg_m, tt_m,
+                    tr_m * scale78, ex_m * scale78, at_m * scale78, ix_m * scale78, ot_m * scale78, tp_m * scale78, hd_m, vg_m, proj78_fwd + hd_m + vg_m,
+                },
+            );
+        }
+    }
+}
+
+test "parseBenchWidths validates CSV widths and rejects out-of-range row counts" {
+    const gpa = std.testing.allocator;
+    const w = try parseBenchWidths(gpa, "1,2,3,7");
+    defer gpa.free(w);
+    try std.testing.expectEqualSlices(usize, &.{ 1, 2, 3, 7 }, w);
+    try std.testing.expectError(error.BadArgs, parseBenchWidths(gpa, "0,2"));
+    try std.testing.expectError(error.BadArgs, parseBenchWidths(gpa, "1,17"));
+    try std.testing.expectError(error.BadArgs, parseBenchWidths(gpa, ""));
+}
