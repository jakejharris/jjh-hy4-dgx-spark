+test "interleaveVocabStripes reassembles full 120832 and odd 101 vocab rows; bootstrap rejects Hy4PackMismatch" {
+    const gpa = std.testing.allocator;
+
+    // 1. Odd vocab_full = 101 across 4 ranks (stride = 26, rank 3 holds 23 valid + 3 padded).
+    var r_bufs: [4][2 * 26]f32 = @splat(@splat(-999.0));
+    for (0..2) |row| {
+        for (0..101) |v| {
+            const rk = v / 26;
+            const col = v % 26;
+            r_bufs[rk][row * 26 + col] = @floatFromInt(row * 1000 + v);
+        }
+    }
+    const views = [4][]const u8{
+        std.mem.sliceAsBytes(&r_bufs[0]),
+        std.mem.sliceAsBytes(&r_bufs[1]),
+        std.mem.sliceAsBytes(&r_bufs[2]),
+        std.mem.sliceAsBytes(&r_bufs[3]),
+    };
+    var out_101: [2 * 101]f32 = undefined;
+    try interleaveVocabStripes(&views, 2, 26, 101, &out_101);
+    for (0..2) |row| for (0..101) |v| {
+        try std.testing.expectEqual(@as(f32, @floatFromInt(row * 1000 + v)), out_101[row * 101 + v]);
+    };
+
+    // 2. Pack digest agreement rejects mismatched digest with error.Hy4PackMismatch.
+    const l = try tp.bootstrap.testListener();
+    defer tp.sock.close(l.fd);
+    const Peer = struct {
+        fn run(port: u16, err_out: *?anyerror) void {
+            var b = tp.Bootstrap.open(.{ .world = 2, .rank = 1, .link_port = port, .connect_timeout_ns = 5 * std.time.ns_per_s }) catch |e| {
+                err_out.* = e;
+                return;
+            };
+            defer b.close();
+            const d_bad: [32]u8 = @splat(0x22);
+            agreePackDigestOnBootstrap(&b, &d_bad) catch |e| {
+                err_out.* = e;
+            };
+        }
+    };
+    var peer_err: ?anyerror = null;
+    const th = try std.Thread.spawn(.{}, Peer.run, .{ l.port, &peer_err });
+    var b0 = try tp.Bootstrap.acceptOn(l.fd, 2, 5 * std.time.ns_per_s);
+    defer b0.close();
+    const d_good: [32]u8 = @splat(0x11);
+    try std.testing.expectError(error.Hy4PackMismatch, agreePackDigestOnBootstrap(&b0, &d_good));
+    th.join();
+    try std.testing.expectEqual(@as(?anyerror, error.Hy4PackMismatch), peer_err);
+    _ = gpa;
+}
+
+test "post-load broadcast uses long limit + Hy4LoadTimeout; gather-first NonFiniteLogits fails all 4 ranks together" {
+    const short_ns: u64 = 80 * std.time.ns_per_ms;
+    const long_ns: u64 = 2 * std.time.ns_per_s;
+    const l = try tp.bootstrap.testListener();
+    defer tp.sock.close(l.fd);
+
+    const Outcome = struct {
+        slot: u64 = 0,
+        restored_ns: u64 = 0,
+        top1_err: ?anyerror = null,
+        vocab_nan_seen: bool = false,
+        load_to_err: ?anyerror = null,
+    };
+    const Worker = struct {
+        fn run(rk: u32, port: u16, out: *Outcome) void {
+            var b = tp.Bootstrap.open(.{
+                .world = 4,
+                .rank = rk,
+                .link_port = port,
+                .connect_timeout_ns = 5 * std.time.ns_per_s,
+            }) catch return;
+            defer b.close();
+            b.timeout_ns = short_ns;
+
+            var slot_le = std.mem.nativeToLittle(u64, 99);
+            broadcastPostLoadOnBootstrap(&b, long_ns, std.mem.asBytes(&slot_le), std.mem.asBytes(&slot_le)) catch return;
+            out.slot = std.mem.littleToNative(u64, slot_le);
+            out.restored_ns = b.timeout_ns;
+
+            var stripe: [4]f32 = .{ @floatFromInt(rk), 1.0, 2.0, 3.0 };
+            if (rk == 2) stripe[1] = std.math.nan(f32);
+            var full: [16]f32 = undefined;
+            gatherVocabOnBootstrap(&b, std.testing.allocator, &stripe, 1, 4, 16, &full) catch return;
+            out.vocab_nan_seen = std.math.isNan(full[2 * 4 + 1]);
+
+            _ = gatherTop1OnBootstrap(&b, rk, &stripe, 4, 16) catch |e| {
+                out.top1_err = e;
+            };
+
+            broadcastPostLoadOnBootstrap(&b, 60 * std.time.ns_per_ms, std.mem.asBytes(&slot_le), std.mem.asBytes(&slot_le)) catch |e| {
+                out.load_to_err = e;
+            };
+        }
+    };
+
+    const sleepMs = struct {
+        fn run(ms: isize) void {
+            var req: std.c.timespec = .{ .sec = 0, .nsec = ms * 1_000_000 };
+            _ = std.c.nanosleep(&req, null);
+        }
+    }.run;
+
+    var outs: [4]Outcome = @splat(.{});
+    var threads: [3]std.Thread = undefined;
+    for (1..4) |rk| threads[rk - 1] = try std.Thread.spawn(.{}, Worker.run, .{ @as(u32, @intCast(rk)), l.port, &outs[rk] });
+    var b0 = try tp.Bootstrap.acceptOn(l.fd, 4, 5 * std.time.ns_per_s);
+    defer b0.close();
+    b0.timeout_ns = short_ns;
+
+    // Sleep longer than short_ns (80 ms) to prove post-load broadcast uses long_ns (2 s) and restores short_ns.
+    sleepMs(160);
+    var slot0_le = std.mem.nativeToLittle(u64, 3);
+    try broadcastPostLoadOnBootstrap(&b0, long_ns, std.mem.asBytes(&slot0_le), std.mem.asBytes(&slot0_le));
+    outs[0].slot = std.mem.littleToNative(u64, slot0_le);
+    outs[0].restored_ns = b0.timeout_ns;
+
+    const stripe0: [4]f32 = .{ 0.0, 1.0, 2.0, 3.0 };
+    var full0: [16]f32 = undefined;
+    try gatherVocabOnBootstrap(&b0, std.testing.allocator, &stripe0, 1, 4, 16, &full0);
+    outs[0].vocab_nan_seen = std.math.isNan(full0[2 * 4 + 1]);
+    try std.testing.expectError(error.NonFiniteLogits, gatherTop1OnBootstrap(&b0, 0, &stripe0, 4, 16));
+    outs[0].top1_err = error.NonFiniteLogits;
+
+    // Do not answer the final post-load broadcast so peers hit the 60 ms load timeout and report Hy4LoadTimeout.
+    sleepMs(140);
+    for (&threads) |*th| th.join();
+
+    for (0..4) |rk| {
+        try std.testing.expectEqual(@as(u64, 3), outs[rk].slot);
+        try std.testing.expectEqual(short_ns, outs[rk].restored_ns);
+        try std.testing.expect(outs[rk].vocab_nan_seen);
+        try std.testing.expectEqual(@as(?anyerror, error.NonFiniteLogits), outs[rk].top1_err);
+    }
+    for (1..4) |rk| {
+        try std.testing.expectEqual(@as(?anyerror, error.Hy4LoadTimeout), outs[rk].load_to_err);
+    }
+}
diff --git a/zig/src/families/hy4/cache.zig b/zig/src/families/hy4/cache.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b6018e7bdf5e1139eb6c311e4012973ec50a1e6f
--- /dev/null
+++ b/zig/src/families/hy4/cache.zig
@@ -0,0 +1,531 @@
+//! Device scratch workspace, per-layer KV/indexer cache view, and active token-selection carry.
+const std = @import("std");
+const cuda = @import("cuda");
+const config = @import("config.zig");
+const ranks = @import("ranks.zig");
+const weights = @import("weights.zig");
+
+/// View of one layer's latent KV and indexer key storage passed to `forwardLayer`.
+/// `has_prefix = false` marks a cache-free single-layer replay (no historical keys before `first_pos`).
+pub const LayerCache = struct {
+    kv_ptr: u64,
+    index_ptr: u64,
+    capacity: usize,
+    has_prefix: bool = true,
+};
+
+pub fn availableKeys(first_pos: usize, rows: usize, has_prefix: bool) usize {
+    return if (has_prefix) first_pos + rows else rows;
+}
+
+pub fn selectionWidth(index_topk: u32, first_pos: usize, rows: usize, has_prefix: bool) usize {
+    return @as(usize, @min(@as(usize, index_topk), availableKeys(first_pos, rows, has_prefix)));
+}
+
+pub const FastPrefillPlan = struct {
+    mla_bytes: usize = 0,
+    aux_bytes: usize = 0,
+    pf_w_bytes: usize = 0,
+    pf_x_bytes: usize = 0,
+    pf_part_bytes: usize = 0,
+
+    pub fn totalBytes(self: FastPrefillPlan) usize {
+        return self.mla_bytes + self.aux_bytes + self.pf_w_bytes + self.pf_x_bytes + self.pf_part_bytes;
+    }
+};
+
+fn noteTrunkProj(plan: *FastPrefillPlan, proj: weights.LinearProj, rows: usize) void {
+    if (proj != .exl3) return;
+    const w = proj.exl3.weight;
+    if (w.codebook != .mul1 or w.k == 0 or w.n == 0 or (w.k | w.n) % 128 != 0) return;
+    if (w.halves != 6 and w.halves != 8 and w.halves != 12 and w.halves != 16) return;
+    plan.pf_w_bytes = @max(plan.pf_w_bytes, @as(usize, w.n) * w.k * 2);
+    plan.pf_x_bytes = @max(plan.pf_x_bytes, rows * w.k * 2);
+    plan.pf_part_bytes = @max(plan.pf_part_bytes, rows * w.n * 4);
+}
+
+pub fn planFastPrefill(
+    k: *const cuda.hy4_ops.Kernels,
+    t: config.Text,
+    rank_opt: ?ranks.Rank,
+    layers: []const weights.LayerWeights,
+    chunk_rows: usize,
+) !FastPrefillPlan {
+    var plan: FastPrefillPlan = .{};
+    if (!k.fast_prefill or chunk_rows < k.min_prefill_rows) return plan;
+    const ls = try ranks.LocalShape.forText(t, rank_opt);
+    const mla_cap: u32 = @intCast(@max(chunk_rows, @as(usize, t.index_topk)));
+    plan.mla_bytes = try cuda.hy4_ops.scratchBytesFor(k, .{
+        .rows = @intCast(chunk_rows), .heads = ls.heads, .capacity = mla_cap,
+        .key_count = @intCast(@max(@as(usize, 1), @as(usize, t.index_topk))),
+        .latent = t.kv_lora_rank, .nope = t.qk_nope_head_dim, .rope = t.qk_rope_head_dim, .value = t.v_head_dim,
+    });
+    const idx_cap: u32 = @intCast(@min(@as(usize, t.max_position_embeddings), @max(chunk_rows, @as(usize, 16384))));
+    if (t.index_topk > 0 and t.index_n_heads > 0 and idx_cap >= chunk_rows) {
+        const idx_bytes = try cuda.hy4_ops.indexWindowScratchBytesFor(k, .{
+            .rows = @intCast(chunk_rows), .first_pos = idx_cap - @as(u32, @intCast(chunk_rows)), .capacity = idx_cap,
+            .top_k = t.index_topk, .width = t.hidden_size, .q_rank = t.q_lora_rank,
+            .heads = t.index_n_heads, .dim = t.index_head_dim, .rope = t.qk_rope_head_dim,
+            .x_row_stride = t.hidden_size, .q_row_stride = t.q_lora_rank,
+            .cache_stride = t.index_head_dim, .indices_stride = t.index_topk,
+            .theta = t.rope_parameters.rope_theta, .norm_eps = t.rms_norm_eps,
+        }, 0);
+        plan.aux_bytes = @max(plan.aux_bytes, idx_bytes);
+    }
+    for (layers) |lw| {
+        inline for (.{ lw.q_a, lw.q_b, lw.kv_a, lw.linear_gate, lw.o_proj }) |p| noteTrunkProj(&plan, p, chunk_rows);
+        switch (lw.mlp) {
+            .dense => |d| inline for (.{ d.gate, d.up, d.down }) |p| noteTrunkProj(&plan, p, chunk_rows),
+            .sparse_bf16 => |sp| inline for (.{ sp.shared.gate, sp.shared.up, sp.shared.down }) |p| noteTrunkProj(&plan, p, chunk_rows),
+            .sparse_exl3 => |sp| {
+                inline for (.{ sp.shared.gate, sp.shared.up, sp.shared.down }) |p| noteTrunkProj(&plan, p, chunk_rows);
+                const r_bytes = if (sp.router_f32 != 0)
+                    try cuda.exl3_experts.scratchBytes(sp.exl3_layer, @min(chunk_rows, 1024), t.num_experts_per_tok)
+                else blk: {
+                    const r_dims = sp.exl3_layer.dims;
+                    break :blk try cuda.hy4_ops.routedScratchBytesFor(k, .{
+                        .rows = @intCast(chunk_rows), .top_k = t.num_experts_per_tok,
+                        .x_row_stride = @intCast(r_dims), .output_row_stride = @intCast(r_dims),
+                        .route_scale = t.routed_scaling_factor,
+                    }, sp.exl3_layer);
+                };
+                plan.aux_bytes = @max(plan.aux_bytes, r_bytes);
+            },
+        }
+    }
+    return plan;
+}
+
+/// Replaces or updates `slot.*` atomically: if allocation fails, the prior selection stays valid.
+pub fn saveActiveIndices(gpa: std.mem.Allocator, slot: *?[]i32, src: []const i32) !void {
+    if (slot.*) |cur| if (cur.len == src.len) {
+        @memcpy(cur, src);
+        return;
+    };
+    const fresh = try gpa.dupe(i32, src);
+    if (slot.*) |old| gpa.free(old);
+    slot.* = fresh;
+}
+
+const scratch_fields = .{
+    "streams_a",   "streams_b",     "collapsed",      "hidden",      "branch",
+    "shared_f32",  "norm_tmp",      "post",           "q_raw",       "q_resid",
+    "q",           "kv",            "gate",           "gated_values","absorbed_q",
+    "kv_cache",    "index_cache",   "indices_buf",    "active_indices_dev",
+    "mla_scratch", "aux_scratch",   "ff_gate",        "ff_up",       "ff_inner",
+    "pad_in",      "pad_out",       "f32_in",         "f32_tmp",     "zeros_f32",
+    "logits_f32",  "ids_i32",       "router_logits",  "router_ids",  "router_weights",
+    "routed_f32",  "moe_x",         "moe_gu",         "moe_act",     "moe_down",
+    "tp_partial",  "tp_gathered",   "ihc_count",
+};
+
+pub const ScratchOptions = struct {
+    logits_rows: usize = 0,
+    single_layer_cache_cap: usize = 0,
+    rank: ?ranks.Rank = null,
+};
+
+pub const Scratch = struct {
+    d: *const cuda.Driver,
+    max_rows: usize,
+    capacity: usize,
+    rank: ?ranks.Rank = null,
+    vision_slot: ?usize = null,
+    mrope: ?@import("vision_runtime.zig").LanePositions = null,
+    graph_mode: enum { off, warm, ready, capturing } = .off,
+    active_k_dev: usize = 0,
+    has_active_dev: bool = false,
+    streams_a: cuda.DeviceBuffer,
+    streams_b: cuda.DeviceBuffer,
+    collapsed: cuda.DeviceBuffer,
+    hidden: cuda.DeviceBuffer,
+    branch: cuda.DeviceBuffer,
+    shared_f32: cuda.DeviceBuffer,
+    norm_tmp: cuda.DeviceBuffer,
+    post: cuda.DeviceBuffer,
+    q_raw: cuda.DeviceBuffer,
+    q_resid: cuda.DeviceBuffer,
+    q: cuda.DeviceBuffer,
+    kv: cuda.DeviceBuffer,
+    gate: cuda.DeviceBuffer,
+    gated_values: cuda.DeviceBuffer,
+    absorbed_q: cuda.DeviceBuffer,
+    kv_cache: cuda.DeviceBuffer,
+    index_cache: cuda.DeviceBuffer,
+    indices_buf: cuda.DeviceBuffer,
+    active_indices_dev: cuda.DeviceBuffer,
+    mla_scratch: cuda.DeviceBuffer,
+    aux_scratch: cuda.DeviceBuffer,
+    ff_gate: cuda.DeviceBuffer,
+    ff_up: cuda.DeviceBuffer,
+    ff_inner: cuda.DeviceBuffer,
+    pad_in: cuda.DeviceBuffer,
+    pad_out: cuda.DeviceBuffer,
+    f32_in: cuda.DeviceBuffer,
+    f32_tmp: cuda.DeviceBuffer,
+    zeros_f32: cuda.DeviceBuffer,
+    logits_f32: cuda.DeviceBuffer,
+    ids_i32: cuda.DeviceBuffer,
+    router_logits: cuda.DeviceBuffer,
+    router_ids: cuda.DeviceBuffer,
+    router_weights: cuda.DeviceBuffer,
+    routed_f32: cuda.DeviceBuffer,
+    moe_x: cuda.DeviceBuffer,
+    moe_gu: cuda.DeviceBuffer,
+    moe_act: cuda.DeviceBuffer,
+    moe_down: cuda.DeviceBuffer,
+    tp_partial: cuda.DeviceBuffer,
+    tp_gathered: cuda.DeviceBuffer,
+    /// u32 [8] row counters for the one-launch iHC read; empty with TF_HY4_IHC_SPLIT=1.
+    ihc_count: cuda.DeviceBuffer,
+
+    pub fn init(d: *const cuda.Driver, t: config.Text, max_rows: usize, capacity: usize) !Scratch {
+        return initWith(d, t, max_rows, .{ .logits_rows = max_rows, .single_layer_cache_cap = capacity });
+    }
+
+    pub fn initWith(d: *const cuda.Driver, t: config.Text, max_rows: usize, opts: ScratchOptions) !Scratch {
+        const ls = try ranks.LocalShape.forText(t, opts.rank);
+        const h: usize = t.hidden_size;
+        const h_exl3 = std.mem.alignForward(usize, h, 128);
+        const q_rank: usize = t.q_lora_rank;
+        const heads: usize = ls.heads;
+        const max_ff: usize = @max(@as(usize, 1), @as(usize, @max(ls.dense, @as(usize, @max(ls.shared, 2 * ls.expert)))));
+        const k_cap: usize = @max(@as(usize, 1), if (opts.single_layer_cache_cap > 0)
+            @as(usize, @min(@as(usize, t.index_topk), opts.single_layer_cache_cap))
+        else
+            @as(usize, t.index_topk));
+        const slots: usize = @max(@as(usize, 1), @as(usize, t.num_experts_per_tok));
+        const e_count: usize = @max(@as(usize, 1), @as(usize, t.n_routed_experts));
+        const branch_w: usize = if (opts.rank != null) @as(usize, @max(h, @as(usize, cuda.hy4_tp.hidden))) else h;
+
+        const empty: cuda.DeviceBuffer = .{ .d = d, .ptr = 0, .len = 0 };
+        var sc: Scratch = undefined;
+        sc.d = d;
+        sc.max_rows = max_rows;
+        sc.capacity = opts.single_layer_cache_cap;
+        sc.rank = opts.rank;
+        sc.vision_slot = null;
+        sc.mrope = null;
+        sc.graph_mode = .off;
+        sc.active_k_dev = 0;
+        sc.has_active_dev = false;
+        inline for (scratch_fields) |field| @field(sc, field) = empty;
+        errdefer sc.deinit();
+
+        sc.streams_a = try cuda.DeviceBuffer.alloc(d, max_rows * 4 * h * 2);
+        sc.streams_b = try cuda.DeviceBuffer.alloc(d, max_rows * 4 * h * 2);
+        sc.collapsed = try cuda.DeviceBuffer.alloc(d, max_rows * h * 2);
+        sc.hidden = try cuda.DeviceBuffer.alloc(d, max_rows * h * 2);
+        sc.branch = try cuda.DeviceBuffer.alloc(d, max_rows * branch_w * 2);
+        sc.shared_f32 = try cuda.DeviceBuffer.alloc(d, max_rows * h * 4);
+        sc.norm_tmp = try cuda.DeviceBuffer.alloc(d, max_rows * @as(usize, @max(h, q_rank)) * 2);
+        sc.post = try cuda.DeviceBuffer.alloc(d, max_rows * 4 * 4);
+        sc.q_raw = try cuda.DeviceBuffer.alloc(d, max_rows * q_rank * 2);
+        sc.q_resid = try cuda.DeviceBuffer.alloc(d, max_rows * q_rank * 2);
+        const kv_a_pad = std.mem.alignForward(usize, t.kvARows(), 128);
+        sc.q = try cuda.DeviceBuffer.alloc(d, max_rows * ls.queryRows(t) * 2);
+        sc.kv = try cuda.DeviceBuffer.alloc(d, max_rows * kv_a_pad * 2);
+        sc.gate = try cuda.DeviceBuffer.alloc(d, max_rows * ls.valueRows(t) * 2);
+        sc.gated_values = try cuda.DeviceBuffer.alloc(d, max_rows * ls.valueRows(t) * 2);
+        sc.absorbed_q = try cuda.DeviceBuffer.alloc(d, max_rows * heads * t.kvARows() * 2);
+        if (opts.single_layer_cache_cap > 0) {
+            sc.kv_cache = try cuda.DeviceBuffer.alloc(d, opts.single_layer_cache_cap * t.kvARows() * 2);
+            sc.index_cache = try cuda.DeviceBuffer.alloc(d, opts.single_layer_cache_cap * t.index_head_dim * 2);
+        }
+        sc.indices_buf = try cuda.DeviceBuffer.alloc(d, max_rows * k_cap * 4);
+        sc.active_indices_dev = try cuda.DeviceBuffer.alloc(d, max_rows * k_cap * 4);
+        sc.ff_gate = try cuda.DeviceBuffer.alloc(d, max_rows * max_ff * 2);
+        sc.ff_up = try cuda.DeviceBuffer.alloc(d, max_rows * max_ff * 2);
+        sc.ff_inner = try cuda.DeviceBuffer.alloc(d, max_rows * max_ff * 2);
+        sc.f32_in = try cuda.DeviceBuffer.alloc(d, max_rows * h_exl3 * 4);
+        sc.f32_tmp = try cuda.DeviceBuffer.alloc(d, max_rows * h_exl3 * 4);
+        sc.zeros_f32 = try cuda.DeviceBuffer.alloc(d, h_exl3 * 4);
+        if (opts.logits_rows > 0) {
+            sc.logits_f32 = try cuda.DeviceBuffer.alloc(d, opts.logits_rows * @as(usize, @max(@as(usize, 1), ls.vocab_stride)) * 4);
+        }
+        sc.ids_i32 = try cuda.DeviceBuffer.alloc(d, max_rows * 4);
+        sc.router_logits = try cuda.DeviceBuffer.alloc(d, max_rows * e_count * 4);
+        sc.router_ids = try cuda.DeviceBuffer.alloc(d, max_rows * slots * 4);
+        sc.router_weights = try cuda.DeviceBuffer.alloc(d, max_rows * slots * 4);
+        sc.routed_f32 = try cuda.DeviceBuffer.alloc(d, max_rows * h_exl3 * 4);
+        try sc.zeros_f32.fill8(0, null);
+        if (!@import("boundary.zig").envFlag("TF_HY4_IHC_SPLIT")) {
+            sc.ihc_count = try cuda.DeviceBuffer.alloc(d, 8 * 4);
+            try sc.ihc_count.fill8(0, null);
+        }
+        if (opts.rank != null) {
+            sc.tp_partial = try cuda.DeviceBuffer.alloc(d, max_rows * cuda.hy4_tp.hidden * 4);
+            sc.tp_gathered = try cuda.DeviceBuffer.alloc(d, max_rows * cuda.hy4_tp.hidden * 16);
+            try sc.tp_partial.fill8(0, null);
+        }
+        return sc;
+    }
+
+    // A capture may already contain pointers into the old buffer. Grow only on the eager pass.
+    // Reserve a small margin then so the next decode position can reuse the allocation.
+    fn growthSize(self: *const Scratch, need: usize) !usize {
+        return switch (self.graph_mode) {
+            .off => need,
+            .capturing => error.Hy4GraphNeedsWarmup,
+            .warm, .ready => std.mem.alignForward(usize, need, 64 * 1024),
+        };
+    }
+
+    pub fn ensureMlaScratch(self: *Scratch, need: usize) !void {
+        if (self.mla_scratch.len >= need) return;
+        const next = try cuda.DeviceBuffer.alloc(self.d, try self.growthSize(need));
+        self.mla_scratch.free();
+        self.mla_scratch = next;
+    }
+
+    pub fn ensureAuxScratch(self: *Scratch, need: usize) !void {
+        if (self.aux_scratch.len >= need) return;
+        const next = try cuda.DeviceBuffer.alloc(self.d, try self.growthSize(need));
+        self.aux_scratch.free();
+        self.aux_scratch = next;
+    }
+
+    pub fn ensurePadScratch(self: *Scratch, need_each: usize) !void {
+        if (self.pad_in.len >= need_each and self.pad_out.len >= need_each) return;
+        const size = try self.growthSize(need_each);
+        var next_in = try cuda.DeviceBuffer.alloc(self.d, size);
+        errdefer next_in.free();
+        const next_out = try cuda.DeviceBuffer.alloc(self.d, size);
+        self.pad_in.free();
+        self.pad_out.free();
+        self.pad_in = next_in;
+        self.pad_out = next_out;
+    }
+
+    pub fn ensureBf16MoeScratch(self: *Scratch, t: config.Text, hit_cap: usize) !void {
+        const ls = try ranks.LocalShape.forText(t, self.rank);
+        const cap: usize = @max(hit_cap, @as(usize, 1));
+        const h: usize = t.hidden_size;
+        const moe_inter: usize = @max(@as(usize, 1), ls.expert);
+        const need_x = cap * h * 2;
+        const need_gu = cap * 2 * moe_inter * 2;
+        const need_act = cap * moe_inter * 2;
+        const need_dn = cap * h * 4;
+        if (self.moe_x.len >= need_x and self.moe_gu.len >= need_gu and self.moe_act.len >= need_act and self.moe_down.len >= need_dn) return;
+        var nx = try cuda.DeviceBuffer.alloc(self.d, need_x);
+        errdefer nx.free();
+        var ngu = try cuda.DeviceBuffer.alloc(self.d, need_gu);
+        errdefer ngu.free();
+        var nact = try cuda.DeviceBuffer.alloc(self.d, need_act);
+        errdefer nact.free();
+        const ndn = try cuda.DeviceBuffer.alloc(self.d, need_dn);
+        self.moe_x.free();
+        self.moe_gu.free();
+        self.moe_act.free();
+        self.moe_down.free();
+        self.moe_x = nx;
+        self.moe_gu = ngu;
+        self.moe_act = nact;
+        self.moe_down = ndn;
+    }
+
+    pub fn totalBytes(self: *const Scratch) usize {
+        var sum: usize = 0;
+        inline for (scratch_fields) |field| sum += @field(self, field).len;
+        return sum;
+    }
+
+    pub fn deinit(self: *Scratch) void {
+        inline for (scratch_fields) |field| @field(self, field).free();
+        self.* = undefined;
+    }
+};
+
+pub const TestMock = if (@import("builtin").is_test) struct {
+    pub var allocations: usize = 0;
+    pub var frees: usize = 0;
+    pub var copied: [1024]u8 = @splat(0);
+    pub var next: u64 = 256;
+    pub var last_alloc_ptr: u64 = 0;
+    pub var sink: ?[]u8 = null;
+    /// When set, every host-to-device copy's bytes (in order) feed this hash: the loaded weights' digest.
+    pub var digest: ?*std.crypto.hash.sha2.Sha256 = null;
+
+    pub fn init() cuda.Driver {
+        allocations = 0;
+        frees = 0;
+        copied = @splat(0);
+        next = 256;
+        last_alloc_ptr = 0;
+        sink = null;
+        var d: cuda.Driver = undefined;
+        d.api.cuMemAlloc_v2 = alloc;
+        d.api.cuMemFree_v2 = free;
+        d.api.cuMemcpyHtoD_v2 = copy;
+        d.api.cuStreamSynchronize = sync;
+        d.api.cuCtxSynchronize = ctxSync;
+        d.api.cuMemsetD8Async = memsetAsync;
+        d.api.cuMemsetD8_v2 = memsetLegacy;
+        d.api.cuGetErrorName = errName;
+        d.api.cuGetErrorString = errName;
+        return d;
+    }
+    fn alloc(p: *cuda.abi.DevicePtr, len: usize) callconv(.c) cuda.abi.Result {
+        p.* = next;
+        last_alloc_ptr = next;
+        next += std.mem.alignForward(usize, @as(usize, @max(len, @as(usize, 1))), 256);
+        allocations += 1;
+        return 0;
+    }
+    fn free(_: cuda.abi.DevicePtr) callconv(.c) cuda.abi.Result { frees += 1; return 0; }
+    fn copy(dst: cuda.abi.DevicePtr, src: ?*const anyopaque, n: usize) callconv(.c) cuda.abi.Result {
+        const s = @as([*]const u8, @ptrCast(src.?))[0..n];
+        if (digest) |h| h.update(s);
+        const count: usize = @min(n, copied.len);
+        @memcpy(copied[0..count], s[0..count]);
+        if (sink) |buf| if (dst >= last_alloc_ptr) {
+            const off: usize = @intCast(dst - last_alloc_ptr);
+            if (off < buf.len) {
+                const w: usize = @min(n, buf.len - off);
+                @memcpy(buf[off .. off + w], s[0..w]);
+            }
+        };
+        return 0;
+    }
+    fn sync(_: cuda.abi.Stream) callconv(.c) cuda.abi.Result { return 0; }
+    fn ctxSync() callconv(.c) cuda.abi.Result { return 0; }
+    fn memsetAsync(_: cuda.abi.DevicePtr, _: u8, _: usize, _: cuda.abi.Stream) callconv(.c) cuda.abi.Result { return 0; }
+    fn memsetLegacy(_: cuda.abi.DevicePtr, _: u8, _: usize) callconv(.c) cuda.abi.Result { return 0; }
+    fn errName(_: cuda.abi.Result, out: *?[*:0]const u8) callconv(.c) cuda.abi.Result { out.* = "mock"; return 0; }
+} else struct {};
+
