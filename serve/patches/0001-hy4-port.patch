@@ -0,0 +1,50 @@
+//! Metal launches for Hy4-flash's closed-group scores and selection.
+const mtl = @import("metal");
+const sources = @import("kernel_sources");
+const recall = @import("index_recall.zig");
+
+pub const Ref = struct { buffer: mtl.Buffer, offset: usize = 0 };
+pub const Buffers = struct {
+    query: Ref,
+    keys: Ref,
+    weights: Ref,
+    rows: Ref,
+    scores: Ref,
+    tokens: Ref,
+    counts: Ref,
+};
+
+pub const Kernels = struct {
+    score: mtl.Pipeline,
+    select: mtl.Pipeline,
+
+    pub fn load(device: mtl.Device) !Kernels {
+        const lib = try mtl.Library.fromSource(device, sources.hy4_flash_index_recall, mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        var score = try mtl.Pipeline.init(device, lib, "tf_hy4_group_scores", false);
+        errdefer score.deinit();
+        return .{ .score = score, .select = try mtl.Pipeline.init(device, lib, "tf_hy4_recall_groups", false) };
+    }
+
+    pub fn deinit(self: *Kernels) void {
+        self.score.deinit();
+        self.select.deinit();
+        self.* = undefined;
+    }
+
+    pub fn run(self: Kernels, e: mtl.ComputeEncoder, b: Buffers, shape: recall.Shape) !void {
+        try shape.check();
+        e.setPipeline(self.score);
+        const input = [_]Ref{ b.query, b.keys, b.weights, b.rows, b.scores };
+        for (input, 0..) |ref, i| e.setBuffer(ref.buffer, ref.offset, i);
+        e.setValue(shape, input.len);
+        e.setValue(recall.head_scale, input.len + 1);
+        e.dispatchGroups(mtl.Size.of((shape.score_groups + 3) / 4, shape.rows, 1), mtl.Size.of(128, 1, 1));
+        e.barrier();
+        e.setPipeline(self.select);
+        const selection = [_]Ref{ b.scores, b.rows, b.tokens, b.counts };
+        for (selection, 0..) |ref, i| e.setBuffer(ref.buffer, ref.offset, i);
+        e.setValue(shape, selection.len);
+        e.dispatchGroups(mtl.Size.of(shape.rows, 1, 1), mtl.Size.of(256, 1, 1));
+    }
+};
diff --git a/zig/src/families/hy4_flash/indexpool_cuda.zig b/zig/src/families/hy4_flash/indexpool_cuda.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f6b0cfbb62aaec2aea9985c1846e15ee8018c554
--- /dev/null
+++ b/zig/src/families/hy4_flash/indexpool_cuda.zig
@@ -0,0 +1,26 @@
+//! CUDA launch for Hy4-flash's FP32 sparse-index key pooling.
+const cuda = @import("cuda");
+const groups = @import("index_groups.zig");
+
+pub const symbol = "tf_hy4_pool_groups";
+pub const threads = 128;
+
+pub const Bindings = struct { values: u64, gates: u64, position_bias: u64, pooled: u64 };
+
+pub fn open(driver: *const cuda.Driver) !cuda.Module {
+    return cuda.Module.load(driver, cuda.kernels.hy4_indexpool);
+}
+
+pub fn load(module: cuda.Module) !cuda.Function {
+    return module.function(symbol);
+}
+
+pub fn run(kernel: cuda.Function, stream: cuda.Stream, refs: Bindings, shape: groups.PoolShape) !void {
+    if (shape.groups == 0 or shape.width == 0) return;
+    var args: cuda.Args = .{};
+    inline for (.{ refs.values, refs.gates, refs.position_bias, refs.pooled, shape.groups, shape.width }) |arg| {
+        args.add(arg);
+    }
+    const columns = (shape.width - 1) / threads + 1;
+    try cuda.launch.launch(kernel, .{ .grid = .{ .x = shape.groups, .y = columns }, .block = .{ .x = threads } }, stream, &args);
+}
