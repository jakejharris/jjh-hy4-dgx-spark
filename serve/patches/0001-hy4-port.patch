diff --git a/zig/kernels/cuda/affine_experts.cu b/zig/kernels/cuda/affine_experts.cu
new file mode 100644
index 0000000000000000000000000000000000000000..e3296e44de0601caefd67741aa945dffbc9808f8
--- /dev/null
+++ b/zig/kernels/cuda/affine_experts.cu
@@ -0,0 +1,82 @@
+// CUDA grouped FFN rows over the checkpoint's 4- or 8-bit MLX affine experts (group size 64).
+#include <cuda_bf16.h>
+#include <stdint.h>
+#include "common/reduce.cuh"
+
+struct AffineExpertShape {
+    uint32_t width, inner, first, experts, pairs, rows;
+    float swiglu_limit;
+};
+
+template<int Bits>
+__device__ float dot(const __nv_bfloat16 *input, const uint32_t *words, const __nv_bfloat16 *scale,
+                     const __nv_bfloat16 *bias, uint32_t width, uint32_t lane) {
+    constexpr uint32_t mask = (1 << Bits) - 1;
+    float acc = 0.0f;
+    for (uint32_t group = 0; group < width / 64; ++group) {
+        const float s = __bfloat162float(scale[group]), b = __bfloat162float(bias[group]);
+        for (uint32_t i = lane; i < 64; i += 32) {
+            const uint32_t index = group * 64 + i;
+            const uint32_t bit = index * Bits;
+            const float code = float((words[bit / 32] >> (bit % 32)) & mask);
+            const float w = __bfloat162float(__float2bfloat16_rn(__fmaf_rn(code, s, b)));
+            acc = __fmaf_rn(__bfloat162float(input[index]), w, acc);
+        }
+    }
+    return tf_common::warp_sum(acc);
+}
+
+template<int Bits, bool Up>
+__device__ void expert_rows(const __nv_bfloat16 *x, const int32_t *ids, const int32_t *source,
+                            const uint32_t *words, const __nv_bfloat16 *scale, const __nv_bfloat16 *bias,
+                            void *output, AffineExpertShape a) {
+    const uint32_t pair = blockIdx.y, lane = threadIdx.x % 32;
+    const uint32_t n = 4 * blockIdx.x + threadIdx.x / 32;
+    const uint32_t width = Up ? a.width : a.inner, size = Up ? a.inner : a.width;
+    if (n >= size) return;
+    const uint64_t out = uint64_t(pair) * size + n;
+    const int32_t id = ids[pair];
+    const int32_t row = Up ? source[pair] : pair;
+    if (id < 0 || uint32_t(id) < a.first || uint32_t(id) - a.first >= a.experts ||
+        row < 0 || (Up && uint32_t(row) >= a.rows)) {
+        if (lane == 0) {
+            if constexpr (Up) reinterpret_cast<__nv_bfloat16 *>(output)[out] = __float2bfloat16_rn(0.0f);
+            else reinterpret_cast<float *>(output)[out] = 0.0f;
+        }
+        return;
+    }
+
+    const __nv_bfloat16 *input = x + uint64_t(row) * width;
+    const uint64_t expert_row = uint64_t(uint32_t(id) - a.first) * (Up ? 2 * size : size) + n;
+    const uint32_t packed_width = width * Bits / 32, groups = width / 64;
+    const uint64_t wc = expert_row * packed_width, gc = expert_row * groups;
+    const float first = dot<Bits>(input, words + wc, scale + gc, bias + gc, width, lane);
+    if constexpr (Up) {
+        const uint64_t wu = wc + uint64_t(size) * packed_width, gu = gc + uint64_t(size) * groups;
+        const float second = dot<Bits>(input, words + wu, scale + gu, bias + gu, width, lane);
+        if (lane == 0) {
+            float gate = __bfloat162float(__float2bfloat16_rn(first));
+            float up = __bfloat162float(__float2bfloat16_rn(second));
+            if (a.swiglu_limit > 0) {
+                gate = fminf(gate, a.swiglu_limit);
+                up = fminf(a.swiglu_limit, fmaxf(-a.swiglu_limit, up));
+            }
+            const float activated = __bfloat162float(__float2bfloat16_rn(gate / (1.0f + expf(-gate))));
+            reinterpret_cast<__nv_bfloat16 *>(output)[out] = __float2bfloat16_rn(activated * up);
+        }
+    } else if (lane == 0) {
+        reinterpret_cast<float *>(output)[out] = first;
+    }
+}
+
+#define TF_AFFINE_EXPERTS(bits, suffix, up)                                                              \
+extern "C" __global__ void __launch_bounds__(128) tf_affine_experts_##suffix##_##bits(                    \
+    const __nv_bfloat16 *x, const int32_t *ids, const int32_t *rows, const uint32_t *words,                \
+    const __nv_bfloat16 *scale, const __nv_bfloat16 *bias, void *out, AffineExpertShape shape) {           \
+    expert_rows<bits, up>(x, ids, rows, words, scale, bias, out, shape);                                  \
+}
+
+TF_AFFINE_EXPERTS(4, up, true)
+TF_AFFINE_EXPERTS(4, down, false)
+TF_AFFINE_EXPERTS(8, up, true)
+TF_AFFINE_EXPERTS(8, down, false)
diff --git a/zig/kernels/cuda/common/moe_score.cuh b/zig/kernels/cuda/common/moe_score.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..46f47517cd929147574d2ac4ea612cb991a41876
--- /dev/null
+++ b/zig/kernels/cuda/common/moe_score.cuh
@@ -0,0 +1,55 @@
+// Final biased sigmoid selection for both the standalone and fused routers.
+#pragma once
+#include <cuda_runtime.h>
+#include <math.h>
+#include <stdint.h>
+
+namespace tf_moe {
+// (value, id) wins over (other value, other id): the larger value, the lower id among equals.
+__device__ __forceinline__ bool beats(float v, int i, float w, int j) {
+    return v > w || (v == w && i < j);
+}
+
+// A float's order as an unsigned (-0 as +0, so equal values stay equal).
+__device__ __forceinline__ unsigned ordered(float v) {
+    const unsigned u = __float_as_uint(__fadd_rn(v, 0.f));
+    return u & 0x80000000u ? ~u : u | 0x80000000u;
+}
+
+template<int P>
+__device__ __forceinline__ void finish_scores(float (&v)[P], const float (&x)[P], int64_t r, int ne, int topk,
+                                               int shared, int normalize, float scale, int* pick, float* wts) {
+    const int lane = threadIdx.x & 31;
+    const int slots = topk + shared;
+    float xk = 0.f; // lane k's pick's score
+    int pk = 0;     // lane k's pick
+    for (int k = 0; k < topk; ++k) {
+        float bv = -INFINITY;
+        int bi = ne;
+#pragma unroll
+        for (int j = 0; j < P; ++j) {
+            const int e = lane + 32 * j;
+            if (e < ne && beats(v[j], e, bv, bi)) bv = v[j], bi = e;
+        }
+        { // the warp's best: the largest value (redux on an order-keeping key), then the lowest id among equals
+            const unsigned key = ordered(bv);
+            const unsigned top = __reduce_max_sync(0xFFFFFFFFu, key);
+            bi = static_cast<int>(__reduce_min_sync(0xFFFFFFFFu, key == top ? static_cast<unsigned>(bi) : 0xFFFFFFFFu));
+        }
+        float xb = 0.f;
+#pragma unroll
+        for (int j = 0; j < P; ++j)
+            if (lane + 32 * j == bi) v[j] = -INFINITY, xb = x[j];
+        xb = __shfl_sync(0xFFFFFFFFu, xb, bi & 31);
+        if (lane == k) xk = xb, pk = bi;
+    }
+    // the weights in their lanes; the sum in pick order, + 1e-20: picks all underflowed to 0 weigh 0, not NaN
+    float sum = 0.f;
+    for (int k = 0; k < topk; ++k) sum = __fadd_rn(sum, __shfl_sync(0xFFFFFFFFu, xk, k));
+    if (lane < topk) {
+        pick[r * slots + lane] = pk;
+        wts[r * slots + lane] = __fmul_rn(normalize ? __fdiv_rn(xk, __fadd_rn(sum, 1e-20f)) : xk, scale);
+    }
+    if (lane < shared) pick[r * slots + topk + lane] = ne + lane, wts[r * slots + topk + lane] = 1.f;
+}
+} // namespace tf_moe
diff --git a/zig/kernels/cuda/contract_hy4_bench.zig b/zig/kernels/cuda/contract_hy4_bench.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9a2533251cd62dd6966fbee986110d0fbf1ddf99
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_bench.zig
@@ -0,0 +1,424 @@
+//! One rank at checkpoint dimensions. CUDA events exclude allocations, plan selection and communication.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = cuda.hy4_ops;
+const Trace = @import("contract_hy4_bench_trace.zig").Trace;
+const t = std.testing;
+const D = 6144;
+const replay = @import("bench_options").replay;
+const K = 2048;
+const H = 16;
+
+// A paired runner gives each process a socket and grants one measurement at a time.
+const Control = struct {
+    extern "c" fn getenv([*:0]const u8) ?[*:0]const u8;
+    extern "c" fn read(c_int, *u8, usize) isize;
+    extern "c" fn write(c_int, *const u8, usize) isize;
+    fn socket() !?c_int {
+        const value = getenv("HY4_BENCH_PAIR_FD") orelse return null;
+        return try std.fmt.parseInt(c_int, std.mem.span(value), 10);
+    }
+    fn step(fd: ?c_int, phase: u8) !void {
+        const f = fd orelse return;
+        var ack: u8 = 0;
+        if (write(f, &phase, 1) != 1 or read(f, &ack, 1) != 1 or ack != phase) return error.Hy4BenchmarkPeer;
+    }
+};
+
+const Bench = struct {
+    pair_fd: ?c_int,
+    d: *cuda.Driver,
+    s: cuda.Stream,
+    k: *ops.Kernels,
+    trace: *Trace,
+    rows: usize,
+    prior: u32,
+    allocations: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    flush: u64 = 0,
+    fn deinit(b: *Bench) void {
+        b.s.synchronize() catch {};
+        for (b.allocations.items) |*mem| mem.free();
+        b.allocations.deinit(t.allocator);
+    }
+    pub fn buf(b: *Bench, bytes: usize, pattern: u32) !u64 {
+        var mem = try cuda.DeviceBuffer.alloc(b.d, bytes);
+        errdefer mem.free();
+        try mem.fill32(pattern, b.s.handle);
+        try b.allocations.append(t.allocator, mem);
+        return mem.ptr;
+    }
+    pub fn upload(b: *Bench, data: anytype) !u64 {
+        var mem = try cuda.DeviceBuffer.fromHost(b.d, std.mem.sliceAsBytes(data));
+        errdefer mem.free();
+        try b.allocations.append(t.allocator, mem);
+        return mem.ptr;
+    }
+    fn file(b: *Bench, dir: []const u8, name: []const u8, bytes: usize) !u64 {
+        const data = try readReplay(dir, name, bytes);
+        defer t.allocator.free(data);
+        return b.upload(data);
+    }
+    fn digest(b: *Bench, name: []const u8, addr: u64, len: usize) !void {
+        const dst = try t.allocator.alloc(u8, len);
+        defer t.allocator.free(dst);
+        try cuda.memory.download(b.d, addr, dst);
+        std.debug.print("WORDS {d} {d} {s} {d} {x}\n", .{ b.rows, b.prior, name, len, std.hash.XxHash64.hash(0, dst) });
+    }
+    pub fn measure(b: *Bench, label: []const u8, comptime f: anytype, args: anytype) !void {
+        try @call(.auto, f, args);
+        try b.s.synchronize();
+        var start = try cuda.Event.init(b.d, true);
+        defer start.deinit();
+        var end = try cuda.Event.init(b.d, true);
+        defer end.deinit();
+        var ms: [5]f32 = undefined;
+        const samples = ms[0..if (b.rows == 1) @as(usize, 5) else 3];
+        for (samples, 0..) |*v, j| {
+            try Control.step(b.pair_fd, 'S');
+            // Read 128 MiB and write 64 MiB outside the event interval.
+            try ops.addExpertPartial(b.k, b.s, b.flush, b.flush + (64 << 20), b.flush, (64 << 20) / 4);
+            try b.s.synchronize();
+            try start.record(b.s);
+            try @call(.auto, f, args);
+            try end.record(b.s);
+            try end.synchronize();
+            v.* = try cuda.Event.elapsedMs(start, end);
+            if (b.pair_fd != null) std.debug.print("SAMPLE {d} {d} {s} {d} {d:.6}\n", .{ b.rows, b.prior, label, j, v.* });
+        }
+        std.mem.sort(f32, samples, {}, std.sort.asc(f32));
+        std.debug.print("TIME {d} {s} {d:.6} {d:.6} {d:.6}\n", .{ b.rows, label, samples[samples.len / 2], samples[0], samples[samples.len - 1] });
+        {
+            try Control.step(b.pair_fd, 'T');
+            b.trace.begin();
+            defer b.trace.stop();
+            try @call(.auto, f, args);
+        }
+        try b.s.synchronize();
+        try b.trace.report(b.rows, label);
+    }
+};
+
+fn readReplay(dir: []const u8, name: []const u8, bytes: usize) ![]u8 {
+    const path = try std.fs.path.join(t.allocator, &.{ dir, name });
+    defer t.allocator.free(path);
+    const data = try std.Io.Dir.cwd().readFileAlloc(t.io, path, t.allocator, .limited(bytes + 1));
+    errdefer t.allocator.free(data);
+    try t.expectEqual(bytes, data.len);
+    return data;
+}
+
+fn randomBf16Buffer(b: *Bench, rng: std.Random, count: usize, scale: f32) !u64 {
+    const values = try t.allocator.alloc(u16, count);
+    defer t.allocator.free(values);
+    for (values) |*value|
+        value.* = @truncate(@as(u32, @bitCast((rng.float(f32) * 2 - 1) * scale)) >> 16);
+    return b.upload(values);
+}
+
+fn widen(norms: *cuda.norms.Norms, s: cuda.Stream, x: u64, fp32: cuda.DeviceBuffer, zero: u64, tmp: u64, rows: usize) !void {
+    try fp32.fill8(0, s.handle);
+    try norms.addRms(s, x, .bf16, fp32.ptr, null, zero, tmp, .f32, rows, D, 1);
+}
+
+fn route(b: *Bench, rows: usize) !void {
+    const inter = 512;
+    var layer: cuda.exl3_experts.Layer = .{
+        .dims = D,
+        .width = inter,
+        .experts = 256,
+        .codebook = .mul1,
+        .limit = 10,
+        .gate = 0,
+        .up = 0,
+        .down = 0,
+        .gate_k2 = 0,
+        .up_k2 = 0,
+        .down_k2 = 0,
+        .suh_g = 0,
+        .suh_u = 0,
+        .svh_g = 0,
+        .svh_u = 0,
+        .suh_d = 0,
+        .svh_d = 0,
+    };
+    inline for (.{ "gate", "up", "down" }, .{ "gate_k2", "up_k2", "down_k2" }, .{ "g", "u", "d" }, .{ 6, 6, 8 }) |field, bits, suffix, mock_k2| {
+        const k2 = if (replay != null) 6 else mock_k2;
+        const stride = D * inter * k2 / 16;
+        const base = if (replay) |dir| try b.file(dir, field ++ "_trellis", 256 * stride) else try b.buf(256 * stride, 0x19d42c85);
+        if (replay) |dir| {
+            const down = comptime std.mem.eql(u8, field, "down");
+            @field(layer, "suh_" ++ suffix) = try b.file(dir, field ++ "_suh", 256 * 2 * (if (down) inter else D));
+            @field(layer, "svh_" ++ suffix) = try b.file(dir, field ++ "_svh", 256 * 2 * (if (down) D else inter));
+        }
+        var table: [256]u64 = undefined;
+        for (&table, 0..) |*ptr, e| ptr.* = base + e * stride;
+        @field(layer, field) = try b.upload(&table);
+        @field(layer, bits) = try b.buf(256 * 4, k2);
+    }
+    if (replay == null) {
+        const sc = try b.buf(256 * D * 2, 0x28002800);
+        layer.suh_g = sc;
+        layer.suh_u = sc;
+        layer.suh_d = sc;
+        layer.svh_g = sc;
+        layer.svh_u = sc;
+        layer.svh_d = sc;
+    }
+    const shape: ops.RoutedShape = .{ .rows = @intCast(rows), .x_row_stride = D, .output_row_stride = D };
+    const x = try t.allocator.alloc(u16, rows * D);
+    defer t.allocator.free(x);
+    @memset(x, 0x3c00);
+    const ids: ?[]u8 = if (replay) |dir| try readReplay(dir, "ids", 2560 * 8) else null;
+    defer if (ids) |data| t.allocator.free(data);
+    const offset: usize = if (rows == 1) 2048 else 0;
+    if (ids) |data| {
+        for (0..rows) |i| for (0..8) |j| {
+            x[i * D + data[(offset + i) * 8 + j]] = @intCast(0x3f80 + (7 - j) * 16);
+        };
+    } else for (0..rows) |i| {
+        x[i * D + i % 32] = 0x3f80;
+    }
+    const w = try t.allocator.alloc(u16, 256 * D);
+    defer t.allocator.free(w);
+    @memset(w, 0);
+    for (0..256) |e| w[e * D + (if (ids != null) e else e / 8)] = 0x3f80;
+    const n = try ops.routedScratchBytes(shape, layer);
+    const args: ops.RoutedBuffers = .{ .layer = layer, .x = try b.upload(x), .router = try b.upload(w), .correction_bias = try b.buf(256 * 4, 0), .ids = try b.buf(rows * 8 * 4, 0), .weights = try b.buf(rows * 8 * 4, 0), .output = try b.buf(rows * D * 4, 0), .scratch = try b.buf(n, 0), .scratch_bytes = n };
+    try b.measure("routed", ops.routedExperts, .{ b.k, b.s, shape, args });
+    const picks = try t.allocator.alloc(i32, rows * 8);
+    defer t.allocator.free(picks);
+    try cuda.memory.download(b.d, args.ids, std.mem.sliceAsBytes(picks));
+    for (0..rows) |i| for (picks[i * 8 ..][0..8], 0..) |id, j| {
+        if (ids) |data| try t.expectEqual(@as(i32, data[(offset + i) * 8 + j]), id) else try t.expectEqual(@as(i32, @intCast(i % 32)), @divTrunc(id, 8));
+    };
+    try b.digest("experts", args.output, rows * D * 4);
+}
+
+fn index(b: *Bench, x: u64, rng: *std.Random.DefaultPrng, pages: bool, reverse: bool) !void {
+    const prior = b.prior;
+    const m = b.rows;
+    const rows: u32 = @intCast(m);
+    const bf: u32 = 0x3c803c80;
+    const ix: ops.IndexShape = .{ .rows = rows, .first_pos = prior, .capacity = prior + rows, .x_row_stride = D, .q_row_stride = 2048, .cache_stride = 128, .indices_stride = K };
+    const in = try ops.indexScratchBytes(ix);
+    const keys = try t.allocator.alloc(u16, (prior + m) * 128);
+    defer t.allocator.free(keys);
+    for (keys) |*v| v.* = @truncate(@as(u32, @bitCast(rng.random().float(f32) * 2 - 1)) >> 16);
+    const allocated = in + (if (pages) @as(usize, 24 << 10) else 0);
+    var ib: ops.IndexBuffers = .{ .x = x, .q_resid = x, .wq_b = try b.buf(4096 * 2048 * 2, bf), .wk = try b.buf(128 * D * 2, bf), .k_norm = try b.buf(128 * 4, 0x3f800000), .k_bias = try b.buf(128 * 4, 0), .weights_proj = try b.buf(32 * D * 4, 0x3b800000), .cache = try b.upload(keys), .indices = try b.buf(m * K * 4, 0), .scratch = try b.buf(allocated, 0), .scratch_bytes = in };
+    const cases = if (reverse) [2]bool{ true, false } else [2]bool{ false, true };
+    for (cases) |wide| {
+        if (wide and !pages) continue;
+        ib.scratch_bytes = if (wide) allocated else in;
+        const label = if (wide) "index_8k" else "index";
+        try b.measure(label, ops.selectTokens, .{ b.k, b.s, ix, ib });
+        try b.digest(label, ib.indices, m * K * 4);
+    }
+}
+
+fn measure(b: *Bench) !void {
+    const m = b.rows;
+    const prior = b.prior;
+    std.debug.print("\nCASE {d} {d}\n", .{ m, prior });
+    const rows: u32 = @intCast(m);
+    const bf: u32 = 0x3c803c80;
+    const unit: u32 = 0x3f803f80;
+    b.flush = try b.buf(128 << 20, 0);
+    var gemm = try cuda.vit.Gemms.init(t.allocator, b.d);
+    defer gemm.deinit();
+    var norms = try cuda.norms.Norms.load(b.d);
+    defer norms.unload();
+    var act = try cuda.act_rows.ActRows.load(b.d);
+    defer act.unload();
+    const streams = try b.buf(4 * m * D * 2, bf);
+    var embed = try cuda.embed_rows.EmbedRows.load(b.d);
+    defer embed.unload();
+    const tokens = try t.allocator.alloc(i32, m);
+    defer t.allocator.free(tokens);
+    for (tokens, 0..) |*id, i| id.* = @intCast((i * 953) % m);
+    const table = try b.buf(m * D * 2, bf);
+    try b.measure("embedding", cuda.embed_rows.EmbedRows.bf16Copies, .{ &embed, b.s, try b.upload(tokens), table, streams, m, D, @as(usize, 4) });
+    const x = try b.buf(m * D * 2, bf);
+    const x2 = try b.buf(m * D * 2, bf);
+    const post = try b.buf(m * 4 * 4, 0x3f800000);
+    const hcshape: ops.IhcShape = .{ .rows = rows };
+    const read: ops.IhcRead = .{ .streams = streams, .projection = try b.buf(8 * 4 * D * 4, 0x39800000), .base = try b.buf(8 * 4, 0), .scale = try b.buf(2 * 4, 0x3f800000), .output = x2, .post = post };
+    try b.measure("ihc_read", ops.ihcRead, .{ b.k, b.s, hcshape, read });
+    try b.measure("ihc_head", ops.ihcHead, .{ b.k, b.s, hcshape, read });
+    if (m > 1) {
+        var last = read;
+        last.streams += (m - 1) * 4 * D * 2;
+        try b.measure("ihc_head_last", ops.ihcHead, .{ b.k, b.s, ops.IhcShape{ .rows = 1 }, last });
+    }
+    const dest = try b.buf(4 * m * D * 2, 0);
+    try b.measure("ihc_write", ops.ihcWrite, .{ b.k, b.s, hcshape, ops.IhcWrite{ .residual = streams, .branch = x2, .post = post, .output = dest } });
+    const gain = try b.buf(D * 2, unit);
+    const tmp = try b.buf(m * D * 4, 0);
+    inline for (.{ D, 2048 }, .{ "norm_hidden", "norm_q" }) |width, label| {
+        try b.measure(label, cuda.norms.Norms.addRmsTail, .{ &norms, b.s, x, null, gain, tmp, x2, null, m, width, @as(f32, 1e-5), cuda.norms.Tail{ .round = true } });
+    }
+    if (m > 1) try b.measure("norm_head_last", cuda.norms.Norms.addRmsTail, .{ &norms, b.s, x + (m - 1) * D * 2, null, gain, tmp, x2, null, @as(usize, 1), D, @as(f32, 1e-5), cuda.norms.Tail{ .round = true } });
+    // The GEMM inputs and outputs are independent, tight local matrix views.
+    inline for (.{ "q_a", "q_b", "kv_a", "gate_linear", "o_proj", "dense_gate", "dense_up", "dense_down", "shared_gate", "shared_up", "shared_down" }, .{ D, 2048, D, D, H * 256, D, D, 4608, D, D, 512 }, .{ 2048, H * 256, 576, H * 256, D, 4608, 4608, D, 512, 512, D }, .{ false, false, false, false, true, false, false, true, false, false, true }) |label, inner, col, fp32| {
+        const weight = try b.buf(col * inner * 2, bf);
+        const column = comptime std.mem.eql(u8, label, "q_b") or std.mem.eql(u8, label, "gate_linear") or
+            std.mem.endsWith(u8, label, "_gate") or std.mem.endsWith(u8, label, "_up");
+        if (column) {
+            var reference = try cuda.cublaslt.Linear.init(&gemm.lt, m, col * 4, inner, .bf16, gemm.workspace.len);
+            defer reference.deinit();
+            var local = try cuda.cublaslt.Linear.init(&gemm.lt, m, col, inner, .bf16, gemm.workspace.len);
+            defer local.deinit();
+            try ops.matchColumnPlan(&reference, &local, gemm.workspace.len);
+            try b.measure(label, cuda.cublaslt.Linear.run, .{ &local, x, weight, x2, gemm.workspace.ptr, gemm.workspace.len, b.s.handle });
+        } else try b.measure(label, cuda.vit.Gemms.run, .{ &gemm, b.s, x, weight, if (fp32) tmp else x2, m, col, inner, if (fp32) cuda.cublaslt.DataType.f32 else .bf16 });
+    }
+    inline for (.{ 4608, 512 }, .{ "dense_swiglu", "shared_swiglu" }) |w, label|
+        try b.measure(label, cuda.act_rows.ActRows.swiglu, .{ &act, b.s, x, w, x2, w, tmp, null, m, w });
+    const shape: ops.MlaShape = .{ .rows = rows, .heads = H, .capacity = prior + rows, .first_pos = prior, .key_count = K };
+    const aq = try b.buf(m * H * 576 * 2, bf);
+    const cache = try b.buf((prior + m) * 576 * 2, bf);
+    const kvb = try b.buf(H * 448 * 512 * 2, bf);
+    const project: ops.MlaProject = .{ .q = x, .kv = x2, .kv_norm = gain, .kv_b = kvb, .absorbed_q = aq, .cache = cache };
+    try b.measure("mla_project", ops.mlaProject, .{ b.k, b.s, shape, project });
+    const idx = try t.allocator.alloc(i32, m * K);
+    defer t.allocator.free(idx);
+    for (0..m) |i| for (idx[i * K ..][0..K], 0..) |*id, j| {
+        id.* = @intCast(j * (prior / K) + i % (prior / K));
+    };
+    const an = try ops.scratchBytes(shape);
+    const ab: ops.MlaAttend = .{ .absorbed_q = aq, .cache = cache, .kv_b = kvb, .gate = x, .sinks = try b.buf(H * 4, 0), .indices = try b.upload(idx), .scratch = try b.buf(an, 0), .scratch_bytes = an, .output = x2 };
+    try b.measure("mla_attend", ops.mlaAttend, .{ b.k, b.s, shape, ab });
+    try b.digest("attention", ab.output, m * H * 256 * 2);
+    try b.digest("attention_workspace", ab.scratch, an);
+    var rng = std.Random.DefaultPrng.init(0x54f4);
+    try index(b, x, &rng, false, false);
+    try route(b, m);
+    const planes = try b.buf(4 * m * D * 4, 0x3c800000);
+    try b.measure("shared_add", ops.addExpertPartial, .{ b.k, b.s, planes, planes + m * D * 4, tmp, m * D });
+    try b.measure("rank_fold", ops.foldRank4, .{ b.k, b.s, planes, x2, m * D });
+    const fp32: cuda.DeviceBuffer = .{ .ptr = try b.buf(m * D * 4, 0), .d = b.d, .len = m * D * 4, .borrowed = true };
+    try b.measure("head_widen", widen, .{ &norms, b.s, x, fp32, try b.buf(D * 4, 0), tmp, m });
+    if (m > 1) {
+        const last: cuda.DeviceBuffer = .{ .ptr = fp32.ptr, .d = b.d, .len = D * 4, .borrowed = true };
+        try b.measure("head_widen_last", widen, .{ &norms, b.s, x + (m - 1) * D * 2, last, try b.buf(D * 4, 0), tmp, @as(usize, 1) });
+    }
+    const ws = 32 << 20;
+    var head = try cuda.cublaslt.Linear.initTyped(&gemm.lt, m, 30208, D, .f32, .f32, ws, .none);
+    defer head.deinit();
+    var whole_head = try cuda.cublaslt.Linear.initTyped(&gemm.lt, m, 4 * 30208, D, .f32, .f32, ws, .none);
+    defer whole_head.deinit();
+    try ops.matchColumnPlan(&whole_head, &head, ws);
+    const vocab = try b.buf(30208 * D * 4, 0x3b800000);
+    const logits = try b.buf(m * 30208 * 4, 0);
+    // Exercise cancellation and rounding in the final-row head check.
+    const sample = try t.allocator.alloc(f32, 128 * D);
+    defer t.allocator.free(sample);
+    for (sample) |*v| v.* = (rng.random().float(f32) - 0.5) * 0.02;
+    var vocab_buf = cuda.DeviceBuffer{ .d = b.d, .ptr = vocab, .len = 30208 * D * 4, .borrowed = true };
+    for (0..30208 / 128) |i| try vocab_buf.upload(i * sample.len * 4, std.mem.sliceAsBytes(sample));
+    for (sample[0..D]) |*v| v.* = @bitCast(@as(u32, @bitCast(rng.random().float(f32) * 2 - 1)) & 0xffff0000);
+    try fp32.upload((m - 1) * D * 4, std.mem.sliceAsBytes(sample[0..D]));
+    try b.measure("lm_head", cuda.cublaslt.Linear.run, .{ &head, fp32.ptr, vocab, logits, gemm.workspace.ptr, ws, b.s.handle });
+    if (m > 1) {
+        var last = try cuda.cublaslt.Linear.initTyped(&gemm.lt, 1, 30208, D, .f32, .f32, ws, .none);
+        defer last.deinit();
+        try ops.matchColumnPlan(&head, &last, ws);
+        const output = try b.buf(30208 * 4, 0);
+        try b.measure("lm_head_last", cuda.cublaslt.Linear.run, .{ &last, fp32.ptr + (m - 1) * D * 4, vocab, output, gemm.workspace.ptr, ws, b.s.handle });
+        const ref = try t.allocator.alloc(f32, 30208);
+        defer t.allocator.free(ref);
+        try cuda.memory.download(b.d, logits + (m - 1) * 30208 * 4, std.mem.sliceAsBytes(ref));
+        const got = sample[0..30208];
+        try cuda.memory.download(b.d, output, std.mem.sliceAsBytes(got));
+        var changed: usize = 0;
+        var drift: f32 = 0;
+        for (got, ref) |v, w| {
+            changed += @intFromBool(@as(u32, @bitCast(v)) != @as(u32, @bitCast(w)));
+            drift = @max(drift, @abs(v - w));
+        }
+        std.debug.print("HEAD_LAST {d} {d} changed={d} max_abs={e}\n", .{ m, prior, changed, drift });
+        try t.expectEqual(@as(usize, 0), changed);
+    }
+    if (m == 1 and @import("bench_options").decode_probe) try @import("contract_hy4_bench_decode.zig").probe(b, &gemm);
+}
+
+fn attentionOnly(b: *Bench) !void {
+    const m = b.rows;
+    const rows: u32 = @intCast(m);
+    const key_count: u32 = @min(K, b.prior);
+    const keys: usize = key_count;
+    const bf: u32 = 0x3c803c80;
+    var prng = std.Random.DefaultPrng.init(0xa771f20 ^ (@as(u64, b.prior) << 8) ^ rows);
+    const rng = prng.random();
+    b.flush = try b.buf(128 << 20, 0);
+    const q = try randomBf16Buffer(b, rng, m * H * 256, 0.5);
+    const kv = try randomBf16Buffer(b, rng, m * 576, 0.5);
+    const gain = try b.buf(512 * 2, 0x3f803f80);
+    const aq = try b.buf(m * H * 576 * 2, bf);
+    const cache = try randomBf16Buffer(b, rng, (@as(usize, b.prior) + m) * 576, 0.5);
+    const kvb_bytes = H * 448 * 512 * 2;
+    const kvb = if (Control.getenv("HY4_BENCH_KVB")) |raw| loaded: {
+        const data = try std.Io.Dir.cwd().readFileAlloc(t.io, std.mem.span(raw), t.allocator, .limited(kvb_bytes + 1));
+        defer t.allocator.free(data);
+        try t.expectEqual(kvb_bytes, data.len);
+        break :loaded try b.upload(data);
+    } else try b.buf(kvb_bytes, bf);
+    const gate = try randomBf16Buffer(b, rng, m * H * 256, 1.0);
+    const output = try b.buf(m * H * 256 * 2, 0);
+    const shape: ops.MlaShape = .{ .rows = rows, .heads = H, .capacity = b.prior + rows, .first_pos = b.prior, .key_count = key_count };
+    const project: ops.MlaProject = .{ .q = q, .kv = kv, .kv_norm = gain, .kv_b = kvb, .absorbed_q = aq, .cache = cache };
+    try b.measure("mla_project", ops.mlaProject, .{ b.k, b.s, shape, project });
+    try b.digest("absorbed_q", aq, m * H * 576 * 2);
+
+    const ids = try t.allocator.alloc(i32, m * keys);
+    defer t.allocator.free(ids);
+    const spacing = @as(usize, b.prior) / keys;
+    for (0..m) |row| {
+        for (0..keys) |j| ids[row * keys + j] = @intCast(j * spacing + row % spacing);
+    }
+    const scratch_bytes = try ops.scratchBytes(shape);
+    const attend: ops.MlaAttend = .{ .absorbed_q = aq, .cache = cache, .kv_b = kvb, .gate = gate, .sinks = try b.buf(H * 4, 0), .indices = try b.upload(ids), .scratch = try b.buf(scratch_bytes, 0), .scratch_bytes = scratch_bytes, .output = output };
+    try b.measure("mla_attend", ops.mlaAttend, .{ b.k, b.s, shape, attend });
+    try b.digest("attention", output, m * H * 256 * 2);
+}
+
+test "full Hy4 tensor parallel rank timings" {
+    const pair_fd = try Control.socket();
+    try Control.step(pair_fd, 'I');
+    var d = try cuda.Driver.open();
+    defer d.close();
+    var ctx = try cuda.Context.init(&d, 0);
+    defer ctx.deinit();
+    if (Control.getenv("HY4_BENCH_COLUMN_PLANS") != null) return @import("contract_hy4_bench_columns.zig").run();
+    var k = try ops.Kernels.load(&d);
+    defer k.deinit();
+    var s = try cuda.Stream.init(&d, true);
+    defer s.deinit();
+    var trace = try Trace.init(&d);
+    defer trace.deinit();
+    if (Control.getenv("HY4_BENCH_ATTN_ONLY") != null) {
+        for ([_]u32{ 512, 32768 }) |prior| for ([_]usize{ 1, 2, 3, 7 }) |rows| {
+            var b: Bench = .{ .d = &d, .s = s, .k = &k, .trace = &trace, .pair_fd = pair_fd, .rows = rows, .prior = prior };
+            defer b.deinit();
+            try attentionOnly(&b);
+        };
+        return;
+    }
+    if (Control.getenv("HY4_BENCH_INDEX_SWEEP") != null) {
+        for ([_]u32{ 32768, 65536, 131072, 131072, 65536, 32768 }, 0..) |keys, i| {
+            var b: Bench = .{ .d = &d, .s = s, .k = &k, .trace = &trace, .pair_fd = pair_fd, .rows = 1, .prior = keys - 1 };
+            defer b.deinit();
+            b.flush = try b.buf(128 << 20, 0);
+            const x = try b.buf(D * 2, 0x3c803c80);
+            var rng = std.Random.DefaultPrng.init(0x54f4);
+            std.debug.print("KEYS {d}\n", .{keys});
+            try index(&b, x, &rng, Control.getenv("HY4_BENCH_INDEX_PAGES") != null, i >= 3);
+        }
+        return;
+    }
+    for ([_]usize{ 1, 2048, 2048 }, [_]u32{ 32768, 4096, 32768 }) |m, prior| {
+        var b: Bench = .{ .d = &d, .s = s, .k = &k, .trace = &trace, .pair_fd = pair_fd, .rows = m, .prior = prior };
+        defer b.deinit();
+        try measure(&b);
+    }
+}
diff --git a/zig/kernels/cuda/contract_hy4_bench_columns.zig b/zig/kernels/cuda/contract_hy4_bench_columns.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f43a278fbe87551e89f8447db1b4dd34a3d59007
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_bench_columns.zig
@@ -0,0 +1,43 @@
+//! Check the full-width algorithm against each actual TP4 output-column slice on the installed cuBLASLt.
+const std = @import("std");
+const cuda = @import("cuda");
+const lt = cuda.cublaslt;
+const ws = 32 << 20;
+
+fn check(name: []const u8, rows: usize, src: *const lt.Linear, dst: *lt.Linear) !bool {
+    var result: lt.Heuristic = undefined;
+    const rc = dst.lt.api.cublasLtMatmulAlgoCheck(dst.handle, dst.desc, dst.a, dst.b, dst.c, dst.c, &src.algo, &result);
+    const state: ?lt.Status = if (rc == 0) result.state else null;
+    const need: ?usize = if (state == 0) result.workspace_size else null;
+    const pinned = if (cuda.hy4_ops.matchColumnPlan(src, dst, ws)) |_| true else |err| switch (err) {
+        error.NoMatchingHy4ColumnPlan => false,
+        else => return err,
+    };
+    std.debug.print("PLAN rows={d} shape={s} pinned={} api={d} state={?d} workspace={?d}\n", .{ rows, name, pinned, rc, state, need });
+    return pinned;
+}
+
+pub fn run() !void {
+    var lib = try lt.Library.open();
+    defer lib.close();
+    std.debug.print("CUBLASLT version={d} workspace={d}\n", .{ lib.api.cublasLtGetVersion(), ws });
+    for ([_]usize{ 1, 5, 7, 16, 1024 }) |m| {
+        inline for (.{ "q_b", "linear_gate", "dense_gate_up", "shared_gate_up", "expert_bf16_gate_up", "vocab" }, .{ 2048, 6144, 6144, 6144, 6144, 6144 }, .{ 4096, 4096, 4608, 512, 1024, 30208 }) |name, k, n| {
+            const vocab = comptime std.mem.eql(u8, name, "vocab");
+            const dtype: lt.DataType = if (vocab) .f32 else .bf16;
+            var full = try lt.Linear.initTyped(&lib, m, 4 * n, k, dtype, dtype, ws, .none);
+            defer full.deinit();
+            var local = try lt.Linear.initTyped(&lib, m, n, k, dtype, dtype, ws, .none);
+            defer local.deinit();
+            _ = try check(name, m, &full, &local);
+            if (vocab) {
+                var last = try lt.Linear.initTyped(&lib, 1, n, k, dtype, dtype, ws, .none);
+                defer last.deinit();
+                _ = try check("vocab_slice_to_last", m, &local, &last);
+                var last_full = try lt.Linear.initTyped(&lib, 1, 4 * n, k, dtype, dtype, ws, .none);
+                defer last_full.deinit();
+                _ = try check("vocab_full_to_last", m, &full, &last_full);
+            }
+        }
+    }
+}
diff --git a/zig/kernels/cuda/contract_hy4_bench_decode.zig b/zig/kernels/cuda/contract_hy4_bench_decode.zig
new file mode 100644
index 0000000000000000000000000000000000000000..0bb278f581a3572ecd5e46c92ea79ff90f0c63b0
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_bench_decode.zig
@@ -0,0 +1,104 @@
+// Measure unshipped GEMV candidates against the original decode plans.
+const std = @import("std");
+const cuda = @import("cuda");
+const t = std.testing;
+
+fn bf(v: u16) f32 {
+    return @bitCast(@as(u32, v) << 16);
+}
+
+const Linear = cuda.cublaslt.Linear;
+
+fn runThree(plans: [3]*Linear, x: u64, w: u64, y: u64, work: cuda.DeviceBuffer, s: cuda.Stream) !void {
+    for (plans, [_]usize{ 0, 2048, 2624 }) |plan, offset|
+        try plan.run(x, w + offset * 6144 * 2, y + offset * 2, work.ptr, work.len, s.handle);
+}
+
+fn runHalves(plan: *Linear, x: u64, w: u64, y: u64, work: cuda.DeviceBuffer, s: cuda.Stream) !void {
+    for (0..2) |half| try plan.run(x, w + half * 3072 * 4096 * 2, y + half * 3072 * 4, work.ptr, work.len, s.handle);
+}
+
+fn time(b: anytype, start: cuda.Event, stop: cuda.Event, comptime f: anytype, args: anytype) !f32 {
+    try cuda.hy4_ops.addExpertPartial(b.k, b.s, b.flush, b.flush + (64 << 20), b.flush, (64 << 20) / 4);
+    try b.s.synchronize();
+    try start.record(b.s);
+    try @call(.auto, f, args);
+    try stop.record(b.s);
+    try stop.synchronize();
+    return cuda.Event.elapsedMs(start, stop);
+}
+
+pub fn probe(b: anytype, g: *cuda.vit.Gemms) !void {
+    const d = 6144;
+    const n = 2048 + 576 + 4096;
+    var gen = std.Random.DefaultPrng.init(20261132);
+    const w = try t.allocator.alloc(u16, n * d);
+    defer t.allocator.free(w);
+    for (w) |*v| v.* = @truncate(@as(u32, @bitCast(gen.random().float(f32) * 2 - 1)) >> 16);
+    const weight = try b.upload(w);
+    const x = try b.buf(d * 2, 0);
+    const out = try b.buf(n * 4, 0);
+    const trial = try b.buf(n * 4, 0);
+    const ws = g.workspace.len;
+    var q = try Linear.init(&g.lt, 1, 2048, d, .bf16, ws);
+    defer q.deinit();
+    var kv = try Linear.init(&g.lt, 1, 576, d, .bf16, ws);
+    defer kv.deinit();
+    var gate = try Linear.init(&g.lt, 1, 4096, d, .bf16, ws);
+    defer gate.deinit();
+    var wide_gate = try Linear.init(&g.lt, 1, 4 * 4096, d, .bf16, ws);
+    defer wide_gate.deinit();
+    try cuda.hy4_ops.matchColumnPlan(&wide_gate, &gate, ws);
+    var fused = try Linear.init(&g.lt, 1, n, d, .bf16, ws);
+    defer fused.deinit();
+    var o = try Linear.init(&g.lt, 1, d, 4096, .f32, ws);
+    defer o.deinit();
+    var half = try Linear.init(&g.lt, 1, d / 2, 4096, .f32, ws);
+    defer half.deinit();
+    var mismatch: [4]usize = @splat(0);
+    var max_abs: [4]f32 = @splat(0);
+    var xmem: cuda.DeviceBuffer = .{ .d = b.d, .ptr = x, .len = d * 2, .borrowed = true };
+    var ref: [n]u16 = undefined;
+    var got: [n]u16 = undefined;
+    var ref_o: [d]f32 = undefined;
+    var got_o: [d]f32 = undefined;
+    var start = try cuda.Event.init(b.d, true);
+    defer start.deinit();
+    var stop = try cuda.Event.init(b.d, true);
+    defer stop.deinit();
+    var ms: [4][16]f32 = undefined;
+    for (0..16) |round| {
+        for (w[0..d]) |*v| v.* = @truncate(@as(u32, @bitCast(gen.random().float(f32) * 2 - 1)) >> 16);
+        try xmem.upload(0, std.mem.sliceAsBytes(w[0..d]));
+        for (0..2) |step| {
+            if ((step + round) % 2 == 0) {
+                ms[0][round] = try time(b, start, stop, runThree, .{ [3]*Linear{ &q, &kv, &gate }, x, weight, out, g.workspace, b.s });
+            } else ms[1][round] = try time(b, start, stop, Linear.run, .{ &fused, x, weight, trial, g.workspace.ptr, ws, b.s.handle });
+        }
+        try cuda.memory.download(b.d, out, std.mem.asBytes(&ref));
+        try cuda.memory.download(b.d, trial, std.mem.asBytes(&got));
+        for (ref, got, 0..) |a, v, i| {
+            const op: usize = if (i < 2048) 0 else if (i < 2624) 1 else 2;
+            mismatch[op] += @intFromBool(a != v);
+            max_abs[op] = @max(max_abs[op], @abs(bf(v) - bf(a)));
+        }
+        for (0..2) |step| {
+            if ((step + round) % 2 == 0) {
+                ms[2][round] = try time(b, start, stop, Linear.run, .{ &o, x, weight, out, g.workspace.ptr, ws, b.s.handle });
+            } else ms[3][round] = try time(b, start, stop, runHalves, .{ &half, x, weight, trial, g.workspace, b.s });
+        }
+        try cuda.memory.download(b.d, out, std.mem.asBytes(&ref_o));
+        try cuda.memory.download(b.d, trial, std.mem.asBytes(&got_o));
+        for (ref_o, got_o) |a, v| {
+            mismatch[3] += @intFromBool(@as(u32, @bitCast(a)) != @as(u32, @bitCast(v)));
+            max_abs[3] = @max(max_abs[3], @abs(a - v));
+        }
+    }
+    for ([_][]const u8{ "q_a", "kv_a", "gate_linear", "o_proj" }, mismatch, max_abs) |name, count, drift|
+        std.debug.print("DECODE_PROBE {s} changed={d} max_abs={e}\n", .{ name, count, drift });
+    for ([_][]const u8{ "separate_qkv_gate", "fused_qkv_gate", "full_o", "split_o" }, &ms) |name, *vals| {
+        const samples = vals[2..];
+        std.mem.sort(f32, samples, {}, std.sort.asc(f32));
+        std.debug.print("PROJECTION_MS {s} median={d:.6} min={d:.6} max={d:.6}\n", .{ name, (samples[6] + samples[7]) / 2, samples[0], samples[13] });
+    }
+}
diff --git a/zig/kernels/cuda/contract_hy4_bench_trace.zig b/zig/kernels/cuda/contract_hy4_bench_trace.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9b0200938946c540e14fcc73684e778512f3003c
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_bench_trace.zig
@@ -0,0 +1,95 @@
+//! Separate attribution pass. Each pair of CUDA events brackets one actual driver launch.
+const std = @import("std");
+const cuda = @import("cuda");
+const abi = cuda.abi;
+const Params = ?[*]?*anyopaque;
+const Sample = struct { start: cuda.Event, end: cuda.Event, func: abi.Function = null };
+const Stat = struct { count: usize = 0, ms: f64 = 0 };
+
+pub const Trace = struct {
+    d: *cuda.Driver,
+    samples: []Sample,
+    used: usize = 0,
+    overflow: bool = false,
+    plain: @FieldType(abi.Api, "cuLaunchKernel"),
+    extended: @FieldType(abi.Api, "cuLaunchKernelEx"),
+    pub fn init(d: *cuda.Driver) !Trace {
+        const samples = try std.testing.allocator.alloc(Sample, 1536);
+        errdefer std.testing.allocator.free(samples);
+        var count: usize = 0;
+        errdefer for (samples[0..count]) |*s| {
+            s.start.deinit();
+            s.end.deinit();
+        };
+        for (samples) |*s| {
+            s.start = try cuda.Event.init(d, true);
+            errdefer s.start.deinit();
+            s.end = try cuda.Event.init(d, true);
+            count += 1;
+        }
+        return .{ .d = d, .samples = samples, .plain = d.api.cuLaunchKernel, .extended = d.api.cuLaunchKernelEx };
+    }
+    pub fn deinit(self: *Trace) void {
+        for (self.samples) |*s| {
+            s.start.deinit();
+            s.end.deinit();
+        }
+        std.testing.allocator.free(self.samples);
+    }
+    pub fn begin(self: *Trace) void {
+        self.used = 0;
+        self.overflow = false;
+        active = self;
+        self.d.api.cuLaunchKernel = plain;
+        self.d.api.cuLaunchKernelEx = extended;
+    }
+    pub fn stop(self: *Trace) void {
+        self.d.api.cuLaunchKernel = self.plain;
+        self.d.api.cuLaunchKernelEx = self.extended;
+        active = null;
+    }
+    pub fn report(self: *Trace, rows: usize, label: []const u8) !void {
+        if (self.overflow) return error.Hy4TraceTooSmall;
+        var map: std.AutoArrayHashMapUnmanaged(usize, Stat) = .empty;
+        defer map.deinit(std.testing.allocator);
+        for (self.samples[0..self.used]) |s| {
+            const g = try map.getOrPut(std.testing.allocator, @intFromPtr(s.func));
+            if (!g.found_existing) g.value_ptr.* = .{};
+            g.value_ptr.count += 1;
+            g.value_ptr.ms += try cuda.Event.elapsedMs(s.start, s.end);
+        }
+        for (map.keys(), map.values()) |f, v| {
+            var name: ?[*:0]const u8 = null;
+            try self.d.check(self.d.func_name.?(&name, @ptrFromInt(f)), "cuFuncGetName");
+            std.debug.print("SYMBOL {d} {s} {s} {d} {d:.6}\n", .{ rows, label, std.mem.span(name.?), v.count, v.ms });
+        }
+    }
+};
+threadlocal var active: ?*Trace = null;
+fn next(f: abi.Function) ?*Sample {
+    const t = active.?;
+    if (t.used == t.samples.len) {
+        t.overflow = true;
+        return null;
+    }
+    const s = &t.samples[t.used];
+    t.used += 1;
+    s.func = f;
+    return s;
+}
+fn plain(f: abi.Function, x: u32, y: u32, z: u32, bx: u32, by: u32, bz: u32, sh: u32, stream: abi.Stream, args: Params, extra: Params) callconv(.c) abi.Result {
+    const t = active.?;
+    const s = next(f) orelse return t.plain(f, x, y, z, bx, by, bz, sh, stream, args, extra);
+    var rc = t.d.api.cuEventRecord(s.start.handle, stream);
+    if (rc == 0) rc = t.plain(f, x, y, z, bx, by, bz, sh, stream, args, extra);
+    if (rc == 0) rc = t.d.api.cuEventRecord(s.end.handle, stream);
+    return rc;
+}
+fn extended(c: *const abi.LaunchConfig, f: abi.Function, args: Params, extra: Params) callconv(.c) abi.Result {
+    const t = active.?;
+    const s = next(f) orelse return t.extended(c, f, args, extra);
+    var rc = t.d.api.cuEventRecord(s.start.handle, c.stream);
+    if (rc == 0) rc = t.extended(c, f, args, extra);
+    if (rc == 0) rc = t.d.api.cuEventRecord(s.end.handle, c.stream);
+    return rc;
+}
diff --git a/zig/kernels/cuda/contract_hy4_entries.zig b/zig/kernels/cuda/contract_hy4_entries.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5888cd6ac94f31226eb8fc1da88db0a9d8b4f4ba
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_entries.zig
@@ -0,0 +1,227 @@
+//! Gates 1-4 run once per device symbol. Each control changes one real kernel input.
+const std = @import("std");
+const cuda = @import("cuda");
+const ct = @import("core").contract;
+const c = ct.spec;
+const g = ct.gates;
+const Rig = @import("rig").Rig;
+const oracle = @import("contract_hy4_reference.zig");
+const bf = @import("bf16_round");
+
+const Entry = struct {
+    rig: *Rig,
+    kernels: *const cuda.hy4_ops.Kernels,
+    kind: oracle.Kind,
+    control: bool,
+    pool: std.heap.ArenaAllocator,
+    shape: c.Shape = undefined,
+    x: []u16 = &.{},
+    args: cuda.Args = .{},
+    func: cuda.Function = undefined,
+    config: cuda.Config = undefined,
+    restore_src: u64 = 0,
+    restore_dst: u64 = 0,
+    restore_bytes: usize = 0,
+
+    fn bind(self: *Entry, f: cuda.Function, grid: cuda.Dim3, threads: u32, values: anytype) void {
+        self.func = f;
+        self.config = .{ .grid = grid, .block = .{ .x = threads } };
+        self.args = .{};
+        inline for (values) |v| self.args.add(v);
+    }
+    fn buf(self: *Entry, x: anytype) !u64 {
+        return self.rig.input(std.mem.sliceAsBytes(x));
+    }
+    fn constant(self: *Entry, comptime T: type, n: usize, value: T) !u64 {
+        const host = try self.pool.allocator().alloc(T, n);
+        @memset(host, value);
+        return self.buf(host);
+    }
+
+    pub fn prepare(self: *Entry, s: c.Shape, fill: g.Fill, seed: u64) !bool {
+        self.rig.reset();
+        _ = self.pool.reset(.free_all);
+        const a = self.pool.allocator();
+        self.shape = s;
+        self.x = try a.alloc(u16, s.rows * s.k);
+        oracle.input(self.x, s, self.kind, fill, seed);
+        const rows: u32 = @intCast(s.rows);
+        const n: u32 = @intCast(s.n);
+        const k: u32 = @intCast(s.k);
+        const one: u32 = 1;
+        const zero: u32 = 0;
+        const null_ptr: u64 = 0;
+        const coefficient = bf.bits(if (self.control) -1 else 1);
+        const ihc: cuda.hy4_ops.IhcShape = .{ .rows = rows, .width = n, .streams_row_stride = 4 * n, .stream_stride = n, .hidden_stride = n };
+        const result = try self.rig.output(self.count() * switch (self.kind) {
+            .scores, .softmax, .context, .index_linear, .index_scores, .index_select, .expert_partial => @as(usize, 4),
+            else => 2,
+        });
+        self.restore_src = 0;
+        self.restore_bytes = self.count() * 4;
+        switch (self.kind) {
+            .collapse => {
+                const x = try self.buf(self.x);
+                const w = try self.constant(f32, 4 * s.k, 1);
+                const bias = try self.constant(f32, 4, if (self.control) 8 else 0);
+                const scale = try self.constant(f32, 1, 1 / @as(f32, @floatFromInt(k)));
+                self.bind(self.kernels.collapse, .{ .x = rows }, 256, .{ x, w, bias, scale, result, null_ptr, ihc, @as(u32, 4) });
+            },
+            .write => {
+                const res = try self.buf(self.x);
+                const branch = try self.constant(u16, s.rows * s.n, coefficient);
+                const post = try self.constant(f32, s.rows * 4, 0.25);
+                self.bind(self.kernels.write, .{ .x = rows, .y = (4 * n + 255) / 256 }, 256, .{ res, branch, post, result, ihc });
+            },
+            .project_q, .cache_k => {
+                const inputs = try a.alloc(u16, s.rows * (s.k + 2));
+                for (0..s.rows) |row| {
+                    const slice = inputs[row * (s.k + 2) ..][0 .. s.k + 2];
+                    @memcpy(slice[0..s.k], self.x[row * s.k ..][0..s.k]);
+                    @memset(slice[s.k..], 0);
+                }
+                const x = try self.buf(inputs);
+                if (self.kind == .project_q) {
+                    const w = try self.constant(u16, (s.k + 1) * s.n, coefficient);
+                    self.bind(self.kernels.project_q, .{ .x = rows }, 128, .{
+                        x, w, result, k + 2, k + 2, n + 2, n + 2, n, k, @as(u32, 2), one, zero, @as(f32, 1e7),
+                    });
+                } else {
+                    const gain = try self.constant(u16, s.k, bf.bits(if (self.control) -0.75 else 0.75));
+                    self.bind(self.kernels.cache_k, .{ .x = rows }, 128, .{
+                        x, gain, result, k + 2, k + 2, k, @as(u32, 2), zero, @as(f32, 1e7), @as(f32, 1e-5),
+                    });
+                }
+            },
+            .scores => {
+                const x = try self.buf(self.x);
+                const w = try self.constant(u16, s.k, coefficient);
+                self.bind(self.kernels.scores, .{ .x = rows }, 128, .{
+                    x, w, null_ptr, result, one, k, k, k, k, one, one, zero, @as(f32, if (k == 576) 1.0 / 16.0 else 0.25), zero,
+                });
+            },
+            .softmax, .gated_value => {
+                const wide = try a.alloc(f32, self.x.len);
+                for (wide, self.x) |*dst, src| dst.* = bf.value(src);
+                const x = try self.buf(wide);
+                if (self.kind == .softmax) {
+                    self.restore_src = x;
+                    self.restore_dst = result;
+                    const sink = try self.constant(f32, 1, if (self.control) 10000 else 0);
+                    self.bind(self.kernels.softmax, .{ .x = rows }, 128, .{ result, sink, one, k });
+                } else {
+                    const w = try self.constant(u16, (1 + s.n) * s.k, coefficient);
+                    const gate = try self.constant(u16, s.rows * s.n, 0);
+                    self.bind(self.kernels.gated_value, .{ .x = rows, .z = n }, 128, .{ x, w, gate, result, one, k, one, n, n, n });
+                }
+            },
+            .expert_partial, .rank_fold => {
+                const elements: usize = s.rows * s.n;
+                const terms = try a.alloc(f32, elements * s.k);
+                for (0..s.k) |term| for (0..s.rows) |row| {
+                    const v = bf.value(self.x[row * s.k + term]);
+                    @memset(terms[term * elements + row * s.n ..][0..s.n], if (self.control and term == 0) 0 else v);
+                };
+                const p = try self.buf(terms);
+                const grid: cuda.Dim3 = .{ .x = @intCast((elements + 255) / 256) };
+                if (self.kind == .rank_fold) {
+                    self.bind(self.kernels.rank_fold, grid, 256, .{ p, result, elements });
+                } else self.bind(self.kernels.expert_partial, grid, 256, .{ p, p + elements * 4, result, elements });
+            },
+            .index_linear => {
+                const x = try self.buf(self.x);
+                const w = try self.constant(f32, s.n * s.k, if (self.control) -1 else 1);
+                self.bind(self.kernels.index_linear, .{ .x = (n + 3) / 4, .y = rows }, 128, .{ x, w, result, k, k, n, one });
+            },
+            .index_prepare => {
+                const x = try a.alloc(f32, self.x.len);
+                for (x, self.x) |*v, q| v.* = bf.value(q);
+                const gain = try self.constant(f32, s.n, if (self.control) -0.75 else 0.75);
+                const bias = try self.constant(f32, s.n, 0.125);
+                self.bind(self.kernels.index_prepare, .{ .x = rows }, 128, .{ try self.buf(x), gain, bias, result, one, n, @as(u32, 2), n, zero, @as(f32, 1e7), @as(f32, 1e-5) });
+            },
+            .index_scores => {
+                const q = try self.buf(self.x);
+                const cache = try self.constant(u16, s.k, bf.bits(1));
+                const weights = try self.constant(f32, s.rows, if (self.control) -1 else 1);
+                self.bind(self.kernels.index_scores, .{ .x = 1, .y = rows }, 128, .{ q, cache, weights, result, one, k, k, one, one, zero, zero, one, one });
+            },
+            .index_select => {
+                const x = try a.alloc(f32, self.x.len);
+                for (x, self.x) |*v, q| v.* = bf.value(q) * (if (self.control) @as(f32, -1) else 1);
+                self.restore_bytes = x.len * 4;
+                self.restore_src = try self.buf(x);
+                self.restore_dst = try self.rig.scratch(self.restore_bytes);
+                const picks = try self.rig.scratch(s.rows * s.n * 8);
+                self.bind(self.kernels.index_select, .{ .x = rows }, 256, .{ self.restore_dst, picks, result, k, n, k, zero, zero, k, n });
+            },
+            .context => {
+                const cache = try a.alloc(u16, self.x.len * s.n);
+                const indices = try a.alloc(i32, self.x.len);
+                for (self.x, indices, 0..) |x, *idx, i| {
+                    @memset(cache[i * s.n ..][0..s.n], x);
+                    idx.* = @intCast(i);
+                }
+                const p = try self.constant(f32, self.x.len, (if (self.control) @as(f32, 1) else 0.5) / @as(f32, @floatFromInt(k)));
+                self.bind(self.kernels.context, .{ .x = rows, .z = (n + 127) / 128 }, 128, .{
+                    p, try self.buf(cache), try self.buf(indices), result, one, n, n, k, k, rows * k - 1, zero,
+                });
+            },
+        }
+        return true;
+    }
+    pub fn run(self: *Entry) !void {
+        if (self.restore_src != 0) {
+            const dst: cuda.DeviceBuffer = .{ .d = self.rig.gpu.d, .ptr = self.restore_dst, .len = self.restore_bytes };
+            try dst.copyFrom(0, self.restore_src, dst.len, self.rig.s.handle);
+        }
+        try cuda.launch.launch(self.func, self.config, self.rig.s, &self.args);
+        try self.rig.s.synchronize();
+    }
+    pub fn count(self: *Entry) usize {
+        return self.shape.rows * oracle.width(self.kind, self.shape.n);
+    }
+    pub fn reference(self: *Entry, want: []f64, mag: []f64) !void {
+        try oracle.evaluate(self.rig.gpu.gpa, self.kind, self.shape, self.x, null, .sequential, want, mag);
+    }
+    pub fn check(self: *Entry, _: g.Gate) !?[]const u8 {
+        const s = self.shape;
+        const got = std.mem.bytesAsSlice(i32, try self.rig.outputBytes());
+        const ids = try self.pool.allocator().alloc(i32, s.k);
+        defer self.pool.allocator().free(ids);
+        for (0..s.rows) |row| {
+            const words = self.x[row * s.k ..][0..s.k];
+            for (ids, 0..) |*id, i| id.* = @intCast(i);
+            std.mem.sort(i32, ids, words, struct {
+                fn better(w: []const u16, i: i32, j: i32) bool {
+                    const v = bf.value(w[@intCast(i)]);
+                    const z = bf.value(w[@intCast(j)]);
+                    if (std.math.isNan(v) != std.math.isNan(z)) return std.math.isNan(v);
+                    return v > z or ((v == z or std.math.isNan(v)) and i < j);
+                }
+            }.better);
+            std.mem.sort(i32, ids[0..s.n], {}, std.sort.asc(i32));
+            for (ids[0..s.n], got[row * s.n ..][0..s.n]) |want, id| if (want != id) return "selected position differs from scalar top-k";
+        }
+        return null;
+    }
+    pub fn simulate(self: *Entry, acc: c.Accum, order: ct.rows.Order, out: []f64) !void {
+        try oracle.evaluate(self.rig.gpu.gpa, self.kind, self.shape, self.x, acc, order, out, null);
+    }
+};
+
+pub fn check(r: *Rig, kernels: *const cuda.hy4_ops.Kernels) !void {
+    var tally: g.Tally = .{};
+    inline for (comptime std.meta.tags(oracle.Kind)) |kind| {
+        var vt = g.hooks(Entry);
+        if (kind != .index_select) vt.check = null;
+        inline for (.{ false, true }) |bad| {
+            var entry: Entry = .{ .rig = r, .kind = kind, .control = bad, .kernels = kernels, .pool = std.heap.ArenaAllocator.init(r.gpu.gpa) };
+            defer entry.pool.deinit();
+            const kernel: g.Kernel = .{ .spec = oracle.spec(kind, bad), .ctx = &entry, .vt = &vt, .control = if (bad) .shapes else null };
+            try g.runAll(r.gpu.gpa, &.{kernel}, 20261120, &tally);
+        }
+    }
+    std.debug.print("SUMMARY full Hy4 CUDA kernels={d}/{d} controls_red={d}/{d} known={d}\n", .{ tally.passed, tally.kernels, tally.caught, tally.controls, tally.known });
+    try std.testing.expectEqual(@as(usize, 0), tally.problems());
+}
diff --git a/zig/kernels/cuda/contract_hy4_front_rows.zig b/zig/kernels/cuda/contract_hy4_front_rows.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b3ab148e1fc3cc80182013e768a2719cfde99023
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_front_rows.zig
@@ -0,0 +1,87 @@
+//! Fused short-row MLA front against the original independent-row contract.
+const std = @import("std");
+const ops = @import("cuda").hy4_ops;
+const Rig = @import("rig").Rig;
+const bf = @import("bf16_round");
+const t = std.testing;
+
+fn randomBf16(a: std.mem.Allocator, rng: std.Random, n: usize, scale: f32) ![]u16 {
+    const values = try a.alloc(u16, n);
+    for (values) |*v| v.* = bf.bits((rng.float(f32) * 2 - 1) * scale);
+    return values;
+}
+
+pub fn check(r: *Rig, k: *const ops.Kernels) !void {
+    var pool = std.heap.ArenaAllocator.init(t.allocator);
+    defer pool.deinit();
+    const a = pool.allocator();
+    const max = 7;
+    const heads = 16;
+    const first = 513;
+    const q_head = 260;
+    const q_row = heads * q_head + 5;
+    const out_head = 580;
+    const out_row = heads * out_head + 7;
+    const kv_row = 580;
+    const cache_stride = 581;
+    var prng = std.Random.DefaultPrng.init(0xa771f20);
+    const rng = prng.random();
+    const q = try randomBf16(a, rng, max * q_row, 0.75);
+    const kv = try randomBf16(a, rng, max * kv_row, 0.75);
+    const weights = try randomBf16(a, rng, heads * 448 * 512, 0.25);
+    const gain = try randomBf16(a, rng, 512, 0.25);
+    for (gain) |*v| v.* = bf.bits(0.875 + @abs(bf.value(v.*)));
+
+    const q_dev = try r.input(std.mem.sliceAsBytes(q));
+    const kv_dev = try r.input(std.mem.sliceAsBytes(kv));
+    const weights_dev = try r.input(std.mem.sliceAsBytes(weights));
+    const gain_dev = try r.input(std.mem.sliceAsBytes(gain));
+    var shape: ops.MlaShape = .{
+        .rows = 1,
+        .heads = heads,
+        .capacity = first + max,
+        .key_count = 1,
+        .first_pos = first,
+        .q_head_stride = q_head,
+        .q_row_stride = q_row,
+        .absorbed_head_stride = out_head,
+        .absorbed_row_stride = out_row,
+        .kv_row_stride = kv_row,
+        .cache_stride = cache_stride,
+    };
+    const reference_aq = try r.output(out_row * 2);
+    const reference_cache = try r.output(shape.capacity * cache_stride * 2);
+
+    for ([_]u32{ 1, 2, 3, 7 }) |rows| {
+        shape.rows = rows;
+        shape.first_pos = first;
+        const batch_aq = try r.output(@as(usize, rows) * out_row * 2);
+        const batch_cache = try r.output(shape.capacity * cache_stride * 2);
+        try ops.mlaProject(k, r.s, shape, .{
+            .q = q_dev,
+            .kv = kv_dev,
+            .kv_norm = gain_dev,
+            .kv_b = weights_dev,
+            .absorbed_q = batch_aq,
+            .cache = batch_cache,
+        });
+        const got_aq = try a.dupe(u8, try r.bytes(batch_aq, @as(usize, rows) * out_row * 2));
+        const got_cache = try a.dupe(u8, try r.bytes(batch_cache, shape.capacity * cache_stride * 2));
+        var one = shape;
+        one.rows = 1;
+        for (0..rows) |row| {
+            one.first_pos = first + @as(u32, @intCast(row));
+            try ops.mlaProjectReference(k, r.s, one, .{
+                .q = q_dev + row * q_row * 2,
+                .kv = kv_dev + row * kv_row * 2,
+                .kv_norm = gain_dev,
+                .kv_b = weights_dev,
+                .absorbed_q = reference_aq,
+                .cache = reference_cache,
+            });
+            try t.expectEqualSlices(u8, got_aq[row * out_row * 2 ..][0 .. out_row * 2], try r.bytes(reference_aq, out_row * 2));
+            const at = (@as(usize, first) + row) * cache_stride * 2;
+            try t.expectEqualSlices(u8, got_cache[at..][0 .. cache_stride * 2], try r.bytes(reference_cache + at, cache_stride * 2));
+        }
+    }
+}
diff --git a/zig/kernels/cuda/contract_hy4_head_bf16.zig b/zig/kernels/cuda/contract_hy4_head_bf16.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4fadfc1e37e44160c1f83eb95a5baa446bdfefed
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_head_bf16.zig
@@ -0,0 +1,97 @@
+//! BF16 vocabulary head: its own FMA order (asserted), a planted weight change
+//! (asserted) and its words against the pinned FP32 plans the served head uses.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = cuda.hy4_ops;
+const lt = cuda.cublaslt;
+const Rig = @import("rig").Rig;
+const bf = @import("bf16_round");
+const t = std.testing;
+const D = 6144;
+const N = 120832;
+const V = N / 4;
+
+/// True only once a device run showed every word equal to the pinned FP32 plans.
+pub const same_as_fp32 = false;
+
+fn download(r: *Rig, a: std.mem.Allocator, ptr: u64, n: usize) ![]f32 {
+    const out = try a.alloc(f32, n);
+    try r.s.synchronize();
+    try cuda.memory.download(r.gpu.d, ptr, std.mem.sliceAsBytes(out));
+    return out;
+}
+
+const Diff = struct { words: usize = 0, max_abs: f32 = 0 };
+
+fn compare(want: []const f32, got: []const f32) Diff {
+    var d: Diff = .{};
+    for (want, got) |l, g| {
+        if (@as(u32, @bitCast(l)) != @as(u32, @bitCast(g))) d.words += 1;
+        d.max_abs = @max(d.max_abs, @abs(l - g));
+    }
+    return d;
+}
+
+pub fn check(a: std.mem.Allocator, r: *Rig, k: *const ops.Kernels, lib: *const lt.Library, workspace: u64, ws: usize, w: u64, wb: u64, first: []const u16, one: []const u16, last: *const lt.Linear) !void {
+    const x = try r.input(std.mem.sliceAsBytes(one[0 .. 8 * D]));
+    const xf = try a.alloc(f32, 8 * D);
+    for (xf, one[0 .. 8 * D]) |*v, h| v.* = bf.value(h);
+    const xw = try r.input(std.mem.sliceAsBytes(xf));
+    const y = try r.output(8 * V * 4);
+    const yb = try r.output(8 * V * 4);
+    var all_same = true;
+    for ([_]usize{ 1, 2, 3, 7, 8 }) |rows| {
+        var full = try lt.Linear.initTyped(lib, rows, N, D, .f32, .f32, ws, .none);
+        defer full.deinit();
+        var local = try lt.Linear.initTyped(lib, rows, V, D, .f32, .f32, ws, .none);
+        defer local.deinit();
+        var pinned = true;
+        ops.matchColumnPlan(&full, &local, ws) catch |err| {
+            if (err != error.NoMatchingHy4ColumnPlan) return err;
+            pinned = false;
+        };
+        for (0..4) |rank| {
+            try local.run(xw, w + rank * V * D * 4, y, workspace, ws, r.s.handle);
+            try ops.headBf16(k, r.s, x, wb + rank * V * D * 2, yb, rows, V, D, V);
+            const want = try download(r, a, y, rows * V);
+            const got = try download(r, a, yb, rows * V);
+            const d = compare(want, got);
+            all_same = all_same and d.words == 0;
+            if (rank == 0 or d.words != 0) std.debug.print("HEAD_BF16 rows={d} rank={d} pinned={} differing_words={d}/{d} max_abs={d:.9}\n", .{ rows, rank, pinned, d.words, rows * V, d.max_abs });
+            if (rank == 0) {
+                // The kernel's own order: one FP32 FMA chain per logit in ascending k.
+                for (0..rows) |row| for (0..128) |col| {
+                    var acc: f32 = 0;
+                    for (0..D) |i| acc = @mulAdd(f32, xf[row * D + i], bf.value(first[col * D + i]), acc);
+                    try t.expectEqual(@as(u32, @bitCast(acc)), @as(u32, @bitCast(got[row * V + col])));
+                };
+            }
+        }
+    }
+    // The served single next-token plan, pinned to the 48-row chunk plan.
+    for (0..4) |rank| {
+        try last.run(xw, w + rank * V * D * 4, y, workspace, ws, r.s.handle);
+        try ops.headBf16(k, r.s, x, wb + rank * V * D * 2, yb, 1, V, D, V);
+        const d = compare(try download(r, a, y, V), try download(r, a, yb, V));
+        all_same = all_same and d.words == 0;
+        std.debug.print("HEAD_BF16 last-head rank={d} differing_words={d}/{d} max_abs={d:.9}\n", .{ rank, d.words, V, d.max_abs });
+    }
+    // Planted control: one changed weight word (at a nonzero input) must move that logit.
+    try ops.headBf16(k, r.s, x, wb, yb, 1, V, D, V);
+    const before = try download(r, a, yb, V);
+    const at = for (xf[0..D], 0..) |v, i| {
+        if (v != 0) break 5 * D + i;
+    } else return error.ZeroHeadInput;
+    const view: cuda.DeviceBuffer = .{ .d = r.gpu.d, .ptr = wb, .len = V * D * 2, .borrowed = true };
+    var word = if (first[at] == bf.bits(0.25)) bf.bits(-0.25) else bf.bits(0.25);
+    try view.upload(at * 2, std.mem.asBytes(&word));
+    try ops.headBf16(k, r.s, x, wb, yb, 1, V, D, V);
+    const after = try download(r, a, yb, V);
+    word = first[at];
+    try view.upload(at * 2, std.mem.asBytes(&word));
+    const moved = compare(before, after);
+    std.debug.print("CONTROL HEAD_BF16 one planted weight word changed {d}/{d} logits\n", .{ moved.words, V });
+    try t.expect(moved.words >= 1 and @as(u32, @bitCast(before[5])) != @as(u32, @bitCast(after[5])));
+    std.debug.print("HEAD_BF16 every word equal to the pinned FP32 plans: {}\n", .{all_same});
+    if (same_as_fp32) try t.expect(all_same);
+}
diff --git a/zig/kernels/cuda/contract_hy4_host.zig b/zig/kernels/cuda/contract_hy4_host.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c3072c5569373d1ae4f7d8067ca375902234c9c2
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_host.zig
@@ -0,0 +1,148 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = cuda.hy4_ops;
+
+test "Hy4 ABI routed scratch caps at one chunk and accepts per-projection widths" {
+    const t = std.testing;
+    var l: cuda.exl3_experts.Layer = .{
+        .gate = 8,
+        .up = 8,
+        .down = 8,
+        .gate_k2 = 4,
+        .up_k2 = 4,
+        .down_k2 = 4,
+        .suh_g = 2,
+        .suh_u = 2,
+        .svh_g = 2,
+        .svh_u = 2,
+        .suh_d = 2,
+        .svh_d = 2,
+        .experts = 256,
+        .dims = 6144,
+        .width = 2048,
+        .limit = 10,
+        .codebook = .mul1,
+    };
+    var s: ops.RoutedShape = .{ .rows = 1024, .x_row_stride = 6144, .output_row_stride = 6144 };
+    const n = try ops.routedScratchBytes(s, l);
+    s.rows = 1025;
+    try t.expectEqual(n, try ops.routedScratchBytes(s, l));
+    s.rows = 1;
+    for ([_]u32{ 0, 6, 8 }) |bits| {
+        l.uniform_k2 = bits;
+        try t.expect(try ops.routedScratchBytes(s, l) < n);
+    }
+    l.uniform_k2 = 4;
+    try t.expectError(error.BadHy4Route, ops.routedScratchBytes(s, l));
+    l.uniform_k2 = 0;
+    l.width = 512;
+    try t.expect(try ops.routedScratchBytes(s, l) < n);
+    l.limit = 0;
+    try t.expectError(error.BadHy4Route, ops.routedScratchBytes(s, l));
+    l.limit = 10;
+    s.output_row_stride = 6143;
+    try t.expectError(error.BadHy4Stride, ops.routedScratchBytes(s, l));
+}
+
+test "index scratch stays bounded beyond 65535 rows and checks pitches before launch" {
+    var s: ops.IndexShape = .{ .rows = 2560, .first_pos = 0, .capacity = 2560, .x_row_stride = 6144, .q_row_stride = 2048, .cache_stride = 128, .indices_stride = 2048 };
+    const small = try ops.indexScratchBytes(s);
+    s.rows = 1 << 20;
+    s.capacity = s.rows;
+    try std.testing.expectEqual(small, try ops.indexScratchBytes(s));
+    try std.testing.expect(small < 4 * 1024 * 1024);
+    s.first_pos = 65536;
+    try std.testing.expectError(error.BadHy4IndexShape, ops.indexScratchBytes(s));
+    s.rows = 1;
+    s.indices_stride = 2047;
+    try std.testing.expectError(error.BadHy4Stride, ops.indexScratchBytes(s));
+    s.indices_stride = 2048;
+    s.rope = 63;
+    try std.testing.expectError(error.BadHy4IndexShape, ops.indexScratchBytes(s));
+}
+
+test "index workspace allocated at offset zero covers every decode step and short prefill chunk" {
+    for ([_]u32{ 1, 64, 1024 }) |rows| {
+        var s: ops.IndexShape = .{ .rows = rows, .first_pos = 0, .capacity = 131072, .x_row_stride = 0, .q_row_stride = 0, .cache_stride = 0, .indices_stride = 0 };
+        const initial = try ops.indexScratchBytes(s);
+        for ([_]u32{ 2, rows, 2047, 65536, s.capacity - rows }) |offset| {
+            s.first_pos = offset;
+            try std.testing.expectEqual(initial, try ops.indexScratchBytes(s));
+        }
+        std.debug.print("Hy4 index scratch rows={d} capacity={d}: {d} bytes across offsets\n", .{ rows, s.capacity, initial });
+    }
+}
+
+test "MLA workspace is bounded and a largest-window allocation covers smaller dense and sparse shapes" {
+    var s: ops.MlaShape = .{ .rows = 131072, .capacity = 131072, .key_count = 131072, .heads = 64 };
+    const max = try ops.scratchBytes(s);
+    try std.testing.expectEqual(@as(usize, 40 * 1024 * 1024), max);
+    std.debug.print("Hy4 64-head MLA workspace upper bound {d} bytes\n", .{max});
+    for ([_]u32{ 1, 2, 17, 63, 64, 65, 32768, 65536, 131072 }) |rows| {
+        s.rows = rows;
+        var previous: usize = 0;
+        for ([_]u32{ 1, 10, 2047, 2048, 2049, 2050, 8192, 32768, 131072 }) |keys| {
+            s.key_count = keys;
+            const bytes = try ops.scratchBytes(s);
+            try std.testing.expect(bytes >= previous and bytes <= max);
+            previous = bytes;
+        }
+    }
+}
+
+test "Hy4 ABI rejects missing attention storage" {
+    const shape: ops.MlaShape = .{ .rows = 2, .heads = 4, .capacity = 16, .key_count = 16 };
+    var b: ops.MlaAttend = .{ .cache = 2, .absorbed_q = 2, .kv_b = 2, .gate = 2, .sinks = 4, .scratch = 4, .output = 2, .scratch_bytes = 1 };
+    const k: ops.Kernels = undefined;
+    const s: cuda.Stream = .{ .d = undefined, .handle = null };
+    try std.testing.expectError(error.BadHy4Scratch, ops.mlaAttend(&k, s, shape, b));
+    b.sinks = 0;
+    try std.testing.expectError(error.MissingHy4Buffer, ops.mlaAttend(&k, s, shape, b));
+}
+
+test "MLA shape errors and overlapping rank buffers fail before launch" {
+    const t = std.testing;
+    const full: ops.MlaShape = .{ .rows = 16, .heads = 64, .capacity = 2048, .key_count = 16 };
+    try t.expectEqual(@as(usize, 16 * 64 * (16 + 512) * 4), try ops.scratchBytes(full));
+    var bad = full;
+    bad.first_pos = bad.capacity;
+    try t.expectError(error.BadHy4MlaShape, ops.scratchBytes(bad));
+    bad = full;
+    bad.q_head_stride = 255;
+    try t.expectError(error.BadHy4Stride, ops.scratchBytes(bad));
+    bad = full;
+    bad.rope = 63;
+    try t.expectError(error.BadHy4MlaShape, ops.scratchBytes(bad));
+    const k: ops.Kernels = undefined;
+    try t.expectError(error.BadHy4RankBuffer, ops.foldRank4(&k, undefined, 64, 112, 4));
+    try t.expectError(error.BadHy4RankBuffer, ops.foldRank4(&k, undefined, 64, 62, 4));
+    try t.expectError(error.BadHy4RankBuffer, ops.addExpertPartial(&k, undefined, 64, 128, 68, 4));
+    try ops.foldRank4(&k, undefined, 0, 0, 0);
+    const no_buffers: ops.IhcRead = .{ .streams = 0, .output = 0, .base = 0, .projection = 0, .scale = 0 };
+    try t.expectError(error.BadHy4Stride, ops.ihcHead(&k, undefined, .{ .rows = 1, .hidden_stride = 6143 }, no_buffers));
+    try t.expectError(error.Overflow, ops.ihcHead(&k, undefined, .{ .rows = 1, .stream_stride = std.math.maxInt(u32) }, no_buffers));
+}
+
+test "Hy4 ABI prefill all-reduce defaults to fp32 and keeps bf16 and off selectable" {
+    const t = std.testing;
+    const hk = cuda.hy4_kernels;
+    try t.expectEqual(hk.PrefillAr.fp32, try hk.parsePrefillAr(true, null));
+    try t.expectEqual(hk.PrefillAr.off, try hk.parsePrefillAr(false, null));
+    try t.expectEqual(hk.PrefillAr.bf16, try hk.parsePrefillAr(true, "bf16"));
+    try t.expectEqual(hk.PrefillAr.off, try hk.parsePrefillAr(true, "off"));
+    try t.expectEqual(hk.PrefillAr.fp32, try hk.parsePrefillAr(true, "fp32"));
+    try t.expectError(error.InvalidEnvironment, hk.parsePrefillAr(true, "fp16"));
+
+    const Env = struct {
+        k: []const u8,
+        v: []const u8,
+        pub fn get(e: @This(), name: []const u8) ?[]const u8 {
+            return if (std.mem.eql(u8, name, e.k)) e.v else null;
+        }
+    };
+    try t.expectError(error.InvalidEnvironment, hk.PrefillSwitches.fromEnv(Env{ .k = "TF_HY4_PREFILL_AR", .v = "fp16" }));
+    try t.expectError(error.InvalidEnvironment, hk.PrefillSwitches.fromEnv(Env{ .k = "TF_HY4_FAST_PREFILL_MIN_ROWS", .v = "abc" }));
+    try t.expectError(error.InvalidEnvironment, hk.PrefillSwitches.fromEnv(Env{ .k = "TF_HY4_FAST_ROUTED", .v = "yes" }));
+    try t.expectEqual(cuda.mla.chunksSmem(16), hk.mla_wide_smem);
+    try t.expectEqual(@as(u32, 93568), hk.mla_wide_smem);
+}
diff --git a/zig/kernels/cuda/contract_hy4_index.zig b/zig/kernels/cuda/contract_hy4_index.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8b1280250f47fb48d6f4f607e160f3bb5ecf7817
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_index.zig
@@ -0,0 +1,336 @@
+//! Exact selected IDs from the public wrappers. No oracle indices enter a launch.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = cuda.hy4_ops;
+const st = @import("core").safetensors;
+const Rig = @import("rig").Rig;
+const tiny = @import("contract_hy4_oracle.zig");
+const bf = @import("bf16_round");
+const t = std.testing;
+
+fn fixture(r: *Rig, k: *const ops.Kernels, weights: []const st.File, dump: st.File, input: st.File, comptime prefix: []const u8, comptime key: []const u8, rows: u32) !void {
+    var pool = std.heap.ArenaAllocator.init(t.allocator);
+    defer pool.deinit();
+    const a = pool.allocator();
+    const ix = prefix ++ "self_attn.indexer.";
+    const streams = try r.input(try tiny.tensor(&.{input}, "streams_in", .bf16, &.{ 1, rows, 4, 32 }));
+    const pos = std.mem.bytesAsSlice(i64, try tiny.tensor(&.{input}, "position_ids", .i64, &.{ 1, rows }));
+    for (pos, 0..) |v, i| try t.expectEqual(@as(i64, @intCast(i)), v);
+    const hc = try tiny.read(r, k, weights, rows, streams, prefix ++ "hc_attn_layer.hc_pre.hc_");
+    const x = try tiny.norm(a, std.mem.bytesAsSlice(u16, try r.bytes(hc.output, rows * 32 * 2)), try tiny.tensor(weights, prefix ++ "input_layernorm.weight", .bf16, &.{32}));
+    const qa = try tiny.mv(a, x, try tiny.tensor(weights, prefix ++ "self_attn.q_a_proj.weight", .bf16, &.{ 12, 32 }), 32, 12);
+    const resid = try tiny.norm(a, qa, try tiny.tensor(weights, prefix ++ "self_attn.q_a_layernorm.weight", .bf16, &.{12}));
+    const shape: ops.IndexShape = .{
+        .rows = rows,
+        .capacity = rows,
+        .first_pos = 0,
+        .top_k = 16,
+        .width = 32,
+        .q_rank = 12,
+        .heads = 4,
+        .dim = 16,
+        .rope = 6,
+        .x_row_stride = 32,
+        .q_row_stride = 12,
+        .cache_stride = 19,
+        .indices_stride = 17,
+    };
+    const n = try ops.indexScratchBytes(shape);
+    const b: ops.IndexBuffers = .{
+        .q_resid = try r.input(std.mem.sliceAsBytes(resid)),
+        .x = try r.input(std.mem.sliceAsBytes(x)),
+        .wq_b = try r.input(try tiny.tensor(weights, ix ++ "wq_b.weight", .bf16, &.{ 64, 12 })),
+        .wk = try r.input(try tiny.tensor(weights, ix ++ "wk.weight", .bf16, &.{ 16, 32 })),
+        .k_norm = try r.input(try tiny.tensor(weights, ix ++ "k_norm.weight", .f32, &.{16})),
+        .k_bias = try r.input(try tiny.tensor(weights, ix ++ "k_norm.bias", .f32, &.{16})),
+        .weights_proj = try r.input(try tiny.tensor(weights, ix ++ "weights_proj.weight", .f32, &.{ 4, 32 })),
+        .cache = try r.output(rows * 19 * 2),
+        .indices = try r.output(rows * 17 * 4),
+        .scratch = try r.scratch(n),
+        .scratch_bytes = n,
+    };
+    try ops.selectTokens(k, r.s, shape, b);
+    const expected = std.mem.bytesAsSlice(i32, try tiny.tensor(&.{dump}, key ++ ".index_positions", .i32, &.{ 1, rows, 16 }));
+    const initial = try a.dupe(u8, try r.bytes(b.indices, rows * 17 * 4));
+    const ids = std.mem.bytesAsSlice(i32, initial);
+    var differences: usize = 0;
+    for (0..rows) |i| {
+        for (ids[i * 17 ..][0..16], expected[i * 16 ..][0..16]) |got, want| differences += @intFromBool(got != want);
+        try t.expectEqual(@as(i32, -1), ids[i * 17 + 16]);
+    }
+    std.debug.print("Hy4 index smooth {s} rows={d} differing={d}/{d}\n", .{ key, rows, differences, rows * 16 });
+    try t.expectEqual(@as(usize, 0), differences);
+    const cache = try a.dupe(u8, try r.bytes(b.cache, rows * 19 * 2));
+    for (0..4) |_| {
+        var replica = b;
+        replica.cache = try r.output(cache.len);
+        replica.indices = try r.output(initial.len);
+        try ops.selectTokens(k, r.s, shape, replica);
+        try t.expectEqualSlices(u8, initial, try r.bytes(replica.indices, initial.len));
+        try t.expectEqualSlices(u8, cache, try r.bytes(replica.cache, cache.len));
+    }
+    // Allocate at offset zero. The same arena must cover all later offsets.
+    for ([_]u32{ 1, 7 }) |chunk_rows| {
+        var chunk = shape;
+        chunk.rows = chunk_rows;
+        var view = b;
+        view.scratch_bytes = try ops.indexScratchBytes(chunk);
+        view.scratch = try r.scratch(view.scratch_bytes);
+        view.cache = try r.output(rows * 19 * 2);
+        view.indices = try r.output(rows * 17 * 4);
+        while (chunk.first_pos < rows) {
+            var step = view;
+            step.x += @as(u64, chunk.first_pos) * 32 * 2;
+            step.q_resid += @as(u64, chunk.first_pos) * 12 * 2;
+            step.indices += @as(u64, chunk.first_pos) * 17 * 4;
+            chunk.rows = @min(chunk_rows, rows - chunk.first_pos);
+            try ops.selectTokens(k, r.s, chunk, step);
+            chunk.first_pos += chunk.rows;
+        }
+        try t.expectEqualSlices(u8, initial, try r.bytes(view.indices, initial.len));
+        try t.expectEqualSlices(u8, cache, try r.bytes(view.cache, cache.len));
+    }
+    for (0..rows) |i| for (cache[(i * 19 + 16) * 2 ..][0..6]) |v| {
+        try t.expectEqual(@as(u8, 255), v);
+    };
+    if (rows == 48) {
+        const zero_weights: [4 * 32]f32 = @splat(0);
+        var bad = b;
+        bad.weights_proj = try r.input(std.mem.asBytes(&zero_weights));
+        try ops.selectTokens(k, r.s, shape, bad);
+        const wrong = std.mem.bytesAsSlice(i32, try r.bytes(bad.indices, rows * 17 * 4));
+        var missed: usize = 0;
+        for (0..rows) |i| for (wrong[i * 17 ..][0..16], expected[i * 16 ..][0..16]) |v, y| {
+            missed += @intFromBool(v != y);
+        };
+        std.debug.print("CONTROL Hy4 zero index head weights {s} differing={d}/{d}\n", .{ key, missed, rows * 16 });
+        try t.expect(missed != 0);
+    }
+}
