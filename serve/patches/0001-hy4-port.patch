+        else if (std.mem.eql(u8, arg, "--drafter-synthetic")) { drafter_on = true; drafter_synthetic = true; }
+        else if (std.mem.eql(u8, arg, "--drafter-wrong")) { drafter_on = true; drafter_wrong = true; }
+        else if (std.mem.eql(u8, arg, "--auto-depth")) { drafter_on = true; auto_depth = true; }
+        else if (std.mem.eql(u8, arg, "--drafter")) {
