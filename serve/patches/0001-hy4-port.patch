+    try std.testing.expectError(error.BadDraftMinMargin, parseMinMarginStr("nan"));
+    try std.testing.expectEqual(@as(usize, 2), resolveEffectiveDepth(2, 6));
+    try std.testing.expectEqual(@as(usize, 1), resolveEffectiveDepth(6, 1));
+    var trk_cut: DepthTracker = .{};
+    trk_cut.observe(1, 1); // tracker asked 6, margin cut to 1: positions 1..5 stay untouched (`pn[1] == 0`).
+    try std.testing.expectApproxEqAbs(@as(f64, 1.0), trk_cut.pn[0], 1e-9);
+    try std.testing.expectApproxEqAbs(@as(f64, 0.0), trk_cut.pn[1], 1e-9);
+    _ = ranks;
+}
