+            try t.expectEqualSlices(u8, branch, try self.rig.bytes(write.branch, D * 2));
+            if (i >= 3) std.debug.print("WRITE156 rank={d} sample={d} direct={d} ms={d:.6} branch={x} streams={x}\n",
+                .{ rank, i-3, @intFromBool(fused), try cuda.Event.elapsedMs(a,b), std.hash.XxHash64.hash(0,branch), std.hash.XxHash64.hash(0,expected) });
+        };
+    }
+
+    fn time(self: *Worker, rows: usize, repeats: usize, samples: usize) !void {
+        const relay = if (self.link.relay) |r| r.fits(r.ctx, rows * D * 4) else false;
+        std.debug.print("ROUTE rank={d} rows={d} calls={d} path={s}\n", .{ @backingInt(self.rank), rows, repeats, if (relay) "verbs-relay" else "nccl" });
+        var a = try cuda.Event.init(self.rig.s.d, true);
+        defer a.deinit();
+        var b = try cuda.Event.init(self.rig.s.d, true);
+        defer b.deinit();
