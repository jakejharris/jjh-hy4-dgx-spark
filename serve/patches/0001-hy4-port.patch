+    const logits = [_]f32{ -2.0, 4.5, 1.0, -5.0 };
+    const rule: cuda.sample.Rule = .{ .seed = 99, .inv_t = 2.0, .top_p = 0.9, .near = 20.0, .min_log = -5.0, .top_k = 2 };
