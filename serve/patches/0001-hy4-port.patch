+//! Single-node DFly2 parity harness against `pass1_state.safetensors` and `proposals.safetensors`
+//! (`tf-hy4-oracle --check-drafter-state STATE.safetensors ...`).
+//!
+//! Feeds each prefix's saved 78-layer state (`anchor_hidden`, `bonus_tok`, `kv_pass_L`, `kv_rot_L`)
+//! directly into `Drafter.proposeTp` (the exact function `serve` calls, loading only `embed_tokens`,
+//! `dfly_layers`, and `lm_head` / EXL3 head sidecars without loading the 78 trunk layers), compares
+//! all 6 proposals per prefix against `proposals.safetensors`, records top-1/top-2 logit margins,
+//! and optionally dumps intermediates (`--trace-row R`) to locate the first differing tensor.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const boundary = @import("boundary.zig");
+const weights = @import("weights.zig");
+const trunk_exl3 = @import("trunk_exl3.zig");
+const kv_pool = @import("kv_pool.zig");
+const forward = @import("forward.zig");
+const draft_policy = @import("draft_policy.zig");
+const drafter = @import("drafter.zig");
+const resident = @import("resident.zig");
+const rank_picks = @import("rank_picks.zig");
+
+const st = core.safetensors;
+const Uploader = cuda.exl3_upload.Uploader;
+pub const max_depth: usize = drafter.max_block_size - 1;
+
+fn nowNs(io: std.Io) u64 {
+    return @intCast(@max(@as(i128, 0), std.Io.Clock.awake.now(io).toNanoseconds()));
+}
+
+/// Packs post-`kv_a_layernorm` `kv_pass` (`[p_len, latent]` BF16) and post-RoPE `kv_rot` (`[p_len, rope]` BF16)
+/// into `KvPool`'s contiguous `[p_len, latent + rope]` BF16 cache row layout (`mla_project.cu:83-89`).
+pub fn packLatentKvRow(p_len: usize, latent: usize, rope: usize, kv_pass_bf16: []const u8, kv_rot_bf16: []const u8, out_bf16: []u8) !void {
+    const pass_b = latent * 2;
+    const rot_b = rope * 2;
+    const stride_b = pass_b + rot_b;
+    if (kv_pass_bf16.len != p_len * pass_b or kv_rot_bf16.len != p_len * rot_b or out_bf16.len != p_len * stride_b)
+        return error.BadDraftStateShape;
+    for (0..p_len) |pos| {
+        const dst = out_bf16[pos * stride_b ..][0..stride_b];
+        @memcpy(dst[0..pass_b], kv_pass_bf16[pos * pass_b ..][0..pass_b]);
+        @memcpy(dst[pass_b..stride_b], kv_rot_bf16[pos * rot_b ..][0..rot_b]);
+    }
+}
+
+pub const GroupScore = struct {
+    n_rows: usize = 0,
+    slot_eq: [max_depth]usize = @splat(0),
+    cum_chain_eq: [max_depth]usize = @splat(0),
+    full_chain_eq: [max_depth]usize = @splat(0),
+    pub fn totalSlotEq(self: GroupScore, depth: usize) usize {
+        var s: usize = 0;
+        for (0..depth) |j| s += self.slot_eq[j];
+        return s;
+    }
+};
+
+pub const ScoreReport = struct {
+    depth: usize,
+    all: GroupScore = .{},
+    prose: GroupScore = .{},
+    code: GroupScore = .{},
+};
+
+pub fn scoreProposals(
+    n_rows: usize,
+    depth: usize,
+    eng: []const u32,
+    ref: []const u32,
+    is_code: ?[]const bool,
+    prefix_lens_out: []usize,
+) !ScoreReport {
+    if (depth == 0 or depth > max_depth or eng.len != n_rows * depth or ref.len != n_rows * depth or prefix_lens_out.len != n_rows)
+        return error.BadDraftStateShape;
+    if (is_code) |ic| if (ic.len != n_rows) return error.BadDraftStateShape;
+    var rep: ScoreReport = .{ .depth = depth };
+    for (0..n_rows) |r| {
+        const code_row = if (is_code) |ic| ic[r] else false;
+        rep.all.n_rows += 1;
+        if (code_row) rep.code.n_rows += 1 else rep.prose.n_rows += 1;
+        var chain_ok = true;
+        var m: usize = 0;
+        for (0..depth) |j| {
+            const eq = (eng[r * depth + j] == ref[r * depth + j]);
+            if (eq) {
+                rep.all.slot_eq[j] += 1;
+                if (code_row) rep.code.slot_eq[j] += 1 else rep.prose.slot_eq[j] += 1;
+                if (chain_ok) m += 1;
+            } else chain_ok = false;
+        }
+        prefix_lens_out[r] = m;
+        for (0..depth) |d_idx| {
+            const d = d_idx + 1;
+            const c = @min(m, d);
+            rep.all.cum_chain_eq[d_idx] += c;
+            if (m >= d) rep.all.full_chain_eq[d_idx] += 1;
+            if (code_row) {
+                rep.code.cum_chain_eq[d_idx] += c;
+                if (m >= d) rep.code.full_chain_eq[d_idx] += 1;
+            } else {
+                rep.prose.cum_chain_eq[d_idx] += c;
+                if (m >= d) rep.prose.full_chain_eq[d_idx] += 1;
+            }
+        }
+    }
+    return rep;
+}
+
+fn readIntTensorU32(gpa: std.mem.Allocator, tensor: st.Tensor) ![]u32 {
+    const n = tensor.numel();
+    const out = try gpa.alloc(u32, n);
+    errdefer gpa.free(out);
+    switch (tensor.dtype) {
+        .i64 => for (out, 0..) |*dst, i| {
+            const v = std.mem.readInt(i64, tensor.bytes[i * 8 ..][0..8], .little);
+            dst.* = std.math.cast(u32, v) orelse return error.BadDraftStateIds;
+        },
+        .i32, .u32 => for (out, 0..) |*dst, i| {
+            const v = std.mem.readInt(i32, tensor.bytes[i * 4 ..][0..4], .little);
+            dst.* = std.math.cast(u32, v) orelse return error.BadDraftStateIds;
+        },
+        else => return error.BadDraftStateIds,
+    }
+    return out;
+}
+
+const MarginCapture = struct {
+    step: usize = 0,
+    depth: usize,
+    ref_row: ?[]const u32,
+    top1_logits: []f32,
+    top2_logits: []f32,
+    top2_ids: []i64,
+    ref_logits: []f32,
+    dump_logits: ?[]f32 = null,
+
+    fn pick(raw: *anyopaque, logits: []const f32, _: u64) !u32 {
+        const self: *@This() = @ptrCast(@alignCast(raw));
+        const j = self.step;
+        if (j >= self.depth or logits.len == 0) return error.BadDraftStateShape;
+        var b1_id: u32 = 0;
+        var b1_v: f32 = -std.math.inf(f32);
+        var b2_id: u32 = 0;
+        var b2_v: f32 = -std.math.inf(f32);
+        for (logits, 0..) |v, id| {
+            if (!std.math.isFinite(v)) return error.NonFiniteLogits;
+            if (v > b1_v) {
+                b2_v = b1_v;
+                b2_id = b1_id;
+                b1_v = v;
+                b1_id = @intCast(id);
+            } else if (v > b2_v) {
+                b2_v = v;
+                b2_id = @intCast(id);
+            }
+        }
+        self.top1_logits[j] = b1_v;
+        self.top2_logits[j] = b2_v;
+        self.top2_ids[j] = @intCast(b2_id);
+        self.ref_logits[j] = if (self.ref_row) |rr| (if (rr[j] < logits.len) logits[rr[j]] else std.math.nan(f32)) else b1_v;
+        if (self.dump_logits) |dl| @memcpy(dl[j * logits.len ..][0..logits.len], logits);
+        self.step += 1;
+        return b1_id;
+    }
+};
+
+fn addEntry(gpa: std.mem.Allocator, a: std.mem.Allocator, list: *std.ArrayList(core.shard_edit.New), name: []const u8, dtype: st.DType, shape: []const usize, bytes: []const u8) !void {
+    try list.append(gpa, .{
+        .name = try a.dupe(u8, name), .dtype = dtype,
+        .shape = try a.dupe(usize, shape), .bytes = try a.dupe(u8, bytes),
+    });
+}
+
+const TraceRecorder = struct {
+    gpa: std.mem.Allocator,
+    a: std.mem.Allocator,
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+    row_idx: usize,
+    entries: *std.ArrayList(core.shard_edit.New),
+
+    fn call(raw: *anyopaque, kind: u8, idx: usize, dev_ptr: u64, rows: usize, cols: usize) !void {
+        const self: *@This() = @ptrCast(@alignCast(raw));
+        const host = try self.gpa.alloc(u8, rows * cols * 2);
+        defer self.gpa.free(host);
+        try self.stream.synchronize();
+        try cuda.memory.download(self.d, dev_ptr, host);
+        var kbuf: [96]u8 = undefined;
+        const key = switch (kind) {
+            's' => try std.fmt.bufPrint(&kbuf, "trace.r{d:0>3}.slot0_fused", .{self.row_idx}),
+            'a' => try std.fmt.bufPrint(&kbuf, "trace.r{d:0>3}.blk{d}.after_attn", .{ self.row_idx, idx }),
+            'b' => try std.fmt.bufPrint(&kbuf, "trace.r{d:0>3}.blk{d}.out", .{ self.row_idx, idx }),
+            'f' => try std.fmt.bufPrint(&kbuf, "trace.r{d:0>3}.final_norm", .{self.row_idx}),
+            'c' => try std.fmt.bufPrint(&kbuf, "trace.r{d:0>3}.corr{d}.h_corr", .{ self.row_idx, idx }),
+            else => return error.BadArgs,
+        };
+        try addEntry(self.gpa, self.a, self.entries, key, .bf16, &.{ rows, cols }, host);
+    }
+};
+
+pub fn runCli(gpa: std.mem.Allocator, io: std.Io, args: []const []const u8) !bool {
+    var has_flag = false;
+    for (args[1..]) |arg| if (std.mem.eql(u8, arg, "--check-drafter-state")) {
+        has_flag = true;
+        break;
+    };
+    if (!has_flag) return false;
+
+    var state_path: ?[]const u8 = null;
+    var model_arg: ?[]const u8 = null;
+    var config_arg: ?[]const u8 = null;
+    var drafter_path: ?[]const u8 = null;
+    var drafter_exl3_arg: ?[]const u8 = null;
+    var drafter_head_arg: ?[]const u8 = null;
+    var ref_prop_path: ?[]const u8 = null;
+    var prefixes_path: ?[]const u8 = null;
+    var out_path: ?[]const u8 = null;
+    var trace_row_opt: ?usize = null;
+    var dump_miss_logits = false;
+    var device: i32 = 0;
+    var floor_gib: usize = try boundary.envUint(usize, "TF_HY4_MEM_FLOOR_GIB", 35);
+
+    var i: usize = 1;
+    while (i < args.len) : (i += 1) {
+        const arg = args[i];
+        if (std.mem.eql(u8, arg, "--dump-miss-logits")) {
+            dump_miss_logits = true;
+        } else if (std.mem.eql(u8, arg, "--drafter")) {
+            if (i + 1 < args.len and !std.mem.startsWith(u8, args[i + 1], "--")) {
+                drafter_path = args[i + 1];
+                i += 1;
+            }
+        } else {
+            if (i + 1 >= args.len) return error.BadArgs;
+            const val = args[i + 1];
+            i += 1;
+            if (std.mem.eql(u8, arg, "--check-drafter-state")) state_path = val
+            else if (std.mem.eql(u8, arg, "--model") or std.mem.eql(u8, arg, "--index")) model_arg = val
+            else if (std.mem.eql(u8, arg, "--config")) config_arg = val
+            else if (std.mem.eql(u8, arg, "--drafter-exl3")) drafter_exl3_arg = val
+            else if (std.mem.eql(u8, arg, "--drafter-head")) drafter_head_arg = val
+            else if (std.mem.eql(u8, arg, "--ref-proposals")) ref_prop_path = val
+            else if (std.mem.eql(u8, arg, "--prefixes")) prefixes_path = val
+            else if (std.mem.eql(u8, arg, "--output")) out_path = val
+            else if (std.mem.eql(u8, arg, "--trace-row")) trace_row_opt = try std.fmt.parseInt(usize, val, 10)
+            else if (std.mem.eql(u8, arg, "--device")) device = try std.fmt.parseInt(i32, val, 10)
+            else if (std.mem.eql(u8, arg, "--mem-floor-gib")) floor_gib = try std.fmt.parseInt(usize, val, 10)
+            else return error.BadArgs;
+        }
+    }
+
+    const st_p = state_path orelse return error.BadArgs;
+    const mod_p = model_arg orelse return error.BadArgs;
+    try rank_picks.checkMemFloor(floor_gib);
+
+    var idx = try weights.ShardIndex.openWithTrunkAndHead(gpa, io, mod_p, config_arg, "bf16", "off", drafter_path);
+    defer idx.deinit();
+    var explicit_didx = try trunk_exl3.openDrafterIndex(gpa, io, &idx, config_arg, drafter_path, drafter_exl3_arg, drafter_head_arg);
+    defer if (explicit_didx) |*d| d.deinit();
+    const didx_ptr: *const weights.ShardIndex = if (explicit_didx) |*d| d else if (idx.cfg.value.dfly_num_hidden_layers > 0) &idx else return error.MissingDrafterWeights;
+
+    const t = idx.cfg.value.text_config;
+    var state_file = try st.File.open(gpa, io, st_p);
+    defer state_file.close(io);
+    const ah_t = state_file.get("anchor_hidden") orelse return error.MissingAnchorHidden;
+    const bt_t = state_file.get("bonus_tok") orelse return error.MissingBonusTok;
+    if (ah_t.dtype != .bf16 or ah_t.rank != 2 or ah_t.shape[1] != t.hidden_size or bt_t.rank != 1 or bt_t.shape[0] != ah_t.shape[0])
+        return error.BadDraftStateShape;
+    const n_rows = ah_t.shape[0];
+    const bonus_ids = try readIntTensorU32(gpa, bt_t);
+    defer gpa.free(bonus_ids);
+
+    if (didx_ptr.cfg.value.dfly_num_hidden_layers == 0) return error.MissingDrafterWeights;
+    const first_kv_l = didx_ptr.cfg.value.dfly_target_kv_layers[0];
+    var kp0_name: [32]u8 = undefined;
+    const kp0 = state_file.get(try std.fmt.bufPrint(&kp0_name, "kv_pass_{d}", .{first_kv_l})) orelse return error.MissingTargetKv;
+    if (kp0.dtype != .bf16 or kp0.rank != 3 or kp0.shape[0] != n_rows or kp0.shape[2] != t.kv_lora_rank)
+        return error.BadDraftStateShape;
+    const p_len = kp0.shape[1];
+    if (p_len > t.index_topk) return error.DraftStateNeedsRecalledIndices;
+
+    var ref_props: ?[]u32 = null;
+    defer if (ref_props) |rp| gpa.free(rp);
+    if (ref_prop_path) |rp_p| {
+        var rf = try st.File.open(gpa, io, rp_p);
+        defer rf.close(io);
+        const pt = rf.get("proposals") orelse return error.MissingProposals;
+        if (pt.rank != 2 or pt.shape[0] != n_rows) return error.BadDraftStateShape;
+        ref_props = try readIntTensorU32(gpa, pt);
+    }
+
+    var is_code: ?[]bool = null;
+    defer if (is_code) |ic| gpa.free(ic);
+    if (prefixes_path) |pf_p| {
+        var pf_file = try st.File.open(gpa, io, pf_p);
+        defer pf_file.close(io);
+        if (pf_file.get("is_code")) |ict| {
+            if (ict.rank == 1 and ict.shape[0] == n_rows) {
+                const flags = try gpa.alloc(bool, n_rows);
+                for (flags, 0..) |*dst, r| dst.* = switch (ict.dtype) {
+                    .bool => ict.bytes[r] != 0,
+                    .u8, .i8 => ict.bytes[r] != 0,
+                    .i64 => std.mem.readInt(i64, ict.bytes[r * 8 ..][0..8], .little) != 0,
+                    .i32, .u32 => std.mem.readInt(i32, ict.bytes[r * 4 ..][0..4], .little) != 0,
+                    else => return error.BadDraftStateShape,
+                };
+                is_code = flags;
+            }
+        }
+    }
+
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, device);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+
+    const t_load0 = nowNs(io);
+    const dev_before = cuda.memory.usage(false).device;
+    var rt = try forward.Runtime.init(gpa, &driver, stream);
+    defer rt.deinit();
+    var up: Uploader = .{ .d = &driver, .gpa = gpa, .max_buffers = 1 << 16, .slab = 64 << 20 };
+    defer up.deinit();
+
+    const trunk = try weights.loadTrunk(gpa, io, &idx, &up);
+    var dr = try drafter.Drafter.loadDirectWithRank(gpa, io, &driver, didx_ptr, &up, null, rank_picks.checkMemFloor, floor_gib);
+    defer dr.deinit();
+    try dr.weights.reserveExl3(&rt.short_trunk, &rt.exl3_dense, stream);
+
+    const hd: weights.HeadWeights = if (dr.weights.custom_head != null) .{
+        .hc = .{ .fn_ptr = 0, .base_ptr = 0, .scale_ptr = 0 }, .final_norm = .{}, .lm_head_f32 = 0,
+        .vocab_local = t.vocab_size, .vocab_pad = t.vocab_size, .vocab_full = t.vocab_size,
+    } else blk_hd: {
+        try rank_picks.checkMemFloor(floor_gib);
+        var sess = weights.ShardSession.init(&idx, io);
+        defer sess.close();
+        const has_lm = idx.has("lm_head.weight") or !t.tie_word_embeddings;
+        const lm_name = if (has_lm) "lm_head.weight" else "model.embed_tokens.weight";
+        const lm_ptr = try weights.uploadF32Sliced(&sess, gpa, &up, lm_name, &.{ t.vocab_size, t.hidden_size }, @as(usize, t.vocab_size) * t.hidden_size, @as(usize, t.vocab_size) * t.hidden_size, !has_lm);
+        break :blk_hd .{
+            .hc = .{ .fn_ptr = 0, .base_ptr = 0, .scale_ptr = 0 }, .final_norm = .{}, .lm_head_f32 = lm_ptr,
+            .vocab_local = t.vocab_size, .vocab_pad = t.vocab_size, .vocab_full = t.vocab_size,
+        };
+    };
+
+    const depth: usize = dr.maxProposals();
+    if (ref_props) |rp| if (rp.len != n_rows * depth) return error.BadDraftStateShape;
+    var sc = try forward.Scratch.initWith(&driver, t, resident.max_decode_window, .{ .logits_rows = 1, .single_layer_cache_cap = 0, .rank = null });
+    defer sc.deinit();
+    var anc = try drafter.AnchorState.init(gpa, &driver, t, dr.weights.blocks.len, 1);
+    defer anc.deinit();
+    var pool = try kv_pool.KvPool.init(gpa, &driver, t, p_len + dr.weights.block_size);
+    defer pool.deinit();
+    try pool.zeroFill(stream.handle);
+    try stream.synchronize();
+    try rank_picks.checkMemFloor(floor_gib);
+
+    const load_s = @as(f64, @floatFromInt(nowNs(io) -| t_load0)) / 1e9;
+    const loaded_gib = @as(f64, @floatFromInt(cuda.memory.usage(false).device -| dev_before)) / (1 << 30);
+    const head_lbl = if (dr.weights.custom_head) |ch| (if (ch == .proj and ch.proj.p == .exl3) (trunk_exl3.k2WidthName(@intCast(@min(ch.proj.p.exl3.weight.halves, 255))) orelse "exl3") else "custom") else "shared_f32";
+    std.debug.print("hy4 drafter-state-check loaded in {d:.2}s: drafter={s} head={s} rows={d} p_len={d} depth={d} gpu={d:.2}GiB MemAvailable={d:.2}GiB\n", .{
+        load_s, dr.quantLabel(), head_lbl, n_rows, p_len, depth, loaded_gib, @as(f64, @floatFromInt(rank_picks.memAvailableBytes())) / (1 << 30),
+    });
+
+    const eng_props = try gpa.alloc(u32, n_rows * depth);
+    defer gpa.free(eng_props);
+    const eng_i64 = try gpa.alloc(i64, n_rows * depth);
+    defer gpa.free(eng_i64);
+    const top1_logits = try gpa.alloc(f32, n_rows * depth);
+    defer gpa.free(top1_logits);
+    const top2_logits = try gpa.alloc(f32, n_rows * depth);
+    defer gpa.free(top2_logits);
+    const top2_ids = try gpa.alloc(i64, n_rows * depth);
+    defer gpa.free(top2_ids);
+    const ref_logits = try gpa.alloc(f32, n_rows * depth);
+    defer gpa.free(ref_logits);
+
+    const kv_stride_b = (t.kv_lora_rank + t.qk_rope_head_dim) * 2;
+    const packed_kv = try gpa.alloc(u8, p_len * kv_stride_b);
+    defer gpa.free(packed_kv);
+    const norm_host = try gpa.alloc(u8, dr.weights.block_size * t.hidden_size * 2);
+    defer gpa.free(norm_host);
+    const miss_logits_buf: ?[]f32 = if (dump_miss_logits) try gpa.alloc(f32, depth * t.vocab_size) else null;
+    defer if (miss_logits_buf) |b| gpa.free(b);
+
+    var dump_arena = std.heap.ArenaAllocator.init(gpa);
+    defer dump_arena.deinit();
+    const da = dump_arena.allocator();
+    var entries: std.ArrayList(core.shard_edit.New) = .empty;
+    defer entries.deinit(gpa);
+
+    @memset(eng_props, std.math.maxInt(u32));
+    @memset(top1_logits, 0);
+    @memset(top2_logits, 0);
+    @memset(top2_ids, 0);
+    @memset(ref_logits, 0);
+    const min_margin_active = (try draft_policy.envMinMargin()) != null;
+    var offered_total: usize = 0;
+    var cut_total: usize = 0;
+    const t_run0 = nowNs(io);
+    for (0..n_rows) |r| {
+        try rank_picks.checkMemFloor(floor_gib);
+        for (dr.weights.blocks) |blk| {
+            const tgt = try drafter.resolveTargetLayers(blk.target_kv, blk.target_index, t, t.num_hidden_layers);
+            var kp_name: [32]u8 = undefined;
+            var kr_name: [32]u8 = undefined;
+            const kp = state_file.get(try std.fmt.bufPrint(&kp_name, "kv_pass_{d}", .{tgt.kv})) orelse return error.MissingTargetKv;
+            const kr = state_file.get(try std.fmt.bufPrint(&kr_name, "kv_rot_{d}", .{tgt.kv})) orelse return error.MissingTargetKv;
+            if (!kp.is(.bf16, &.{ n_rows, p_len, t.kv_lora_rank }) or !kr.is(.bf16, &.{ n_rows, p_len, t.qk_rope_head_dim }))
+                return error.BadDraftStateShape;
+            const pass_row = kp.bytes[r * p_len * t.kv_lora_rank * 2 ..][0 .. p_len * t.kv_lora_rank * 2];
+            const rot_row = kr.bytes[r * p_len * t.qk_rope_head_dim * 2 ..][0 .. p_len * t.qk_rope_head_dim * 2];
+            try packLatentKvRow(p_len, t.kv_lora_rank, t.qk_rope_head_dim, pass_row, rot_row, packed_kv);
+            try pool.kv_bufs[tgt.kv].uploadAsync(0, packed_kv, stream.handle);
+            try pool.clearLayerKvRange(t, tgt.kv, p_len, pool.capacity, stream.handle);
+        }
+        anc.beginPass(1);
+        const ah_row = ah_t.bytes[r * t.hidden_size * 2 ..][0 .. t.hidden_size * 2];
+        try anc.hidden_bf16.uploadAsync(0, ah_row, stream.handle);
+
+        const row_out = eng_props[r * depth ..][0..depth];
+        const got = try dr.proposeTp(&rt, &sc, t, trunk.embed_bf16, hd, t.num_hidden_layers, &pool, &anc, 0, p_len, bonus_ids[r], depth, null, true, null, null, row_out);
+        if (!min_margin_active and got != depth) return error.ShortDraftProposals;
+        offered_total += got;
+        cut_total += depth - got;
+        try stream.synchronize();
+        try cuda.memory.download(&driver, dr.sc.normalized.ptr, norm_host);
+
+        var row_mismatch = false;
+        if (ref_props) |rp| {
+            for (0..got) |j| if (row_out[j] != rp[r * depth + j]) {
+                row_mismatch = true;
+                break;
+            };
+        }
+        const want_trace = (trace_row_opt != null and trace_row_opt.? == r);
+        var cap: MarginCapture = .{
+            .depth = depth,
+            .ref_row = if (ref_props) |rp| rp[r * depth ..][0..depth] else null,
+            .top1_logits = top1_logits[r * depth ..][0..depth],
+            .top2_logits = top2_logits[r * depth ..][0..depth],
+            .top2_ids = top2_ids[r * depth ..][0..depth],
+            .ref_logits = ref_logits[r * depth ..][0..depth],
+            .dump_logits = if ((row_mismatch or want_trace) and miss_logits_buf != null) miss_logits_buf else null,
+        };
+        var tr_rec: TraceRecorder = .{ .gpa = gpa, .a = da, .d = &driver, .stream = stream, .row_idx = r, .entries = &entries };
+        drafter.trace_hook = if (want_trace) .{ .ctx = &tr_rec, .call = TraceRecorder.call } else null;
+        defer drafter.trace_hook = null;
+        var verify_out: [max_depth]u32 = @splat(0);
+        const got_m = try dr.proposeTp(&rt, &sc, t, trunk.embed_bf16, hd, t.num_hidden_layers, &pool, &anc, 0, p_len, bonus_ids[r], depth, null, false, MarginCapture.pick, &cap, verify_out[0..depth]);
+        if (got_m != got or !std.mem.eql(u32, row_out[0..got], verify_out[0..got])) return error.GreedyPickMismatchHostArgmax;
+
+        for (0..depth) |j| eng_i64[r * depth + j] = if (j < got) @intCast(row_out[j]) else -1;
+        if (row_mismatch or want_trace) {
+            var kbuf: [64]u8 = undefined;
+            try addEntry(gpa, da, &entries, try std.fmt.bufPrint(&kbuf, "miss.r{d:0>3}.final_norm", .{r}), .bf16, &.{ dr.weights.block_size, t.hidden_size }, norm_host);
+            if (cap.dump_logits) |dl| {
+                try addEntry(gpa, da, &entries, try std.fmt.bufPrint(&kbuf, "miss.r{d:0>3}.logits", .{r}), .f32, &.{ depth, t.vocab_size }, std.mem.sliceAsBytes(dl));
+            }
+        }
+    }
+    const run_s = @as(f64, @floatFromInt(nowNs(io) -| t_run0)) / 1e9;
+    std.debug.print("hy4 drafter-state-check ran {d} prefixes ({d} offered, {d} cut) in {d:.2}s ({d:.2}ms/prefix, MemAvailable={d:.2}GiB)\n", .{
+        n_rows, offered_total, cut_total, run_s, (run_s * 1e3) / @as(f64, @floatFromInt(n_rows)), @as(f64, @floatFromInt(rank_picks.memAvailableBytes())) / (1 << 30),
+    });
+
+    if (ref_props) |rp| {
+        const prefix_lens = try gpa.alloc(usize, n_rows);
+        defer gpa.free(prefix_lens);
+        const rep = try scoreProposals(n_rows, depth, eng_props, rp, is_code, prefix_lens);
+        const tot_eq = rep.all.totalSlotEq(depth);
+        std.debug.print("RESULT drafter={s} head={s}: total_slot_equal={d}/{d} ({d:.2}%)\n", .{
+            dr.quantLabel(), head_lbl, tot_eq, n_rows * depth, 100.0 * @as(f64, @floatFromInt(tot_eq)) / @as(f64, @floatFromInt(n_rows * depth)),
+        });
+        for (0..depth) |j| {
+            std.debug.print("  depth={d}: slot_eq={d}/{d} (prose={d}/{d} code={d}/{d}) | chain_cum={d}/{d} full_chain={d}/{d} (prose_full={d}/{d} code_full={d}/{d})\n", .{
+                j + 1, rep.all.slot_eq[j], rep.all.n_rows, rep.prose.slot_eq[j], rep.prose.n_rows, rep.code.slot_eq[j], rep.code.n_rows,
+                rep.all.cum_chain_eq[j], rep.all.n_rows * (j + 1), rep.all.full_chain_eq[j], rep.all.n_rows,
+                rep.prose.full_chain_eq[j], rep.prose.n_rows, rep.code.full_chain_eq[j], rep.code.n_rows,
+            });
+        }
+        var shown: usize = 0;
+        for (0..n_rows) |r| {
+            if (prefix_lens[r] == depth) continue;
+            const j = prefix_lens[r];
+            const idx_rj = r * depth + j;
+            if (shown < 24) {
+                std.debug.print("  FIRST_MISS row={d} ({s}) first_diff_step={d} (1-based {d}): eng_tok={d} (logit={d:.5}) vs ref_tok={d} (eng_logit={d:.5}, gap={d:.5}, eng_top1_top2_margin={d:.5})\n", .{
+                    r, if (is_code != null and is_code.?[r]) "code" else "prose", j, j + 1,
+                    eng_props[idx_rj], top1_logits[idx_rj], rp[idx_rj], ref_logits[idx_rj],
+                    top1_logits[idx_rj] - ref_logits[idx_rj], top1_logits[idx_rj] - top2_logits[idx_rj],
+                });
+                shown += 1;
+            }
+        }
+    }
+
+    if (out_path) |op| {
+        try addEntry(gpa, da, &entries, "proposals", .i64, &.{ n_rows, depth }, std.mem.sliceAsBytes(eng_i64));
+        try addEntry(gpa, da, &entries, "top1_logits", .f32, &.{ n_rows, depth }, std.mem.sliceAsBytes(top1_logits));
+        try addEntry(gpa, da, &entries, "top2_logits", .f32, &.{ n_rows, depth }, std.mem.sliceAsBytes(top2_logits));
+        try addEntry(gpa, da, &entries, "top2_ids", .i64, &.{ n_rows, depth }, std.mem.sliceAsBytes(top2_ids));
+        try addEntry(gpa, da, &entries, "ref_logits", .f32, &.{ n_rows, depth }, std.mem.sliceAsBytes(ref_logits));
+        std.mem.sort(core.shard_edit.New, entries.items, {}, struct {
+            fn lt(_: void, x: core.shard_edit.New, y: core.shard_edit.New) bool {
+                return std.mem.order(u8, x.name, y.name) == .lt;
+            }
+        }.lt);
+        try core.shard_edit.create(gpa, op, &.{.{ "format", "pt" }}, entries.items);
+    }
+    return true;
+}
+
+test "packLatentKvRow and scoreProposals preserve MLA cache layout and per-depth chain counts" {
+    const pass = [_]u16{ 0x3c00, 0x4000, 0x4200, 0x4400 }; // 2 rows x 2 latent
+    const rot = [_]u16{ 0xbc00, 0xc000 }; // 2 rows x 1 rope
+    var out_u16: [6]u16 = undefined;
+    try packLatentKvRow(2, 2, 1, std.mem.sliceAsBytes(&pass), std.mem.sliceAsBytes(&rot), std.mem.sliceAsBytes(&out_u16));
+    try std.testing.expectEqualSlices(u16, &.{ 0x3c00, 0x4000, 0xbc00, 0x4200, 0x4400, 0xc000 }, &out_u16);
+
+    const eng = [_]u32{ 10, 20, 30, 10, 99, 30 };
+    const ref = [_]u32{ 10, 20, 30, 10, 20, 30 };
+    const code = [_]bool{ false, true };
+    var plens: [2]usize = undefined;
+    const rep = try scoreProposals(2, 3, &eng, &ref, &code, &plens);
+    try std.testing.expectEqualSlices(usize, &.{ 3, 1 }, &plens);
+    try std.testing.expectEqual(@as(usize, 5), rep.all.totalSlotEq(3));
+    try std.testing.expectEqualSlices(usize, &.{ 2, 1, 2 }, rep.all.slot_eq[0..3]);
+    try std.testing.expectEqualSlices(usize, &.{ 2, 3, 4 }, rep.all.cum_chain_eq[0..3]);
+    try std.testing.expectEqualSlices(usize, &.{ 2, 1, 1 }, rep.all.full_chain_eq[0..3]);
+    try std.testing.expectEqualSlices(usize, &.{ 1, 1, 1 }, rep.prose.full_chain_eq[0..3]);
+    try std.testing.expectEqualSlices(usize, &.{ 1, 0, 0 }, rep.code.full_chain_eq[0..3]);
+}
