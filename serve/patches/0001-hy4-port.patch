+
+    try tmp.dir.writeFile(io, .{ .sub_path = "src/model.safetensors.index.json", .data = try std.fmt.allocPrint(a, "{{\"weight_map\":{{{s}}}}}", .{base_wm.items}) });
+    try tmp.dir.writeFile(io, .{ .sub_path = "src/trunk-4b/trunk.index.json", .data = try std.fmt.allocPrint(a, "{{\"metadata\":{{\"matrices\":{{{s}}}}},\"weight_map\":{{{s}}}}}", .{ m4.items, wm4.items }) });
+    try tmp.dir.writeFile(io, .{ .sub_path = "src/trunk-6b/trunk.index.json", .data = try std.fmt.allocPrint(a, "{{\"metadata\":{{\"matrices\":{{{s}}}}},\"weight_map\":{{{s}}}}}", .{ m6.items, wm6.items }) });
+
+    // 1. Export --trunk 4b: 27 EXL3 trunk mats (5 + 8 + 7 + 7), L2 & L3 lossless shared_experts.down_proj.weight survives!
+    const out4 = try sub(a, root, "out-4b");
+    _ = try pack_export.exportPack(gpa, io, .{ .src = src, .out = out4, .trunk = "4b" });
+    _ = try pack_export.checkPack(gpa, io, out4, src); // Passes recorded "4b" recipe automatically!
+    const c4 = try sub(a, out4, "common");
+    for (0..4) |r| {
