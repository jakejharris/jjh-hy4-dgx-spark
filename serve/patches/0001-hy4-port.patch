--- /dev/null
+++ b/zig/src/families/hy4/trunk_exl3_window.zig
@@ -0,0 +1,286 @@
+//! 7-row decode window verification (`--check-window7`) for Full Hy4 quantized and lossless trunks.
+//!
+//! Compares one 7-row window call (`rows = 7`) against seven independent 1-row calls (`rows = 1`) on every
+//! loaded trunk projection (including TP=4 `gatherFold` on `o_proj` and `shared.down` and `decodeGroup` vs
+//! separate `decode`), plus end-to-end `ResidentModel.decodeWindow` stream and logit parity.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const ranks = @import("ranks.zig");
+const boundary = @import("boundary.zig");
+const weights = @import("weights.zig");
+const kv_pool = @import("kv_pool.zig");
+const forward = @import("forward.zig");
+const dump_oracle = @import("dump_oracle.zig");
+const resident = @import("resident.zig");
+const trunk_exl3 = @import("trunk_exl3.zig");
+
+const htp = cuda.hy4_tp;
+
+fn checkOneProj7(
+    rt: *forward.Runtime,
+    sc: *forward.Scratch,
+    p: trunk_exl3.LinearProj,
+    x_ptr: u64,
+    k_in: usize,
+    y7_ptr: u64,
+    y1_ptr: u64,
+    row_partial_f32: bool,
+    strided_pad: bool,
+    tp_sess: ?*const boundary.TpSession,
+    h: usize,
+) !struct { words: usize, diffs: usize } {
+    const gpa = rt.gpa;
+    if (row_partial_f32) {
+        if (tp_sess) |tps| {
+            try rt.runProjRowPartialF32(sc, x_ptr, p, sc.tp_partial.ptr, 7);
+            try forward.tpGatherFold(tps, rt, sc, h, 7);
+            const got7 = try gpa.alloc(u16, 7 * h);
+            defer gpa.free(got7);
+            try rt.stream.synchronize();
+            try cuda.memory.download(rt.d, sc.branch.ptr, std.mem.sliceAsBytes(got7));
+
+            const got1 = try gpa.alloc(u16, 7 * h);
+            defer gpa.free(got1);
+            for (0..7) |r| {
+                try rt.runProjRowPartialF32(sc, x_ptr + r * k_in * 2, p, sc.tp_partial.ptr, 1);
+                try forward.tpGatherFold(tps, rt, sc, h, 1);
+                try rt.stream.synchronize();
+                try cuda.memory.download(rt.d, sc.branch.ptr, std.mem.sliceAsBytes(got1[r * h ..][0..h]));
+            }
+            var d: usize = 0;
+            for (got7, got1) |a, b| if (a != b) { d += 1; };
+            return .{ .words = got7.len, .diffs = d };
+        }
+        try rt.runProjRowPartialF32(sc, x_ptr, p, y7_ptr, 7);
+        for (0..7) |r| try rt.runProjRowPartialF32(sc, x_ptr + r * k_in * 2, p, y1_ptr + r * p.logicalN() * 4, 1);
+        const got7 = try gpa.alloc(u32, 7 * p.logicalN()); defer gpa.free(got7);
+        const got1 = try gpa.alloc(u32, 7 * p.logicalN()); defer gpa.free(got1);
+        try rt.stream.synchronize();
+        try cuda.memory.download(rt.d, y7_ptr, std.mem.sliceAsBytes(got7));
+        try cuda.memory.download(rt.d, y1_ptr, std.mem.sliceAsBytes(got1));
+        var d: usize = 0;
+        for (got7, got1) |a, b| if (a != b) { d += 1; };
+        return .{ .words = got7.len, .diffs = d };
+    }
+
+    const out_stride: usize = if (strided_pad and p.kvRowStride() != 0) p.kvRowStride() else p.logicalN();
+    try rt.runProj(sc, x_ptr, p, y7_ptr, 7, strided_pad);
+    for (0..7) |r| try rt.runProj(sc, x_ptr + r * k_in * 2, p, y1_ptr + r * out_stride * 2, 1, strided_pad);
+    const got7 = try gpa.alloc(u16, 7 * out_stride); defer gpa.free(got7);
+    const got1 = try gpa.alloc(u16, 7 * out_stride); defer gpa.free(got1);
+    try rt.stream.synchronize();
+    try cuda.memory.download(rt.d, y7_ptr, std.mem.sliceAsBytes(got7));
+    try cuda.memory.download(rt.d, y1_ptr, std.mem.sliceAsBytes(got1));
+    var d: usize = 0;
+    for (0..7) |r| for (0..p.logicalN()) |c| {
+        if (got7[r * out_stride + c] != got1[r * out_stride + c]) d += 1;
+    };
+    return .{ .words = 7 * p.logicalN(), .diffs = d };
+}
+
+pub fn runCheckWindow7(
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+    idx: *const weights.ShardIndex,
+    prompt: dump_oracle.PromptTokens,
+    max_layers: ?usize,
+    skip_head: bool,
+    mem_floor_gib: usize,
+    tp_sess: ?*boundary.TpSession,
+    memFloorCheck: *const fn (usize) anyerror!void,
+) !void {
+    if (prompt.seq_len < 8) return error.BadInputIds;
+    const prefix_len = prompt.seq_len - 7;
+    const win7 = prompt.ids[prefix_len..][0..7];
+
+    var model = try resident.ResidentModel.load(gpa, io, d, stream, idx, .{
+        .max_layers = max_layers,
+        .skip_head = skip_head,
+        .chunk_rows = @max(prefix_len, resident.max_decode_window),
+        .logits_rows = resident.max_decode_window,
+        .mem_floor_gib = mem_floor_gib,
+        .tp_sess = tp_sess,
+    }, memFloorCheck);
+    defer model.deinit();
+    if (tp_sess) |tps| try tps.agreePostLoad("WIN7_LOADED", "Hy4 check-window7 load");
+
+    const t = model.t;
+    const check_graph = model.sc.graph_mode != .off and model.head != null and prefix_len >= t.index_topk;
+    const h: usize = t.hidden_size;
+    const ls = try ranks.LocalShape.forText(t, if (tp_sess) |tps| tps.rank else null);
+    const max_in: usize = @max(h, @max(@as(usize, t.q_lora_rank), @max(ls.valueRows(t), @max(ls.shared, ls.dense))));
+    const max_out_elems: usize = @max(h, @max(@as(usize, std.mem.alignForward(usize, t.kvARows(), 128)), @max(ls.queryRows(t), @max(ls.valueRows(t), @max(ls.shared, ls.dense)))));
+
+    var x_buf = try cuda.DeviceBuffer.alloc(d, 7 * max_in * 2); defer x_buf.free();
+    var y7_buf = try cuda.DeviceBuffer.alloc(d, 7 * max_out_elems * 4); defer y7_buf.free();
+    var y1_buf = try cuda.DeviceBuffer.alloc(d, 7 * max_out_elems * 4); defer y1_buf.free();
+    {
+        const host_x = try gpa.alloc(u16, 7 * max_in);
+        defer gpa.free(host_x);
+        var prng = std.Random.DefaultPrng.init(0x2026_1120_0007);
+        for (host_x) |*slot| {
+            const v = (@as(f32, @floatFromInt(prng.random().intRangeAtMost(i16, -256, 256))) / 256.0);
+            slot.* = core.quant.convert.bf16(v);
+        }
+        try x_buf.uploadAsync(0, std.mem.sliceAsBytes(host_x), stream.handle);
+    }
+
+    var exl3_words: usize = 0;
+    var exl3_diffs: usize = 0;
+    var bf16_words: usize = 0;
+    var bf16_diffs: usize = 0;
+    var group_diffs: usize = 0;
+    const Acc = struct {
+        fn add(p: trunk_exl3.LinearProj, r: anytype, ew: *usize, ed: *usize, bw: *usize, bd: *usize) void {
+            if (p == .exl3) {
+                ew.* += r.words;
+                ed.* += r.diffs;
+            } else {
+                bw.* += r.words;
+                bd.* += r.diffs;
+            }
+        }
+    };
+    for (model.layers) |*lw| {
+        Acc.add(lw.q_a, try checkOneProj7(&model.rt, &model.sc, lw.q_a, x_buf.ptr, h, y7_buf.ptr, y1_buf.ptr, false, false, null, h), &exl3_words, &exl3_diffs, &bf16_words, &bf16_diffs);
+        Acc.add(lw.q_b, try checkOneProj7(&model.rt, &model.sc, lw.q_b, x_buf.ptr, t.q_lora_rank, y7_buf.ptr, y1_buf.ptr, false, false, null, h), &exl3_words, &exl3_diffs, &bf16_words, &bf16_diffs);
+        Acc.add(lw.kv_a, try checkOneProj7(&model.rt, &model.sc, lw.kv_a, x_buf.ptr, h, y7_buf.ptr, y1_buf.ptr, false, true, null, h), &exl3_words, &exl3_diffs, &bf16_words, &bf16_diffs);
+        Acc.add(lw.linear_gate, try checkOneProj7(&model.rt, &model.sc, lw.linear_gate, x_buf.ptr, h, y7_buf.ptr, y1_buf.ptr, false, false, null, h), &exl3_words, &exl3_diffs, &bf16_words, &bf16_diffs);
+        Acc.add(lw.o_proj, try checkOneProj7(&model.rt, &model.sc, lw.o_proj, x_buf.ptr, ls.valueRows(t), y7_buf.ptr, y1_buf.ptr, true, false, tp_sess, h), &exl3_words, &exl3_diffs, &bf16_words, &bf16_diffs);
+
+        const dn: weights.DenseMlp = switch (lw.mlp) {
+            .dense => |dm| dm,
+            .sparse_bf16 => |sp| sp.shared,
+            .sparse_exl3 => |sp| sp.shared,
+        };
+        const ffn_w = dn.gate.logicalN();
+        Acc.add(dn.gate, try checkOneProj7(&model.rt, &model.sc, dn.gate, x_buf.ptr, h, y7_buf.ptr, y1_buf.ptr, false, false, null, h), &exl3_words, &exl3_diffs, &bf16_words, &bf16_diffs);
+        Acc.add(dn.up, try checkOneProj7(&model.rt, &model.sc, dn.up, x_buf.ptr, h, y7_buf.ptr, y1_buf.ptr, false, false, null, h), &exl3_words, &exl3_diffs, &bf16_words, &bf16_diffs);
+        Acc.add(dn.down, try checkOneProj7(&model.rt, &model.sc, dn.down, x_buf.ptr, ffn_w, y7_buf.ptr, y1_buf.ptr, true, false, tp_sess, h), &exl3_words, &exl3_diffs, &bf16_words, &bf16_diffs);
+
+        if (dn.gate == .exl3 and dn.up == .exl3 and dn.gate.exl3.k_pad == dn.gate.exl3.k and dn.gate.exl3.n_pad == dn.gate.exl3.n) {
+            try model.rt.runProjPair(&model.sc, x_buf.ptr, dn.gate, model.sc.ff_gate.ptr, false, dn.up, model.sc.ff_up.ptr, false, 7);
+            try model.rt.runProj(&model.sc, x_buf.ptr, dn.gate, y7_buf.ptr, 7, false);
+            try model.rt.runProj(&model.sc, x_buf.ptr, dn.up, y1_buf.ptr, 7, false);
+            const g_grp = try gpa.alloc(u16, 7 * ffn_w); defer gpa.free(g_grp);
+            const g_sep = try gpa.alloc(u16, 7 * ffn_w); defer gpa.free(g_sep);
+            const u_grp = try gpa.alloc(u16, 7 * ffn_w); defer gpa.free(u_grp);
+            const u_sep = try gpa.alloc(u16, 7 * ffn_w); defer gpa.free(u_sep);
+            try stream.synchronize();
+            try cuda.memory.download(d, model.sc.ff_gate.ptr, std.mem.sliceAsBytes(g_grp));
+            try cuda.memory.download(d, y7_buf.ptr, std.mem.sliceAsBytes(g_sep));
+            try cuda.memory.download(d, model.sc.ff_up.ptr, std.mem.sliceAsBytes(u_grp));
+            try cuda.memory.download(d, y1_buf.ptr, std.mem.sliceAsBytes(u_sep));
+            for (g_grp, g_sep) |a, b| if (a != b) { group_diffs += 1; };
+            for (u_grp, u_sep) |a, b| if (a != b) { group_diffs += 1; };
+        }
+    }
+
+    var pool_a = try kv_pool.KvPool.initSlice(gpa, d, t, 0, model.layers.len, prompt.seq_len);
+    defer pool_a.deinit();
+    var pool_b = try kv_pool.KvPool.initSlice(gpa, d, t, 0, model.layers.len, prompt.seq_len);
+    defer pool_b.deinit();
+    try pool_a.zeroFill(stream.handle);
+    try pool_b.zeroFill(stream.handle);
+
+    try model.prefill(&pool_a, prompt.ids[0..prefix_len], model.chunk_rows, null);
+    try model.prefill(&pool_b, prompt.ids[0..prefix_len], model.chunk_rows, null);
+
+    const stream_row_u16 = 4 * h;
+    const s_win7 = try gpa.alloc(u16, 7 * stream_row_u16); defer gpa.free(s_win7);
+    const s_1x7 = try gpa.alloc(u16, 7 * stream_row_u16); defer gpa.free(s_1x7);
+    const log_win7: []f32 = if (!skip_head) try gpa.alloc(f32, 7 * t.vocab_size) else &.{};
+    defer if (!skip_head) gpa.free(log_win7);
+    const log_1x7: []f32 = if (!skip_head) try gpa.alloc(f32, 7 * t.vocab_size) else &.{};
+    defer if (!skip_head) gpa.free(log_1x7);
+
+    if (skip_head) {
+        try model.forwardStep(&pool_a, prefix_len, win7);
+        try stream.synchronize();
+        try cuda.memory.download(d, model.sc.streams_a.ptr, std.mem.sliceAsBytes(s_win7));
+        for (0..7) |j| {
+            try model.forwardStep(&pool_b, prefix_len + j, win7[j .. j + 1]);
+            try stream.synchronize();
+            try cuda.memory.download(d, model.sc.streams_a.ptr, std.mem.sliceAsBytes(s_1x7[j * stream_row_u16 ..][0..stream_row_u16]));
+        }
+    } else {
+        try model.decodeWindow(&pool_a, prefix_len, win7, log_win7);
+        try cuda.memory.download(d, model.sc.streams_a.ptr, std.mem.sliceAsBytes(s_win7));
+        for (0..7) |j| {
+            try model.decodeWindow(&pool_b, prefix_len + j, win7[j .. j + 1], log_1x7[j * t.vocab_size ..][0..t.vocab_size]);
+            try cuda.memory.download(d, model.sc.streams_a.ptr, std.mem.sliceAsBytes(s_1x7[j * stream_row_u16 ..][0..stream_row_u16]));
+        }
+    }
+
+    var stream_diffs: usize = 0;
+    var stream_max_abs: f32 = 0;
+    for (s_win7, s_1x7) |a, b| {
+        if (a != b) stream_diffs += 1;
+        const fa = core.quant.convert.load(.bf16, std.mem.asBytes(&a), 0);
+        const fb = core.quant.convert.load(.bf16, std.mem.asBytes(&b), 0);
+        stream_max_abs = @max(stream_max_abs, @abs(fa - fb));
+    }
+    var argmax_same: usize = 0;
+    var logit_max_abs: f32 = 0;
+    if (!skip_head) {
+        for (0..7) |j| {
+            const ta = try resident.argmaxF32(log_win7[j * t.vocab_size ..][0..t.vocab_size]);
+            const tb = try resident.argmaxF32(log_1x7[j * t.vocab_size ..][0..t.vocab_size]);
+            if (ta == tb) argmax_same += 1;
+        }
+        for (log_win7, log_1x7) |a, b| logit_max_abs = @max(logit_max_abs, @abs(a - b));
+    }
+
+    if (tp_sess == null or tp_sess.?.rank == .zero) {
+        std.debug.print(
+            "hy4 check-window7 (tp={d} layers={d} prefix={d}): exl3_diffs={d}/{d} bf16_diffs={d}/{d} group_diffs={d} e2e_stream_diffs={d}/{d} stream_max_abs={d:.6} logit_max_abs={d:.6} argmax_match={d}/7\n",
+            .{
+                @as(usize, if (tp_sess != null) htp.world else 1), model.layers.len, prefix_len,
+                exl3_diffs, exl3_words, bf16_diffs, bf16_words, group_diffs, stream_diffs, s_win7.len, stream_max_abs, logit_max_abs, argmax_same,
+            },
+        );
+    }
+    if (exl3_diffs != 0 or group_diffs != 0) return error.Window7ProjectionMismatch;
+    if (check_graph) try @import("step_graph_check.zig").check(&model, &pool_a, &pool_b, prefix_len, win7);
+}
+
+pub fn runCheckWindow7Cli(
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+    idx: *const weights.ShardIndex,
+    synthetic_len: ?usize,
+    seed: u64,
+    prompt_st: ?[]const u8,
+    tokens_csv: ?[]const u8,
+    max_layers: ?usize,
+    skip_head: bool,
+    floor_gib: usize,
+    tp_ptr: ?*boundary.TpSession,
+    memFloorCheck: *const fn (usize) anyerror!void,
+) !void {
+    const prompt = if (synthetic_len) |slen|
+        try resident.syntheticPrompt(gpa, idx.cfg.value.text_config.vocab_size, slen, seed)
+    else if (prompt_st) |p|
+        try dump_oracle.readPromptSafetensors(gpa, io, p)
+    else if (tokens_csv) |csv| blk: {
+        var list: std.ArrayList(u32) = .empty;
+        errdefer list.deinit(gpa);
+        var it = std.mem.tokenizeAny(u8, csv, ", \t\r\n");
+        while (it.next()) |tok| try list.append(gpa, try std.fmt.parseInt(u32, tok, 10));
+        if (list.items.len == 0) return error.EmptyPrompt;
+        break :blk dump_oracle.PromptTokens{ .batch = 1, .seq_len = list.items.len, .ids = try list.toOwnedSlice(gpa) };
+    } else return error.BadArgs;
+    defer prompt.deinit(gpa);
+    if (tp_ptr) |tps| {
+        var tbuf: [96]u8 = undefined;
+        const rtag = try std.fmt.bufPrint(&tbuf, "win7:{?d}:{}:{d}", .{ max_layers, skip_head, prompt.seq_len });
+        try tps.agreePackAndRun(gpa, io, idx, rtag);
+    }
+    try runCheckWindow7(gpa, io, d, stream, idx, prompt, max_layers, skip_head, floor_gib, tp_ptr, memFloorCheck);
+    if (tp_ptr) |tps| try tps.finishRun(stream);
+}
diff --git a/zig/src/families/hy4/vision_config.zig b/zig/src/families/hy4/vision_config.zig
new file mode 100644
index 0000000000000000000000000000000000000000..29c99e1e063d3ce8227a15bf431d078d3c162970
--- /dev/null
+++ b/zig/src/families/hy4/vision_config.zig
@@ -0,0 +1,259 @@
+//! Full Hy4 (`hy_v4_vl`) vision tower configuration, image token markers, and `processor_config.json` settings.
+const std = @import("std");
+
+pub const Config = struct {
+    hidden_size: u32 = 1536,
+    intermediate_size: u32 = 6144,
+    num_hidden_layers: u32 = 40,
+    num_attention_heads: u32 = 16,
+    num_channels: u32 = 3,
+    patch_size: u32 = 16,
+    spatial_merge_size: u32 = 2,
+    temporal_patch_size: u32 = 1,
+    max_image_size: u32 = 2048,
+    max_vit_seq_len: u32 = 16384,
+    out_hidden_size: u32 = 6144,
+    layer_norm_eps: f32 = 1e-5,
+    rms_norm_eps: f32 = 1e-5,
+    image_start_token_id: u32 = 120118,
+    image_end_token_id: u32 = 120119,
+    image_token_id: u32 = 120120,
+    image_newline_token_id: u32 = 120121,
+    min_pixels: u64 = 4096,
+    max_pixels: u64 = 4_194_304,
+    rescale_factor: f64 = 1.0 / 255.0,
+    image_mean: [3]f32 = .{ 0.5, 0.5, 0.5 },
+    image_std: [3]f32 = .{ 0.5, 0.5, 0.5 },
+
+    pub fn headDim(self: Config) u32 {
+        return self.hidden_size / self.num_attention_heads;
+    }
+
+    pub fn patchDim(self: Config) u32 {
+        return self.num_channels * self.temporal_patch_size * self.patch_size * self.patch_size;
+    }
+
+    pub fn gridFactor(self: Config) u32 {
+        return self.patch_size * self.spatial_merge_size;
+    }
+
+    pub fn positionEdge(self: Config) u32 {
+        return self.max_image_size / self.patch_size;
+    }
+
+    pub fn numPositions(self: Config) u32 {
+        const e = self.positionEdge();
+        return e * e + 1;
+    }
+
+    pub fn validate(self: Config, text_hidden: u32, vocab_size: u32) !void {
+        if (self.hidden_size == 0 or self.num_hidden_layers == 0 or self.num_attention_heads == 0 or
+            self.hidden_size % self.num_attention_heads != 0 or self.headDim() != 96 or
+            self.hidden_size % 64 != 0 or self.intermediate_size == 0 or self.intermediate_size % 64 != 0)
+            return error.UnsupportedHy4Vision;
+        if (self.num_channels != 3 or self.patch_size != 16 or self.spatial_merge_size != 2 or
+            self.temporal_patch_size != 1 or self.max_image_size == 0 or self.max_image_size % self.patch_size != 0)
+            return error.UnsupportedHy4Vision;
+        const edge = self.positionEdge();
+        if (edge * edge != self.max_vit_seq_len) return error.UnsupportedHy4Vision;
+        if (self.out_hidden_size != text_hidden or self.hidden_size * 4 != self.out_hidden_size)
+            return error.UnsupportedHy4Vision;
+        if (!std.math.isFinite(self.layer_norm_eps) or self.layer_norm_eps <= 0 or
+            !std.math.isFinite(self.rms_norm_eps) or self.rms_norm_eps <= 0)
+            return error.UnsupportedHy4Vision;
+        if (self.min_pixels == 0 or self.max_pixels < self.min_pixels or !std.math.isFinite(self.rescale_factor) or self.rescale_factor <= 0)
+            return error.UnsupportedHy4Vision;
+        for (self.image_mean, self.image_std) |m, s| {
+            if (!std.math.isFinite(m) or !std.math.isFinite(s) or s <= 0) return error.UnsupportedHy4Vision;
+        }
+        for ([_]u32{ self.image_start_token_id, self.image_end_token_id, self.image_token_id, self.image_newline_token_id }) |id| {
+            if (id >= vocab_size) return error.UnsupportedHy4Vision;
+        }
+    }
+};
+
+fn jsonUint(comptime T: type, v: ?std.json.Value) !?T {
+    const x = v orelse return null;
+    return switch (x) {
+        .integer => |i| std.math.cast(T, i) orelse error.UnsupportedHy4Vision,
+        else => error.UnsupportedHy4Vision,
+    };
+}
+
+fn jsonFloat(comptime T: type, v: ?std.json.Value) !?T {
+    const x = v orelse return null;
+    return switch (x) {
+        .float => |f| @floatCast(f),
+        .integer => |i| @floatFromInt(i),
+        else => error.UnsupportedHy4Vision,
+    };
+}
+
+fn jsonVec3(v: ?std.json.Value) !?[3]f32 {
+    const x = v orelse return null;
+    if (x != .array or x.array.items.len != 3) return error.UnsupportedHy4Vision;
+    var out: [3]f32 = undefined;
+    for (&out, x.array.items) |*dst, item| {
+        dst.* = (try jsonFloat(f32, item)) orelse return error.UnsupportedHy4Vision;
+    }
+    return out;
+}
+
+pub fn parse(gpa: std.mem.Allocator, config_json: []const u8, processor_json: ?[]const u8) !?Config {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+
+    const root_val = try std.json.parseFromSliceLeaky(std.json.Value, a, config_json, .{});
+    if (root_val != .object) return error.BadConfigJson;
+    const root = root_val.object;
+    const vc_val = root.get("vision_config") orelse return null;
+    if (vc_val == .null) return null;
+    if (vc_val != .object) return error.BadConfigJson;
+    const vc = vc_val.object;
+
+    if (vc.get("hidden_act")) |act| {
+        if (act != .string or !std.mem.eql(u8, act.string, "gelu")) return error.UnsupportedHy4Vision;
+    }
+    if (vc.get("projector_type")) |pt| {
+        if (pt != .string or !std.mem.eql(u8, pt.string, "rmsnorm_mlp_adapter")) return error.UnsupportedHy4Vision;
+    }
+    if (vc.get("interpolate_mode")) |im| {
+        if (im != .string or !std.mem.eql(u8, im.string, "bilinear")) return error.UnsupportedHy4Vision;
+    }
+
+    const tc_obj = if (root.get("text_config")) |tv| (if (tv == .object) tv.object else root) else root;
+    const text_hidden = (try jsonUint(u32, tc_obj.get("hidden_size"))) orelse return error.BadConfigJson;
+    const vocab_size = (try jsonUint(u32, tc_obj.get("vocab_size"))) orelse return error.BadConfigJson;
+    if (tc_obj.get("rope_parameters")) |rp| {
+        if (rp != .object) return error.UnsupportedHy4Vision;
+        if (rp.object.get("mrope_interleaved")) |mi| if (mi != .bool or !mi.bool) return error.UnsupportedHy4Vision;
+        if (rp.object.get("mrope_section")) |ms| {
+            if (ms != .array or ms.array.items.len != 3) return error.UnsupportedHy4Vision;
+            const s0 = (try jsonUint(u32, ms.array.items[0])).?;
+            const s1 = (try jsonUint(u32, ms.array.items[1])).?;
+            const s2 = (try jsonUint(u32, ms.array.items[2])).?;
+            if (s0 != 12 or s1 != 10 or s2 != 10) return error.UnsupportedHy4Vision;
+        }
+    }
+
+    var cfg: Config = .{};
+    if (try jsonUint(u32, vc.get("hidden_size"))) |x| cfg.hidden_size = x;
+    if (try jsonUint(u32, vc.get("intermediate_size"))) |x| cfg.intermediate_size = x;
+    if (try jsonUint(u32, vc.get("num_hidden_layers"))) |x| cfg.num_hidden_layers = x;
+    if (try jsonUint(u32, vc.get("num_attention_heads"))) |x| cfg.num_attention_heads = x;
+    if (try jsonUint(u32, vc.get("num_channels"))) |x| cfg.num_channels = x;
+    if (try jsonUint(u32, vc.get("patch_size"))) |x| cfg.patch_size = x;
+    if (try jsonUint(u32, vc.get("spatial_merge_size"))) |x| cfg.spatial_merge_size = x;
+    if (try jsonUint(u32, vc.get("temporal_patch_size"))) |x| cfg.temporal_patch_size = x;
+    if (try jsonUint(u32, vc.get("max_image_size"))) |x| cfg.max_image_size = x;
+    if (try jsonUint(u32, vc.get("max_vit_seq_len"))) |x| cfg.max_vit_seq_len = x;
+    if (try jsonUint(u32, vc.get("out_hidden_size"))) |x| cfg.out_hidden_size = x;
+    if (try jsonFloat(f32, vc.get("layer_norm_eps"))) |x| cfg.layer_norm_eps = x;
+    if (try jsonFloat(f32, vc.get("rms_norm_eps"))) |x| cfg.rms_norm_eps = x;
+
+    if (try jsonUint(u32, root.get("image_start_token_id"))) |x| cfg.image_start_token_id = x;
+    if (try jsonUint(u32, root.get("image_end_token_id"))) |x| cfg.image_end_token_id = x;
+    if (try jsonUint(u32, root.get("image_token_id"))) |x| cfg.image_token_id = x;
+    if (try jsonUint(u32, root.get("image_newline_token_id"))) |x| cfg.image_newline_token_id = x;
+
+    if (processor_json) |proc_bytes| {
+        const proc_val = try std.json.parseFromSliceLeaky(std.json.Value, a, proc_bytes, .{});
+        if (proc_val != .object) return error.UnsupportedHy4Vision;
+        const ip = if (proc_val.object.get("image_processor")) |sub|
+            (if (sub == .object) sub.object else return error.UnsupportedHy4Vision)
+        else
+            proc_val.object;
+        if (try jsonUint(u32, ip.get("patch_size"))) |x| if (x != cfg.patch_size) return error.UnsupportedHy4Vision;
+        if (try jsonUint(u32, ip.get("merge_size"))) |x| if (x != cfg.spatial_merge_size) return error.UnsupportedHy4Vision;
+        if (try jsonUint(u32, ip.get("temporal_patch_size"))) |x| if (x != cfg.temporal_patch_size) return error.UnsupportedHy4Vision;
+        if (try jsonUint(u64, ip.get("min_pixels"))) |x| cfg.min_pixels = x;
+        if (try jsonUint(u64, ip.get("max_pixels"))) |x| cfg.max_pixels = x;
+        if (ip.get("size")) |sz| {
+            if (sz != .object) return error.UnsupportedHy4Vision;
+            if (try jsonUint(u64, sz.object.get("shortest_edge"))) |x| cfg.min_pixels = x;
+            if (try jsonUint(u64, sz.object.get("longest_edge"))) |x| cfg.max_pixels = x;
+        }
+        if (try jsonFloat(f64, ip.get("rescale_factor"))) |x| cfg.rescale_factor = x;
+        if (try jsonVec3(ip.get("image_mean"))) |x| cfg.image_mean = x;
+        if (try jsonVec3(ip.get("image_std"))) |x| cfg.image_std = x;
+    }
+
+    try cfg.validate(text_hidden, vocab_size);
+    return cfg;
+}
+
+pub fn readFromDir(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) !?Config {
+    const cfg_path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+    defer gpa.free(cfg_path);
+    const cfg_bytes = try std.Io.Dir.cwd().readFileAlloc(io, cfg_path, gpa, .limited(4 << 20));
+    defer gpa.free(cfg_bytes);
+    const proc_path = try std.fs.path.join(gpa, &.{ dir, "processor_config.json" });
+    defer gpa.free(proc_path);
+    const proc_bytes = std.Io.Dir.cwd().readFileAlloc(io, proc_path, gpa, .limited(1 << 20)) catch null;
+    defer if (proc_bytes) |b| gpa.free(b);
+    return parse(gpa, cfg_bytes, proc_bytes);
+}
+
+test "vision_config parses Hy4-VL checkpoint settings and processor_config.json [0.5, 0.5, 0.5] override" {
+    const cfg_json =
+        \\{
+        \\  "model_type": "hy_v4_vl",
+        \\  "image_start_token_id": 120118,
+        \\  "image_end_token_id": 120119,
+        \\  "image_token_id": 120120,
+        \\  "image_newline_token_id": 120121,
+        \\  "text_config": {
+        \\    "hidden_size": 6144,
+        \\    "vocab_size": 120832,
+        \\    "rope_parameters": {"mrope_interleaved": true, "mrope_section": [12, 10, 10]}
+        \\  },
+        \\  "vision_config": {
+        \\    "hidden_act": "gelu",
+        \\    "hidden_size": 1536,
+        \\    "intermediate_size": 6144,
+        \\    "interpolate_mode": "bilinear",
+        \\    "max_image_size": 2048,
+        \\    "max_vit_seq_len": 16384,
+        \\    "num_attention_heads": 16,
+        \\    "num_channels": 3,
+        \\    "num_hidden_layers": 40,
+        \\    "out_hidden_size": 6144,
+        \\    "patch_size": 16,
+        \\    "projector_type": "rmsnorm_mlp_adapter",
+        \\    "rms_norm_eps": 1e-05,
+        \\    "spatial_merge_size": 2,
+        \\    "temporal_patch_size": 1
+        \\  }
+        \\}
+    ;
+    const proc_json =
+        \\{
+        \\  "image_processor": {
+        \\    "image_mean": [0.5, 0.5, 0.5],
+        \\    "image_std": [0.5, 0.5, 0.5],
+        \\    "merge_size": 2,
+        \\    "patch_size": 16,
+        \\    "rescale_factor": 0.00392156862745098,
+        \\    "size": {"longest_edge": 4194304, "shortest_edge": 4096},
+        \\    "temporal_patch_size": 1
+        \\  }
+        \\}
+    ;
+    const c = (try parse(std.testing.allocator, cfg_json, proc_json)).?;
+    try std.testing.expectEqual(@as(u32, 96), c.headDim());
+    try std.testing.expectEqual(@as(u32, 768), c.patchDim());
+    try std.testing.expectEqual(@as(u32, 32), c.gridFactor());
+    try std.testing.expectEqual(@as(u32, 128), c.positionEdge());
