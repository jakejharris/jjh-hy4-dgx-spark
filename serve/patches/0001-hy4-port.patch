+    var seed: u64 = 20261120;
+    var chunk_size: ?usize = null;
+    var greedy_tokens: ?usize = null;
+    var bench_window_iters: usize = 0;
+    var bench_widths_arg: ?[]const u8 = null;
+    var bench_parts_iters: usize = 0;
