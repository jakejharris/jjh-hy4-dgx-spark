+fn sumHeaderGpuBytes(hdr: *const st.Header, t: config.Text, rank_opt: ?ranks.Rank) !u64 {
+    var sum: u64 = 0;
+    for (hdr.keys(), hdr.values()) |k, e| {
+        sum = try std.math.add(u64, sum, try cuda_native.entryGpuBytes(hdr, k, e, t, rank_opt));
+    }
+    return sum;
+}
