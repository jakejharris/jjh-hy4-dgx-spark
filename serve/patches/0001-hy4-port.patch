+    var sess_r2 = weights.ShardSession.initWithRank(&idx, io, try ranks.Rank.init(2, 4));
+    defer sess_r2.close();
+
+    for (specs) |sp| {
+        const pfx = try std.fmt.allocPrint(a, "model.layers.1.{s}", .{sp.sfx});
