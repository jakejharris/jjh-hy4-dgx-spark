+    "bos_token_id": 120000,
+    "compressed_indexer_candidate_topk": 2048,
+    "compressed_indexer_compress_ratio": 4,
+    "compressed_indexer_group_topk": 512,
+    "compressed_indexer_head_dim": 128,
