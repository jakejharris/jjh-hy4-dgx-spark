diff --git a/zig/src/families/hy4/exl3_weights.zig b/zig/src/families/hy4/exl3_weights.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6fccd5810a65bc008b5ad07a3ee4e05f56c2b36f
--- /dev/null
+++ b/zig/src/families/hy4/exl3_weights.zig
@@ -0,0 +1,154 @@
+//! EXL3 `mul1` routed-expert loader for Full Hy4 (`6144 x 2048` full, `6144 x 512` TP=4 slice, or `128 x 128` tiny).
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const weights = @import("weights.zig");
+
+pub fn readProj(
+    alloc: std.mem.Allocator,
+    sess: *weights.ShardSession,
+    layer: usize,
+    expert: usize,
+    proj_name: []const u8,
+    k_full_pad: usize,
+    n_full_pad: usize,
+    k_local_pad: usize,
+    n_local_pad: usize,
+) !cuda.exl3_upload.Proj {
+    var pbuf: [160]u8 = undefined;
+    const prefix = try std.fmt.bufPrint(&pbuf, "model.layers.{d}.mlp.experts.{d}.{s}_proj", .{ layer, expert, proj_name });
+    var n1: [192]u8 = undefined;
+    var n2: [192]u8 = undefined;
+    var n3: [192]u8 = undefined;
+    var n4: [192]u8 = undefined;
+
+    const tr_got = try sess.getSlice(alloc, try std.fmt.bufPrint(&n1, "{s}.trellis", .{prefix}), false);
+    const trellis = tr_got.tensor;
+    if (trellis.dtype != .i16 or trellis.rank != 3 or k_full_pad == 0 or n_full_pad == 0 or
+        k_full_pad % 128 != 0 or n_full_pad % 128 != 0 or k_local_pad == 0 or n_local_pad == 0 or
+        k_local_pad % 128 != 0 or n_local_pad % 128 != 0)
+        return error.BadHy4Trellis;
+
+    const g = try core.exl3_layout.Group.fromShape(trellis.shape[0..trellis.rank]);
+    if (g.k() != k_full_pad or g.n() != n_full_pad or trellis.numel() * 2 != g.trellisBytes())
+        return error.BadHy4Trellis;
+    if (g.k2() != 6 and g.k2() != 8)
+        return error.UnsupportedHy4ExpertBits;
+    const expect_tr_bytes = (k_local_pad / 16) * (n_local_pad / 16) * @as(usize, @intCast(g.tileBytes()));
+    if (tr_got.bytes.len != expect_tr_bytes)
+        return error.BadHy4Trellis;
+
+    const marker_name = try std.fmt.bufPrint(&n4, "{s}.mul1", .{prefix});
+    const mk_got = try sess.getSlice(alloc, marker_name, false);
+    const marker = mk_got.tensor;
+    if ((!marker.is(.i32, &.{}) and !marker.is(.i32, &.{1})) or mk_got.bytes.len != 4)
+        return error.BadHy4ExpertMarker;
+    if (try core.exl3_layout.fromMarker(std.mem.readInt(u32, mk_got.bytes[0..4], .little)) != .mul1)
+        return error.BadHy4ExpertMarker;
+
+    const suh_name = try std.fmt.bufPrint(&n2, "{s}.suh", .{prefix});
+    if (sess.idx.has(suh_name)) {
+        const suh = try sess.getSlice(alloc, suh_name, false);
+        const svh = try sess.getSlice(alloc, try std.fmt.bufPrint(&n3, "{s}.svh", .{prefix}), false);
+        if (!suh.tensor.is(.f16, &.{k_full_pad}) or !svh.tensor.is(.f16, &.{n_full_pad}))
+            return error.UnexpectedTensor;
+        if (suh.bytes.len != k_local_pad * 2 or svh.bytes.len != n_local_pad * 2)
+            return error.BadHy4Trellis;
+        return .{ .trellis = tr_got.bytes, .suh = suh.bytes, .svh = svh.bytes, .k2 = g.k2(), .signs = false };
+    }
+    const su = try sess.getSlice(alloc, try std.fmt.bufPrint(&n2, "{s}.su", .{prefix}), false);
+    const sv = try sess.getSlice(alloc, try std.fmt.bufPrint(&n3, "{s}.sv", .{prefix}), false);
+    if (!su.tensor.is(.i16, &.{k_full_pad / 16}) or !sv.tensor.is(.i16, &.{n_full_pad / 16}))
+        return error.UnexpectedTensor;
+    if (su.bytes.len != (k_local_pad / 16) * 2 or sv.bytes.len != (n_local_pad / 16) * 2)
+        return error.BadHy4Trellis;
+    return .{ .trellis = tr_got.bytes, .suh = su.bytes, .svh = sv.bytes, .k2 = g.k2(), .signs = true };
+}
+
+pub fn loadLayerExperts(
+    gpa: std.mem.Allocator,
+    sess: *weights.ShardSession,
+    up: *cuda.exl3_upload.Uploader,
+    layer: usize,
+    e_count: usize,
+    dims: usize,
+    full_inter: usize,
+    local_inter: usize,
+    swiglu_limit: f32,
+) !cuda.exl3_experts.Layer {
+    const dims_pad = std.mem.alignForward(usize, dims, 128);
+    const full_inter_pad = std.mem.alignForward(usize, full_inter, 128);
+    const local_inter_pad = std.mem.alignForward(usize, local_inter, 128);
+
+    var tmp_arena = std.heap.ArenaAllocator.init(gpa);
+    defer tmp_arena.deinit();
+    const ta = tmp_arena.allocator();
+
+    const projs = try ta.alloc(cuda.exl3_upload.Proj, 3 * e_count);
+    const gate_p = projs[0..e_count];
+    const up_p = projs[e_count..][0..e_count];
+    const down_p = projs[2 * e_count ..];
+    for (0..e_count) |ex| {
+        gate_p[ex] = try readProj(ta, sess, layer, ex, "gate", dims_pad, full_inter_pad, dims_pad, local_inter_pad);
+        up_p[ex] = try readProj(ta, sess, layer, ex, "up", dims_pad, full_inter_pad, dims_pad, local_inter_pad);
+        down_p[ex] = try readProj(ta, sess, layer, ex, "down", full_inter_pad, dims_pad, local_inter_pad, dims_pad);
+    }
+    var loaded = try cuda.exl3_upload.layer(up, gpa, dims_pad, local_inter_pad, .mul1, swiglu_limit, 0, gate_p, up_p, down_p);
+    loaded.uniform_k2 = for (projs) |p| {
+        if (p.k2 != projs[0].k2) break 0;
+    } else projs[0].k2;
+    return loaded;
+}
+
+test "readProj admits k2 in {6,8} for tiny and TP=4 6144x512 slices and rejects k2 outside {6,8}" {
+    const gpa = std.testing.allocator;
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const dir = try tmp.dir.realPathFileAlloc(io, ".", gpa);
+    defer gpa.free(dir);
+
+    try tmp.dir.writeFile(io, .{ .sub_path = "config.json", .data =
+        \\{"text_config":{"model_type":"hy_v4","hidden_size":32,"intermediate_size":64,"moe_intermediate_size":16,
+        \\"num_hidden_layers":2,"vocab_size":16,"q_lora_rank":12,"kv_lora_rank":8,"num_attention_heads":4,
+        \\"qk_nope_head_dim":10,"qk_rope_head_dim":6,"v_head_dim":16,"index_n_heads":4,"index_head_dim":16,
+        \\"index_topk":16,"indexer_types":["full","full"],"mlp_layer_types":["dense","sparse"],
+        \\"n_routed_experts":2,"num_experts_per_tok":1}}
+    });
+    const trellis_3b: [8 * 8 * 48 * 2]u8 = @splat(0);
+    const trellis_4b: [8 * 8 * 64 * 2]u8 = @splat(0);
+    const trellis_2b: [8 * 8 * 32 * 2]u8 = @splat(0);
+    const scales_f16: [128 * 2]u8 = @splat(0);
+    const signs_i16: [8 * 2]u8 = @splat(0);
+    const mul1 = [_]u8{ 0x2D, 0xD1, 0xDC, 0x83 };
+    const shard = try std.fs.path.join(gpa, &.{ dir, "model.safetensors" });
+    defer gpa.free(shard);
+    try core.shard_edit.create(gpa, shard, &.{}, &.{
+        .{ .name = "model.layers.1.mlp.experts.0.gate_proj.trellis", .dtype = .i16, .shape = &.{ 8, 8, 48 }, .bytes = &trellis_3b },
+        .{ .name = "model.layers.1.mlp.experts.0.gate_proj.suh", .dtype = .f16, .shape = &.{128}, .bytes = &scales_f16 },
+        .{ .name = "model.layers.1.mlp.experts.0.gate_proj.svh", .dtype = .f16, .shape = &.{128}, .bytes = &scales_f16 },
+        .{ .name = "model.layers.1.mlp.experts.0.gate_proj.mul1", .dtype = .i32, .shape = &.{}, .bytes = &mul1 },
+        .{ .name = "model.layers.1.mlp.experts.0.down_proj.trellis", .dtype = .i16, .shape = &.{ 8, 8, 64 }, .bytes = &trellis_4b },
+        .{ .name = "model.layers.1.mlp.experts.0.down_proj.su", .dtype = .i16, .shape = &.{8}, .bytes = &signs_i16 },
+        .{ .name = "model.layers.1.mlp.experts.0.down_proj.sv", .dtype = .i16, .shape = &.{8}, .bytes = &signs_i16 },
+        .{ .name = "model.layers.1.mlp.experts.0.down_proj.mul1", .dtype = .i32, .shape = &.{1}, .bytes = &mul1 },
+        .{ .name = "model.layers.1.mlp.experts.1.gate_proj.trellis", .dtype = .i16, .shape = &.{ 8, 8, 32 }, .bytes = &trellis_2b },
+        .{ .name = "model.layers.1.mlp.experts.1.gate_proj.suh", .dtype = .f16, .shape = &.{128}, .bytes = &scales_f16 },
+        .{ .name = "model.layers.1.mlp.experts.1.gate_proj.svh", .dtype = .f16, .shape = &.{128}, .bytes = &scales_f16 },
+        .{ .name = "model.layers.1.mlp.experts.1.gate_proj.mul1", .dtype = .i32, .shape = &.{}, .bytes = &mul1 },
+    });
+
+    var idx = try weights.ShardIndex.open(gpa, io, dir);
+    defer idx.deinit();
+    var sess = weights.ShardSession.init(&idx, io);
+    defer sess.close();
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const gp = try readProj(arena.allocator(), &sess, 1, 0, "gate", 128, 128, 128, 128);
+    const dp = try readProj(arena.allocator(), &sess, 1, 0, "down", 128, 128, 128, 128);
+    try std.testing.expectEqual(@as(u32, 6), gp.k2);
+    try std.testing.expect(!gp.signs);
+    try std.testing.expectEqual(@as(u32, 8), dp.k2);
+    try std.testing.expect(dp.signs);
+    try std.testing.expectError(error.UnsupportedHy4ExpertBits, readProj(arena.allocator(), &sess, 1, 1, "gate", 128, 128, 128, 128));
+}
diff --git a/zig/src/families/hy4/forward.zig b/zig/src/families/hy4/forward.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c90621b66d69f504af1d9c70947fddae06f51be7
--- /dev/null
+++ b/zig/src/families/hy4/forward.zig
@@ -0,0 +1,595 @@
+//! One-rank and four-rank (`TP=4`) Full Hy4 CUDA forward pass over `cuda.hy4_ops` and `cuda.hy4_tp.Boundary`.
+//!
+//! Wires `matchColumnPlan` on every rank-sliced BF16 GEMM (`q_b`, `linear_gate`, `dense` & `shared` `gate`/`up`,
+//! BF16 MoE `gate_up`) and the FP32 vocabulary head (`+ lastHeadPlan`), FP32 row-partial `o_proj` and `down_proj`,
+//! `addExpertPartial` for local routed + shared MoE FP32 partials, and `Boundary.gatherFold` -> `ihcWrite`.
+const std = @import("std");
+const cuda = @import("cuda");
+const config = @import("config.zig");
+const ranks = @import("ranks.zig");
+const boundary = @import("boundary.zig");
+const weights = @import("weights.zig");
+const cache = @import("cache.zig");
+const dump_oracle = @import("dump_oracle.zig");
+const moe_forward = @import("moe_forward.zig");
+const trunk_exl3 = @import("trunk_exl3.zig");
+const vision_runtime = @import("vision_runtime.zig");
+pub const Scratch = cache.Scratch;
+pub const LayerCache = cache.LayerCache;
+const workspace_bytes = 32 << 20;
+pub const PartBucket = @import("window_bench.zig").PartBucket;
+pub const PartTimers = @import("window_bench.zig").PartTimers;
+fn partNowNs(io: std.Io) u64 {
+    return @intCast(@max(@as(i128, 0), std.Io.Clock.awake.now(io).toNanoseconds()));
+}
+pub const Runtime = struct {
+    short_trunk: cuda.hy4_ops.ShortTrunk,
+    gpa: std.mem.Allocator, d: *const cuda.Driver, stream: cuda.Stream,
+    ops: cuda.hy4_ops.Kernels, gemm: cuda.vit.Gemms, vit_k: cuda.vit.Kernels,
+    norms: cuda.norms.Norms, act: cuda.act_rows.ActRows, embed: cuda.embed_rows.EmbedRows,
+    exl3_dense: cuda.exl3.Dense,
+    parts: ?*PartTimers = null,
+    parts_io: ?std.Io = null,
+    f32_plans: std.AutoHashMapUnmanaged([3]u64, cuda.cublaslt.Linear) = .empty,
+    col_bf16_plans: std.AutoHashMapUnmanaged([4]u64, cuda.cublaslt.Linear) = .empty,
+    vocab_f32_plans: std.AutoHashMapUnmanaged([4]u64, cuda.cublaslt.Linear) = .empty,
+    last_head_plans: std.AutoHashMapUnmanaged([4]u64, ?cuda.cublaslt.Linear) = .empty,
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, stream: cuda.Stream) !Runtime {
+        var ops = try cuda.hy4_ops.Kernels.load(d); errdefer ops.deinit();
+        var gemm = try cuda.vit.Gemms.init(gpa, d); errdefer gemm.deinit();
+        var vit_k = try cuda.vit.Kernels.load(d); errdefer vit_k.unload();
+        var norms = try cuda.norms.Norms.load(d); errdefer norms.unload();
+        var act = try cuda.act_rows.ActRows.load(d); errdefer act.unload();
+        var embed = try cuda.embed_rows.EmbedRows.load(d); errdefer embed.unload();
+        var exl3_dense = try cuda.exl3.Dense.load(d); errdefer exl3_dense.unload();
+        return .{ .gpa = gpa, .d = d, .stream = stream, .ops = ops, .gemm = gemm, .vit_k = vit_k, .norms = norms, .act = act, .embed = embed, .exl3_dense = exl3_dense, .short_trunk = try cuda.hy4_ops.ShortTrunk.load(d) };
+    }
+
+    pub fn deinit(self: *Runtime) void {
+        inline for (.{ "f32_plans", "col_bf16_plans", "vocab_f32_plans" }) |field| {
+            var it = @field(self, field).valueIterator();
+            while (it.next()) |p| p.deinit();
+            @field(self, field).deinit(self.gpa);
+        }
+        var lhp_it = self.last_head_plans.valueIterator();
+        while (lhp_it.next()) |slot| if (slot.*) |*p| p.deinit();
+        self.last_head_plans.deinit(self.gpa);
+        self.short_trunk.deinit();
+        self.exl3_dense.unload(); self.embed.unload(); self.act.unload(); self.norms.unload(); self.vit_k.unload(); self.gemm.deinit(); self.ops.deinit();
+        self.* = undefined;
+    }
+
+    pub fn copy2dAsync(self: *Runtime, dst: u64, dst_pitch: usize, src: u64, src_pitch: usize, width: usize, rows: usize) !void {
+        if (rows == 0 or width == 0) return;
+        const copy: cuda.abi.Memcpy2D = .{ .src = src, .src_pitch = src_pitch, .dst = dst, .dst_pitch = dst_pitch, .width = width, .height = rows };
+        try self.d.check(self.d.api.cuMemcpy2DAsync_v2(&copy, self.stream.handle), "cuMemcpy2DAsync");
+    }
+
+    fn runMatchedBf16(self: *Runtime, x: u64, w_ptr: u64, y: u64, rows: usize, n_loc: usize, n_full: usize, k: usize) !void {
+        const key: [4]u64 = .{ rows, n_loc, n_full, k };
+        const gop = try self.col_bf16_plans.getOrPut(self.gpa, key);
+        if (!gop.found_existing) {
+            errdefer self.col_bf16_plans.removeByPtr(gop.key_ptr);
+            var full = try cuda.cublaslt.Linear.init(&self.gemm.lt, rows, n_full, k, .bf16, workspace_bytes);
+            defer full.deinit();
+            var loc = try cuda.cublaslt.Linear.init(&self.gemm.lt, rows, n_loc, k, .bf16, workspace_bytes);
+            errdefer loc.deinit();
+            var pinned = true;
+            tryPinColumnPlan(&full, &loc, workspace_bytes) catch |err| {
+                if (!isColumnPlanMismatch(err)) return err;
+                pinned = false;
+                if (n_full != n_loc * cuda.hy4_tp.world) {
+                    var full_aligned = try cuda.cublaslt.Linear.init(&self.gemm.lt, rows, n_loc * cuda.hy4_tp.world, k, .bf16, workspace_bytes);
+                    defer full_aligned.deinit();
+                    if (tryPinColumnPlan(&full_aligned, &loc, workspace_bytes)) |_| {
+                        pinned = true;
+                    } else |e2| if (!isColumnPlanMismatch(e2)) return e2;
+                }
+            };
+            std.log.info("hy4 column plan (bf16 rows={d} n={d}/{d} k={d}): pinned={}", .{ rows, n_loc, n_full, k, pinned });
+            gop.value_ptr.* = loc;
+        }
+        try gop.value_ptr.run(x, w_ptr, y, self.gemm.workspace.ptr, workspace_bytes, self.stream.handle);
+    }
+
+    pub fn runLinearBf16(self: *Runtime, sc: *Scratch, x: u64, w: weights.LinearBf16, y: u64, rows: usize) !void {
+        if (rows == 0) return;
+        const sliced = w.fullN() != w.n;
+        if (!w.padded) {
+            if (sliced) return self.runMatchedBf16(x, w.ptr, y, rows, w.n, w.fullN(), w.k);
+            return self.gemm.run(self.stream, x, w.ptr, y, rows, w.n, w.k, .bf16);
+        }
+        try sc.ensurePadScratch(rows * @as(usize, @max(w.k_pad, w.n_pad)) * 2);
+        const pad_view: cuda.DeviceBuffer = .{ .d = self.d, .ptr = sc.pad_in.ptr, .len = rows * w.k_pad * 2, .borrowed = true };
+        try pad_view.fill8(0, self.stream.handle);
+        try self.copy2dAsync(sc.pad_in.ptr, w.k_pad * 2, x, w.k * 2, w.k * 2, rows);
+        if (sliced) {
+            try self.runMatchedBf16(sc.pad_in.ptr, w.ptr, sc.pad_out.ptr, rows, w.n_pad, w.fullNPad(), w.k_pad);
+        } else {
+            try self.gemm.run(self.stream, sc.pad_in.ptr, w.ptr, sc.pad_out.ptr, rows, w.n_pad, w.k_pad, .bf16);
+        }
+        try self.copy2dAsync(y, w.n * 2, sc.pad_out.ptr, w.n_pad * 2, w.n * 2, rows);
+    }
+
+    pub fn runLinearRowPartialF32(self: *Runtime, sc: *Scratch, x: u64, w: weights.LinearBf16, y_f32: u64, rows: usize) !void {
+        if (rows == 0) return;
+        if (!w.padded) return self.gemm.run(self.stream, x, w.ptr, y_f32, rows, w.n, w.k, .f32);
+        try sc.ensurePadScratch(rows * w.k_pad * 2);
+        const pad_view: cuda.DeviceBuffer = .{ .d = self.d, .ptr = sc.pad_in.ptr, .len = rows * w.k_pad * 2, .borrowed = true };
+        try pad_view.fill8(0, self.stream.handle);
+        try self.copy2dAsync(sc.pad_in.ptr, w.k_pad * 2, x, w.k * 2, w.k * 2, rows);
+        try self.gemm.run(self.stream, sc.pad_in.ptr, w.ptr, sc.f32_tmp.ptr, rows, w.n_pad, w.k_pad, .f32);
+        try self.copy2dAsync(y_f32, w.n * 4, sc.f32_tmp.ptr, w.n_pad * 4, w.n * 4, rows);
+    }
+
+    pub fn runProj(self: *Runtime, sc: *Scratch, x: u64, w: weights.LinearProj, y: u64, rows: usize, allow_strided_pad: bool) !void {
+        return switch (w) {
+            .bf16 => |b| self.runLinearBf16(sc, x, b, y, rows),
+            .exl3 => |ex| trunk_exl3.runExl3Gemm(&self.short_trunk, &self.exl3_dense, &self.gemm, self.stream, sc, x, ex, y, rows, allow_strided_pad),
+        };
+    }
+
+    pub fn runProjPair(self: *Runtime, sc: *Scratch, x: u64, w0: weights.LinearProj, y0: u64, s0: bool, w1: weights.LinearProj, y1: u64, s1: bool, rows: usize) !void {
+        if (w0 == .exl3 and w1 == .exl3 and !(self.short_trunk.fast_prefill and rows >= self.short_trunk.min_prefill_rows)) {
+            const e0 = w0.exl3;
+            const e1 = w1.exl3;
+            if (e0.k_pad == e0.k and e1.k_pad == e1.k and (e0.n_pad == e0.n or s0) and (e1.n_pad == e1.n or s1)) {
+                if (try self.short_trunk.paired(&self.exl3_dense, self.stream, .{ e0.weight, e1.weight }, x, .{ y0, y1 }, rows)) return;
+                return self.exl3_dense.decodeGroup(self.stream, &.{ e0.weight, e1.weight }, x, .bf16, rows, &.{ y0, y1 }, .bf16);
+            }
+        }
+        try self.runProj(sc, x, w0, y0, rows, s0);
+        try self.runProj(sc, x, w1, y1, rows, s1);
+    }
+
+    pub fn runProjRowPartialF32(self: *Runtime, sc: *Scratch, x: u64, w: weights.LinearProj, y_f32: u64, rows: usize) !void {
+        return switch (w) {
+            .bf16 => |b| self.runLinearRowPartialF32(sc, x, b, y_f32, rows),
+            .exl3 => |ex| trunk_exl3.runExl3RowPartialF32Gemm(&self.short_trunk, &self.exl3_dense, &self.gemm, self.stream, sc, x, ex, y_f32, rows),
+        };
+    }
+
+    pub fn runLinearF32(self: *Runtime, x: u64, w: u64, y: u64, rows: usize, n: usize, k: usize) !void {
+        if (rows == 0) return;
+        const gop = try self.f32_plans.getOrPut(self.gpa, .{ rows, n, k });
+        if (!gop.found_existing) {
+            gop.value_ptr.* = cuda.cublaslt.Linear.initTyped(&self.gemm.lt, rows, n, k, .f32, .f32, workspace_bytes, .none) catch |e| {
+                self.f32_plans.removeByPtr(gop.key_ptr);
+                return e;
+            };
+        }
+        try gop.value_ptr.run(x, w, y, self.gemm.workspace.ptr, workspace_bytes, self.stream.handle);
+    }
+
+    fn getOrMakeVocabPlan(self: *Runtime, rows: usize, n_loc: usize, n_full: usize, k: usize) !*cuda.cublaslt.Linear {
+        const key: [4]u64 = .{ rows, n_loc, n_full, k };
+        const gop = try self.vocab_f32_plans.getOrPut(self.gpa, key);
+        if (!gop.found_existing) {
+            errdefer self.vocab_f32_plans.removeByPtr(gop.key_ptr);
+            var loc = try cuda.cublaslt.Linear.initTyped(&self.gemm.lt, rows, n_loc, k, .f32, .f32, workspace_bytes, .none);
+            errdefer loc.deinit();
+            if (n_loc != n_full) {
+                var full = try cuda.cublaslt.Linear.initTyped(&self.gemm.lt, rows, n_full, k, .f32, .f32, workspace_bytes, .none);
+                defer full.deinit();
+                var pinned = true;
+                tryPinColumnPlan(&full, &loc, workspace_bytes) catch |err| {
+                    if (!isColumnPlanMismatch(err)) return err;
+                    pinned = false;
+                    if (n_full != n_loc * cuda.hy4_tp.world) {
+                        var full_aligned = try cuda.cublaslt.Linear.initTyped(&self.gemm.lt, rows, n_loc * cuda.hy4_tp.world, k, .f32, .f32, workspace_bytes, .none);
+                        defer full_aligned.deinit();
+                        if (tryPinColumnPlan(&full_aligned, &loc, workspace_bytes)) |_| {
+                            pinned = true;
+                        } else |e2| if (!isColumnPlanMismatch(e2)) return e2;
+                    }
+                };
+                std.log.info("hy4 column plan (vocab_f32 rows={d} n={d}/{d} k={d}): pinned={}", .{ rows, n_loc, n_full, k, pinned });
+            }
+            gop.value_ptr.* = loc;
+        }
+        return gop.value_ptr;
+    }
+
+    pub fn runVocabF32(self: *Runtime, x: u64, w: u64, y: u64, rows: usize, n_loc: usize, n_full: usize, k: usize, ref_chunk_rows: usize) !void {
+        if (rows == 0) return;
+        if (rows == 1 and ref_chunk_rows > 1) {
+            const lkey: [4]u64 = .{ ref_chunk_rows, n_loc, n_full, k };
+            if (!self.last_head_plans.contains(lkey)) {
+                const chunk_plan = try self.getOrMakeVocabPlan(ref_chunk_rows, n_loc, n_full, k);
+                if (makePinnedLastHeadPlan(chunk_plan, n_loc, k, workspace_bytes)) |lp_val| {
+                    try self.last_head_plans.put(self.gpa, lkey, lp_val);
+                    std.log.info("hy4 column plan (last_head ref_rows={d} n={d}/{d} k={d}): pinned=true", .{ ref_chunk_rows, n_loc, n_full, k });
+                } else |err| {
+                    _ = try lastHeadFallback(err, n_loc, n_full);
+                    try self.last_head_plans.put(self.gpa, lkey, null);
+                    std.log.info("hy4 column plan (last_head ref_rows={d} n={d}/{d} k={d}): pinned=false", .{ ref_chunk_rows, n_loc, n_full, k });
+                }
+            }
+            if (self.last_head_plans.getPtr(lkey).?.*) |*lp| {
+                return lp.run(x, w, y, self.gemm.workspace.ptr, workspace_bytes, self.stream.handle);
+            }
+            if (n_loc == n_full) return self.runLinearF32(x, w, y, 1, n_loc, k);
+            const plan1 = try self.getOrMakeVocabPlan(1, n_loc, n_full, k);
+            return plan1.run(x, w, y, self.gemm.workspace.ptr, workspace_bytes, self.stream.handle);
+        }
+        if (n_loc == n_full) return self.runLinearF32(x, w, y, rows, n_loc, k);
+        const plan = try self.getOrMakeVocabPlan(rows, n_loc, n_full, k);
+        try plan.run(x, w, y, self.gemm.workspace.ptr, workspace_bytes, self.stream.handle);
+    }
+
+    pub fn runRmsNorm(self: *Runtime, sc: *Scratch, x: u64, w: weights.RmsNormWeight, y: u64, rows: usize, eps: f32) !void {
+        if (rows == 0) return;
+        if (w.width % 64 == 0) return self.norms.addRmsTail(self.stream, x, null, w.bf16_ptr, sc.norm_tmp.ptr, y, null, rows, w.width, eps, .{ .round = true });
+        try self.norms.rms(self.stream, x, .bf16, w.f32_ptr, y, .bf16, rows, w.width, eps);
+    }
+
+    pub fn runSwigluBf16(self: *Runtime, sc: *Scratch, gate: u64, up: u64, out: u64, rows: usize, width: usize) !void {
+        if (rows == 0) return;
+        if (width % 64 == 0) return self.act.swiglu(self.stream, gate, width, up, width, out, null, rows, width);
+        const pad_w = std.mem.alignForward(usize, width, 64);
+        try sc.ensurePadScratch(rows * pad_w * 2);
+        const p_in: cuda.DeviceBuffer = .{ .d = self.d, .ptr = sc.pad_in.ptr, .len = rows * pad_w * 2, .borrowed = true };
+        const p_out: cuda.DeviceBuffer = .{ .d = self.d, .ptr = sc.pad_out.ptr, .len = rows * pad_w * 2, .borrowed = true };
+        try p_in.fill8(0, self.stream.handle);
+        try p_out.fill8(0, self.stream.handle);
+        try self.copy2dAsync(sc.pad_in.ptr, pad_w * 2, gate, width * 2, width * 2, rows);
+        try self.copy2dAsync(sc.pad_out.ptr, pad_w * 2, up, width * 2, width * 2, rows);
+        try self.act.swiglu(self.stream, sc.pad_in.ptr, pad_w, sc.pad_out.ptr, pad_w, sc.pad_in.ptr, null, rows, pad_w);
+        try self.copy2dAsync(out, width * 2, sc.pad_in.ptr, pad_w * 2, width * 2, rows);
+    }
+
+    pub fn widenBf16ToF32(self: *Runtime, sc: *Scratch, x_bf16: u64, rows: usize, width: usize) !u64 {
+        const sub: cuda.DeviceBuffer = .{ .d = self.d, .ptr = sc.f32_in.ptr, .len = rows * width * 4, .borrowed = true };
+        try sub.fill8(0, self.stream.handle);
+        try self.norms.addRms(self.stream, x_bf16, .bf16, sc.f32_in.ptr, null, sc.zeros_f32.ptr, sc.f32_tmp.ptr, .f32, rows, width, 1.0);
+        return sc.f32_in.ptr;
+    }
+
+    noinline fn resetPartMarkSlow(self: *Runtime) !void {
+        const pt = self.parts.?;
+        try self.stream.synchronize();
+        pt.mark_ns = partNowNs(self.parts_io.?);
+    }
+
+    noinline fn stampPartSlow(self: *Runtime, bucket: PartBucket, tp_sess: ?*const boundary.TpSession) !void {
+        const pt = self.parts.?;
+        if (bucket == .tp_gather and tp_sess != null) try tp_sess.?.boundary.finish(self.stream) else try self.stream.synchronize();
+        const now = partNowNs(self.parts_io.?);
+        pt.add(bucket, now -| pt.mark_ns);
+        pt.mark_ns = now;
+    }
+
+    pub inline fn resetPartMark(self: *Runtime) !void {
+        if (self.parts != null) {
+            @branchHint(.unlikely);
+            return self.resetPartMarkSlow();
+        }
+    }
+
+    pub inline fn stampPart(self: *Runtime, bucket: PartBucket, tp_sess: ?*const boundary.TpSession) !void {
+        if (self.parts != null) {
+            @branchHint(.unlikely);
+            return self.stampPartSlow(bucket, tp_sess);
+        }
+    }
+};
+
+pub const LayerCaptureHost = struct {
+    streams_in: ?[]u8 = null, attention_out: ?[]u8 = null, index_positions: ?[]i32 = null, dense_out: ?[]u8 = null,
+    router_ids: ?[]i32 = null, router_weights: ?[]f32 = null, moe_out: ?[]u8 = null, streams_out: ?[]u8 = null,
+};
+
+pub fn tpGatherFold(tp_sess: *const boundary.TpSession, rt: *Runtime, sc: *Scratch, h: usize, rows: usize) !void {
+    if (h < cuda.hy4_tp.hidden) {
+        const tail: cuda.DeviceBuffer = .{ .d = rt.d, .ptr = sc.tp_partial.ptr + rows * h * 4, .len = rows * (cuda.hy4_tp.hidden - h) * 4, .borrowed = true };
+        try tail.fill8(0, rt.stream.handle);
+    }
+    try tp_sess.gatherFold(&rt.ops, rt.stream, rows, sc.tp_partial.ptr, sc.tp_partial.len, sc.tp_gathered.ptr, sc.tp_gathered.len, sc.branch.ptr, sc.branch.len);
+}
+
+pub fn runDenseBranch(rt: *Runtime, sc: *Scratch, dn: weights.DenseMlp, rows: usize, out_ptr: u64) !void {
+    try rt.runProjPair(sc, sc.hidden.ptr, dn.gate, sc.ff_gate.ptr, false, dn.up, sc.ff_up.ptr, false, rows);
+    try rt.runSwigluBf16(sc, sc.ff_gate.ptr, sc.ff_up.ptr, sc.ff_inner.ptr, rows, dn.gate.logicalN());
+    try rt.runProj(sc, sc.ff_inner.ptr, dn.down, out_ptr, rows, false);
+}
+
+pub fn runDensePartialF32(rt: *Runtime, sc: *Scratch, dn: weights.DenseMlp, rows: usize, out_f32_ptr: u64) !void {
+    if (try trunk_exl3.tryGated(&rt.short_trunk, &rt.exl3_dense, rt.stream, dn, sc.hidden.ptr, out_f32_ptr, rows)) return;
+    try rt.runProjPair(sc, sc.hidden.ptr, dn.gate, sc.ff_gate.ptr, false, dn.up, sc.ff_up.ptr, false, rows);
+    try rt.runSwigluBf16(sc, sc.ff_gate.ptr, sc.ff_up.ptr, sc.ff_inner.ptr, rows, dn.gate.logicalN());
+    try rt.runProjRowPartialF32(sc, sc.ff_inner.ptr, dn.down, out_f32_ptr, rows);
+}
+
+pub fn routeF32LogitsAndTopk(
+    rt: *Runtime, sc: *Scratch, x_bf16: u64, router_f32: u64, correction_bias: u64,
+    rows: usize, dims: usize, e_count: usize, top_k: usize, normalize: bool, scale: f32,
+) !void {
+    const x_f32 = try rt.widenBf16ToF32(sc, x_bf16, rows, dims);
+    try rt.runLinearF32(x_f32, router_f32, sc.router_logits.ptr, rows, e_count, dims);
+    try rt.ops.glue.topk(rt.stream, sc.router_logits.ptr, correction_bias, .{
+        .experts = e_count, .topk = top_k, .score = true, .shared = false, .normalize = normalize, .scale = scale,
+    }, sc.router_ids.ptr, sc.router_weights.ptr, rows);
+}
+
+fn readNorm(rt: *Runtime, sc: *Scratch, rows: usize, t: config.Text, streams: u64, hc: weights.IhcWeights, norm: weights.RmsNormWeight, head: bool) !void {
+    const shape: cuda.hy4_ops.IhcShape = .{ .rows = @intCast(rows), .width = t.hidden_size, .rms_eps = t.rms_norm_eps, .hc_eps = t.hc_eps, .magnitude = t.hc_magnitude };
+    const b: cuda.hy4_ops.IhcRead = .{ .streams = streams, .projection = hc.fn_ptr, .base = hc.base_ptr, .scale = hc.scale_ptr, .output = sc.collapsed.ptr, .post = if (head) 0 else sc.post.ptr };
+    if (head) try cuda.hy4_ops.ihcHead(&rt.ops, rt.stream, shape, b) else {
+        if (try cuda.hy4_ops.tryIhcReadOnce(&rt.ops, rt.stream, shape, b, norm.bf16_ptr, sc.hidden.ptr, sc.norm_tmp.ptr, sc.norm_tmp.len, sc.ihc_count.ptr)) return;
+        if (try cuda.hy4_ops.tryIhcReadNorm(&rt.ops, rt.stream, shape, b, norm.bf16_ptr, sc.hidden.ptr, sc.norm_tmp.ptr, sc.norm_tmp.len)) return;
+        try cuda.hy4_ops.ihcRead(&rt.ops, rt.stream, shape, b);
+    }
+    try rt.runRmsNorm(sc, b.output, norm, sc.hidden.ptr, rows, t.rms_norm_eps);
+}
+
+fn ihcWriteOp(rt: *Runtime, rows: usize, t: config.Text, b: cuda.hy4_ops.IhcWrite) !void {
+    if (rows == 0) return;
+    try cuda.hy4_ops.ihcWrite(&rt.ops, rt.stream, .{ .rows = @intCast(rows), .width = t.hidden_size, .rms_eps = t.rms_norm_eps, .hc_eps = t.hc_eps, .magnitude = t.hc_magnitude }, b);
+}
+
+fn finishBranch(rt: *Runtime, sc: *Scratch, t: config.Text, rows: usize, session: ?*const boundary.TpSession, residual: u64, output: u64, capture: ?[]u8) !void {
+    const w: cuda.hy4_ops.IhcWrite = .{ .residual = residual, .branch = sc.branch.ptr, .post = sc.post.ptr, .output = output };
+    const written = if (session) |tp| blk: {
+        if (t.hidden_size == cuda.hy4_tp.hidden and try tp.boundary.tryFoldWrite(rt.stream, rows, .{
+            .partial = .{ .ptr = sc.tp_partial.ptr, .bytes = sc.tp_partial.len },
+            .gathered = .{ .ptr = sc.tp_gathered.ptr, .bytes = sc.tp_gathered.len },
+            .branch = .{ .ptr = sc.branch.ptr, .bytes = sc.branch.len },
+        }, w)) { try rt.stampPart(.tp_gather, session); break :blk true; }
+        try tpGatherFold(tp, rt, sc, t.hidden_size, rows);
+        try rt.stampPart(.tp_gather, session);
+        break :blk false;
+    } else false;
+    if (!written) { try ihcWriteOp(rt, rows, t, w); try rt.stampPart(.other_local, null); }
+    if (capture) |dst| { try rt.stream.synchronize(); try cuda.memory.download(rt.d, sc.branch.ptr, dst); }
+}
+
+fn mlaProjectAndAttend(rt: *Runtime, sc: *Scratch, t: config.Text, layer: *const weights.LayerWeights, first_pos: usize, rows: usize, lc: LayerCache, use_indices: u64, key_count: usize) !void {
+    const ls = try ranks.LocalShape.forText(t, sc.rank);
+    const cache_start: usize = if (!lc.has_prefix and first_pos > 0) first_pos else 0;
+    const eff_keys: usize = if (use_indices != 0) key_count else first_pos + rows - cache_start;
+    const shape: cuda.hy4_ops.MlaShape = .{
+        .rows = @intCast(rows), .heads = ls.heads, .capacity = @intCast(lc.capacity),
+        .key_count = @intCast(@as(usize, @max(eff_keys, @as(usize, 1)))), .first_pos = @intCast(first_pos), .latent = t.kv_lora_rank,
+        .nope = t.qk_nope_head_dim, .rope = t.qk_rope_head_dim, .value = t.v_head_dim,
+        .kv_row_stride = layer.kv_a.kvRowStride(), .theta = t.rope_parameters.rope_theta, .rms_eps = t.rms_norm_eps,
+    };
+    try cuda.hy4_ops.mlaProject(&rt.ops, rt.stream, shape, .{
+        .q = sc.q.ptr, .kv = sc.kv.ptr, .kv_norm = layer.kv_a_norm_bf16,
+        .kv_b = layer.kv_b, .absorbed_q = sc.absorbed_q.ptr, .cache = lc.kv_ptr,
+    });
+    if (sc.mrope) |*mr| try mr.vk.mropeMlaOverwrite(rt.stream, shape, .{ .q = sc.q.ptr, .kv = sc.kv.ptr, .kv_norm = layer.kv_a_norm_bf16, .kv_b = layer.kv_b, .absorbed_q = sc.absorbed_q.ptr, .cache = lc.kv_ptr }, mr.thw_ptr, mr.rope_delta);
+    try sc.ensureMlaScratch(try cuda.hy4_ops.scratchBytesFor(&rt.ops, shape));
+    try cuda.hy4_ops.mlaAttendWindow(&rt.ops, rt.stream, shape, .{
+        .absorbed_q = sc.absorbed_q.ptr, .cache = lc.kv_ptr, .kv_b = layer.kv_b,
+        .gate = sc.gate.ptr, .sinks = layer.sinks, .indices = use_indices,
+        .scratch = sc.mla_scratch.ptr, .scratch_bytes = sc.mla_scratch.len, .output = sc.gated_values.ptr,
+    }, @intCast(cache_start));
+}
+
+pub fn forwardLayer(
+    rt: *Runtime, sc: *Scratch, t: config.Text, layer: *const weights.LayerWeights, first_pos: usize, rows: usize,
+    lc: LayerCache, active_indices: ?*?[]i32, active_k: *usize, forced_full_indices: ?[]const i32, cap: ?LayerCaptureHost,
+) !void {
+    return forwardLayerTp(rt, sc, t, layer, first_pos, rows, lc, active_indices, active_k, forced_full_indices, null, cap);
+}
+
+pub fn forwardLayerTp(
+    rt: *Runtime, sc: *Scratch, t: config.Text, layer: *const weights.LayerWeights, first_pos: usize, rows: usize,
+    lc: LayerCache, active_indices: ?*?[]i32, active_k: *usize, forced_full_indices: ?[]const i32,
+    tp_sess: ?*const boundary.TpSession, cap: ?LayerCaptureHost,
+) !void {
+    const gpa = rt.gpa;
+    const total_seq = first_pos + rows;
+    if (rows == 0 or rows > sc.max_rows or total_seq > lc.capacity) return error.BadHy4PassRows;
+    const pos_guard = vision_runtime.enterRowPositionGuard(&rt.ops, if (sc.mrope) |*mr| mr else null);
+    defer pos_guard.leave(&rt.ops);
+
+    if (cap) |c| if (c.streams_in) |dst| { try rt.stream.synchronize(); try cuda.memory.download(rt.d, sc.streams_a.ptr, dst); };
+    try rt.resetPartMark();
+
+    try readNorm(rt, sc, rows, t, sc.streams_a.ptr, layer.attn_hc, layer.input_norm, false);
+    try rt.stampPart(.other_local, null);
+    if (layer.q_a == .exl3 and layer.kv_a == .exl3) {
+        try rt.runProjPair(sc, sc.hidden.ptr, layer.q_a, sc.q_raw.ptr, false, layer.kv_a, sc.kv.ptr, true, rows);
+        try rt.stampPart(.trunk, null);
+        try rt.runRmsNorm(sc, sc.q_raw.ptr, layer.q_a_norm, sc.q_resid.ptr, rows, t.rms_norm_eps);
+        try rt.stampPart(.other_local, null);
+        try rt.runProj(sc, sc.q_resid.ptr, layer.q_b, sc.q.ptr, rows, false);
+    } else {
+        try rt.runProj(sc, sc.hidden.ptr, layer.q_a, sc.q_raw.ptr, rows, false);
+        try rt.stampPart(.trunk, null);
+        try rt.runRmsNorm(sc, sc.q_raw.ptr, layer.q_a_norm, sc.q_resid.ptr, rows, t.rms_norm_eps);
+        try rt.stampPart(.other_local, null);
+        try rt.runProj(sc, sc.q_resid.ptr, layer.q_b, sc.q.ptr, rows, false);
+        try rt.runProj(sc, sc.hidden.ptr, layer.kv_a, sc.kv.ptr, rows, true);
+    }
+    try rt.runProj(sc, sc.hidden.ptr, layer.linear_gate, sc.gate.ptr, rows, false);
+    try rt.stampPart(.trunk, null);
+
+    const avail_keys = cache.availableKeys(first_pos, rows, lc.has_prefix);
+    const k_eff = cache.selectionWidth(t.index_topk, first_pos, rows, lc.has_prefix);
+    var use_indices: u64 = 0;
+    var key_count: usize = total_seq;
+
+    switch (t.indexer_types[layer.index]) {
+        .full => {
+            const ix = layer.indexer orelse return error.MissingIndexerWeights;
+            if (forced_full_indices) |forced| {
+                if (forced.len != rows * k_eff) return error.BadForcedIndices;
+                try sc.indices_buf.uploadAsync(0, std.mem.sliceAsBytes(forced), rt.stream.handle);
+                use_indices = sc.indices_buf.ptr; key_count = k_eff;
+                if (active_indices) |slot| try cache.saveActiveIndices(gpa, slot, forced);
+                try sc.active_indices_dev.copyFrom(0, sc.indices_buf.ptr, rows * k_eff * 4, rt.stream.handle);
+                sc.active_k_dev = k_eff; sc.has_active_dev = true; active_k.* = k_eff;
+                if (cap) |c| if (c.index_positions) |dst| @memcpy(dst, forced);
+            } else {
+                const idx_shape: cuda.hy4_ops.IndexShape = .{
+                    .rows = @intCast(rows), .first_pos = @intCast(first_pos), .capacity = @intCast(lc.capacity),
+                    .top_k = @intCast(k_eff), .width = t.hidden_size, .q_rank = t.q_lora_rank,
+                    .heads = t.index_n_heads, .dim = t.index_head_dim, .rope = t.qk_rope_head_dim,
+                    .x_row_stride = t.hidden_size, .q_row_stride = t.q_lora_rank,
+                    .cache_stride = t.index_head_dim, .indices_stride = @intCast(k_eff),
+                    .theta = t.rope_parameters.rope_theta, .norm_eps = t.rms_norm_eps,
+                };
+                const cache_start: u32 = if (lc.has_prefix) 0 else @intCast(first_pos);
+                const force_2k = boundary.envFlag("TF_HY4_INDEX_PAGE_2K");
+                const req_idx_sc = if (force_2k) cuda.hy4_ops.indexScratchBytes(idx_shape) else cuda.hy4_ops.indexWindowScratchBytesFor(&rt.ops, idx_shape, cache_start);
+                if (req_idx_sc) |idx_sc_bytes| {
+                    try sc.ensureAuxScratch(idx_sc_bytes);
+                    const idx_bufs: cuda.hy4_ops.IndexBuffers = .{
+                        .q_resid = sc.q_resid.ptr, .x = sc.hidden.ptr, .wq_b = ix.wq_b, .wk = ix.wk,
+                        .k_norm = ix.k_norm_weight, .k_bias = ix.k_norm_bias, .weights_proj = ix.weights_proj,
+                        .cache = lc.index_ptr, .indices = sc.indices_buf.ptr,
+                        .scratch = sc.aux_scratch.ptr, .scratch_bytes = if (force_2k) idx_sc_bytes else sc.aux_scratch.len,
+                    };
+                    if (sc.mrope) |*mr| try mr.vk.selectTokensWindowMrope(&rt.ops, rt.stream, idx_shape, idx_bufs, cache_start, mr.thw_ptr, mr.rope_delta) else try cuda.hy4_ops.selectTokensWindow(&rt.ops, rt.stream, idx_shape, idx_bufs, cache_start);
+                    use_indices = sc.indices_buf.ptr; key_count = k_eff;
+                    try sc.active_indices_dev.copyFrom(0, sc.indices_buf.ptr, rows * k_eff * 4, rt.stream.handle);
+                    sc.active_k_dev = k_eff; sc.has_active_dev = true; active_k.* = k_eff;
+                    if (active_indices != null or (cap != null and cap.?.index_positions != null)) {
+                        const host_idx = try gpa.alloc(i32, rows * k_eff); defer gpa.free(host_idx);
+                        try rt.stream.synchronize();
+                        try cuda.memory.download(rt.d, sc.indices_buf.ptr, std.mem.sliceAsBytes(host_idx));
+                        if (active_indices) |slot| try cache.saveActiveIndices(gpa, slot, host_idx);
+                        if (cap) |c| if (c.index_positions) |dst| @memcpy(dst, host_idx);
+                    }
+                } else |err| {
+                    if (err != error.Hy4KernelNotImplemented or avail_keys > t.index_topk) return err;
+                    const canon = try gpa.alloc(i32, rows * k_eff); defer gpa.free(canon);
+                    if (!lc.has_prefix and first_pos > 0) {
+                        try dump_oracle.fillCanonicalCausalIndices(canon, 0, rows, k_eff);
+                        const bias: i32 = @intCast(first_pos);
+                        for (canon) |*v| if (v.* >= 0) { v.* += bias; };
+                    } else try dump_oracle.fillCanonicalCausalIndices(canon, first_pos, rows, k_eff);
+                    try sc.indices_buf.uploadAsync(0, std.mem.sliceAsBytes(canon), rt.stream.handle);
+                    try sc.active_indices_dev.copyFrom(0, sc.indices_buf.ptr, rows * k_eff * 4, rt.stream.handle);
+                    sc.active_k_dev = k_eff; sc.has_active_dev = true; use_indices = sc.indices_buf.ptr; key_count = k_eff;
+                    if (active_indices) |slot| try cache.saveActiveIndices(gpa, slot, canon);
+                    active_k.* = k_eff;
+                    if (cap) |c| if (c.index_positions) |dst| @memcpy(dst, canon);
+                }
+            }
+        },
+        .shared => {
+            if (active_indices) |slot| {
+                const shared_idx = slot.* orelse return error.MissingSharedTopkIndices;
+                if (shared_idx.len != rows * active_k.*) return error.BadSharedTopkIndices;
+                try sc.indices_buf.uploadAsync(0, std.mem.sliceAsBytes(shared_idx), rt.stream.handle);
+                use_indices = sc.indices_buf.ptr; key_count = active_k.*;
+                if (cap) |c| if (c.index_positions) |dst| @memcpy(dst, shared_idx);
+            } else {
+                if (!sc.has_active_dev or sc.active_k_dev == 0) return error.MissingSharedTopkIndices;
+                use_indices = sc.active_indices_dev.ptr; key_count = sc.active_k_dev;
+            }
+        },
+    }
+    try rt.stampPart(.index, null);
+
+    try mlaProjectAndAttend(rt, sc, t, layer, first_pos, rows, lc, use_indices, key_count);
+    try rt.stampPart(.attn, null);
+    if (tp_sess != null) {
+        try rt.runProjRowPartialF32(sc, sc.gated_values.ptr, layer.o_proj, sc.tp_partial.ptr, rows);
+    } else {
+        try rt.runProj(sc, sc.gated_values.ptr, layer.o_proj, sc.branch.ptr, rows, false);
+    }
+    try rt.stampPart(.trunk, null);
+
+    try finishBranch(rt, sc, t, rows, tp_sess, sc.streams_a.ptr, sc.streams_b.ptr, if (cap) |c| c.attention_out else null);
+    try readNorm(rt, sc, rows, t, sc.streams_b.ptr, layer.ffn_hc, layer.post_attn_norm, false);
+    try rt.stampPart(.other_local, null);
+
+    switch (layer.mlp) {
+        .dense => |dn| {
+            if (tp_sess != null) {
+                try runDensePartialF32(rt, sc, dn, rows, sc.tp_partial.ptr);
+            } else {
+                try runDenseBranch(rt, sc, dn, rows, sc.branch.ptr);
+            }
+            try rt.stampPart(.trunk, null);
+        },
+        .sparse_bf16 => |sp| try moe_forward.runSparseBf16(rt, sc, t, sp, rows, tp_sess, cap),
+        .sparse_exl3 => |sp| try moe_forward.runSparseExl3(rt, sc, t, sp, rows, tp_sess, cap),
+    }
+
+    const capture = if (cap) |c| (if (layer.mlp == .dense) c.dense_out else c.moe_out) else null;
+    try finishBranch(rt, sc, t, rows, tp_sess, sc.streams_b.ptr, sc.streams_a.ptr, capture);
+    if (cap) |c| if (c.streams_out) |dst| { try rt.stream.synchronize(); try cuda.memory.download(rt.d, sc.streams_a.ptr, dst); };
+}
+
+pub fn forwardHeadDeviceWithRef(rt: *Runtime, sc: *Scratch, t: config.Text, head: weights.HeadWeights, streams_ptr: u64, rows: usize, ref_chunk_rows: usize) !u64 {
+    if (rows == 0 or rows * head.vocab_pad * 4 > sc.logits_f32.len) return error.BadHy4PassRows;
+    const h: usize = t.hidden_size;
+    try readNorm(rt, sc, rows, t, streams_ptr, head.hc, head.final_norm, true);
+    if (head.lm_head_exl3) |ex| {
+        try rt.runProjRowPartialF32(sc, sc.hidden.ptr, .{ .exl3 = ex }, sc.logits_f32.ptr, rows);
+        return sc.logits_f32.ptr;
+    }
+    if (head.lm_head_bf16 != 0) {
+        try cuda.hy4_ops.headBf16(&rt.ops, rt.stream, sc.hidden.ptr, head.lm_head_bf16, sc.logits_f32.ptr, rows, head.vocab_pad, h, head.vocab_pad);
+        return sc.logits_f32.ptr;
+    }
+    const head_f32 = try rt.widenBf16ToF32(sc, sc.hidden.ptr, rows, h);
+    try rt.runVocabF32(head_f32, head.lm_head_f32, sc.logits_f32.ptr, rows, head.vocab_pad, head.vocab_full, h, ref_chunk_rows);
+    return sc.logits_f32.ptr;
+}
+
+pub fn forwardHeadDevice(rt: *Runtime, sc: *Scratch, t: config.Text, head: weights.HeadWeights, streams_ptr: u64, rows: usize) !u64 {
+    return forwardHeadDeviceWithRef(rt, sc, t, head, streams_ptr, rows, 0);
+}
+
+pub fn forwardHeadTpTimed(
+    rt: *Runtime, sc: *Scratch, t: config.Text, head: weights.HeadWeights, streams_ptr: u64,
+    rows: usize, ref_chunk_rows: usize, tp_sess: ?*boundary.TpSession, logits_out: []u8,
+    io_opt: ?std.Io, gather_ns_out: ?*u64,
+) !void {
+    if (gather_ns_out) |g| g.* = 0;
+    if (logits_out.len != rows * head.vocab_full * 4) return error.BadOracleShape;
+    const ptr = try forwardHeadDeviceWithRef(rt, sc, t, head, streams_ptr, rows, ref_chunk_rows);
+    if (tp_sess) |tps| {
+        const local_f32 = try rt.gpa.alloc(f32, rows * head.vocab_pad);
+        defer rt.gpa.free(local_f32);
+        try rt.stream.synchronize();
+        try cuda.memory.download(rt.d, ptr, std.mem.sliceAsBytes(local_f32));
+        const out_f32: []f32 = @alignCast(std.mem.bytesAsSlice(f32, logits_out));
+        const gt0: u64 = if (io_opt) |io| @intCast(@max(@as(i128, 0), std.Io.Clock.awake.now(io).toNanoseconds())) else 0;
+        try tps.gatherVocabLogits(rt.gpa, rt.stream, local_f32, rows, head.vocab_pad, head.vocab_full, out_f32);
+        if (io_opt) |io| if (gather_ns_out) |g| {
+            const gt1: u64 = @intCast(@max(@as(i128, 0), std.Io.Clock.awake.now(io).toNanoseconds()));
+            g.* = gt1 -| gt0;
+        };
+        return;
+    }
+    try rt.stream.synchronize();
+    try cuda.memory.download(rt.d, ptr, logits_out);
+}
+
+pub fn forwardHeadTp(rt: *Runtime, sc: *Scratch, t: config.Text, head: weights.HeadWeights, streams_ptr: u64, rows: usize, ref_chunk_rows: usize, tp_sess: ?*boundary.TpSession, logits_out: []u8) !void {
+    return forwardHeadTpTimed(rt, sc, t, head, streams_ptr, rows, ref_chunk_rows, tp_sess, logits_out, null, null);
+}
+pub fn forwardHead(rt: *Runtime, sc: *Scratch, t: config.Text, head: weights.HeadWeights, streams_ptr: u64, rows: usize, logits_out: []u8) !void {
+    return forwardHeadTp(rt, sc, t, head, streams_ptr, rows, 0, null, logits_out);
+}
+
+pub fn embedTokens(rt: *Runtime, sc: *Scratch, embed_bf16: u64, ids: []const u32, vocab_size: u32, h: usize) !void {
+    try dump_oracle.validateTokenIds(ids, vocab_size);
+    if (h % 8 == 0) {
+        const ids_i32 = try rt.gpa.alloc(i32, ids.len);
+        defer rt.gpa.free(ids_i32);
+        for (ids, ids_i32) |tok, *dst| dst.* = @intCast(tok);
+        try sc.ids_i32.uploadAsync(0, std.mem.sliceAsBytes(ids_i32), rt.stream.handle);
+        return rt.embed.bf16Copies(rt.stream, sc.ids_i32.ptr, embed_bf16, sc.streams_a.ptr, ids.len, h, 4);
+    }
+    for (ids, 0..) |tok, r| for (0..4) |st_idx| {
+        try sc.streams_a.copyFrom((r * 4 + st_idx) * h * 2, embed_bf16 + @as(u64, tok) * h * 2, h * 2, rt.stream.handle);
+    };
+}
+
+fn tryPinColumnPlan(ref: *const cuda.cublaslt.Linear, loc: *cuda.cublaslt.Linear, ws: usize) !void { return cuda.hy4_ops.matchColumnPlan(ref, loc, ws); }
+fn makePinnedLastHeadPlan(ref: *const cuda.cublaslt.Linear, v: usize, h: usize, ws: usize) !cuda.cublaslt.Linear { return cuda.hy4_ops.lastHeadPlan(ref, @intCast(v), @intCast(h), ws); }
+pub const LastHeadFallback = enum { linear_one_row, matched_one_row };
+pub fn isColumnPlanMismatch(err: anyerror) bool { return err == error.NoMatchingHy4ColumnPlan; }
+pub fn lastHeadFallback(err: anyerror, n_loc: usize, n_full: usize) !LastHeadFallback {
+    if (!isColumnPlanMismatch(err)) return err;
+    return if (n_loc == n_full) .linear_one_row else .matched_one_row;
+}
diff --git a/zig/src/families/hy4/greedy.zig b/zig/src/families/hy4/greedy.zig
new file mode 100644
index 0000000000000000000000000000000000000000..44dacbfa3a3e454f93347d11d99d56cef3f25b1d
--- /dev/null
+++ b/zig/src/families/hy4/greedy.zig
@@ -0,0 +1,210 @@
+//! Each rank contributes one device-reduced FP32 logit and global ID per greedy row.
+const std = @import("std");
+const cuda = @import("cuda");
+const tp = @import("tp");
+
+pub const max_rows = 16;
+pub const Pair = extern struct { value: f32, id: u32 };
+pub const Top2 = extern struct { v1: f32, id1: u32, v2: f32, id2: u32 };
+pub const MarginWinner = struct { id: u32, margin: f32, v1: f32, v2: f32, id2: u32 };
+comptime {
+    if (@sizeOf(Pair) != 8 or @offsetOf(Pair, "id") != 4) @compileError("invalid greedy GPU and wire ABI");
+    if (@sizeOf(Top2) != 16 or @offsetOf(Top2, "v2") != 8) @compileError("invalid top2 GPU and wire ABI");
+}
+
+pub fn reduce(ops: *const cuda.hy4_ops.Kernels, stream: cuda.Stream, logits: u64, out: u64, rows: usize, stride: usize, valid: usize, first: usize) !void {
+    if (rows == 0 or rows > max_rows or valid > stride or logits == 0 or out == 0) return error.BadHy4VocabGather;
+    var args: cuda.Args = .{};
+    args.add(logits);
+    args.add(out);
+    args.add(@as(u32, @intCast(stride)));
+    args.add(@as(u32, @intCast(valid)));
+    args.add(@as(u32, @intCast(if (valid == 0) 0 else first)));
+    try cuda.launch.launch(ops.greedy, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 256 } }, stream, &args);
+}
+
+pub fn reduceTop2(ops: *const cuda.hy4_ops.Kernels, stream: cuda.Stream, logits: u64, out: u64, rows: usize, stride: usize, valid: usize, first: usize) !void {
+    if (rows == 0 or rows > max_rows or valid > stride or logits == 0 or out == 0) return error.BadHy4VocabGather;
+    var args: cuda.Args = .{};
+    args.add(logits);
+    args.add(out);
+    args.add(@as(u32, @intCast(stride)));
+    args.add(@as(u32, @intCast(valid)));
+    args.add(@as(u32, @intCast(if (valid == 0) 0 else first)));
+    try cuda.launch.launch(ops.greedy_top2, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 256 } }, stream, &args);
+}
+
+fn insertTop2(t: *Top2, v: f32, id: u32) void {
+    if (id == std.math.maxInt(u32)) return;
+    if (t.id1 == std.math.maxInt(u32) or v > t.v1 or (v == t.v1 and id < t.id1)) {
+        if (id != t.id1) {
+            t.v2 = t.v1;
+            t.id2 = t.id1;
+        }
+        t.v1 = v;
+        t.id1 = id;
+    } else if (id != t.id1 and (t.id2 == std.math.maxInt(u32) or v > t.v2 or (v == t.v2 and id < t.id2))) {
+        t.v2 = v;
+        t.id2 = id;
+    }
+}
+
+pub fn hostTop2(logits: []const f32) !MarginWinner {
+    if (logits.len == 0) return error.EmptyVocab;
+    var acc: Top2 = .{ .v1 = -std.math.inf(f32), .id1 = std.math.maxInt(u32), .v2 = -std.math.inf(f32), .id2 = std.math.maxInt(u32) };
+    for (logits, 0..) |v, idx| {
+        if (!std.math.isFinite(v)) return error.NonFiniteLogits;
+        insertTop2(&acc, v, @intCast(idx));
+    }
+    return .{
+        .id = acc.id1,
+        .margin = if (acc.id2 == std.math.maxInt(u32)) std.math.inf(f32) else acc.v1 - acc.v2,
+        .v1 = acc.v1,
+        .v2 = acc.v2,
+        .id2 = acc.id2,
+    };
+}
+
+pub fn selectTop2(ranks: []const []const u8, rows: usize, stride: usize, vocab: usize, out: []MarginWinner) !void {
+    if (rows == 0 or rows > max_rows or rows != out.len or vocab == 0) return error.BadHy4VocabGather;
+    const expect_bytes = rows * @sizeOf(Top2);
+    var merged: [max_rows]Top2 = @splat(.{ .v1 = -std.math.inf(f32), .id1 = std.math.maxInt(u32), .v2 = -std.math.inf(f32), .id2 = std.math.maxInt(u32) });
+    for (ranks, 0..) |rank_bytes, rk| {
+        if (rank_bytes.len != expect_bytes) return error.BadHy4VocabGather;
+        const base = rk * stride;
+        if (base >= vocab) continue;
+        const end = @min(base + stride, vocab);
+        for (std.mem.bytesAsSlice(Top2, rank_bytes), merged[0..rows]) |p, *m| {
+            if (!std.math.isFinite(p.v1)) return error.NonFiniteLogits;
+            if (p.id1 < base or p.id1 >= end) return error.BadHy4VocabGather;
+            insertTop2(m, p.v1, p.id1);
+            if (p.id2 != std.math.maxInt(u32)) {
+                if (!std.math.isFinite(p.v2)) return error.NonFiniteLogits;
+                if (p.id2 < base or p.id2 >= end or p.id2 == p.id1) return error.BadHy4VocabGather;
+                insertTop2(m, p.v2, p.id2);
+            }
+        }
+    }
+    for (merged[0..rows], out) |m, *dst| {
+        if (m.id1 == std.math.maxInt(u32)) return error.BadHy4VocabGather;
+        dst.* = .{
+            .id = m.id1,
+            .margin = if (m.id2 == std.math.maxInt(u32)) std.math.inf(f32) else m.v1 - m.v2,
+            .v1 = m.v1,
+            .v2 = m.v2,
+            .id2 = m.id2,
+        };
+    }
+}
+
+pub fn gatherTop2(bootstrap: ?*tp.Bootstrap, local: []const Top2, stride: usize, vocab: usize, out: []MarginWinner) !void {
+    if (local.len == 0 or local.len > max_rows or local.len != out.len or vocab == 0) return error.BadHy4VocabGather;
+    const bytes = std.mem.sliceAsBytes(local);
+    var storage: [cuda.hy4_tp.world * max_rows * @sizeOf(Top2)]u8 = undefined;
+    var parts: [tp.bootstrap.max_ranks][]const u8 = undefined;
+    const ranks = if (bootstrap) |b| b.allGather(bytes, &storage, &parts) catch |err| {
+        return if (err == error.Timeout) error.Hy4BootstrapTimeout else err;
+    } else &[_][]const u8{bytes};
+    try selectTop2(ranks, local.len, stride, vocab, out);
+}
+
+pub fn selectWinners(ranks: []const []const u8, rows: usize, stride: usize, vocab: usize, out: []u32) !void {
+    if (rows == 0 or rows > max_rows or rows != out.len or vocab == 0) return error.BadHy4VocabGather;
+    const expect_bytes = rows * @sizeOf(Pair);
+    var winners: [max_rows]Pair = @splat(.{ .value = -std.math.inf(f32), .id = std.math.maxInt(u32) });
+    for (ranks, 0..) |rank_bytes, rk| {
+        if (rank_bytes.len != expect_bytes) return error.BadHy4VocabGather;
+        const base = rk * stride;
+        if (base >= vocab) continue;
+        for (std.mem.bytesAsSlice(Pair, rank_bytes), winners[0..rows]) |p, *w| {
+            if (!std.math.isFinite(p.value)) return error.NonFiniteLogits;
+            if (p.id < base or p.id >= @min(base + stride, vocab)) return error.BadHy4VocabGather;
+            if (p.value > w.value or (p.value == w.value and p.id < w.id)) w.* = p;
+        }
+    }
+    for (winners[0..rows], out) |w, *dst| dst.* = w.id;
+}
+
+// CUDA, GB10 and the two supported host architectures use little-endian FP32/u32.
+pub fn gather(bootstrap: ?*tp.Bootstrap, local: []const Pair, stride: usize, vocab: usize, out: []u32) !void {
+    if (local.len == 0 or local.len > max_rows or local.len != out.len or vocab == 0) return error.BadHy4VocabGather;
+    const bytes = std.mem.sliceAsBytes(local);
+    var storage: [cuda.hy4_tp.world * max_rows * @sizeOf(Pair)]u8 = undefined;
+    var parts: [tp.bootstrap.max_ranks][]const u8 = undefined;
+    const ranks = if (bootstrap) |b| b.allGather(bytes, &storage, &parts) catch |err| {
+        return if (err == error.Timeout) error.Hy4BootstrapTimeout else err;
+    } else &[_][]const u8{bytes};
+    try selectWinners(ranks, local.len, stride, vocab, out);
+}
+
+test "batched greedy bootstrap delivers identical IDs and errors on four ranks, then recovers" {
+    const Worker = struct {
+        fn check(b: *tp.Bootstrap) !void {
+            const rk: u32 = b.rank;
+            var local: [max_rows]Pair = undefined;
+            for (&local, 0..) |*p, r| p.* = .{
+                .value = if (r % 2 == 0) 0.0 else @floatFromInt(rk),
+                .id = @intCast(3 * rk + r % 2),
+            };
+            var ids: [max_rows]u32 = undefined;
+            // The nonwinning rank faults on the last row. No result may escape from earlier rows.
+            const last = local[max_rows - 1];
+            for ([_]f32{ std.math.nan(f32), std.math.inf(f32), -std.math.inf(f32) }) |bad| {
+                if (rk == 1) local[max_rows - 1].value = bad;
+                @memset(&ids, 99);
+                try std.testing.expectError(error.NonFiniteLogits, gather(b, &local, 3, 11, &ids));
+                for (ids) |id| try std.testing.expectEqual(@as(u32, 99), id);
+            }
+            local[max_rows - 1] = last;
+            try gather(b, &local, 3, 11, &ids);
+            for (ids, 0..) |id, i| try std.testing.expectEqual(@as(u32, if (i % 2 == 0) 0 else 10), id);
+            const empty: Pair = .{ .id = std.math.maxInt(u32), .value = -std.math.inf(f32) };
+            const candidate: Pair = if (rk < 2) .{ .value = -2, .id = rk } else empty;
+            try gather(b, &.{candidate}, 1, 2, ids[0..1]);
+            try std.testing.expectEqual(@as(u32, 0), ids[0]);
+        }
+
+        fn peer(rk: u32, port: u16, err: *?anyerror) void {
+            var b = tp.Bootstrap.open(.{ .world = 4, .rank = rk, .link_port = port, .connect_timeout_ns = 5 * std.time.ns_per_s }) catch |e| {
+                err.* = e;
+                return;
+            };
+            defer b.close();
+            check(&b) catch |e| {
+                err.* = e;
+            };
+        }
+    };
+    const l = try tp.bootstrap.testListener();
+    defer tp.sock.close(l.fd);
+    var errors: [3]?anyerror = @splat(null);
+    var threads: [3]std.Thread = undefined;
+    var started: usize = 0;
+    defer for (threads[0..started]) |th| th.join();
+    for (&threads, &errors, 1..) |*th, *err, rk| {
+        th.* = try std.Thread.spawn(.{}, Worker.peer, .{ @as(u32, @intCast(rk)), l.port, err });
+        started += 1;
+    }
+    var b = try tp.Bootstrap.acceptOn(l.fd, 4, 5 * std.time.ns_per_s);
+    defer b.close();
+    try Worker.check(&b);
+    for (threads) |th| th.join();
+    started = 0;
+    for (errors) |err| if (err) |e| return e;
+
+    // Verify selectTop2 and hostTop2 handle intra-rank runner-up, cross-rank runner-up, ties, and NonFiniteLogits:
+    const hw = try hostTop2(&.{ 1.5, 4.0, 3.25, 4.0 });
+    try std.testing.expectEqual(@as(u32, 1), hw.id);
+    try std.testing.expectEqual(@as(u32, 3), hw.id2);
+    try std.testing.expectApproxEqAbs(@as(f32, 0.0), hw.margin, 1e-6);
+
+    const r0 = Top2{ .v1 = 10.5, .id1 = 1, .v2 = 10.0, .id2 = 2 };
+    const r1 = Top2{ .v1 = 9.0, .id1 = 3, .v2 = 8.0, .id2 = 4 };
+    const r2 = Top2{ .v1 = 10.25, .id1 = 7, .v2 = -std.math.inf(f32), .id2 = std.math.maxInt(u32) };
+    const r3 = Top2{ .v1 = -std.math.inf(f32), .id1 = std.math.maxInt(u32), .v2 = -std.math.inf(f32), .id2 = std.math.maxInt(u32) };
+    var mw: [1]MarginWinner = undefined;
+    try selectTop2(&.{ std.mem.asBytes(&r0), std.mem.asBytes(&r1), std.mem.asBytes(&r2), std.mem.asBytes(&r3) }, 1, 3, 8, &mw);
+    try std.testing.expectEqual(@as(u32, 1), mw[0].id);
+    try std.testing.expectEqual(@as(u32, 7), mw[0].id2);
+    try std.testing.expectApproxEqAbs(@as(f32, 0.25), mw[0].margin, 1e-6);
+}
diff --git a/zig/src/families/hy4/head_bf16.zig b/zig/src/families/hy4/head_bf16.zig
new file mode 100644
index 0000000000000000000000000000000000000000..0ea683cb04dc7299c3664e30359480de29e9d2c1
--- /dev/null
+++ b/zig/src/families/hy4/head_bf16.zig
@@ -0,0 +1,39 @@
+//! Opt-in vocabulary head read from its own BF16 rows (`TF_HY4_HEAD_BF16=1`).
+//! FP32 accumulation, one ascending-k FMA chain per logit. The FP32 copy is then
+//! not loaded. Off by default: its logits differ from the cuBLAS FP32 head.
+const std = @import("std");
+const cuda = @import("cuda");
+const boundary = @import("boundary.zig");
+const weights = @import("weights.zig");
+
+pub fn enabled() bool {
+    return boundary.envFlag("TF_HY4_HEAD_BF16");
+}
+
+/// Rank stripe [pad_rows,width] BF16, rows past `local_rows` zero.
+/// `TF_HY4_HEAD_BF16_PLANT=<i>` changes stripe word i (gate control only).
+pub fn upload(sess: *weights.ShardSession, gpa: std.mem.Allocator, up: *cuda.exl3_upload.Uploader, name: []const u8, full_shape: []const usize, local_elems: usize, pad_elems: usize, force_vocab: bool) !u64 {
+    const got = try sess.getSlice(gpa, name, force_vocab);
+    defer if (got.owned) gpa.free(got.bytes);
+    if (!got.tensor.is(.bf16, full_shape) or got.bytes.len != local_elems * 2 or pad_elems < local_elems) {
+        if (!@import("builtin").is_test) std.log.err("hy4 head bf16: {s} is stored as {t}, not bf16; unset TF_HY4_HEAD_BF16 to use the FP32 head", .{ name, got.tensor.dtype });
+        return error.UnexpectedTensor;
+    }
+    const plant = try boundary.envUint(usize, "TF_HY4_HEAD_BF16_PLANT", std.math.maxInt(usize));
+    var ptr: u64 = undefined;
+    if (pad_elems == local_elems and plant == std.math.maxInt(usize)) {
+        ptr = try up.dev(got.bytes);
+    } else {
+        const words = try gpa.alloc(u16, pad_elems);
+        defer gpa.free(words);
+        @memset(words, 0);
+        @memcpy(std.mem.sliceAsBytes(words[0..local_elems]), got.bytes);
+        if (plant < local_elems) {
+            words[plant] = if (words[plant] == 0x3e80) 0xbe80 else 0x3e80; // +0.25, or -0.25 if it already was
+            std.log.warn("hy4 head bf16 PLANTED word {d} (gate control)", .{plant});
+        }
+        ptr = try up.dev(std.mem.sliceAsBytes(words));
+    }
+    if (!got.direct_hit and got.bytes.len >= (128 << 20)) got.file.release(sess.idx.gpa);
+    return ptr;
+}
diff --git a/zig/src/families/hy4/hy4.zig b/zig/src/families/hy4/hy4.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c6b5b76f3bcc15d021bad60f2b3b9210f102442c
--- /dev/null
+++ b/zig/src/families/hy4/hy4.zig
@@ -0,0 +1,599 @@
+//! Full Hy4 (`hy_v4_vl` / `hy_v4`) CUDA family root and `tf-hy4-oracle` parity, drafter, & TP=4 CLI.
+//! Streams one layer at a time or holds resident slices on 1 or 4 ranks (`--tp 4`) and emits `compare.py` dumps.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+
+pub const config = @import("config.zig");
+pub const ranks = @import("ranks.zig");
+pub const boundary = @import("boundary.zig");
+pub const rank_picks = @import("rank_picks.zig");
+pub const weights = @import("weights.zig");
+pub const exl3_weights = @import("exl3_weights.zig");
+pub const trunk_exl3 = @import("trunk_exl3.zig");
+pub const trunk_exl3_replay = @import("trunk_exl3_replay.zig");
+pub const trunk_exl3_window = @import("trunk_exl3_window.zig");
+pub const cache = @import("cache.zig");
+pub const kv_pool = @import("kv_pool.zig");
+pub const direct_load = @import("direct_load.zig");
+pub const greedy = @import("greedy.zig");
+pub const forward = @import("forward.zig");
+pub const dump_oracle = @import("dump_oracle.zig");
+pub const draft_policy = @import("draft_policy.zig");
+pub const drafter = @import("drafter.zig");
+pub const window_bench = @import("window_bench.zig");
+pub const speculative = @import("speculative.zig");
+pub const resident = @import("resident.zig");
+pub const cuda_backend = @import("cuda_backend.zig");
+pub const cuda_native = @import("cuda_native.zig");
+pub const self_test = @import("self_test.zig");
+pub const pack_export = @import("pack_export.zig");
+pub const drafter_state_check = @import("drafter_state_check.zig");
+pub const vision_config = @import("vision_config.zig");
+pub const vision_image = @import("vision_image.zig");
+pub const vision_weights = @import("vision_weights.zig");
+pub const vision_runtime = @import("vision_runtime.zig");
+pub const native = cuda_native.native;
+pub const native_text = cuda_native.native_text;
+pub const rankDumpPath = rank_picks.rankDumpPath;
+pub const memAvailableBytes = rank_picks.memAvailableBytes;
+const checkMemFloor = rank_picks.checkMemFloor;
+const readForcedLayerIndices = rank_picks.readForcedLayerIndices;
+const parseCsvTokens = rank_picks.parseCsvTokens;
+
+pub const PromptRunOptions = struct {
+    max_layers: ?usize = null, skip_head: bool = false, forced_indices_path: ?[]const u8 = null,
+    dump_shared_indices: bool = false, verify_rank_picks: bool = false, mem_floor_gib: usize = 8, tp_sess: ?*boundary.TpSession = null,
+};
+
+pub fn runPromptToDump(gpa: std.mem.Allocator, io: std.Io, rt: *forward.Runtime, idx: *const weights.ShardIndex, prompt: dump_oracle.PromptTokens, opts: PromptRunOptions, dump: *dump_oracle.Dump) !void {
+    const t = idx.cfg.value.text_config;
+    try dump_oracle.validateTokenIds(prompt.ids, t.vocab_size);
+    const h: usize = t.hidden_size;
+    const batch = prompt.batch;
+    const seq_len = prompt.seq_len;
+    const layer_limit: usize = @min(opts.max_layers orelse @as(usize, t.num_hidden_layers), @as(usize, t.num_hidden_layers));
+    const k_eff: usize = @min(@as(usize, t.index_topk), seq_len);
+    const k_top: usize = t.num_experts_per_tok;
+    const rank_opt = if (opts.tp_sess) |tps| tps.rank else null;
+    try dump.recordInputIds(prompt.ids, batch, seq_len);
+
+    var sc = try forward.Scratch.initWith(rt.d, t, seq_len, .{
+        .logits_rows = if (opts.skip_head) 0 else seq_len, .single_layer_cache_cap = seq_len, .rank = rank_opt,
+    });
+    defer sc.deinit();
+    var pf = direct_load.DirectPrefetcher.initWithRank(gpa, io, idx, rank_opt);
+    defer pf.deinit();
+    var pick_rec: ?rank_picks.PickRecorder = if (opts.verify_rank_picks and opts.tp_sess != null) try rank_picks.PickRecorder.init(gpa, layer_limit) else null;
+    defer if (pick_rec) |*pr| pr.deinit();
+
+    const cur_streams = try gpa.alloc(u8, batch * seq_len * 4 * h * 2);
+    defer gpa.free(cur_streams);
+    {
+        try checkMemFloor(opts.mem_floor_gib);
+        if (layer_limit > 0) try pf.startLayerPrefetch(0);
+        var trunk_up: cuda.exl3_upload.Uploader = .{ .d = rt.d, .gpa = gpa, .max_buffers = 64, .slab = 64 << 20 };
+        defer trunk_up.deinit();
+        const trunk = try pf.loadTrunk(&trunk_up);
+        for (0..batch) |b| {
+            try forward.embedTokens(rt, &sc, trunk.embed_bf16, prompt.ids[b * seq_len ..][0..seq_len], t.vocab_size, h);
+            try rt.stream.synchronize();
+            try cuda.memory.download(rt.d, sc.streams_a.ptr, cur_streams[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2]);
+        }
+    }
+
+    const active_per_batch = try gpa.alloc(?[]i32, batch);
+    @memset(active_per_batch, null);
+    defer { for (active_per_batch) |slot| if (slot) |s| gpa.free(s); gpa.free(active_per_batch); }
+    const active_k_per_batch = try gpa.alloc(usize, batch);
+    defer gpa.free(active_k_per_batch);
+    @memset(active_k_per_batch, 0);
+
+    const s_in_all = try gpa.alloc(u8, batch * seq_len * 4 * h * 2); defer gpa.free(s_in_all);
+    const s_out_all = try gpa.alloc(u8, batch * seq_len * 4 * h * 2); defer gpa.free(s_out_all);
+    const attn_all = try gpa.alloc(u8, batch * seq_len * h * 2); defer gpa.free(attn_all);
+    const ffn_all = try gpa.alloc(u8, batch * seq_len * h * 2); defer gpa.free(ffn_all);
+    const idx_all = try gpa.alloc(i32, batch * seq_len * k_eff); defer gpa.free(idx_all);
+    const r_ids_all = try gpa.alloc(i32, batch * seq_len * @as(usize, @max(k_top, @as(usize, 1)))); defer gpa.free(r_ids_all);
+    const r_wts_all = try gpa.alloc(f32, batch * seq_len * @as(usize, @max(k_top, @as(usize, 1)))); defer gpa.free(r_wts_all);
+
+    var layer_up: cuda.exl3_upload.Uploader = .{ .d = rt.d, .gpa = gpa, .max_buffers = 1 << 16, .slab = 64 << 20 };
+    defer layer_up.deinit();
+    const lc: forward.LayerCache = .{ .kv_ptr = sc.kv_cache.ptr, .index_ptr = sc.index_cache.ptr, .capacity = seq_len, .has_prefix = false };
+
+    for (0..layer_limit) |l| {
+        try checkMemFloor(opts.mem_floor_gib);
+        var lw = try pf.loadLayer(&layer_up, l, if (l + 1 < layer_limit) l + 1 else null);
+        defer { lw.deinitHost(gpa); layer_up.rollback(0); }
+        try trunk_exl3.reserveLayer(&rt.short_trunk, &rt.exl3_dense, rt.stream, &rt.ops, &lw);
+
+        const is_dense = t.mlpKind(l) == .dense;
+        const is_full = t.indexer_types[l] == .full;
+        const record_idx = is_full or opts.dump_shared_indices;
+        const forced_all: ?[]i32 = if (opts.forced_indices_path != null and is_full)
+            try readForcedLayerIndices(gpa, io, opts.forced_indices_path.?, l, batch, seq_len, k_eff) else null;
+        defer if (forced_all) |f| gpa.free(f);
+
+        for (0..batch) |b| {
+            const s_slice = cur_streams[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2];
+            try sc.streams_a.uploadAsync(0, s_slice, rt.stream.handle);
+            try sc.kv_cache.fill8(0, rt.stream.handle);
+            try sc.index_cache.fill8(0, rt.stream.handle);
+            const forced_b = if (forced_all) |f| f[b * seq_len * k_eff ..][0 .. seq_len * k_eff] else null;
+            try forward.forwardLayerTp(rt, &sc, t, &lw, 0, seq_len, lc, &active_per_batch[b], &active_k_per_batch[b], forced_b, opts.tp_sess, .{
+                .streams_in = s_in_all[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2],
+                .attention_out = attn_all[b * seq_len * h * 2 ..][0 .. seq_len * h * 2],
+                .index_positions = if (record_idx) idx_all[b * seq_len * k_eff ..][0 .. seq_len * k_eff] else null,
+                .dense_out = if (is_dense) ffn_all[b * seq_len * h * 2 ..][0 .. seq_len * h * 2] else null,
+                .router_ids = if (!is_dense) r_ids_all[b * seq_len * k_top ..][0 .. seq_len * k_top] else null,
+                .router_weights = if (!is_dense) r_wts_all[b * seq_len * k_top ..][0 .. seq_len * k_top] else null,
+                .moe_out = if (!is_dense) ffn_all[b * seq_len * h * 2 ..][0 .. seq_len * h * 2] else null,
+                .streams_out = s_out_all[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2],
+            });
+            @memcpy(s_slice, s_out_all[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2]);
+        }
+
+        if (pick_rec) |*pr| pr.observeHostLayer(l, if (!is_dense) r_ids_all[0 .. batch * seq_len * k_top] else null, if (record_idx) idx_all else null);
+        try dump.recordStreams(l, false, s_in_all, batch, seq_len, 4, h);
+        try dump.recordLayerBf16(l, "attention_out", attn_all, batch, seq_len, h);
+        if (record_idx) try dump.recordIndexPositions(l, idx_all, batch, seq_len, k_eff, 0);
+        if (is_dense) try dump.recordLayerBf16(l, "dense_out", ffn_all, batch, seq_len, h) else {
+            try dump.recordRouter(l, r_ids_all[0 .. batch * seq_len * k_top], r_wts_all[0 .. batch * seq_len * k_top], batch, seq_len, k_top);
+            try dump.recordLayerBf16(l, "moe_out", ffn_all, batch, seq_len, h);
+        }
+        try dump.recordStreams(l, true, s_out_all, batch, seq_len, 4, h);
+    }
+    if (pick_rec) |*pr| try pr.verifyAcrossRanks(&opts.tp_sess.?.bootstrap);
+
+    if (!opts.skip_head) {
+        try checkMemFloor(opts.mem_floor_gib);
+        var head_up: cuda.exl3_upload.Uploader = .{ .d = rt.d, .gpa = gpa, .max_buffers = 64, .slab = 64 << 20 };
+        defer head_up.deinit();
+        const head = try pf.loadHead(&head_up);
+        if (head.lm_head_exl3) |ex| try trunk_exl3.reserveProj(&rt.short_trunk, &rt.exl3_dense, rt.stream, .{ .exl3 = ex });
+        const logits_bytes = try gpa.alloc(u8, batch * seq_len * t.vocab_size * 4);
+        defer gpa.free(logits_bytes);
+        for (0..batch) |b| {
+            try sc.streams_a.uploadAsync(0, cur_streams[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2], rt.stream.handle);
+            try forward.forwardHeadTp(rt, &sc, t, head, sc.streams_a.ptr, seq_len, 0, opts.tp_sess, logits_bytes[b * seq_len * t.vocab_size * 4 ..][0 .. seq_len * t.vocab_size * 4]);
+        }
+        try dump.recordLogits(logits_bytes, batch, seq_len, t.vocab_size);
+    }
+}
+
+pub const ReplayOptions = struct {
+    forced_indices_path: ?[]const u8 = null, with_head: bool = false, dump_shared_indices: bool = false,
+    verify_rank_picks: bool = false, mem_floor_gib: usize = 8, tp_sess: ?*boundary.TpSession = null,
+};
+
+pub fn runReplayToDump(gpa: std.mem.Allocator, io: std.Io, rt: *forward.Runtime, idx: *const weights.ShardIndex, start_layer: usize, end_layer: usize, inputs_path: []const u8, opts: ReplayOptions, dump: *dump_oracle.Dump) !void {
+    const t = idx.cfg.value.text_config;
+    if (start_layer > end_layer or end_layer >= t.num_hidden_layers) return error.BadLayerIndex;
+    const h: usize = t.hidden_size;
+    const k_top: usize = t.num_experts_per_tok;
+    const rank_opt = if (opts.tp_sess) |tps| tps.rank else null;
+
+    var replay = try dump_oracle.ReplayInputs.load(gpa, io, inputs_path, 4, h, t.max_position_embeddings, t.index_topk, t.indexer_types[start_layer] == .shared);
+    defer replay.deinit();
+    const batch = replay.batch;
+    const seq_len = replay.seq_len;
+    const cap_len = replay.max_first_pos + seq_len;
+    const k_eff = replay.topk_width;
+
+    var sc = try forward.Scratch.initWith(rt.d, t, seq_len, .{
+        .logits_rows = if (opts.with_head) seq_len else 0, .single_layer_cache_cap = cap_len, .rank = rank_opt,
+    });
+    defer sc.deinit();
+    var pf = direct_load.DirectPrefetcher.initWithRank(gpa, io, idx, rank_opt);
+    defer pf.deinit();
+
+    const cur_streams = try gpa.dupe(u8, replay.streams_bf16);
+    defer gpa.free(cur_streams);
+    const active_per_batch = try gpa.alloc(?[]i32, batch);
+    @memset(active_per_batch, null);
+    defer { for (active_per_batch) |slot| if (slot) |s| gpa.free(s); gpa.free(active_per_batch); }
+    const active_k_per_batch = try gpa.alloc(usize, batch);
+    defer gpa.free(active_k_per_batch);
+    @memset(active_k_per_batch, 0);
+    if (t.indexer_types[start_layer] == .shared) {
+        for (0..batch) |b| {
+            const bias: i32 = @intCast(replay.first_pos[b]);
+            const dup = try gpa.dupe(i32, replay.prev_topk.?[b * seq_len * k_eff ..][0 .. seq_len * k_eff]);
+            for (dup) |*v| if (v.* >= 0) { v.* += bias; };
+            active_per_batch[b] = dup;
+            active_k_per_batch[b] = k_eff;
+        }
+    }
+
+    const s_in_all = try gpa.alloc(u8, batch * seq_len * 4 * h * 2); defer gpa.free(s_in_all);
+    const s_out_all = try gpa.alloc(u8, batch * seq_len * 4 * h * 2); defer gpa.free(s_out_all);
+    const attn_all = try gpa.alloc(u8, batch * seq_len * h * 2); defer gpa.free(attn_all);
+    const ffn_all = try gpa.alloc(u8, batch * seq_len * h * 2); defer gpa.free(ffn_all);
+    const idx_all = try gpa.alloc(i32, batch * seq_len * k_eff); defer gpa.free(idx_all);
+    const r_ids_all = try gpa.alloc(i32, batch * seq_len * @as(usize, @max(k_top, @as(usize, 1)))); defer gpa.free(r_ids_all);
+    const r_wts_all = try gpa.alloc(f32, batch * seq_len * @as(usize, @max(k_top, @as(usize, 1)))); defer gpa.free(r_wts_all);
+
+    var layer_up: cuda.exl3_upload.Uploader = .{ .d = rt.d, .gpa = gpa, .max_buffers = 1 << 16, .slab = 64 << 20 };
+    defer layer_up.deinit();
+    const lc: forward.LayerCache = .{ .kv_ptr = sc.kv_cache.ptr, .index_ptr = sc.index_cache.ptr, .capacity = cap_len, .has_prefix = false };
+
+    try pf.startLayerPrefetch(start_layer);
+    for (start_layer..end_layer + 1) |l| {
+        try checkMemFloor(opts.mem_floor_gib);
+        var lw = try pf.loadLayer(&layer_up, l, if (l < end_layer) l + 1 else null);
+        defer { lw.deinitHost(gpa); layer_up.rollback(0); }
+        try trunk_exl3.reserveLayer(&rt.short_trunk, &rt.exl3_dense, rt.stream, &rt.ops, &lw);
+
+        const is_full = t.indexer_types[l] == .full;
+        const is_dense = t.mlpKind(l) == .dense;
+        const record_idx = is_full or opts.dump_shared_indices;
+        const forced_file: ?[]i32 = if (opts.forced_indices_path != null and is_full)
+            try readForcedLayerIndices(gpa, io, opts.forced_indices_path.?, l, batch, seq_len, k_eff) else null;
+        defer if (forced_file) |f| gpa.free(f);
+
+        for (0..batch) |b| {
+            const fp_b = replay.first_pos[b];
+            const bias_b: i32 = @intCast(fp_b);
+            var local_forced: ?[]i32 = null;
+            defer if (local_forced) |lf| gpa.free(lf);
+            if (forced_file) |ff| {
+                const f_b = try gpa.dupe(i32, ff[b * seq_len * k_eff ..][0 .. seq_len * k_eff]);
+                for (f_b) |*v| if (v.* >= 0) { v.* += bias_b; };
+                local_forced = f_b;
+            }
+            const s_slice = cur_streams[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2];
+            try sc.streams_a.uploadAsync(0, s_slice, rt.stream.handle);
+            try sc.kv_cache.fill8(0, rt.stream.handle);
+            try sc.index_cache.fill8(0, rt.stream.handle);
+            try forward.forwardLayerTp(rt, &sc, t, &lw, fp_b, seq_len, lc, &active_per_batch[b], &active_k_per_batch[b], local_forced, opts.tp_sess, .{
+                .streams_in = s_in_all[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2],
+                .attention_out = attn_all[b * seq_len * h * 2 ..][0 .. seq_len * h * 2],
+                .index_positions = if (record_idx) idx_all[b * seq_len * k_eff ..][0 .. seq_len * k_eff] else null,
+                .dense_out = if (is_dense) ffn_all[b * seq_len * h * 2 ..][0 .. seq_len * h * 2] else null,
+                .router_ids = if (!is_dense) r_ids_all[b * seq_len * k_top ..][0 .. seq_len * k_top] else null,
+                .router_weights = if (!is_dense) r_wts_all[b * seq_len * k_top ..][0 .. seq_len * k_top] else null,
+                .moe_out = if (!is_dense) ffn_all[b * seq_len * h * 2 ..][0 .. seq_len * h * 2] else null,
+                .streams_out = s_out_all[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2],
+            });
+            if (record_idx and bias_b > 0) for (idx_all[b * seq_len * k_eff ..][0 .. seq_len * k_eff]) |*v| if (v.* >= bias_b) { v.* -= bias_b; };
+            @memcpy(s_slice, s_out_all[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2]);
+        }
+
+        if (opts.verify_rank_picks) if (opts.tp_sess) |tps| {
+            try rank_picks.verifyLayerDigests(&tps.bootstrap, l, .{
+                .has_router = @intFromBool(!is_dense),
+                .has_index = @intFromBool(record_idx),
+                .router_sha256 = if (!is_dense) rank_picks.hashI32Slice(r_ids_all[0 .. batch * seq_len * k_top]) else @splat(0),
+                .index_sha256 = if (record_idx) rank_picks.hashI32Slice(idx_all) else @splat(0),
+            });
+        };
+        try dump.recordStreams(l, false, s_in_all, batch, seq_len, 4, h);
+        try dump.recordLayerBf16(l, "attention_out", attn_all, batch, seq_len, h);
+        if (record_idx) try dump.recordIndexPositions(l, idx_all, batch, seq_len, k_eff, 0);
+        if (is_dense) try dump.recordLayerBf16(l, "dense_out", ffn_all, batch, seq_len, h) else {
+            try dump.recordRouter(l, r_ids_all[0 .. batch * seq_len * k_top], r_wts_all[0 .. batch * seq_len * k_top], batch, seq_len, k_top);
+            try dump.recordLayerBf16(l, "moe_out", ffn_all, batch, seq_len, h);
+        }
+        try dump.recordStreams(l, true, s_out_all, batch, seq_len, 4, h);
+    }
+
+    if (opts.with_head) {
+        try checkMemFloor(opts.mem_floor_gib);
+        var head_up: cuda.exl3_upload.Uploader = .{ .d = rt.d, .gpa = gpa, .max_buffers = 64, .slab = 64 << 20 };
+        defer head_up.deinit();
+        const head = try pf.loadHead(&head_up);
+        if (head.lm_head_exl3) |ex| try trunk_exl3.reserveProj(&rt.short_trunk, &rt.exl3_dense, rt.stream, .{ .exl3 = ex });
+        const logits_bytes = try gpa.alloc(u8, batch * seq_len * t.vocab_size * 4);
+        defer gpa.free(logits_bytes);
+        for (0..batch) |b| {
+            try sc.streams_a.uploadAsync(0, cur_streams[b * seq_len * 4 * h * 2 ..][0 .. seq_len * 4 * h * 2], rt.stream.handle);
+            try forward.forwardHeadTp(rt, &sc, t, head, sc.streams_a.ptr, seq_len, 0, opts.tp_sess, logits_bytes[b * seq_len * t.vocab_size * 4 ..][0 .. seq_len * t.vocab_size * 4]);
+        }
+        try dump.recordLogits(logits_bytes, batch, seq_len, t.vocab_size);
+    }
+}
+
+fn usage() void {
+    std.debug.print(
+        \\usage:
+        \\  tf-hy4-oracle --self-test [--device 0] | --check-tp4-pack LAYER.safetensors
+        \\  tf-hy4-oracle --vision-only --model DIR --image IMG [--image IMG2 ...] --output OUT.safetensors [--vision-image-tokens 8192]
+        \\  tf-hy4-oracle --model DIR_OR_INDEX [--config CONFIG.json] [--trunk PROF] --check-load [--layer L | --max-layers K] [--skip-head] [--tp 4 | --load-rank R]
+        \\  tf-hy4-oracle --export-rank-pack SRC --out DIR [--trunk PROF] [--target-head 6b|4b|PATH] [--ranks 0,1,2,3] [--layers L,..] [--no-common] | --check-rank-pack DIR [--source SRC]
+        \\  tf-hy4-oracle --model DIR_OR_INDEX [--config CONFIG.json] [--trunk PROF] [--target-head 6b|4b|PATH] --output OUT.safetensors
+        \\    [--prompt-safetensors REF.safetensors | --tokens id0,id1,... | --tokens-u32 IDS.u32 | --synthetic-len T [--seed S]]
+        \\    [--chunk-size C] [--greedy N] [--bench-window ITERS] [--bench-widths CSV] [--bench-parts ITERS] [--cached-last-token] [--kv-capacity CAP] [--full-kv-pool]
+        \\    [--drafter [DIR]] [--drafter-exl3 PATH_OR_PROF] [--drafter-head PATH_OR_PROF] [--drafter-synthetic] [--drafter-wrong]
+        \\    [--draft-depth D | --auto-depth] [--draft-min-margin M] [--row-cost-table SPEC] [--bench-drafter ITERS]
+        \\    [--max-layers K] [--skip-head] [--forced-indices REF.safetensors] [--dump-shared-indices] [--dump-all-ranks] [--verify-rank-picks]
+        \\    [--tp 4 --rank R --master IP --master-port PORT [--tp-timeout SEC] [--load-timeout SEC] [--require-ib]]
+        \\  tf-hy4-oracle --model DIR_OR_INDEX [--config CONFIG.json] [--trunk PROF] --layer L [--end-layer E] --inputs IN.safetensors
+        \\    [--forced-indices REF.safetensors] [--with-head] [--dump-shared-indices] [--dump-all-ranks] [--verify-rank-picks] --output OUT.safetensors [--tp 4]
+        \\
+    , .{});
+}
+
+pub fn main(init: std.process.Init) !void {
+    const gpa = init.gpa;
+    const arena = init.arena.allocator();
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(arena);
+    if (try pack_export.runCli(gpa, io, args)) return;
+    if (try drafter_state_check.runCli(gpa, io, args)) return;
+    if (try vision_runtime.runVisionOnlyCli(gpa, io, args)) return;
+
+    var load_rank: ?usize = null;
+    var model_arg: ?[]const u8 = null;
+    var config_arg: ?[]const u8 = null;
+    var trunk_arg: ?[]const u8 = null;
+    var target_head_arg: ?[]const u8 = null;
