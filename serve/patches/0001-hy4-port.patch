+    var dump_all_ranks = false;
+    var verify_picks = false;
+    var tp4_slice_replay = false;
+    var check_window7 = false;
+    var self_test_flag = false;
+    var check_load = false;
+    var drafter_on = false;
+    var drafter_path: ?[]const u8 = null;
+    var drafter_exl3_arg: ?[]const u8 = null;
