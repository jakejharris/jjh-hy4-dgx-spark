+    try t.expectEqualStrings(expected_high, (try text.render(a, messages, .{ .enable_thinking = true, .reasoning_effort = "high" }, &problem)).text);
+    try t.expectEqualStrings(expected_no_think, (try text.render(a, messages, .{ .enable_thinking = false, .reasoning_effort = "no_think" }, &problem)).text);
