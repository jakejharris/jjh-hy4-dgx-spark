@@ -0,0 +1,25 @@
+//! Rank-local inputs and independent one-device references for the process contract.
+const std = @import("std");
+const t = std.testing;
+
+pub const Files = struct {
+    dir: []const u8,
+
+    fn path(self: Files, buf: []u8, rank: ?usize, name: []const u8) ![]const u8 {
+        if (rank) |r| return std.fmt.bufPrint(buf, "{s}/r{d}/{s}", .{ self.dir, r, name });
+        return std.fmt.bufPrint(buf, "{s}/ref/{s}", .{ self.dir, name });
+    }
+
+    pub fn save(self: Files, rank: ?usize, name: []const u8, data: []const u8) !void {
+        var buf: [1024]u8 = undefined;
+        try std.Io.Dir.cwd().writeFile(t.io, .{ .sub_path = try self.path(&buf, rank, name), .data = data });
+    }
+
+    pub fn read(self: Files, rank: ?usize, name: []const u8, len: usize) ![]u8 {
+        var buf: [1024]u8 = undefined;
+        const bytes = try std.Io.Dir.cwd().readFileAlloc(t.io, try self.path(&buf, rank, name), t.allocator, .limited(len + 1));
+        errdefer t.allocator.free(bytes);
+        try t.expectEqual(len, bytes.len);
+        return bytes;
+    }
+};
diff --git a/zig/kernels/cuda/contract_hy4_tp_head.zig b/zig/kernels/cuda/contract_hy4_tp_head.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b9a864b7fbcbb875f0cfeee3a3fe24b0eeaf907b
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_tp_head.zig
@@ -0,0 +1,221 @@
+//! Carry the two independently rounded residual branches through identical iHC and the full vocabulary.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = cuda.hy4_ops;
+const Rig = @import("rig").Rig;
+const bf = @import("bf16_round");
+const tp = @import("contract_hy4_tp.zig");
+const t = std.testing;
+const D = 6144;
+const M = 48;
+const N = 120832;
+
+fn upload(r: *Rig, words: anytype) !u64 {
+    return r.input(std.mem.sliceAsBytes(words));
+}
+
+fn branch(a: std.mem.Allocator, r: *Rig, k: *const ops.Kernels, full: []const f32, parts: []const f32, split: bool) !u64 {
+    if (split) {
+        const dst = try r.output(full.len * 2);
+        try ops.foldRank4(k, r.s, try upload(r, parts), dst, full.len);
+        return dst;
+    }
+    const v = try a.alloc(u16, full.len);
+    for (v, full) |*w, f| w.* = bf.bits(f);
+    return upload(r, v);
+}
+
+const Snapshot = struct { read: []u16, post: []f32, streams: []u16, head: []u16, normalized: []u16 };
+fn streamPass(a: std.mem.Allocator, r: *Rig, k: *const ops.Kernels, streams: u64, projection: u64, dense: u64, moe: u64) !Snapshot {
+    const shape: ops.IhcShape = .{ .rows = M };
+    const buf = try r.output(M * 4 * D * 2);
+    var read: ops.IhcRead = .{ .streams = streams, .projection = projection, .scale = try upload(r, &[2]f32{ 1, 1 }), .base = try upload(r, &[8]f32{ 0.1, 0.2, -0.1, -0.2, 0.2, -0.3, 0.15, 0.1 }), .post = try r.output(M * 4 * 4), .output = try r.output(M * D * 2) };
+    var snap: Snapshot = undefined;
+    for ([2]u64{ dense, moe }) |br| {
+        try ops.ihcRead(k, r.s, shape, read);
+        snap.read = try tp.download(r, a, u16, read.output, M * D);
+        snap.post = try tp.download(r, a, f32, read.post, M * 4);
+        try ops.ihcWrite(k, r.s, shape, .{ .residual = read.streams, .branch = br, .post = read.post, .output = buf });
+        read.streams = buf;
+    }
+    snap.streams = try tp.download(r, a, u16, buf, M * 4 * D);
+    try ops.ihcHead(k, r.s, shape, read);
+    snap.head = try tp.download(r, a, u16, read.output, M * D);
+    const gain: [D]u16 = @splat(bf.bits(1));
+    var norms = try cuda.norms.Norms.load(r.gpu.d);
+    defer norms.unload();
+    const norm = try r.output(M * D * 2);
+    try norms.addRmsTail(r.s, read.output, null, try upload(r, &gain), try r.output(M * D * 4), norm, null, M, D, 1e-5, .{ .round = true });
+    snap.normalized = try tp.download(r, a, u16, norm, M * D);
+    read.streams = buf + (M - 1) * 4 * D * 2;
+    try ops.ihcHead(k, r.s, .{ .rows = 1 }, read);
+    try norms.addRmsTail(r.s, read.output, null, try upload(r, &gain), try r.output(D * 4), norm, null, 1, D, 1e-5, .{ .round = true });
+    try r.s.synchronize();
+    var last: [D]u16 = undefined;
+    try cuda.memory.download(r.gpu.d, norm, std.mem.asBytes(&last));
+    try t.expectEqualSlices(u16, snap.normalized[(M - 1) * D ..], &last);
+    return snap;
+}
+
+fn wide(a: std.mem.Allocator, r: *Rig, x: []u16) !u64 {
+    const y = try a.alloc(f32, x.len);
+    for (y, x) |*v, w| v.* = bf.value(w);
+    return upload(r, y);
+}
+
+fn logits(a: std.mem.Allocator, r: *Rig, k: *const ops.Kernels, one: []u16, four: []u16) !void {
+    const ws = 32 << 20;
+    var g = try cuda.vit.Gemms.init(a, r.gpu.d);
+    defer g.deinit();
+    var full = try cuda.cublaslt.Linear.initTyped(&g.lt, M, N, D, .f32, .f32, ws, .none);
+    defer full.deinit();
+    var local = try cuda.cublaslt.Linear.initTyped(&g.lt, M, N / 4, D, .f32, .f32, ws, .none);
+    defer local.deinit();
+    try cuda.hy4_ops.matchColumnPlan(&full, &local, ws);
+    var w = try cuda.DeviceBuffer.alloc(r.gpu.d, N * D * 4);
+    defer w.free();
+    // The same weights as BF16 words (each value is an exact BF16 integer step).
+    var wb = try cuda.DeviceBuffer.alloc(r.gpu.d, N * D * 2);
+    defer wb.free();
+    const half = try a.alloc(u16, 256 * D);
+    var first: []u16 = &.{};
+    var prng = std.Random.DefaultPrng.init(20261124);
+    const chunk = try a.alloc(f32, 256 * D);
+    var bytes: [16384]u8 = undefined;
+    var lut: [256]f32 = undefined;
+    for (&lut, 0..) |*v, i| v.* = @as(f32, @floatFromInt(@as(i32, @intCast(i)) - 128)) / 32768;
+    var pos: usize = 0;
+    while (pos < N * D) {
+        const size = @min(chunk.len, N * D - pos);
+        var j: usize = 0;
+        while (j < size) {
+            const n = @min(bytes.len, size - j);
+            prng.random().bytes(bytes[0..n]);
+            for (chunk[j..][0..n], bytes[0..n]) |*v, b| v.* = lut[b];
+            j += n;
+        }
+        try w.upload(pos * 4, std.mem.sliceAsBytes(chunk[0..size]));
+        for (half[0..size], chunk[0..size]) |*h, v| h.* = bf.bits(v);
+        try wb.upload(pos * 2, std.mem.sliceAsBytes(half[0..size]));
+        if (pos == 0) first = try a.dupe(u16, half[0..size]);
+        pos += size;
+    }
+    const input = try wide(a, r, one);
+    const input4 = try wide(a, r, four);
+    const y = try r.output(M * N * 4);
+    try full.run(input, w.ptr, y, g.workspace.ptr, ws, r.s.handle);
+    const expected = try tp.download(r, a, f32, y, M * N);
+    const pred = try a.alloc(f32, M * N);
+    var worst: f32 = 0;
+    var isolated: f32 = 0;
+    for (0..4) |rank| {
+        const v = N / 4;
+        for ([2]u64{ input, input4 }, 0..) |x, i| {
+            try local.run(x, w.ptr + rank * v * D * 4, y, g.workspace.ptr, ws, r.s.handle);
+            const got = try tp.download(r, a, f32, y, M * v);
+            for (0..M) |row| {
+                const offset = row * N + rank * v;
+                const stripe = got[row * v ..][0..v];
+                if (i == 1) @memcpy(pred[offset..][0..v], stripe) else try t.expectEqualSlices(u8, std.mem.sliceAsBytes(expected[offset..][0..v]), std.mem.sliceAsBytes(stripe));
+                for (expected[offset..][0..v], stripe) |left, right| {
+                    try t.expect(std.math.isFinite(left) and std.math.isFinite(right));
+                    if (i == 0) isolated = @max(isolated, @abs(left - right)) else worst = @max(worst, @abs(left - right));
+                }
+            }
+        }
+    }
+    var last = try ops.lastHeadPlan(&local, N / 4, D, ws);
+    defer last.deinit();
+    const stripe = try a.alloc(f32, N / 4);
+    for (0..4) |rank| {
+        try last.run(input + (M - 1) * D * 4, w.ptr + rank * (N / 4) * D * 4, y, g.workspace.ptr, ws, r.s.handle);
+        try r.s.synchronize();
+        try cuda.memory.download(r.gpu.d, y, std.mem.sliceAsBytes(stripe));
+        const begin = (M - 1) * N + rank * (N / 4);
+        try t.expectEqualSlices(u8, std.mem.sliceAsBytes(expected[begin..][0 .. N / 4]), std.mem.sliceAsBytes(stripe));
+    }
+    try @import("contract_hy4_head_bf16.zig").check(a, r, k, &g.lt, g.workspace.ptr, ws, w.ptr, wb.ptr, first, one, &last);
+    var same: usize = 0;
+    var ranks: u8 = 0;
+    var cosine_loss: f64 = 0;
+    for (0..M) |row| {
+        const ref = std.mem.indexOfMax(f32, expected[row * N ..][0..N]);
+        const logits4 = pred[row * N ..][0..N];
+        var dot: f64 = 0;
+        var aa: f64 = 0;
+        var bb: f64 = 0;
+        for (expected[row * N ..][0..N], logits4) |l, rr| {
+            const left: f64 = l;
+            const right: f64 = rr;
+            dot += left * right;
+            aa += left * left;
+            bb += right * right;
+        }
+        cosine_loss = @max(cosine_loss, 1 - dot / @sqrt(aa * bb));
+        var got: usize = 0;
+        for (0..4) |rank| {
+            const begin = rank * (N / 4);
+            const id = begin + std.mem.indexOfMax(f32, logits4[begin..][0 .. N / 4]);
+            if (logits4[id] > logits4[got]) got = id;
+        }
+        try t.expectEqual(std.mem.indexOfMax(f32, logits4), got);
+        same += @intFromBool(ref == got);
+        ranks |= @as(u8, 1) << @intCast(got / (N / 4));
+    }
+    std.debug.print("TP4 head logits={d} isolated_max_abs={d:.10} propagated_max_abs={d:.10} greedy={d}/48 ranks_mask={x} worst_row_cos_loss={d:.12}\n", .{ M * N, isolated, worst, same, ranks, cosine_loss });
+    try t.expect(isolated == 0 and worst <= 0.08 and cosine_loss <= 5e-4 and same == M and ranks == 15);
+}
+
+pub fn check(r: *Rig, k: *const ops.Kernels) !void {
+    return forBoundary(r, k, null);
+}
+
+pub fn forBoundary(r: *Rig, k: *const ops.Kernels, files: ?@import("contract_hy4_tp_files.zig").Files) !void {
+    var pool = std.heap.ArenaAllocator.init(t.allocator);
+    defer pool.deinit();
+    const a = pool.allocator();
+    var prng = std.Random.DefaultPrng.init(20261123);
+    const x = try tp.weights(a, prng.random(), M * D, 0.125);
+    const dense = try @import("contract_hy4_tp_ffn.zig").forBoundary(a, r, k, x, 18432, files);
+    const shared = try @import("contract_hy4_tp_ffn.zig").forBoundary(a, r, k, x, 2048, files);
+    const routed = try @import("contract_hy4_tp_routed.zig").run(a, r, k, x);
+    const s = try upload(r, shared.parts);
+    const routed_d = try upload(r, routed.parts);
+    const n = M * D;
+    const sum = try r.output(n * 16);
+    for (0..4) |rank| try ops.addExpertPartial(k, r.s, routed_d + rank * n * 4, s + rank * n * 4, sum + rank * n * 4, n);
+    const parts = try tp.download(r, a, f32, sum, 4 * n);
+    for (parts, routed.parts, shared.parts) |got, v, w| try t.expectEqual(v + w, got);
+    const full = try a.alloc(f32, n);
+    for (full, routed.full, shared.full) |*y, v, w| y.* = v + w;
+    const proper = try tp.measure(a, r, k, .{ .full = full, .parts = parts }, "combined_moe", 0.002);
+    try ops.addExpertPartial(k, r.s, sum, s, sum, n);
+    const bad = try r.output(n * 2);
+    try ops.foldRank4(k, r.s, sum, bad, n);
+    const wrong = try tp.download(r, a, u16, bad, n);
+    var diff: usize = 0;
+    for (wrong, proper) |v, q| diff += @intFromBool(v != q);
+    std.debug.print("CONTROL TP4 duplicated rank0 shared branch changed {d}/{d} BF16 outputs\n", .{ diff, n });
+    try t.expect(diff > 0);
+    if (files) |f| {
+        for (0..4) |rank| try f.save(rank, "routed", std.mem.sliceAsBytes(routed.parts[rank * n ..][0..n]));
+        try f.save(null, "moe", std.mem.sliceAsBytes(proper));
+        try f.save(null, "moe-double-shared", std.mem.sliceAsBytes(wrong));
+        return;
+    }
+    const streams = try upload(r, try tp.weights(a, prng.random(), 4 * n, 0.03125));
+    const projection = try a.alloc(f32, 8 * 4 * D);
+    for (projection) |*v| v.* = (prng.random().float(f32) - 0.5) / 1024;
+    const proj = try upload(r, projection);
+    var ref: Snapshot = undefined;
+    var split: Snapshot = undefined;
+    for (0..5) |idx| {
+        const snap = try streamPass(a, r, k, streams, proj, try branch(a, r, k, dense.full, dense.parts, idx != 0), try branch(a, r, k, full, parts, idx != 0));
+        if (idx == 0) ref = snap else if (idx == 1) split = snap else inline for (.{ "read", "post", "streams", "head", "normalized" }) |name| {
+            try t.expectEqualSlices(u8, std.mem.sliceAsBytes(@field(split, name)), std.mem.sliceAsBytes(@field(snap, name)));
+        }
+    }
+    try t.expect(try r.intact());
+    r.reset();
+    try logits(a, r, k, ref.normalized, split.normalized);
+}
diff --git a/zig/kernels/cuda/contract_hy4_tp_inputs.zig b/zig/kernels/cuda/contract_hy4_tp_inputs.zig
new file mode 100644
index 0000000000000000000000000000000000000000..7245d1030da3e25aba829e016ab46747d2daa0ea
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_tp_inputs.zig
@@ -0,0 +1,63 @@
+//! Replicated hidden/Q normalization and exact column slices for the two attention input projections.
+const std = @import("std");
+const cuda = @import("cuda");
+const Rig = @import("rig").Rig;
+const tp = @import("contract_hy4_tp.zig");
+const bf = @import("bf16_round");
+const t = std.testing;
+
+pub fn check(r: *Rig, _: *const cuda.hy4_ops.Kernels) !void {
+    const m = 48;
+    const d = 6144;
+    const q = 2048;
+    const o = 16384;
+    var pool = std.heap.ArenaAllocator.init(t.allocator);
+    defer pool.deinit();
+    const a = pool.allocator();
+    var prng = std.Random.DefaultPrng.init(20261127);
+    const rng = prng.random();
+    const x = try r.input(std.mem.sliceAsBytes(try tp.weights(a, rng, m * d, 0.125)));
+    const qa = try r.input(std.mem.sliceAsBytes(try tp.weights(a, rng, q * d, 1.0 / 256.0)));
+    const kv = try r.input(std.mem.sliceAsBytes(try tp.weights(a, rng, 576 * d, 1.0 / 256.0)));
+    const qb = try r.input(std.mem.sliceAsBytes(try tp.weights(a, rng, o * q, 1.0 / 256.0)));
+    const gate = try r.input(std.mem.sliceAsBytes(try tp.weights(a, rng, o * d, 1.0 / 256.0)));
+    const unit: [d]u16 = @splat(bf.bits(1));
+    const gain = try r.input(std.mem.asBytes(&unit));
+    var g = try cuda.vit.Gemms.init(a, r.gpu.d);
+    defer g.deinit();
+    var norm = try cuda.norms.Norms.load(r.gpu.d);
+    defer norm.unload();
+    const ws = g.workspace.len;
+    var qfull = try cuda.cublaslt.Linear.init(&g.lt, m, o, q, .bf16, ws);
+    defer qfull.deinit();
+    var qlocal = try cuda.cublaslt.Linear.init(&g.lt, m, o / 4, q, .bf16, ws);
+    defer qlocal.deinit();
+    var gfull = try cuda.cublaslt.Linear.init(&g.lt, m, o, d, .bf16, ws);
+    defer gfull.deinit();
+    var glocal = try cuda.cublaslt.Linear.init(&g.lt, m, o / 4, d, .bf16, ws);
+    defer glocal.deinit();
+    try cuda.hy4_ops.matchColumnPlan(&qfull, &qlocal, ws);
+    try cuda.hy4_ops.matchColumnPlan(&gfull, &glocal, ws);
+    var refs: [6][]u16 = undefined;
+    const tmp = try r.scratch(m * d * 4);
+    for (0..5) |i| {
+        const rank = if (i == 0) 0 else i - 1;
+        const width: usize = if (i == 0) o else o / 4;
+        const sizes = [6]usize{ d, q, q, 576, width, width };
+        var y: [6]u64 = undefined;
+        for (&y, sizes) |*ptr, size| ptr.* = try r.output(m * size * 2);
+        try norm.addRmsTail(r.s, x, null, gain, tmp, y[0], null, m, d, 1e-5, .{ .round = true });
+        try g.run(r.s, y[0], qa, y[1], m, q, d, .bf16);
+        try norm.addRmsTail(r.s, y[1], null, gain, tmp, y[2], null, m, q, 1e-5, .{ .round = true });
+        try g.run(r.s, y[0], kv, y[3], m, 576, d, .bf16);
+        const qp = if (i == 0) &qfull else &qlocal;
+        const gp = if (i == 0) &gfull else &glocal;
+        try qp.run(y[2], qb + rank * width * q * 2, y[4], g.workspace.ptr, ws, r.s.handle);
+        try gp.run(y[0], gate + rank * width * d * 2, y[5], g.workspace.ptr, ws, r.s.handle);
+        for (y, sizes, 0..) |ptr, size, j| {
+            const words = try tp.download(r, a, u16, ptr, m * size);
+            if (i == 0) refs[j] = words else if (j < 4) try t.expectEqualSlices(u16, refs[j], words) else for (0..m) |row| try t.expectEqualSlices(u16, refs[j][row * o + rank * width ..][0..width], words[row * width ..][0..width]);
+        }
+    }
+    std.debug.print("TP4 48-row hidden/Q norms, q_a, kv_a, q_b and linear_gate match all BF16 words\n", .{});
+}
diff --git a/zig/kernels/cuda/contract_hy4_tp_mla.zig b/zig/kernels/cuda/contract_hy4_tp_mla.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c0df4cfa83ea55b305a4864c6b3c31eccd06ca02
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_tp_mla.zig
@@ -0,0 +1,234 @@
+//! Compare actual disjoint 16-head calls with the 64-head MLA and output projection.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = cuda.hy4_ops;
+const Rig = @import("rig").Rig;
+const bf = @import("bf16_round");
+const tp = @import("contract_hy4_tp.zig");
+const download = tp.download;
+const t = std.testing;
+
+const Files = @import("contract_hy4_tp_files.zig").Files;
+
+pub fn check(r: *Rig, k: *const ops.Kernels) !void {
+    try forBoundary(r, k, null);
+}
+
+pub fn forBoundary(r: *Rig, k: *const ops.Kernels, files: ?Files) !void {
+    var pool = std.heap.ArenaAllocator.init(t.allocator);
+    defer pool.deinit();
+    const a = pool.allocator();
+
+    const cap = 32770;
+    const first = 32768;
+    const rows = 2;
+    const keep = 2048;
+    var prng = std.Random.DefaultPrng.init(20261120);
+    const rnd = prng.random();
+
+    const q64 = try a.alloc(u16, rows * 64 * 256);
+    const kv = try a.alloc(u16, rows * 576);
+    const kv_b64 = try a.alloc(u16, 64 * 448 * 512);
+    const gate64 = try a.alloc(u16, rows * 64 * 256);
+    const sinks64 = try a.alloc(f32, 64);
+    var gain: [512]u16 = undefined;
+    for (q64) |*v| v.* = bf.bits((rnd.float(f32) - 0.5) * 0.5);
+    for (kv) |*v| v.* = bf.bits((rnd.float(f32) - 0.5) * 0.5);
+    for (kv_b64) |*v| v.* = bf.bits((rnd.float(f32) - 0.5) * 0.25);
+    for (gate64) |*v| v.* = bf.bits((rnd.float(f32) - 0.5) * 2.0);
+    for (sinks64) |*v| v.* = (rnd.float(f32) - 0.5) * 2.0;
+    for (&gain) |*v| v.* = bf.bits(0.9 + rnd.float(f32) * 0.2);
+
+    const cache_init = try a.alloc(u16, cap * 576);
+    @memset(cache_init, 0);
+    const indices = try a.alloc(i32, rows * keep);
+    for (0..rows) |row| {
+        for (0..keep - 4) |j| {
+            const pos = j * 15;
+            if (row == 0) {
+                for (0..576) |d| cache_init[pos * 576 + d] = bf.bits((rnd.float(f32) - 0.5) * 0.5);
+            }
+            indices[row * keep + j] = @intCast(pos);
+        }
+        indices[row * keep + keep - 4] = -1;
+        indices[row * keep + keep - 3] = first - 1;
+        indices[row * keep + keep - 2] = first;
+        indices[row * keep + keep - 1] = first + 1;
+    }
+    for (0..576) |d| cache_init[(first - 1) * 576 + d] = bf.bits((rnd.float(f32) - 0.5) * 0.5);
+
+    const full_shape: ops.MlaShape = .{ .rows = rows, .heads = 64, .capacity = cap, .first_pos = first, .key_count = keep };
+    const cache64 = try r.input(std.mem.sliceAsBytes(cache_init));
+    const aq64 = try r.output(rows * 64 * 576 * 2);
+    const kv_dev = try r.input(std.mem.sliceAsBytes(kv));
+    const gain_dev = try r.input(std.mem.asBytes(&gain));
+    const kv_b64_dev = try r.input(std.mem.sliceAsBytes(kv_b64));
+    const idx_dev = try r.input(std.mem.sliceAsBytes(indices));
+    try ops.mlaProject(k, r.s, full_shape, .{
+        .q = try r.input(std.mem.sliceAsBytes(q64)),
+        .kv = kv_dev,
+        .kv_norm = gain_dev,
+        .kv_b = kv_b64_dev,
+        .absorbed_q = aq64,
+        .cache = cache64,
+    });
+    const sc64 = try ops.scratchBytes(full_shape);
+    const out64_dev = try r.output(rows * 64 * 256 * 2);
+    const scratch64 = try r.scratch(sc64);
+    try ops.mlaAttend(k, r.s, full_shape, .{
+        .absorbed_q = aq64,
+        .cache = cache64,
+        .kv_b = kv_b64_dev,
+        .gate = try r.input(std.mem.sliceAsBytes(gate64)),
+        .sinks = try r.input(std.mem.sliceAsBytes(sinks64)),
+        .indices = idx_dev,
+        .scratch = scratch64,
+        .scratch_bytes = sc64,
+        .output = out64_dev,
+    });
+    const out64 = try download(r, a, u16, out64_dev, rows * 64 * 256);
+
+    const prob = try download(r, a, f32, scratch64, rows * 64 * keep);
+    const context = try download(r, a, f32, scratch64 + rows * 64 * keep * 4, rows * 64 * 512);
+    const aq = try download(r, a, u16, aq64, rows * 64 * 576);
+    const tail = try download(r, a, u16, cache64 + first * 576 * 2, rows * 576);
+    var gemm = try cuda.vit.Gemms.init(a, r.gpu.d);
+    defer gemm.deinit();
+    const hidden = 6144;
+    const ow = try tp.weights(a, rnd, 64 * 256 * hidden, 0.001953125);
+    const o = try r.output(rows * hidden * 4);
+    try gemm.run(r.s, out64_dev, try r.input(std.mem.sliceAsBytes(ow)), o, rows, hidden, 64 * 256, .f32);
+    const p: tp.Planes = .{ .full = try download(r, a, f32, o, rows * hidden), .parts = try a.alloc(f32, 4 * rows * hidden) };
+    var tp4_diffs: usize = 0;
+    const rank_shape: ops.MlaShape = .{ .rows = rows, .heads = 16, .capacity = cap, .first_pos = first, .key_count = keep };
+    const sc16 = try ops.scratchBytes(rank_shape);
+    const scratch16 = try r.scratch(sc16);
+    for (0..4) |rank| {
+        const q16 = try a.alloc(u16, rows * 16 * 256);
+        const gate16 = try a.alloc(u16, rows * 16 * 256);
+        for (0..rows) |row| {
+            @memcpy(q16[row * 16 * 256 ..][0 .. 16 * 256], q64[(row * 64 + rank * 16) * 256 ..][0 .. 16 * 256]);
+            @memcpy(gate16[row * 16 * 256 ..][0 .. 16 * 256], gate64[(row * 64 + rank * 16) * 256 ..][0 .. 16 * 256]);
+        }
+        const kv_b16_dev = kv_b64_dev + rank * 16 * 448 * 512 * 2;
+        const cache16 = try r.input(std.mem.sliceAsBytes(cache_init));
+        const aq16 = try r.output(rows * 16 * 576 * 2);
+        const out16_dev = try r.output(rows * 16 * 256 * 2);
+        try ops.mlaProject(k, r.s, rank_shape, .{
+            .q = try r.input(std.mem.sliceAsBytes(q16)),
+            .kv = kv_dev,
+            .kv_norm = gain_dev,
+            .kv_b = kv_b16_dev,
+            .absorbed_q = aq16,
+            .cache = cache16,
+        });
+        var attend: ops.MlaAttend = .{
+            .absorbed_q = aq16,
+            .cache = cache16,
+            .kv_b = kv_b16_dev,
+            .gate = try r.input(std.mem.sliceAsBytes(gate16)),
+            .sinks = try r.input(std.mem.sliceAsBytes(sinks64[rank * 16 ..][0..16])),
+            .indices = idx_dev,
+            .scratch = scratch16,
+            .scratch_bytes = sc16,
+            .output = out16_dev,
+        };
+        try ops.mlaAttend(k, r.s, rank_shape, attend);
+        const prob16 = try download(r, a, f32, scratch16, rows * 16 * keep);
+        const ctx16 = try download(r, a, f32, scratch16 + rows * 16 * keep * 4, rows * 16 * 512);
+        for (0..rows) |row| {
+            try t.expectEqualSlices(u8, std.mem.sliceAsBytes(prob[(row * 64 + rank * 16) * keep ..][0 .. 16 * keep]), std.mem.sliceAsBytes(prob16[row * 16 * keep ..][0 .. 16 * keep]));
+            try t.expectEqualSlices(u8, std.mem.sliceAsBytes(context[(row * 64 + rank * 16) * 512 ..][0 .. 16 * 512]), std.mem.sliceAsBytes(ctx16[row * 16 * 512 ..][0 .. 16 * 512]));
+        }
+        const qa = try download(r, a, u16, aq16, rows * 16 * 576);
+        for (0..rows) |row| try t.expectEqualSlices(u16, aq[(row * 64 + rank * 16) * 576 ..][0 .. 16 * 576], qa[row * 16 * 576 ..][0 .. 16 * 576]);
+        try t.expectEqualSlices(u16, tail, try download(r, a, u16, cache16 + first * 576 * 2, rows * 576));
+        const wlocal = try tp.columns(a, ow, 64 * 256, rank);
+        try gemm.run(r.s, out16_dev, try r.input(std.mem.sliceAsBytes(wlocal)), o, rows, hidden, 16 * 256, .f32);
+        @memcpy(p.parts[rank * rows * hidden ..][0 .. rows * hidden], try download(r, a, f32, o, rows * hidden));
+        const out16 = try download(r, a, u16, out16_dev, rows * 16 * 256);
+        if (files) |f| {
+            if (rank == 0) {
+                try f.save(null, "indices", std.mem.sliceAsBytes(indices));
+                try f.save(null, "cache", try r.bytes(cache16, cap * 576 * 2));
+            }
+            try f.save(rank, "aq", std.mem.sliceAsBytes(qa));
+            try f.save(rank, "kv-b", std.mem.sliceAsBytes(kv_b64[rank * 16 * 448 * 512 ..][0 .. 16 * 448 * 512]));
+            try f.save(rank, "gate", std.mem.sliceAsBytes(gate16));
+            try f.save(rank, "sinks", std.mem.sliceAsBytes(sinks64[rank * 16 ..][0..16]));
+            try f.save(rank, "attn-input", std.mem.sliceAsBytes(out16));
+            try f.save(rank, "attn-weight", std.mem.sliceAsBytes(wlocal));
+        }
+        for (0..rows) |row| {
+            for (0..16 * 256) |i| {
+                tp4_diffs += @intFromBool(out16[row * 16 * 256 + i] != out64[(row * 64 + rank * 16) * 256 + i]);
+            }
+        }
+        if (rank == 0) {
+            var bad: [16]f32 = undefined;
+            for (&bad, sinks64[0..16]) |*v, x| v.* = x + @log(@as(f32, 2));
+            attend.sinks = try r.input(std.mem.asBytes(&bad));
+            try ops.mlaAttend(k, r.s, rank_shape, attend);
+            const wrong = try download(r, a, u16, out16_dev, out16.len);
+            if (files) |f| try f.save(rank, "attn-double-sink", std.mem.sliceAsBytes(wrong));
+            var missed: usize = 0;
+            for (wrong, out16) |v, w| missed += @intFromBool(v != w);
+            std.debug.print("CONTROL TP4 duplicated rank0 sink changed {d}/{d} BF16 values\n", .{ missed, out16.len });
+            try t.expect(missed != 0);
+        }
+    }
+    try t.expectEqual(@as(usize, 0), tp4_diffs);
+    const reference = try tp.measure(a, r, k, p, "attention", 0.001);
+    if (files) |f| try f.save(null, "attention", std.mem.sliceAsBytes(reference));
+}
+
+// Check the checkpoint prefill geometry against independent, original one-row
+// launches with a partial key tile, causal and cold masks, and padded views.
+pub fn prefillTile(r: *Rig, k: *const ops.Kernels) !void {
+    var pool = std.heap.ArenaAllocator.init(t.allocator);
+    defer pool.deinit();
+    const a = pool.allocator();
+    var rng = std.Random.DefaultPrng.init(20261130);
+    const n = 4;
+    const h = 16;
+    const keys = 37;
+    const cap = 404;
+    const first = cap - n;
+    const out_stride = h * 257 + 3;
+    const shape: ops.MlaShape = .{ .rows = n, .heads = h, .key_count = keys, .capacity = cap, .first_pos = first, .cache_stride = 581, .value_head_stride = 257, .value_row_stride = out_stride };
+    const indices = try a.alloc(i32, n * keys);
+    for (indices, 0..) |*pos, i| pos.* = switch (i % keys) {
+        0 => -1,
+        1 => 5,
+        2 => first + 2,
+        else => @intCast(16 + (i * 59) % (first - 16)),
+    };
+    const sizes = [_]usize{ n * h * 576, cap * 581, h * 448 * 512, n * out_stride };
+    var tensors: [sizes.len]u64 = undefined;
+    for (sizes, &tensors) |size, *ptr| {
+        const host = try a.alloc(u16, size);
+        for (host) |*v| v.* = bf.bits(rng.random().float(f32) * 2 - 1);
+        ptr.* = try r.input(std.mem.sliceAsBytes(host));
+    }
+    const bytes = try ops.scratchBytes(shape);
+    const sinks: [h]f32 = @splat(0.3);
+    var b: ops.MlaAttend = .{ .absorbed_q = tensors[0], .cache = tensors[1], .kv_b = tensors[2], .gate = tensors[3], .sinks = try r.input(std.mem.asBytes(&sinks)), .indices = try r.input(std.mem.sliceAsBytes(indices)), .scratch = try r.scratch(bytes), .scratch_bytes = bytes, .output = try r.output(n * out_stride * 2) };
+    try ops.mlaAttendWindow(k, r.s, shape, b, 16);
+    const all = try a.dupe(u8, try r.bytes(b.output, n * out_stride * 2));
+    const scratch = try a.dupe(u8, try r.bytes(b.scratch, bytes));
+    var one = shape;
+    one.rows = 1;
+    b.output = try r.output(out_stride * 2);
+    for (0..n) |row| {
+        try ops.mlaAttendWindow(k, r.s, one, b, 16);
+        try t.expectEqualSlices(u8, all[row * out_stride * 2 ..][0 .. out_stride * 2], try r.bytes(b.output, out_stride * 2));
+        const pn = h * keys * 4;
+        const cn = h * 512 * 4;
+        try t.expectEqualSlices(u8, scratch[row * pn ..][0..pn], try r.bytes(b.scratch, pn));
+        try t.expectEqualSlices(u8, scratch[n * pn + row * cn ..][0..cn], try r.bytes(b.scratch + pn, cn));
+        b.absorbed_q += h * 576 * 2;
+        b.indices += keys * 4;
+        b.gate += out_stride * 2;
+        one.first_pos += 1;
+    }
+}
diff --git a/zig/kernels/cuda/contract_hy4_tp_pack.zig b/zig/kernels/cuda/contract_hy4_tp_pack.zig
new file mode 100644
index 0000000000000000000000000000000000000000..fce0a0f6e17da18bf3eb001741deaaf82d4e5d35
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_tp_pack.zig
@@ -0,0 +1,78 @@
+//! Read-only round trip of each real tensor through the four loader slices.
+const std = @import("std");
+const core = @import("core");
+const tp = @import("cuda").hy4_tp;
+const layout = core.exl3_layout;
+const t = std.testing;
+const Span = layout.Span;
+
+fn span(file: *const core.safetensors.File, name: []const u8, e: core.safetensors.Entry, rank: tp.Rank) !Span {
+    const bytes = e.end - e.begin;
+    const whole: Span = .{ .offset = 0, .len = bytes };
+    if (std.mem.indexOf(u8, name, ".experts.") != null) {
+        const dot = std.mem.lastIndexOfScalar(u8, name, '.').?;
+        const suffix = name[dot + 1 ..];
+        if (std.mem.eql(u8, suffix, "mul1")) return whole;
+        var buf: [192]u8 = undefined;
+        const key = try std.fmt.bufPrint(&buf, "{s}.trellis", .{name[0..dot]});
+        const trellis = file.names.get(key) orelse return error.MissingTrellis;
+        const group = try layout.Group.fromShape(trellis.shape[0..trellis.rank]);
+        const projection: tp.Projection = if (std.mem.endsWith(u8, name[0..dot], "down_proj")) .down else if (std.mem.endsWith(u8, name[0..dot], "gate_proj")) .gate else .up;
+        const part = try rank.expertPart(layout, group, projection);
+        inline for (.{ "trellis", "suh", "svh" }) |field| if (std.mem.eql(u8, suffix, field)) return @field(part, field);
+        return error.UnknownExpertField;
+    }
+    const shared = std.mem.indexOf(u8, name, ".shared_experts.") != null;
+    const s = rank.stripe(if (shared) .shared else .heads);
+    const row_split = std.mem.endsWith(u8, name, "o_proj.weight") or (shared and std.mem.endsWith(u8, name, "down_proj.weight"));
+    const heads = std.mem.endsWith(u8, name, "learnable_sink_param") or std.mem.endsWith(u8, name, "kv_b_proj.weight") or std.mem.endsWith(u8, name, "q_b_proj.weight") and std.mem.indexOf(u8, name, ".indexer.") == null or std.mem.endsWith(u8, name, "linear_gate.weight");
+    if (!row_split and !shared and !heads) return whole;
+    const count = if (row_split) e.shape[0] else 1;
+    const stride = bytes / count;
+    const unit = stride / (s.count * tp.world);
+    return .{ .offset = s.first * unit, .len = s.count * unit, .stride = stride, .count = count };
+}
+
+fn roundTrip(file: *const core.safetensors.File, key: []const u8, e: core.safetensors.Entry) !bool {
+    const src = file.map.memory[file.data + e.begin .. file.data + e.end];
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var parts: [4][]u8 = undefined;
+    var spans: [4]Span = undefined;
+    for (&parts, &spans, 0..) |*piece, *s, i| {
+        s.* = try span(file, key, e, try tp.Rank.init(i, 4));
+        piece.* = try a.alloc(u8, s.bytes());
+        for (0..s.count) |j| @memcpy(piece.*[j * s.len ..][0..s.len], src[s.at(j)..][0..s.len]);
+    }
+    if (parts[0].len == src.len) {
+        for (parts) |piece| try t.expect(std.mem.eql(u8, src, piece));
+        return false;
+    }
+    var pos: usize = 0;
+    for (0..spans[0].count) |j| for (parts, spans) |piece, s| {
+        const stripe = piece[j * s.len ..][0..s.len];
+        try t.expect(std.mem.eql(u8, src[pos..][0..stripe.len], stripe));
+        pos += stripe.len;
+    };
+    try t.expectEqual(src.len, pos);
+    return true;
+}
+
+test "Hy4 four rank farm layer reassembles every stored byte" {
+    const path = @import("tp_pack_options").path orelse return error.SkipZigTest;
+    var file = try core.safetensors.File.open(t.allocator, t.io, path);
+    defer file.close(t.io);
+    var split: usize = 0;
+    var at = file.data;
+    var h = std.crypto.hash.sha2.Sha256.init(.{});
+    h.update(file.map.memory[0..at]);
+    for (file.names.keys(), file.names.values()) |key, e| {
+        if (try roundTrip(&file, key, e)) split += 1;
+        try t.expectEqual(at, file.data + e.begin);
+        h.update(file.map.memory[at .. file.data + e.end]);
+        at = file.data + e.end;
+    }
+    try t.expectEqual(file.map.memory.len, at);
+    std.debug.print("PACK tensors={d} split={d} replicated={d} bytes={d} sha256={x}\n", .{ file.names.count(), split, file.names.count() - split, at, h.finalResult() });
+}
diff --git a/zig/kernels/cuda/contract_hy4_tp_routed.zig b/zig/kernels/cuda/contract_hy4_tp_routed.zig
new file mode 100644
index 0000000000000000000000000000000000000000..3768ecd26299c282b2f8460e49b8444cda7de446
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_tp_routed.zig
@@ -0,0 +1,144 @@
+//! Real 6144x2048, top-eight EXL3 with distinct random trellises for every selected expert.
+const std = @import("std");
+const cuda = @import("cuda");
+const layout = @import("core").exl3_layout;
+const ops = cuda.hy4_ops;
+const Rig = @import("rig").Rig;
+const tp = @import("contract_hy4_tp.zig");
+const t = std.testing;
+
+const Rebuilt = struct { words: [8][]u8, suh: []u8, svh: []u8 };
+
+const Projection = struct {
+    group: layout.Group,
+    words: [8][]u8,
+    suh: []f16,
+    svh: []f16,
+
+    fn init(a: std.mem.Allocator, rng: std.Random, down: bool, k2: u32) !Projection {
+        const group: layout.Group = .{ .k_tiles = if (down) 128 else 384, .n_tiles = if (down) 384 else 128, .words = k2 * 8 };
+        var p: Projection = .{ .group = group, .words = undefined, .suh = try a.alloc(f16, group.k()), .svh = try a.alloc(f16, group.n()) };
+        for (&p.words) |*w| {
+            w.* = try a.alloc(u8, group.trellisBytes());
+            rng.bytes(w.*);
+        }
+        for (p.suh, 0..) |*v, i| v.* = if (i % 7 == 0) -0.125 else 0.125;
+        for (p.svh, 0..) |*v, i| v.* = if (i % 5 == 0) -0.125 else 0.125;
+        return p;
+    }
+
+    fn slice(p: Projection, a: std.mem.Allocator, r: *Rig, split: layout.Split, rank: u32, world: u32, rebuilt: ?*Rebuilt) ![4]u64 {
+        const part = try p.group.part(split, rank, world);
+        var ptrs: [256]u64 = undefined;
+        for (p.words, 0..) |w, j| {
+            const local = try a.alloc(u8, part.trellis.bytes());
+            defer a.free(local);
+            for (0..part.trellis.count) |i| {
+                const original = part.trellis.at(i);
+                const stripe = local[i * part.trellis.len ..][0..part.trellis.len];
+                @memcpy(stripe, w[original..][0..stripe.len]);
+                if (rebuilt) |re| @memcpy(re.words[j][original..][0..stripe.len], stripe);
+            }
+            ptrs[j] = try r.input(local);
+        }
+        for (8..256) |i| ptrs[i] = ptrs[i % 8];
+        const bits: [256]i32 = @splat(@intCast(p.group.k2()));
+        var out = [4]u64{ try r.input(std.mem.asBytes(&ptrs)), try r.input(std.mem.asBytes(&bits)), 0, 0 };
+        for ([2][]f16{ p.suh, p.svh }, [_]layout.Span{ part.suh, part.svh }, 2..) |scale, span, j| {
+            const row = std.mem.sliceAsBytes(scale)[span.offset..][0..span.len];
+            if (rebuilt) |re| {
+                const dest = if (j == 2) re.suh else re.svh;
+                @memcpy(dest[span.offset..][0..row.len], row);
+            }
+            const scales = try a.alloc(u8, 256 * row.len);
+            defer a.free(scales);
+            for (0..256) |e| @memcpy(scales[e * row.len ..][0..row.len], row);
+            out[j] = try r.input(scales);
+        }
+        return out;
+    }
+};
+
+const Inputs = struct {
+    proj: [3]Projection,
+    router: []u16,
+    fn init(a: std.mem.Allocator) !Inputs {
+        var prng = std.Random.DefaultPrng.init(20261122);
+        const rng = prng.random();
+        const proj = [3]Projection{ try Projection.init(a, rng, false, 6), try Projection.init(a, rng, false, 6), try Projection.init(a, rng, true, 8) };
+        return .{ .proj = proj, .router = try tp.weights(a, rng, 256 * 6144, 1.0 / 512.0) };
+    }
+    fn partial(self: Inputs, a: std.mem.Allocator, r: *Rig, k: *const ops.Kernels, x: []const u16, rank: u32, world: u32, rebuilt: ?*[3]Rebuilt) !ops.RoutedBuffers {
+        var bias: [256]f32 = undefined;
+        for (&bias, 0..) |*v, e| v.* = if (e >= 248) 4 else 0;
+        const shape: ops.RoutedShape = .{ .rows = @intCast(x.len / 6144), .x_row_stride = 6144, .output_row_stride = 6144 };
+        var layer: cuda.exl3_experts.Layer = .{ .dims = 6144, .width = 2048 / world, .limit = 10, .experts = 256, .codebook = .mul1, .gate = 0, .gate_k2 = 0, .up = 0, .up_k2 = 0, .down = 0, .down_k2 = 0, .suh_g = 0, .suh_u = 0, .suh_d = 0, .svh_g = 0, .svh_u = 0, .svh_d = 0 };
+        inline for (.{ "gate", "up", "down" }, .{ "g", "u", "d" }, 0..) |name, suffix, j| {
+            const v = try self.proj[j].slice(a, r, if (j == 2) .row else .col, rank, world, if (rebuilt) |all| &all[j] else null);
+            @field(layer, name) = v[0];
+            @field(layer, name ++ "_k2") = v[1];
+            @field(layer, "suh_" ++ suffix) = v[2];
+            @field(layer, "svh_" ++ suffix) = v[3];
+        }
+        const b = try @import("contract_hy4_routed.zig").allocBuffers(r, shape, layer, x, self.router, &bias);
+        try ops.routedExperts(k, r.s, shape, b);
+        return b;
+    }
+};
+
+pub fn rankPartial(r: *Rig, k: *const ops.Kernels, rank: cuda.hy4_tp.Rank) !u64 {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var rng = std.Random.DefaultPrng.init(20261123);
+    const x = try tp.weights(a, rng.random(), 48 * 6144, 0.125);
+    const fixture = try Inputs.init(a);
+    return (try fixture.partial(a, r, k, x, @backingInt(rank), 4, null)).output;
+}
+
+pub fn run(a: std.mem.Allocator, r: *Rig, k: *const ops.Kernels, x: []const u16) !tp.Planes {
+    const rows = x.len / 6144;
+    const fixture = try Inputs.init(a);
+    const proj = fixture.proj;
+    var rebuilt: [3]Rebuilt = undefined;
+    for (&rebuilt, proj) |*re, p| {
+        for (&re.words) |*s| {
+            s.* = try a.alloc(u8, p.group.trellisBytes());
+            @memset(s.*, 0);
+        }
+        re.suh = try a.alloc(u8, p.suh.len * 2);
+        @memset(re.suh, 0);
+        re.svh = try a.alloc(u8, p.svh.len * 2);
+        @memset(re.svh, 0);
+    }
+    var ids: []i32 = undefined;
+    var weights: []f32 = undefined;
+    var p: tp.Planes = .{ .full = undefined, .parts = try a.alloc(f32, 4 * x.len) };
+    for (0..5) |i| {
+        const rank: u32 = if (i == 0) 0 else @intCast(i - 1);
+        const world: u32 = if (i == 0) 1 else 4;
+        const b = try fixture.partial(a, r, k, x, rank, world, if (world == 4) &rebuilt else null);
+        const picks = try tp.download(r, a, i32, b.ids, rows * 8);
+        const ws = try tp.download(r, a, f32, b.weights, rows * 8);
+        const y = try tp.download(r, a, f32, b.output, x.len);
+        if (i == 0) {
+            ids = picks;
+            weights = ws;
+            p.full = y;
+            for (ids) |id| try t.expect(id >= 248 and id < 256);
+        } else {
+            try t.expectEqualSlices(i32, ids, picks);
+            try t.expectEqualSlices(f32, weights, ws);
+            @memcpy(p.parts[rank * x.len ..][0..x.len], y);
+        }
+        try t.expect(try r.intact());
+        r.reset();
+    }
+    for (proj, rebuilt) |proj_i, re| {
+        for (proj_i.words, re.words) |src, out| try t.expectEqualSlices(u8, src, out);
+        try t.expectEqualSlices(u8, std.mem.sliceAsBytes(proj_i.suh), re.suh);
+        try t.expectEqualSlices(u8, std.mem.sliceAsBytes(proj_i.svh), re.svh);
+    }
+    _ = try tp.measure(a, r, k, p, "routed", 0.001);
+    return p;
+}
