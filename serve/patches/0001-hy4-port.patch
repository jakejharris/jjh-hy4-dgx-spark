+    try std.testing.expect(p_r11.expected_tokens / p_r11.expected_ms > 1.0 / r11_78l.roundMs(0));
+    try std.testing.expect(p_r11.expected_tokens / p_r11.expected_ms > 2.159 / r11_78l.roundMs(6));
+
+    const code_rates = [_]f64{ 0.92, 0.88, 0.84, 0.78, 0.72, 0.65 };
