+const env = @import("sys").environment;
+
+pub const PrefillAr = enum { off, bf16, fp32 };
+
+pub fn parsePrefillAr(fast_prefill: bool, raw: ?[]const u8) env.Error!PrefillAr {
+    const default: u8 = @intFromEnum(if (fast_prefill) PrefillAr.fp32 else PrefillAr.off);
+    return @enumFromInt(try env.value(u8, "TF_HY4_PREFILL_AR", raw, default));
+}
+
+pub const PrefillSwitches = struct {
+    fast_prefill: bool = false,
+    fast_routed: bool = false,
+    fast_mla: bool = false,
+    fast_indexer: bool = false,
+    prefill_ar: PrefillAr = .off,
+    min_prefill_rows: u32 = 256,
+
+    pub fn fromEnv(source: anytype) env.Error!PrefillSwitches {
+        const fast = try env.value(bool, "TF_HY4_FAST_PREFILL", source.get("TF_HY4_FAST_PREFILL"), false);
+        const routed = try env.value(bool, "TF_HY4_FAST_ROUTED", source.get("TF_HY4_FAST_ROUTED"), true);
+        const mla = try env.value(bool, "TF_HY4_FAST_MLA", source.get("TF_HY4_FAST_MLA"), true);
+        const indexer = try env.value(bool, "TF_HY4_FAST_INDEXER", source.get("TF_HY4_FAST_INDEXER"), true);
+        return .{
+            .fast_prefill = fast,
+            .fast_routed = fast and routed,
+            .fast_mla = fast and mla,
+            .fast_indexer = fast and indexer,
+            .prefill_ar = try parsePrefillAr(fast, source.get("TF_HY4_PREFILL_AR")),
+            .min_prefill_rows = try env.value(u32, "TF_HY4_FAST_PREFILL_MIN_ROWS", source.get("TF_HY4_FAST_PREFILL_MIN_ROWS"), 256),
+        };
+    }
+
+    pub fn fromProcess() env.Error!PrefillSwitches {
+        return fromEnv(env.Process{});
+    }
+};
