new file mode 100644
index 0000000000000000000000000000000000000000..de30a3a1e21ed3358949ac5b1f6b3c6212ce9bff
--- /dev/null
+++ b/zig/kernels/cuda/contract_hy4_trunk.zig
@@ -0,0 +1,87 @@
+//! Compare the GB10 short trunk with the existing EXL3 linear and grouped paths.
+const std = @import("std");
+const cuda = @import("cuda");
+const ex = cuda.exl3;
+const Rig = @import("rig").Rig;
+const t = std.testing;
+
+fn weight(a: std.mem.Allocator, r: *Rig, rng: std.Random, k: u32, n: u32, sk: u32, wk: u32, strips: bool) !ex.Weight {
+    const data = try a.alloc(u32, @as(usize, k) * n / 8);
+    rng.bytes(std.mem.sliceAsBytes(data));
+    const scales = try a.alloc(f16, k + 2 * n);
+    for (scales) |*v| v.* = @floatCast(0.3 + rng.float(f32) * 0.7);
+    const s = try r.input(std.mem.sliceAsBytes(scales));
+    const strides = ex.strides(k, n, 8, strips);
+    return .{ .trellis = try r.input(std.mem.sliceAsBytes(data)), .suh = s, .svh = s + 2 * k,
+        .bias = s + 2 * (k + n), .k = k, .n = n, .halves = 8, .codebook = .mul1,
+        .sk = sk, .wk = wk, .stride_k = strides.k, .stride_nb = strides.nb };
+}
+
+fn equal(r: *Rig, old: u64, new: u64, count: usize) !void {
+    const reference = try t.allocator.dupe(u8, try r.bytes(old, count));
+    defer t.allocator.free(reference);
+    try t.expectEqualSlices(u8, reference, try r.bytes(new, count));
+}
+
+pub fn check(r: *Rig, _: *const cuda.hy4_ops.Kernels) !void {
+    var short = try cuda.hy4_ops.ShortTrunk.load(r.s.d);
+    defer short.deinit();
+    if (!short.enabled) return error.SkipZigTest;
+    var dense = try ex.Dense.load(r.s.d);
+    defer dense.unload();
+    var activation = try cuda.act_rows.ActRows.load(r.s.d);
+    defer activation.unload();
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var rng = std.Random.DefaultPrng.init(20261120);
+    const x = try r.input(std.mem.sliceAsBytes(try @import("contract_hy4_tp.zig").weights(a, rng.random(), 8 * 6144, 0.125)));
+    const gu = [2]ex.Weight{ try weight(a, r, rng.random(), 6144, 512, 8, 4, true), try weight(a, r, rng.random(), 6144, 512, 8, 4, false) };
+    const down = try weight(a, r, rng.random(), 512, 6144, 1, 4, true);
+    const other = try weight(a, r, rng.random(), 1024, 256, 2, 8, false);
+    const pair = [2]u64{ try r.output(8 * 512 * 2), try r.output(8 * 512 * 2) };
+    const actual = [2]u64{ try r.output(8 * 512 * 2), try r.output(8 * 512 * 2) };
+    const h = try r.output(8 * 512 * 2);
+    const old = try r.output(8 * 6144 * 4);
+    const new = try r.output(8 * 6144 * 4);
+    for (1..9) |rows| {
+        try dense.decode(r.s, other, x, .bf16, rows, old, .f32);
+        try t.expect(try short.single(&dense, r.s, other, x, new, .f32, rows));
+        try equal(r, old, new, rows * 256 * 4);
+        try dense.decodeGroup(r.s, &gu, x, .bf16, rows, &pair, .bf16);
+        try t.expect(try short.paired(&dense, r.s, gu, x, actual, rows));
+        for (pair, actual) |before, after| try equal(r, before, after, rows * 512 * 2);
+        try activation.swiglu(r.s, pair[0], 512, pair[1], 512, h, null, rows, 512);
+        try dense.decode(r.s, down, h, .bf16, rows, old, .f32);
+        try t.expect(try short.gated(&dense, r.s, gu, down, x, new, rows));
+        try equal(r, old, new, rows * 6144 * 4);
+        short.enabled = false;
+        try short.projectRange(&dense, r.s, down, h, new, .f32, rows);
+        short.enabled = true;
+        try equal(r, old, new, rows * 6144 * 4);
+    }
+    // A zero input makes every SwiGLU lane the known product of the two biases.
+    const zero: [6144]u16 = @splat(0);
+    const x0 = try r.input(std.mem.sliceAsBytes(&zero));
+    for ([_][2]f16{ .{ 1000, 1000 }, .{ 2000, 2008 } }) |biases| {
+        var planted = gu;
+        for (&planted, biases) |*w, value| {
+            const bias: [512]f16 = @splat(value);
+            w.bias = try r.input(std.mem.sliceAsBytes(&bias));
+        }
+        try dense.decodeGroup(r.s, &planted, x0, .bf16, 1, &pair, .bf16);
+        try activation.swiglu(r.s, pair[0], 512, pair[1], 512, h, null, 1, 512);
+        const planted_word = @import("bf16_round").bits(@as(f32, biases[0]) * @as(f32, biases[1]));
+        for (std.mem.bytesAsSlice(u16, try r.bytes(h, 512 * 2))) |word| try t.expectEqual(planted_word, word);
+        short.enabled = false;
+        try short.projectRange(&dense, r.s, down, h, old, .f32, 1);
+        short.enabled = true;
+        try t.expect(try short.gated(&dense, r.s, planted, down, x0, new, 1));
+        try equal(r, old, new, 6144 * 4);
+        for (std.mem.bytesAsSlice(f32, try r.bytes(new, 6144 * 4))) |v| try t.expect(std.math.isFinite(v));
+    }
+    try t.expect(!try short.gated(&dense, r.s, gu, down, x, new, 9));
+    var mixed = gu;
+    mixed[1].halves = 12;
+    try t.expect(!try short.paired(&dense, r.s, mixed, x, actual, 1));
+}
