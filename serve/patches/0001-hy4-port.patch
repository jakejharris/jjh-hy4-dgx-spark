+        }
+    }
+
+    if (self_test_flag) return self_test.run(gpa, device, memAvailableBytes);
+    if (check_tp4_pack) |pack_path| {
+        const ps = try ranks.verifyPackReassembly(gpa, io, pack_path);
+        std.debug.print("PACK tensors={d} split={d} replicated={d} bytes={d} sha256={x}\n", .{ ps.tensors, ps.split, ps.replicated, ps.bytes, ps.sha256 });
+        return;
+    }
+
+    if (tp_opts.tp_world != 1 and tp_opts.tp_world != cuda.hy4_tp.world) return error.BadHy4Rank;
+    const model_path = model_arg orelse { usage(); return error.BadArgs; };
+
+    var idx = try weights.ShardIndex.openWithTrunkAndHead(gpa, io, model_path, config_arg, trunk_arg, target_head_arg, drafter_path);
+    defer idx.deinit();
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, device);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+
+    var tp_sess: ?boundary.TpSession = if (tp_opts.tp_world == cuda.hy4_tp.world) try boundary.TpSession.openWithStream(io, stream, tp_opts) else null;
+    var tp_clean = false;
+    defer if (tp_sess) |*tps| { if (tp_clean) tps.close() else tps.abortAndClose(); };
+
+    const tp_ptr: ?*boundary.TpSession = if (tp_sess) |*tps| tps else null;
+    if (check_load) {
+        if (tp_ptr) |tps| {
+            var tbuf: [96]u8 = undefined;
+            try tps.agreePackAndRun(gpa, io, &idx, try std.fmt.bufPrint(&tbuf, "check-load:{?d}:{?d}:{}:{}", .{ layer_arg, max_layers, skip_head, drafter_on }));
+        }
+        try checkMemFloor(floor_gib);
+        // `--load-rank R`: one process loads rank R's slice alone (no TP session), e.g. to check a per-rank pack.
+        const solo: ?ranks.Rank = if (load_rank) |r| try ranks.Rank.init(r, cuda.hy4_tp.world) else null;
+        const place_b = try cuda_native.hy4PlacementWeightBytesIndexWithDrafts(gpa, io, &idx, if (solo != null) cuda.hy4_tp.world else tp_opts.tp_world, load_rank orelse tp_opts.rank, drafter_on);
+        const t_load = std.Io.Clock.awake.now(io).toNanoseconds();
+        const st = try weights.checkLoadRank(gpa, io, &driver, &idx, layer_arg, max_layers, skip_head, if (tp_ptr) |tps| tps.rank else solo);
+        const load_ms = @divTrunc(std.Io.Clock.awake.now(io).toNanoseconds() - t_load, std.time.ns_per_ms);
+        if (tp_ptr) |tps| { try tps.agreePostLoad("CHECK_LOADED", "Hy4 check-load weights"); try tps.finishRun(stream); }
+        tp_clean = true;
+        std.debug.print("hy4 check-load PASS (tp={d} rank={d}): trunk={} head={} dense={d} sparse_bf16={d} sparse_exl3={d} trunk_exl3={d}/{d} (exl3 {d}x{d}, placement={d:.2} GiB, MemAvailable {d:.2} GiB, load_ms={d}, rank_pack={})\n", .{
+            if (solo != null) cuda.hy4_tp.world else tp_opts.tp_world, load_rank orelse tp_opts.rank, st.has_trunk, st.has_head, st.n_dense, st.n_bf16, st.n_exl3, st.n_trunk_exl3, st.trunk_exl3_mats, st.exl3_dims, st.exl3_width, @as(f64, @floatFromInt(place_b)) / (1 << 30), @as(f64, @floatFromInt(memAvailableBytes())) / (1 << 30), load_ms, idx.pack != null,
+        });
+        return;
+    }
+
+    if (check_window7) {
+        try trunk_exl3_window.runCheckWindow7Cli(gpa, io, &driver, stream, &idx, synthetic_len, seed, prompt_st, tokens_csv, max_layers, skip_head, floor_gib, tp_ptr, checkMemFloor);
+        tp_clean = true;
+        return;
+    }
+
+    const out_path = output_arg orelse { usage(); return error.BadArgs; };
+    var dump = dump_oracle.Dump.init(gpa);
+    defer dump.deinit();
+
+    var explicit_drafter_idx: ?weights.ShardIndex = if (drafter_on and !drafter_synthetic)
+        try trunk_exl3.openDrafterIndex(gpa, io, &idx, config_arg, drafter_path, drafter_exl3_arg, drafter_head_arg)
+    else
+        null;
+    defer if (explicit_drafter_idx) |*didx| didx.deinit();
+
+    const drafter_idx_ptr: ?*const weights.ShardIndex = if (explicit_drafter_idx) |*didx| didx
+    else if (drafter_on and !drafter_synthetic and idx.cfg.value.dfly_num_hidden_layers > 0) &idx else null;
+    const use_synth_drafter = drafter_on and (drafter_synthetic or (drafter_idx_ptr == null and idx.cfg.value.dfly_num_hidden_layers == 0));
+    const explicit_costs: ?draft_policy.CostParams = if (row_cost_arg orelse boundary.envStr("TF_HY4_ROW_COST_TABLE")) |rc|
+        try draft_policy.CostParams.parseSpecOrFile(gpa, io, rc, if (tp_ptr != null) 7.0 else 25.0, if (tp_ptr != null) 0.5 else 2.0)
+    else null;
+
+    const bench_widths: ?[]usize = if (bench_widths_arg) |bw| try window_bench.parseBenchWidths(gpa, bw) else null;
+    defer if (bench_widths) |bw| gpa.free(bw);
+    const use_resident = synthetic_len != null or chunk_size != null or greedy_tokens != null or bench_window_iters > 0 or bench_parts_iters > 0 or cached_last or kv_capacity != null or full_kv_pool or drafter_on;
+    if (layer_arg) |l| {
+        if (tp_ptr) |tps| {
+            var tbuf: [160]u8 = undefined;
+            try tps.agreePackAndRun(gpa, io, &idx, try std.fmt.bufPrint(&tbuf, "replay:{d}:{d}:{}:{}:{}:{}:{}", .{
+                l, end_layer_arg orelse l, with_head, dump_shared, dump_all_ranks, verify_picks, boundary.envFlag("HY4_TP_DIRECT_WRITE"),
+            }));
+        }
+        var rt = try forward.Runtime.init(gpa, &driver, stream);
+        defer rt.deinit();
+        const in_path = inputs_arg orelse return error.MissingReplayInputs;
+        if (tp4_slice_replay) {
+            try trunk_exl3_replay.runReplayFourSliceToDump(gpa, io, &rt, &idx, l, end_layer_arg orelse l, in_path, forced_st, with_head, dump_shared, floor_gib, checkMemFloor, &dump);
+        } else {
+            try runReplayToDump(gpa, io, &rt, &idx, l, end_layer_arg orelse l, in_path, .{
+                .forced_indices_path = forced_st, .with_head = with_head, .dump_shared_indices = dump_shared,
+                .verify_rank_picks = verify_picks, .mem_floor_gib = floor_gib, .tp_sess = tp_ptr,
+            }, &dump);
+        }
+    } else {
+        const prompt = if (synthetic_len) |slen| try resident.syntheticPrompt(gpa, idx.cfg.value.text_config.vocab_size, slen, seed)
+        else if (prompt_st) |p| try dump_oracle.readPromptSafetensors(gpa, io, p)
+        else if (tokens_csv) |csv| try parseCsvTokens(gpa, csv)
+        else if (tokens_u32) |u32_path| blk: {
+            const raw = try std.Io.Dir.cwd().readFileAlloc(io, u32_path, gpa, .limited(4 << 20));
+            defer gpa.free(raw);
+            if (raw.len == 0 or raw.len % 4 != 0) return error.BadInputIds;
+            const ids = try gpa.alloc(u32, raw.len / 4);
+            for (ids, 0..) |*dst, j| dst.* = std.mem.readInt(u32, raw[j * 4 ..][0..4], .little);
+            break :blk dump_oracle.PromptTokens{ .batch = 1, .seq_len = ids.len, .ids = ids };
+        } else { usage(); return error.BadArgs; };
+        defer prompt.deinit(gpa);
+
+        if (tp_ptr) |tps| {
+            var psha: [32]u8 = undefined;
+            std.crypto.hash.sha2.Sha256.hash(std.mem.sliceAsBytes(prompt.ids), &psha, .{});
+            var tbuf: [448]u8 = undefined;
+            const dtag = if (drafter_idx_ptr) |didx| didx.trunk_tag else "";
+            const mm_bits: u32 = if (draft_min_margin orelse try draft_policy.envMinMargin()) |mm| @bitCast(mm) else 0;
+            const rtag = try std.fmt.bufPrint(&tbuf, "run:{}:{?d}:{}:{?d}:{?d}:{d}:{d}:{s}:{}:{}:{}:{}:{}:{}:{?d}:{x}:{}:{s}:{d}:{d}:{x}", .{
+                use_resident, max_layers, skip_head, chunk_size, greedy_tokens, bench_window_iters, bench_parts_iters,
+                bench_widths_arg orelse "", boundary.envFlag("TF_HY4_INDEX_PAGE_2K"), boundary.envFlag("TF_HY4_GREEDY_FULL_GATHER"),
+                boundary.envFlag("HY4_TP_DIRECT_WRITE"), cached_last, dump_all_ranks, verify_picks, draft_depth, mm_bits, auto_depth, dtag, prompt.batch, prompt.seq_len, psha[0..8],
+            });
+            try tps.agreePackAndRun(gpa, io, &idx, rtag);
+            if (drafter_idx_ptr) |didx| if (didx != &idx) try tps.agreeDrafterPack(gpa, io, didx);
+        }
+
+        if (tp4_slice_replay) {
+            var rt = try forward.Runtime.init(gpa, &driver, stream);
+            defer rt.deinit();
+            try trunk_exl3_replay.runPromptFourSliceToDump(gpa, io, &rt, &idx, prompt, max_layers, skip_head, floor_gib, checkMemFloor, &dump);
+        } else if (use_resident) {
+            try resident.runResidentToDump(gpa, io, &driver, stream, &idx, prompt, .{
+                .max_layers = max_layers, .skip_head = skip_head, .chunk_size = chunk_size orelse resident.default_chunk_rows,
+                .greedy_tokens = greedy_tokens orelse 0, .bench_window_iters = bench_window_iters,
+                .bench_widths = bench_widths, .bench_parts_iters = bench_parts_iters,
+                .cached_last_token = cached_last, .verify_rank_picks = verify_picks,
+                .kv_capacity = kv_capacity, .full_kv_pool = full_kv_pool, .mem_floor_gib = floor_gib, .tp_sess = tp_ptr,
+                .drafter_idx = drafter_idx_ptr, .drafter_synthetic = use_synth_drafter, .drafter_wrong = drafter_wrong,
+                .draft_depth = draft_depth, .draft_min_margin = draft_min_margin, .auto_depth = auto_depth, .explicit_costs = explicit_costs, .bench_drafter_iters = bench_drafter,
+            }, checkMemFloor, memAvailableBytes, &dump);
+        } else {
+            var rt = try forward.Runtime.init(gpa, &driver, stream);
+            defer rt.deinit();
+            try runPromptToDump(gpa, io, &rt, &idx, prompt, .{
+                .max_layers = max_layers, .skip_head = skip_head, .forced_indices_path = forced_st,
+                .dump_shared_indices = dump_shared, .verify_rank_picks = verify_picks, .mem_floor_gib = floor_gib, .tp_sess = tp_ptr,
+            }, &dump);
+        }
+    }
+
+    if (tp_ptr) |tps| try tps.finishRun(stream);
+    tp_clean = true;
+    if (tp_ptr == null or tp_ptr.?.rank == .zero or dump_all_ranks) {
+        const rank_out = try rankDumpPath(gpa, out_path, @intCast(tp_opts.rank), dump_all_ranks, tp_ptr != null);
+        defer gpa.free(rank_out);
+        try dump.write(rank_out);
+        std.debug.print("hy4 oracle dump (tp={d} rank={d}): {d} tensors -> {s} (MemAvailable {d:.2} GiB)\n", .{
+            tp_opts.tp_world, tp_opts.rank, dump.entries.items.len, rank_out, @as(f64, @floatFromInt(memAvailableBytes())) / (1 << 30),
+        });
+    }
+}
+
+test {
+    _ = .{ config, ranks, boundary, rank_picks, weights, exl3_weights, trunk_exl3, trunk_exl3_replay, trunk_exl3_window, cache, kv_pool, direct_load, greedy, dump_oracle, forward, draft_policy, drafter, window_bench, speculative, resident, cuda_backend, cuda_native, drafter_state_check, vision_config, vision_image, vision_weights, vision_runtime, @import("real_shape_test.zig"), @import("trunk_exl3_test.zig"), @import("weights_test.zig"), @import("pack_test.zig"), @import("repeat_stable.zig"), @import("vision_guard_test.zig") };
+}
diff --git a/zig/src/families/hy4/kv_pool.zig b/zig/src/families/hy4/kv_pool.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c4738929be67a52353745e8ef6f075d60d0f29f3
--- /dev/null
+++ b/zig/src/families/hy4/kv_pool.zig
@@ -0,0 +1,245 @@
+//! Lossless BF16 KV and full-indexer key pool for Full Hy4 (`hy_v4_vl` / `hy_v4`).
+//!
+//! Stores per-layer MLA `[kv_lora_rank(512) || k_pe(64)]` (`576` BF16 = `1,152` B/tok on all 78 layers)
+//! plus full-indexer keys `[index_head_dim(128)]` (`128` BF16 = `256` B/tok on the 21 `.full` layers):
+//! `78 * 1,152 + 21 * 256 = 95,232` bytes/token (`12,482,248,704` bytes = `11.625 GiB` at `131,072` tokens).
+//! Nothing in the pool is stored below BF16. Both tensors are head-shared across attention heads, so this
+//! exact per-layer layout carries unchanged to TP=4 (where each rank holds 16 heads and replicated latent KV).
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const config = @import("config.zig");
+const cache = @import("cache.zig");
+
+pub const default_capacity: usize = 131_072;
+pub const default_page_tokens: usize = 256;
+
+pub fn kvRowBytes(t: config.Text) usize {
+    return t.kvARows() * @sizeOf(u16);
+}
+
+pub fn indexRowBytes(t: config.Text) usize {
+    return @as(usize, t.index_head_dim) * @sizeOf(u16);
+}
+
+pub fn fullIndexerCount(t: config.Text, start_layer: usize, layer_count: usize) usize {
+    var count: usize = 0;
+    const end: usize = @min(start_layer + layer_count, t.indexer_types.len);
+    if (start_layer >= end) return 0;
+    for (t.indexer_types[start_layer..end]) |kind| {
+        if (kind == .full) count += 1;
+    }
+    return count;
+}
+
+pub fn bytesPerTokenSlice(t: config.Text, start_layer: usize, layer_count: usize) usize {
+    const end: usize = @min(start_layer + layer_count, @as(usize, t.num_hidden_layers));
+    const n_layers = end -| start_layer;
+    return n_layers * kvRowBytes(t) + fullIndexerCount(t, start_layer, n_layers) * indexRowBytes(t);
+}
+
+pub fn bytesPerToken(t: config.Text) usize {
+    return bytesPerTokenSlice(t, 0, t.num_hidden_layers);
+}
+
+pub fn poolBytesSlice(t: config.Text, start_layer: usize, layer_count: usize, capacity: usize) usize {
+    return bytesPerTokenSlice(t, start_layer, layer_count) * capacity;
+}
+
+pub fn poolBytes(t: config.Text, capacity: usize) usize {
+    return bytesPerToken(t) * capacity;
+}
+
+pub fn coreLayout(t: config.Text, fixed_bytes: usize, page_tokens: usize) core.kv_pool.Layout {
+    const pt: u32 = @intCast(@as(usize, @max(page_tokens, @as(usize, 1))));
+    return .{
+        .fixed_bytes = fixed_bytes,
+        .token_bytes = bytesPerToken(t),
+        .page_tokens = pt,
+        .snap_bytes = 0,
+    };
+}
+
+pub const KvPool = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    start_layer: usize,
+    layer_count: usize,
+    capacity: usize,
+    kv_bufs: []cuda.DeviceBuffer,
+    index_bufs: []cuda.DeviceBuffer,
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, t: config.Text, capacity: usize) !KvPool {
+        return initSlice(gpa, d, t, 0, t.num_hidden_layers, capacity);
+    }
+
+    pub fn initSlice(
+        gpa: std.mem.Allocator,
+        d: *const cuda.Driver,
+        t: config.Text,
+        start_layer: usize,
+        layer_count: usize,
+        capacity: usize,
+    ) !KvPool {
+        if (capacity == 0 or capacity > std.math.maxInt(i32)) return error.BadKvCapacity;
+        if (start_layer > t.num_hidden_layers or layer_count > t.num_hidden_layers - start_layer)
+            return error.BadLayerIndex;
+
+        const kv_bufs = try gpa.alloc(cuda.DeviceBuffer, layer_count);
+        errdefer gpa.free(kv_bufs);
+        const index_bufs = try gpa.alloc(cuda.DeviceBuffer, layer_count);
+        errdefer gpa.free(index_bufs);
+
+        const empty: cuda.DeviceBuffer = .{ .d = d, .ptr = 0, .len = 0 };
+        @memset(kv_bufs, empty);
+        @memset(index_bufs, empty);
+
+        var made: usize = 0;
+        errdefer {
+            for (0..made) |i| {
+                kv_bufs[i].free();
+                index_bufs[i].free();
+            }
+        }
+
+        const kv_bytes = try std.math.mul(usize, capacity, kvRowBytes(t));
+        const idx_bytes = try std.math.mul(usize, capacity, indexRowBytes(t));
+
+        for (0..layer_count) |i| {
+            const l = start_layer + i;
+            kv_bufs[i] = try cuda.DeviceBuffer.alloc(d, kv_bytes);
+            if (t.indexer_types[l] == .full) {
+                index_bufs[i] = cuda.DeviceBuffer.alloc(d, idx_bytes) catch |err| {
+                    kv_bufs[i].free();
+                    kv_bufs[i] = empty;
+                    return err;
+                };
+            }
+            made += 1;
+        }
+
+        return .{
+            .gpa = gpa,
+            .d = d,
+            .start_layer = start_layer,
+            .layer_count = layer_count,
+            .capacity = capacity,
+            .kv_bufs = kv_bufs,
+            .index_bufs = index_bufs,
+        };
+    }
+
+    pub fn totalBytes(self: *const KvPool) usize {
+        var sum: usize = 0;
+        for (self.kv_bufs, self.index_bufs) |kvb, ixb| sum += kvb.len + ixb.len;
+        return sum;
+    }
+
+    pub fn layerCache(self: *const KvPool, layer: usize) !cache.LayerCache {
+        if (layer < self.start_layer or layer - self.start_layer >= self.layer_count)
+            return error.BadLayerIndex;
+        const slot = layer - self.start_layer;
+        return .{
+            .kv_ptr = self.kv_bufs[slot].ptr,
+            .index_ptr = self.index_bufs[slot].ptr,
+            .capacity = self.capacity,
+            .has_prefix = true,
+        };
+    }
+
+    pub fn zeroFill(self: *KvPool, stream: ?cuda.abi.Stream) !void {
+        for (self.kv_bufs, self.index_bufs) |*kvb, *ixb| {
+            if (kvb.len > 0) try kvb.fill8(0, stream);
+            if (ixb.len > 0) try ixb.fill8(0, stream);
+        }
+    }
+
+    pub fn clearLayerKvRange(self: *KvPool, t: config.Text, layer: usize, from_pos: usize, to_pos: usize, stream: ?cuda.abi.Stream) !void {
+        if (from_pos >= to_pos or from_pos >= self.capacity) return;
+        if (layer < self.start_layer or layer - self.start_layer >= self.layer_count) return error.BadLayerIndex;
+        const end_pos: usize = @min(to_pos, self.capacity);
+        const slot = layer - self.start_layer;
+        const row_b = kvRowBytes(t);
+        const sub: cuda.DeviceBuffer = .{ .d = self.d, .ptr = self.kv_bufs[slot].ptr + from_pos * row_b, .len = (end_pos - from_pos) * row_b, .borrowed = true };
+        if (sub.len > 0) try sub.fill8(0, stream);
+    }
+
+    pub fn clearRange(self: *KvPool, t: config.Text, from_pos: usize, to_pos: usize, stream: ?cuda.abi.Stream) !void {
+        if (from_pos >= to_pos or from_pos >= self.capacity) return;
+        const end_pos: usize = @min(to_pos, self.capacity);
+        const count = end_pos - from_pos;
+        const kv_b = kvRowBytes(t);
+        const ix_b = indexRowBytes(t);
+        for (self.kv_bufs, self.index_bufs) |kvb, ixb| {
+            if (kvb.len > 0) {
+                const sub_kv: cuda.DeviceBuffer = .{ .d = self.d, .ptr = kvb.ptr + from_pos * kv_b, .len = count * kv_b, .borrowed = true };
+                try sub_kv.fill8(0, stream);
+            }
+            if (ixb.len > 0) {
+                const sub_ix: cuda.DeviceBuffer = .{ .d = self.d, .ptr = ixb.ptr + from_pos * ix_b, .len = count * ix_b, .borrowed = true };
+                try sub_ix.fill8(0, stream);
+            }
+        }
+    }
+
+    pub fn deinit(self: *KvPool) void {
+        for (self.kv_bufs, self.index_bufs) |*kvb, *ixb| {
+            kvb.free();
+            ixb.free();
+        }
+        self.gpa.free(self.kv_bufs);
+        self.gpa.free(self.index_bufs);
+        self.* = undefined;
+    }
+};
+
+fn buildReal78IndexerTypes() [78]config.IndexerType {
+    var out: [78]config.IndexerType = @splat(.shared);
+    var l: usize = 0;
+    while (l < 78) : (l += 4) out[l] = .full;
+    out[77] = .full;
+    return out;
+}
+
+test "KvPool sizes 78-layer Hy4 at 95,232 BF16 bytes/tok (11.625 GiB at 131,072) and unwinds cleanly" {
+    const gpa = std.testing.allocator;
+    const idx_types = buildReal78IndexerTypes();
+    const real_t: config.Text = .{
+        .hidden_size = 6144, .intermediate_size = 18432, .moe_intermediate_size = 2048,
+        .num_hidden_layers = 78, .vocab_size = 120832, .q_lora_rank = 2048, .kv_lora_rank = 512,
+        .num_attention_heads = 64, .qk_nope_head_dim = 192, .qk_rope_head_dim = 64, .v_head_dim = 256,
+        .index_n_heads = 32, .index_head_dim = 128, .index_topk = 2048, .indexer_types = &idx_types,
+        .n_routed_experts = 256, .num_experts_per_tok = 8,
+    };
+
+    try std.testing.expectEqual(@as(usize, 21), fullIndexerCount(real_t, 0, 78));
+    try std.testing.expectEqual(@as(usize, 1152), kvRowBytes(real_t));
+    try std.testing.expectEqual(@as(usize, 256), indexRowBytes(real_t));
+    try std.testing.expectEqual(@as(usize, 95_232), bytesPerToken(real_t));
+    try std.testing.expectEqual(@as(usize, 12_482_248_704), poolBytes(real_t, default_capacity));
+
+    const layout = coreLayout(real_t, 1 << 20, default_page_tokens);
+    try std.testing.expectEqual(@as(u64, 95_232 * 256), layout.pageBytes());
+    try std.testing.expectEqual(@as(u32, 256), layout.page_tokens);
+
+    const mock = cache.TestMock;
+    var d = mock.init();
+    var pool = try KvPool.init(gpa, &d, real_t, 64);
+    try std.testing.expectEqual(@as(usize, 95_232 * 64), pool.totalBytes());
+    try std.testing.expect((try pool.layerCache(0)).index_ptr != 0);
+    try std.testing.expectEqual(@as(u64, 0), (try pool.layerCache(1)).index_ptr);
+    try std.testing.expect((try pool.layerCache(4)).index_ptr != 0);
+    try std.testing.expect((try pool.layerCache(77)).index_ptr != 0);
+    try pool.zeroFill(null);
+    pool.deinit();
+    try std.testing.expectEqual(mock.allocations, mock.frees);
+
+    // Transactional unwind on partial device OOM: zero leaked buffers.
+    const before = cuda.memory.usage(false);
+    const prev_lim = try cuda.memory.setAllocationLimit(before.device + before.host + 64 * (1152 + 256 + 1152));
+    defer _ = cuda.memory.setAllocationLimit(prev_lim) catch {};
+    var d2 = mock.init();
+    try std.testing.expectError(error.OutOfDeviceMemory, KvPool.init(gpa, &d2, real_t, 64));
+    try std.testing.expectEqual(before.device, cuda.memory.usage(false).device);
+    try std.testing.expectEqual(mock.allocations, mock.frees);
+}
diff --git a/zig/src/families/hy4/moe_forward.zig b/zig/src/families/hy4/moe_forward.zig
new file mode 100644
index 0000000000000000000000000000000000000000..611de2244f36948bcc6e00b8f761b5345eec8c1f
--- /dev/null
+++ b/zig/src/families/hy4/moe_forward.zig
@@ -0,0 +1,213 @@
+//! Routed + shared MoE FFN forward (`sparse_bf16` and `sparse_exl3`) for TP=1 and TP=4 Full Hy4.
+//!
+//! Both TP=1 and TP=4 accumulate routed expert down outputs and shared expert down outputs in FP32 via
+//! `cuda.hy4_ops.addExpertPartial` and round once to BF16 (`vit_k.cast` on TP=1; `Boundary.gatherFold` on TP=4).
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const config = @import("config.zig");
+const ranks = @import("ranks.zig");
+const boundary = @import("boundary.zig");
+const weights = @import("weights.zig");
+const forward = @import("forward.zig");
+
+const Runtime = forward.Runtime;
+const Scratch = forward.Scratch;
+const LayerCaptureHost = forward.LayerCaptureHost;
+
+fn bf16Val(bits: u16) f32 {
+    return core.quant.convert.load(.bf16, std.mem.asBytes(&bits), 0);
+}
+
+fn clampedSwigluBf16(gate_u16: u16, up_u16: u16, limit: f32) u16 {
+    const g = bf16Val(core.quant.convert.bf16(@min(bf16Val(gate_u16), limit)));
+    const u = bf16Val(core.quant.convert.bf16(std.math.clamp(bf16Val(up_u16), -limit, limit)));
+    const silu = bf16Val(core.quant.convert.bf16(g / (1.0 + @exp(-g))));
+    return core.quant.convert.bf16(silu * u);
+}
+
+pub fn runSparseBf16(
+    rt: *Runtime,
+    sc: *Scratch,
+    t: config.Text,
+    sp: weights.SparseBf16,
+    rows: usize,
+    tp_sess: ?*const boundary.TpSession,
+    cap: ?LayerCaptureHost,
+) !void {
+    const gpa = rt.gpa;
+    const ls = try ranks.LocalShape.forText(t, sc.rank);
+    const h: usize = t.hidden_size;
+    const e_count: usize = t.n_routed_experts;
+    const k_top: usize = t.num_experts_per_tok;
+    const inter: usize = ls.expert;
+
+    const x_f32 = try rt.widenBf16ToF32(sc, sc.hidden.ptr, rows, h);
+    try rt.runLinearF32(x_f32, sp.router_f32, sc.router_logits.ptr, rows, e_count, h);
+    try rt.stream.synchronize();
+
+    const logits_host = try gpa.alloc(f32, rows * e_count); defer gpa.free(logits_host);
+    try cuda.memory.download(rt.d, sc.router_logits.ptr, std.mem.sliceAsBytes(logits_host));
+    const hidden_host = try gpa.alloc(u16, rows * h); defer gpa.free(hidden_host);
+    try cuda.memory.download(rt.d, sc.hidden.ptr, std.mem.sliceAsBytes(hidden_host));
+
+    const picked_ids = try gpa.alloc(i32, rows * k_top); defer gpa.free(picked_ids);
+    const picked_wts = try gpa.alloc(f32, rows * k_top); defer gpa.free(picked_wts);
+    const scores = try gpa.alloc(f32, e_count); defer gpa.free(scores);
+    const choices = try gpa.alloc(f32, e_count); defer gpa.free(choices);
+
+    for (0..rows) |r| {
+        for (0..e_count) |ex| {
+            const s: f32 = 1.0 / (1.0 + @exp(-logits_host[r * e_count + ex]));
+            scores[ex] = s;
+            choices[ex] = s + sp.correction_bias_host[ex];
+        }
+        var w_sum: f32 = 0;
+        for (0..k_top) |slot| {
+            var best_idx: usize = 0;
+            var best_val: f32 = -std.math.inf(f32);
+            for (0..e_count) |ex| if (choices[ex] > best_val) { best_val = choices[ex]; best_idx = ex; };
+            choices[best_idx] = -std.math.inf(f32);
+            picked_ids[r * k_top + slot] = @intCast(best_idx);
+            picked_wts[r * k_top + slot] = scores[best_idx];
+            w_sum += scores[best_idx];
+        }
+        const scale = if (t.norm_topk_prob) t.routed_scaling_factor / (w_sum + 1e-20) else t.routed_scaling_factor;
+        for (0..k_top) |slot| picked_wts[r * k_top + slot] *= scale;
+    }
+
+    if (cap) |c| {
+        if (c.router_ids) |dst| @memcpy(dst, picked_ids);
+        if (c.router_weights) |dst| @memcpy(dst, picked_wts);
+    }
+
+    const hit_rows = try gpa.alloc(usize, rows * k_top); defer gpa.free(hit_rows);
+    const hit_slots = try gpa.alloc(usize, rows * k_top); defer gpa.free(hit_slots);
+    const total_hits: usize = rows * k_top;
+    const step_cap: usize = if (total_hits == 0) 1 else if (total_hits > 256) 256 else total_hits;
+    try sc.ensureBf16MoeScratch(t, step_cap);
+    const x_batch = try gpa.alloc(u16, step_cap * h); defer gpa.free(x_batch);
+    const gu_host = try gpa.alloc(u16, step_cap * 2 * inter); defer gpa.free(gu_host);
+    const act_host = try gpa.alloc(u16, step_cap * inter); defer gpa.free(act_host);
+    const final_f32 = try gpa.alloc(f32, rows * h); defer gpa.free(final_f32);
+    @memset(final_f32, 0);
+    const dn_f32 = try gpa.alloc(f32, step_cap * h); defer gpa.free(dn_f32);
+
+    for (0..e_count) |ex| {
+        var m_e: usize = 0;
+        for (0..k_top) |slot| for (0..rows) |r| {
+            if (picked_ids[r * k_top + slot] == @as(i32, @intCast(ex))) { hit_rows[m_e] = r; hit_slots[m_e] = slot; m_e += 1; }
+        };
+        var base: usize = 0;
+        while (base < m_e) {
+            const cur: usize = @min(step_cap, m_e - base);
+            for (0..cur) |j| @memcpy(x_batch[j * h ..][0..h], hidden_host[hit_rows[base + j] * h ..][0..h]);
+            try sc.moe_x.uploadAsync(0, std.mem.sliceAsBytes(x_batch[0 .. cur * h]), rt.stream.handle);
+            try rt.runLinearBf16(sc, sc.moe_x.ptr, sp.gate_up[ex], sc.moe_gu.ptr, cur);
+            try rt.stream.synchronize();
+            try cuda.memory.download(rt.d, sc.moe_gu.ptr, std.mem.sliceAsBytes(gu_host[0 .. cur * 2 * inter]));
+            for (0..cur) |j| {
+                const gu_row = gu_host[j * 2 * inter ..][0 .. 2 * inter];
+                const act_row = act_host[j * inter ..][0..inter];
+                for (0..inter) |col| act_row[col] = clampedSwigluBf16(gu_row[col], gu_row[inter + col], t.swiglu_limit);
+            }
+            try sc.moe_act.uploadAsync(0, std.mem.sliceAsBytes(act_host[0 .. cur * inter]), rt.stream.handle);
+            try rt.runLinearRowPartialF32(sc, sc.moe_act.ptr, sp.down[ex], sc.moe_down.ptr, cur);
+            try rt.stream.synchronize();
+            try cuda.memory.download(rt.d, sc.moe_down.ptr, std.mem.sliceAsBytes(dn_f32[0 .. cur * h]));
+            for (0..cur) |j| {
+                const tok = hit_rows[base + j];
+                const wt = picked_wts[tok * k_top + hit_slots[base + j]];
+                const dst = final_f32[tok * h ..][0..h];
+                const src = dn_f32[j * h ..][0..h];
+                for (0..h) |col| dst[col] += src[col] * wt;
+            }
+            base += cur;
+        }
+    }
+
+    try sc.routed_f32.uploadAsync(0, std.mem.sliceAsBytes(final_f32), rt.stream.handle);
+    try rt.stampPart(.experts, null);
+    try forward.runDensePartialF32(rt, sc, sp.shared, rows, sc.shared_f32.ptr);
+    try rt.stampPart(.trunk, null);
+    if (tp_sess != null) {
+        try cuda.hy4_ops.addExpertPartial(&rt.ops, rt.stream, sc.routed_f32.ptr, sc.shared_f32.ptr, sc.tp_partial.ptr, rows * h);
+        try rt.stampPart(.other_local, null);
+    } else {
+        try cuda.hy4_ops.addExpertPartial(&rt.ops, rt.stream, sc.routed_f32.ptr, sc.shared_f32.ptr, sc.shared_f32.ptr, rows * h);
+        try rt.vit_k.cast(rt.stream, sc.shared_f32.ptr, sc.branch.ptr, rows * h);
+        try rt.stampPart(.other_local, null);
+    }
+}
+
+pub fn runSparseExl3(
+    rt: *Runtime,
+    sc: *Scratch,
+    t: config.Text,
+    sp: weights.SparseExl3,
+    rows: usize,
+    tp_sess: ?*const boundary.TpSession,
+    cap: ?LayerCaptureHost,
+) !void {
+    const h: usize = t.hidden_size;
+    const r_dims = sp.exl3_layer.dims;
+    const top_k: usize = t.num_experts_per_tok;
+    const x_ptr = if (r_dims == h) sc.hidden.ptr else blk: {
+        try sc.ensurePadScratch(rows * r_dims * 2);
+        const sub: cuda.DeviceBuffer = .{ .d = rt.d, .ptr = sc.pad_in.ptr, .len = rows * r_dims * 2, .borrowed = true };
+        try sub.fill8(0, rt.stream.handle);
+        try rt.copy2dAsync(sc.pad_in.ptr, r_dims * 2, sc.hidden.ptr, h * 2, h * 2, rows);
+        break :blk sc.pad_in.ptr;
+    };
+
+    if (sp.router_f32 != 0) {
+        try forward.routeF32LogitsAndTopk(rt, sc, x_ptr, sp.router_f32, sp.correction_bias, rows, r_dims, t.n_routed_experts, top_k, t.norm_topk_prob, t.routed_scaling_factor);
+        const chunk_cap: usize = if (rows > 1024) 1024 else rows;
+        try sc.ensureAuxScratch(@as(usize, @max(try cuda.exl3_experts.scratchBytes(sp.exl3_layer, chunk_cap, top_k), @as(usize, 256))));
+        var first: usize = 0;
+        while (first < rows) {
+            const cur: usize = @min(chunk_cap, rows - first);
+            const work = try cuda.exl3_experts.scratch(sc.aux_scratch.ptr, sp.exl3_layer, cur, top_k);
+            try rt.ops.experts.run(
+                rt.stream, sp.exl3_layer, x_ptr + first * r_dims * 2, r_dims, .bf16,
+                sc.router_ids.ptr + first * top_k * 4, sc.router_weights.ptr + first * top_k * 4,
+                cur, sc.routed_f32.ptr + first * r_dims * 4, work,
+            );
+            first += cur;
+        }
+    } else {
+        const r_shape: cuda.hy4_ops.RoutedShape = .{
+            .rows = @intCast(rows), .top_k = t.num_experts_per_tok,
+            .x_row_stride = @intCast(r_dims), .output_row_stride = @intCast(r_dims),
+            .route_scale = t.routed_scaling_factor,
+        };
+        try sc.ensureAuxScratch(@as(usize, @max(try cuda.hy4_ops.routedScratchBytesFor(&rt.ops, r_shape, sp.exl3_layer), @as(usize, 256))));
+        try cuda.hy4_ops.routedExperts(&rt.ops, rt.stream, r_shape, .{
+            .layer = sp.exl3_layer, .x = x_ptr, .router = sp.router_bf16,
+            .correction_bias = sp.correction_bias, .ids = sc.router_ids.ptr,
+            .weights = sc.router_weights.ptr, .output = sc.routed_f32.ptr,
+            .scratch = sc.aux_scratch.ptr, .scratch_bytes = sc.aux_scratch.len,
+        });
+    }
+
+    const f32_src = if (r_dims == h) sc.routed_f32.ptr else blk: {
+        try rt.copy2dAsync(sc.f32_in.ptr, h * 4, sc.routed_f32.ptr, r_dims * 4, h * 4, rows);
+        break :blk sc.f32_in.ptr;
+    };
+    try rt.stampPart(.experts, null);
+    try forward.runDensePartialF32(rt, sc, sp.shared, rows, sc.shared_f32.ptr);
+    try rt.stampPart(.trunk, null);
+    if (tp_sess != null) {
+        try cuda.hy4_ops.addExpertPartial(&rt.ops, rt.stream, f32_src, sc.shared_f32.ptr, sc.tp_partial.ptr, rows * h);
+        try rt.stampPart(.other_local, null);
+    } else {
+        try cuda.hy4_ops.addExpertPartial(&rt.ops, rt.stream, f32_src, sc.shared_f32.ptr, sc.shared_f32.ptr, rows * h);
+        try rt.vit_k.cast(rt.stream, sc.shared_f32.ptr, sc.branch.ptr, rows * h);
+        try rt.stampPart(.other_local, null);
+    }
+    if (cap) |c| {
+        try rt.stream.synchronize();
+        if (c.router_ids) |dst| try cuda.memory.download(rt.d, sc.router_ids.ptr, std.mem.sliceAsBytes(dst));
+        if (c.router_weights) |dst| try cuda.memory.download(rt.d, sc.router_weights.ptr, std.mem.sliceAsBytes(dst));
+    }
+}
diff --git a/zig/src/families/hy4/pack_export.zig b/zig/src/families/hy4/pack_export.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e3a4b21cc5ccf0cca11aae749900014ec6f6c2be
--- /dev/null
+++ b/zig/src/families/hy4/pack_export.zig
@@ -0,0 +1,516 @@
+//! Cuts a per-rank pack from a full Full Hy4 pack with the loader's own `ranks.tensorSpan`: `common/` holds every
+//! tensor all four TP=4 ranks read whole (written once), `rank<R>/` holds rank R's span of every tensor the loader
+//! reads sliced, as a flat tensor of the same dtype, with the full shape kept in that part's index. `checkPack`
+//! re-reads what was written against the stored file hashes and, given the source, compares every tensor with the
+//! span it was cut from. `pack_parts.zig` is the loading side.
+const std = @import("std");
+const core = @import("core");
+const config = @import("config.zig");
+const ranks = @import("ranks.zig");
+const weights = @import("weights.zig");
+const trunk_exl3 = @import("trunk_exl3.zig");
+const pack_parts = @import("pack_parts.zig");
+
+const st = core.safetensors;
+const Sha256 = std.crypto.hash.sha2.Sha256;
+const Value = std.json.Value;
+const ObjectMap = std.json.ObjectMap;
+const world = ranks.world;
+const part_names = [_][]const u8{ "common", "rank0", "rank1", "rank2", "rank3" };
+
+pub const Options = struct {
+    src: []const u8,
+    out: []const u8,
+    ranks: [world]bool = @splat(true),
+    common: bool = true,
+    /// Only `model.layers.<L>.` tensors of these layers (nothing else); null exports every tensor.
+    layers: ?[]const usize = null,
+    trunk: ?[]const u8 = null,
+    target_head: ?[]const u8 = null,
+};
+
+pub const Stats = struct { tensors: [1 + world]usize = @splat(0), bytes: [1 + world]u64 = @splat(0) };
+const MatrixK2 = struct { prefix: []const u8, k2: u8 };
+
+/// The full pack being cut: its config, the hash of its index, its identity hash, and which shard owns each tensor.
+const Source = struct {
+    arena: std.heap.ArenaAllocator,
+    cfg: config.Parsed,
+    hash_hex: [64]u8 = undefined,
+    index_hex: [64]u8 = @splat('-'),
+    index_name: []const u8 = "",
+    shards: [][]const u8 = &.{},
+    owner: ?ObjectMap = null,
+    trunk_recipe: ?[]const u8 = null,
+    target_head_recipe: ?[]const u8 = null,
+    trunk_tag: []const u8 = "",
+    matrices: []MatrixK2 = &.{},
+    out_rels: std.StringHashMapUnmanaged([]const u8) = .empty,
+
+    fn open(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, trunk_opt: ?[]const u8, target_head_opt: ?[]const u8) !Source {
+        const canon_trunk = try pack_parts.canonicalTrunkRecipe(gpa, trunk_opt);
+        defer if (canon_trunk) |ct| gpa.free(ct);
+        const head_spec = if (target_head_opt) |th| try trunk_exl3.canonicalTargetHeadSpec(th) else "fp32";
+        const use_overlay = canon_trunk != null or !std.mem.eql(u8, head_spec, "fp32");
+
+        const cfg_path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+        defer gpa.free(cfg_path);
+        const cfg_bytes = try std.Io.Dir.cwd().readFileAlloc(io, cfg_path, gpa, .limited(4 << 20));
+        defer gpa.free(cfg_bytes);
+        var s: Source = .{ .arena = std.heap.ArenaAllocator.init(gpa), .cfg = try config.parse(gpa, cfg_bytes) };
+        errdefer s.deinit();
+        const a = s.arena.allocator();
+        var names: std.ArrayList([]const u8) = .empty;
+        var h = Sha256.init(.{});
+
+        for ([_][]const u8{ pack_parts.common_index, "index.json" }) |iname| {
+            const p = try std.fs.path.join(gpa, &.{ dir, iname });
+            defer gpa.free(p);
+            const bytes = std.Io.Dir.cwd().readFileAlloc(io, p, a, .limited(256 << 20)) catch |err| switch (err) {
+                error.FileNotFound => continue,
+                else => return err,
+            };
+            const root = try std.json.parseFromSliceLeaky(Value, a, bytes, .{});
+            if (pack_parts.marker(root) != null) return error.Hy4SourceIsAlreadyAPart;
+            s.index_name = iname;
+            if (!use_overlay) {
+                s.owner = try st.index.weightMap(root);
+                h.update(bytes);
+                var seen: std.StringHashMapUnmanaged(void) = .empty;
+                for (s.owner.?.values()) |v| if (!(try seen.getOrPut(a, v.string)).found_existing) try names.append(a, v.string);
+            }
+            break;
+        }
+        if (use_overlay) {
+            var idx = try weights.ShardIndex.openWithTrunkAndHead(gpa, io, dir, null, trunk_opt orelse "bf16", target_head_opt orelse "off", null);
+            defer idx.deinit();
+            if (canon_trunk) |ct| s.trunk_recipe = try a.dupe(u8, ct);
+            if (idx.has("lm_head.trellis")) {
+                s.target_head_recipe = if (idx.trunk_k2.get("lm_head")) |hk2| (trunk_exl3.k2WidthName(hk2) orelse try a.dupe(u8, head_spec)) else try a.dupe(u8, head_spec);
+            }
+            s.trunk_tag = try a.dupe(u8, idx.trunk_tag);
+
+            var mlist: std.ArrayList(MatrixK2) = .empty;
+            var mit = idx.trunk_k2.iterator();
+            while (mit.next()) |mkv| try mlist.append(a, .{ .prefix = try a.dupe(u8, mkv.key_ptr.*), .k2 = mkv.value_ptr.* });
+            std.mem.sort(MatrixK2, mlist.items, {}, struct {
+                fn less(_: void, x: MatrixK2, y: MatrixK2) bool { return std.mem.lessThan(u8, x.prefix, y.prefix); }
+            }.less);
+            s.matrices = try mlist.toOwnedSlice(a);
+
+            var keys: std.ArrayList([]const u8) = .empty;
+            var kit = idx.weight_map.keyIterator();
+            while (kit.next()) |kp| try keys.append(a, kp.*);
+            std.mem.sort([]const u8, keys.items, {}, lessStr);
+
+            var wm: ObjectMap = .empty;
+            var seen: std.StringHashMapUnmanaged(void) = .empty;
+            h.update(s.trunk_tag);
+            h.update(&.{0});
+            for (keys.items) |k| {
+                const raw_sh = idx.weight_map.get(k).?;
+                const sh = try a.dupe(u8, raw_sh);
+                try wm.put(a, try a.dupe(u8, k), .{ .string = sh });
+                if (!(try seen.getOrPut(a, sh)).found_existing) {
+                    try names.append(a, sh);
+                    if (std.mem.startsWith(u8, sh, "../") or std.mem.startsWith(u8, sh, "/")) {
+                        const safe = try std.fs.path.join(a, &.{ "target-head", std.fs.path.basename(sh) });
+                        try s.out_rels.put(a, sh, safe);
+                    }
+                }
+                h.update(k);
+                h.update(&.{0});
+                h.update(sh);
+                h.update(&.{0});
+            }
+            s.owner = wm;
+        } else if (s.owner == null) {
+            var d = try std.Io.Dir.cwd().openDir(io, dir, .{ .iterate = true });
+            defer d.close(io);
+            var it = d.iterate();
+            while (try it.next(io)) |e| if (e.kind != .directory and std.mem.endsWith(u8, e.name, ".safetensors") and e.name[0] != '.')
+                try names.append(a, try a.dupe(u8, e.name));
+        }
+        s.shards = try names.toOwnedSlice(a);
+        std.mem.sort([]const u8, s.shards, {}, lessStr);
+        const index_digest = h.finalResult();
+        if (s.owner != null) s.index_hex = std.fmt.bytesToHex(index_digest, .lower);
+        var id = Sha256.init(.{});
+        id.update(&index_digest);
+        for (s.shards) |sh| {
+            const p = if (std.fs.path.isAbsolute(sh)) try gpa.dupe(u8, sh) else try std.fs.path.join(gpa, &.{ dir, sh });
+            defer gpa.free(p);
+            var f = try st.File.openPrefixes(gpa, io, p, &.{ "model.", "lm_head." });
+            defer f.close(io);
+            const mem = f.map.memory;
+            const sample: usize = @min(mem.len - f.data, 64 << 10);
+            const flen = std.mem.nativeToLittle(u64, mem.len);
+            id.update(sh);
+            id.update(std.mem.asBytes(&flen));
+            id.update(mem[0..f.data]);
+            id.update(mem[f.data..][0..sample]);
+            id.update(mem[mem.len - sample ..]);
+        }
+        s.hash_hex = std.fmt.bytesToHex(id.finalResult(), .lower);
+        return s;
+    }
+
+    fn outShard(self: *const Source, shard: []const u8) []const u8 {
+        return self.out_rels.get(shard) orelse shard;
+    }
+
+    fn deinit(self: *Source) void {
+        self.cfg.deinit();
+        self.arena.deinit();
+    }
+
+    fn takes(self: *const Source, name: []const u8, shard: []const u8, layers: ?[]const usize) bool {
+        if (self.owner) |m| {
+            const v = m.get(name) orelse return false;
+            if (!std.mem.eql(u8, v.string, shard)) return false;
+        }
+        const ls = layers orelse return true;
+        const rest = if (std.mem.startsWith(u8, name, "model.layers.")) name["model.layers.".len..] else return false;
+        const dot = std.mem.indexOfScalar(u8, rest, '.') orelse return false;
+        const l = std.fmt.parseInt(usize, rest[0..dot], 10) catch return false;
+        return std.mem.indexOfScalar(usize, ls, l) != null;
+    }
+};
+
+fn lessStr(_: void, x: []const u8, y: []const u8) bool {
+    return std.mem.lessThan(u8, x, y);
+}
+
+/// Per-tensor spans for all four ranks, and whether every rank reads the tensor whole (it then goes to `common/`).
+fn rankSpans(file: *const st.File, name: []const u8, e: st.Entry, t: config.Text) !struct { spans: [world]ranks.Span, whole: bool } {
+    var out: [world]ranks.Span = undefined;
+    var whole = true;
+    for (&out, 0..) |*sp, r| {
+        sp.* = try ranks.tensorSpan(file, name, e, t, try ranks.Rank.init(r, world), false);
+        if (sp.count != 1 or sp.offset != 0 or sp.len != e.end - e.begin) whole = false;
+    }
+    return .{ .spans = out, .whole = whole };
+}
+
+const Part = struct {
+    arena: std.heap.ArenaAllocator,
+    weight_map: ObjectMap = .empty,
+    shapes: ObjectMap = .empty,
+    files: ObjectMap = .empty,
+    total: u64 = 0,
+};
+
+pub fn exportPack(gpa: std.mem.Allocator, io: std.Io, o: Options) !Stats {
+    var src = try Source.open(gpa, io, o.src, o.trunk, o.target_head);
+    defer src.deinit();
+    const t = src.cfg.value.text_config;
+    var stats: Stats = .{};
+    var parts: [1 + world]Part = undefined;
+    for (&parts) |*p| p.* = .{ .arena = std.heap.ArenaAllocator.init(gpa) };
+    defer for (&parts) |*p| p.arena.deinit();
+    const want = [1 + world]bool{ o.common, o.ranks[0], o.ranks[1], o.ranks[2], o.ranks[3] };
+
+    for (src.shards) |shard| {
+        const path = if (std.fs.path.isAbsolute(shard)) try gpa.dupe(u8, shard) else try std.fs.path.join(gpa, &.{ o.src, shard });
+        defer gpa.free(path);
+        const out_shard = src.outShard(shard);
+        var file = try st.File.openPrefixes(gpa, io, path, &.{ "model.", "lm_head." });
+        defer file.close(io);
+        for (0..1 + world) |pi| if (want[pi]) {
+            var scratch = std.heap.ArenaAllocator.init(gpa);
+            defer scratch.deinit();
+            const sa = scratch.allocator();
+            const pa = parts[pi].arena.allocator();
+            var list: std.ArrayList(core.shard_edit.New) = .empty;
+            for (file.names.keys(), file.names.values()) |name, e| {
+                if (!src.takes(name, shard, o.layers)) continue;
+                const rs = try rankSpans(&file, name, e, t);
+                if (rs.whole != (pi == 0)) continue;
+                const raw = file.map.memory[file.data + e.begin .. file.data + e.end];
+                if (pi == 0) {
+                    try list.append(sa, .{ .name = name, .dtype = e.dtype, .shape = try sa.dupe(usize, e.shape[0..e.rank]), .bytes = raw });
+                } else {
+                    const cut = try ranks.extractSpanAlloc(sa, raw, rs.spans[pi - 1]);
+                    if (cut.len % e.dtype.size() != 0) return error.BadHy4PackSpan;
+                    try list.append(sa, .{ .name = name, .dtype = e.dtype, .shape = try sa.dupe(usize, &.{cut.len / e.dtype.size()}), .bytes = cut });
+                    var dims: std.json.Array = .init(pa);
+                    for (e.shape[0..e.rank]) |d| try dims.append(.{ .integer = @intCast(d) });
+                    try parts[pi].shapes.put(pa, try pa.dupe(u8, name), .{ .array = dims });
+                }
+                try parts[pi].weight_map.put(pa, try pa.dupe(u8, name), .{ .string = try pa.dupe(u8, out_shard) });
+            }
+            if (list.items.len == 0) continue;
+            const out_path = try std.fs.path.join(sa, &.{ o.out, part_names[pi], out_shard });
+            try std.Io.Dir.cwd().createDirPath(io, std.fs.path.dirname(out_path).?);
+            const meta = [_][2][]const u8{ .{ "format", "pt" }, .{ pack_parts.part_key, part_names[pi] }, .{ pack_parts.source_key, &src.hash_hex } };
+            try core.shard_edit.create(gpa, out_path, &meta, list.items);
+            const fh = try hashFile(gpa, io, out_path);
+            var fo: ObjectMap = .empty;
+            try fo.put(pa, "bytes", .{ .integer = @intCast(fh.bytes) });
+            try fo.put(pa, "sha256", .{ .string = try pa.dupe(u8, &fh.hex) });
+            try parts[pi].files.put(pa, try pa.dupe(u8, out_shard), .{ .object = fo });
+            parts[pi].total += fh.bytes;
+            stats.tensors[pi] += list.items.len;
+            stats.bytes[pi] += fh.bytes;
+        };
+        file.release(gpa);
+    }
+
+    for (0..1 + world) |pi| if (want[pi]) try writeIndex(gpa, io, o, &src, &parts, pi);
+    try copyAux(gpa, io, o.src, o.out, src.index_name, want);
+    return stats;
+}
+
+fn writeIndex(gpa: std.mem.Allocator, io: std.Io, o: Options, src: *const Source, all_parts: *[1 + world]Part, pi: usize) !void {
+    const p = &all_parts[pi];
+    const a = p.arena.allocator();
+    var mk: ObjectMap = .empty;
+    try mk.put(a, "part", .{ .string = if (pi == 0) "common" else "rank" });
+    if (pi > 0) try mk.put(a, "rank", .{ .integer = @intCast(pi - 1) });
+    try mk.put(a, "world", .{ .integer = world });
+    try mk.put(a, pack_parts.source_id_key, .{ .string = &src.hash_hex });
+    try mk.put(a, "source_index_sha256", .{ .string = &src.index_hex });
+    try mk.put(a, "source_index", .{ .string = src.index_name });
+    if (src.trunk_recipe) |tr| try mk.put(a, "trunk", .{ .string = tr });
+    if (src.target_head_recipe) |th| try mk.put(a, "target_head", .{ .string = th });
+    if (src.trunk_tag.len != 0) try mk.put(a, "trunk_tag", .{ .string = src.trunk_tag });
+    if (o.layers) |ls| {
+        var arr: std.json.Array = .init(a);
+        for (ls) |l| try arr.append(.{ .integer = @intCast(l) });
+        try mk.put(a, "layers", .{ .array = arr });
+    } else try mk.put(a, "layers", .{ .string = "all" });
+    var meta: ObjectMap = .empty;
+    try meta.put(a, "total_size", .{ .integer = @intCast(p.total) });
+    try meta.put(a, pack_parts.index_key, .{ .object = mk });
+    if (pi == 0 and src.matrices.len != 0) {
+        var mats: ObjectMap = .empty;
+        var kbuf: [224]u8 = undefined;
+        for (src.matrices) |m| {
+            const tr_name = std.fmt.bufPrint(&kbuf, "{s}.trellis", .{m.prefix}) catch continue;
+            if (o.layers != null) {
+                var exported = false;
+                for (all_parts) |*ap| if (ap.weight_map.contains(tr_name)) { exported = true; break; };
+                if (!exported) continue;
+            }
+            var mo: ObjectMap = .empty;
+            try mo.put(a, "k2", .{ .integer = m.k2 });
+            try mats.put(a, m.prefix, .{ .object = mo });
+        }
+        if (mats.count() != 0) try meta.put(a, "matrices", .{ .object = mats });
+    }
+    var root: ObjectMap = .empty;
+    try root.put(a, "metadata", .{ .object = meta });
+    try root.put(a, "weight_map", .{ .object = p.weight_map });
+    if (pi > 0) try root.put(a, "shapes", .{ .object = p.shapes });
+    try root.put(a, "files", .{ .object = p.files });
+    const text = try std.json.Stringify.valueAlloc(a, Value{ .object = root }, .{ .whitespace = .indent_1 });
+    const path = try std.fs.path.join(gpa, &.{ o.out, part_names[pi], if (pi == 0) pack_parts.common_index else pack_parts.rank_index });
+    defer gpa.free(path);
+    try std.Io.Dir.cwd().createDirPath(io, std.fs.path.dirname(path).?);
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = path, .data = text });
+}
+
+/// config.json, tokenizer and template files (everything small that is not a shard or the index) into `common/`;
+/// config.json also into each rank part, so opening a rank folder as the model gets a plain refusal.
+fn copyAux(gpa: std.mem.Allocator, io: std.Io, src: []const u8, out: []const u8, index_name: []const u8, want: [1 + world]bool) !void {
+    var d = try std.Io.Dir.cwd().openDir(io, src, .{ .iterate = true });
+    defer d.close(io);
+    var it = d.iterate();
+    while (try it.next(io)) |e| {
+        if ((e.kind != .file and e.kind != .sym_link) or std.mem.endsWith(u8, e.name, ".safetensors") or std.mem.eql(u8, e.name, index_name) or
+            std.mem.eql(u8, e.name, pack_parts.common_index) or std.mem.eql(u8, e.name, pack_parts.rank_index) or
+            std.mem.eql(u8, e.name, "trunk.index.json")) continue;
+        const from = try std.fs.path.join(gpa, &.{ src, e.name });
+        defer gpa.free(from);
+        const bytes = std.Io.Dir.cwd().readFileAlloc(io, from, gpa, .limited(64 << 20)) catch continue;
+        defer gpa.free(bytes);
+        for (part_names, want, 0..) |pn, w, pi| if (w and (pi == 0 or std.mem.eql(u8, e.name, "config.json"))) {
+            const to = try std.fs.path.join(gpa, &.{ out, pn, e.name });
+            defer gpa.free(to);
+            try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = to, .data = bytes });
+        };
+    }
+}
+
+fn hashFile(gpa: std.mem.Allocator, io: std.Io, path: []const u8) !struct { bytes: u64, hex: [64]u8 } {
+    var f = try st.File.open(gpa, io, path);
+    defer f.close(io);
+    var digest: [32]u8 = undefined;
+    Sha256.hash(f.map.memory, &digest, .{});
+    f.release(gpa);
+    return .{ .bytes = f.map.memory.len, .hex = std.fmt.bytesToHex(digest, .lower) };
+}
+
+pub const CheckStats = struct { files: usize = 0, bytes: u64 = 0, tensors_compared: usize = 0, failures: usize = 0 };
+
+const ReadPart = struct { dir: []const u8, root: Value, files: std.StringHashMapUnmanaged(st.File) = .empty };
+
+/// Re-reads a pack root: every part file against its index hash and part marker; with `src_dir`, every tensor
+/// against the span of the source it was cut from. Prints each failure and returns error.Hy4PackCheckFailed.
+pub fn checkPack(gpa: std.mem.Allocator, io: std.Io, root_dir: []const u8, src_dir: ?[]const u8) !CheckStats {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var stats: CheckStats = .{};
+    var parts: [1 + world]?ReadPart = @splat(null);
+    defer for (&parts) |*rp| if (rp.*) |*p| {
+        var it = p.files.valueIterator();
+        while (it.next()) |f| f.close(io);
+        p.files.deinit(a);
+    };
+    var source: []const u8 = "";
+    var rec_trunk: ?[]const u8 = null;
+    var rec_head: ?[]const u8 = null;
+    var layers: ?Value = null;
+    for (0..1 + world) |pi| {
+        const dir = try std.fs.path.join(a, &.{ root_dir, part_names[pi] });
+        const ipath = try std.fs.path.join(a, &.{ dir, if (pi == 0) pack_parts.common_index else pack_parts.rank_index });
+        const bytes = std.Io.Dir.cwd().readFileAlloc(io, ipath, a, .limited(256 << 20)) catch |err| switch (err) {
+            error.FileNotFound => if (pi == 0) return error.Hy4PackHasNoCommon else continue,
+            else => return err,
+        };
+        const root = try std.json.parseFromSliceLeaky(Value, a, bytes, .{});
+        const mk = pack_parts.marker(root) orelse return error.BadHy4Pack;
+        const src_hex = pack_parts.str(mk.get(pack_parts.source_id_key)) orelse "";
+        const m_trunk = pack_parts.str(mk.get("trunk"));
+        const m_head = pack_parts.str(mk.get("target_head"));
+        if (pi == 0) {
+            source = src_hex;
+            rec_trunk = m_trunk;
+            rec_head = m_head;
+            layers = mk.get("layers");
+        } else if (!std.mem.eql(u8, src_hex, source) or (pack_parts.int(mk.get("rank")) orelse world) != pi - 1 or
+            !std.mem.eql(u8, m_trunk orelse "lossless", rec_trunk orelse "lossless") or
+            !std.mem.eql(u8, m_head orelse "fp32", rec_head orelse "fp32"))
+        {
+            std.debug.print("FAIL {s}: index says rank {?d}, source {s}, trunk {s}; common/ says source {s}, trunk {s}\n", .{
+                part_names[pi], pack_parts.int(mk.get("rank")), src_hex, m_trunk orelse "lossless", source, rec_trunk orelse "lossless",
+            });
+            stats.failures += 1;
+        }
+        parts[pi] = .{ .dir = dir, .root = root };
+        const files = pack_parts.obj(root.object.get("files")) orelse return error.BadHy4Pack;
+        var fit = files.iterator();
+        while (fit.next()) |kv| {
+            const fpath = try std.fs.path.join(a, &.{ dir, kv.key_ptr.* });
+            const want_hex = pack_parts.str((pack_parts.obj(kv.value_ptr.*) orelse return error.BadHy4Pack).get("sha256")) orelse "";
+            const fh = try hashFile(gpa, io, fpath);
+            stats.files += 1;
+            stats.bytes += fh.bytes;
+            if (!std.mem.eql(u8, &fh.hex, want_hex)) {
+                std.debug.print("FAIL {s}/{s}: sha256 {s} but its index records {s} (changed after export)\n", .{ part_names[pi], kv.key_ptr.*, &fh.hex, want_hex });
+                stats.failures += 1;
+            }
+            var f = try st.File.openPrefixes(gpa, io, fpath, &.{ "model.", "lm_head." });
+            errdefer f.close(io);
+            const head = f.map.memory[8..f.data];
+            if (!std.mem.eql(u8, pack_parts.metaValue(head, pack_parts.part_key) orelse "", part_names[pi]) or
+                !std.mem.eql(u8, pack_parts.metaValue(head, pack_parts.source_key) orelse "", source))
+            {
+                std.debug.print("FAIL {s}/{s}: file marker does not say {s} from source {s}\n", .{ part_names[pi], kv.key_ptr.*, part_names[pi], source });
+                stats.failures += 1;
+            }
+            try parts[pi].?.files.put(a, kv.key_ptr.*, f);
+        }
+    }
+    if (src_dir) |sd| try compareWithSource(gpa, io, a, sd, source, rec_trunk, rec_head, layers, &parts, &stats);
+    std.debug.print("hy4 pack check {s}: files={d} bytes={d} tensors_compared={d} failures={d}\n", .{ root_dir, stats.files, stats.bytes, stats.tensors_compared, stats.failures });
+    if (stats.failures != 0) return error.Hy4PackCheckFailed;
+    return stats;
+}
+
+fn compareWithSource(gpa: std.mem.Allocator, io: std.Io, a: std.mem.Allocator, sd: []const u8, source: []const u8, rec_trunk: ?[]const u8, rec_head: ?[]const u8, layers_v: ?Value, parts: *[1 + world]?ReadPart, stats: *CheckStats) !void {
+    var src = try Source.open(gpa, io, sd, rec_trunk, rec_head);
+    defer src.deinit();
+    if (!std.mem.eql(u8, &src.hash_hex, source)) {
+        std.debug.print("FAIL source {s}: index sha256 {s}, pack was cut from {s}\n", .{ sd, &src.hash_hex, source });
+        stats.failures += 1;
+        return;
+    }
+    var layer_list: std.ArrayList(usize) = .empty;
+    if (layers_v) |lv| if (lv == .array) for (lv.array.items) |x| try layer_list.append(a, pack_parts.int(x) orelse return error.BadHy4Pack);
+    const layers: ?[]const usize = if (layers_v != null and layers_v.? == .array) layer_list.items else null;
+    const t = src.cfg.value.text_config;
+    for (src.shards) |shard| {
+        const path = if (std.fs.path.isAbsolute(shard)) try gpa.dupe(u8, shard) else try std.fs.path.join(gpa, &.{ sd, shard });
+        defer gpa.free(path);
+        var file = try st.File.openPrefixes(gpa, io, path, &.{ "model.", "lm_head." });
+        defer file.close(io);
+        for (file.names.keys(), file.names.values()) |name, e| {
+            if (!src.takes(name, shard, layers)) continue;
+            const rs = try rankSpans(&file, name, e, t);
+            const raw = file.map.memory[file.data + e.begin .. file.data + e.end];
+            for (0..1 + world) |pi| {
+                const p = &(parts[pi] orelse continue);
+                if (rs.whole != (pi == 0)) continue;
+                const wm = try st.index.weightMap(p.root);
+                const fname = (wm.get(name) orelse {
+                    std.debug.print("FAIL {s}: {s} is missing\n", .{ part_names[pi], name });
+                    stats.failures += 1;
+                    continue;
+                }).string;
+                const pf = p.files.getPtr(fname) orelse return error.BadHy4Pack;
+                const got = pf.get(name) orelse return error.BadHy4Pack;
+                var scratch = std.heap.ArenaAllocator.init(gpa);
+                defer scratch.deinit();
+                const expect = if (pi == 0) raw else try ranks.extractSpanAlloc(scratch.allocator(), raw, rs.spans[pi - 1]);
+                if (!std.mem.eql(u8, got.bytes, expect) or got.dtype != e.dtype) {
+                    std.debug.print("FAIL {s}/{s}: tensor {s} differs from its source span\n", .{ part_names[pi], fname, name });
+                    stats.failures += 1;
+                }
+                stats.tensors_compared += 1;
+            }
+        }
+        file.release(gpa);
+    }
+}
+
+/// `tf-hy4-oracle --export-rank-pack SRC --out DIR [--trunk PROF] [--target-head 6b|4b|PATH] [--ranks 0,1,2,3] [--layers L,..] [--no-common]`
+/// and `tf-hy4-oracle --check-rank-pack ROOT [--source SRC]`; returns false when neither mode was asked for.
+pub fn runCli(gpa: std.mem.Allocator, io: std.Io, args: anytype) !bool {
+    var export_src: ?[]const u8 = null;
+    var check_root: ?[]const u8 = null;
+    var o: Options = .{ .src = "", .out = "" };
+    var source: ?[]const u8 = null;
+    var layer_buf: [128]usize = undefined;
+    var i: usize = 1;
+    while (i < args.len) : (i += 1) {
+        const arg: []const u8 = args[i];
+        if (std.mem.eql(u8, arg, "--no-common")) { o.common = false; continue; }
+        if (i + 1 >= args.len) break;
+        const val: []const u8 = args[i + 1];
+        if (std.mem.eql(u8, arg, "--export-rank-pack")) export_src = val
+        else if (std.mem.eql(u8, arg, "--check-rank-pack")) check_root = val
+        else if (std.mem.eql(u8, arg, "--out")) o.out = val
+        else if (std.mem.eql(u8, arg, "--source")) source = val
+        else if (std.mem.eql(u8, arg, "--trunk")) o.trunk = val
+        else if (std.mem.eql(u8, arg, "--target-head")) o.target_head = val
+        else if (std.mem.eql(u8, arg, "--ranks")) {
+            o.ranks = @splat(false);
+            var it = std.mem.tokenizeScalar(u8, val, ',');
+            while (it.next()) |r| o.ranks[try std.fmt.parseInt(usize, r, 10)] = true;
+        } else if (std.mem.eql(u8, arg, "--layers")) {
+            var n: usize = 0;
+            var it = std.mem.tokenizeScalar(u8, val, ',');
+            while (it.next()) |l| : (n += 1) layer_buf[n] = try std.fmt.parseInt(usize, l, 10);
+            o.layers = layer_buf[0..n];
+        } else continue;
+        i += 1;
+    }
+    const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    if (export_src) |s| {
+        if (o.out.len == 0) return error.BadArgs;
+        o.src = s;
+        const stats = try exportPack(gpa, io, o);
+        const ms = @divTrunc(std.Io.Clock.awake.now(io).toNanoseconds() - t0, std.time.ns_per_ms);
+        for (part_names, 0..) |pn, pi| if (stats.tensors[pi] > 0)
+            std.debug.print("hy4 rank pack {s}/{s}: tensors={d} bytes={d}\n", .{ o.out, pn, stats.tensors[pi], stats.bytes[pi] });
+        std.debug.print("hy4 rank pack export done in {d} ms\n", .{ms});
+        return true;
+    }
+    if (check_root) |r| {
+        _ = try checkPack(gpa, io, r, source);
+        return true;
+    }
+    return false;
+}
diff --git a/zig/src/families/hy4/pack_parts.zig b/zig/src/families/hy4/pack_parts.zig
new file mode 100644
index 0000000000000000000000000000000000000000..a354e0001c08e2f4c253b20e5382f9a9c9f8a40a
--- /dev/null
+++ b/zig/src/families/hy4/pack_parts.zig
@@ -0,0 +1,290 @@
+//! Per-rank weight files for TP=4 Full Hy4: a `common/` part (every tensor all four ranks read whole, written once)
+//! and `rank<R>/` parts (rank R's bytes of each tensor the loader reads sliced). `pack_export.zig` cuts the parts
+//! with `ranks.tensorSpan`, so a sliced tensor's file bytes are exactly the span the loader would have read from
+//! the full pack and loading needs no reassembly. Point `--model` at `common/`; every `rank<R>/` beside it is added.
+//! Refused with a plain message: a part for another rank, a part cut from a different source pack, and a mix of
+//! full-pack files and part files.
+const std = @import("std");
+const core = @import("core");
+const ranks = @import("ranks.zig");
+const boundary = @import("boundary.zig");
+const trunk_exl3 = @import("trunk_exl3.zig");
+const overlay = @import("trunk_exl3_overlay.zig");
+
+const st = core.safetensors;
+
+/// Key of the part marker object inside an index's `metadata`.
+pub const index_key = "tf_hy4_pack";
+/// Safetensors `__metadata__` keys every part file carries: `common` or `rank<R>`, and the source pack hash.
+pub const part_key = "tf_hy4_part";
+pub const source_key = "tf_hy4_source";
+/// Marker key of the source pack's identity: SHA-256 of its index plus each shard's name, size, header and the
+/// first and last 64 KiB of its payload (`pack_export.Source`); every part and part file must carry the same one.
+pub const source_id_key = "source_pack_sha256";
+pub const common_index = "model.safetensors.index.json";
+pub const rank_index = "index.json";
+
+/// A tensor stored sliced: its full shape (what the loader checks) and, per rank present, the file holding its span.
+pub const Sliced = struct { rank: u8, shape: [st.max_rank]usize, rels: [ranks.world]?[]const u8 = @splat(null) };
+
+pub const Pack = struct {
+    source: []const u8,
+    trunk: []const u8 = "lossless",
+    target_head: []const u8 = "fp32",
+    present: [ranks.world]bool = @splat(false),
+    sliced: std.StringHashMapUnmanaged(Sliced) = .empty,
+
+    pub fn isSliced(self: *const Pack, name: []const u8) bool {
+        return self.sliced.contains(name);
+    }
+
+    /// The file a session of `rank` reads `name` from: common tensors keep `rel`, a sliced one needs this rank's part.
+    pub fn relFor(self: *const Pack, name: []const u8, rel: []const u8, rank: ?ranks.Rank) ![]const u8 {
+        const s = self.sliced.get(name) orelse return rel;
+        const r = rank orelse return refuse("{s} is stored per rank; a per-rank pack loads only with --tp 4, one rank per process", .{name}, error.Hy4RankPartNeedsTp4);
+        const ri: usize = @intFromEnum(r);
+        var buf: [32]u8 = undefined;
+        return s.rels[ri] orelse return refuse("no part for rank {d} beside common/ (parts found: {s}); this process is rank {d} and refuses another rank's part", .{ ri, self.presentList(&buf), ri }, error.Hy4RankPartMissing);
+    }
+
+    /// `t` as the loader sees it: a sliced tensor keeps its file bytes (the rank's span) under its full shape.
+    pub fn fullView(self: *const Pack, name: []const u8, t: st.Tensor) st.Tensor {
+        const s = self.sliced.get(name) orelse return t;
+        return .{ .dtype = t.dtype, .rank = s.rank, .shape = s.shape, .bytes = t.bytes };
+    }
+
+    fn presentList(self: *const Pack, buf: []u8) []const u8 {
+        var n: usize = 0;
+        for (self.present, 0..) |p, ri| if (p and n + 7 <= buf.len) {
+            n += (std.fmt.bufPrint(buf[n..], "{s}rank{d}", .{ if (n == 0) "" else " ", ri }) catch break).len;
+        };
+        return if (n == 0) "none" else buf[0..n];
+    }
+
+    fn addRank(self: *Pack, a: std.mem.Allocator, gpa: std.mem.Allocator, io: std.Io, dir: []const u8, ri: usize, weight_map: *std.StringHashMapUnmanaged([]const u8)) !void {
+        const sub = try std.fmt.allocPrint(a, "../rank{d}", .{ri});
+        const path = try std.fs.path.join(gpa, &.{ dir, sub, rank_index });
+        defer gpa.free(path);
+        const bytes = std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(256 << 20)) catch |err| switch (err) {
+            error.FileNotFound => return,
+            else => return err,
+        };
+        defer gpa.free(bytes);
+        const root = try std.json.parseFromSliceLeaky(std.json.Value, a, bytes, .{});
+        const m = marker(root) orelse return refuse("rank{d}/ has an index without a {s} marker", .{ ri, index_key }, error.Hy4PackMix);
+        if (!std.mem.eql(u8, str(m.get("part")) orelse "", "rank") or (int(m.get("rank")) orelse ranks.world) != ri)
+            return refuse("rank{d}/ does not hold the part for rank {d} (its index says part={s} rank={?d})", .{ ri, ri, str(m.get("part")) orelse "?", int(m.get("rank")) }, error.Hy4RankPartMismatch);
+        try checkWorld(m);
+        const src = str(m.get(source_id_key)) orelse "";
+        if (!std.mem.eql(u8, src, self.source))
+            return refuse("rank{d}/ was cut from a different source pack (source pack sha256 {s}) than common/ ({s})", .{ ri, src, self.source }, error.Hy4PackSourceMismatch);
+        const r_trunk = str(m.get("trunk")) orelse "lossless";
+        const r_head = str(m.get("target_head")) orelse "fp32";
+        if (!std.mem.eql(u8, r_trunk, self.trunk) or !std.mem.eql(u8, r_head, self.target_head))
+            return refuse("rank{d}/ was cut with trunk='{s}' target-head='{s}', while common/ has trunk='{s}' target-head='{s}'", .{ ri, r_trunk, r_head, self.trunk, self.target_head }, error.Hy4PackTrunkMismatch);
+        const shapes = obj(root.object.get("shapes")) orelse return refuse("rank{d}/ index has no shapes", .{ri}, error.BadHy4Pack);
+        const map = try st.index.weightMap(root);
+        var it = map.iterator();
+        while (it.next()) |kv| {
+            const name = kv.key_ptr.*;
+            const rel = try std.fs.path.join(a, &.{ sub, kv.value_ptr.string });
+            const gop = try self.sliced.getOrPut(a, name);
+            if (!gop.found_existing) {
+                if (weight_map.contains(name)) return refuse("{s} is both in common/ and in rank{d}/", .{ name, ri }, error.Hy4PackMix);
+                gop.value_ptr.* = .{ .rank = 0, .shape = @splat(1) };
+                const dims = shapes.get(name) orelse return refuse("rank{d}/ index has no shape for {s}", .{ ri, name }, error.BadHy4Pack);
+                if (dims != .array or dims.array.items.len > st.max_rank) return error.BadHy4Pack;
+                gop.value_ptr.rank = @intCast(dims.array.items.len);
+                for (dims.array.items, 0..) |d, j| gop.value_ptr.shape[j] = int(d) orelse return error.BadHy4Pack;
+                try weight_map.put(a, name, rel);
+            }
+            gop.value_ptr.rels[ri] = rel;
+        }
+        self.present[ri] = true;
+    }
+};
+
+fn canonProfileToken(raw: []const u8) []const u8 {
+    if (overlay.isLosslessToken(raw)) return "bf16";
+    if (std.mem.startsWith(u8, raw, "trunk-") and raw.len > 6) return raw[6..];
+    return raw;
+}
+
+fn canonSelector(sel: []const u8) []const u8 {
+    if (std.mem.eql(u8, sel, "q_a") or std.mem.eql(u8, sel, "q_a_proj") or std.mem.eql(u8, sel, "self_attn.q_a_proj")) return "q_a";
+    if (std.mem.eql(u8, sel, "q_b") or std.mem.eql(u8, sel, "q_b_proj") or std.mem.eql(u8, sel, "self_attn.q_b_proj")) return "q_b";
+    if (std.mem.eql(u8, sel, "kv_a") or std.mem.eql(u8, sel, "kv_a_proj_with_mqa") or std.mem.eql(u8, sel, "self_attn.kv_a_proj_with_mqa")) return "kv_a";
+    if (std.mem.eql(u8, sel, "linear_gate") or std.mem.eql(u8, sel, "self_attn.linear_gate")) return "linear_gate";
+    if (std.mem.eql(u8, sel, "o") or std.mem.eql(u8, sel, "o_proj") or std.mem.eql(u8, sel, "self_attn.o_proj")) return "o_proj";
+    if (std.mem.eql(u8, sel, "shared") or std.mem.eql(u8, sel, "shared_experts")) return "shared";
+    if (std.mem.eql(u8, sel, "shared.gate") or std.mem.eql(u8, sel, "shared_experts.gate_proj") or std.mem.eql(u8, sel, "mlp.shared_experts.gate_proj")) return "shared.gate";
+    if (std.mem.eql(u8, sel, "shared.up") or std.mem.eql(u8, sel, "shared_experts.up_proj") or std.mem.eql(u8, sel, "mlp.shared_experts.up_proj")) return "shared.up";
+    if (std.mem.eql(u8, sel, "shared.down") or std.mem.eql(u8, sel, "shared_experts.down_proj") or std.mem.eql(u8, sel, "mlp.shared_experts.down_proj")) return "shared.down";
+    if (std.mem.eql(u8, sel, "dense.gate") or std.mem.eql(u8, sel, "mlp.gate_proj")) return "dense.gate";
+    if (std.mem.eql(u8, sel, "dense.up") or std.mem.eql(u8, sel, "mlp.up_proj")) return "dense.up";
+    if (std.mem.eql(u8, sel, "dense.down") or std.mem.eql(u8, sel, "mlp.down_proj")) return "dense.down";
+    return sel;
+}
+
+/// Canonicalizes an explicit `--trunk` / `TF_HY4_TRUNK` string (`null` when lossless/auto).
+pub fn canonicalTrunkRecipe(gpa: std.mem.Allocator, raw_opt: ?[]const u8) !?[]u8 {
+    const raw = raw_opt orelse return null;
+    const trimmed = std.mem.trim(u8, raw, " \t\r\n");
+    if (trimmed.len == 0 or std.ascii.eqlIgnoreCase(trimmed, "auto") or overlay.isLosslessToken(trimmed)) return null;
+    const expanded = overlay.expandPreset(trimmed);
+    if (std.mem.indexOfScalar(u8, expanded, ',') == null and std.mem.indexOfScalar(u8, expanded, '=') == null) {
+        const tok = canonProfileToken(expanded);
+        return if (std.mem.eql(u8, tok, "bf16")) null else try gpa.dupe(u8, tok);
+    }
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(gpa);
+    var it = std.mem.splitScalar(u8, expanded, ',');
+    var first = true;
+    while (it.next()) |raw_part| {
+        const part = std.mem.trim(u8, raw_part, " \t");
+        if (part.len == 0) return error.InvalidHy4TrunkRecipe;
+        if (first and std.mem.indexOfScalar(u8, part, '=') == null) {
+            try out.appendSlice(gpa, canonProfileToken(part));
+            first = false;
+            continue;
+        }
+        if (!first) try out.append(gpa, ',');
+        first = false;
+        const eq = std.mem.indexOfScalar(u8, part, '=') orelse return error.InvalidHy4TrunkRecipe;
+        const sel = std.mem.trim(u8, part[0..eq], " \t");
+        const tgt = std.mem.trim(u8, part[eq + 1 ..], " \t");
+        if (sel.len == 0 or tgt.len == 0) return error.InvalidHy4TrunkRecipe;
+        try overlay.validateSelector(sel);
+        try out.print(gpa, "{s}={s}", .{ canonSelector(sel), canonProfileToken(tgt) });
+    }
+    return try out.toOwnedSlice(gpa);
+}
+
+/// Verifies that `spec` and `explicit_target_head` / `TF_HY4_TARGET_HEAD` agree with the recipe recorded in `pack`.
+pub fn verifyPackTrunk(self: *const Pack, gpa: std.mem.Allocator, spec: overlay.TrunkSpec, explicit_target_head: ?[]const u8) !void {
+    switch (spec) {
+        .auto => {},
+        .force_bf16 => {
+            if (!std.mem.eql(u8, self.trunk, "lossless"))
+                return refuse("per-rank pack was cut with trunk '{s}', cannot load with trunk 'lossless' (unset TF_HY4_TRUNK / --trunk or re-export the pack)", .{self.trunk}, error.Hy4PackTrunkMismatch);
+        },
+        .profile => |raw_prof| {
+            const want_opt = try canonicalTrunkRecipe(gpa, raw_prof);
+            defer if (want_opt) |w| gpa.free(w);
+            const want = want_opt orelse "lossless";
+            if (!std.mem.eql(u8, self.trunk, want))
+                return refuse("per-rank pack was cut with trunk '{s}', cannot load with trunk '{s}' (unset TF_HY4_TRUNK / --trunk or re-export the pack)", .{ self.trunk, raw_prof }, error.Hy4PackTrunkMismatch);
+        },
+    }
+    if (explicit_target_head orelse boundary.envStr("TF_HY4_TARGET_HEAD")) |raw_h| {
+        const th = std.mem.trim(u8, raw_h, " \t\r\n");
+        if (th.len != 0 and !std.ascii.eqlIgnoreCase(th, "auto")) {
+            const want_h = try trunk_exl3.canonicalTargetHeadSpec(th);
+            if (!std.mem.eql(u8, self.target_head, want_h))
+                return refuse("per-rank pack was cut with target-head '{s}', cannot load with target-head '{s}' (unset TF_HY4_TARGET_HEAD / --target-head or re-export the pack)", .{ self.target_head, th }, error.Hy4PackTrunkMismatch);
+        }
+    }
+}
+
+/// Reads an index's part marker: null for a full pack; refuses a rank index opened as the model folder; for a
+/// `common` index, adds every `rank<R>/` beside `dir` to `weight_map` and records each sliced tensor's full shape.
+pub fn attach(
+    a: std.mem.Allocator,
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    root: std.json.Value,
+    dir: []const u8,
+    weight_map: *std.StringHashMapUnmanaged([]const u8),
+    trunk_k2: *std.StringHashMapUnmanaged(u8),
+    trunk_tag: *[]const u8,
+) !?Pack {
+    const m = marker(root) orelse return null;
+    const kind = str(m.get("part")) orelse "";
+    if (std.mem.eql(u8, kind, "rank"))
+        return refuse("{s} holds one rank's part; point --model at the common/ folder beside it", .{dir}, error.Hy4RankPartAsModel);
+    if (!std.mem.eql(u8, kind, "common")) return refuse("{s}: unknown part kind '{s}'", .{ dir, kind }, error.BadHy4Pack);
+    try checkWorld(m);
+    var pack: Pack = .{
+        .source = try a.dupe(u8, str(m.get(source_id_key)) orelse return error.BadHy4Pack),
+        .trunk = try a.dupe(u8, str(m.get("trunk")) orelse "lossless"),
+        .target_head = try a.dupe(u8, str(m.get("target_head")) orelse "fp32"),
+    };
+    if (str(m.get("trunk_tag"))) |tt| if (tt.len != 0) {
+        trunk_tag.* = try a.dupe(u8, tt);
+    };
+    if (obj(if (root == .object) root.object.get("metadata") else null)) |meta| {
+        if (obj(meta.get("matrices"))) |mats| {
+            var mit = mats.iterator();
+            while (mit.next()) |mkv| if (obj(mkv.value_ptr.*)) |mo| if (int(mo.get("k2"))) |k2| {
+                if (k2 == 0 or k2 > 16) return error.TrunkBitWidthMismatch;
+                try trunk_k2.put(a, try a.dupe(u8, mkv.key_ptr.*), @intCast(k2));
+            };
+        }
+    }
+    for (0..ranks.world) |ri| try pack.addRank(a, gpa, io, dir, ri, weight_map);
+    if (std.mem.indexOfScalar(bool, &pack.present, true) == null)
+        return refuse("no rank<R>/ part beside {s}; copy your rank's folder next to common/", .{dir}, error.Hy4RankPartMissing);
+    return pack;
+}
+
+/// Checks a just-opened shard against the pack it was reached from (`null` = a full pack) by its `__metadata__`.
+pub fn checkFile(pack: ?*const Pack, file: *const st.File, rel: []const u8) !void {
+    const head = file.map.memory[8..file.data];
+    const part = metaValue(head, part_key);
+    const p = pack orelse {
+        if (part != null) return refuse("{s} is a per-rank part file ({s}) but --model is a full pack; do not mix the two", .{ rel, part.? }, error.Hy4PackMix);
+        return;
+    };
+    const got = part orelse return refuse("{s} is a full-pack file inside a per-rank pack; do not mix the two", .{rel}, error.Hy4PackMix);
+    const src = metaValue(head, source_key) orelse "";
+    if (!std.mem.eql(u8, src, p.source))
+        return refuse("{s} was cut from a different source pack (source pack sha256 {s}) than common/ ({s})", .{ rel, src, p.source }, error.Hy4PackSourceMismatch);
+    const want: []const u8 = if (std.mem.startsWith(u8, rel, "../rank") and rel.len > 8) rel[3..8] else "common";
+    if (!std.mem.eql(u8, got, want)) return refuse("{s} holds the {s} part, not {s}", .{ rel, got, want }, error.Hy4RankPartMismatch);
+}
+
+/// A string value of `__metadata__` in a safetensors header (compact JSON written by `shard_edit.create`).
+pub fn metaValue(head: []const u8, key: []const u8) ?[]const u8 {
+    var buf: [64]u8 = undefined;
+    const quoted = std.fmt.bufPrint(&buf, "\"{s}\"", .{key}) catch return null;
+    var at = (std.mem.indexOf(u8, head, quoted) orelse return null) + quoted.len;
+    while (at < head.len and (head[at] == ' ' or head[at] == ':')) at += 1;
+    if (at >= head.len or head[at] != '"') return null;
+    const end = std.mem.indexOfScalarPos(u8, head, at + 1, '"') orelse return null;
+    return head[at + 1 .. end];
+}
+
+pub fn marker(root: std.json.Value) ?std.json.ObjectMap {
+    const meta = obj(if (root == .object) root.object.get("metadata") else null) orelse return null;
+    return obj(meta.get(index_key));
+}
+
+fn checkWorld(m: std.json.ObjectMap) !void {
+    if ((int(m.get("world")) orelse 0) != ranks.world) return refuse("part was cut for world {?d}; this engine runs world {d}", .{ int(m.get("world")), ranks.world }, error.Hy4RankPartMismatch);
+}
+
+pub var last_refusal_buf: [320]u8 = undefined;
+pub var last_refusal_len: usize = 0;
+pub fn lastRefusal() []const u8 { return last_refusal_buf[0..last_refusal_len]; }
+
+fn refuse(comptime fmt: []const u8, args: anytype, err: anyerror) anyerror {
+    const msg = std.fmt.bufPrint(&last_refusal_buf, "hy4 pack: " ++ fmt, args) catch "hy4 pack: refused";
+    last_refusal_len = msg.len;
+    if (!@import("builtin").is_test) std.log.err("{s}", .{msg});
+    return err;
+}
+
+pub fn str(v: ?std.json.Value) ?[]const u8 {
+    const x = v orelse return null;
+    return if (x == .string) x.string else null;
+}
+
+pub fn obj(v: ?std.json.Value) ?std.json.ObjectMap {
+    const x = v orelse return null;
+    return if (x == .object) x.object else null;
+}
+
+pub fn int(v: ?std.json.Value) ?usize {
+    const x = v orelse return null;
+    return if (x == .integer) std.math.cast(usize, x.integer) else null;
+}
diff --git a/zig/src/families/hy4/pack_test.zig b/zig/src/families/hy4/pack_test.zig
