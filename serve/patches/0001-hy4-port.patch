@@ -0,0 +1,597 @@
+//! Four-rank process session (`TpSession`) for Full Hy4 (`hy_v4_vl` / `hy_v4`) over `cuda.hy4_tp.Boundary`.
+//!
+//! Coordinates bounded TCP bootstrap (`tp.Bootstrap`), executable SHA-256 + NCCL version agreement via
+//! `Boundary.join`, fail-closed checkpoint pack + run-settings agreement (`error.Hy4PackMismatch`),
+//! device gather-and-fold (`Boundary.gatherFold`), async transport check (`Boundary.finish`), vocabulary
+//! stripe reassembly, and `PlanLink` round replication for `tensorfold-native serve --tp 4`.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const tp = @import("tp");
+const weights = @import("weights.zig");
+
+const htp = cuda.hy4_tp;
+const st = core.safetensors;
+
+pub fn envStr(name: [:0]const u8) ?[]const u8 {
+    const raw = std.c.getenv(name.ptr) orelse return null;
+    const s = std.mem.span(raw);
+    return if (s.len > 0) s else null;
+}
+
+pub fn envUint(comptime T: type, name: [:0]const u8, default: T) !T {
+    const s = envStr(name) orelse return default;
+    return std.fmt.parseInt(T, s, 10);
+}
+
+pub fn envFlag(name: [:0]const u8) bool {
+    const s = envStr(name) orelse return false;
+    return std.mem.eql(u8, s, "1") or std.ascii.eqlIgnoreCase(s, "true");
+}
+
+pub const ConnectOptions = struct {
+    tp_world: usize = 1,
+    rank: usize = 0,
+    master: []const u8 = "127.0.0.1",
+    port: u16 = 29577,
+    timeout_s: u64 = 20,
+    load_timeout_s: u64 = 900,
+    require_ib: bool = false,
+    with_plan_link: bool = false,
+    plant_pack_mismatch_rank: ?usize = null,
+
+    pub fn fromEnv() !ConnectOptions {
+        const req_ib = if (envStr("TF_HY4_REQUIRE_IB")) |v| std.mem.eql(u8, v, "1") else false;
+        return .{
+            .tp_world = try envUint(usize, "WORLD_SIZE", 1),
+            .rank = try envUint(usize, "RANK", 0),
+            .master = envStr("MASTER_ADDR") orelse "127.0.0.1",
+            .port = try envUint(u16, "MASTER_PORT", 29577),
+            .timeout_s = try envUint(u64, "TF_HY4_TP_TIMEOUT_S", 20),
+            .load_timeout_s = try envUint(u64, "TF_HY4_LOAD_TIMEOUT_S", 900),
+            .require_ib = req_ib,
+        };
+    }
+};
+
+pub fn computePackDigest(gpa: std.mem.Allocator, io: std.Io, idx: *const weights.ShardIndex) ![32]u8 {
+    var unique: std.StringHashMapUnmanaged(void) = .empty;
+    defer unique.deinit(gpa);
+    var it = idx.weight_map.valueIterator();
+    // A per-rank pack agrees on common/ plus the source pack's index hash; each rank's own part differs by design.
+    while (it.next()) |rel_ptr| if (idx.pack == null or !std.mem.startsWith(u8, rel_ptr.*, "../rank")) try unique.put(gpa, rel_ptr.*, {});
+
+    const rels = try gpa.alloc([]const u8, unique.count());
+    defer gpa.free(rels);
+    var kit = unique.keyIterator();
+    var pos: usize = 0;
+    while (kit.next()) |k| : (pos += 1) rels[pos] = k.*;
+    std.mem.sort([]const u8, rels, {}, struct {
+        fn less(_: void, a: []const u8, b: []const u8) bool {
+            return std.mem.lessThan(u8, a, b);
+        }
+    }.less);
+
+    var sha = std.crypto.hash.sha2.Sha256.init(.{});
+    sha.update(&idx.cfg_sha256);
+    if (idx.pack) |*p| sha.update(p.source);
+    if (idx.trunk_tag.len != 0) {
+        sha.update(&.{0xff});
+        sha.update(idx.trunk_tag);
+    }
+    var count_le = std.mem.nativeToLittle(u64, idx.weight_map.count());
+    sha.update(std.mem.asBytes(&count_le));
+
+    for (rels) |rel| {
+        const path = try std.fs.path.join(gpa, &.{ idx.dir, rel });
+        defer gpa.free(path);
+        var f = try st.File.open(gpa, io, path);
+        defer f.close(io);
+        sha.update(rel);
+        sha.update(&.{0});
+        var flen = std.mem.nativeToLittle(u64, f.map.memory.len);
+        sha.update(std.mem.asBytes(&flen));
+        sha.update(f.map.memory[0..f.data]);
+        const payload = f.map.memory[f.data..];
+        const sample_n: usize = @min(payload.len, @as(usize, 65536));
+        sha.update(payload[0..sample_n]);
+        if (payload.len > sample_n) sha.update(payload[payload.len - sample_n ..]);
+    }
+    return sha.finalResult();
+}
+
+pub fn agreePackDigestOnBootstrap(b: *tp.Bootstrap, digest: *const [32]u8) !void {
+    b.agree(digest, "Hy4 checkpoint pack SHA-256") catch |err| {
+        if (err == error.Mismatch) return error.Hy4PackMismatch;
+        if (err == error.Timeout) return error.Hy4BootstrapTimeout;
+        return err;
+    };
+}
+
+pub fn interleaveVocabStripes(
+    all_ranks_bytes: []const []const u8,
+    rows: usize,
+    vocab_stride: usize,
+    vocab_full: usize,
+    out_full: []f32,
+) !void {
+    if (all_ranks_bytes.len != htp.world or out_full.len != rows * vocab_full) return error.BadHy4VocabGather;
+    const expect_bytes = rows * vocab_stride * 4;
+    for (all_ranks_bytes) |b| if (b.len != expect_bytes) return error.BadHy4VocabGather;
+
+    for (0..rows) |r| {
+        for (0..htp.world) |rk| {
+            const first = rk * vocab_stride;
+            if (first >= vocab_full) break;
+            const take: usize = @min(vocab_stride, vocab_full - first);
+            const src_bytes = all_ranks_bytes[rk][(r * vocab_stride) * 4 ..][0 .. take * 4];
+            @memcpy(std.mem.sliceAsBytes(out_full[r * vocab_full + first ..][0..take]), src_bytes);
+        }
+    }
+}
+
+pub const vocab_gather_chunk_cap: usize = 16384;
+
+pub fn gatherVocabOnBootstrap(
+    b: *tp.Bootstrap, gpa: std.mem.Allocator, local_f32: []const f32,
+    rows: usize, vocab_stride: usize, vocab_full: usize, out_full: []f32,
+) !void {
+    if (local_f32.len != rows * vocab_stride) return error.BadHy4VocabGather;
+    const mine = std.mem.sliceAsBytes(local_f32);
+    const rank_bytes = mine.len;
+    const gathered_all = try gpa.alloc(u8, htp.world * rank_bytes);
+    defer gpa.free(gathered_all);
+
+    var scratch = try gpa.alloc(u8, htp.world * vocab_gather_chunk_cap);
+    defer gpa.free(scratch);
+    var blobs: [tp.bootstrap.max_ranks][]const u8 = undefined;
+
+    var off: usize = 0;
+    while (off < rank_bytes) {
+        const step: usize = @min(vocab_gather_chunk_cap, rank_bytes - off);
+        const parts = b.allGather(mine[off .. off + step], scratch[0 .. htp.world * step], &blobs) catch |err| {
+            return if (err == error.Timeout) error.Hy4BootstrapTimeout else err;
+        };
+        for (0..htp.world) |rk| {
+            @memcpy(gathered_all[rk * rank_bytes + off ..][0..step], parts[rk]);
+        }
+        off += step;
+    }
+
+    const rank_views: [htp.world][]const u8 = .{
+        gathered_all[0 * rank_bytes ..][0..rank_bytes],
+        gathered_all[1 * rank_bytes ..][0..rank_bytes],
+        gathered_all[2 * rank_bytes ..][0..rank_bytes],
+        gathered_all[3 * rank_bytes ..][0..rank_bytes],
+    };
+    try interleaveVocabStripes(&rank_views, rows, vocab_stride, vocab_full, out_full);
+}
+
+/// Gathers each rank's 8-byte `(best_val_f32, best_global_id_u32)` candidate first so all four ranks finish
+/// the collective together, then fails all four ranks together with `error.NonFiniteLogits` if any rank saw
+/// non-finite logits in its valid stripe.
+pub fn gatherTop1OnBootstrap(
+    b: *tp.Bootstrap, rank_idx: usize, local_f32: []const f32, vocab_stride: usize, vocab_full: usize,
+) !u32 {
+    if (local_f32.len != vocab_stride or vocab_full == 0) return error.BadHy4VocabGather;
+    const base_id = rank_idx * vocab_stride;
+    const valid: usize = if (base_id < vocab_full) @min(vocab_stride, vocab_full - base_id) else 0;
+    var best_val: f32 = -std.math.inf(f32);
+    var best_id: u32 = @intCast(@min(base_id, vocab_full - 1));
+    for (local_f32[0..valid], 0..) |v, col| {
+        if (!std.math.isFinite(v)) {
+            best_val = std.math.nan(f32);
+            break;
+        }
+        if (v > best_val) {
+            best_val = v;
+            best_id = @intCast(base_id + col);
+        }
+    }
+
+    const greedy = @import("greedy.zig");
+    const local = greedy.Pair{ .value = best_val, .id = best_id };
+    var result: [1]u32 = undefined;
+    try greedy.gather(b, &.{local}, vocab_stride, vocab_full, &result);
+    return result[0];
+}
+
+pub const PlanOp = enum(i64) {
+    forward_step = 1,
+    compute_logits = 2,
+    stop = 3,
+    clear_range = 4,
+    draft_propose = 5,
+    greedy_rows = 6,
+    forward_greedy = 7, vision_set = 8, vision_clear = 9,
+};
+
+pub const TpSession = struct {
+    rank: htp.Rank,
+    rank_idx: u32,
+    nccl_lib: *cuda.nccl.Library,
+    bootstrap: tp.Bootstrap,
+    boundary: htp.Boundary,
+    load_timeout_ns: u64,
+    plan_link: ?tp.planlink.PlanLink = null,
+    plant_pack_mismatch_rank: ?usize = null,
+
+    pub fn open(io: std.Io, opts: ConnectOptions) !TpSession {
+        return openOpt(io, null, opts);
+    }
+
+    pub fn openWithStream(io: std.Io, stream: cuda.Stream, opts: ConnectOptions) !TpSession {
+        return openOpt(io, stream, opts);
+    }
+
+    fn openOpt(io: std.Io, stream_opt: ?cuda.Stream, opts: ConnectOptions) !TpSession {
+        const rank = try htp.Rank.init(opts.rank, opts.tp_world);
+        if (opts.require_ib) {
+            const net = envStr("NCCL_NET") orelse return error.Hy4SocketTransportRefused;
+            if (!std.mem.eql(u8, net, "IB")) return error.Hy4SocketTransportRefused;
+        }
+
+        const cfg: tp.Config = .{
+            .world = htp.world,
+            .rank = @intCast(opts.rank),
+            .master = opts.master,
+            .link_port = opts.port,
+            .connect_timeout_ns = @as(u64, @max(opts.timeout_s, @as(u64, 1))) * std.time.ns_per_s,
+        };
+        var b = try tp.Bootstrap.open(cfg);
+        errdefer b.close();
+
+        const lib = try std.heap.c_allocator.create(cuda.nccl.Library);
+        errdefer std.heap.c_allocator.destroy(lib);
+        lib.* = try cuda.nccl.Library.open();
+        errdefer lib.close();
+
+        var bnd = if (stream_opt) |s| try htp.Boundary.joinConfigured(tp, lib, &b, s, io) else try htp.Boundary.join(lib, &b, io);
+        errdefer bnd.abort();
+
+        var pl: ?tp.planlink.PlanLink = null;
+        if (opts.with_plan_link) {
+            pl = tp.planlink.PlanLink.init(@intCast(opts.rank), htp.world, b.releasePlan());
+        }
+
+        return .{
+            .rank = rank,
+            .rank_idx = @intCast(opts.rank),
+            .nccl_lib = lib,
+            .bootstrap = b,
+            .boundary = bnd,
+            .load_timeout_ns = @as(u64, @max(opts.load_timeout_s, @as(u64, 1))) * std.time.ns_per_s,
+            .plan_link = pl,
+            .plant_pack_mismatch_rank = opts.plant_pack_mismatch_rank,
+        };
+    }
+
+    pub fn agreePackAndRun(
+        self: *TpSession,
+        gpa: std.mem.Allocator,
+        io: std.Io,
+        idx: *const weights.ShardIndex,
+        run_tag: []const u8,
+    ) !void {
+        var digest = try computePackDigest(gpa, io, idx);
+        if (self.plant_pack_mismatch_rank) |bad_r| {
+            if (bad_r == self.rank_idx) digest[0] ^= 0xff;
+        }
+        try agreePackDigestOnBootstrap(&self.bootstrap, &digest);
+        self.bootstrap.agree(run_tag, "Hy4 run settings") catch |err| {
+            if (err == error.Mismatch) return error.Hy4RunMismatch;
+            if (err == error.Timeout) return error.Hy4BootstrapTimeout;
+            return err;
+        };
+    }
+
+    pub fn agreeDrafterPack(
+        self: *TpSession,
+        gpa: std.mem.Allocator,
+        io: std.Io,
+        drafter_idx: *const weights.ShardIndex,
+    ) !void {
+        const digest = try computePackDigest(gpa, io, drafter_idx);
+        try agreePackDigestOnBootstrap(&self.bootstrap, &digest);
+    }
+
+    pub fn gatherTop1(
+        self: *TpSession,
+        stream: cuda.Stream,
+        local_f32: []const f32,
+        vocab_stride: usize,
+        vocab_full: usize,
+    ) !u32 {
+        try self.boundary.finish(stream);
+        return gatherTop1OnBootstrap(&self.bootstrap, self.rank_idx, local_f32, vocab_stride, vocab_full);
+    }
+
+    pub fn broadcastPostLoad(self: *TpSession, send_bytes: []const u8, out_bytes: []u8) !void {
+        try broadcastPostLoadOnBootstrap(&self.bootstrap, self.load_timeout_ns, send_bytes, out_bytes);
+    }
+
+    pub fn agreePostLoad(self: *TpSession, tag: []const u8, what: []const u8) !void {
+        const saved = self.bootstrap.timeout_ns;
+        self.bootstrap.timeout_ns = @max(saved, self.load_timeout_ns);
+        defer self.bootstrap.timeout_ns = saved;
+        self.bootstrap.agree(tag, what) catch |err| {
+            if (err == error.Timeout) return error.Hy4LoadTimeout;
+            if (err == error.Mismatch) return error.Hy4RunMismatch;
+            return err;
+        };
+    }
+
+    pub fn gatherFold(
+        self: *const TpSession, ops: *const cuda.hy4_ops.Kernels, stream: cuda.Stream, rows: usize,
+        partial_ptr: u64, partial_bytes: usize, gathered_ptr: u64, gathered_bytes: usize, branch_ptr: u64, branch_bytes: usize,
+    ) !void {
+        try self.boundary.gatherFold(ops, stream, rows, .{
+            .partial = .{ .ptr = partial_ptr, .bytes = partial_bytes },
+            .gathered = .{ .ptr = gathered_ptr, .bytes = gathered_bytes },
+            .branch = .{ .ptr = branch_ptr, .bytes = branch_bytes },
+        });
+    }
+
+    /// Under `HY4_TP_DIRECT_WRITE=1` (when the RoCE verbs relay is active and `h == 6144`), folds all 4 peers'
+    /// RDMA slots directly into `branch_ptr` (`[rows * 6144]` BF16) without writing `tp_gathered` or `foldRank4`.
+    pub fn tryDraftFold(
+        self: *const TpSession, stream: cuda.Stream, rows: usize, h: usize,
+        partial_ptr: u64, partial_bytes: usize, gathered_ptr: u64, gathered_bytes: usize,
+        branch_ptr: u64, branch_bytes: usize, scratch_streams_ptr: u64, zeros_f32_ptr: u64,
+    ) !bool {
+        if (h != htp.hidden) return false;
+        return self.boundary.tryFoldWrite(stream, rows, .{
+            .partial = .{ .ptr = partial_ptr, .bytes = partial_bytes },
+            .gathered = .{ .ptr = gathered_ptr, .bytes = gathered_bytes },
+            .branch = .{ .ptr = branch_ptr, .bytes = branch_bytes },
+        }, .{ .residual = scratch_streams_ptr, .branch = branch_ptr, .post = zeros_f32_ptr, .output = scratch_streams_ptr });
+    }
+
+    /// Exchanges `rows` 8-byte `greedy.Pair` candidates across all 4 ranks (16-byte-aligned device RDMA gather
+    /// when `HY4_TP_DIRECT_WRITE=1`, otherwise `Bootstrap.allGather`).
+    pub fn gatherGreedyDevice(
+        self: *TpSession, d: *const cuda.Driver, stream: cuda.Stream, dev_local_ptr: u64, dev_all_ptr: u64,
+        rows: usize, vocab_pad: usize, vocab_full: usize, ids_out: []u32,
+    ) !void {
+        const greedy = @import("greedy.zig");
+        if (rows == 0 or rows > greedy.max_rows or ids_out.len != rows) return error.BadHy4VocabGather;
+        if (envFlag("HY4_TP_DIRECT_WRITE")) {
+            const pair_bytes = rows * @sizeOf(greedy.Pair);
+            const wire_bytes = std.mem.alignForward(usize, pair_bytes, 16);
+            if (self.boundary.comm == null) return error.Hy4CommunicatorClosed;
+            if (self.boundary.relay) |r| {
+                try r.check(r.ctx);
+                if (r.fits(r.ctx, wire_bytes)) try r.gather(r.ctx, stream.handle, dev_local_ptr, dev_all_ptr, wire_bytes)
+                else try self.nccl_lib.check(self.nccl_lib.api.ncclAllGather(dev_local_ptr, dev_all_ptr, wire_bytes, .u8, self.boundary.comm, stream.handle), "Hy4 greedy all-gather");
+            } else {
+                try self.nccl_lib.check(self.nccl_lib.api.ncclAllGather(dev_local_ptr, dev_all_ptr, wire_bytes, .u8, self.boundary.comm, stream.handle), "Hy4 greedy all-gather");
+            }
+            try self.boundary.finish(stream);
+            var raw: [htp.world * greedy.max_rows * @sizeOf(greedy.Pair)]u8 align(@alignOf(greedy.Pair)) = undefined;
+            try cuda.memory.download(d, dev_all_ptr, raw[0 .. htp.world * wire_bytes]);
+            const views: [htp.world][]const u8 = .{
+                raw[0 * wire_bytes ..][0..pair_bytes], raw[1 * wire_bytes ..][0..pair_bytes],
+                raw[2 * wire_bytes ..][0..pair_bytes], raw[3 * wire_bytes ..][0..pair_bytes],
+            };
+            return greedy.selectWinners(&views, rows, vocab_pad, vocab_full, ids_out);
+        }
+        try self.boundary.finish(stream);
+        var local: [greedy.max_rows]greedy.Pair = undefined;
+        try cuda.memory.download(d, dev_local_ptr, std.mem.sliceAsBytes(local[0..rows]));
+        return greedy.gather(&self.bootstrap, local[0..rows], vocab_pad, vocab_full, ids_out);
+    }
+
+    pub fn gatherTop2Device(
+        self: *TpSession, d: *const cuda.Driver, stream: cuda.Stream, dev_local_ptr: u64, dev_all_ptr: u64,
+        rows: usize, vocab_pad: usize, vocab_full: usize, out: []@import("greedy.zig").MarginWinner,
+    ) !void {
+        const greedy = @import("greedy.zig");
+        if (rows == 0 or rows > greedy.max_rows or out.len != rows) return error.BadHy4VocabGather;
+        if (envFlag("HY4_TP_DIRECT_WRITE")) {
+            const wire_bytes = rows * @sizeOf(greedy.Top2);
+            if (self.boundary.comm == null) return error.Hy4CommunicatorClosed;
+            if (self.boundary.relay) |r| {
+                try r.check(r.ctx);
+                if (r.fits(r.ctx, wire_bytes)) try r.gather(r.ctx, stream.handle, dev_local_ptr, dev_all_ptr, wire_bytes)
+                else try self.nccl_lib.check(self.nccl_lib.api.ncclAllGather(dev_local_ptr, dev_all_ptr, wire_bytes, .u8, self.boundary.comm, stream.handle), "Hy4 top2 all-gather");
+            } else try self.nccl_lib.check(self.nccl_lib.api.ncclAllGather(dev_local_ptr, dev_all_ptr, wire_bytes, .u8, self.boundary.comm, stream.handle), "Hy4 top2 all-gather");
+            try self.boundary.finish(stream);
+            var raw: [htp.world * greedy.max_rows * @sizeOf(greedy.Top2)]u8 align(@alignOf(greedy.Top2)) = undefined;
+            try cuda.memory.download(d, dev_all_ptr, raw[0 .. htp.world * wire_bytes]);
+            const views: [htp.world][]const u8 = .{ raw[0..wire_bytes], raw[wire_bytes .. 2 * wire_bytes], raw[2 * wire_bytes .. 3 * wire_bytes], raw[3 * wire_bytes .. 4 * wire_bytes] };
+            return greedy.selectTop2(&views, rows, vocab_pad, vocab_full, out);
+        }
+        try self.boundary.finish(stream);
+        var local: [greedy.max_rows]greedy.Top2 = undefined;
+        try cuda.memory.download(d, dev_local_ptr, std.mem.sliceAsBytes(local[0..rows]));
+        return greedy.gatherTop2(&self.bootstrap, local[0..rows], vocab_pad, vocab_full, out);
+    }
+
+    pub fn gatherVocabLogits(
+        self: *TpSession, gpa: std.mem.Allocator, stream: cuda.Stream, local_f32: []const f32,
+        rows: usize, vocab_stride: usize, vocab_full: usize, out_full: []f32,
+    ) !void {
+        if (local_f32.len != rows * vocab_stride) return error.BadHy4VocabGather;
+        try self.boundary.finish(stream);
+        try gatherVocabOnBootstrap(&self.bootstrap, gpa, local_f32, rows, vocab_stride, vocab_full, out_full);
+    }
+
+    pub fn finishRun(self: *TpSession, stream: cuda.Stream) !void {
+        try self.boundary.finish(stream);
+        self.bootstrap.agree("HY4_OK", "Hy4 run completion") catch |err| {
+            return if (err == error.Timeout) error.Hy4BootstrapTimeout else err;
+        };
+    }
+
+    pub fn abortAndClose(self: *TpSession) void {
+        if (self.plan_link) |*pl| pl.close();
+        self.plan_link = null;
+        self.boundary.abort();
+        self.bootstrap.close();
+        self.nccl_lib.close();
+        std.heap.c_allocator.destroy(self.nccl_lib);
+    }
+
+    pub fn close(self: *TpSession) void {
+        if (self.plan_link) |*pl| pl.close();
+        self.plan_link = null;
+        self.boundary.close();
+        self.bootstrap.close();
+        self.nccl_lib.close();
+        std.heap.c_allocator.destroy(self.nccl_lib);
+    }
+};
+
+pub fn broadcastPostLoadOnBootstrap(
+    b: *tp.Bootstrap,
+    load_timeout_ns: u64,
+    send_bytes: []const u8,
+    out_bytes: []u8,
+) !void {
+    const saved = b.timeout_ns;
+    b.timeout_ns = @max(saved, load_timeout_ns);
+    defer b.timeout_ns = saved;
+    b.broadcast(send_bytes, out_bytes) catch |err| {
+        if (err == error.Timeout) return error.Hy4LoadTimeout;
+        return error.Hy4RunMismatch;
+    };
+}
