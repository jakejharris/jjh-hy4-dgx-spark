+fn addExl3Mat(a: std.mem.Allocator, list: *std.ArrayList(core.shard_edit.New), wm: *std.ArrayList(u8), mats: *std.ArrayList(u8), shard: []const u8, pfx: []const u8, n: usize, k: usize, k2: u8, rnd: std.Random) !void {
+    const mul1 = try a.dupe(u8, &[_]u8{ 0x2D, 0xD1, 0xDC, 0x83 });
+    const tr_b = try a.alloc(u8, (k / 16) * (n / 16) * 8 * k2 * 2);
+    const su_b = try a.alloc(u8, k * 2);
+    const sv_b = try a.alloc(u8, n * 2);
+    rnd.bytes(tr_b);
+    @memset(su_b, 0x3c);
+    @memset(sv_b, 0x3c);
+    const first = wm.items.len == 0;
+    try list.appendSlice(a, &.{
+        .{ .name = try std.fmt.allocPrint(a, "{s}.mul1", .{pfx}), .dtype = .i32, .shape = &.{}, .bytes = mul1 },
+        .{ .name = try std.fmt.allocPrint(a, "{s}.trellis", .{pfx}), .dtype = .i16, .shape = try a.dupe(usize, &.{ k / 16, n / 16, @as(usize, 8) * k2 }), .bytes = tr_b },
+        .{ .name = try std.fmt.allocPrint(a, "{s}.suh", .{pfx}), .dtype = .f16, .shape = try a.dupe(usize, &.{k}), .bytes = su_b },
+        .{ .name = try std.fmt.allocPrint(a, "{s}.svh", .{pfx}), .dtype = .f16, .shape = try a.dupe(usize, &.{n}), .bytes = sv_b },
+    });
+    try mats.print(a, "{s}\"{s}\":{{\"k2\":{d}}}", .{ if (first) "" else ",", pfx, k2 });
+    inline for (.{ "mul1", "trellis", "suh", "svh" }, 0..) |sfx, j| {
+        try wm.print(a, "{s}\"{s}.{s}\":\"{s}\"", .{ if (first and j == 0) "" else ",", pfx, sfx, shard });
+    }
+}
