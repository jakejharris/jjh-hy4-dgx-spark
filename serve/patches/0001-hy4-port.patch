+        const post = [_]f32{ 0.5, 1.25, -0.75, 2 };
+        const write: cuda.hy4_ops.IhcWrite = .{ .branch = self.branch.ptr, .post = try self.rig.input(std.mem.asBytes(&post)),
+            .residual = try self.rig.input(std.mem.asBytes(&res)), .output = try self.rig.output(4 * D * 2) };
+        try self.writeBoundary(false, write);
+        try self.link.finish(self.rig.s);
+        const expected = try t.allocator.dupe(u8, try self.rig.bytes(write.output, 4 * D * 2));
+        defer t.allocator.free(expected);
+        const branch = try t.allocator.dupe(u8, try self.rig.bytes(write.branch, D * 2));
+        defer t.allocator.free(branch);
+        try t.expectEqual(@as(u16, 0x4040), std.mem.bytesAsValue(u16, branch[0..2]).*);
