+const HeadLoadCtx = struct {
+    gpa: std.mem.Allocator, up: *Uploader, m: config.Model, rank: ?ranks.Rank, out: *DraftWeights,
+
+    fn call(raw: *anyopaque, sess: *weights.ShardSession) !void {
+        const c: *@This() = @ptrCast(@alignCast(raw));
+        const t = c.m.text_config;
+        const h: usize = t.hidden_size;
+        c.out.enorm = try weights.uploadNorm(sess, c.gpa, c.up, "model.dfly_layers.mtp_fusion.enorm.weight", h);
+        c.out.hnorm = try weights.uploadNorm(sess, c.gpa, c.up, "model.dfly_layers.mtp_fusion.hnorm.weight", h);
+        c.out.eh_proj = try trunk_exl3.uploadProj(sess, c.gpa, c.up, "model.dfly_layers.mtp_fusion.eh_proj", h, 2 * h, h, 2 * h, .whole);
+        c.out.fusion_gate_f32 = try weights.uploadF32Any(sess, c.gpa, c.up, "model.dfly_layers.mtp_fusion.gate", &.{h});
+        c.out.final_norm = try weights.uploadNorm(sess, c.gpa, c.up, "model.dfly_layers.final_norm.weight", h);
+        if (c.m.dfly_enable_hidden_correction) {
+            const d_corr = try inferOutDim(sess, "model.dfly_layers.hidden_correction.gate_proj", 2 * h);
+            if (c.rank != null and d_corr % cuda.hy4_tp.world != 0) return error.BadHy4TpShape;
+            const d_corr_loc = if (c.rank != null) d_corr / cuda.hy4_tp.world else d_corr;
+            c.out.corr_hidden_norm = try weights.uploadNorm(sess, c.gpa, c.up, "model.dfly_layers.hidden_correction.hidden_norm.weight", h);
+            c.out.corr_embed_norm = try weights.uploadNorm(sess, c.gpa, c.up, "model.dfly_layers.hidden_correction.embed_norm.weight", h);
+            c.out.corr_mlp = .{
+                .gate = try trunk_exl3.uploadProj(sess, c.gpa, c.up, "model.dfly_layers.hidden_correction.gate_proj", d_corr, 2 * h, d_corr_loc, 2 * h, .col),
+                .up = try trunk_exl3.uploadProj(sess, c.gpa, c.up, "model.dfly_layers.hidden_correction.up_proj", d_corr, 2 * h, d_corr_loc, 2 * h, .col),
+                .down = try trunk_exl3.uploadProj(sess, c.gpa, c.up, "model.dfly_layers.hidden_correction.down_proj", h, d_corr, h, d_corr_loc, .row),
+            };
+        }
+        if (sess.idx.has("lm_head.trellis")) {
+            const ls = try ranks.LocalShape.forText(t, c.rank);
+            const hp = try trunk_exl3.uploadProj(sess, c.gpa, c.up, "lm_head", t.vocab_size, h, ls.vocab_local, h, .col);
+            c.out.custom_head = .{ .proj = .{ .p = hp, .vocab_local = ls.vocab_local, .vocab_pad = ls.vocab_stride, .vocab_full = ls.vocab_full } };
+        }
+    }
+};
