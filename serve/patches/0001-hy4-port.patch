+            .q_a = try trunk_exl3.uploadProj(sess, c.gpa, c.up, try std.fmt.bufPrint(&nb, p ++ "self_attn.q_a_proj", .{l}), q_rank, h, q_rank, h, .whole),
+            .q_a_norm = try weights.uploadNorm(sess, c.gpa, c.up, try std.fmt.bufPrint(&nb, p ++ "self_attn.q_a_layernorm.weight", .{l}), q_rank),
+            .q_b = try trunk_exl3.uploadProj(sess, c.gpa, c.up, try std.fmt.bufPrint(&nb, p ++ "self_attn.q_b_proj", .{l}), t.queryRows(), q_rank, ls.queryRows(t), q_rank, .col),
+            .kv_a = try trunk_exl3.uploadProj(sess, c.gpa, c.up, try std.fmt.bufPrint(&nb, p ++ "self_attn.kv_a_proj_with_mqa", .{l}), t.kvARows(), h, t.kvARows(), h, .whole),
+            .kv_a_norm_bf16 = try weights.uploadRawSliced(sess, c.gpa, c.up, try std.fmt.bufPrint(&nb, p ++ "self_attn.kv_a_layernorm.weight", .{l}), .bf16, &.{t.kv_lora_rank}, @as(usize, t.kv_lora_rank) * 2),
+            .kv_b = try weights.uploadRawSliced(sess, c.gpa, c.up, try std.fmt.bufPrint(&nb, p ++ "self_attn.kv_b_proj.weight", .{l}), .bf16, &.{ t.kvBRows(), t.kv_lora_rank }, ls.kvBRows(t) * t.kv_lora_rank * 2),
+            .linear_gate = try trunk_exl3.uploadProj(sess, c.gpa, c.up, try std.fmt.bufPrint(&nb, p ++ "self_attn.linear_gate", .{l}), t.valueRows(), h, ls.valueRows(t), h, .col),
+            .o_proj = try trunk_exl3.uploadProj(sess, c.gpa, c.up, try std.fmt.bufPrint(&nb, p ++ "self_attn.o_proj", .{l}), h, t.valueRows(), h, ls.valueRows(t), .row),
+            .sinks = try weights.uploadF32Sliced(sess, c.gpa, c.up, try std.fmt.bufPrint(&nb, p ++ "self_attn.learnable_sink_param", .{l}), &.{t.num_attention_heads}, ls.heads, ls.heads, false),
+            .post_attn_norm = try weights.uploadNorm(sess, c.gpa, c.up, try std.fmt.bufPrint(&nb, p ++ "post_attention_layernorm.weight", .{l}), h),
+            .mlp = .{
+                .gate = try trunk_exl3.uploadProj(sess, c.gpa, c.up, try std.fmt.bufPrint(&nb, p ++ "mlp.gate_proj", .{l}), d_ffn, h, d_ffn_loc, h, .col),
+                .up = try trunk_exl3.uploadProj(sess, c.gpa, c.up, try std.fmt.bufPrint(&nb, p ++ "mlp.up_proj", .{l}), d_ffn, h, d_ffn_loc, h, .col),
+                .down = try trunk_exl3.uploadProj(sess, c.gpa, c.up, try std.fmt.bufPrint(&nb, p ++ "mlp.down_proj", .{l}), h, d_ffn, h, d_ffn_loc, .row),
+            },
+        };
+    }
+};
+
+pub fn loadWeightsDirect(
+    gpa: std.mem.Allocator, io: std.Io, idx: *const weights.ShardIndex, up: *Uploader,
+    rank: ?ranks.Rank, memFloorCheck: ?*const fn (usize) anyerror!void, floor_gib: usize,
+) !DraftWeights {
+    const m = idx.cfg.value;
+    if (m.dfly_num_hidden_layers == 0) return error.MissingDrafterWeights;
+    var pf = direct_load.DirectPrefetcher.initWithRank(gpa, io, idx, rank);
+    defer pf.deinit();
+
+    const blocks = try gpa.alloc(DraftBlockWeights, m.dfly_num_hidden_layers);
+    errdefer gpa.free(blocks);
+    var out: DraftWeights = .{
+        .blocks = blocks, .block_size = m.dfly_block_size,
+        .mask_token_id = m.dfly_mask_token_id, .enable_hidden_correction = m.dfly_enable_hidden_correction,
+    };
+
+    if (memFloorCheck) |chk| try chk(floor_gib);
+    var hctx: HeadLoadCtx = .{ .gpa = gpa, .up = up, .m = m, .rank = rank, .out = &out };
+    try pf.runWithPrefixes(&.{
+        "model.dfly_layers.mtp_fusion.", "model.dfly_layers.final_norm.", "model.dfly_layers.hidden_correction.", "lm_head.",
+    }, &hctx, HeadLoadCtx.call);
+
+    for (blocks, 0..) |*blk, l| {
+        if (memFloorCheck) |chk| try chk(floor_gib);
+        var pbuf: [64]u8 = undefined;
+        const pfx = try std.fmt.bufPrint(&pbuf, "model.dfly_layers.{d}.", .{l});
+        var bctx: BlockLoadCtx = .{ .gpa = gpa, .up = up, .m = m, .rank = rank, .layer = l, .out = blk };
+        try pf.runWithPrefixes(&.{pfx}, &bctx, BlockLoadCtx.call);
+    }
+    return out;
+}
+
+fn tpDraftFold(tps: *const boundary.TpSession, rt: *forward.Runtime, msc: *forward.Scratch, h: usize, rows: usize) !void {
+    if (try tps.tryDraftFold(
+        rt.stream, rows, h, msc.tp_partial.ptr, msc.tp_partial.len,
+        msc.tp_gathered.ptr, msc.tp_gathered.len, msc.branch.ptr, msc.branch.len,
+        msc.streams_b.ptr, msc.zeros_f32.ptr,
+    )) return;
+    try forward.tpGatherFold(tps, rt, msc, h, rows);
+}
+
+pub const Drafter = struct {
+    gpa: std.mem.Allocator,
+    weights: DraftWeights,
+    sc: DraftScratch,
+    fault_wrong_token: bool = false, step_ms: f64 = 0.0, min_margin_override: ?f32 = null,
+
+    pub fn loadDirect(
+        gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, idx: *const weights.ShardIndex,
+        up: *Uploader, memFloorCheck: ?*const fn (usize) anyerror!void, floor_gib: usize,
+    ) !Drafter {
+        return loadDirectWithRank(gpa, io, d, idx, up, null, memFloorCheck, floor_gib);
+    }
+
+    pub fn loadDirectWithRank(
+        gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, idx: *const weights.ShardIndex,
+        up: *Uploader, rank: ?ranks.Rank, memFloorCheck: ?*const fn (usize) anyerror!void, floor_gib: usize,
+    ) !Drafter {
+        var dw = try loadWeightsDirect(gpa, io, idx, up, rank, memFloorCheck, floor_gib);
+        errdefer dw.deinitHost(gpa);
+        const sc = try DraftScratch.init(gpa, d, idx.cfg.value.text_config, dw.block_size);
+        return .{ .gpa = gpa, .weights = dw, .sc = sc };
+    }
+
+    pub fn deinit(self: *Drafter) void {
+        self.sc.deinit();
+        self.weights.deinitHost(self.gpa);
+        self.* = undefined;
+    }
+
+    pub fn maxProposals(self: *const Drafter) u32 { return self.weights.maxProposals(); }
+    pub fn quantLabel(self: *const Drafter) []const u8 { return self.weights.quantLabel(); }
+
+    pub fn propose(self: *Drafter, rt: *forward.Runtime, msc: *forward.Scratch, t: config.Text, embed_bf16: u64, head: weights.HeadWeights, loaded_layers: usize, pool: *kv_pool.KvPool, anchor: *const AnchorState, anchor_row: usize, p: usize, bonus_tok: u32, depth: usize, pickFn: ?*const fn (*anyopaque, []const f32, u64) anyerror!u32, pick_ctx: ?*anyopaque, out_tokens: []u32) !usize {
+        return self.proposeTp(rt, msc, t, embed_bf16, head, loaded_layers, pool, anchor, anchor_row, p, bonus_tok, depth, null, true, pickFn, pick_ctx, out_tokens);
+    }
+
+    pub fn proposeTp(
+        self: *Drafter, rt: *forward.Runtime, msc: *forward.Scratch, t: config.Text,
+        embed_bf16: u64, head: weights.HeadWeights, loaded_layers: usize, pool: *kv_pool.KvPool,
+        anchor: *const AnchorState, anchor_row: usize, p: usize, bonus_tok: u32, depth: usize,
+        tp_sess: ?*boundary.TpSession, is_greedy: bool,
+        pickFn: ?*const fn (ctx: *anyopaque, logits: []const f32, pos: u64) anyerror!u32,
+        pick_ctx: ?*anyopaque, out_tokens: []u32,
+    ) !usize {
+        const ro = self.weights.custom_head orelse draft_policy.DraftHead{ .shared_f32 = head };
+        return self.proposeTpWithHead(rt, msc, t, embed_bf16, ro, loaded_layers, pool, anchor, anchor_row, p, bonus_tok, depth, tp_sess, is_greedy, pickFn, pick_ctx, out_tokens);
+    }
+
+    pub fn proposeTpWithHead(
+        self: *Drafter, rt: *forward.Runtime, msc: *forward.Scratch, t: config.Text,
+        embed_bf16: u64, head_ro: draft_policy.DraftHead, loaded_layers: usize, pool: *kv_pool.KvPool,
+        anchor: *const AnchorState, anchor_row: usize, p: usize, bonus_tok: u32, depth: usize,
+        tp_sess: ?*boundary.TpSession, is_greedy: bool,
+        pickFn: ?*const fn (ctx: *anyopaque, logits: []const f32, pos: u64) anyerror!u32,
+        pick_ctx: ?*anyopaque, out_tokens: []u32,
+    ) !usize {
+        const w: usize = self.weights.block_size;
+        const count: usize = @min(@as(usize, @min(depth, w - 1)), out_tokens.len);
+        if (count == 0 or p + w > pool.capacity) return 0;
+        if (anchor_row >= anchor.captured_rows) return error.BadDraftAnchor;
+        const ls = try ranks.LocalShape.forText(t, if (tp_sess) |tps| tps.rank else null);
+
+        const h: usize = t.hidden_size;
+        var ids_host: [max_block_size]i32 = @splat(@intCast(self.weights.mask_token_id));
+        ids_host[0] = @intCast(bonus_tok);
+        try self.sc.ids_i32.uploadAsync(0, std.mem.sliceAsBytes(ids_host[0..w]), rt.stream.handle);
+        try rt.embed.bf16(rt.stream, self.sc.ids_i32.ptr, embed_bf16, self.sc.streams_0.ptr, w, h);
+
+        // slot0 mtp_fusion: apply separate 6,144-element fusion_gate_f32 in FP32 before BF16 round (per-channel FP32 gate).
+        const anchor_ptr = anchor.hidden_bf16.ptr + anchor_row * h * 2;
+        try rt.runRmsNorm(msc, self.sc.streams_0.ptr, self.weights.enorm, self.sc.concat.ptr, 1, t.rms_norm_eps);
+        try rt.runRmsNorm(msc, anchor_ptr, self.weights.hnorm, self.sc.concat.ptr + h * 2, 1, t.rms_norm_eps);
+        if (draft_policy.isUnpaddedAlignedBf16(self.weights.eh_proj)) |eh_bf16| {
+            if (h % 8 == 0 and self.sc.concat.ptr % 16 == 0 and eh_bf16.ptr % 16 == 0) {
+                try self.sc.dense_rows.rowsScaled(rt.stream, self.sc.concat.ptr, 2 * h, eh_bf16.ptr, self.weights.fusion_gate_f32, self.sc.delta_f32.ptr, h, 1, h, 2 * h);
+                try rt.vit_k.cast(rt.stream, self.sc.delta_f32.ptr, self.sc.delta_bf16.ptr, h);
+            } else {
+                try draft_policy.runDraftPartialF32(self.weights.eh_proj, rt, msc, self.sc.concat.ptr, self.sc.delta_f32.ptr, 1);
+                try rt.ops.glue.combine(rt.stream, self.sc.delta_f32.ptr, .f32, self.weights.fusion_gate_f32, self.sc.delta_bf16.ptr, .bf16, h, 1, 1);
+            }
+        } else {
+            try draft_policy.runDraftPartialF32(self.weights.eh_proj, rt, msc, self.sc.concat.ptr, self.sc.delta_f32.ptr, 1);
+            try rt.ops.glue.combine(rt.stream, self.sc.delta_f32.ptr, .f32, self.weights.fusion_gate_f32, self.sc.delta_bf16.ptr, .bf16, h, 1, 1);
+        }
+        try rt.vit_k.pointwise(rt.stream, self.sc.delta_bf16.ptr, self.sc.streams_0.ptr, self.sc.streams_0.ptr, h, .none);
+        if (trace_hook) |th| try th.call(th.ctx, 's', 0, self.sc.streams_0.ptr, w, h);
+
+        var x = self.sc.streams_0.ptr;
+        var y = self.sc.streams_1.ptr;
+        for (self.weights.blocks, 0..) |blk, b_idx| {
+            const tgt = try resolveTargetLayers(blk.target_kv, blk.target_index, t, loaded_layers);
+            const lc = try pool.layerCache(tgt.kv);
+
+            var indices_ptr: u64 = 0;
+            var key_count: u32 = @intCast(p + w);
+            if (p > t.index_topk) {
+                const recalled = anchor.recalledRow(b_idx, anchor_row);
+                try buildDraftIndices(recalled, p, w, self.sc.draft_stride, self.sc.host_indices);
+                try self.sc.indices_dev.uploadAsync(0, std.mem.sliceAsBytes(self.sc.host_indices), rt.stream.handle);
+                indices_ptr = self.sc.indices_dev.ptr;
+                key_count = @intCast(self.sc.draft_stride);
+            }
+
+            try rt.runRmsNorm(msc, x, blk.input_norm, msc.hidden.ptr, w, t.rms_norm_eps);
+            if (blk.q_a == .exl3 and blk.kv_a == .exl3) {
+                try rt.runProjPair(msc, msc.hidden.ptr, blk.q_a, msc.q_raw.ptr, false, blk.kv_a, msc.kv.ptr, true, w);
+                try rt.runRmsNorm(msc, msc.q_raw.ptr, blk.q_a_norm, msc.q_resid.ptr, w, t.rms_norm_eps);
+                try rt.runProj(msc, msc.q_resid.ptr, blk.q_b, msc.q.ptr, w, false);
+            } else {
+                try rt.runProj(msc, msc.hidden.ptr, blk.q_a, msc.q_raw.ptr, w, false);
+                try rt.runRmsNorm(msc, msc.q_raw.ptr, blk.q_a_norm, msc.q_resid.ptr, w, t.rms_norm_eps);
+                try rt.runProj(msc, msc.q_resid.ptr, blk.q_b, msc.q.ptr, w, false);
+                try rt.runProj(msc, msc.hidden.ptr, blk.kv_a, msc.kv.ptr, w, true);
+            }
+            try rt.runProj(msc, msc.hidden.ptr, blk.linear_gate, msc.gate.ptr, w, false);
+
+            const mla_shape: cuda.hy4_ops.MlaShape = .{
+                .rows = @intCast(w), .heads = ls.heads, .capacity = @intCast(pool.capacity),
+                .key_count = key_count, .first_pos = @intCast(p), .latent = t.kv_lora_rank,
+                .nope = t.qk_nope_head_dim, .rope = t.qk_rope_head_dim, .value = t.v_head_dim,
+                .kv_row_stride = blk.kv_a.kvRowStride(), .theta = t.rope_parameters.rope_theta, .rms_eps = t.rms_norm_eps,
+            };
+            try msc.ensureMlaScratch(try cuda.hy4_ops.scratchBytes(mla_shape));
+            try cuda.hy4_ops.mlaProject(&rt.ops, rt.stream, mla_shape, .{
+                .q = msc.q.ptr, .kv = msc.kv.ptr, .kv_norm = blk.kv_a_norm_bf16,
+                .kv_b = blk.kv_b, .absorbed_q = msc.absorbed_q.ptr, .cache = lc.kv_ptr,
+            });
+            if (msc.mrope) |*mr| try mr.vk.mropeMlaOverwrite(rt.stream, mla_shape, .{ .q = msc.q.ptr, .kv = msc.kv.ptr, .kv_norm = blk.kv_a_norm_bf16, .kv_b = blk.kv_b, .absorbed_q = msc.absorbed_q.ptr, .cache = lc.kv_ptr }, 0, mr.rope_delta);
+            try cuda.hy4_ops.mlaAttend(&rt.ops, rt.stream, mla_shape, .{
+                .absorbed_q = msc.absorbed_q.ptr, .cache = lc.kv_ptr, .kv_b = blk.kv_b,
+                .gate = msc.gate.ptr, .sinks = blk.sinks, .indices = indices_ptr,
+                .scratch = msc.mla_scratch.ptr, .scratch_bytes = msc.mla_scratch.len, .output = msc.gated_values.ptr,
+            });
+            try pool.clearLayerKvRange(t, tgt.kv, p, p + w, rt.stream.handle);
+
+            if (tp_sess) |tps| {
+                try draft_policy.runDraftPartialF32(blk.o_proj, rt, msc, msc.gated_values.ptr, msc.tp_partial.ptr, w);
+                try tpDraftFold(tps, rt, msc, h, w);
+            } else {
+                try draft_policy.runDraftBf16(blk.o_proj, rt, msc, msc.gated_values.ptr, msc.branch.ptr, w);
+            }
+            try rt.vit_k.pointwise(rt.stream, msc.branch.ptr, x, self.sc.after_attn.ptr, w * h, .none);
+            if (trace_hook) |th| try th.call(th.ctx, 'a', b_idx, self.sc.after_attn.ptr, w, h);
+
+            try rt.runRmsNorm(msc, self.sc.after_attn.ptr, blk.post_attn_norm, msc.hidden.ptr, w, t.rms_norm_eps);
+            if (tp_sess) |tps| {
+                try blk.mlp.runPartialF32(rt, msc, msc.hidden.ptr, w, msc.tp_partial.ptr);
+                try tpDraftFold(tps, rt, msc, h, w);
+            } else {
+                try blk.mlp.runBranch(rt, msc, msc.hidden.ptr, w, msc.branch.ptr);
+            }
+            try rt.vit_k.pointwise(rt.stream, msc.branch.ptr, self.sc.after_attn.ptr, y, w * h, .none);
+            if (trace_hook) |th| try th.call(th.ctx, 'b', b_idx, y, w, h);
+            std.mem.swap(u64, &x, &y);
+        }
+
+        try rt.runRmsNorm(msc, x, self.weights.final_norm, self.sc.normalized.ptr, w, t.rms_norm_eps);
+        if (trace_hook) |th| try th.call(th.ctx, 'f', 0, self.sc.normalized.ptr, w, h);
+
+        const v_loc = head_ro.vocabLocal();
+        const v_pad = head_ro.vocabPad();
+        const v_full = head_ro.vocabFull();
+        const rk_idx: usize = if (tp_sess) |tps| tps.rank_idx else 0;
+        const min_margin: ?f32 = if (self.fault_wrong_token) null else (self.min_margin_override orelse try draft_policy.envMinMargin());
+        var prev_tok = bonus_tok;
+        for (0..count) |col_idx| {
+            const col = col_idx + 1;
+            const draft_col_ptr = self.sc.normalized.ptr + col * h * 2;
+            var readout_ptr = draft_col_ptr;
+            if (self.weights.enable_hidden_correction) {
+                const prev_i32 = [1]i32{@intCast(prev_tok)};
+                try self.sc.ids_i32.uploadAsync(0, std.mem.sliceAsBytes(&prev_i32), rt.stream.handle);
+                try rt.embed.bf16(rt.stream, self.sc.ids_i32.ptr, embed_bf16, self.sc.prev_embed.ptr, 1, h);
+                try rt.runRmsNorm(msc, draft_col_ptr, self.weights.corr_hidden_norm, self.sc.concat.ptr, 1, t.rms_norm_eps);
+                try rt.runRmsNorm(msc, self.sc.prev_embed.ptr, self.weights.corr_embed_norm, self.sc.concat.ptr + h * 2, 1, t.rms_norm_eps);
+                if (tp_sess) |tps| {
+                    try self.weights.corr_mlp.runPartialF32(rt, msc, self.sc.concat.ptr, 1, msc.tp_partial.ptr);
+                    try tpDraftFold(tps, rt, msc, h, 1);
+                    try rt.vit_k.pointwise(rt.stream, msc.branch.ptr, draft_col_ptr, self.sc.prev_embed.ptr, h, .none);
+                } else {
+                    try self.weights.corr_mlp.runBranch(rt, msc, self.sc.concat.ptr, 1, self.sc.delta_bf16.ptr);
+                    try rt.vit_k.pointwise(rt.stream, self.sc.delta_bf16.ptr, draft_col_ptr, self.sc.prev_embed.ptr, h, .none);
+                }
+                readout_ptr = self.sc.prev_embed.ptr;
+            }
+            if (trace_hook) |th| try th.call(th.ctx, 'c', col, readout_ptr, 1, h);
+            try head_ro.evalLogitsRow(rt, msc, readout_ptr, msc.logits_f32.ptr, h);
+
+            const chosen: u32 = if (is_greedy or pickFn == null) blk_g: {
+                if (min_margin) |mm| {
+                    try greedy.reduceTop2(&rt.ops, rt.stream, msc.logits_f32.ptr, msc.f32_in.ptr, 1, v_pad, v_loc, rk_idx * v_pad);
+                    var win: [1]greedy.MarginWinner = undefined;
+                    if (tp_sess) |tps| try tps.gatherTop2Device(rt.d, rt.stream, msc.f32_in.ptr, msc.f32_tmp.ptr, 1, v_pad, v_full, &win) else {
+                        try rt.stream.synchronize();
+                        var local_t2: [1]greedy.Top2 = undefined;
+                        try cuda.memory.download(rt.d, msc.f32_in.ptr, std.mem.sliceAsBytes(&local_t2));
+                        try greedy.gatherTop2(null, &local_t2, v_pad, v_full, &win);
+                    }
+                    if (win[0].margin < mm) return col_idx;
+                    break :blk_g win[0].id;
+                }
+                try greedy.reduce(&rt.ops, rt.stream, msc.logits_f32.ptr, msc.f32_in.ptr, 1, v_pad, v_loc, rk_idx * v_pad);
+                var picked: [1]u32 = undefined;
+                if (tp_sess) |tps| try tps.gatherGreedyDevice(rt.d, rt.stream, msc.f32_in.ptr, msc.f32_tmp.ptr, 1, v_pad, v_full, &picked) else {
+                    try rt.stream.synchronize();
+                    var local_pair: [1]greedy.Pair = undefined;
+                    try cuda.memory.download(rt.d, msc.f32_in.ptr, std.mem.sliceAsBytes(&local_pair));
+                    try greedy.gather(null, &local_pair, v_pad, v_full, &picked);
+                }
+                break :blk_g if (self.fault_wrong_token) self.weights.mask_token_id else picked[0];
+            } else if (tp_sess) |tps| blk_tp: {
+                try rt.stream.synchronize();
+                try cuda.memory.download(rt.d, msc.logits_f32.ptr, std.mem.sliceAsBytes(self.sc.local_logits[0..v_pad]));
+                try tps.gatherVocabLogits(rt.gpa, rt.stream, self.sc.local_logits[0..v_pad], 1, v_pad, v_full, self.sc.host_logits);
+                if (self.fault_wrong_token) { _ = try argminF32(self.sc.host_logits); break :blk_tp self.weights.mask_token_id; }
+                const cut_here = if (tps.rank == .zero and min_margin != null) (try greedy.hostTop2(self.sc.host_logits)).margin < min_margin.? else false;
+                var tok_le: u32 = if (tps.rank != .zero) 0 else if (cut_here) std.math.maxInt(u32) else std.mem.nativeToLittle(u32, try pickFn.?(pick_ctx.?, self.sc.host_logits, @intCast(p + col)));
+                tps.bootstrap.broadcast(std.mem.asBytes(&tok_le), std.mem.asBytes(&tok_le)) catch |err| return if (err == error.Timeout) error.Hy4BootstrapTimeout else error.Hy4RunMismatch;
+                const tok = std.mem.littleToNative(u32, tok_le);
+                if (tok == std.math.maxInt(u32)) return col_idx;
+                break :blk_tp tok;
+            } else blk_one: {
+                try rt.stream.synchronize();
+                try cuda.memory.download(rt.d, msc.logits_f32.ptr, std.mem.sliceAsBytes(self.sc.host_logits));
+                if (self.fault_wrong_token) { _ = try argminF32(self.sc.host_logits); break :blk_one self.weights.mask_token_id; }
+                if (min_margin) |mm| if ((try greedy.hostTop2(self.sc.host_logits)).margin < mm) return col_idx;
+                break :blk_one try pickFn.?(pick_ctx.?, self.sc.host_logits, @intCast(p + col));
+            };
+            out_tokens[col_idx] = chosen;
+            prev_tok = chosen;
+        }
+        return count;
+    }
+};
+
+test "buildDraftIndices, argminF32, and resolveTargetLayers enforce causal and thin-slice invariants" {
+    var out: [3 * 8]i32 = undefined;
+    try buildDraftIndices(&.{ 0, 5, 9, 12, 14, -1 }, 12, 3, 8, &out);
+    try std.testing.expectEqualSlices(i32, &.{ 0, 5, 9, 12, -1, -1, -1, -1 }, out[0..8]);
+    try std.testing.expectEqualSlices(i32, &.{ 0, 5, 9, 12, 13, -1, -1, -1 }, out[8..16]);
+    try std.testing.expectEqualSlices(i32, &.{ 0, 5, 9, 12, 13, 14, -1, -1 }, out[16..24]);
+
+    try std.testing.expectEqual(@as(u32, 2), try argminF32(&.{ 1.5, 0.25, -4.0, -4.0 }));
+    try std.testing.expectError(error.NonFiniteLogits, argminF32(&.{ 0.0, std.math.nan(f32) }));
+
+    const tiny_cfg: config.Text = .{
+        .hidden_size = 32, .intermediate_size = 64, .moe_intermediate_size = 16,
+        .num_hidden_layers = 6, .vocab_size = 101, .q_lora_rank = 12, .kv_lora_rank = 8,
+        .num_attention_heads = 4, .qk_nope_head_dim = 10, .qk_rope_head_dim = 6, .v_head_dim = 16,
+        .index_n_heads = 4, .index_head_dim = 16, .index_topk = 16,
+        .indexer_types = &.{ .full, .full, .shared, .shared, .shared, .full },
+    };
+    const r = try resolveTargetLayers(5, 5, tiny_cfg, 4);
+    try std.testing.expectEqual(@as(usize, 3), r.kv);
+    try std.testing.expectEqual(@as(usize, 1), r.ix);
+}
