+
+    // 2. Upload on TP=1 and TP=4 rank 2: verify widths (6, 8, 12 halves), kv_a row stride (640), and pinned (sk, wk)!
+    var idx = try weights.ShardIndex.openWithTrunk(gpa, io, dir, null, null);
+    defer idx.deinit();
+    try std.testing.expectEqualStrings("inline_exl3", idx.trunk_tag);
