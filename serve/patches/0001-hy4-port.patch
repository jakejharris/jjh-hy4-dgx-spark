+    };
+
+    const dfly_hdr = try buildRealDrafterHeader(aa);
+    try std.testing.expectEqual(@as(usize, 82), dfly_hdr.count());
+
+    var raw_payload_bytes: u64 = 0;
+    var split_count: usize = 0;
+    var loaded_count: usize = 0;
+    var rank_disk_bytes: [4]u64 = @splat(0);
+    var rank_gpu_bytes: [4]u64 = @splat(0);
+    var tp1_gpu_bytes: u64 = 0;
+
+    for (dfly_hdr.keys(), dfly_hdr.values()) |k, e| {
+        const full_b: u64 = e.end - e.begin;
+        raw_payload_bytes += full_b;
+        const loaded = cuda_native.isLoadedDrafterTensor(k, 5);
+        if (loaded) {
+            loaded_count += 1;
+            tp1_gpu_bytes += try cuda_native.entryGpuBytes(&dfly_hdr, k, e, full_t, null);
+        }
+
+        var sum_split: u64 = 0;
+        var any_split = false;
+        for (0..4) |rk_i| {
+            const rk = try ranks.Rank.init(rk_i, 4);
+            const sp = try ranks.headerTensorSpan(&dfly_hdr, k, e, full_t, rk, false);
+            if (sp.bytes() < full_b) {
+                any_split = true;
+                sum_split += sp.bytes();
+            } else {
+                try std.testing.expectEqual(full_b, sp.bytes());
+                try std.testing.expectEqual(@as(u64, 1), sp.count);
+            }
+            if (loaded) {
+                rank_disk_bytes[rk_i] += sp.bytes();
+                rank_gpu_bytes[rk_i] += try cuda_native.entryGpuBytes(&dfly_hdr, k, e, full_t, rk);
+            }
+        }
+        if (any_split) {
