# Local parts-launch overlay for "GO parts" on the 4-Spark ring.
# Layered after:
#   1. S/run/kit/ring-78l-picked-128k.env (ring hosts, master, NCCL IB, image, binary)
#   2. K/launch/ring.relay.env.example    (direct RoCE relay)
#   3. K/launch/ring.parts.env.example    (per-Spark parts defaults)
#   4. this file                          (local paths + 4K parity settings)

PARTS_ROOT="~/hy4/int/parts-78l-4b6b"
MODEL_DIR="${PARTS_ROOT}/common"
DRAFTER_DIR="~/hy4/int/drafter-4b"
SERVE_MODEL_NAME="hy4-exl3"

CONTEXT_LEN="4096"
TF_HY4_TRUNK="4b6b"
TF_HY4_DRAFTER_EXL3="4b"
TF_HY4_DRAFTER_HEAD="4b"
TF_HY4_REPEAT_STABLE="1"
TF_HY4_ROW_COST_TABLE="v1:56.74,v2:68.72,v3:78.15,v4:86.81,v5:95.48,v6:104.15,v7:112.81,d:6.44,e:0.41"
TF_TP_KERNEL_IMAGE="~/hy4/int/winB-bin/tp_mailbox.fatbin"

LOGDIR="/tmp/hy4-winD-parts-launch/serve"
PREFIX="hy4-winD-parts"
