+
+    config_path = args.config or (args.model_dir / "config.json")
+    if not config_path.is_file():
+        raise FileNotFoundError(f"config.json not found at {config_path}")
+
+    raw_cfg = json.loads(config_path.read_text(encoding = "utf-8"))
+    tcfg = raw_cfg.get("text_config", raw_cfg)
+    n_layers = int(tcfg["num_hidden_layers"])
+    end_layer = (n_layers - 1) if args.end_layer is None else min(args.end_layer, n_layers - 1)
+
+    recipes = [load_trunk_recipe(args.recipe)] + [load_trunk_recipe(Path(p)) for p in args.extra_recipe]
+    primary = recipes[0]
+    args.work_dir.mkdir(parents = True, exist_ok = True)
+    args.out_dir.mkdir(parents = True, exist_ok = True)
+
+    print(f"=== Hy4 Trunk EXL3 Quantization Pass ({utc_now()}) ===", flush = True)
+    print(f"    Model dir (read-only): {args.model_dir}", flush = True)
+    print(f"    Output root:           {args.out_dir}", flush = True)
+    print(f"    Work dir:              {args.work_dir}", flush = True)
+    print(f"    Calibration:           {args.cal_data} ({args.cal_rows} rows x {args.cal_cols} cols)", flush = True)
+    print(f"    Layers:                {args.start_layer}..{end_layer} (model has {n_layers})", flush = True)
+    print(f"    Codebook:              {primary['codebook']}", flush = True)
+    print(f"    Output scales:         {primary['out_scales']}", flush = True)
+    for ri, r in enumerate(recipes):
