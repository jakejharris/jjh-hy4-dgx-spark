+def install_exl3_inplace(linear, out_tensors_cpu: dict[str, torch.Tensor], device: torch.device) -> None:
+    from exllamav3.modules.quant import LinearEXL3
+
+    orig_bias = linear.inner.get_bias_tensor() if linear.inner is not None else None
+    linear.inner = None
+    t_dev = {k: v.to(device) for k, v in out_tensors_cpu.items()}
+    linear.inner = LinearEXL3(
+        linear.config,
+        linear.in_features,
+        linear.out_features,
+        t_dev.get("scale"),
+        t_dev.get("su"),
+        t_dev.get("sv"),
+        t_dev.get("suh"),
+        t_dev.get("svh"),
+        t_dev.get("trellis"),
+        t_dev.get("mcg"),
+        t_dev.get("mul1"),
+        orig_bias,
+        linear.out_dtype,
+        key = linear.key,
+    )
+    linear.quant_type = "exl3"
