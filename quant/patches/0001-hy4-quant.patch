+def run_optional_lm_head(
+    recipes: list[dict],
+    source: ModelSource,
+    out_dir: Path,
+    work_dir: Path,
+    state: torch.Tensor | None,
+    device: torch.device,
+    remote_workers: list[tuple[str, int]],
+) -> None:
+    active = [r for r in recipes if r["lm_head_bits"] is not None]
+    if not active:
+        return
+    t0 = time.monotonic()
+    shard = source.tensor_shard("lm_head.weight")
+    if shard is None:
+        print(" !! lm_head_bits requested but lm_head.weight not found in model-dir; skipping", flush = True)
+        return
+    with safe_open(str(shard), framework = "pt", device = "cpu") as f:
+        w_bf16 = f.get_tensor("lm_head.weight")  # [N=120832, K=6144]
+    n_log, k_log = int(w_bf16.shape[0]), int(w_bf16.shape[1])
+    k_pad = (k_log + 127) // 128 * 128
+    n_pad = (n_log + 127) // 128 * 128
+    w_t = torch.zeros((k_pad, n_pad), dtype = torch.float16)
+    w_t[:k_log, :n_log] = w_bf16.t().to(torch.float16)
+    del w_bf16
+
+    # If we have post-L77 state and hc_head + model.norm shards, compute calibrated lm_head Hessian
+    H_final = None
+    if state is not None and source.tensor_shard("model.norm.weight") is not None and source.tensor_shard("model.hc_head.hc_head_fn") is not None:
+        from exllamav3.model.model import Model
+        from exllamav3.modules.quant.exl3_lib.hessian_packed import accumulate_, packed_numel
+        from exllamav3.modules.quant.exl3_lib.quantize import finalize_capture_H
+
+        head_shards = sorted({
+            source.tensor_shard("model.norm.weight"),
+            source.tensor_shard("model.hc_head.hc_head_fn"),
+            shard,
+        })
+        cfg, tmp_dir = source.make_scoped_config(head_shards)
+        try:
+            model = Model.from_config(cfg)
+            hc_head = model.modules[-3]
+            norm = model.modules[-2]
+            hc_head.load(device)
+            norm.load(device)
+            H_buf = torch.zeros(packed_numel(k_pad), dtype = torch.float32, device = device)
+            count = 0
+            with torch.inference_mode():
+                for i in range(state.shape[0]):
+                    x = state[i : i + 1].to(device = device, dtype = state.dtype)
+                    x = hc_head.forward(x, {})
+                    x = norm.forward(x, {}, out_dtype = torch.half)
+                    flat = x.reshape(-1, k_log)
+                    if k_pad > k_log:
+                        flat = torch.nn.functional.pad(flat, (0, k_pad - k_log))
+                    accumulate_(H_buf, flat)
+                    count += flat.shape[0]
+            hc_head.unload()
+            norm.unload()
+            cfg.stc.close()
+            H_final = {
+                "H": H_buf,
+                "packed": True,
+                "n": k_pad,
+                "first_key": "lm_head",
+                "count": count,
+                "finalized": False,
+                "num_total": count * k_pad,
+                "device": device,
+            }
+            finalize_capture_H(H_final, {"seed": 999, "sigma_reg": 0.025}, verbose = False)
+            H_final = {k: (v.detach().cpu() if isinstance(v, torch.Tensor) else v) for k, v in H_final.items()}
+            print(f" -- Captured calibrated lm_head Hessian ({count} tokens) in {time.monotonic() - t0:.1f}s", flush = True)
+        finally:
+            shutil.rmtree(tmp_dir, ignore_errors = True)
+
+    if H_final is None:
+        H_final = make_uncalibrated_H(k_pad, "lm_head", device, seed = 999)
+        print(" -- Using uncalibrated EXL3 Hessian for standalone lm_head sidecar", flush = True)
+
+    jobs = []
+    for r in active:
+        jobs.append({
+            "job_id": f"{r['profile']}::lm_head",
+            "key": "lm_head",
+            "weight_cpu": w_t,
+            "H_data": H_final,
+            "bpw": r["lm_head_bits"],
+            "seed": 999,
+            "local_only": False,
+        })
+    res = quantize_jobs_distributed(jobs, device, remote_workers, work_dir)
+    for r in active:
+        _, out_cpu, _ = res[f"{r['profile']}::lm_head"]
+        spec = [{"key": "lm_head", "k_logical": k_log, "n_logical": n_log, "k_pad": k_pad, "n_pad": n_pad, "bpw": r["lm_head_bits"]}]
+        pdir = out_dir / r["profile"]
+        wm, mats, nbytes = verify_and_pack_sidecar(spec, {"lm_head": out_cpu}, r["profile"], "lm_head", pdir / "lm_head.safetensors")
+        update_trunk_index(pdir, r, wm, mats, nbytes, extra_tag = "lm_head")
+    print(f" -- Finished lm_head sidecar(s) in {time.monotonic() - t0:.1f}s", flush = True)
+
+
+def run_optional_dfly(
+    recipes: list[dict],
+    source: ModelSource,
+    out_dir: Path,
+    work_dir: Path,
+    device: torch.device,
+    remote_workers: list[tuple[str, int]],
+) -> None:
+    active = [r for r in recipes if r["dfly_bits"] is not None]
+    if not active:
+        return
+    t0 = time.monotonic()
+    dfly_keys = sorted(k for k in source.weight_map if k.startswith("model.dfly_layers.") and k.endswith(".weight"))
+    if not dfly_keys:
+        print(" !! dfly_bits requested but model.dfly_layers.* not found in model-dir; skipping", flush = True)
+        return
+
+    # Select standard quantizable 2D linears (exclude 1D norms, kv_b_proj, confidence_head.proj unless overridden)
+    target_prefixes: list[str] = []
+    for k in dfly_keys:
+        pref = k[: -len(".weight")]
+        if pref in DFLY_TOP_LINEARS or any(pref.endswith("." + s) for s in DFLY_LAYER_LINEAR_SUFFIXES):
+            target_prefixes.append(pref)
+
+    # Load all target weights once from the dfly shard
+    loaded: dict[str, tuple[torch.Tensor, int, int, int, int]] = {}
+    by_shard: dict[Path, list[str]] = {}
+    for pref in target_prefixes:
+        sh = source.tensor_shard(pref + ".weight")
+        if sh is not None:
+            by_shard.setdefault(sh, []).append(pref)
+    for sh, prefs in by_shard.items():
+        with safe_open(str(sh), framework = "pt", device = "cpu") as f:
+            for pref in prefs:
+                w = f.get_tensor(pref + ".weight")  # [N_log, K_log]
+                if w.dim() != 2:
+                    continue
+                n_log, k_log = int(w.shape[0]), int(w.shape[1])
+                k_pad = (k_log + 127) // 128 * 128
+                n_pad = (n_log + 127) // 128 * 128
+                wt = torch.zeros((k_pad, n_pad), dtype = torch.float16)
+                wt[:k_log, :n_log] = w.t().to(torch.float16)
+                loaded[pref] = (wt, k_log, n_log, k_pad, n_pad)
+
+    jobs = []
+    specs_by_profile: dict[str, list[dict]] = {r["profile"]: [] for r in active}
+    for r in active:
+        for idx, pref in enumerate(sorted(loaded.keys())):
+            bpw = r["dfly_overrides"].get(pref, r["dfly_bits"])
+            if bpw >= 16:
+                continue
+            wt, k_log, n_log, k_pad, n_pad = loaded[pref]
+            hd = make_uncalibrated_H(k_pad, pref, device, seed = 2000 + idx)
+            jobs.append({
+                "job_id": f"{r['profile']}::{pref}",
+                "key": pref,
+                "weight_cpu": wt,
+                "H_data": hd,
+                "bpw": bpw,
+                "seed": 2000 + idx,
+                "local_only": False,
+            })
+            specs_by_profile[r["profile"]].append({
+                "key": pref, "k_logical": k_log, "n_logical": n_log, "k_pad": k_pad, "n_pad": n_pad, "bpw": bpw,
+            })
+
+    print(f" -- Quantizing {len(jobs)} dfly_layers matrices across {1 + len(remote_workers)} GPU(s)", flush = True)
+    res = quantize_jobs_distributed(jobs, device, remote_workers, work_dir)
+    for r in active:
+        out_map = {s["key"]: res[f"{r['profile']}::{s['key']}"][1] for s in specs_by_profile[r["profile"]]}
+        pdir = out_dir / r["profile"]
+        wm, mats, nbytes = verify_and_pack_sidecar(
+            specs_by_profile[r["profile"]], out_map, r["profile"], "dfly_layers", pdir / "dfly_layers.safetensors"
+        )
+        update_trunk_index(pdir, r, wm, mats, nbytes, extra_tag = "dfly_layers")
+    print(f" -- Finished dfly_layers sidecar(s) in {time.monotonic() - t0:.1f}s", flush = True)
+
+
+def check_farm_state(farm_state_path: Path | None, layer_idx: int) -> tuple[bool, str | None]:
+    """Check synced coordinator state.json for layer verification and main-job health.
+
+    Returns (verified_ok, stop_reason):
+      - If farm_state_path is None: returns (True, None) (relies on local staged index.json).
+      - If main job reported error, or stopped/exited without producing layer_idx: returns (False, reason).
+      - If layer_idx is in verified_layers (post mul1/k2/0-NaN check): returns (True, None).
+      - Otherwise: returns (False, None) -> keep waiting.
+    """
+    if farm_state_path is None:
+        return True, None
+    if not farm_state_path.is_file():
+        return False, None
+    try:
+        st = json.loads(farm_state_path.read_text(encoding = "utf-8"))
+    except Exception:
+        return False, None
+    err = str(st.get("error") or "").strip()
+    verified = set(int(x) for x in (st.get("verified_layers") or []))
+    done = set(int(x) for x in (st.get("layers_done") or []))
+    if layer_idx in verified and layer_idx in done:
+        return True, None
+    if err:
+        return False, f"main job error: {err}"
+    cstatus = str(st.get("container_status") or "")
+    stopped = bool(st.get("stopped", False))
+    if stopped or (cstatus and not cstatus.startswith("running")):
+        return False, f"main job stopped/exited (status={cstatus!r}, stopped={stopped}) before layer {layer_idx}"
+    return False, None
+
