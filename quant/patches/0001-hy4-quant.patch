index 0000000000000000000000000000000000000000..c954568e04019311d04b1bd8f699755750891dce
--- /dev/null
+++ b/scripts/hy4_oracle_dump.py
@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""Run ExLlamaV3 HyV4VLModel forward on oracle inputs and dump all oracle parity keys."""
+from __future__ import annotations
+
+import argparse
+import time
+from pathlib import Path
+
+import torch
+from safetensors.torch import load_file, save_file
+
+from exllamav3.model.config import Config
+from exllamav3.model.model import Model
+from exllamav3.modules import TransformerBlock
+from exllamav3.modules.hyv4 import HyV4MoE
+
+
+@torch.inference_mode()
+def run_case(model: Model, input_ids: torch.Tensor, device: torch.device) -> dict[str, torch.Tensor]:
+    records: dict[str, torch.Tensor] = {}
+    records["input_ids"] = input_ids.detach().cpu().contiguous().clone()
+
+    params: dict = {"oracle_capture": records}
+    x = model.prepare_inputs(input_ids.to("cpu"), params)
+
+    for module in model.modules:
+        x = module.prepare_for_device(x, params)
+        if isinstance(module, TransformerBlock):
+            idx = module.layer_idx
+            prefix = f"layer.{idx:03d}."
+            records[prefix + "streams_in"] = x.detach().cpu().contiguous().clone()
+
+            # Attention sublayer (mirrors TransformerBlock.forward)
+            hc_post, hc_comb, y, normed = module.attn_hc.mix_norm(x, params, module.attn_norm)
+            if module.attn_norm and not normed:
+                y = module.attn_norm.forward(y, params, out_dtype = torch.half)
+            else:
+                y = y.half()
+            attn_out = module.attn.forward(y, params)
+            records[prefix + "attention_out"] = attn_out.detach().cpu().contiguous().clone()
+            x = module.attn_hc.apply_(x, attn_out, hc_post, hc_comb, params)
+
+            # MLP / MoE sublayer (mirrors TransformerBlock.forward)
+            hc_post, hc_comb, y, normed = module.mlp_hc.mix_norm(x, params, module.mlp_norm)
+            if module.mlp_norm and not normed:
+                y = module.mlp_norm.forward(y, params, out_dtype = torch.half)
+            else:
+                y = y.half()
+
+            if isinstance(module.mlp, HyV4MoE):
+                orig_routing_fn = module.mlp.routed.routing_fn
+                bsz_t, seq_t = y.shape[:2]
+
+                def _wrapped_routing(bsz, cfg, z, p, _orig = orig_routing_fn, _pref = prefix, _b = bsz_t, _s = seq_t):
+                    sel, w = _orig(bsz, cfg, z, p)
+                    sel_sorted, order = sel.sort(dim = -1)
+                    w_sorted = w.float().gather(-1, order)
+                    records[_pref + "router_experts"] = sel_sorted.reshape(_b, _s, -1).detach().cpu().contiguous().clone()
+                    records[_pref + "router_weights"] = w_sorted.reshape(_b, _s, -1).detach().cpu().contiguous().clone()
+                    return sel, w
+
+                module.mlp.routed.routing_fn = _wrapped_routing
+                try:
+                    mlp_out = module.mlp.forward(y, params)
+                finally:
+                    module.mlp.routed.routing_fn = orig_routing_fn
+                records[prefix + "moe_out"] = mlp_out.detach().cpu().contiguous().clone()
+            else:
+                mlp_out = module.mlp.forward(y, params)
+                records[prefix + "dense_out"] = mlp_out.detach().cpu().contiguous().clone()
+
+            x = module.mlp_hc.apply_(x, mlp_out, hc_post, hc_comb, params)
+            records[prefix + "streams_out"] = x.detach().cpu().contiguous().clone()
+        else:
+            x = module.forward(x, params)
+
+    records["logits"] = x.float().detach().cpu().contiguous().clone()
+    return records
+
+
+def main():
+    ap = argparse.ArgumentParser(description = __doc__)
+    ap.add_argument("--model-dir", type = Path, required = True, help = "Directory with config.json and safetensors")
+    ap.add_argument("--ref-dumps", type = Path, required = True, help = "Directory with prompt16.safetensors and prune48.safetensors")
+    ap.add_argument("--out-dir", type = Path, required = True, help = "Output directory for candidate dumps")
+    ap.add_argument("--cases", nargs = "+", default = ["prompt16", "prune48"])
+    ap.add_argument("--device", default = "cuda:0")
+    args = ap.parse_args()
+
+    device = torch.device(args.device)
+    t0 = time.time()
+    config = Config.from_directory(str(args.model_dir))
+    model = Model.from_config(config)
+    for m in model.modules:
+        m.load(torch.device("cpu") if m.caps.get("prefer_cpu") else device)
+    t_load = time.time() - t0
+    print(f"Loaded {config.architecture} ({config.num_hidden_layers} layers) in {t_load:.3f}s")
+
+    args.out_dir.mkdir(parents = True, exist_ok = True)
+    for case in args.cases:
+        ref = load_file(str(args.ref_dumps / f"{case}.safetensors"))
+        input_ids = ref["input_ids"]
+        tc = time.time()
+        out = run_case(model, input_ids, device)
+        dt = time.time() - tc
+        out_path = args.out_dir / f"{case}.safetensors"
+        save_file({k: v.detach().cpu().contiguous().clone() for k, v in out.items()}, str(out_path))
+        print(f"{case}: shape={tuple(input_ids.shape)} keys={len(out)} time={dt:.3f}s -> {out_path}")
+
+
+if __name__ == "__main__":
+    main()
