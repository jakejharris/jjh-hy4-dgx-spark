@@ -0,0 +1,209 @@
+#!/usr/bin/env python3
+"""Two-layer tiny convert + resume (with and without lm_head) + compile + reload smoke test."""
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import torch
+from safetensors.torch import load_file, save_file
+
+
+def make_tiny_tokenizer(dst: Path, vocab_size: int):
+    vocab = {"<pad>": 0, "<bos>": 1, "<eos>": 2, " ": 3}
+    for i in range(4, vocab_size):
+        vocab[f"tok{i}"] = i
+    tok = {
+        "version": "1.0",
+        "truncation": None,
+        "padding": None,
+        "added_tokens": [
+            {"id": 0, "content": "<pad>", "single_word": False, "lstrip": False, "rstrip": False, "normalized": False, "special": True},
+            {"id": 1, "content": "<bos>", "single_word": False, "lstrip": False, "rstrip": False, "normalized": False, "special": True},
+            {"id": 2, "content": "<eos>", "single_word": False, "lstrip": False, "rstrip": False, "normalized": False, "special": True},
+        ],
+        "normalizer": None,
+        "pre_tokenizer": None,
+        "post_processor": None,
+        "decoder": None,
+        "model": {"type": "WordLevel", "vocab": vocab, "unk_token": "<pad>"},
+    }
+    (dst / "tokenizer.json").write_text(json.dumps(tok, indent = 2))
+    (dst / "tokenizer_config.json").write_text(json.dumps({
+        "bos_token": "<bos>",
+        "eos_token": "<eos>",
+        "pad_token": "<pad>",
+        "tokenizer_class": "PreTrainedTokenizerFast",
+    }, indent = 2))
+
+
+def run_cmd(cmd: list[str], cwd: Path | None = None):
+    print("CMD:", " ".join(cmd), flush = True)
+    t0 = time.time()
+    p = subprocess.run(cmd, cwd = cwd, text = True)
+    dt = time.time() - t0
+    if p.returncode != 0:
+        raise RuntimeError(f"Command failed (rc={p.returncode}) after {dt:.1f}s: {' '.join(cmd)}")
+    print(f"OK ({dt:.2f}s)", flush = True)
+    return dt
+
+
+def main():
+    src_repo = Path(sys.argv[1])
+    tiny_dir = Path(sys.argv[2])
+    work_root = Path(sys.argv[3])
+    ref_dumps = Path(sys.argv[4])
+
+    if work_root.exists():
