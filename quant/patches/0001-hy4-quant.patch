index 0000000000000000000000000000000000000000..7d2b6a0ec0b3136276da6c4cd67dbe8795b53a18
--- /dev/null
+++ b/exllamav3/architecture/hy_v4_vl.py
@@ -0,0 +1,282 @@
+from __future__ import annotations
+from typing_extensions import override
+import torch
+
+from ..model.config import Config, no_default
+from ..model.model import Model
+from ..modules import (
+    RMSNorm, Embedding, Linear, ExpandStreams, TransformerBlock, GatedMLP,
+)
+from ..modules.attn import prepare_for_attn
+from ..modules.hyv4 import (
+    HyV4Attention, HyV4VLIndexer, HyV4HyperConnection, HyV4HyperHead, HyV4MoE, HyV4VLLMHead,
+)
+
+# Full Hy4 (Tencent HYV4VLForConditionalGeneration): 78 layers (1 dense + 77 MoE with 256
+# fused 3D routed experts on hidden 6144 + 1 shared expert), gated MLA with learned sinks,
+# token-level DSA indexer (21 full + 57 shared layers), 4-stream iHC with learned head.
+# Vision tower (vit.*) and DFly2 drafter (model.dfly_layers.*) stay uncalibrated and are
+# copied through unquantized by compile.py via get_additional_compiled_tensors().
+
+_DEFAULT_ROPE_THETA = 10000000.0
+
+
+class HyV4VLConfig(Config):
+    arch_string = "HYV4VLForConditionalGeneration"
+    cfg_prefix = "text_config->"
+
+    def __init__(self, directory: str, model_classes: dict | None = None, **kwargs):
+        super().__init__(directory, model_classes or {"text": HyV4VLModel}, **kwargs)
+        p = self.cfg_prefix
+
+        def r(t, key, default = no_default):
+            return self.read_cfg(t, [p + key, key], default)
+
+        self.vocab_size = r(int, "vocab_size")
+        self.hidden_size = r(int, "hidden_size")
+        self.intermediate_size = r(int, "intermediate_size")
+        self.moe_intermediate_size = r(int, "moe_intermediate_size")
+        self.num_hidden_layers = r(int, "num_hidden_layers")
+        self.num_q_heads = r(int, "num_attention_heads")
+        self.q_lora_rank = r(int, "q_lora_rank")
+        self.kv_lora_rank = r(int, "kv_lora_rank")
+        self.qk_nope = r(int, "qk_nope_head_dim")
+        self.qk_rope = r(int, "qk_rope_head_dim")
+        self.v_head_dim = r(int, "v_head_dim")
+
+        self.num_experts = r(int, "n_routed_experts")
+        self.num_experts_per_tok = r(int, "num_experts_per_tok")
+        self.num_shared_experts = r(int, "n_shared_experts", 1)
+        self.routed_scaling_factor = r(float, "routed_scaling_factor", 2.827)
+        self.swiglu_limit = r(float, "swiglu_limit", 10.0)
+        self.n_group = r(int, "n_group", 1)
+        self.topk_group = r(int, "topk_group", 1)
+
+        self.rms_norm_eps = r(float, "rms_norm_eps", 1e-5)
+        self.index_n_heads = r(int, "index_n_heads", 32)
+        self.index_head_dim = r(int, "index_head_dim", 128)
+        self.index_topk = r(int, "index_topk", 2048)
+        self.indexer_types = r(list, "indexer_types")
+        assert len(self.indexer_types) >= self.num_hidden_layers and \
+            all(t in ("full", "shared") for t in self.indexer_types) and \
+            self.indexer_types[0] == "full", \
+            f"Unexpected indexer_types: {self.indexer_types}"
+
+        first_k_dense = r(int, "first_k_dense_replace", 1)
+        self.mlp_layer_types = r(
+            list, "mlp_layer_types",
+            ["dense" if i < first_k_dense else "sparse" for i in range(self.num_hidden_layers)],
+        )
+        assert len(self.mlp_layer_types) >= self.num_hidden_layers and \
+            all(t in ("dense", "sparse") for t in self.mlp_layer_types), \
+            f"Unexpected mlp_layer_types: {self.mlp_layer_types}"
+
+        self.layer_types = r(
+            list, "layer_types",
+            ["deepseek_sparse_attention"] * self.num_hidden_layers,
+        )
+        self.max_position_embeddings = r(int, "max_position_embeddings", 1048576)
+        self.tie_word_embeddings = r(bool, "tie_word_embeddings", False)
+
+        self.hc_mult = r(int, "hc_mult", 4)
+        self.hc_magnitude = r(float, "hc_magnitude", 2.0)
+        self.hc_eps = r(float, "hc_eps", 1e-6)
+
+        self.rope_theta = self.read_cfg(
+            float,
+            [
+                p + "rope_parameters->rope_theta",
+                p + "rope_theta",
+                "rope_parameters->rope_theta",
+                "rope_theta",
+            ],
+            _DEFAULT_ROPE_THETA,
+        )
+        self.head_dim = self.qk_nope + self.qk_rope
+        # Preserve original BF16/FP32 dtypes and unpadded shapes for unquantized weights during convert.py
+        self.preserve_unquantized_source = True
+
+
+class HyV4VLModel(Model):
+    config_class = HyV4VLConfig
+
+    @staticmethod
+    @override
+    def get_additional_compiled_tensors(config: HyV4VLConfig) -> dict:
+        vit_tensors = config.stc.list_tensors(prefix = "vit")
+        dfly_tensors = config.stc.list_tensors(prefix = "model.dfly_layers")
+        return vit_tensors | dfly_tensors
+
+    def __init__(self, config: HyV4VLConfig, key_prefix: str = "model", **kwargs):
+        super().__init__(config, **kwargs)
+        self.caps.update({"supports_tp": False})
+
+        self.modules += [
+            Embedding(
+                config = config,
+                key = f"{key_prefix}.embed_tokens",
+                vocab_size = config.vocab_size,
+                hidden_size = config.hidden_size,
+            ),
+            ExpandStreams(
+                config = config,
+                key = "hc_expand",
+                hc_mult = config.hc_mult,
+            ),
+        ]
+        self.first_block_idx = len(self.modules)
+
+        for idx in range(config.num_hidden_layers):
+            key = f"{key_prefix}.layers.{idx}"
+            indexer_mode = config.indexer_types[idx]
+            indexer = None
+            if indexer_mode == "full":
+                indexer = HyV4VLIndexer(
+                    config = config,
+                    key = f"{key}.self_attn.indexer",
+                    hidden_size = config.hidden_size,
+                    q_lora_rank = config.q_lora_rank,
+                    num_heads = config.index_n_heads,
+                    head_dim = config.index_head_dim,
