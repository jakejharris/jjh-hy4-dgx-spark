+def main() -> None:
+    ap = argparse.ArgumentParser(description = __doc__)
+    ap.add_argument("--model-dir", type = Path, required = True, help = "Existing lossless-trunk + 3b-routed model dir (read-only)")
+    ap.add_argument("--extra-model-dir", type = Path, default = None, help = "Optional fallback dir/file for lm_head/dfly_layers (e.g. /extra-model)")
+    ap.add_argument("--config", type = Path, default = None, help = "Path to full 78-layer config.json (default: <model-dir>/config.json)")
+    ap.add_argument("--out-dir", type = Path, required = True, help = "Output root (writes <out-dir>/<profile>/ sidecars)")
+    ap.add_argument("--work-dir", type = Path, required = True, help = "Scratch/checkpoint directory (separate from main farm work_dir)")
+    ap.add_argument("--recipe", type = Path, required = True, help = "Primary trunk recipe YAML (governs sequential state propagation)")
+    ap.add_argument("--extra-recipe", type = Path, action = "append", default = [], help = "Optional additional trunk recipe YAML(s) quantized in the same pass")
+    ap.add_argument("--cal-data", type = Path, required = True, help = "Frozen calibration token safetensors (e.g. /work/farm-250x2048.safetensors)")
+    ap.add_argument("--cal-rows", type = int, default = 250)
+    ap.add_argument("--cal-cols", type = int, default = 2048)
+    ap.add_argument("--start-layer", type = int, default = 0)
+    ap.add_argument("--end-layer", type = int, default = None, help = "Inclusive last layer (default: num_hidden_layers - 1)")
+    ap.add_argument("--workers", type = str, default = None, help = "Comma-separated remote worker host:port list (overridden by EXL3_REMOTE_WORKERS_FILE)")
+    ap.add_argument("--device", type = str, default = "cuda:0")
+    ap.add_argument("--resume", action = "store_true", help = "Resume from <work-dir>/ckpt/")
+    ap.add_argument("--no-checkpoint", action = "store_true", help = "Skip saving state checkpoints")
+    ap.add_argument("--follow", action = "store_true", help = "Trail the main job: wait for each layer L to be verified and staged before quantizing L")
+    ap.add_argument("--farm-state", type = Path, default = None, help = "Path to synced coordinator state.json for verified_layers + failure detection in --follow mode")
+    ap.add_argument("--poll-s", type = int, default = 20, help = "Poll interval in seconds when waiting in --follow mode (default 20)")
+    ap.add_argument("--stop-file", type = Path, default = None, help = "If this file appears, save checkpoint and exit cleanly at the next layer boundary")
+    ap.add_argument("--extras-only", action = "store_true", help = "Skip decoder layers and run only lm_head/dfly_layers sidecars enabled in recipe(s)")
+    args = ap.parse_args()
+
+    stop_flag = {"stop": False}
+    def _on_sig(signum, _frame):
+        print(f"\n[{utc_now()}] Received signal {signum}; will stop cleanly after current layer", flush = True)
+        stop_flag["stop"] = True
+    signal.signal(signal.SIGTERM, _on_sig)
+    signal.signal(signal.SIGINT, _on_sig)
+
+    # Prevent PyTorch 2.13 BaseDSL flag hijacking
+    sys.argv = [sys.argv[0]]
+    if os.environ.get("TORCH_ALLOW_TF32_CUBLAS_OVERRIDE") is not None:
+        raise RuntimeError("TORCH_ALLOW_TF32_CUBLAS_OVERRIDE must be unset")
+
+    from exllamav3.model.model import Model
+    from exllamav3.modules import Linear, TransformerBlock
+    from exllamav3.modules.quant.exl3_lib import quantize as exl3_quantize
+    from exllamav3.modules.quant.exl3_lib.quantize import finalize_capture_H
+    from exllamav3.util.memory import free_mem, is_integrated_device
+
+    device = torch.device(args.device)
+    dev_idx = device.index if device.index is not None else 0
+    if device.type == "cuda":
+        torch.cuda.set_device(device)
