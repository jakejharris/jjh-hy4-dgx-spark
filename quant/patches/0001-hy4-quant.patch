+        )
+
+    source = ModelSource(args.model_dir, config_path, args.extra_model_dir)
+    t_pass_start = time.monotonic()
+
+    if args.extras_only:
+        remote_workers = read_remote_workers(args.workers)
+        write_trunk_state(args.work_dir, {"status": "running_extras", "recipes": [r["profile"] for r in recipes]})
+        run_optional_lm_head(recipes, source, args.out_dir, args.work_dir, None, device, remote_workers)
+        run_optional_dfly(recipes, source, args.out_dir, args.work_dir, device, remote_workers)
+        dt_e = round(time.monotonic() - t_pass_start, 2)
+        write_trunk_state(args.work_dir, {"status": "done_extras", "total_wall_s": dt_e, "recipes": [r["profile"] for r in recipes]})
+        print(f"\n=== TRUNK EXTRAS COMPLETE in {dt_e:.1f}s ({dt_e / 60:.2f}m) ===", flush = True)
+        return
+
+    cal_ids = load_cal_tokens(args.cal_data, args.cal_rows, args.cal_cols)
+
+    cur_layer = args.start_layer
+    state: torch.Tensor
+    preserves: list[dict]
+    layer_timings: list[dict] = []
+
+    if args.resume:
+        loaded = load_checkpoint(args.work_dir)
+        if loaded is not None:
+            cur_layer, state, preserves, layer_timings = loaded
+            print(f" -- Resumed checkpoint at layer {cur_layer} (state {tuple(state.shape)})", flush = True)
+        else:
+            print(" -- --resume given but no checkpoint found; starting fresh from embed_tokens", flush = True)
+            state = build_initial_state(source, cal_ids, device)
+            preserves = [{} for _ in range(state.shape[0])]
+    else:
+        if cur_layer != 0:
+            raise ValueError("--start-layer > 0 requires --resume with a checkpoint")
+        t_init = time.monotonic()
+        state = build_initial_state(source, cal_ids, device)
+        preserves = [{} for _ in range(state.shape[0])]
+        print(f" -- Built initial state {tuple(state.shape)} from embed_tokens + hc_expand in {time.monotonic() - t_init:.2f}s", flush = True)
+
+    stopped_early = False
+    for layer_idx in range(cur_layer, end_layer + 1):
+        if stop_flag["stop"] or (args.stop_file and args.stop_file.exists()):
+            print(f"[{utc_now()}] Clean stop requested before layer {layer_idx}; checkpoint already saved.", flush = True)
+            write_trunk_state(args.work_dir, {
+                "status": "stopped_clean", "next_layer": layer_idx,
+                "layers_done": [r["layer"] for r in layer_timings], "recipes": [r["profile"] for r in recipes],
+            })
+            stopped_early = True
+            break
+
+        # Follow mode: wait until main job verifies layer_idx AND local staged file + index entry exist
+        if args.follow:
+            waited = False
+            while True:
+                if stop_flag["stop"] or (args.stop_file and args.stop_file.exists()):
+                    print(f"[{utc_now()}] Clean stop requested while waiting for layer {layer_idx}", flush = True)
+                    write_trunk_state(args.work_dir, {
+                        "status": "stopped_clean", "next_layer": layer_idx,
+                        "layers_done": [r["layer"] for r in layer_timings], "recipes": [r["profile"] for r in recipes],
+                    })
+                    stopped_early = True
+                    break
+                farm_ok, stop_reason = check_farm_state(args.farm_state, layer_idx)
+                if stop_reason is not None:
+                    print(f"[{utc_now()}] Stopping cleanly in --follow mode: {stop_reason}", flush = True)
+                    write_trunk_state(args.work_dir, {
+                        "status": "stopped_main_job", "reason": stop_reason, "next_layer": layer_idx,
+                        "layers_done": [r["layer"] for r in layer_timings], "recipes": [r["profile"] for r in recipes],
+                    })
+                    stopped_early = True
+                    break
+                file_ok = source.refresh_layer(layer_idx)
+                if farm_ok and file_ok:
+                    if waited:
+                        print(f"[{utc_now()}] Layer {layer_idx} verified and staged; resuming.", flush = True)
+                    break
+                if not waited:
+                    print(
+                        f"[{utc_now()}] Waiting for layer {layer_idx} (farm_verified={farm_ok}, staged_file={file_ok}; polling every {args.poll_s}s)...",
+                        flush = True,
+                    )
+                    write_trunk_state(args.work_dir, {
+                        "status": "waiting", "waiting_for_layer": layer_idx,
+                        "layers_done": [r["layer"] for r in layer_timings], "recipes": [r["profile"] for r in recipes],
+                    })
+                    waited = True
+                time.sleep(args.poll_s)
+            if stopped_early:
+                break
+
+        write_trunk_state(args.work_dir, {
+            "status": "running", "current_layer": layer_idx,
+            "layers_done": [r["layer"] for r in layer_timings], "recipes": [r["profile"] for r in recipes],
+        })
+        t_layer0 = time.monotonic()
+        remote_workers = read_remote_workers(args.workers)
+        print(
+            f"\n[{utc_now()}] === Layer {layer_idx}/{end_layer} (GPUs: local + {len(remote_workers)} remote: {remote_workers}) ===",
+            flush = True,
+        )
+
+        # 1. Load ONLY this layer from read-only model_dir
+        t0 = time.monotonic()
+        layer_shards = source.shards_for_prefix(f"model.layers.{layer_idx}.")
+        cfg, tmp_cfg_dir = source.make_scoped_config(layer_shards)
+        try:
+            model = Model.from_config(cfg)
+            module_idx = model.first_block_idx + layer_idx
+            block = model.modules[module_idx]
+            assert isinstance(block, TransformerBlock) and block.layer_idx == layer_idx
+
+            defer = block.can_defer_load()
+            if defer:
+                cfg.stc.begin_deferred_load()
+            try:
+                block.load(device)
+            finally:
+                if defer:
+                    cfg.stc.end_deferred_load()
+            cfg.stc.close()
+            t_load = time.monotonic() - t0
+
+            # Identify trunk Linears in this layer (5 on dense L0, 8 on MoE L1..L77)
+            trunk_linears = []
+            for m in block:
+                if isinstance(m, Linear) and any(m.key.endswith("." + s) for s in ALL_TRUNK_SUFFIXES):
+                    trunk_linears.append(m)
+            trunk_qmaps = {l.qmap for l in trunk_linears if l.qmap}
+
+            # 2. Capture Hessians for trunk matrices ONLY (skips all 256 routed experts!)
+            t0 = time.monotonic()
+            capture_H = capture_trunk_hessians(block, state, preserves, device, trunk_qmaps)
+            t_cap = time.monotonic() - t0
+
+            # Finalize Hessians once on GPU and keep CPU copies for remote dispatch
+            t0 = time.monotonic()
+            finalized_H: dict[str, dict] = {}
+            for qm in sorted(trunk_qmaps):
+                hd = capture_H[qm]
+                finalize_capture_H(hd, {"seed": module_idx, "sigma_reg": 0.025}, verbose = False)
+                # Keep finalized tensors on CPU for safe multi-thread local/remote sharing
+                finalized_H[qm] = {
+                    k: (v.detach().to("cpu") if isinstance(v, torch.Tensor) else v)
+                    for k, v in hd.items()
+                }
+            del capture_H
+            free_mem()
+
+            # Snapshot source weights for all trunk linears (fp16 padded (in_features, out_features) on CPU)
+            weights_cpu: dict[str, torch.Tensor] = {}
+            for l in trunk_linears:
+                weights_cpu[l.key] = l.inner.get_weight_tensor().detach().to("cpu", dtype = torch.float16).contiguous()
+
+            # 3. Build quantization jobs across primary + extra recipes
+            jobs: list[dict] = []
+            specs_by_profile: dict[str, list[dict]] = {r["profile"]: [] for r in recipes}
+            for r in recipes:
+                for l in trunk_linears:
+                    bpw = bits_for_trunk_key(r, l.key)
+                    if bpw >= 16.0:
+                        continue
+                    # Pin o_proj (16384x16384 H = 1.07 GB) to local GPU so we never ship 1 GB H over TCP
+                    local_only = l.in_features >= 16384
+                    jobs.append({
+                        "job_id": f"{r['profile']}::{l.key}",
+                        "key": l.key,
+                        "weight_cpu": weights_cpu[l.key],
+                        "H_data": finalized_H[l.qmap],
+                        "bpw": bpw,
+                        "seed": module_idx,
+                        "local_only": local_only,
+                    })
+                    specs_by_profile[r["profile"]].append({
+                        "key": l.key,
+                        "k_logical": l.in_features_unpadded,
+                        "n_logical": l.out_features_unpadded,
+                        "k_pad": l.in_features,
+                        "n_pad": l.out_features,
+                        "bpw": bpw,
+                    })
+
+            quant_res = quantize_jobs_distributed(jobs, device, remote_workers, args.work_dir)
+            t_enc = time.monotonic() - t0
+
+            # 4. Verify and save sidecar safetensors + trunk.index.json for each recipe
+            t0 = time.monotonic()
+            saved_bytes_by_profile: dict[str, int] = {}
+            for r in recipes:
+                specs = specs_by_profile[r["profile"]]
+                if not specs:
+                    continue
+                out_map = {s["key"]: quant_res[f"{r['profile']}::{s['key']}"][1] for s in specs}
+                pdir = args.out_dir / r["profile"]
+                out_path = pdir / f"model.layers.{layer_idx}.safetensors"
+                wm, mats, nbytes = verify_and_pack_sidecar(specs, out_map, r["profile"], str(layer_idx), out_path)
+                update_trunk_index(pdir, r, wm, mats, nbytes, layer_idx = layer_idx)
+                saved_bytes_by_profile[r["profile"]] = nbytes
+            t_save = time.monotonic() - t0
+
+            # 5. Install PRIMARY recipe's quantized EXL3 trunk matrices in-place and advance state
+            t0 = time.monotonic()
+            if layer_idx < n_layers - 1 or any(r["lm_head_bits"] is not None for r in recipes):
+                for l in trunk_linears:
+                    jid = f"{primary['profile']}::{l.key}"
+                    if jid in quant_res:
+                        install_exl3_inplace(l, quant_res[jid][1], device)
+                preserves = advance_state_layer(block, state, preserves, device)
+            t_adv = time.monotonic() - t0
+
+            block.unload()
+            del quant_res, finalized_H, weights_cpu
+            gc.collect()
+            free_mem()
+        finally:
+            shutil.rmtree(tmp_cfg_dir, ignore_errors = True)
+
+        # 6. Save resumable checkpoint
+        t_ckpt = 0.0
+        if not args.no_checkpoint:
+            t_ckpt = save_checkpoint(args.work_dir, layer_idx + 1, state, preserves, layer_timings)
+
+        t_tot = time.monotonic() - t_layer0
+        rec = {
+            "layer": layer_idx,
+            "finished_utc": utc_now(),
+            "load_s": round(t_load, 2),
+            "capture_s": round(t_cap, 2),
+            "encode_s": round(t_enc, 2),
+            "save_s": round(t_save, 2),
+            "advance_s": round(t_adv, 2),
+            "ckpt_s": round(t_ckpt, 2),
+            "total_s": round(t_tot, 2),
+            "saved_bytes": saved_bytes_by_profile,
+        }
+        layer_timings.append(rec)
+        print(
+            f" -- Layer {layer_idx} DONE in {t_tot:.2f}s ({t_tot / 60:.2f}m): "
+            f"load={t_load:.1f}s cap={t_cap:.1f}s enc={t_enc:.1f}s save={t_save:.1f}s "
+            f"adv={t_adv:.1f}s ckpt={t_ckpt:.1f}s",
+            flush = True,
+        )
+
+    # Optional sidecars (enabled by lm_head_bits / dfly_bits recipe lines; run only on full pass completion)
+    if not stopped_early and end_layer == n_layers - 1:
+        remote_workers = read_remote_workers(args.workers)
+        run_optional_lm_head(recipes, source, args.out_dir, args.work_dir, state, device, remote_workers)
+        run_optional_dfly(recipes, source, args.out_dir, args.work_dir, device, remote_workers)
+
+    summary = {
+        "finished_utc": utc_now(),
+        "stopped_early": stopped_early,
+        "total_wall_s": round(time.monotonic() - t_pass_start, 2),
+        "layers": f"{args.start_layer}..{end_layer}",
+        "cal_rows": args.cal_rows,
+        "cal_cols": args.cal_cols,
+        "recipes": [r["profile"] for r in recipes],
+        "layer_timings": layer_timings,
+    }
+    atomic_write_json(args.work_dir / "trunk_pass_summary.json", summary)
+    if not stopped_early:
+        write_trunk_state(args.work_dir, {
+            "status": "done", "total_wall_s": summary["total_wall_s"],
+            "layers_done": [r["layer"] for r in layer_timings], "recipes": [r["profile"] for r in recipes],
+        })
+    print(f"\n=== TRUNK PASS {'STOPPED CLEANLY' if stopped_early else 'COMPLETE'} in {summary['total_wall_s']:.1f}s ({summary['total_wall_s'] / 60:.2f}m) ===", flush = True)
+
+
+if __name__ == "__main__":
+    main()
