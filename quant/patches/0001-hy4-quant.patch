new file mode 100644
index 0000000000000000000000000000000000000000..c25f3d145f73636eccbfb92252c7e694cfcb2ee0
--- /dev/null
+++ b/farm/make_hy4_recipe.py
@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+"""Generate an ExLlamaV3 per-tensor recipe YAML for full Hy4 (HYV4VLForConditionalGeneration).
+
+Profile:
+  - Routed experts (layers with mlp_layer_types[i] == "sparse"): EXL3 mul1 at expert_bits
+    (with optional down_bits override on a layer range, e.g. --down-bits 4 --down-range 20..76)
+  - All other budgeted Linears (self_attn.{q_a,q_b,kv_a_proj_with_mqa,linear_gate,o_proj},
+    indexer.wq_b on full layers, dense layer 0 mlp.{gate,up,down}_proj,
+    shared_experts.{gate,up,down}_proj): 16 (stored lossless unquantized BF16)
+  - lm_head: head_bits = 16
+  - vit.* and model.dfly_layers.*: copied unquantized by compile.py (not budgeted)
+"""
+import argparse
+import json
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("config", help = "Path to model config.json")
+    ap.add_argument("out", help = "Output recipe.yaml path")
+    ap.add_argument("--expert-bits", type = float, default = 3, help = "Bitrate for routed experts (default 3)")
+    ap.add_argument("--down-bits", type = float, default = None, help = "Optional bitrate for routed down_proj")
+    ap.add_argument("--down-range", type = str, default = None, help = "Inclusive layer range e.g. 20..76 for --down-bits")
+    args = ap.parse_args()
+
+    raw = json.load(open(args.config))
+    cfg = raw.get("text_config", raw)
+    n_layers = cfg["num_hidden_layers"]
+    n_experts = cfg["n_routed_experts"]
+    mlp_types = cfg.get("mlp_layer_types") or ["dense" if i < cfg.get("first_k_dense_replace", 1) else "sparse" for i in range(n_layers)]
+    indexer_types = cfg["indexer_types"]
+
+    down_lo, down_hi = None, None
+    if args.down_bits is not None:
+        if args.down_range:
+            a, b = args.down_range.split("..")
+            down_lo, down_hi = int(a), int(b)
+        else:
+            down_lo, down_hi = 0, n_layers - 1
+
+    def fmt_bits(b):
+        return int(b) if float(b).is_integer() else float(b)
+
+    eb = fmt_bits(args.expert_bits)
+    db = fmt_bits(args.down_bits) if args.down_bits is not None else eb
+
+    # Use pattern rules for routed experts + explicit 16-bit entries for non-experts so the YAML stays compact
+    lines = [
+        f"# Hy4 EXL3 recipe: routed experts @{eb}b (down @{db}b in {down_lo}..{down_hi}), non-experts 16b lossless",
+        f"target_bpw: {eb}",
+        "head_bits: 16",
+        "tensors:",
+    ]
+    n_16 = 0
+    n_exp = 0
+    for i in range(n_layers):
+        p = f"model.layers.{i}"
+        attn_keys = [
+            f"{p}.self_attn.q_a_proj",
+            f"{p}.self_attn.q_b_proj",
+            f"{p}.self_attn.kv_a_proj_with_mqa",
+            f"{p}.self_attn.linear_gate",
+            f"{p}.self_attn.o_proj",
+        ]
+        if indexer_types[i] == "full":
+            attn_keys.append(f"{p}.self_attn.indexer.wq_b")
+        for k in attn_keys:
+            lines.append(f'  "{k}": 16')
+            n_16 += 1
+        if mlp_types[i] == "dense":
+            for proj in ("gate_proj", "up_proj", "down_proj"):
+                lines.append(f'  "{p}.mlp.{proj}": 16')
+                n_16 += 1
+        else:
+            for proj in ("gate_proj", "up_proj", "down_proj"):
+                lines.append(f'  "{p}.mlp.shared_experts.{proj}": 16')
+                n_16 += 1
+            d_bits = db if (down_lo is not None and down_lo <= i <= down_hi) else eb
+            lines.append(f'  "{p}.mlp.experts.*.gate_proj": {eb}')
+            lines.append(f'  "{p}.mlp.experts.*.up_proj": {eb}')
+            lines.append(f'  "{p}.mlp.experts.*.down_proj": {d_bits}')
+            n_exp += 3 * n_experts
+
+    with open(args.out, "w") as f:
+        f.write("\n".join(lines) + "\n")
+    print(f"recipe: layers={n_layers} experts_matrices={n_exp} non_expert_16={n_16} -> {args.out}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/farm/package_hy4_cpu.py b/farm/package_hy4_cpu.py
new file mode 100644
index 0000000000000000000000000000000000000000..6d36fad729344cc39fef37383281e083eb295c0e
--- /dev/null
+++ b/farm/package_hy4_cpu.py
@@ -0,0 +1,154 @@
+#!/usr/bin/env python3
+"""Package a finished Hy4 EXL3 model on a CPU host with >=400 GB free disk without GPU use.
+
+After the main job stops cleanly right after L77 (module index 79, next_module_idx=80),
+all 78 quantized decoder layers (model.layers.0..77.safetensors) are already SHA-256 verified
+in --staged-layers-dir (e.g. /staged/hy4-exl3). The remaining modules
+(model.embed_tokens, hc_expand, model.hc_head, model.norm, lm_head) are 100% unquantized
+(embed_bits=16, head_bits=16) and are copied verbatim on CPU from --in-dir source shards.
+
+Then exllamav3.conversion.compile.compile_model() packs all 78 layers + unquantized head/embed
++ vit.* + model.dfly_layers.* + non-tensor metadata into standard 8 GB release shards in --out-dir,
+passing compile_model's zero-dropped-tensors check. Never touches the coordinator or any GPU.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import shutil
+import sys
+import time
+from pathlib import Path
+
+SCRIPT_DIR = Path(__file__).resolve().parent
+REPO_ROOT = SCRIPT_DIR.parent
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+
+
+def link_or_copy(src: Path, dst: Path) -> None:
+    if dst.exists() or dst.is_symlink():
+        dst.unlink()
+    try:
+        os.link(src, dst)
+    except OSError:
+        shutil.copy2(src, dst)
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--in-dir", type=Path, required=True, help="Source model dir containing config.json, non-tensor files, and unquantized head/embed/vit/dfly shards")
+    ap.add_argument("--staged-layers-dir", type=Path, required=True, help="Directory holding SHA-256 verified model.layers.0..N.safetensors")
+    ap.add_argument("--work-dir", type=Path, required=True, help="Scratch work dir on packaging host (creates qtensors/ via hard links)")
+    ap.add_argument("--out-dir", type=Path, required=True, help="Destination compiled release directory")
+    ap.add_argument("--args-json", type=Path, required=True, help="Copy of main job args.json (for quantization_config metadata)")
+    ap.add_argument("--shard-size", type=int, default=8192, help="Max shard size in MB (default 8192)")
+    args = ap.parse_args()
+
+    # Guard against PyTorch 2.13 BaseDSL flag hijacking
+    sys.argv = [sys.argv[0]]
+
+    from exllamav3 import Config, Model, Tokenizer
+    from exllamav3.conversion.allocation import create_q_strategy, create_q_strategy_from_recipe
+    from exllamav3.conversion.compile import compile_model
+    from exllamav3.loader.safetensors_alt import save_file
+
+    t0 = time.monotonic()
+    qt_dir = args.work_dir / "qtensors"
+    qt_dir.mkdir(parents=True, exist_ok=True)
+    args.out_dir.mkdir(parents=True, exist_ok=True)
+
+    saved_args = json.loads(args.args_json.read_text(encoding="utf-8"))
+    if saved_args.get("head_bits", 16) != 16 or saved_args.get("embed_bits", 16) != 16:
+        raise ValueError(
+            f"CPU head packaging requires unquantized head_bits=16 and embed_bits=16; "
+            f"got head_bits={saved_args.get('head_bits')} embed_bits={saved_args.get('embed_bits')}"
+        )
+
+    config = Config.from_directory(str(args.in_dir))
+    model = Model.from_config(config)
+    tokenizer = Tokenizer.from_config(config)
+
+    n_layers = int(config.num_hidden_layers)
+    print(f" -- Packaging {config.architecture} ({n_layers} decoder layers) on CPU", flush=True)
+
+    # 1. Hard-link all verified decoder layer files model.layers.0..N-1 into work_dir/qtensors/
+    for l in range(n_layers):
+        fname = f"model.layers.{l}.safetensors"
+        src = args.staged_layers_dir / fname
+        if not src.is_file():
+            raise FileNotFoundError(f"Missing verified layer file: {src}")
+        link_or_copy(src, qt_dir / fname)
+    print(f" -- Linked {n_layers} verified decoder layers from {args.staged_layers_dir} in {time.monotonic() - t0:.2f}s", flush=True)
+
+    # 2. Emit unquantized non-layer modules (embed_tokens, hc_expand, hc_head, norm, lm_head) verbatim on CPU
+    #    matching convert_model.py's preserve_unquantized_source=True output tensors exactly.
+    t_head = time.monotonic()
+    stc = config.stc
+    unquant_specs = [
+        ("model.embed_tokens", ["model.embed_tokens.weight"]),
+        ("hc_expand", []),
+        ("model.hc_head", ["model.hc_head.hc_head_fn", "model.hc_head.hc_head_base", "model.hc_head.hc_head_scale"]),
+        ("model.norm", ["model.norm.weight"]),
+        ("lm_head", ["lm_head.weight"]),
+    ]
+    for mod_key, tensor_keys in unquant_specs:
+        out_path = qt_dir / f"{mod_key}.safetensors"
+        if not tensor_keys:
+            continue
+        tensors = {}
+        for tk in tensor_keys:
+            if not stc.has_tensor(tk):
+                if tk == "lm_head.weight" and config.tie_word_embeddings:
+                    continue
+                raise FileNotFoundError(f"Missing unquantized source tensor {tk} in {args.in_dir}")
+            t = stc.get_tensor(tk, "cpu", allow_bf16=True, float2half=False, no_defer=True).contiguous()
+            if mod_key == "model.hc_head":
+                t = t.float().contiguous()
+            tensors[tk] = t
+        if tensors:
+            save_file(tensors, str(out_path))
+            print(
+                f" -- Wrote unquantized {out_path.name}: "
+                + ", ".join(f"{k} {tuple(v.shape)} {v.dtype}" for k, v in tensors.items()),
+                flush=True,
+            )
+    stc.close()
+    print(f" -- Prepared unquantized embed/head/norm modules on CPU in {time.monotonic() - t_head:.2f}s", flush=True)
+
+    # 3. Compile into standard 8 GB release shards via exllamav3.conversion.compile.compile_model
+    t_comp = time.monotonic()
+    compile_args = dict(saved_args)
+    compile_args["in_dir"] = str(args.in_dir)
+    compile_args["work_dir"] = str(args.work_dir)
+    compile_args["out_dir"] = str(args.out_dir)
+    compile_args["shard_size"] = int(args.shard_size)
+    compile_args.pop("model_stc", None)
+    if "final_bits" not in compile_args:
+        hq = int(compile_args.get("hq", 0) or 0)
+        half_steps = compile_args.get("codebook", "mul1") == "mul1"
+        if compile_args.get("recipe_strategy"):
+            _, final_bpw = create_q_strategy_from_recipe(
+                model, None, config, compile_args["recipe_strategy"],
+                compile_args.get("head_bits", 16), compile_args.get("mtp_bits", 16),
+                vision_model=None, vision_bpw=compile_args.get("vision_bits", 16),
+                hq=hq, half_steps=half_steps,
+            )
+        else:
+            _, final_bpw = create_q_strategy(
+                model, None, config, compile_args["bits"],
+                compile_args.get("head_bits", 16), compile_args.get("mtp_bits", 16),
+                hq, vision_model=None, vision_bpw=compile_args.get("vision_bits", 16),
+                half_steps=half_steps,
+            )
+        compile_args["final_bits"] = round(final_bpw, 2)
+
+    compile_model(compile_args, model, config, tokenizer, mtp_model=None, vision_model=None)
+    dt_comp = time.monotonic() - t_comp
+    dt_tot = time.monotonic() - t0
+    print(f" -- Compile finished in {dt_comp:.2f}s (total packaging {dt_tot:.2f}s) -> {args.out_dir}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/farm/quantize_trunk_pass.py b/farm/quantize_trunk_pass.py
new file mode 100755
index 0000000000000000000000000000000000000000..a5402993d6e45292be4058f403cea258f3a2b5f7
--- /dev/null
+++ b/farm/quantize_trunk_pass.py
@@ -0,0 +1,1323 @@
+#!/usr/bin/env python3
+"""Second-pass EXL3 quantization of Hy4 trunk matrices (5 attention + 3 shared-expert per layer),
+plus optional sidecar quantization of lm_head and model.dfly_layers.*.
+
+Reads an existing lossless-trunk + 3-bit-routed Hy4 model directory strictly READ-ONLY
+(either compiled hy4-exl3-out, qtensors/, or a staged subset such as farm-l03-full),
+propagates calibration activations sequentially through each layer with all prior layers'
+quantized trunk + quantized routed experts active, and writes sidecar safetensors files
+into <out-dir>/<profile>/model.layers.<L>.safetensors + trunk.index.json without touching
+any existing model file.
+
+Supports:
+  - 1 primary recipe (--recipe) or dual-width in one pass (--extra-recipe, e.g. 4-bit + 6-bit)
+  - Per-layer resumable checkpoints in <work-dir>/ckpt/
+  - Multi-node work-stealing dispatch over EXL3_REMOTE_WORKERS_FILE / EXL3_REMOTE_WORKERS
+    (reuses existing farm/exl3_farm.py workers; pins 16384x16384 o_proj locally to avoid
+    shipping its 1.07 GB Hessian over TCP)
+  - Optional lm_head_bits (calibrated from L77 model.norm Hessian or uncalibrated fallback)
+    and dfly_bits (uncalibrated EXL3 sidecar for model.dfly_layers.*) in the same recipe YAML.
+"""
+from __future__ import annotations
+
+import argparse
+import gc
+import json
+import math
+import os
+import queue
+import shutil
+import signal
+import struct
+import sys
+import tempfile
+import threading
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+
+import torch
+import yaml
+from safetensors import safe_open
+from safetensors.torch import load_file, save_file
+
+SCRIPT_DIR = Path(__file__).resolve().parent
+REPO_ROOT = SCRIPT_DIR.parent
+for p in (str(REPO_ROOT), str(SCRIPT_DIR)):
+    if p not in sys.path:
+        sys.path.insert(0, p)
+
+ATTN_SUFFIXES = (
+    "self_attn.q_a_proj",
+    "self_attn.q_b_proj",
+    "self_attn.kv_a_proj_with_mqa",
+    "self_attn.linear_gate",
+    "self_attn.o_proj",
+)
+SHARED_SUFFIXES = (
+    "mlp.shared_experts.gate_proj",
+    "mlp.shared_experts.up_proj",
+    "mlp.shared_experts.down_proj",
+)
+ALL_TRUNK_SUFFIXES = ATTN_SUFFIXES + SHARED_SUFFIXES
+
+DFLY_LAYER_LINEAR_SUFFIXES = (
+    "self_attn.q_a_proj",
+    "self_attn.q_b_proj",
+    "self_attn.kv_a_proj_with_mqa",
+    "self_attn.linear_gate",
+    "self_attn.o_proj",
+    "mlp.gate_proj",
+    "mlp.up_proj",
+    "mlp.down_proj",
+)
+DFLY_TOP_LINEARS = (
+    "model.dfly_layers.hidden_correction.gate_proj",
+    "model.dfly_layers.hidden_correction.up_proj",
+    "model.dfly_layers.hidden_correction.down_proj",
+    "model.dfly_layers.mtp_fusion.eh_proj",
+)
+
+MUL1_MAGIC = 0x83DCD12D
+TRUNK_STATE_DTYPE = torch.bfloat16
+ALLOWED_BITS = {3, 4, 6, 8, 16, 3.0, 4.0, 6.0, 8.0, 16.0}
+
+
+def utc_now() -> str:
+    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def fmt_bits(b: float) -> str:
+    return str(int(b)) if float(b).is_integer() else f"{float(b):g}"
+
+
+def atomic_write_json(path: Path, obj: dict) -> None:
+    path.parent.mkdir(parents = True, exist_ok = True)
+    tmp = path.with_suffix(path.suffix + ".tmp")
+    tmp.write_text(json.dumps(obj, indent = 2) + "\n", encoding = "utf-8")
+    os.replace(tmp, path)
+
+
+def atomic_save_safetensors(path: Path, tensors: dict[str, torch.Tensor], metadata: dict[str, str] | None = None) -> None:
+    path.parent.mkdir(parents = True, exist_ok = True)
+    tmp = path.with_suffix(path.suffix + ".tmp")
+    clean = {k: v.detach().cpu().contiguous() for k, v in tensors.items()}
+    save_file(clean, str(tmp), metadata = metadata)
+    os.chmod(tmp, 0o644)
+    os.replace(tmp, path)
+
+
+def load_trunk_recipe(path: Path) -> dict:
+    raw = yaml.safe_load(path.read_text(encoding = "utf-8"))
+    if not isinstance(raw, dict):
+        raise ValueError(f"Invalid trunk recipe YAML: {path}")
+    profile = str(raw.get("profile") or path.stem)
+    codebook = str(raw.get("codebook") or "mul1")
+    out_scales = str(raw.get("out_scales") or "always")
+    if codebook != "mul1":
+        raise ValueError(f"Unsupported codebook {codebook!r} in {path} (expected 'mul1')")
+    if out_scales != "always":
+        raise ValueError(f"Unsupported out_scales {out_scales!r} in {path} (expected 'always')")
+    default_bits = float(raw.get("default_bits", 4))
+    if default_bits not in ALLOWED_BITS:
+        raise ValueError(f"Unsupported default_bits={default_bits} in {path}")
+    matrices = {str(k): float(v) for k, v in (raw.get("matrices") or {}).items()}
+    for k, v in matrices.items():
+        if v not in ALLOWED_BITS:
+            raise ValueError(f"Unsupported bits={v} for matrix {k} in {path}")
+    overrides = {str(k): float(v) for k, v in (raw.get("overrides") or {}).items()}
+    for k, v in overrides.items():
+        if v not in ALLOWED_BITS:
+            raise ValueError(f"Unsupported bits={v} for override {k} in {path}")
+    lm_head_bits = raw.get("lm_head_bits")
+    lm_head_bits = None if lm_head_bits in (None, "", 16, 16.0) else float(lm_head_bits)
+    if lm_head_bits is not None and lm_head_bits not in ALLOWED_BITS:
+        raise ValueError(f"Unsupported lm_head_bits={lm_head_bits} in {path}")
+    dfly_bits = raw.get("dfly_bits")
+    dfly_bits = None if dfly_bits in (None, "", 16, 16.0) else float(dfly_bits)
+    if dfly_bits is not None and dfly_bits not in ALLOWED_BITS:
+        raise ValueError(f"Unsupported dfly_bits={dfly_bits} in {path}")
+    dfly_overrides = {str(k): float(v) for k, v in (raw.get("dfly_overrides") or {}).items()}
+    return {
+        "path": str(path),
+        "profile": profile,
+        "codebook": codebook,
+        "out_scales": out_scales,
+        "default_bits": default_bits,
+        "matrices": matrices,
+        "overrides": overrides,
+        "lm_head_bits": lm_head_bits,
+        "dfly_bits": dfly_bits,
+        "dfly_overrides": dfly_overrides,
+    }
+
+
+def bits_for_trunk_key(recipe: dict, full_key: str) -> float:
+    if full_key in recipe["overrides"]:
+        return recipe["overrides"][full_key]
+    for suf in ALL_TRUNK_SUFFIXES:
+        if full_key.endswith("." + suf):
+            return recipe["matrices"].get(suf, recipe["default_bits"])
+    return 16.0
+
+
+def read_remote_workers(cli_workers: str | None) -> list[tuple[str, int]]:
+    entries: list[str] = []
+    wfile = os.environ.get("EXL3_REMOTE_WORKERS_FILE", "").strip()
+    if wfile and os.path.isfile(wfile):
+        for raw_line in Path(wfile).read_text(encoding = "utf-8").splitlines():
+            line = raw_line.split("#", 1)[0].strip()
+            if line:
+                entries.extend(p.strip() for p in line.split(",") if p.strip())
+    elif cli_workers is not None:
+        entries.extend(p.strip() for p in cli_workers.split(",") if p.strip())
+    else:
+        env_w = os.environ.get("EXL3_REMOTE_WORKERS", "").strip()
+        if env_w:
+            entries.extend(p.strip() for p in env_w.split(",") if p.strip())
+    out: list[tuple[str, int]] = []
+    seen = set()
+    for ep in entries:
+        if ":" in ep:
+            h, p_s = ep.rsplit(":", 1)
+            pair = (h.strip(), int(p_s.strip()))
+        else:
+            pair = (ep.strip(), 5599)
+        if pair not in seen:
+            seen.add(pair)
+            out.append(pair)
+    return out
+
+
+class ModelSource:
+    """Read-only shard resolver supporting both HF-indexed model dirs and raw qtensors/ dirs."""
+
+    def __init__(self, model_dir: Path, config_path: Path, extra_model_dir: Path | None = None):
+        self.model_dir = model_dir
+        self.config_path = config_path
+        self.extra_model_dir = extra_model_dir
+        self.weight_map: dict[str, Path] = {}
+        self._scan_dir(model_dir)
+        if extra_model_dir is not None and extra_model_dir != model_dir:
+            self._scan_dir(extra_model_dir, fallback = True)
+
+    def _scan_dir(self, d: Path, fallback: bool = False) -> None:
+        if d.is_file() and d.suffix == ".safetensors":
+            with d.open("rb") as f:
+                hlen = struct.unpack("<Q", f.read(8))[0]
+                hdr = json.loads(f.read(hlen).decode("utf-8"))
+            for k in hdr:
+                if k == "__metadata__":
+                    continue
+                if not fallback or k not in self.weight_map:
+                    self.weight_map[k] = d
+            return
+        idx_file = d / "model.safetensors.index.json"
+        if idx_file.is_file():
+            wm = json.loads(idx_file.read_text(encoding = "utf-8"))["weight_map"]
+            for k, rel in wm.items():
+                p = d / rel
+                if p.is_file() and (not fallback or k not in self.weight_map):
+                    self.weight_map[k] = p
+            return
+        # Raw qtensors/ or single-shard directory: map safetensors headers directly
+        for st_file in sorted(d.glob("*.safetensors")):
+            if st_file.name.startswith("."):
+                continue
+            with st_file.open("rb") as f:
+                hlen = struct.unpack("<Q", f.read(8))[0]
+                hdr = json.loads(f.read(hlen).decode("utf-8"))
+            for k in hdr:
+                if k == "__metadata__":
+                    continue
+                if not fallback or k not in self.weight_map:
+                    self.weight_map[k] = st_file
+
+    def refresh_layer(self, layer_idx: int) -> bool:
+        """Re-check model_dir for a newly arrived layer file (used in --follow mode).
+
+        When model.safetensors.index.json exists (staged/compiled dir), requires BOTH the
+        non-hidden layer file AND its entry in index.json (published atomically after SHA-256).
+        """
+        probe_key = f"model.layers.{layer_idx}.self_attn.q_a_proj.weight"
+        idx_file = self.model_dir / "model.safetensors.index.json"
+        if idx_file.is_file():
+            try:
+                wm = json.loads(idx_file.read_text(encoding = "utf-8")).get("weight_map", {})
+            except Exception:
+                return False
+            rel = wm.get(probe_key)
+            if not rel:
+                return False
+            p = self.model_dir / rel
+            if not p.is_file():
+                return False
+            prefix = f"model.layers.{layer_idx}."
+            for k, r in wm.items():
+                if k.startswith(prefix):
+                    sp = self.model_dir / r
+                    if sp.is_file():
+                        self.weight_map[k] = sp
+            return True
+        # Raw qtensors/ directory: look for model.layers.<L>.safetensors
+        layer_f = self.model_dir / f"model.layers.{layer_idx}.safetensors"
+        if not layer_f.is_file():
+            return False
+        try:
+            with layer_f.open("rb") as f:
+                hlen = struct.unpack("<Q", f.read(8))[0]
+                hdr = json.loads(f.read(hlen).decode("utf-8"))
+        except Exception:
+            return False
+        if probe_key not in hdr:
+            return False
+        for k in hdr:
+            if k != "__metadata__":
+                self.weight_map[k] = layer_f
+        return True
+
+    def shards_for_prefix(self, prefix: str) -> list[Path]:
+        shards = sorted({p for k, p in self.weight_map.items() if k.startswith(prefix)})
+        if not shards:
+            raise FileNotFoundError(f"No tensors matching prefix {prefix!r} under {self.model_dir}")
+        return shards
+
+    def tensor_shard(self, key: str) -> Path | None:
+        return self.weight_map.get(key)
+
+    def make_scoped_config(self, shard_paths: list[Path]):
+        from exllamav3.loader.safetensors import SafetensorsCollection
+        from exllamav3.model.config import Config
+
+        tmp_dir = tempfile.mkdtemp(prefix = "hy4_trunk_cfg_")
+        try:
+            os.symlink(str(self.config_path.resolve()), os.path.join(tmp_dir, "config.json"))
+            cfg = Config.from_directory(tmp_dir)
+            stc = SafetensorsCollection(tmp_dir)
+            for sp in shard_paths:
+                stc.add_tensor_files(str(sp), warn_if_override = False)
+            cfg.stc = stc
+            return cfg, tmp_dir
+        except Exception:
+            shutil.rmtree(tmp_dir, ignore_errors = True)
+            raise
+
+
+def load_cal_tokens(cal_path: Path, cal_rows: int, cal_cols: int) -> torch.Tensor:
+    with safe_open(str(cal_path), framework = "pt", device = "cpu") as f:
+        keys = list(f.keys())
+        key = "input_ids" if "input_ids" in keys else keys[0]
+        t = f.get_tensor(key)
+    if t.dim() != 2:
+        raise ValueError(f"Expected 2D calibration tensor in {cal_path}, got {tuple(t.shape)}")
+    if t.shape[0] < cal_rows or t.shape[1] < cal_cols:
+        raise ValueError(f"Calibration tensor {tuple(t.shape)} smaller than {cal_rows}x{cal_cols}")
+    return t[:cal_rows, :cal_cols].contiguous()
+
+
+def build_initial_state(source: ModelSource, cal_ids: torch.Tensor, device: torch.device) -> torch.Tensor:
+    from exllamav3.model.model import Model
+
+    shards = source.shards_for_prefix("model.embed_tokens.")
+    cfg, tmp_dir = source.make_scoped_config(shards)
+    try:
+        model = Model.from_config(cfg)
+        embed = model.modules[0]
+        expand = model.modules[1]
+        embed.load(device)
+        expand.load(device)
+        state = None
+        with torch.inference_mode():
+            for i in range(cal_ids.shape[0]):
+                ids = cal_ids[i : i + 1].to(device = device, dtype = torch.long)
+                x = embed.forward(ids, {})
+                x = expand.forward(x, {})
+                if state is None:
+                    state = torch.empty((cal_ids.shape[0], *x.shape[1:]), dtype = TRUNK_STATE_DTYPE, device = "cpu")
+                _copy_row_to_cpu(state, i, x)
+        embed.unload()
+        expand.unload()
+        cfg.stc.close()
+        assert state is not None
+        return state
+    finally:
+        shutil.rmtree(tmp_dir, ignore_errors = True)
+        gc.collect()
+        if device.type == "cuda":
+            torch.cuda.empty_cache()
+
+
+def _copy_row_to_cpu(state: torch.Tensor, row_idx: int, src: torch.Tensor) -> None:
+    dst = state[row_idx : row_idx + 1]
+    if src.dtype != dst.dtype:
+        src = src.to(dtype = dst.dtype)
+    dst.copy_(src, non_blocking = False)
+
+
+def _preserve_to_cpu(obj):
+    if isinstance(obj, torch.Tensor):
+        return obj.detach().to("cpu")
+    if isinstance(obj, dict):
+        return {k: _preserve_to_cpu(v) for k, v in obj.items()}
+    if isinstance(obj, (list, tuple)):
+        return type(obj)(_preserve_to_cpu(v) for v in obj)
+    return obj
+
+
+def _preserve_to_device(obj, device: torch.device):
+    if isinstance(obj, torch.Tensor):
+        return obj.to(device)
+    if isinstance(obj, dict):
+        return {k: _preserve_to_device(v, device) for k, v in obj.items()}
+    if isinstance(obj, (list, tuple)):
+        return type(obj)(_preserve_to_device(v, device) for v in obj)
+    return obj
+
+
+def save_checkpoint(work_dir: Path, next_layer: int, state: torch.Tensor, preserves: list[dict], layer_timings: list[dict]) -> float:
+    t0 = time.monotonic()
+    ckpt = work_dir / "ckpt"
+    ckpt_new = work_dir / "ckpt_new"
+    ckpt_old = work_dir / "ckpt_old"
+    if ckpt_new.exists():
+        shutil.rmtree(ckpt_new)
+    ckpt_new.mkdir(parents = True, exist_ok = True)
+    (ckpt_new / "job.json").write_text(
+        json.dumps({"next_layer": next_layer, "updated_utc": utc_now(), "layer_timings": layer_timings}, indent = 2) + "\n",
+        encoding = "utf-8",
+    )
+    save_file({"state": state}, str(ckpt_new / "state.safetensors"))
+    torch.save({"next_layer": next_layer, "rows": [_preserve_to_cpu(p) for p in preserves]}, str(ckpt_new / "preserve.pt"))
+    if ckpt_old.exists():
+        shutil.rmtree(ckpt_old)
+    if ckpt.exists():
+        os.rename(ckpt, ckpt_old)
+    os.rename(ckpt_new, ckpt)
+    if ckpt_old.exists():
+        shutil.rmtree(ckpt_old)
+    return time.monotonic() - t0
+
+
+def load_checkpoint(work_dir: Path) -> tuple[int, torch.Tensor, list[dict], list[dict]] | None:
+    ckpt = work_dir / "ckpt"
+    job_p = ckpt / "job.json"
+    st_p = ckpt / "state.safetensors"
+    if not (job_p.is_file() and st_p.is_file()):
+        return None
+    jd = json.loads(job_p.read_text(encoding = "utf-8"))
+    state = load_file(str(st_p))["state"].contiguous()
+    if state.dtype == torch.half and TRUNK_STATE_DTYPE == torch.bfloat16:
+        print(f" -- Casting resumed F16 trunk state {tuple(state.shape)} to BF16 in-place", flush = True)
+        raw = state.view(torch.int16)
+        for i in range(state.shape[0]):
+            raw[i].copy_(state[i].to(torch.bfloat16).view(torch.int16))
+        state = raw.view(torch.bfloat16)
+    pr_p = ckpt / "preserve.pt"
+    if pr_p.is_file():
+        preserves = torch.load(str(pr_p), map_location = "cpu", weights_only = False)["rows"]
+    else:
+        preserves = [{} for _ in range(state.shape[0])]
+    return int(jd["next_layer"]), state, preserves, jd.get("layer_timings") or []
+
+
+@torch.inference_mode()
+def capture_trunk_hessians(block, state: torch.Tensor, preserves: list[dict], device: torch.device, trunk_qmaps: set[str]) -> dict:
+    """Run ONLY attention + shared_experts (skipping all 256 routed experts and capture_sens)
+    to accumulate exact Hessians for the 5 (L0) or 8 (L1..L77) trunk matrices."""
+    from exllamav3.modules.hyv4 import HyV4MoE
+
+    is_moe = isinstance(block.mlp, HyV4MoE)
+    n_rows = state.shape[0]
+    capture_H: dict = {}
+
+    for i in range(n_rows):
+        x = state[i : i + 1].to(device = device, dtype = state.dtype)
+        params: dict = {
+            "attn_mode": "flash_attn_nc",
+            "capture": capture_H,
+            "capture_qmaps": trunk_qmaps,
+            "capture_only": True,
+        }
+        if preserves[i]:
+            params.update(_preserve_to_device(preserves[i], device))
+
+        # Attention sublayer (mirrors TransformerBlock.forward)
+        hc_post, hc_comb, y, normed = block.attn_hc.mix_norm(x, params, block.attn_norm)
+        if block.attn_norm and not normed:
+            y = block.attn_norm.forward(y, params, out_dtype = torch.half)
+        else:
+            y = y.half()
+        attn_out = block.attn.forward(y, params)
+
+        if is_moe:
+            x = block.attn_hc.apply_(x, attn_out, hc_post, hc_comb, params)
+            _, _, y2, normed2 = block.mlp_hc.mix_norm(x, params, block.mlp_norm)
+            if block.mlp_norm and not normed2:
+                y2 = block.mlp_norm.forward(y2, params, out_dtype = torch.half)
+            else:
+                y2 = y2.half()
+            # Run shared_experts ONLY (routed experts are already quantized and independent of shared)
+            block.mlp.shared.forward(y2, params)
+        del x, attn_out
+
+    torch.cuda.synchronize(device)
+    return capture_H
+
+
+@torch.inference_mode()
+def advance_state_layer(block, state: torch.Tensor, preserves: list[dict], device: torch.device) -> list[dict]:
+    """Advance calibration state through full layer (quantized trunk + quantized routed experts)
+    using in-place contiguous CPU copy, preserving dsa_topk_indices on full indexer layers."""
+    n_rows = state.shape[0]
+    new_preserves: list[dict] = []
+    for i in range(n_rows):
+        x = state[i : i + 1].to(device = device, dtype = state.dtype)
+        p_in = _preserve_to_device(preserves[i], device) if preserves[i] else {}
+        params: dict = {
+            "attn_mode": "flash_attn_nc",
+            "quant_preserve": dict(p_in),
+        }
+        params.update(p_in)
+        out = block.forward(x, params)
+        _copy_row_to_cpu(state, i, out)
+        new_preserves.append(_preserve_to_cpu(params.get("quant_preserve") or {}))
+        del x, out
+    torch.cuda.synchronize(device)
+    return new_preserves
+
+
+def make_uncalibrated_H(k_pad: int, key: str, device: torch.device, seed: int) -> dict:
+    """Create a finalized uncalibrated H_data dict safe for both local and TCP remote quantize_exl3."""
+    from exllamav3.modules.quant.exl3_lib.quantize import finalize_capture_H
+
+    hd = {
+        "H": torch.zeros(k_pad, k_pad, dtype = torch.float32, device = "meta"),
+        "packed": False,
+        "n": k_pad,
+        "first_key": key,
+        "count": 0,
+        "finalized": False,
+        "num_total": 0,
+        "device": device,
+    }
+    finalize_capture_H(hd, {"seed": seed}, verbose = False)
+    # Replace meta tensor with empty CPU tensor so TCP _export_H works cleanly (unused when finalized=True)
+    hd["H"] = torch.empty((0,), dtype = torch.float32)
+    return hd
+
+
+def quantize_jobs_distributed(
+    jobs: list[dict],
+    device: torch.device,
+    remote_workers: list[tuple[str, int]],
+    work_dir: Path,
+) -> dict[str, tuple[float, dict[str, torch.Tensor], dict]]:
+    """Quantize a list of matrix jobs across local GPU + remote farm workers.
+
+    Each job dict has:
+      job_id, key, weight_cpu (in_pad, out_pad) fp16/bf16, H_data (finalized), bpw, seed, local_only (bool)
+    Returns:
+      {job_id: (proxy_err, out_tensors_cpu, quant_args)}
+    """
+    from exllamav3.modules.quant.exl3_lib.quantize import quantize_exl3
+    import exl3_farm
+
+    dev_idx = device.index if device.index is not None else 0
+    results: dict[str, tuple[float, dict[str, torch.Tensor], dict]] = {}
+    res_lock = threading.Lock()
+    local_gpu_lock = threading.Lock()
+
+    def build_qa(job: dict) -> dict:
+        bpw_val = int(job["bpw"]) if float(job["bpw"]).is_integer() else float(job["bpw"])
+        return {
+            "seed": job["seed"],
+            "K": bpw_val,
+            "devices": [dev_idx],
+            "device_ratios": None,
+            "apply_out_scales": True,
+            "scaled_hessian": True,
+            "sigma_reg_out": 0.025,
+            "mul1": True,
+            "debug_dir": str(work_dir / "debug"),
+        }
+
+    def run_local(job: dict) -> None:
+        qa = build_qa(job)
+        with local_gpu_lock:
+            t0 = time.monotonic()
+            with torch.inference_mode():
+                hd = job["H_data"]
+                # Move H_data tensors to GPU if needed
+                hd_dev = {}
+                for k, v in hd.items():
+                    hd_dev[k] = v.to(device) if isinstance(v, torch.Tensor) and v.device != device else v
+                hd_dev["device"] = device
+                _, pe, out = quantize_exl3(job["weight_cpu"].to(device = device, dtype = torch.float32), hd_dev, qa, False)
+                out_cpu = {k: v.detach().to("cpu").contiguous() for k, v in out.items() if v is not None}
+            torch.cuda.synchronize(device)
+            dt = time.monotonic() - t0
+        with res_lock:
+            results[job["job_id"]] = (float(pe), out_cpu, qa)
+        print(
+            f" -- Quantized: {job['key']:<58} bpw: {job['bpw']:4.1f}  proxy_err: {float(pe):8.6f}  "
+            f"g_sc: {qa.get('g_scale', 0.0):.6f}  [local {dt:.1f}s]",
+            flush = True,
+        )
+
+    # Sort largest matrices first; keep local_only (e.g. 16384x16384 o_proj) in local queue
+    local_jobs = [j for j in jobs if j.get("local_only")]
+    shared_jobs = sorted([j for j in jobs if not j.get("local_only")], key = lambda j: j["weight_cpu"].numel(), reverse = True)
+
+    if not remote_workers:
+        for job in local_jobs + shared_jobs:
+            run_local(job)
+        return results
+
+    q: queue.Queue = queue.Queue()
+    for job in shared_jobs:
+        q.put(job)
+
+    def local_thread():
+        for job in local_jobs:
+            run_local(job)
+        while True:
+            try:
+                job = q.get_nowait()
+            except queue.Empty:
+                return
+            run_local(job)
+
+    def remote_thread(host: str, port: int):
+        while True:
+            try:
+                job = q.get_nowait()
+            except queue.Empty:
+                return
+            qa = build_qa(job)
+            t0 = time.monotonic()
+            try:
+                res_list, qa_list = exl3_farm.quantize_remote(
+                    host, port, [job["weight_cpu"]], [job["H_data"]], [qa]
+                )
+                pe, out_cpu = res_list[0]
+                qa_out = qa_list[0]
+                dt = time.monotonic() - t0
+                with res_lock:
+                    results[job["job_id"]] = (float(pe), {k: v.contiguous() for k, v in out_cpu.items()}, qa_out)
+                print(
+                    f" -- Quantized: {job['key']:<58} bpw: {job['bpw']:4.1f}  proxy_err: {float(pe):8.6f}  "
+                    f"g_sc: {qa_out.get('g_scale', 0.0):.6f}  [remote {host} {dt:.1f}s]",
+                    flush = True,
+                )
+            except Exception as e:
+                print(f" !! remote {host}:{port} failed on {job['key']} ({e}); encoding locally", flush = True)
+                run_local(job)
+
+    threads = [threading.Thread(target = local_thread, daemon = True)]
+    for host, port in remote_workers:
+        threads.append(threading.Thread(target = remote_thread, args = (host, port), daemon = True))
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+
+    assert len(results) == len(jobs), f"Missing results: got {len(results)} / {len(jobs)}"
+    return results
+
+
+def verify_and_pack_sidecar(
+    matrix_specs: list[dict],
+    out_tensors_by_key: dict[str, dict[str, torch.Tensor]],
+    profile: str,
+    layer_tag: str,
+    out_path: Path,
+) -> tuple[dict[str, str], dict[str, dict], int]:
+    """Verify .mul1 magic, trellis shape/k2, FP16 suh/svh finiteness, and write atomic safetensors."""
+    flat: dict[str, torch.Tensor] = {}
+    meta_matrices: dict[str, dict] = {}
+    st_meta: dict[str, str] = {
+        "format": "hy4-exl3-trunk-v1",
+        "profile": profile,
+        "layer": layer_tag,
+        "codebook": "mul1",
+        "out_scales": "always",
+    }
+
+    for spec in matrix_specs:
+        key = spec["key"]
+        k_log, n_log = spec["k_logical"], spec["n_logical"]
+        k_pad, n_pad = spec["k_pad"], spec["n_pad"]
+        bpw = spec["bpw"]
+        k2 = int(round(bpw * 2))
+        out = out_tensors_by_key[key]
+
+        tr = out["trellis"]
+        suh = out["suh"]
+        svh = out["svh"]
+        mul1 = out["mul1"]
+
+        exp_tr_shape = (k_pad // 16, n_pad // 16, 8 * k2)
+        if tr.dtype != torch.int16 or tuple(tr.shape) != exp_tr_shape:
+            raise AssertionError(f"{key}.trellis: expected I16 {exp_tr_shape}, got {tr.dtype} {tuple(tr.shape)}")
+        if suh.dtype != torch.float16 or tuple(suh.shape) != (k_pad,):
+            raise AssertionError(f"{key}.suh: expected F16 ({k_pad},), got {suh.dtype} {tuple(suh.shape)}")
+        if svh.dtype != torch.float16 or tuple(svh.shape) != (n_pad,):
+            raise AssertionError(f"{key}.svh: expected F16 ({n_pad},), got {svh.dtype} {tuple(svh.shape)}")
+        if not (torch.isfinite(suh).all() and torch.isfinite(svh).all()):
+            raise AssertionError(f"{key}: NaN/Inf in suh/svh scales")
+        if mul1.dtype != torch.int32 or mul1.numel() != 1:
+            raise AssertionError(f"{key}.mul1: bad dtype/shape {mul1.dtype} {tuple(mul1.shape)}")
+        magic_u32 = int(mul1.reshape(-1)[0].item()) & 0xFFFFFFFF
+        if magic_u32 != MUL1_MAGIC:
+            raise AssertionError(f"{key}.mul1: expected 0x{MUL1_MAGIC:08x}, got 0x{magic_u32:08x}")
+
+        flat[f"{key}.trellis"] = tr
+        flat[f"{key}.suh"] = suh
+        flat[f"{key}.svh"] = svh
+        flat[f"{key}.mul1"] = mul1
+
+        meta_matrices[key] = {
+            "bpw": int(bpw) if float(bpw).is_integer() else float(bpw),
+            "k2": k2,
+            "k_logical": k_log,
+            "n_logical": n_log,
+            "k_pad": k_pad,
+            "n_pad": n_pad,
+        }
+        st_meta[f"bpw.{key}"] = fmt_bits(bpw)
+
+    st_meta["matrices"] = json.dumps(meta_matrices, separators = (",", ":"))
+    atomic_save_safetensors(out_path, flat, metadata = st_meta)
+    total_bytes = sum(t.numel() * t.element_size() for t in flat.values())
+    weight_map_entries = {k: out_path.name for k in sorted(flat.keys())}
+    return weight_map_entries, meta_matrices, total_bytes
+
+
+def update_trunk_index(
+    profile_dir: Path,
+    recipe: dict,
+    new_wm: dict[str, str],
+    new_matrices: dict[str, dict],
+    new_bytes: int,
+    layer_idx: int | None = None,
+    extra_tag: str | None = None,
+) -> None:
+    idx_path = profile_dir / "trunk.index.json"
+    if idx_path.is_file():
+        doc = json.loads(idx_path.read_text(encoding = "utf-8"))
+    else:
+        doc = {
+            "metadata": {
+                "format": "hy4-exl3-trunk-v1",
+                "profile": recipe["profile"],
+                "codebook": recipe["codebook"],
+                "out_scales": recipe["out_scales"],
+                "recipe_path": recipe["path"],
+                "default_bits": recipe["default_bits"],
+                "layers_done": [],
+                "extras_done": [],
+                "total_bytes": 0,
+                "matrices": {},
+            },
+            "weight_map": {},
+        }
+    doc["weight_map"].update(new_wm)
+    doc["metadata"]["matrices"].update(new_matrices)
+    if layer_idx is not None and layer_idx not in doc["metadata"]["layers_done"]:
+        doc["metadata"]["layers_done"] = sorted(doc["metadata"]["layers_done"] + [layer_idx])
+    if extra_tag is not None and extra_tag not in doc["metadata"]["extras_done"]:
+        doc["metadata"]["extras_done"].append(extra_tag)
+    doc["metadata"]["total_bytes"] = sum(
+        p.stat().st_size for p in profile_dir.glob("*.safetensors") if not p.name.startswith(".")
+    )
+    doc["metadata"]["updated_utc"] = utc_now()
+    atomic_write_json(idx_path, doc)
+
